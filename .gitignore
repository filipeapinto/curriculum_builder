# Gate result records are written on every run and are never committed; the folder
# itself is kept by tests/results/.gitkeep so "results written" and "worktree clean"
# are simultaneously satisfiable (harness rule 4).
tests/results/*.json
!tests/results/.gitkeep

# Python bytecode from the gate harness.
__pycache__/
*.pyc

# Run output. runtime/io.py's require_internal_output requires every --output-root
# to resolve beneath outputs/, so every run — including test scratch space — writes
# here now. Generated curriculum artifacts are drafts pending review, never
# committed history.
outputs/

# Python packaging artifacts are disposable and must never affect inventory,
# imports, or release verification. Anchored to repo root so nested build/
# directories that hold real source (e.g. templates/report-system/build/)
# aren't swept up.
/build/
/dist/
*.egg-info/

# Retained Plan 26 execution branches are local forensic artifacts. Their
# immutable metadata is referenced by the tracked scheduler audit log, but each
# branch contains a complete working copy and must never enter Git history.
.plan26-run/

# Scratch/run state for the graph-system-document skill (source inventory,
# verify/repair attempt counters, diagram render fragments). Regenerated on
# every run, never committed.
.doc-run/
.doc-run-live/

# skill-creator's optimization workspace (old-version snapshots, benchmark
# eval runs comparing skill versions, throwaway fixtures). Not a deliverable.
.claude/skills/*-workspace/

# macOS
.DS_Store
.retrieved_sources/
