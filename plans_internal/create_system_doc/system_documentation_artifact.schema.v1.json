{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_documentation_artifact.schema.v1.json",
  "title": "Graph-system documentation stage artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "artifact_digest", "producer", "created_at", "inputs", "status", "issues", "payload"],
  "properties": {
    "schema_id": {"enum": ["system_documentation_intake.v1.json", "system_evidence_inventory.v1.json", "system_fact_model.v1.json", "system_claim_register.v1.json", "system_documentation_plan.v1.json", "render_manifest.v1.json", "system_documentation_verification.v1.json"]},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "implementation_id", "implementation_version", "host"],
      "properties": {"stage": {"type": "string", "minLength": 1}, "implementation_id": {"type": "string", "minLength": 1}, "implementation_version": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "status": {"enum": ["complete", "complete_with_gaps", "blocked"]},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"schema_id": {"const": "system_documentation_intake.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/intake"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_evidence_inventory.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/inventory"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_fact_model.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/fact_model"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_claim_register.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/claim_register"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_documentation_plan.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/plan"}}}},
    {"if": {"properties": {"schema_id": {"const": "render_manifest.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/render"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_documentation_verification.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/verification"}}}}
  ],
  "$defs": {
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "schema_version", "digest"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "issue": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "owner_stage", "reason", "disposition"], "properties": {"id": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "blocking"]}, "owner_stage": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "disposition": {"type": "string", "minLength": 1}}},
    "open_object": {"type": "object"},
    "id_array": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "intake": {"type": "object", "additionalProperties": false, "required": ["raw_request", "purpose", "audiences", "supported_decisions", "scope", "disclosure_policy", "completion_policy", "delivery", "open_decisions"], "properties": {"raw_request": {"type": "string"}, "purpose": {"type": "string", "minLength": 1}, "audiences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/open_object"}}, "supported_decisions": {"type": "array", "items": {"type": "string"}}, "scope": {"$ref": "#/$defs/open_object"}, "disclosure_policy": {"$ref": "#/$defs/open_object"}, "completion_policy": {"$ref": "#/$defs/open_object"}, "delivery": {"$ref": "#/$defs/open_object"}, "open_decisions": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["sources"], "properties": {"sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "locator", "kind", "provenance", "authority_class", "version_or_digest", "observed_at", "freshness_rule", "permitted_use", "accessibility", "inspection_status"]}}}},
    "fact_model": {"type": "object", "additionalProperties": false, "required": ["system_boundary", "components", "routes", "state_fields", "dependencies", "deployment", "controls", "operations", "candidate_claims"], "properties": {"system_boundary": {"$ref": "#/$defs/open_object"}, "components": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "routes": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "state_fields": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "deployment": {"$ref": "#/$defs/open_object"}, "controls": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "operations": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "candidate_claims": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}}},
    "claim_register": {"type": "object", "additionalProperties": false, "required": ["claims"], "properties": {"claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "claim", "subject_ids", "evidence_class", "source_ids", "scope", "freshness", "conflict", "disclosure", "confidence", "publication_eligibility", "adjudication_reason"]}}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["reader_journey", "sections", "views", "requirement_coverage", "claim_placements", "format_decisions"], "properties": {"reader_journey": {"type": "array", "items": {"type": "string"}}, "sections": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "views": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "requirement_coverage": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "claim_placements": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "format_decisions": {"$ref": "#/$defs/open_object"}}},
    "render": {"type": "object", "additionalProperties": false, "required": ["deliverables"], "properties": {"deliverables": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["locator", "media_type", "digest", "claim_ids", "view_ids", "generated_assets", "fallback_status", "renderer"]}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["subject_digests", "checks", "gate_results", "findings", "freshness_status", "publication_decision", "verified_at"], "properties": {"subject_digests": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "checks": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "gate_results": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "freshness_status": {"type": "string"}, "publication_decision": {"enum": ["publish", "publish_with_accepted_gaps", "block"]}, "verified_at": {"type": "string", "format": "date-time"}}}
  }
}
