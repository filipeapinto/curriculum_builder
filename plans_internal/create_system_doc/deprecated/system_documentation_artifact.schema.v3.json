{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_documentation_artifact.schema.v3.json",
  "title": "Graph-system documentation stage artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "artifact_digest", "producer", "created_at", "inputs", "status", "issues", "payload"],
  "properties": {
    "schema_id": {"enum": ["system_documentation_plan.v1.json", "system_documentation_build.v1.json", "system_documentation_update.v1.json"]},
    "schema_version": {"const": "3.0.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "implementation_id", "implementation_version", "host"],
      "properties": {"stage": {"type": "string", "minLength": 1}, "implementation_id": {"type": "string", "minLength": 1}, "implementation_version": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "status": {"enum": ["complete", "complete_with_gaps", "blocked"]},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"schema_id": {"const": "system_documentation_plan.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/workflow_plan"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_documentation_build.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/workflow_build"}}}},
    {"if": {"properties": {"schema_id": {"const": "system_documentation_update.v1.json"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/workflow_update"}}}}
  ],
  "$defs": {
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "schema_version", "digest"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "issue": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "owner_stage", "reason", "disposition"], "properties": {"id": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "blocking"]}, "owner_stage": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "disposition": {"type": "string", "minLength": 1}}},
    "open_object": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "summary", "source_ids", "attributes"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/id_array"}, "attributes": {"type": "object"}}},
    "id_array": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "intake": {"type": "object", "additionalProperties": false, "required": ["raw_request", "purpose", "audiences", "supported_decisions", "scope", "disclosure_policy", "completion_policy", "delivery", "open_decisions", "conformance_profile"], "properties": {"raw_request": {"type": "string"}, "purpose": {"type": "string", "minLength": 1}, "audiences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/open_object"}}, "supported_decisions": {"type": "array", "items": {"type": "string"}}, "scope": {"$ref": "#/$defs/open_object"}, "disclosure_policy": {"$ref": "#/$defs/open_object"}, "completion_policy": {"$ref": "#/$defs/open_object"}, "delivery": {"$ref": "#/$defs/open_object"}, "open_decisions": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "conformance_profile": {"type": "object", "additionalProperties": false, "required": ["scenario_checklist", "viewports", "approved_output_location", "accepted_gap_classes", "disclosure_approver", "authoritative_roots", "authority_rules", "first_deliverable", "renderer_policy", "required_hosts", "freshness_rule"], "properties": {"scenario_checklist": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "question", "expected_answer"]}}, "viewports": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["name", "width", "height"]}}, "approved_output_location": {"type": "string", "minLength": 1}, "accepted_gap_classes": {"type": "array", "items": {"type": "string"}}, "disclosure_approver": {"type": "string", "minLength": 1}, "authoritative_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authority_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "first_deliverable": {"type": "string", "minLength": 1}, "renderer_policy": {"type": "string", "minLength": 1}, "required_hosts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "freshness_rule": {"type": "string", "minLength": 1}}}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["sources"], "properties": {"sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "locator", "kind", "provenance", "authority_class", "version_or_digest", "observed_at", "freshness_rule", "permitted_use", "accessibility", "inspection_status"]}}}},
    "fact_model": {"type": "object", "additionalProperties": false, "required": ["system_boundary", "components", "routes", "state_fields", "dependencies", "deployment", "controls", "operations", "candidate_claims"], "properties": {"system_boundary": {"$ref": "#/$defs/open_object"}, "components": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "routes": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "state_fields": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "deployment": {"$ref": "#/$defs/open_object"}, "controls": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "operations": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "candidate_claims": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}}},
    "claim_register": {"type": "object", "additionalProperties": false, "required": ["claims"], "properties": {"claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "claim", "subject_ids", "evidence_class", "source_ids", "scope", "freshness", "conflict", "disclosure", "confidence", "publication_eligibility", "adjudication_reason"]}}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["reader_journey", "sections", "views", "requirement_coverage", "claim_placements", "format_decisions"], "properties": {"reader_journey": {"type": "array", "items": {"type": "string"}}, "sections": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "views": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "requirement_coverage": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "claim_placements": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "format_decisions": {"$ref": "#/$defs/open_object"}}},
    "render": {"type": "object", "additionalProperties": false, "required": ["deliverables"], "properties": {"deliverables": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["locator", "media_type", "digest", "claim_ids", "view_ids", "generated_assets", "fallback_status", "renderer"]}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["subject_digests", "checks", "gate_results", "findings", "freshness_status", "publication_decision", "verified_at"], "properties": {"subject_digests": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "checks": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "gate_results": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "freshness_status": {"type": "string"}, "publication_decision": {"enum": ["publish", "publish_with_accepted_gaps", "block"]}, "verified_at": {"type": "string", "format": "date-time"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["decision", "plan_digest", "approver", "decided_at", "accepted_gaps", "approved_output_location"], "properties": {"decision": {"enum": ["pending", "approved", "rejected"]}, "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approver": {"type": "string"}, "decided_at": {"type": ["string", "null"], "format": "date-time"}, "accepted_gaps": {"type": "array", "items": {"type": "string"}}, "approved_output_location": {"type": "string"}}},
    "workflow_plan": {"type": "object", "additionalProperties": false, "required": ["request", "audience", "scope_and_disclosure", "delivery_profile", "sources", "fact_model", "claims", "documentation_plan", "acceptance_checks", "gaps", "approval"], "properties": {"request": {"type": "string"}, "audience": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "scope_and_disclosure": {"$ref": "#/$defs/open_object"}, "delivery_profile": {"$ref": "#/$defs/open_object"}, "sources": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "fact_model": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "claims": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "documentation_plan": {"$ref": "#/$defs/plan"}, "acceptance_checks": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "gaps": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "approval": {"$ref": "#/$defs/approval"}}},
    "workflow_build": {"type": "object", "additionalProperties": false, "required": ["approved_plan", "deliverables", "claim_view_mappings", "checks", "gate_results", "findings", "freshness_status", "publication_decision", "creation_diff"], "properties": {"approved_plan": {"$ref": "#/$defs/artifact_ref"}, "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/open_object"}}, "claim_view_mappings": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "checks": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "gate_results": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "freshness_status": {"enum": ["current", "stale", "unknown"]}, "publication_decision": {"enum": ["publish", "publish_with_accepted_gaps", "block"]}, "creation_diff": {"type": "string"}}},
    "workflow_update": {"type": "object", "additionalProperties": false, "required": ["prior_plan", "prior_build", "changed_sources", "impacted_claims_and_views", "proposed_change_set", "approval", "actual_diff", "verification", "freshness_status", "publication_decision"], "properties": {"prior_plan": {"$ref": "#/$defs/artifact_ref"}, "prior_build": {"$ref": "#/$defs/artifact_ref"}, "changed_sources": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "impacted_claims_and_views": {"$ref": "#/$defs/id_array"}, "proposed_change_set": {"type": "array", "items": {"$ref": "#/$defs/open_object"}}, "approval": {"$ref": "#/$defs/approval"}, "actual_diff": {"type": "string"}, "verification": {"$ref": "#/$defs/verification"}, "freshness_status": {"enum": ["current", "stale", "unknown"]}, "publication_decision": {"enum": ["publish", "publish_with_accepted_gaps", "block"]}}}
  }
}
