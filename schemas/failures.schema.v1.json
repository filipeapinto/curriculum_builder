{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/curriculum_builder/failures.schema.v1.json",
  "title": "Failure ledger v1",
  "description": "Validates policy/failures.v1.yaml. Kept as data rather than prose so each entry can be traced mechanically: every id names its correction and the owner that verifies it. An id with no correction, or a correction with no proving owner, fails the release gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failures_version",
    "schema",
    "generator_defects",
    "v5_gate_failures",
    "capability_failures",
    "runtime_obligations",
    "traceability_rule"
  ],
  "properties": {
    "failures_version": {
      "const": "1.0"
    },
    "schema": {
      "const": "schemas/failures.schema.v1.json"
    },
    "traceability_rule": {
      "type": "string",
      "minLength": 40
    },
    "generator_defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "correction",
          "verified_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "correction": {
            "type": "string",
            "minLength": 20
          },
          "verified_by": {
            "type": "string",
            "pattern": "^(FR-[A-Z0-9-]+|RT-[0-9]+)$",
            "description": "Either a gate in this suite that proves the correction, or the deferred obligation that would. An id with a correction but no proving owner is an incomplete remediation."
          }
        }
      }
    },
    "capability_failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "correction",
          "verified_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "correction": {
            "type": "string",
            "minLength": 20
          },
          "verified_by": {
            "type": "string",
            "pattern": "^(FR-[A-Z0-9-]+|RT-[0-9]+)$",
            "description": "Either a gate in this suite that proves the correction, or the deferred obligation that would. An id with a correction but no proving owner is an incomplete remediation."
          }
        }
      }
    },
    "v5_gate_failures": {
      "type": "object",
      "required": [
        "gates"
      ],
      "properties": {
        "provenance": {
          "type": "string"
        },
        "provenance_note": {
          "type": "string"
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "correction",
              "verified_by"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "correction": {
                "type": "string",
                "minLength": 20
              },
              "verified_by": {
                "type": "string",
                "pattern": "^(FR-[A-Z0-9-]+|RT-[0-9]+)$",
                "description": "Either a gate in this suite that proves the correction, or the deferred obligation that would. An id with a correction but no proving owner is an incomplete remediation."
              }
            }
          }
        }
      }
    },
    "runtime_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "condition",
          "outcome",
          "prose_pattern",
          "correction",
          "verified_by",
          "enforced_at_runtime"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "minLength": 20
          },
          "outcome": {
            "type": "string",
            "pattern": "^[A-Z][A-Z_]*$"
          },
          "prose_pattern": {
            "type": "string",
            "minLength": 8,
            "description": "The anchored pattern that matches this condition as prose writes it. Declared here rather than interpreted by a gate: free-text matching is the last place a rule could be dodged by rewording."
          },
          "correction": {
            "type": "string",
            "minLength": 20
          },
          "verified_by": {
            "type": "string",
            "pattern": "^(FR-[A-Z0-9-]+|RT-[0-9]+)$"
          },
          "enforced_at_runtime": {
            "const": false
          }
        }
      }
    }
  }
}
