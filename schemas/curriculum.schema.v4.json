{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/elegoo/curriculum.schema.v4.json",
  "title": "Component-oriented electronics curriculum manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "curriculum",
    "kit_power_profile",
    "visual_system",
    "labs"
  ],
  "properties": {
    "manifest_version": {
      "const": "4.0"
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "learner",
        "delivery",
        "design_rule"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "learner": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        },
        "design_rule": {
          "const": "Component first; a problem is an application, never the organising principle."
        }
      }
    },
    "kit_power_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference_verification",
        "local_inspection",
        "input",
        "rail_choices",
        "release_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reference_verification": {
          "enum": [
            "unverified",
            "verified_official"
          ]
        },
        "local_inspection": {
          "enum": [
            "not_available",
            "verified"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "evidence"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rail_choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visual_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "photorealistic_roles",
        "technical_map_rule"
      ],
      "properties": {
        "photorealistic_roles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "technical_map_rule": {
          "const": "Technical build maps are deterministically rendered from verified circuit data; generative images are never the connection authority."
        }
      }
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lab"
      },
      "description": "The curriculum defines how many labs exist. The schema does not fix a count \u2014 it requires at least one lab, ascending, contiguous from L01, with unique ids."
    },
    "lab_count": {
      "description": "Optional declared count. When present it must equal len(labs); the controller asserts this.",
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "kind",
        "title",
        "component_set",
        "sequence",
        "component_job",
        "learner_outcome",
        "required_explanation",
        "core_activity",
        "applications",
        "visual_roles",
        "safety_focus",
        "qa_focus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L[0-9]{2,3}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "foundation",
            "component",
            "application",
            "integration",
            "diagnostic"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "component_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "supporting"
          ],
          "properties": {
            "primary": {
              "type": "string",
              "minLength": 1
            },
            "supporting": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sequence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prerequisites",
            "prepares_for"
          ],
          "properties": {
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^L(0[1-9]|[12][0-9]|3[0-5])$"
              }
            },
            "prepares_for": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^L(0[1-9]|[12][0-9]|3[0-5])$"
              }
            }
          }
        },
        "component_job": {
          "type": "string",
          "minLength": 20
        },
        "learner_outcome": {
          "type": "string",
          "minLength": 20
        },
        "required_explanation": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "core_activity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "question",
            "circuit_status"
          ],
          "properties": {
            "mode": {
              "enum": [
                "unpowered",
                "powered_pending_physical_check",
                "adult_led_controller_station",
                "diagnostic"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 10
            },
            "circuit_status": {
              "enum": [
                "not_designed",
                "requires_verified_circuit_data"
              ]
            }
          }
        },
        "applications": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "visual_roles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "safety_focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 6
          }
        },
        "qa_focus": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 6
          }
        }
      }
    }
  }
}