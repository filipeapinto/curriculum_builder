{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/curriculum_builder/task_taxonomy.schema.v2.json",
  "title": "Task taxonomy v2",
  "description": "Validates policy/routing/task_taxonomy.v2.yaml. Every task class carries a risk band and the evidence its output must be backed by. The risk band is what the hard safety rules key on, so a class without one cannot be routed at all.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "schema": {
      "const": "schemas/task_taxonomy.schema.v2.json"
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "evidence_required"
        ],
        "properties": {
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "safety_critical"
            ]
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  }
}
