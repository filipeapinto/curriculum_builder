{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "coverage_denominator.schema.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "source_digest", "nodes", "edges", "guards", "side_effect_boundaries", "mutations", "historical_findings", "historical_anomalies", "aggregates", "process_thresholds"],
  "properties": {
    "version": {"const": "1.0"}, "source_digest": {"$ref": "#/$defs/sha256"},
    "nodes": {"$ref": "#/$defs/records"}, "edges": {"$ref": "#/$defs/records"}, "guards": {"$ref": "#/$defs/records"}, "side_effect_boundaries": {"$ref": "#/$defs/records"},
    "mutations": {"type": "array", "minItems": 19, "items": {"$ref": "#/$defs/mutation"}, "allOf": [
      {"contains": {"properties": {"kind": {"const": "MISSING_SYSTEM_EDGE"}}}}, {"contains": {"properties": {"kind": {"const": "MISSING_REPAIR_EDGE"}}}}, {"contains": {"properties": {"kind": {"const": "MISSING_EXHAUSTION_EDGE"}}}}, {"contains": {"properties": {"kind": {"const": "MISSING_PAUSE_EDGE"}}}}, {"contains": {"properties": {"kind": {"const": "MISSING_RESUME_EDGE"}}}}, {"contains": {"properties": {"kind": {"const": "GUARD_INVERSION"}}}}, {"contains": {"properties": {"kind": {"const": "GUARD_DUPLICATION"}}}}, {"contains": {"properties": {"kind": {"const": "DEPENDENCY_MISMATCH"}}}}, {"contains": {"properties": {"kind": {"const": "CONTEXT_LEAK"}}}}, {"contains": {"properties": {"kind": {"const": "DUPLICATE_OWNER"}}}}, {"contains": {"properties": {"kind": {"const": "TERMINAL_KIND"}}}}, {"contains": {"properties": {"kind": {"const": "REDUCER_ORDER"}}}}, {"contains": {"properties": {"kind": {"const": "CRASH_BEFORE"}}}}, {"contains": {"properties": {"kind": {"const": "CRASH_AFTER"}}}}, {"contains": {"properties": {"kind": {"const": "EVIDENCE_FREE_PASS"}}}}, {"contains": {"properties": {"kind": {"const": "CROSS_RUN_RESUME"}}}}, {"contains": {"properties": {"kind": {"const": "UNKNOWN_CONTRACT"}}}}, {"contains": {"properties": {"kind": {"const": "FUTURE_PRODUCER"}}}}, {"contains": {"properties": {"kind": {"const": "IDEMPOTENCY_COLLISION"}}}}
    ]},
    "historical_findings": {"$ref": "#/$defs/records"}, "historical_anomalies": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "aggregates": {"type": "object", "additionalProperties": false, "required": ["node_count", "edge_count", "guard_count", "side_effect_boundary_count", "mutation_count", "historical_finding_count", "historical_anomaly_count"], "properties": {"node_count": {"type": "integer", "minimum": 1}, "edge_count": {"type": "integer", "minimum": 1}, "guard_count": {"type": "integer", "minimum": 1}, "side_effect_boundary_count": {"type": "integer", "minimum": 1}, "mutation_count": {"type": "integer", "minimum": 19}, "historical_finding_count": {"type": "integer", "minimum": 1}, "historical_anomaly_count": {"type": "integer", "minimum": 0}}},
    "process_thresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_live_model_calls", "minimum_cold_resume_processes", "minimum_independent_reviewers", "maximum_repair_attempts", "required_unit_count"], "properties": {"minimum_live_model_calls": {"type": "integer", "minimum": 2}, "minimum_cold_resume_processes": {"type": "integer", "minimum": 2}, "minimum_independent_reviewers": {"const": 3}, "maximum_repair_attempts": {"const": 2}, "required_unit_count": {"type": "integer", "minimum": 3}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record": {"type": "object", "additionalProperties": false, "required": ["id", "owner", "source_locator", "source_hash", "evidence_requirement"], "properties": {"id": {"type": "string", "minLength": 2}, "owner": {"type": "string", "minLength": 2}, "source_locator": {"type": "string", "minLength": 4}, "source_hash": {"$ref": "#/$defs/sha256"}, "evidence_requirement": {"type": "string", "minLength": 8}}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "owner", "source_locator", "source_hash", "evidence_requirement"], "properties": {"id": {"type": "string", "minLength": 2}, "kind": {"enum": ["MISSING_SYSTEM_EDGE", "MISSING_REPAIR_EDGE", "MISSING_EXHAUSTION_EDGE", "MISSING_PAUSE_EDGE", "MISSING_RESUME_EDGE", "GUARD_INVERSION", "GUARD_DUPLICATION", "DEPENDENCY_MISMATCH", "CONTEXT_LEAK", "DUPLICATE_OWNER", "TERMINAL_KIND", "REDUCER_ORDER", "CRASH_BEFORE", "CRASH_AFTER", "EVIDENCE_FREE_PASS", "CROSS_RUN_RESUME", "UNKNOWN_CONTRACT", "FUTURE_PRODUCER", "IDEMPOTENCY_COLLISION"]}, "owner": {"type": "string", "minLength": 2}, "source_locator": {"type": "string", "minLength": 4}, "source_hash": {"$ref": "#/$defs/sha256"}, "evidence_requirement": {"type": "string", "minLength": 8}}}
  }
}
