{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "sandbox_profile.schema.v2.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "engine", "resolved_roots", "mount_policy", "symlink_policy", "network", "credential_boundary"],
  "properties": {
    "version": {"const": "2.0"}, "engine": {"enum": ["sandbox-exec", "container", "vm", "other_verified"]},
    "resolved_roots": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "purpose", "read", "write"], "properties": {"path": {"type": "string", "pattern": "^/[^\\u0000]+$"}, "purpose": {"enum": ["staged_input", "controller_output", "cli_binary", "temporary", "credential_broker"]}, "read": {"type": "boolean"}, "write": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"write": {"const": true}}}, "then": {"properties": {"read": {"const": true}}}}]}},
    "mount_policy": {"const": "DENY_UNDECLARED"}, "symlink_policy": {"const": "REJECT_ESCAPE"},
    "network": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "destinations"], "properties": {"mode": {"const": "DENY"}, "destinations": {"const": []}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "destinations"], "properties": {"mode": {"const": "ALLOWLIST"}, "destinations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]+$"}}}}]},
    "credential_boundary": {"enum": ["BROKERED_OUTSIDE_SANDBOX", "NO_CREDENTIALS"]}
  }
}
