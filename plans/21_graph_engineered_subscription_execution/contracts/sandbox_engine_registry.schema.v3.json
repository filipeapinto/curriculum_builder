{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "sandbox_engine_registry.schema.v3.json",
  "type": "object", "additionalProperties": false, "required": ["version", "registry_id", "entries", "signer_key_id", "signature"],
  "properties": {"version": {"const": "3.0"}, "registry_id": {"$ref": "#/$defs/sha"}, "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["engine", "version", "binary_path", "binary_sha256", "binary_format"], "properties": {"engine": {"enum": ["sandbox-exec", "container", "vm"]}, "version": {"type": "string", "minLength": 1}, "binary_path": {"type": "string", "pattern": "^/"}, "binary_sha256": {"$ref": "#/$defs/sha"}, "binary_format": {"enum": ["MACH_O", "ELF"]}}}}, "signer_key_id": {"type": "string", "minLength": 8}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}},
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
