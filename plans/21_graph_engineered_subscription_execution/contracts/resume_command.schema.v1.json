{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "resume_command.schema.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "command_id", "run_id", "continuation_id", "continuation_hash", "resume_node_id", "next_attempt", "operator_authorization_hash"],
  "properties": {"version": {"const": "1.0"}, "command_id": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string", "minLength": 8}, "continuation_id": {"$ref": "#/$defs/sha256"}, "continuation_hash": {"$ref": "#/$defs/sha256"}, "resume_node_id": {"type": "string", "pattern": "^P[0-9]+$"}, "next_attempt": {"type": "integer", "minimum": 1}, "operator_authorization_hash": {"$ref": "#/$defs/sha256"}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
