{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "subtask_receipt.schema.v3.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "receipt_id", "run_id", "node_id", "attempt", "subtask_id", "input_digest", "state", "output_sources", "admitted_event_id", "evidence_manifest_id", "signer_key_id", "signature"],
  "properties": {"version": {"const": "3.0"}, "receipt_id": {"$ref": "#/$defs/sha"}, "run_id": {"type": "string", "minLength": 8}, "node_id": {"type": "string", "pattern": "^P[0-6]$"}, "attempt": {"type": "integer", "minimum": 1}, "subtask_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "input_digest": {"$ref": "#/$defs/sha"}, "state": {"const": "COMMITTED"}, "output_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "sha256", "size"], "properties": {"artifact_id": {"type": "string", "minLength": 3}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "size": {"type": "integer", "minimum": 1}}}}, "admitted_event_id": {"$ref": "#/$defs/sha"}, "evidence_manifest_id": {"$ref": "#/$defs/sha"}, "signer_key_id": {"type": "string", "minLength": 8}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}},
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
