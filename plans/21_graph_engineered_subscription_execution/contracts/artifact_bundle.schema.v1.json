{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "artifact_bundle.schema.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "producer_node_id", "execution_contract_digest", "artifacts"],
  "properties": {
    "version": {"const": "1.0"}, "producer_node_id": {"type": "string", "pattern": "^P[0-9]+$"}, "execution_contract_digest": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "schema_ref", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "schema_ref": {"type": "string", "minLength": 8}, "sha256": {"$ref": "#/$defs/sha256"}}}}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
