{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "evidence_manifest.schema.v3.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "manifest_id", "run_id", "node_id", "attempt", "graph_digest", "prompt_digest", "policy_digest", "schema_digest", "route_digest", "execution_contract_digest", "test_receipts", "artifact_sources", "signer_key_id", "signature"],
  "properties": {
    "version": {"const": "3.0"}, "manifest_id": {"$ref": "#/$defs/sha"}, "run_id": {"type": "string", "minLength": 8}, "node_id": {"type": "string", "pattern": "^P[0-6]$"}, "attempt": {"type": "integer", "minimum": 1}, "graph_digest": {"$ref": "#/$defs/sha"}, "prompt_digest": {"$ref": "#/$defs/sha"}, "policy_digest": {"$ref": "#/$defs/sha"}, "schema_digest": {"$ref": "#/$defs/sha"}, "route_digest": {"$ref": "#/$defs/sha"}, "execution_contract_digest": {"$ref": "#/$defs/sha"},
    "test_receipts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["test_id", "path", "sha256", "size"], "properties": {"test_id": {"type": "string", "pattern": "^P[0-6]-T[0-9]{2}$"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "size": {"type": "integer", "minimum": 1}}}},
    "artifact_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "sha256", "size", "media_type", "schema_ref"], "properties": {"artifact_id": {"type": "string", "minLength": 4}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "size": {"type": "integer", "minimum": 1}, "media_type": {"enum": ["application/json", "application/yaml", "text/markdown", "application/octet-stream"]}, "schema_ref": {"type": ["string", "null"]}}}},
    "signer_key_id": {"type": "string", "minLength": 8}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }, "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1}}
}
