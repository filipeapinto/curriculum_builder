{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "baseline_contract.schema.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "execution_contract_digest", "protected_paths", "authorized_paths", "dirty_overlap_decisions", "baseline_results", "capability_facts", "status_vocabularies", "status_migration"],
  "properties": {
    "version": {"const": "1.0"}, "execution_contract_digest": {"$ref": "#/$defs/sha256"},
    "protected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "authorized_paths": {"type": "object", "additionalProperties": false, "required": ["P4", "P5", "P6"], "properties": {
      "P4": {"type": "object", "additionalProperties": false, "required": ["runtime_policy_schema", "plan19_reconciliation", "tests"], "properties": {"runtime_policy_schema": {"$ref": "#/$defs/repoPaths"}, "plan19_reconciliation": {"$ref": "#/$defs/repoPaths"}, "tests": {"$ref": "#/$defs/repoPaths"}}},
      "P5": {"type": "object", "additionalProperties": false, "required": ["runtime_policy_schema", "tests"], "properties": {"runtime_policy_schema": {"$ref": "#/$defs/repoPaths"}, "tests": {"$ref": "#/$defs/repoPaths"}}},
      "P6": {"type": "object", "additionalProperties": false, "required": ["fresh_test_roots", "rt7_reconciliation"], "properties": {"fresh_test_roots": {"$ref": "#/$defs/repoPaths"}, "rt7_reconciliation": {"$ref": "#/$defs/repoPaths"}}}
    }},
    "dirty_overlap_decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "owner", "decision", "authorization_evidence"], "properties": {"path": {"$ref": "#/$defs/repoPath"}, "owner": {"enum": ["user", "plan19", "plan21", "unknown"]}, "decision": {"enum": ["PROTECTED", "AUTHORIZED_FOR_P6", "NOT_PRESENT"]}, "authorization_evidence": {"type": ["string", "null"]}}}},
    "baseline_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "command", "status", "exit_code", "evidence_hash"], "properties": {"id": {"type": "string", "minLength": 4}, "command": {"type": "string", "minLength": 4}, "status": {"enum": ["PASS", "FAIL", "BLOCKED"]}, "exit_code": {"type": ["integer", "null"]}, "evidence_hash": {"$ref": "#/$defs/sha256"}}}},
    "capability_facts": {"type": "object", "additionalProperties": false, "required": ["claude_code", "codex_cli", "provider_overrides", "outer_sandbox"], "properties": {
      "claude_code": {"$ref": "#/$defs/claudeCapability"}, "codex_cli": {"$ref": "#/$defs/codexCapability"},
      "provider_overrides": {"type": "object", "additionalProperties": false, "required": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "OPENAI_API_KEY", "CODEX_ACCESS_TOKEN", "OPENAI_BASE_URL", "OPENAI_API_BASE", "MODEL_PROVIDER", "API_KEY_HELPER"], "properties": {"ANTHROPIC_API_KEY": {"type": "boolean"}, "CLAUDE_CODE_OAUTH_TOKEN": {"type": "boolean"}, "ANTHROPIC_BASE_URL": {"type": "boolean"}, "ANTHROPIC_AUTH_TOKEN": {"type": "boolean"}, "OPENAI_API_KEY": {"type": "boolean"}, "CODEX_ACCESS_TOKEN": {"type": "boolean"}, "OPENAI_BASE_URL": {"type": "boolean"}, "OPENAI_API_BASE": {"type": "boolean"}, "MODEL_PROVIDER": {"type": "boolean"}, "API_KEY_HELPER": {"type": "boolean"}}},
      "outer_sandbox": {"type": "object", "additionalProperties": false, "required": ["engine", "engine_version", "profile_sha256", "policy_digest", "resolved_roots", "mount_policy", "symlink_policy", "network", "credential_boundary"], "properties": {"engine": {"enum": ["sandbox-exec", "container", "vm", "other_verified"]}, "engine_version": {"type": "string", "minLength": 1}, "profile_sha256": {"$ref": "#/$defs/sha256"}, "policy_digest": {"$ref": "#/$defs/sha256"}, "resolved_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "purpose", "read", "write"], "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "purpose": {"enum": ["staged_input", "controller_output", "cli_binary", "temporary", "credential_broker"]}, "read": {"type": "boolean"}, "write": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"write": {"const": true}}}, "then": {"properties": {"read": {"const": true}}}}]}}, "mount_policy": {"const": "DENY_UNDECLARED"}, "symlink_policy": {"const": "REJECT_ESCAPE"}, "network": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "destinations"], "properties": {"mode": {"const": "DENY"}, "destinations": {"const": []}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "destinations"], "properties": {"mode": {"const": "ALLOWLIST"}, "destinations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]+$"}}}}]}, "credential_boundary": {"enum": ["BROKERED_OUTSIDE_SANDBOX", "NO_CREDENTIALS"]}}}
    }, "allOf": [
      {"if": {"properties": {"claude_code": {"properties": {"metering_mode": {"const": "INCLUDED_SUBSCRIPTION_ONLY"}}}}}, "then": {"properties": {"provider_overrides": {"properties": {"ANTHROPIC_API_KEY": {"const": false}, "CLAUDE_CODE_OAUTH_TOKEN": {"const": false}, "ANTHROPIC_BASE_URL": {"const": false}, "ANTHROPIC_AUTH_TOKEN": {"const": false}, "MODEL_PROVIDER": {"const": false}, "API_KEY_HELPER": {"const": false}}}}}},
      {"if": {"properties": {"codex_cli": {"properties": {"metering_mode": {"const": "INCLUDED_SUBSCRIPTION_ONLY"}}}}}, "then": {"properties": {"provider_overrides": {"properties": {"OPENAI_API_KEY": {"const": false}, "CODEX_ACCESS_TOKEN": {"const": false}, "OPENAI_BASE_URL": {"const": false}, "OPENAI_API_BASE": {"const": false}, "MODEL_PROVIDER": {"const": false}, "API_KEY_HELPER": {"const": false}}}}}}
    ]},
    "status_vocabularies": {"type": "object", "additionalProperties": false, "required": ["observed", "target"], "properties": {
      "observed": {"type": "object", "additionalProperties": false, "required": ["unit", "run", "plan"], "properties": {"unit": {"const": ["ACCEPTED", "BLOCKED"]}, "run": {"const": ["IN_PROGRESS", "PARTIAL", "INTERRUPTED", "BLOCKED", "COMPLETE"]}, "plan": {"const": ["draft", "qa", "approved", "blocked", "superseded"]}}},
      "target": {"type": "object", "additionalProperties": false, "required": ["unit", "run", "plan"], "properties": {"unit": {"const": ["ACCEPTED", "BLOCKED", "SYSTEM_FAILURE"]}, "run": {"const": ["IN_PROGRESS", "PARTIAL", "INTERRUPTED", "BLOCKED", "COMPLETE", "SYSTEM_FAILURE"]}, "plan": {"const": ["PLAN_APPROVED", "PAUSED_PREREQUISITE", "INTERRUPTED", "SYSTEM_FAILURE"]}}}
    }},
    "status_migration": {"type": "object", "additionalProperties": false, "required": ["owner", "preserve_observed", "added_status", "reason_schema", "checkpoint_semantics"], "properties": {"owner": {"const": "P4"}, "preserve_observed": {"const": true}, "added_status": {"const": "SYSTEM_FAILURE"}, "reason_schema": {"type": "string", "minLength": 8}, "checkpoint_semantics": {"const": "preserve_last_valid_fail_closed"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._{}:/-]+$"}, "repoPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}}, "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]+$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source", "observed_at", "evidence_hash"], "properties": {"source": {"type": "string", "minLength": 4}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_hash": {"$ref": "#/$defs/sha256"}}},
    "claudeCapability": {"type": "object", "additionalProperties": false, "required": ["version", "binary_sha256", "auth_class", "plan_subtype", "metering_mode", "separately_billed_credits_enabled", "api_fallback_enabled", "native_executed_model_available", "evidence"], "properties": {"version": {"type": "string"}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "auth_class": {"enum": ["CLAUDE_SUBSCRIPTION_OAUTH", "CONSOLE_OAUTH", "API_KEY", "LOGGED_OUT", "UNKNOWN"]}, "plan_subtype": {"enum": ["PRO", "MAX", "TEAM_STANDARD", "TEAM_PREMIUM", "ENTERPRISE_SEAT_STANDARD", "ENTERPRISE_SEAT_PREMIUM", "ENTERPRISE_USAGE_BASED", "UNPROVEN"]}, "metering_mode": {"enum": ["INCLUDED_SUBSCRIPTION_ONLY", "UNPROVEN", "SEPARATELY_BILLED"]}, "separately_billed_credits_enabled": {"type": "boolean"}, "api_fallback_enabled": {"type": "boolean"}, "native_executed_model_available": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/evidence"}}, "allOf": [{"if": {"properties": {"metering_mode": {"const": "INCLUDED_SUBSCRIPTION_ONLY"}}}, "then": {"properties": {"auth_class": {"const": "CLAUDE_SUBSCRIPTION_OAUTH"}, "plan_subtype": {"enum": ["PRO", "MAX", "TEAM_STANDARD", "TEAM_PREMIUM", "ENTERPRISE_SEAT_STANDARD", "ENTERPRISE_SEAT_PREMIUM"]}, "separately_billed_credits_enabled": {"const": false}, "api_fallback_enabled": {"const": false}}}}]},
    "codexCapability": {"type": "object", "additionalProperties": false, "required": ["version", "binary_sha256", "auth_class", "plan_subtype", "metering_mode", "chatgpt_credits_enabled", "api_fallback_enabled", "requested_model", "native_executed_model_available", "evidence"], "properties": {"version": {"type": "string"}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "auth_class": {"enum": ["CHATGPT_LOGIN", "API_KEY", "LOGGED_OUT", "UNKNOWN"]}, "plan_subtype": {"enum": ["PLUS", "PRO", "BUSINESS", "ENTERPRISE", "EDU", "UNPROVEN"]}, "metering_mode": {"enum": ["INCLUDED_SUBSCRIPTION_ONLY", "UNPROVEN", "SEPARATELY_BILLED"]}, "chatgpt_credits_enabled": {"type": "boolean"}, "api_fallback_enabled": {"type": "boolean"}, "requested_model": {"type": ["string", "null"]}, "native_executed_model_available": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/evidence"}}, "allOf": [{"if": {"properties": {"metering_mode": {"const": "INCLUDED_SUBSCRIPTION_ONLY"}}}, "then": {"properties": {"auth_class": {"const": "CHATGPT_LOGIN"}, "plan_subtype": {"enum": ["PLUS", "PRO", "BUSINESS", "ENTERPRISE", "EDU"]}, "chatgpt_credits_enabled": {"const": false}, "api_fallback_enabled": {"const": false}}}}]}
  }
}
