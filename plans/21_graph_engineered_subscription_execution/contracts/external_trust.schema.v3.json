  "allOf": [{"if": {"properties": {"status": {"const": "AVAILABLE"}}}, "then": {"properties": {"reason": {"type": "null"}, "authority_root": {"type": "string", "pattern": "^/"}, "authority_uid": {"type": "integer", "minimum": 0}, "controller_public_key_path": {"type": "string", "pattern": "^/"}, "controller_public_key_sha256": {"$ref": "#/$defs/sha"}, "operator_public_key_path": {"type": "string", "pattern": "^/"}, "operator_public_key_sha256": {"$ref": "#/$defs/sha"}}}}, {"if": {"properties": {"status": {"const": "UNAVAILABLE"}}}, "then": {"properties": {"reason": {"type": "string", "minLength": 8}, "authority_root": {"type": "null"}, "authority_uid": {"type": "null"}, "controller_public_key_path": {"type": "null"}, "controller_public_key_sha256": {"type": "null"}, "operator_public_key_path": {"type": "null"}, "operator_public_key_sha256": {"type": "null"}}}}],
