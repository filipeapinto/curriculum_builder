{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "test_receipt.schema.v3.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "receipt_id", "run_id", "node_id", "attempt", "test_id", "runner", "subject_digest", "command_digest", "exit_code", "assertions", "stdout_sha256", "stderr_sha256", "started_at", "completed_at", "signer_key_id", "signature"],
  "properties": {
    "version": {"const": "3.0"}, "receipt_id": {"$ref": "#/$defs/sha"}, "run_id": {"type": "string", "minLength": 8}, "node_id": {"type": "string", "pattern": "^P[0-6]$"}, "attempt": {"type": "integer", "minimum": 1}, "test_id": {"type": "string", "pattern": "^P[0-6]-T[0-9]{2}$"}, "runner": {"const": "DETERMINISTIC_TEST_RUNNER"}, "subject_digest": {"$ref": "#/$defs/sha"}, "command_digest": {"$ref": "#/$defs/sha"}, "exit_code": {"const": 0},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "observed_digest"], "properties": {"id": {"type": "string", "minLength": 3}, "status": {"const": "PASS"}, "observed_digest": {"$ref": "#/$defs/sha"}}}},
    "stdout_sha256": {"$ref": "#/$defs/sha"}, "stderr_sha256": {"$ref": "#/$defs/sha"}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "signer_key_id": {"type": "string", "minLength": 8}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }, "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
