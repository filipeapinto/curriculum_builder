{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan 26 implementation prompt graph v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "version", "source_spec", "schema", "runner", "entry", "result_pattern", "execution", "rules", "nodes", "edges", "rework_edges", "terminals"],
  "properties": {
    "graph_id": {"type": "string", "const": "plan26_langgraph_curriculum_factory_implementation"},
    "version": {"type": "integer", "const": 3},
    "source_spec": {"type": "string"},
    "schema": {"type": "string"},
    "runner": {"type": "string"},
    "entry": {"type": "string"},
    "result_pattern": {"type": "string"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "state_dir", "receipt_schema", "patch_schema", "patch_dir", "attempt_dir", "audit_log", "legacy_result_pattern", "workspace_mode", "workspace_log_dir", "python_candidates", "claude_command", "max_parallel", "node_timeout_seconds", "test_timeout_seconds", "cache"],
      "properties": {
        "controller": {"type": "string"},
        "state_dir": {"type": "string"},
        "receipt_schema": {"type": "string"},
        "patch_schema": {"type": "string"},
        "patch_dir": {"type": "string"},
        "attempt_dir": {"type": "string"},
        "audit_log": {"type": "string"},
        "legacy_result_pattern": {"type": "string"},
        "workspace_mode": {"const": "isolated_copy"},
        "workspace_log_dir": {"type": "string"},
        "python_candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "claude_command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 4},
        "node_timeout_seconds": {"type": "integer", "minimum": 60},
        "test_timeout_seconds": {"type": "integer", "minimum": 10},
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "environment_files"],
          "properties": {
            "strategy": {"const": "content_addressed"},
            "environment_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      }
    },
    "rules": {"type": "object", "required": ["success_requires_result_evidence", "allow_parallel_ready_nodes", "parallel_requires_disjoint_writes", "invalidate_descendants_on_rework", "max_same_finding_rework", "forbidden_production_imports"]},
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "depends_on", "writes", "verification", "test_lane"],
        "properties": {
          "prompt": {"type": "string"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "join": {"enum": ["all_of"]},
          "writes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "verification": {
            "type": "array",
            "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "test_lane": {"enum": ["contract", "focused", "join", "full", "live", "audit"]},
          "allowed_results": {"type": "array", "uniqueItems": true, "items": {"enum": ["PASSED", "NOT_AVAILABLE", "BLOCKED"]}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "type": {"enum": ["normal", "fan_out", "all_of"]}}
      }
    },
    "rework_edges": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "terminals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ACTIVATED", "IMPLEMENTED_NOT_ACTIVATED", "BLOCKED"],
      "properties": {"ACTIVATED": {"$ref": "#/$defs/terminal"}, "IMPLEMENTED_NOT_ACTIVATED": {"$ref": "#/$defs/terminal"}, "BLOCKED": {"$ref": "#/$defs/terminal"}}
    }
  },
  "$defs": {"terminal": {"type": "object", "additionalProperties": false, "required": ["guard"], "properties": {"guard": {"type": "string", "minLength": 1}}}}
}
