{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan 26 compact scheduler receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_digest",
    "node_definition_sha256",
    "node_id",
    "status",
    "input_fingerprint",
    "prompt_sha256",
    "outputs",
    "changed_files",
    "commands",
    "findings",
    "source",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"const": "plan26_langgraph_curriculum_factory_implementation"},
    "graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"enum": ["PASSED", "NOT_AVAILABLE", "BLOCKED"]},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outputs": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argv", "started_at", "finished_at", "exit_code", "timed_out", "log", "log_sha256", "tail"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "started_at": {"type": "string"},
          "finished_at": {"type": "string"},
          "exit_code": {"type": "integer"},
          "timed_out": {"type": "boolean"},
          "log": {"type": "string"},
          "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tail": {"type": "string", "maxLength": 4000}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["owner", "fingerprint", "summary"],
        "properties": {
          "owner": {"type": "string"},
          "fingerprint": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    },
    "source": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
