{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cdy55jFi1wFMyTJ4rtg4W","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EEapKUniyqCj83tisbZQi9","name":"Read","input":{"file_path":"/Users/filipepinto/Projects/curriculum_builder/tests/runtime/test_plan26_workbook.py","offset":100,"limit":330},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4966,"cache_read_input_tokens":141719,"cache_creation":{"ephemeral_5m_input_tokens":4966,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"5a0ecef2-20d2-4c32-96f0-6f27889fa197","timestamp":"2026-08-12T15:13:20.712Z","request_id":"req_011Cdy55hhSaRUExNHT3J2vS","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EEapKUniyqCj83tisbZQi9","type":"tool_result","content":"100\t            )\n101\t        return {\"pages\": pages}\n102\t\n103\t\n104\tclass _Context:\n105\t    def __init__(self, sandbox: Path, registry: Any = None) -> None:\n106\t        self.engine_root = REPO_ROOT\n107\t        self.output_root = sandbox\n108\t        self.transport_registry = registry or _Registry(sandbox)\n109\t        self.source_retriever = None\n110\t        self.signal_token = None\n111\t        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n112\t\n113\t\n114\tdef _unit_layout(tmp_path: Path, unit_id: str) -> tuple[dict[str, Any], str]:\n115\t    body = f\"unit-pdf-{unit_id}\".encode()\n116\t    path = tmp_path / f\"{unit_id}.pdf\"\n117\t    sha = _write(path, body)\n118\t    record = {\n119\t        \"stream\": stream_id(unit_id, \"layout\"),\n120\t        \"version\": 1,\n121\t        \"parent_hash\": None,\n122\t        \"hash\": canonical_digest({\"unit\": unit_id, \"pdf\": sha}),\n123\t        \"pdf_path\": str(path),\n124\t        \"pdf_sha256\": sha,\n125\t    }\n126\t    return record, sha\n127\t\n128\t\n129\tdef _accepted_receipt(unit_id: str, pdf_sha256: str) -> dict[str, Any]:\n130\t    denominator = {\"pages\": {\"result\": \"PASS\", \"pdf_sha256\": pdf_sha256, \"page_count\": 1}}\n131\t    body = {\"unit_id\": unit_id, \"denominator\": denominator, \"artifact_head_hashes\": {}, \"log_high_water_mark\": 0}\n132\t    receipt = dict(body)\n133\t    receipt[\"receipt_hash\"] = canonical_digest(body)\n134\t    return receipt\n135\t\n136\t\n137\tdef _base_state(tmp_path: Path, unit_ids: tuple[str, ...] = (U1, U2)) -> dict[str, Any]:\n138\t    artifact_versions = []\n139\t    accepted: dict[str, Any] = {}\n140\t    for unit_id in unit_ids:\n141\t        layout, sha = _unit_layout(tmp_path, unit_id)\n142\t        artifact_versions.append(layout)\n143\t        accepted[unit_id] = _accepted_receipt(unit_id, sha)\n144\t    return {\n145\t        \"run_id\": RUN,\n146\t        \"episode_id\": EPISODE,\n147\t        \"mode\": \"all\",\n148\t        \"requested_unit_id\": None,\n149\t        \"effective_run\": {\"target_closure\": list(unit_ids), \"ordered_unit_ids\": list(unit_ids)},\n150\t        \"accepted_unit_receipts\": accepted,\n151\t        \"artifact_versions\": artifact_versions,\n152\t        \"checkpoint_metadata\": [{\"checkpoint_id\": \"ckpt-1\"}],\n153\t        \"evidence_index_entries\": [],\n154\t        \"engine_root\": str(REPO_ROOT),\n155\t        \"workbook_coverage\": [],\n156\t        \"workbook_versions\": [],\n157\t        \"workbook_head\": {},\n158\t        \"workbook_page_inventories\": [],\n159\t        \"workbook_page_inspections\": [],\n160\t        \"workbook_reviews\": [],\n161\t        \"workbook_review_packets\": [],\n162\t        \"workbook_finding_partitions\": [],\n163\t        \"workbook_repair_requests\": [],\n164\t        \"workbook_retests\": [],\n165\t        \"final_release_audits\": [],\n166\t        \"attempt_counters\": {},\n167\t        \"deterministic_checks\": [],\n168\t    }\n169\t\n170\t\n171\tdef _review_candidate(pdf_sha256: str, inspections: list[dict[str, Any]]) -> dict[str, Any]:\n172\t    return {\n173\t        \"key\": f\"candidate:m07:{pdf_sha256}\",\n174\t        \"record_kind\": \"model_candidate\",\n175\t        \"job_id\": \"M07_REVIEW_ACTUAL_WORKBOOK\",\n176\t        \"workbook_pdf_sha256\": pdf_sha256,\n177\t        \"page_count\": len(inspections),\n178\t        \"payload\": {\n179\t            \"overall_findings\": [],\n180\t            \"page_findings\": [\n181\t                {\"page_number\": record[\"page\"], \"page_sha256\": record[\"page_sha256\"], \"findings\": []}\n182\t                for record in inspections\n183\t            ],\n184\t        },\n185\t    }\n186\t\n187\t\n188\tdef _assemble_and_review(tmp_path: Path, sandbox: Path, unit_ids: tuple[str, ...] = (U1, U2)) -> dict[str, Any]:\n189\t    \"\"\"D24 -> D25 -> D26 -> D27 -> (a clean M07 candidate) -> D28, all real calls.\"\"\"\n190\t\n191\t    state = _base_state(tmp_path, unit_ids)\n192\t    context = _Context(sandbox)\n193\t\n194\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, context))\n195\t    assert state[\"pending_guard\"][\"value\"] == \"manifest_coverage_proven\"\n196\t\n197\t    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, context))\n198\t    assert state[\"pending_guard\"][\"value\"] == \"workbook_assembled\"\n199\t\n200\t    state = _apply(state, workbook.D26_RENDER_INVENTORY_INSPECT_WORKBOOK(state, context))\n201\t    assert state[\"pending_guard\"][\"value\"] == \"workbook_pages_inspected\"\n202\t\n203\t    state = _apply(state, workbook.D27_FREEZE_WORKBOOK_REVIEW_PACKET(state, context))\n204\t    assert state[\"pending_guard\"][\"value\"] == \"workbook_packet_frozen\"\n205\t\n206\t    pdf_sha256 = state[\"workbook_page_inventories\"][-1][\"pdf_sha256\"]\n207\t    review = _review_candidate(pdf_sha256, state[\"workbook_page_inspections\"])\n208\t    state = _apply(state, {\"workbook_reviews\": [review]})\n209\t    return state\n210\t\n211\t\n212\t# ---------------------------------------------------------------------------\n213\t# TEST 1: missing/extra/reordered/wrong-hash unit blocks assembly\n214\t# ---------------------------------------------------------------------------\n215\t\n216\t\n217\tdef test_d24_all_mode_rejects_a_manifest_that_is_missing_a_receipt(tmp_path: Path) -> None:\n218\t    state = _base_state(tmp_path)\n219\t    del state[\"accepted_unit_receipts\"][U2]\n220\t    with pytest.raises(SystemFailure):\n221\t        workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n222\t\n223\t\n224\tdef test_d24_all_mode_rejects_an_extra_receipt_outside_the_manifest(tmp_path: Path) -> None:\n225\t    state = _base_state(tmp_path)\n226\t    state[\"accepted_unit_receipts\"][\"U999\"] = _accepted_receipt(\"U999\", \"f\" * 64)\n227\t    # Extra receipts are harmless to D24's own predicate (it only requires\n228\t    # every *closure* member accepted); the coverage proof still names\n229\t    # exactly the manifest order, never the stray extra member.\n230\t    update = workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n231\t    assert update[\"workbook_coverage\"][0][\"ordered_unit_ids\"] == [U1, U2]\n232\t    assert \"U999\" not in update[\"workbook_coverage\"][0][\"receipt_hashes\"]\n233\t\n234\t\n235\tdef test_d25_rejects_an_assembly_map_the_assembler_reordered(tmp_path: Path) -> None:\n236\t    \"\"\"A local assembler that reorders/renames the assembly map never ships.\"\"\"\n237\t\n238\t    sandbox = tmp_path / \"sandbox\"\n239\t    state = _base_state(tmp_path)\n240\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n241\t\n242\t    registry = _Registry(sandbox)\n243\t    original = registry.assemble_workbook\n244\t\n245\t    def _reordered(ordered_unit_ids: Any, unit_pdf_hashes: Any, front_matter: Any) -> dict[str, Any]:\n246\t        result = original(ordered_unit_ids, unit_pdf_hashes, front_matter)\n247\t        result[\"assembly_map\"] = list(reversed(result[\"assembly_map\"]))\n248\t        return result\n249\t\n250\t    registry.assemble_workbook = _reordered  # type: ignore[method-assign]\n251\t    with pytest.raises(SystemFailure) as error:\n252\t        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox, registry))\n253\t    assert error.value.cause == \"integrity\"\n254\t\n255\t\n256\tdef test_d25_refuses_a_unit_pdf_that_changed_after_acceptance(tmp_path: Path) -> None:\n257\t    sandbox = tmp_path / \"sandbox\"\n258\t    state = _base_state(tmp_path)\n259\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n260\t\n261\t    # Mutate the on-disk bytes of one accepted unit's PDF after coverage was\n262\t    # proven: byte-for-byte immutability (spec section 13.2 item 2) is checked\n263\t    # again, freshly, at assembly.\n264\t    layout = next(r for r in state[\"artifact_versions\"] if r[\"stream\"] == stream_id(U1, \"layout\"))\n265\t    Path(layout[\"pdf_path\"]).write_bytes(b\"tampered\")\n266\t\n267\t    with pytest.raises(SystemFailure) as error:\n268\t        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox))\n269\t    assert error.value.cause == \"integrity\"\n270\t\n271\t\n272\tdef test_d25_refuses_a_wrong_hash_layout_version(tmp_path: Path) -> None:\n273\t    sandbox = tmp_path / \"sandbox\"\n274\t    state = _base_state(tmp_path)\n275\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n276\t    # The layout version itself now disagrees with the accepted receipt's\n277\t    # frozen hash -- a stale/rewritten layout, not a stale-disk-bytes case.\n278\t    state[\"artifact_versions\"] = [\n279\t        {**record, \"pdf_sha256\": \"0\" * 64} if record[\"stream\"] == stream_id(U1, \"layout\") else record\n280\t        for record in state[\"artifact_versions\"]\n281\t    ]\n282\t    with pytest.raises(SystemFailure):\n283\t        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox))\n284\t\n285\t\n286\t# ---------------------------------------------------------------------------\n287\t# TEST 2: positive contiguous workbook inventory, every page reaches M07\n288\t# ---------------------------------------------------------------------------\n289\t\n290\t\n291\tdef test_workbook_assembly_through_review_freezes_every_page_once(tmp_path: Path) -> None:\n292\t    sandbox = tmp_path / \"sandbox\"\n293\t    state = _assemble_and_review(tmp_path, sandbox)\n294\t\n295\t    inventory = state[\"workbook_page_inventories\"][-1]\n296\t    assert inventory[\"result\"] == \"PASS\"\n297\t    assert inventory[\"contiguous\"] is True\n298\t    assert inventory[\"page_count\"] == 2\n299\t\n300\t    packet = state[\"workbook_review_packets\"][-1]\n301\t    assert packet[\"page_count\"] == 2\n302\t    assert len(packet[\"page_keys\"]) == 2\n303\t    assert len(set(packet[\"page_keys\"])) == 2\n304\t    assert packet[\"accepted_unit_hashes\"] == {\n305\t        U1: state[\"accepted_unit_receipts\"][U1][\"denominator\"][\"pages\"][\"pdf_sha256\"],\n306\t        U2: state[\"accepted_unit_receipts\"][U2][\"denominator\"][\"pages\"][\"pdf_sha256\"],\n307\t    }\n308\t\n309\t    dispatched = state[\"pending_packet\"][\"packets\"]\n310\t    assert len(dispatched) == 1\n311\t    projected_pages = dispatched[0][\"pages\"]\n312\t    assert [p[\"page_number\"] for p in projected_pages] == [1, 2]\n313\t    assert [p[\"page_sha256\"] for p in projected_pages] == [\n314\t        record[\"page_sha256\"] for record in state[\"workbook_page_inspections\"]\n315\t    ]\n316\t\n317\t\n318\t@pytest.mark.parametrize(\"defect\", [\"empty\", \"non_contiguous\"])\n319\tdef test_workbook_inventory_that_cannot_be_proven_is_repairable_not_shipped(tmp_path: Path, defect: str) -> None:\n320\t    sandbox = tmp_path / \"sandbox\"\n321\t    state = _base_state(tmp_path)\n322\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n323\t\n324\t    registry = _Registry(sandbox)\n325\t    if defect == \"empty\":\n326\t        registry.inspect_workbook_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n327\t    else:\n328\t        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n329\t            report = _Registry.inspect_workbook_pages(registry, pdf_path, pdf_sha256)\n330\t            report[\"pages\"][-1][\"number\"] = 9\n331\t            return report\n332\t\n333\t        registry.inspect_workbook_pages = _skewed  # type: ignore[method-assign]\n334\t\n335\t    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox, registry)))\n336\t    update = workbook.D26_RENDER_INVENTORY_INSPECT_WORKBOOK(state, _Context(sandbox, registry))\n337\t    assert update[\"workbook_page_inventories\"][0][\"result\"] == \"FAIL\"\n338\t    assert update[\"pending_guard\"][\"value\"] == \"workbook_layout_repairable\"\n339\t    merged = {**state, **update}\n340\t    assert R.route_workbook_inspection(merged) == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n341\t\n342\t\n343\t# ---------------------------------------------------------------------------\n344\t# TEST 3: missing/stale/failed/NOT_RUN workbook evidence blocks release\n345\t# ---------------------------------------------------------------------------\n346\t\n347\t\n348\t@pytest.mark.parametrize(\n349\t    \"mutate\",\n350\t    [\n351\t        lambda s: s.__setitem__(\"workbook_coverage\", []),\n352\t        lambda s: s.__setitem__(\"workbook_page_inspections\", []),\n353\t        lambda s: s.__setitem__(\n354\t            \"workbook_page_inventories\",\n355\t            [{**s[\"workbook_page_inventories\"][-1], \"result\": \"FAIL\"}],\n356\t        ),\n357\t        lambda s: s.__setitem__(\"workbook_reviews\", []),\n358\t    ],\n359\t    ids=[\"coverage_missing\", \"pages_missing\", \"inventory_failed\", \"review_not_run\"],\n360\t)\n361\tdef test_removing_or_failing_any_evidence_member_blocks_the_denominator(tmp_path: Path, mutate: Any) -> None:\n362\t    sandbox = tmp_path / \"sandbox\"\n363\t    state = _assemble_and_review(tmp_path, sandbox)\n364\t    mutate(state)\n365\t    result = workbook.compute_workbook_denominator(state)\n366\t    assert not result.passed\n367\t\n368\t\n369\tdef test_the_full_denominator_passes_once_every_member_is_current(tmp_path: Path) -> None:\n370\t    sandbox = tmp_path / \"sandbox\"\n371\t    state = _assemble_and_review(tmp_path, sandbox)\n372\t    result = workbook.compute_workbook_denominator(state)\n373\t    assert result.passed, result.denominator\n374\t\n375\t\n376\t# ---------------------------------------------------------------------------\n377\t# TEST 4: M08/deterministic repair cannot alter accepted unit hashes\n378\t# ---------------------------------------------------------------------------\n379\t\n380\t\n381\tdef _repairable_layout_state(tmp_path: Path, sandbox: Path) -> dict[str, Any]:\n382\t    \"\"\"A workbook one deterministic layout finding away from repair.\"\"\"\n383\t\n384\t    state = _base_state(tmp_path)\n385\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n386\t    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox)))\n387\t    state[\"pending_guard\"] = {\n388\t        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n389\t        \"value\": \"workbook_layout_repairable\",\n390\t        \"detail\": {\n391\t            \"findings\": [\n392\t                {\"component\": \"layout\", \"check_id\": \"workbook_page_inventory\", \"pointer\": \"/assembly/pages\", \"message\": \"bad\"}\n393\t            ]\n394\t        },\n395\t    }\n396\t    return state\n397\t\n398\t\n399\tdef test_a_deterministic_layout_repair_never_touches_accepted_unit_hashes(tmp_path: Path) -> None:\n400\t    sandbox = tmp_path / \"sandbox\"\n401\t    state = _repairable_layout_state(tmp_path, sandbox)\n402\t    plan = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n403\t    assert plan[\"pending_guard\"][\"value\"] == \"deterministic_repair\"\n404\t    candidate = plan[\"workbook_versions\"][0]\n405\t    parent_hashes = state[\"workbook_head\"][\"workbook\"]\n406\t    parent_version = next(v for v in state[\"workbook_versions\"] if v[\"hash\"] == parent_hashes[\"hash\"])\n407\t    assert candidate[\"body\"][\"coverage\"][\"unit_pdf_hashes\"] == parent_version[\"body\"][\"coverage\"][\"unit_pdf_hashes\"]\n408\t\n409\t    admitted = _apply(_apply(state, plan), {})\n410\t    update = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(admitted, None)\n411\t    assert update[\"pending_guard\"][\"value\"] == \"workbook_repair_admitted\"\n412\t    assert update[\"workbook_versions\"][0][\"body\"][\"coverage\"][\"unit_pdf_hashes\"] == parent_version[\"body\"][\"coverage\"][\"unit_pdf_hashes\"]\n413\t\n414\t\n415\tdef test_d31_refuses_a_model_candidate_that_changes_an_accepted_unit_hash(tmp_path: Path) -> None:\n416\t    sandbox = tmp_path / \"sandbox\"\n417\t    state = _repairable_layout_state(tmp_path, sandbox)\n418\t    state[\"pending_guard\"] = {\n419\t        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n420\t        \"value\": \"workbook_layout_repairable\",\n421\t        \"detail\": {\n422\t            \"findings\": [\n423\t                {\"component\": \"front_matter\", \"check_id\": \"x\", \"pointer\": \"/front_matter\", \"message\": \"bad\"}\n424\t            ]\n425\t        },\n426\t    }\n427\t    plan = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n428\t    assert plan[\"pending_guard\"][\"value\"] == \"model_repair\"\n429\t    state = _apply(state, plan)"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"268e7cb9-b0a8-440b-ab87-5a434eba0cc7","timestamp":"2026-08-12T15:13:20.721Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
