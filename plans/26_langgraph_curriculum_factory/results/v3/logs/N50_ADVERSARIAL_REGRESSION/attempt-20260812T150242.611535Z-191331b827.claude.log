{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016o4Ys15oPG93pUdyPLVNPo","type":"tool_result","content":"520\t    assert update[\"cursor\"][\"accepted_ordinal\"] == 1\n521\t    assert update[\"checkpoint_metadata\"][0][\"checkpoint_id\"]\n522\t    assert update[\"accepted_unit_checkpoint_receipts\"][0][\"checkpoint_id\"] == update[\"checkpoint_metadata\"][0][\"checkpoint_id\"]\n523\t\n524\t\n525\tdef test_d23_refuses_to_advance_the_cursor_with_no_accepted_receipt() -> None:\n526\t    state = _passing_state()\n527\t    with pytest.raises(SystemFailure):\n528\t        acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n529\t\n530\t\n531\t# ---------------------------------------------------------------------------\n532\t# TEST 8: D24-shaped coverage rejects missing/extra/reordered/wrong-hash\n533\t# ---------------------------------------------------------------------------\n534\t\n535\t\n536\tdef test_coverage_proof_rejects_missing_extra_reordered_and_wrong_hash() -> None:\n537\t    receipts = {\n538\t        \"U001\": {\"receipt_hash\": \"1\" * 64},\n539\t        \"U002\": {\"receipt_hash\": \"2\" * 64},\n540\t    }\n541\t    ordered = [\"U001\", \"U002\"]\n542\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n543\t        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}]\n544\t    )\n545\t    assert passed and not rejections\n546\t\n547\t    # missing\n548\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n549\t        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}]\n550\t    )\n551\t    assert not passed\n552\t\n553\t    # extra\n554\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n555\t        ordered, receipts,\n556\t        [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}, {\"unit_id\": \"U003\", \"receipt_hash\": \"3\" * 64}],\n557\t    )\n558\t    assert not passed\n559\t\n560\t    # reordered\n561\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n562\t        ordered, receipts, [{\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}, {\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}]\n563\t    )\n564\t    assert not passed\n565\t\n566\t    # wrong hash\n567\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n568\t        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"0\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}]\n569\t    )\n570\t    assert not passed\n571\t\n572\t\n573\t# ---------------------------------------------------------------------------\n574\t# TEST 9: real D98 traverses one-mode success and unit-failure candidates\n575\t# ---------------------------------------------------------------------------\n576\t\n577\t\n578\tdef _d98_projection(state: dict[str, Any]) -> dict[str, Any]:\n579\t    from runtime.langgraph_factory.nodes import project\n580\t\n581\t    full = {\n582\t        **state,\n583\t        \"terminal\": None,\n584\t        \"terminal_history\": [],\n585\t        \"mode\": \"one\",\n586\t        \"requested_unit_id\": UNIT,\n587\t        \"final_release_audits\": [],\n588\t        \"workbook_head\": {},\n589\t        \"failure_fingerprints\": [],\n590\t        \"resume_frontier\": None,\n591\t        \"pending_failure\": None,\n592\t        \"output_root\": \"/tmp/out\",\n593\t    }\n594\t    return project(\"D98_WRITE_TERMINAL\", full)\n595\t\n596\t\n597\tdef test_a_unit_accepted_candidate_traverses_the_real_d98_and_is_accepted() -> None:\n598\t    assert terminal.write_terminal.__module__ == \"runtime.langgraph_factory.nodes.terminal\"\n599\t\n600\t    state = _passing_state()\n601\t    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n602\t    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n603\t\n604\t    receipt = state[\"accepted_unit_receipts\"][UNIT]\n605\t    checkpoint = state[\"checkpoint_metadata\"][-1]\n606\t    state[\"terminal_candidate\"] = {\n607\t        \"kind\": \"UNIT_ACCEPTED\",\n608\t        \"unit_id\": UNIT,\n609\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n610\t        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]},\n611\t        \"denominator\": receipt[\"denominator\"],\n612\t        \"log_high_water_mark\": 0,\n613\t        \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n614\t    }\n615\t    projection = _d98_projection(state)\n616\t    record = terminal.write_terminal(projection, None)\n617\t    assert record[\"terminal\"][\"kind\"] == \"UNIT_ACCEPTED\"\n618\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n619\t\n620\t\n621\tdef test_a_tampered_unit_accepted_candidate_is_rejected_by_the_real_d98() -> None:\n622\t    state = _passing_state()\n623\t    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n624\t    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n625\t    receipt = state[\"accepted_unit_receipts\"][UNIT]\n626\t    checkpoint = state[\"checkpoint_metadata\"][-1]\n627\t    state[\"terminal_candidate\"] = {\n628\t        \"kind\": \"UNIT_ACCEPTED\",\n629\t        \"unit_id\": UNIT,\n630\t        \"receipt_hash\": \"not-the-real-hash\",\n631\t        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]},\n632\t        \"denominator\": receipt[\"denominator\"],\n633\t        \"log_high_water_mark\": 0,\n634\t        \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n635\t    }\n636\t    projection = _d98_projection(state)\n637\t    record = terminal.write_terminal(projection, None)\n638\t    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n639\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"50c4c44a-f100-46fa-