{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019gEMnon1xKwkMg47Sw3Sxw","type":"tool_result","content":"76\tclass ImportGraphAuditTests(unittest.TestCase):\n77\t    \"\"\"No node reads this file; it is read once, at collection time.\"\"\"\n78\t\n79\t    def _imported_names(self) -> list[tuple[str, str]]:\n80\t        \"\"\"Every `(module, attribute)` this file imports, `attribute` \"\" for a bare import.\"\"\"\n81\t        found: list[tuple[str, str]] = []\n82\t        for node in ast.walk(CLI_AST):\n83\t            if isinstance(node, ast.ImportFrom):\n84\t                module = node.module or \"\"\n85\t                for alias in node.names:\n86\t                    found.append((module, alias.name))\n87\t            elif isinstance(node, ast.Import):\n88\t                for alias in node.names:\n89\t                    found.append((alias.name, \"\"))\n90\t        return found\n91\t\n92\t    def test_no_plan25_or_legacy_runtime_modules_are_imported(self):\n93\t        forbidden_modules = {\n94\t            \"runtime.controller\",\n95\t            \"runtime.curriculum_factory_graph\",\n96\t            \"runtime.model_worker\",\n97\t            \"runtime.session_bridge\",\n98\t            \"runtime.checks\",\n99\t            \"runtime.checkpoint\",\n100\t            \"runtime.capability_cycle\",\n101\t        }\n102\t        forbidden_names = {\"CurriculumFactoryGraph\", \"CodexWorker\", \"CurriculumRuntime\", \"GeminiReviewer\"}\n103\t        for module, name in self._imported_names():\n104\t            self.assertNotIn(module, forbidden_modules, f\"legacy module imported: {module}\")\n105\t            self.assertNotIn(name, forbidden_names, f\"legacy symbol imported: {name}\")\n106\t\n107\t    def test_only_two_narrow_pure_helpers_are_imported_from_nodes_inputs(self):\n108\t        \"\"\"The one declared exception: identity/freeze helpers, not node bodies.\"\"\"\n109\t        from_nodes = sorted(name for module, name in self._imported_names() if module.endswith(\"nodes.inputs\"))\n110\t        self.assertEqual(from_nodes, [\"REQUIRED_CAPABILITIES\", \"_frozen_input_records\", \"_resolve_active_manifest\"])\n111\t\n112\t    def test_no_import_from_any_other_nodes_or_routing_or_workbook_module(self):\n113\t        forbidden_module_suffixes = (\n114\t            \"nodes.domain\", \"nodes.content\", \"nodes.sources\", \"nodes.render\",\n115\t            \"nodes.review\", \"nodes.visuals\", \"nodes.terminal\", \"nodes\",\n116\t            \"routing\", \"workbook\", \"unit_graph\", \"model_nodes\", \"repair\",\n117\t        )\n118\t        for module, _name in self._imported_names():\n119\t            if module.endswith(\"nodes.inputs\") or module in (\"runtime.langgraph_factory.graph\",):\n120\t                continue\n121\t            for suffix in forbidden_module_suffixes:\n122\t                self.assertFalse(\n123\t                    module == f\"runtime.langgraph_factory.{suffix}\" or module.endswith(f\".{suffix}\"),\n124\t                    f\"unexpected node/topology import: {module}\",\n125\t                )\n126\t\n127\t    def test_no_langchain_provider_sdk_or_direct_http_imports(self):\n128\t        forbidden = (\"langchain\", \"openai\", \"anthropic\", \"google.generativeai\", \"requests\", \"httpx\", \"urllib3\")\n129\t        for module, name in self._imported_names():\n130\t            haystack = f\"{module}.{name}\".lower()\n131\t            for bad in forbidden:\n132\t                self.assertNotIn(bad, haystack, f\"forbidden provider/HTTP import: {module} / {name}\")\n133\t\n134\t    def test_no_product_node_or_guard_identifiers_appear_in_source(self):\n135\t        \"\"\"D00-D98 and M01-M08 are never named: the CLI cannot call, route, or\n136\t        guard against a node it never imports.\"\"\"\n137\t        node_id_pattern = re.compile(r\"\\b(?:D\\d{2}[A-Z0-9_]*|M0[1-8][A-Z0-9_]*)\\b\")\n138\t        hits = sorted(set(node_id_pattern.findall(CLI_SOURCE)))\n139\t        self.assertEqual(hits, [], f\"CLI source names product node IDs: {hits}\")\n140\t\n141\t    def test_build_curriculum_factory_graph_is_the_only_graph_builder_referenced(self):\n142\t        self.assertIn(\"build_curriculum_factory_graph\", CLI_SOURCE)\n143\t        self.assertNotIn(\"register_workbook_topology\", CLI_SOURCE)\n144\t        self.assertNotIn(\"register_skeleton\", CLI_SOURCE)\n145\t        self.assertNotIn(\".compile(\", CLI_SOURCE)\n146\t\n147\t    def test_graph_builder_is_called_at_most_once_per_execution_path(self):\n148\t        \"\"\"Each of the two live-mode branches (fresh, resume) calls it exactly\n149\t        once; the source has exactly two call sites, one per branch.\"\"\"\n150\t        calls = re.findall(r\"build_curriculum_factory_graph\\(\", CLI_SOURCE)\n151\t        self.assertEqual(len(calls), 2)\n152\t\n153\t\n154\t# ===========================================================================\n155\t# TEST 2 — help surface\n156\t# ===========================================================================\n157\t\n158\t\n159\tclass HelpSurfaceTests(unittest.TestCase):\n160\t    def setUp(self):\n161\t        self.help_text = R.build_parser().format_help()\n162\t\n163\t    def test_spec_section_16_flags_are_present(self):\n164\t        for flag in (\"--engine-root\", \"--curriculum\", \"--output-root\", \"--preflight\",\n165\t                     \"--unit\", \"--all\", \"--resume\", \"--authorization\"):\n166\t            self.assertIn(flag, self.help_text)\n167\t\n168\t    def test_no_legacy_simulation_or_session_bridge_or_custom_controller_flags(self):\n169\t        legacy_flags = (\n170\t            \"--lab-id\", \"--model\", \"--test-static\", \"--test-simulated-all\",\n171\t            \"--test-live-capabilities\", \"--test-golden-l01\", \"--interrupt-after\",\n172\t            \"--max-lab-seconds\", \"--phase-timeout-seconds\", \"--max-run-seconds\",\n173\t        )\n174\t        for flag in legacy_flags:\n175\t            self.assertNotIn(flag, self.help_text)\n176\t\n177\t\n178\t# ===========================================================================\n179\t# TEST 3 — argument shape, canonical paths, exit codes\n180\t# ===========================================================================\n181\t\n182\t\n183\tclass ArgumentValidationTests(unittest.TestCase):\n184\t    def test_mode_flags_are_mutually_exclusive(self):\n185\t        parser = R.build_parser()\n186\t        with self.assertRaises(SystemExit):\n187\t            parser.parse_args([\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\",\n188\t                                \"--unit\", \"L01\", \"--all\"])\n189\t\n190\t    def test_at_least_one_mode_flag_is_required(self):\n191\t        parser = R.build_parser()\n192\t        with self.assertRaises(SystemExit):\n193\t            parser.parse_args([\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\"])\n194\t\n195\t    def test_authorization_required_for_unit_all_resume(self):\n196\t        parser = R.build_parser()\n197\t        for mode_args in ([\"--unit\", \"L01\"], [\"--all\"], [\"--resume\"]):\n198\t            args = parser.parse_args(\n199\t                [\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\", *mode_args]\n200\t            )\n201\t            with self.assertRaises(R.CliArgumentError):\n202\t                R._validate_args(args)\n203\t\n204\t    def test_preflight_rejects_authorization(self):\n205\t        parser = R.build_parser()\n206\t        args = parser.parse_args(\n207\t            [\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\",\n208\t             \"--preflight\", \"--authorization\", \"auth.json\"]\n209\t        )\n210\t        with self.assertRaises(R.CliArgumentError):\n211\t            R._validate_args(args)\n212\t\n213\t    def test_curriculum_root_resolves_manifest_file_to_parent_directory(self, tmp_path=None):\n214\t        import tempfile\n215\t        with tempfile.TemporaryDirectory() as raw:\n216\t            root = Path(raw)\n217\t            manifest = root / \"curricula\" / \"arduino_kit\" / \"arduino_kit_curriculum.v5.yaml\"\n218\t            manifest.parent.mkdir(parents=True)\n219\t            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n220\t            self.assertEqual(R._resolve_curriculum_root(str(manifest)), manifest.parent.resolve())\n221\t            self.assertEqual(R._resolve_curriculum_root(str(manifest.parent)), manifest.parent.resolve())\n222\t\n223\t    def test_curriculum_root_missing_path_is_an_argument_error(self):\n224\t        with self.assertRaises(R.CliArgumentError):\n225\t            R._resolve_curriculum_root(\"/definitely/does/not/exist/for/plan26\")\n226\t\n227\t    def test_authorization_file_must_be_a_json_object_with_required_fields(self):\n228\t        import tempfile\n229\t        with tempfile.TemporaryDirectory() as raw:\n230\t            root = Path(raw)\n231\t            not_json = root / \"bad.json\"\n232\t            not_json.write_text(\"not json\", encoding=\"utf-8\")\n233\t            with self.assertRaises(R.CliArgumentError):\n234\t                R._read_authorization(str(not_json))\n235\t\n236\t            not_object = root / \"list.json\"\n237\t            not_object.write_text(\"[]\", encoding=\"utf-8\")\n238\t            with self.assertRaises(R.CliArgumentError):\n239\t                R._read_authorization(str(not_object))\n240\t\n241\t            incomplete = root / \"incomplete.json\"\n242\t            incomplete.write_text(json.dumps({\"providers\": {}}), encoding=\"utf-8\")\n243\t            with self.assertRaises(R.CliArgumentError):\n244\t                R._read_authorization(str(incomplete))\n245\t\n246\t            missing = root / \"missing.json\"\n247\t            with self.assertRaises(R.CliArgumentError):\n248\t                R._read_authorization(str(missing))\n249\t\n250\t    def test_collision_reason_for_fresh_output_root(self):\n251\t        import tempfile\n252\t        with tempfile.TemporaryDirectory() as raw:\n253\t            root = Path(raw)\n254\t            nonexistent = root / \"does-not-exist-yet\"\n255\t            self.assertIsNone(R._collision_reason(nonexistent))\n256\t\n257\t            empty = root / \"empty\"\n258\t            empty.mkdir()\n259\t            self.assertIsNone(R._collision_reason(empty))\n260\t\n261\t            dirty = root / \"dirty\"\n262\t            dirty.mkdir()\n263\t            (dirty / \"leftover.txt\").write_text(\"x\", encoding=\"utf-8\")\n264\t            self.assertIsNotNone(R._collision_reason(dirty))\n265\t"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"c32e2640-1948-43af-aa26-23ef0cf0cc2c","timestamp":"2026-08-12T15:13:07.632Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
