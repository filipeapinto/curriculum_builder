{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VV6skinyiRyoXcAwBSopS6","type":"tool_result","content":"1824\t    )\n1825\t    compiled = G.build_curriculum_factory_graph(\n1826\t        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n1827\t    )\n1828\t\n1829\t    # Simulate the power loss: stop consuming the stream mid-episode and never\n1830\t    # let D98 run, leaving the episode lease open.\n1831\t    executed: list[str] = []\n1832\t    stream = compiled.stream(\n1833\t        {\"invocation\": envelope},\n1834\t        config=invocation.config,\n1835\t        stream_mode=\"updates\",\n1836\t        context=context,\n1837\t    )\n1838\t    for chunk in stream:\n1839\t        executed.extend(chunk)\n1840\t        if \"D04_INITIALIZE_OR_RESUME\" in chunk:\n1841\t            break\n1842\t    stream.close()\n1843\t\n1844\t    committed = compiled.get_state(invocation.config)\n1845\t    assert committed.values.get(\"terminal\") is None\n1846\t    assert committed.values[\"run_id\"]\n1847\t\n1848\t    # The recovery path reads the orphan and prepares a *new* thread for it.\n1849\t    ledger = P.EpisodeLeaseLedger(fixture[\"output_root\"])\n1850\t    orphan = ledger.open_lease()\n1851\t    assert orphan is not None\n1852\t    assert orphan[\"thread_id\"] == invocation.thread_id\n1853\t    saver, _connection = P.open_checkpoint_saver(fixture[\"output_root\"])\n1854\t    view = P.ReadOnlyCheckpointView(compiled, saver)\n1855\t    readout = P.extract_prior_episode(view, invocation.thread_id)\n1856\t    assert readout is not None\n1857\t    assert readout.terminal is None, \"an orphan holds no terminal\"\n1858\t    assert readout.next, \"a crashed episode must expose an incomplete frontier\"\n1859\t    for node_id in readout.next:\n1860\t        assert not str(node_id).startswith((\"M0\",)), (\n1861\t            \"a model node may never be stored as a resume destination\"\n1862\t        )\n1863\t    lock.release()\n1864\t\n1865\t\n1866\t# ---------------------------------------------------------------------------\n1867\t# Dependency gaps: every one this node ever raised is now closed, and each is\n1868\t# kept below as the regression that would catch its reversal.\n1869\t# ---------------------------------------------------------------------------\n1870\t\n1871\t\n1872\tdef test_every_blocking_gap_is_declared_with_an_owner_and_rework_edge() -> None:\n1873\t    \"\"\"`BLOCKING_GAPS` is empty, and any future row still has to be well formed.\n1874\t\n1875\t    B-1 through B-13 are all closed. The shape assertion is kept rather than\n1876\t    deleted with the rows, so a gap found later cannot be recorded in prose\n1877\t    without an owner and a rework edge.\n1878\t    \"\"\"\n1879\t\n1880\t    rework_edges = {\n1881\t        \"state_or_reducer\",\n1882\t        \"transport_or_authorization\",\n1883\t        \"deterministic_node\",\n1884\t        \"model_node_or_projection\",\n1885\t        \"topology_or_guard\",\n1886\t    }\n1887\t    assert U.BLOCKING_GAPS == ()\n1888\t    for gap in U.BLOCKING_GAPS:  # pragma: no cover - guards a future row\n1889\t        assert gap[\"owner\"].startswith(\"N\")\n1890\t        assert gap[\"rework_edge\"] in rework_edges\n1891\t        assert len(gap[\"detail\"]) > 80\n1892\t\n1893\t\n1894\t# --- B-1 (RESOLVED by N11 generation 5): kept as the regression that would catch it\n1895\t\n1896\t\n1897\tdef test_a_zero_arg_constructible_write_once_channel_is_what_broke_d01() -> None:\n1898\t    \"\"\"The mechanism behind the resolved B-1, pinned so a redeclaration re-fails.\n1899\t\n1900\t    LangGraph seeds a `BinaryOperatorAggregate` by calling the annotated type\n1901\t    when that type is zero-arg constructible, so `Annotated[dict, write_once]`\n1902\t    starts at `{}` and the reducer rejects the channel's own first write. The\n1903\t    `X | None` declaration N11 chose is not constructible, so the channel stays\n1904\t    unset. Both halves are asserted, because the fix is a property of the\n1905\t    declaration, not of the reducer.\n1906\t    \"\"\"\n1907\t\n1908\t    class _Broken(TypedDict, total=False):\n1909\t        effective_run: Annotated[dict[str, Any], write_once]\n1910\t\n1911\t    builder: StateGraph = StateGraph(_Broken)\n1912\t    builder.add_node(\"A\", lambda state: {\"effective_run\": {\"x\": 1}})\n1913\t    builder.add_edge(START, \"A\")\n1914\t    builder.add_edge(\"A\", END)\n1915\t    with pytest.raises(WriteOnceConflict):\n1916\t        builder.compile().invoke({})\n1917\t\n1918\t    class _Control(TypedDict, total=False):\n1919\t        effective_run: Annotated[dict[str, Any] | None, write_once]\n1920\t\n1921\t    control: StateGraph = StateGraph(_Control)\n1922\t    control.add_node(\"A\", lambda state: {\"effective_run\": {\"x\": 1}})\n1923\t    control.add_node(\"B\", lambda state: {\"effective_run\": {\"x\": 1}})\n1924\t    control.add_edge(START, \"A\")\n1925\t    control.add_edge(\"A\", \"B\")\n1926\t    control.add_edge(\"B\", END)\n1927\t    assert control.compile().invoke({}) == {\"effective_run\": {\"x\": 1}}\n1928\t\n1929\t\n1930\tdef test_no_write_once_channel_of_the_production_graph_is_seeded(compiled) -> None:\n1931\t    \"\"\"B-1 is closed on the real compiled graph, not on a synthetic one.\"\"\"\n1932\t\n1933\t    seeded = sorted(\n1934\t        field\n1935\t        for field in FACTORY_STATE_FIELDS\n1936\t        if FIELD_REDUCER_CLASSES[field] == \"write_once\"\n1937\t        and isinstance(compiled.channels.get(field), BinaryOperatorAggregate)\n1938\t        and isinstance(getattr(compiled.channels[field], \"value\", None), (str, list, dict))\n1939\t    )\n1940\t    assert seeded == [], f\"these write_once channels would reject their own first write: {seeded}\"\n1941\t\n1942\t\n1943\t# --- B-2 (RESOLVED by N22 generation 5): the inverted acceptance rows\n1944\t\n1945\t\n1946\tdef test_a_source_fanout_stages_one_m01_packet_per_request_key() -> None:\n1947\t    \"\"\"D06 commits the denominator and stages exactly the dispatch it declared.\"\"\"\n1948\t\n1949\t    assert \"pending_packet\" in NODE_CATALOGUE[\"D06_COMPILE_SOURCE_REQUESTS\"].outputs\n1950\t    unit = {\n1951\t        \"id\": \"U001\",\n1952\t        \"title\": \"t\",\n1953\t        \"required_explanation\": [\"fact\"],\n1954\t        \"safety_focus\": [\"care\"],\n1955\t    }\n1956\t    state = {\n1957\t        \"run_id\": \"run-n30-fixture\",\n1958\t        \"episode_id\": \"episode-n30-fixture\",\n1959\t        \"effective_run\": {\"unit_records\": [unit], \"target_closure\": [\"U001\"]},\n1960\t        \"selected_unit_id\": \"U001\",\n1961\t        \"source_admissions\": [],\n1962\t        \"engine_root\": \"/tmp\",\n1963\t    }\n1964\t    update = sources.D06_COMPILE_SOURCE_REQUESTS(state, _Context())\n1965\t    assert update[\"pending_guard\"][\"value\"] == \"discovery_fanout\"\n1966\t\n1967\t    denominator = next(iter(update[\"source_denominators\"].values()))\n1968\t    packet = update[\"pending_packet\"]\n1969\t    assert packet[\"dispatch\"] == \"M01_RESEARCH_UNIT_SOURCES\"\n1970\t    members = packet[\"packets\"]\n1971\t    assert sorted(m[\"correlation\"][\"correlation_key\"] for m in members) == sorted(\n1972\t        denominator[\"request_keys\"]\n1973\t    )\n1974\t    assert all(m[\"phase\"] == \"DISCOVER\" for m in members)\n1975\t\n1976\t    # B-6: the dispatcher reserves before it dispatches, so the staged members\n1977\t    # reach their worker through D90 rather than on a direct edge.\n1978\t    assert R.route_source_discovery_fanout({**state, **update}) == \"D90_RESERVE_MODEL_ATTEMPT\"\n1979\t    reserved = mn.D90_RESERVE_MODEL_ATTEMPT({**state, **update}, None)\n1980\t    dispatch = R.route_attempt_reservation({**state, **update, **reserved})\n1981\t    assert [send.node for send in dispatch] == [\"M01_RESEARCH_UNIT_SOURCES\"] * len(members)\n1982\t    assert [send.arg for send in dispatch] == reserved[\"pending_packet\"][\"packets\"]\n1983\t    assert [send.arg[\"correlation\"][\"correlation_key\"] for send in dispatch] == sorted(\n1984\t        denominator[\"request_keys\"]\n1985\t    )\n1986\t\n1987\t\n1988\t@pytest.mark.parametrize(\n1989\t    \"node_id, worker\",\n1990\t    [\n1991\t        (\"D06_COMPILE_SOURCE_REQUESTS\", \"M01 discovery\"),\n1992\t        (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"M01 interpretation\"),\n1993\t        (\"D07_CORRELATE_AND_ADMIT_SOURCES\", \"M02\"),\n1994\t        (\"D08_VALIDATE_DOMAIN\", \"M03\"),\n1995\t        (\"D10_COMPILE_VISUAL_BRIEFS\", \"D11\"),\n1996\t        (\"D12_VISUAL_BARRIER_AND_JOIN\", \"M04\"),\n1997\t        (\"D15_FREEZE_UNIT_REVIEW_PACKET\", \"M05\"),\n1998\t    ],\n1999\t)\n2000\tdef test_every_dispatching_node_authorizes_a_worker_packet(node_id: str, worker: str) -> None:\n2001\t    \"\"\"The frozen catalogue rows B-2 required, asserted as the total dispatch set.\"\"\"\n2002\t\n2003\t    spec = NODE_CATALOGUE[node_id]\n2004\t    assert \"pending_packet\" in spec.outputs, f\"{node_id} stages nothing for {worker}\"\n2005\t    assert {\"run_id\", \"episode_id\"} <= set(spec.inputs), (\n2006\t        f\"{node_id} dispatches without run/episode identity, so it has no correlation\"\n2007\t    )\n2008\t\n2009\t\n2010\tdef test_a_staged_m04_member_is_an_m04_packet_not_a_brief() -> None:\n2011\t    \"\"\"D12's members carry the spec 9 projection `Send` will hand M04 verbatim.\"\"\"\n2012\t\n2013\t    unit_id = \"U001\"\n2014\t    briefs = [_brief(unit_id, \"det-a\", \"deterministic\"), _brief(unit_id, \"mdl-a\", \"model\")]\n2015\t    key = f\"{unit_id}/visual/det-a\"\n2016\t    state = _visual_state(unit_id, briefs, {key: _visual_result(key, unit_id, \"deterministic\")})\n2017\t    update = visuals.D12_VISUAL_BARRIER_AND_JOIN(state, _Context())\n2018\t\n2019\t    member = update[\"pending_packet\"][\"packets\"][0]\n2020\t    assert member[\"brief\"][\"brief_id\"] == f\"{unit_id}/visual/mdl-a\"\n2021\t    assert \"visual_contract\" in member and \"permitted_facts\" in member\n2022\t    # The reservation is D90's to mint; a dispatching node staging one would be\n2023\t    # committing an attempt counter it does not own (spec 6.2, D90 row).\n2024\t    assert \"reservation\" not in member\n2025\t\n2026\t\n2027\t# --- B-3 (RESOLVED by N23 generation 3): D90/D91 are registrable and registered\n2028\t\n2029\t\n2030\tdef test_d90_and_d91_are_registered_production_nodes(compiled, available) -> None:\n2031\t    \"\"\"Both bookkeeping nodes exist, pass N20's binding audit, and are compiled in.\"\"\"\n2032\t\n2033\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" in available\n2034\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" in available\n2035\t    inventory = G.binding_inventory()\n2036\t    for node_id in (\"D90_RESERVE_MODEL_ATTEMPT\", \"D91_CLASSIFY_MODEL_FAILURE\"):\n2037\t        body = inventory[node_id]\n2038\t        parameters = list(inspect.signature(body).parameters.values())\n2039\t        assert len(parameters) == 2\n2040\t        assert all(p.kind is inspect.Parameter.POSITIONAL_OR_KEYWORD for p in parameters)\n2041\t        assert body.__module__ == \"runtime.langgraph_factory.model_nodes\"\n2042\t    assert {\"D90_RESERVE_MODEL_ATTEMPT\", \"D91_CLASSIFY_MODEL_FAILURE\"} <= set(\n2043\t        compiled.get_graph().nodes\n2044\t    )\n2045\t\n2046\t\n2047\tdef test_d90_mints_one_reservation_per_fanout_member(compiled) -> None:\n2048\t    \"\"\"A map is N attempts, not one: the bound is per correlation, not per superstep.\"\"\"\n2049\t\n2050\t    unit = {\n2051\t        \"id\": \"U001\",\n2052\t        \"title\": \"t\",\n2053\t        \"required_explanation\": [\"fact\"],\n2054\t        \"safety_focus\": [\"care\"],\n2055\t    }\n2056\t    state = {\n2057\t        \"run_id\": \"run-n30-fixture\",\n2058\t        \"episode_id\": \"episode-n30-fixture\",\n2059\t        \"effective_run\": {\"unit_records\": [unit], \"target_closure\": [\"U001\"]},\n2060\t        \"selected_unit_id\": \"U001\",\n2061\t        \"source_admissions\": [],\n2062\t        \"engine_root\": \"/tmp\",\n2063\t    }\n2064\t    staged = sources.D06_COMPILE_SOURCE_REQUESTS(state, _Context())\n2065\t    reserved = mn.D90_RESERVE_MODEL_ATTEMPT({**state, **staged}, None)\n2066\t\n2067\t    members = reserved[\"pending_packet\"][\"packets\"]\n2068\t    assert len(members) == 2\n2069\t    assert len({m[\"reservation\"][\"activation_id\"] for m in members}) == 2\n2070\t    assert len(reserved[\"attempt_counters\"]) == 2\n2071\t    assert all(value == 1 for value in reserved[\"attempt_counters\"].values())\n2072\t    assert reserved[\"pending_guard\"][\"value\"] == \"authorized\"\n2073\t\n2074\t\n2075\t# --- B-6 (RESOLVED by N20 generation 7): every model dispatch reserves first\n2076\t\n2077\t\n2078\tdef test_every_model_dispatch_is_routed_through_d90(topology) -> None:\n2079\t    \"\"\"B-6 closed, asserted against the really-compiled edge set, not the tables.\n2080\t\n2081\t    Spec 6.2's D90 row requires the counter increment to be committed before any\n2082\t    dispatch. Both halves are asserted so either could regress and be caught:\n2083\t    every dispatcher reaches D90, and D90 is the *only* predecessor any model\n2084\t    node has.\n2085\t    \"\"\"\n2086\t\n2087\t    dispatchers = {\n2088\t        \"D06_COMPILE_SOURCE_REQUESTS\",\n2089\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n2090\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n2091\t        \"D08_VALIDATE_DOMAIN\",\n2092\t        \"D12_VISUAL_BARRIER_AND_JOIN\",\n2093\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n2094\t    }\n2095\t    to_reservation = {\n2096\t        source\n2097\t        for source, target, _conditional in topology[\"edges\"]\n2098\t        if target == \"D90_RESERVE_MODEL_ATTEMPT\"\n2099\t    }\n2100\t    assert dispatchers <= to_reservation, sorted(dispatchers - to_reservation)\n2101\t\n2102\t    predecessors = {\n2103\t        (source, target)\n2104\t        for source, target, _conditional in topology[\"edges\"]\n2105\t        if target in MODEL_NODE_IDS and source != \"D90_RESERVE_MODEL_ATTEMPT\"\n2106\t    }\n2107\t    assert not predecessors, f\"a model node is entered without a reservation: {sorted(predecessors)}\"\n2108\t\n2109\t\n2110\tdef test_an_unreserved_dispatch_is_refused_by_every_adapter() -> None:\n2111\t    \"\"\"The runtime consequence of B-6, on the real adapters and the real fake transport.\"\"\"\n2112\t\n2113\t    sandbox = Path(tempfile.mkdtemp())\n2114\t    context = mn.build_test_model_node_context(sandbox_root=sandbox, responses={})\n2115\t    whole_state = {field: None for field in FACTORY_STATE_FIELDS}\n2116\t    whole_state.update({\"run_id\": \"r1\", \"episode_id\": \"e1\", \"selected_unit_id\": \"U001\"})\n2117\t\n2118\t    with pytest.raises(mn.AttemptNotReserved):\n2119\t        mn.MODEL_NODE_ADAPTERS[\"M02_CREATE_UNIT_DOMAIN_DATA\"](whole_state, context)\n2120\t    with pytest.raises(mn.ProjectionViolation):\n2121\t        mn.MODEL_NODE_ADAPTERS[\"M05_REVIEW_ACTUAL_UNIT\"](whole_state, context)\n2122\t\n2123\t    # Even a correctly staged member is refused until D90 has attached a reservation.\n2124\t    unit_id = \"U001\"\n2125\t    briefs = [_brief(unit_id, \"det-a\", \"deterministic\"), _brief(unit_id, \"mdl-a\", \"model\")]\n2126\t    key = f\"{unit_id}/visual/det-a\"\n2127\t    state = _visual_state(unit_id, briefs, {key: _visual_result(key, unit_id, \"deterministic\")})\n2128\t    update = visuals.D12_VISUAL_BARRIER_AND_JOIN(state, _Context())\n2129\t    member = update[\"pending_packet\"][\"packets\"][0]\n2130\t    with pytest.raises(mn.AttemptNotReserved):\n2131\t        mn.MODEL_NODE_ADAPTERS[\"M04_CREATE_UNIT_VISUALS\"](member, context)\n2132\t\n2133\t\n2134\tdef test_d90s_authorized_guard_expresses_a_map() -> None:\n2135\t    \"\"\"The second half of B-6, closed: D90's guard translates its restaged packet.\n2136\t\n2137\t    A one-member dispatch becomes a one-element `Send` list and an N-member map an\n2138\t    N-element one, so D07/D08/D15 can route through D90 without their single\n2139\t    dispatch collapsing into a whole-state edge.\n2140\t    \"\"\"\n2141\t\n2142\t    def _reserved(members: list[dict[str, Any]]) -> dict[str, Any]:\n2143\t        return {\n2144\t            \"pending_guard\": {\n2145\t                \"node\": \"D90_RESERVE_MODEL_ATTEMPT\",\n2146\t                \"value\": \"authorized\",\n2147\t                \"kind\": \"model_attempt\",\n2148\t                \"decision\": \"authorized\",\n2149\t                \"detail\": {\"job_id\": \"M01_RESEARCH_UNIT_SOURCES\", \"members\": len(members)},\n2150\t            },\n2151\t            \"pending_packet\": {\"dispatch\": \"M01_RESEARCH_UNIT_SOURCES\", \"packets\": members},\n2152\t        }\n2153\t\n2154\t    mapped = R.route_attempt_reservation(_reserved([{\"a\": 1}, {\"b\": 2}]))\n2155\t    assert [(send.node, send.arg) for send in mapped] == [\n2156\t        (\"M01_RESEARCH_UNIT_SOURCES\", {\"a\": 1}),\n2157\t        (\"M01_RESEARCH_UNIT_SOURCES\", {\"b\": 2}),\n2158\t    ]\n2159\t    single = R.route_attempt_reservation(_reserved([{\"a\": 1}]))\n2160\t    assert [(send.node, send.arg) for send in single] == [\n2161\t        (\"M01_RESEARCH_UNIT_SOURCES\", {\"a\": 1})\n2162\t    ]\n2163\t\n2164\t\n2165\t# --- B-7 (RESOLVED by N22 generation 6 / N23 generation 4): admission mints\n2166\t\n2167\t\n2168\tdef test_a_model_candidate_is_minted_into_an_admissible_artifact_version() -> None:\n2169\t    \"\"\"B-7 closed, on the real M02 adapter and the real D08 body.\n2170\t\n2171\t    The candidate still carries no `version`/`hash`/`parent_hash` — spec 2.4's\n2172\t    code-owned-admission rule — and D08 now mints them from the candidate's\n2173\t    `payload` and the current head. Both halves are asserted: the model still may\n2174\t    not mint, and admission now can.\n2175\t    \"\"\"\n2176\t\n2177\t    sandbox = Path(tempfile.mkdtemp())\n2178\t    context = _scripted_model_context(sandbox)\n2179\t    update = mn.MODEL_NODE_ADAPTERS[\"M02_CREATE_UNIT_DOMAIN_DATA\"](\n2180\t        _m02_packet(\"U001\"), context\n2181\t    )\n2182\t    record = update[\"artifact_versions\"][0]\n2183\t    assert record[\"record_kind\"] == \"model_candidate\"\n2184\t    for field in (\"version\", \"parent_hash\", \"hash\"):\n2185\t        assert field not in record, f\"a model minted {field}; that is admission's authority\"\n2186\t\n2187\t    admission = domain.D08_VALIDATE_DOMAIN(\n2188\t        {\n2189\t            \"run_id\": \"r\",\n2190\t            \"episode_id\": \"e\",\n2191\t            \"selected_unit_id\": \"U001\",\n2192\t            \"effective_run\": {\n2193\t                \"unit_records\": [{\"id\": \"U001\", \"title\": \"t\"}],\n2194\t                \"manifest_schema\": None,\n2195\t            },\n2196\t            \"artifact_versions\": update[\"artifact_versions\"],\n2197\t            \"artifact_heads\": {},\n2198\t            \"source_admissions\": [],\n2199\t            \"engine_root\": str(REPO_ROOT),\n2200\t        },\n2201\t        _Context(),\n2202\t    )\n2203\t    # The candidate is resolved and versioned; whether it then passes the domain\n2204\t    # checks is a product question, and this fixture's body deliberately fails\n2205\t    # them. What B-7 was about is that the candidate is *seen* at all.\n2206\t    assert \"pending_failure\" not in admission\n2207\t    assert admission[\"pending_guard\"][\"value\"] == \"domain_repairable\"\n2208\t    assert {finding[\"check_id\"] for finding in admission[\"pending_guard\"][\"detail\"][\"findings\"]} <= {\n2209\t        \"domain_schema_valid\",\n2210\t        \"domain_facts_sourced\",\n2211\t        \"domain_verifier_fixtures\",\n2212\t    }\n2213\t\n2214\t\n2215\tdef test_each_join_reads_a_lineage_field_the_candidate_record_now_writes(\n2216\t    tmp_path: Path, monkeypatch\n2217\t) -> None:\n2218\t    \"\"\"The same gap, enumerated per consuming join, now inverted.\n2219\t\n2220\t    Asserted against the records a real episode actually produced, not against\n2221\t    the source of `_candidate_record`: N23 attaches lineage at the adapter call\n2222\t    sites, so a source scan would pass or fail for the wrong reason.\n2223\t    \"\"\""}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"18c2b2e5-9324-4c0b-8d5a-de8a28b29ec5","timestamp":"2026-08-12T15:12:50.191Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
