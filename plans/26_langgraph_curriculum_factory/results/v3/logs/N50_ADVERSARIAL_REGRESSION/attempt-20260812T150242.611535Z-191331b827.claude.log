{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XDMqmp7UXL92XqViq1higi","type":"tool_result","content":"120\t               \"evidence\": \"test fixture\", \"limitation\": None}\n121\t        for name in tp.REQUIRED_CAPABILITY_FACETS\n122\t    }\n123\t    unsatisfied = [] if enforced else sorted(facets)\n124\t    return {\"proved_at_utc\": datetime.now(timezone.utc).isoformat(), \"platform\": \"test\",\n125\t            \"facets\": facets, \"satisfied\": enforced,\n126\t            \"unsatisfied_required_facets\": unsatisfied}\n127\t\n128\t\n129\tdef authorization(output_root: Path, **overrides) -> AuthorizationRecord:\n130\t    payload = {\n131\t        \"run_id\": RUN_ID,\n132\t        \"curriculum_digest\": CURRICULUM_DIGEST,\n133\t        \"output_root\": str(output_root),\n134\t        \"approved_at_utc\": \"2026-08-11T00:00:00+00:00\",\n135\t        \"expires_at_utc\": (datetime.now(timezone.utc) + timedelta(days=1)).isoformat(),\n136\t        \"providers\": {name: sorted(classes) for name, classes in PROVIDER_DATA_CLASSES.items()},\n137\t    }\n138\t    payload.update(overrides)\n139\t    return AuthorizationRecord(**payload)\n140\t\n141\t\n142\tFAKE_EXECUTABLES = {\n143\t    \"codex\": tp.ExecutableIdentity(\"codex\", \"/opt/homebrew/bin/codex\", \"d\" * 64, \"codex-cli 0.147.0\"),\n144\t    \"gemini\": tp.ExecutableIdentity(\"gemini\", \"/opt/homebrew/bin/gemini\", \"e\" * 64, \"0.24.5\"),\n145\t}\n146\t\n147\t\n148\tdef make_transport(tmp_path: Path, runner: FakeRunner, *, record=\"default\",\n149\t                   proof=None, keep_workspaces=False) -> tp.CliTransport:\n150\t    output_root = tmp_path / \"output\"\n151\t    output_root.mkdir(exist_ok=True)\n152\t    receipts = ReceiptLog()\n153\t    guard = EgressGuard(receipts)\n154\t    ledger = tp.AttemptLedger()\n155\t    runner.ledger = ledger\n156\t    transport = tp.CliTransport(\n157\t        output_root=output_root, run_id=RUN_ID, curriculum_digest=CURRICULUM_DIGEST,\n158\t        authorization=authorization(output_root) if record == \"default\" else record,\n159\t        receipts=receipts, guard=guard, ledger=ledger,\n160\t        capability_proof=capability_proof() if proof is None else proof,\n161\t        runner=runner, executables=FAKE_EXECUTABLES, keep_workspaces=keep_workspaces)\n162\t    transport.test_ledger = ledger  # type: ignore[attr-defined]\n163\t    transport.test_receipts = receipts  # type: ignore[attr-defined]\n164\t    return transport\n165\t\n166\t\n167\tdef run_m03(transport: tp.CliTransport) -> tp.TransportResult:\n168\t    return transport.execute(\n169\t        job_id=\"M03_WRITE_UNIT_CONTENT\", activation_id=\"act-001\", episode_id=\"ep-000001\",\n170\t        projection={\"unit_id\": \"U01\"})\n171\t\n172\t\n173\t# ------------------------------------------------------- TEST 1: exactly eight routes\n174\t\n175\t\n176\tdef test_registry_freezes_exactly_the_eight_spec_routes():\n177\t    registry = tp.load_job_registry()\n178\t    assert len(registry) == 8\n179\t    assert set(registry) == set(EXPECTED_ROUTES)\n180\t    for job_id, expected in EXPECTED_ROUTES.items():\n181\t        route = registry[job_id]\n182\t        actual = (route.job_type, route.cli, route.family, route.model,\n183\t                  route.task_class, route.reasoning_effort)\n184\t        assert actual == expected, job_id\n185\t\n186\t\n187\tdef test_unknown_job_id_is_rejected():\n188\t    with pytest.raises(tp.RouteRejected):\n189\t        tp.resolve_route(\"M09_INVENTED_JOB\")\n190\t\n191\t\n192\tdef test_registry_with_the_wrong_job_count_is_rejected(tmp_path: Path):\n193\t    document = yaml.safe_load(tp.REGISTRY_PATH.read_text(encoding=\"utf-8\"))\n194\t    document[\"jobs\"] = document[\"jobs\"][:7]\n195\t    path = tmp_path / \"short.yaml\"\n196\t    path.write_text(yaml.safe_dump(document), encoding=\"utf-8\")\n197\t    with pytest.raises(tp.RouteRejected):\n198\t        tp.load_job_registry(path)\n199\t\n200\t\n201\tdef test_registry_with_a_mismatched_family_is_rejected(tmp_path: Path):\n202\t    document = yaml.safe_load(tp.REGISTRY_PATH.read_text(encoding=\"utf-8\"))\n203\t    document[\"jobs\"][0][\"family\"] = \"google\"\n204\t    path = tmp_path / \"wrong_family.yaml\"\n205\t    path.write_text(yaml.safe_dump(document), encoding=\"utf-8\")\n206\t    with pytest.raises(tp.RouteRejected):\n207\t        tp.load_job_registry(path)\n208\t\n209\t\n210\tdef test_unknown_schema_or_prompt_fails_before_launch(tmp_path: Path):\n211\t    route = tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\")\n212\t    for field, value in ((\"prompt\", \"does_not_exist.prompt.md\"),\n213\t                         (\"schema\", \"does_not_exist.schema.json\")):\n214\t        broken = tp.JobRoute(**{**route.__dict__, field: value})\n215\t        with pytest.raises(tp.RouteRejected):\n216\t            tp.resolve_prompt_path(broken) if field == \"prompt\" else tp.resolve_schema_path(broken)\n217\t\n218\t\n219\tdef test_execute_rejects_an_unknown_job_without_launching(tmp_path: Path):\n220\t    runner = FakeRunner(Step(stdout=\"\"))\n221\t    transport = make_transport(tmp_path, runner)\n222\t    with pytest.raises(tp.RouteRejected):\n223\t        transport.execute(job_id=\"M09_INVENTED_JOB\", activation_id=\"a\", episode_id=\"e\",\n224\t                          projection={})\n225\t    assert runner.calls == []\n226\t\n227\t\n228\tdef test_execute_rejects_undeclared_data_classes_without_launching(tmp_path: Path):\n229\t    runner = FakeRunner(Step(stdout=\"\"))\n230\t    transport = make_transport(tmp_path, runner)\n231\t    with pytest.raises(tp.RouteRejected):\n232\t        transport.execute(job_id=\"M03_WRITE_UNIT_CONTENT\", activation_id=\"a\", episode_id=\"e\",\n233\t                          projection={}, data_classes=(\"rasterized_pages\",))\n234\t    assert runner.calls == []\n235\t\n236\t\n237\t# -------------------------------------------- TEST 1/14: no model owns a control field\n238\t\n239\t\n240\tdef test_every_model_schema_is_closed_and_control_free():\n241\t    for job_id in EXPECTED_ROUTES:\n242\t        route = tp.resolve_route(job_id)\n243\t        schema = tp.load_output_schema(route)\n244\t        assert schema[\"additionalProperties\"] is False, job_id\n245\t        tp.assert_no_authoritative_fields(schema, label=job_id)\n246\t        jsonschema.Draft202012Validator.check_schema(schema)\n247\t\n248\t\n249\tdef test_a_schema_declaring_a_terminal_field_is_refused():\n250\t    with pytest.raises(tp.TransportError):\n251\t        tp.assert_no_authoritative_fields(\n252\t            {\"type\": \"object\", \"properties\": {\"terminal\": {\"type\": \"string\"}}}, label=\"probe\")\n253\t\n254\t\n255\tdef test_a_candidate_carrying_a_verdict_is_refused():\n256\t    with pytest.raises(tp.TransportError):\n257\t        tp.assert_no_authoritative_fields({\"overall_findings\": [{\"verdict\": \"pass\"}]},\n258\t                                          label=\"probe\")\n259\t"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"6be15bbd-444a-41f5-b855-7dfe5ebf8709","timestamp":"2026-08-12T15:13:00.768Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QaWfpX9dWisBm2pxxuszMj","type":"tool_result","content":"1\t\"\"\"N13 egress broker and external-data authorization tests (spec 7.4, 9).\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport hashlib\n5\timport http.client\n6\timport socket\n7\timport threading\n8\timport urllib.request\n9\tfrom datetime import datetime, timedelta, timezone\n10\tfrom pathlib import Path\n11\t\n12\timport pytest\n13\t\n14\tfrom runtime.langgraph_factory.egress import (\n15\t    MODEL_API_HOSTS,\n16\t    AuthorizationDenied,\n17\t    AuthorizationRecord,\n18\t    EgressDenied,\n19\t    EgressGuard,\n20\t    ReceiptLog,\n21\t    RetrievalPolicy,\n22\t    RetrievalResponse,\n23\t    SourceRetriever,\n24\t    authorize_subprocess_transmission,\n25\t    authorize_transmission,\n26\t)\n27\t\n28\tCURRICULUM_DIGEST = \"a\" * 64\n29\tOTHER_DIGEST = \"b\" * 64\n30\tRUN_ID = \"run-plan26-egress\"\n31\t\n32\t\n33\tdef make_record(output_root: Path, **overrides) -> AuthorizationRecord:\n34\t    payload = {\n35\t        \"run_id\": RUN_ID,\n36\t        \"curriculum_digest\": CURRICULUM_DIGEST,\n37\t        \"output_root\": str(output_root),\n38\t        \"approved_at_utc\": \"2026-08-11T00:00:00+00:00\",\n39\t        \"expires_at_utc\": (datetime.now(timezone.utc) + timedelta(days=1)).isoformat(),\n40\t        \"providers\": {\n41\t            \"openai\": [\"manifest_unit_projection\", \"schemas_and_rubrics\"],\n42\t            \"google\": [\"shipped_pdf\", \"rasterized_pages\"],\n43\t            \"primary_source_hosts\": [\"primary_source_bytes\"],\n44\t        },\n45\t    }\n46\t    payload.update(overrides)\n47\t    return AuthorizationRecord(**payload)\n48\t\n49\t\n50\t@pytest.fixture()\n51\tdef output_root(tmp_path: Path) -> Path:\n52\t    root = tmp_path / \"output\"\n53\t    root.mkdir()\n54\t    return root\n55\t\n56\t\n57\t@pytest.fixture()\n58\tdef receipts() -> ReceiptLog:\n59\t    return ReceiptLog()\n60\t\n61\t\n62\t@pytest.fixture()\n63\tdef guard(receipts: ReceiptLog):\n64\t    broker = EgressGuard(receipts)\n65\t    broker.install()\n66\t    try:\n67\t        yield broker\n68\t    finally:\n69\t        broker.uninstall()\n70\t\n71\t\n72\tdef grant(record: AuthorizationRecord, output_root: Path, provider=\"primary_source_hosts\",\n73\t          data_classes=(\"primary_source_bytes\",)):\n74\t    return authorize_transmission(\n75\t        record, provider=provider, data_classes=data_classes,\n76\t        curriculum_digest=CURRICULUM_DIGEST, run_id=RUN_ID, output_root=output_root)\n77\t\n78\t\n79\t# --------------------------------------------------------------- authorization record\n80\t\n81\t\n82\tdef test_record_rejects_unknown_provider_and_undeclared_data_class(output_root: Path):\n83\t    with pytest.raises(AuthorizationDenied) as unknown:\n84\t        make_record(output_root, providers={\"anthropic\": [\"shipped_pdf\"]})\n85\t    assert unknown.value.reason == \"unknown_provider\"\n86\t\n87\t    with pytest.raises(AuthorizationDenied) as undeclared:\n88\t        make_record(output_root, providers={\"google\": [\"manifest_unit_projection\"]})\n89\t    assert undeclared.value.reason == \"undeclared_data_class\"\n90\t\n91\t\n92\t@pytest.mark.parametrize(\n93\t    (\"mutation\", \"expected_reason\"),\n94\t    [\n95\t        ({\"record\": None}, \"authorization_absent\"),\n96\t        ({\"run_id\": \"some-other-run\"}, \"wrong_run_scope\"),\n97\t        ({\"curriculum_digest\": OTHER_DIGEST}, \"wrong_curriculum_digest\"),\n98\t        ({\"provider\": \"google\", \"data_classes\": (\"shipped_pdf\",),\n99\t          \"output_root\": \"elsewhere\"}, \"wrong_output_scope\"),\n100\t        ({\"provider\": \"primary_source_hosts\",\n101\t          \"data_classes\": (\"primary_source_bytes\",), \"drop_provider\": True},\n102\t         \"provider_not_authorized\"),\n103\t        ({\"provider\": \"openai\", \"data_classes\": (\"named_repair_findings\",)},\n104\t         \"data_class_not_authorized\"),\n105\t        ({\"expired\": True}, \"authorization_expired\"),\n106\t    ],\n107\t)\n108\tdef test_authorization_fails_closed_for_every_scope_mismatch(\n109\t    tmp_path: Path, output_root: Path, mutation, expected_reason\n110\t):\n111\t    providers = None\n112\t    if mutation.get(\"drop_provider\"):\n113\t        providers = {\"openai\": [\"manifest_unit_projection\"]}\n114\t    kwargs = {}\n115\t    if mutation.get(\"expired\"):\n116\t        kwargs[\"expires_at_utc\"] = \"2020-01-01T00:00:00+00:00\"\n117\t    if providers is not None:\n118\t        kwargs[\"providers\"] = providers\n119\t    record = None if \"record\" in mutation else make_record(output_root, **kwargs)\n120\t\n121\t    root = tmp_path / \"elsewhere\" if mutation.get(\"output_root\") == \"elsewhere\" else output_root\n122\t    root.mkdir(exist_ok=True)\n123\t\n124\t    with pytest.raises(AuthorizationDenied) as denied:\n125\t        authorize_transmission(\n126\t            record,\n127\t            provider=mutation.get(\"provider\", \"openai\"),\n128\t            data_classes=mutation.get(\"data_classes\", (\"manifest_unit_projection\",)),\n129\t            curriculum_digest=mutation.get(\"curriculum_digest\", CURRICULUM_DIGEST),\n130\t            run_id=mutation.get(\"run_id\", RUN_ID),\n131\t            output_root=root,\n132\t        )\n133\t    assert denied.value.reason == expected_reason\n134\t\n135\t\n136\tdef test_granted_receipt_carries_full_scope(output_root: Path):\n137\t    receipt = grant(make_record(output_root), output_root, provider=\"openai\",\n138\t                    data_classes=(\"manifest_unit_projection\",))\n139\t    assert receipt[\"decision\"] == \"granted\"\n140\t    assert receipt[\"provider\"] == \"openai\"\n141\t    assert receipt[\"curriculum_digest\"] == CURRICULUM_DIGEST\n142\t    assert receipt[\"run_id\"] == RUN_ID\n143\t    assert receipt[\"output_root\"] == str(output_root.resolve())\n144\t    assert len(receipt[\"authorization_digest\"]) == 64\n145\t\n146\t\n147\tdef test_subprocess_authorization_receipts_both_outcomes(output_root: Path, receipts: ReceiptLog):\n148\t    authorize_subprocess_transmission(\n149\t        make_record(output_root), provider=\"openai\",\n150\t        data_classes=(\"manifest_unit_projection\",), curriculum_digest=CURRICULUM_DIGEST,\n151\t        run_id=RUN_ID, output_root=output_root, receipts=receipts)\n152\t    assert receipts.allowed[-1][\"channel\"] == \"subprocess_transmission\"\n153\t\n154\t    with pytest.raises(AuthorizationDenied):\n155\t        authorize_subprocess_transmission(\n156\t            None, provider=\"openai\", data_classes=(\"manifest_unit_projection\",),\n157\t            curriculum_digest=CURRICULUM_DIGEST, run_id=RUN_ID,\n158\t            output_root=output_root, receipts=receipts)\n159\t    assert receipts.denials[-1][\"denial_reason\"] == \"authorization_absent\"\n160\t\n161\t\n162\t# ------------------------------------------------------------------------ egress guard\n163\t\n164\t\n165\tdef test_raw_socket_connect_is_denied_and_receipted(guard: EgressGuard, receipts: ReceiptLog):\n166\t    with pytest.raises(EgressDenied) as denied:\n167\t        socket.socket().connect((\"example.org\", 443))\n168\t    assert denied.value.reason == \"unauthorized_socket_no_active_retrieval\"\n169\t    assert receipts.denials[-1][\"channel\"] == \"socket_connect\"\n170\t    assert receipts.denials[-1][\"requested_target\"] == \"example.org:443\"\n171\t    assert receipts.denials[-1][\"traceback_origin\"]\n172\t\n173\t\n174\t@pytest.mark.parametrize(\"host\", sorted(MODEL_API_HOSTS))\n175\tdef test_direct_model_endpoint_is_denied(guard: EgressGuard, receipts: ReceiptLog, host: str):\n176\t    with pytest.raises(EgressDenied) as denied:\n177\t        socket.create_connection((host, 443), timeout=1)\n178\t    assert denied.value.reason == \"direct_model_endpoint\"\n179\t    assert receipts.denials[-1][\"requested_target\"] == f\"{host}:443\"\n180\t\n181\t\n182\tdef test_urllib_and_http_client_cannot_route_around_the_broker(\n183\t    guard: EgressGuard, receipts: ReceiptLog\n184\t):\n185\t    with pytest.raises(EgressDenied):\n186\t        urllib.request.urlopen(\"http://example.org/data.json\", timeout=1)\n187\t    with pytest.raises(EgressDenied):\n188\t        http.client.HTTPSConnection(\"api.openai.com\", timeout=1).connect()\n189\t    reasons = {entry[\"denial_reason\"] for entry in receipts.denials}\n190\t    assert \"unauthorized_socket_no_active_retrieval\" in reasons\n191\t    assert \"direct_model_endpoint\" in reasons\n192\t\n193\t\n194\tdef test_connect_ex_is_also_brokered(guard: EgressGuard, receipts: ReceiptLog):\n195\t    with pytest.raises(EgressDenied):\n196\t        socket.socket().connect_ex((\"example.org\", 443))\n197\t    assert receipts.denials[-1][\"channel\"] == \"socket_connect_ex\"\n198\t\n199\t\n200\tdef test_guard_uninstall_restores_the_stdlib(receipts: ReceiptLog):\n201\t    original = socket.socket.connect\n202\t    broker = EgressGuard(receipts)\n203\t    broker.install()\n204\t    assert socket.socket.connect is not original\n205\t    broker.uninstall()\n206\t    assert socket.socket.connect is original\n207\t\n208\t\n209\t# -------------------------------------------------------------------- source retriever\n210\t\n211\t\n212\tdef retriever(guard: EgressGuard, *, opener, resolver=None, **policy_kwargs) -> SourceRetriever:\n213\t    policy = RetrievalPolicy(allowed_hosts=frozenset({\"standards.example.org\"}), **policy_kwargs)\n214\t    return SourceRetriever(\n215\t        guard=guard, policy=policy,\n216\t        resolver=resolver or (lambda host: (\"93.184.216.34\",)),\n217\t        opener=opener)\n218\t\n219\t\n220\tdef canned(body=b\"<html>ok</html>\", **overrides):\n221\t    payload = {\n222\t        \"final_url\": \"https://standards.example.org/spec.html\",\n223\t        \"status\": 200,\n224\t        \"headers\": {\"content-type\": \"text/html; charset=utf-8\"},\n225\t        \"body\": body,\n226\t        \"redirect_chain\": (),\n227\t        \"tls\": {\"protocol\": \"TLSv1.3\", \"cipher\": \"TLS_AES_256_GCM_SHA384\",\n228\t                \"peer_subject\": \"CN=standards.example.org\"},\n229\t    }\n230\t    payload.update(overrides)\n231\t    return lambda url, *, timeout: RetrievalResponse(**payload)\n232\t\n233\t\n234\tdef test_authorized_retrieval_records_full_metadata(\n235\t    guard: EgressGuard, receipts: ReceiptLog, output_root: Path\n236\t):\n237\t    receipt_grant = grant(make_record(output_root), output_root)\n238\t    body = b\"<html>primary source</html>\"\n239\t    fetcher = retriever(guard, opener=canned(body))\n240\t    payload, receipt = fetcher.fetch(\n241\t        \"https://standards.example.org/spec.html\", authorization_receipt=receipt_grant)\n242\t\n243\t    assert payload == body\n244\t    assert receipt[\"outcome\"] == \"allowed\"\n245\t    assert receipt[\"resolved_host\"] == \"standards.example.org\"\n246\t    assert receipt[\"resolved_addresses\"] == [\"93.184.216.34\"]\n247\t    assert receipt[\"final_url\"] == \"https://standards.example.org/spec.html\"\n248\t    assert receipt[\"http_status\"] == 200\n249\t    assert receipt[\"tls\"][\"protocol\"] == \"TLSv1.3\"\n250\t    assert receipt[\"bytes_sha256\"] == hashlib.sha256(body).hexdigest()\n251\t    assert receipt[\"byte_count\"] == len(body)\n252\t    assert receipt[\"authorization_receipt_id\"] == receipt_grant[\"receipt_id\"]\n253\t    assert receipt[\"data_class\"] == \"primary_source_bytes\"\n254\t\n255\t\n256\t@pytest.mark.parametrize(\n257\t    (\"locator\", \"opener_kwargs\", \"expected_reason\"),\n258\t    [\n259\t        (\"http://standards.example.org/x\", {}, \"scheme_not_allowed\"),\n260\t        (\"https://unlisted.example.net/x\", {}, \"host_not_allowlisted\"),\n261\t        (\"https://api.openai.com/v1/responses\", {}, \"direct_model_endpoint\"),\n262\t        (\"https://standards.example.org/x\",\n263\t         {\"redirect_chain\": (\"https://evil.example.net/x\",),\n264\t          \"final_url\": \"https://evil.example.net/x\"},\n265\t         \"redirect_to_unapproved_host\"),\n266\t        (\"https://standards.example.org/x\",\n267\t         {\"redirect_chain\": (\"https://api.openai.com/v1/responses\",),\n268\t          \"final_url\": \"https://api.openai.com/v1/responses\"},\n269\t         \"redirect_to_model_endpoint\"),\n270\t        (\"https://standards.example.org/x\", {\"status\": 404}, \"http_status_not_ok\"),\n271\t        (\"https://standards.example.org/x\",\n272\t         {\"headers\": {\"content-type\": \"application/x-msdownload\"}},\n273\t         \"content_type_not_allowed\"),\n274\t    ],\n275\t)\n276\tdef test_retrieval_denials_are_receipted(\n277\t    guard: EgressGuard, receipts: ReceiptLog, output_root: Path,\n278\t    locator, opener_kwargs, expected_reason\n279\t):\n280\t    receipt_grant = grant(make_record(output_root), output_root)\n281\t    fetcher = retriever(guard, opener=canned(**opener_kwargs))\n282\t    with pytest.raises(EgressDenied) as denied:\n283\t        fetcher.fetch(locator, authorization_receipt=receipt_grant)\n284\t    assert denied.value.reason == expected_reason\n285\t    assert receipts.denials[-1][\"denial_reason\"] == expected_reason\n286\t\n287\t\n288\tdef test_oversized_response_is_denied(guard: EgressGuard, output_root: Path):\n289\t    receipt_grant = grant(make_record(output_root), output_root)\n290\t    fetcher = retriever(guard, opener=canned(b\"x\" * 4096), max_bytes=1024)\n291\t    with pytest.raises(EgressDenied) as denied:\n292\t        fetcher.fetch(\"https://standards.example.org/big\",\n293\t                      authorization_receipt=receipt_grant)\n294\t    assert denied.value.reason == \"response_too_large\"\n295\t\n296\t\n297\tdef test_non_global_resolution_is_denied(guard: EgressGuard, output_root: Path):\n298\t    receipt_grant = grant(make_record(output_root), output_root)\n299\t    fetcher = retriever(guard, opener=canned(), resolver=lambda host: (\"169.254.169.254\",))\n300\t    with pytest.raises(EgressDenied) as denied:\n301\t        fetcher.fetch(\"https://standards.example.org/meta\",\n302\t                      authorization_receipt=receipt_grant)\n303\t    assert denied.value.reason == \"non_global_address\"\n304\t\n305\t\n306\tdef test_dns_rebinding_to_an_unpinned_address_is_denied(\n307\t    guard: EgressGuard, receipts: ReceiptLog, output_root: Path\n308\t):\n309\t    receipt_grant = grant(make_record(output_root), output_root)\n310\t\n311\t    def rebinding_opener(url, *, timeout):\n312\t        socket.create_connection((\"203.0.113.9\", 443), timeout=1)\n313\t        raise AssertionError(\"rebinding connect should never be permitted\")\n314\t\n315\t    fetcher = retriever(guard, opener=rebinding_opener)\n316\t    with pytest.raises(EgressDenied) as denied:\n317\t        fetcher.fetch(\"https://standards.example.org/spec.html\",\n318\t                      authorization_receipt=receipt_grant)\n319\t    assert denied.value.reason == \"dns_rebinding\"\n320\t    assert receipts.denials[-1][\"requested_target\"] == \"203.0.113.9:443\"\n321\t\n322\t\n323\tdef test_unauthorized_retrieval_makes_no_connection(guard: EgressGuard, output_root: Path):\n324\t    calls: list[str] = []\n325\t\n326\t    def counting_opener(url, *, timeout):\n327\t        calls.append(url)\n328\t        return canned()(url, timeout=timeout)\n329\t\n330\t    fetcher = retriever(guard, opener=counting_opener)\n331\t    with pytest.raises(EgressDenied) as absent:\n332\t        fetcher.fetch(\"https://standards.example.org/spec.html\", authorization_receipt=None)\n333\t    assert absent.value.reason == \"authorization_absent\"\n334\t\n335\t    wrong_provider = grant(make_record(output_root), output_root, provider=\"google\",\n336\t                           data_classes=(\"shipped_pdf\",))\n337\t    with pytest.raises(EgressDenied) as mismatched:\n338\t        fetcher.fetch(\"https://standards.example.org/spec.html\",\n339\t                      authorization_receipt=wrong_provider)\n340\t    assert mismatched.value.reason == \"wrong_provider_authorization\"\n341\t    assert calls == []\n342\t\n343\t\n344\tdef test_only_the_retriever_may_egress_to_an_allowlisted_host(\n345\t    guard: EgressGuard, receipts: ReceiptLog, output_root: Path\n346\t):\n347\t    \"\"\"The same host the retriever may reach is still denied to any other caller.\"\"\"\n348\t    listener = socket.socket()\n349\t    listener.bind((\"127.0.0.1\", 0))\n350\t    listener.listen(1)\n351\t    port = listener.getsockname()[1]\n352\t    accepted: list[socket.socket] = []\n353\t    thread = threading.Thread(target=lambda: accepted.append(listener.accept()[0]), daemon=True)\n354\t    thread.start()\n355\t\n356\t    receipt_grant = grant(make_record(output_root), output_root)\n357\t\n358\t    def connecting_opener(url, *, timeout):\n359\t        connection = socket.create_connection((\"127.0.0.1\", port), timeout=2)\n360\t        connection.close()\n361\t        return RetrievalResponse(\n362\t            final_url=f\"http://localhost:{port}/spec.txt\", status=200,\n363\t            headers={\"content-type\": \"text/plain\"}, body=b\"source bytes\")\n364\t\n365\t    policy = RetrievalPolicy(\n366\t        allowed_hosts=frozenset({\"localhost\"}), require_tls=False,\n367\t        allow_private_addresses=True)\n368\t    fetcher = SourceRetriever(\n369\t        guard=guard, policy=policy, resolver=lambda host: (\"127.0.0.1\",),\n370\t        opener=connecting_opener)\n371\t\n372\t    body, receipt = fetcher.fetch(\n373\t        f\"http://localhost:{port}/spec.txt\", authorization_receipt=receipt_grant)\n374\t    assert body == b\"source bytes\"\n375\t    assert receipt[\"outcome\"] == \"allowed\"\n376\t    thread.join(timeout=2)\n377\t\n378\t    with pytest.raises(EgressDenied) as denied:\n379\t        socket.create_connection((\"127.0.0.1\", port), timeout=1)\n380\t    assert denied.value.reason == \"unauthorized_socket_no_active_retrieval\"\n381\t    for opened in accepted:\n382\t        opened.close()\n383\t    listener.close()\n384\t\n385\t\n386\tdef test_grant_does_not_leak_past_the_retrieval(guard: EgressGuard, output_root: Path):\n387\t    receipt_grant = grant(make_record(output_root), output_root)\n388\t    fetcher = retriever(guard, opener=canned())\n389\t    fetcher.fetch(\"https://standards.example.org/spec.html\",\n390\t                  authorization_receipt=receipt_grant)\n391\t    with pytest.raises(EgressDenied) as denied:\n392\t        socket.socket().connect((\"93.184.216.34\", 443))\n393\t    assert denied.value.reason == \"unauthorized_socket_no_active_retrieval\"\n394\t"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"dc30b3f5-c334-4f27-bf0a-c5520692aeaf","timestamp":"2026-08-12T15:13:00.770Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
