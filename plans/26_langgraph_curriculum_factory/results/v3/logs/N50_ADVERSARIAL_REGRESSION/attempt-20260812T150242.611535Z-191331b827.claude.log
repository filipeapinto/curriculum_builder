{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013y4XS4Mhj1XqMDTqjwZYoM","type":"tool_result","content":"634\t    def test_resume_envelope_derives_mode_and_target_from_the_frozen_identity(self):\n635\t        identity = {\n636\t            \"contract_version\": \"1\", \"engine_root\": \"/engine\", \"curriculum_root\": \"/curriculum\",\n637\t            \"active_manifest_path\": \"/curriculum/manifest.yaml\", \"output_root\": \"/out\",\n638\t            \"mode\": \"one\", \"requested_unit_id\": \"L07\", \"run_id\": \"run-xyz\",\n639\t        }\n640\t        invocation = SimpleNamespace(\n641\t            bootstrap_kind=P.BOOTSTRAP_RESUME,\n642\t            run_id=\"run-xyz\",\n643\t            episode_id=\"run-xyz:episode:000002\",\n644\t            episode_ordinal=2,\n645\t            thread_id=\"run-xyz:episode:000002\",\n646\t            identity_envelope=identity,\n647\t            prior_thread_id=\"run-xyz:episode:000001\",\n648\t            resume_from={\"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"}},\n649\t        )\n650\t        prior_values = {\n651\t            \"frozen_digest\": \"deadbeef\" * 8,\n652\t            \"accepted_unit_receipts\": {},\n653\t            \"terminal\": {\"kind\": \"INTERRUPTED\"},\n654\t            \"bootstrap_kind\": \"fresh\",\n655\t            \"invocation\": {\"kind\": \"fresh\"},\n656\t            \"episode_id\": \"run-xyz:episode:000001\",\n657\t        }\n658\t\n659\t        with mock.patch.object(P, \"open_checkpoint_saver\", return_value=(object(), mock.Mock(close=lambda: None))), \\\n660\t             mock.patch.object(P, \"ReadOnlyCheckpointView\", return_value=object()), \\\n661\t             mock.patch.object(P, \"prepare_episode_invocation\", return_value=invocation), \\\n662\t             mock.patch.object(P, \"extract_prior_episode\", return_value=SimpleNamespace(values=prior_values)):\n663\t            got_invocation, envelope, frozen_digest, seed_values = R._prepare_resume(\n664\t                output_root=Path(\"/out\"), lock=mock.Mock(), compiled=object()\n665\t            )\n666\t\n667\t        self.assertIs(got_invocation, invocation)\n668\t        self.assertEqual(envelope[\"kind\"], \"resume\")\n669\t        self.assertEqual(envelope[\"mode\"], \"one\")\n670\t        self.assertEqual(envelope[\"requested_unit_id\"], \"L07\")\n671\t        self.assertEqual(envelope[\"engine_root\"], \"/engine\")\n672\t        self.assertEqual(envelope[\"prior_identity\"], identity)\n673\t        self.assertEqual(envelope[\"prior_terminal\"], {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"})\n674\t        self.assertFalse(envelope[\"lease_open\"])\n675\t        self.assertEqual(frozen_digest, \"deadbeef\" * 8)\n676\t\n677\t        # Episode-scoped fields are never carried forward from the prior episode.\n678\t        for excluded in (\"terminal\", \"bootstrap_kind\", \"invocation\", \"episode_id\"):\n679\t            self.assertNotIn(excluded, seed_values)\n680\t        self.assertEqual(seed_values[\"frozen_digest\"], \"deadbeef\" * 8)\n681\t        self.assertEqual(seed_values[\"accepted_unit_receipts\"], {})\n682\t\n683\t    def test_recover_orphan_envelope_carries_no_prior_terminal_and_marks_lease_open(self):\n684\t        identity = {\n685\t            \"contract_version\": \"1\", \"engine_root\": \"/engine\", \"curriculum_root\": \"/curriculum\",\n686\t            \"active_manifest_path\": \"/curriculum/manifest.yaml\", \"output_root\": \"/out\",\n687\t            \"mode\": \"all\", \"requested_unit_id\": None, \"run_id\": \"run-xyz\",\n688\t        }\n689\t        invocation = SimpleNamespace(\n690\t            bootstrap_kind=P.BOOTSTRAP_RECOVER_ORPHAN,\n691\t            run_id=\"run-xyz\",\n692\t            episode_id=\"run-xyz:recover:1\",\n693\t            episode_ordinal=2,\n694\t            thread_id=\"run-xyz:recover:1\",\n695\t            identity_envelope=identity,\n696\t            prior_thread_id=\"run-xyz:episode:000001\",\n697\t            resume_from=None,\n698\t        )\n699\t        with mock.patch.object(P, \"open_checkpoint_saver\", return_value=(object(), mock.Mock(close=lambda: None))), \\\n700\t             mock.patch.object(P, \"ReadOnlyCheckpointView\", return_value=object()), \\\n701\t             mock.patch.object(P, \"prepare_episode_invocation\", return_value=invocation), \\\n702\t             mock.patch.object(P, \"extract_prior_episode\", return_value=SimpleNamespace(values={})):\n703\t            _invocation, envelope, _frozen_digest, _seed = R._prepare_resume(\n704\t                output_root=Path(\"/out\"), lock=mock.Mock(), compiled=object()\n705\t            )\n706\t\n707\t        self.assertEqual(envelope[\"kind\"], \"recover_orphan\")\n708\t        self.assertIsNone(envelope[\"prior_terminal\"])\n709\t        self.assertTrue(envelope[\"lease_open\"])\n710\t\n711\t\n712\t# ===========================================================================\n713\t# Evidence artifacts (spec-facing proof, written under results/evidence/)\n714\t# ===========================================================================\n715\t\n716\tEVIDENCE_DIR = REPO_ROOT / \"plans\" / \"26_langgraph_curriculum_factory\" / \"results\" / \"evidence\" / \"N40_CLI_CUTOVER\"\n717\t\n718\t\n719\tclass EvidenceArtifactTests(unittest.TestCase):\n720\t    \"\"\"Regenerates the node's own result-doc evidence as a side effect of a real\n721\t    assertion, so the evidence can never drift from what actually passed.\"\"\"\n722\t\n723\t    def test_cli_help_evidence_matches_spec_section_16_surface(self):"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"9c4dbedb-4050-4016-96dd-c0f469e6a9c7","timestamp":"2026-08-12T15:18:02.039Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
