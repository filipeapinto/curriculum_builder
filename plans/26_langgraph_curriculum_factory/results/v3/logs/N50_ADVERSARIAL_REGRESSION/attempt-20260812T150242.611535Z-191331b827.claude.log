ansport)\n480\t\n481\t\n482\t# ----------------------------------------------------------- TEST 8: capability proof\n483\t\n484\t\n485\tdef test_unproven_capability_fails_closed():\n486\t    with pytest.raises(tp.CapabilityProofFailed):\n487\t        tp.require_capability_proof(None)\n488\t    with pytest.raises(tp.CapabilityProofFailed):\n489\t        tp.require_capability_proof(capability_proof(enforced=False))\n490\t\n491\t\n492\tdef test_execute_refuses_to_launch_without_a_capability_proof(tmp_path: Path):\n493\t    runner = FakeRunner(Step(stdout=codex_events(), result_text=json.dumps(M03_CANDIDATE)))\n494\t    transport = make_transport(tmp_path, runner, proof=capability_proof(enforced=False))\n495\t    with pytest.raises(tp.CapabilityProofFailed):\n496\t        run_m03(transport)\n497\t    assert runner.calls == []\n498\t    assert transport.test_ledger.total_reserved == 0\n499\t\n500\t\n501\tdef test_launch_is_refused_when_no_host_sandbox_exists(tmp_path: Path, monkeypatch):\n502\t    monkeypatch.setattr(tp, \"sandbox_mechanism\", lambda: tp.SANDBOX_UNAVAILABLE)\n503\t    with pytest.raises(tp.CapabilityProofFailed):\n504\t        tp.build_sandboxed_argv([\"codex\"], profile_path=tmp_path / \"p.sb\")\n505\t    unproven = tp.prove_workspace_isolation(\n506\t        workspace=tmp_path, home=tmp_path, forbidden_paths=[tp.REPO_ROOT])\n507\t    assert unproven[\"enforced\"] is False\n508\t\n509\t\n510\t# -------------------------------------------------------- TEST 9: JSON parsing + retry\n511\t\n512\t\n513\t@pytest.mark.parametrize(\n514\t    (\"document\", \"failure_class\"),\n515\t    [\n516\t        (\"\", \"empty_result\"),\n517\t        (\"```json\\n{\\\"a\\\": 1}\\n```\", \"fenced_result\"),\n518\t        (\"{\\\"a\\\": 1} {\\\"a\\\": 2}\", \"trailing_material\"),\n519\t        (\"{\\\"a\\\": 1}\\ntrailing prose\", \"trailing_material\"),\n520\t        (\"{\\\"a\\\": NaN}\", \"non_finite_json_constant\"),\n521\t        (\"{\\\"a\\\": 1, \\\"a\\\": 2}\", \"duplicate_json_key\"),\n522\t        (\"{not json}\", \"malformed_json\"),\n523\t        (\"[1, 2, 3]\", \"result_is_not_an_object\"),\n524\t    ],\n525\t)\n526\tdef test_only_one_clean_json_document_is_accepted(document: str, failure_class: str):\n527\t    with pytest.raises(tp.ResultParseError) as error:\n528\t        tp.parse_single_json_document(document)\n529\t    assert error.value.failure_class == failure_class\n530\t\n531\t\n532\tdef test_envelope_extractor_requires_a_response_string():\n533\t    assert tp.extract_envelope_response(gemini_envelope(response='{\"x\": 1}')) == '{\"x\": 1}'\n534\t    with pytest.raises(tp.ResultParseError):\n535\t        tp.extract_envelope_response(json.dumps({\"session_id\": \"a\"}))\n536\t\n537\t\n538\tdef test_m01_must_emit_exactly_one_phase(tmp_path: Path):\n539\t    route = tp.resolve_route(\"M01_RESEARCH_UNIT_SOURCES\")\n540\t    schema = tp.load_output_schema(route)\n541\t    both = {\n542\t        \"locators\": [{\"request_id\": \"r1\", \"url\": \"https://x.example/a\", \"title\": \"t\",\n543\t                      \"publisher\": \"p\", \"locator_kind\": \"primary\", \"rationale\": \"why\"}],\n544\t        \"interpretations\": [{\"request_id\": \"r1\", \"retrieval_id\": \"g1\",\n545\t                             \"claims\": [{\"claim_text\": \"c\", \"source_quote\": \"q\",\n546\t                                         \"source_location\": \"p1\"}], \"limitations\": []}],\n547\t    }\n548\t    (tmp_path / \"result.json\").write_text(json.dumps(both), encoding=\"utf-8\")\n549\t    with pytest.raises(tp.ResultParseError):\n550\t        tp.load_candidate(route, workspace=tmp_path, stdout=\"\", schema=schema)\n551\t\n552\t\n553\t@requires_sandbox\n554\tdef test_malformed_result_gets_exactly_one_retry_then_fails(tmp_path: Path):\n555\t    runner = FakeRunner(Step(stdout=codex_events(), result_text=\"{oops\"))\n556\t    transport = make_transport(tmp_path, runner)\n557\t    with pytest.raises(tp.ResultParseError):\n558\t        run_m03(transport)\n559\t    assert len(runner.calls) == 2\n560\t    assert transport.test_ledger.total_reserved == 2\n561\t\n562\t\n563\t@requires_sandbox\n564\tdef test_schema_invalid_result_gets_exactly_one_retry(tmp_path: Path):\n565\t    runner = FakeRunner(Step(stdout=codex_events(),\n566\t                             result_text=json.dumps({\"unit_content\": {\"unit_id\": \"U01\"}})))\n567\t    transport = make_transport(tmp_path, runner)\n568\t    with pytest.raises(tp.ResultParseError) as error:\n569\t        run_m03(transport)\n570\t    assert error.value.failure_class == \"schema_invalid_result\"\n571\t    assert len(runner.calls) == 2\n572\t\n573\t\n574\t@requires_sandbox\n575\tdef test_the_single_retry_can_succeed(tmp_path: Path):\n576\t    runner = FakeRunner(\n577\t        Step(stdout=codex_events(), result_text=\"{trailing junk\"),\n578\t        Step(stdout=codex_events(), result_text=json.dumps(M03_CANDIDATE)))\n579\t    transport = make_transport(tmp_path, runner)\n580\t    result = run_m03(transport)\n581\t    assert result.candidate == M03_CANDIDATE\n582\t    assert len(result.attempts) == 2\n583\t    assert result.attempts[0][\"outcome\"] == \"transport_failure\"\n584\t    assert result.attempts[1][\"outcome\"] == \"candidate_produced\"\n585\t    assert len(runner.calls) == 2\n586\t\n587\t\n588\t@requires_sandbox\n589\tdef test_identity_mismatch_is_never_retried(tmp_path: Path):\n590\t    runner = FakeRunner(Step(stdout=codex_events(\"gpt-4o\"),\n591\t                             result_text=json.dumps(M03_CANDIDATE)))\n592\t    transport = make_transport(tmp_path, runner)\n593\t    with pytest.raises(tp.IdentityMismatch):\n594\t        run_m03(transport)\n595\t    assert len(runner.calls) == 1\n596\t    assert transport.test_ledger.total_reserved == 1\n597\t\n598\t\n599\tdef test_attempt_ledger_refuses_a_third_attempt():\n600\t    ledger = tp.AttemptLedger()\n601\t    ledger.reserve(activation_id=\"a\", job_id=\"M03_WRITE_UNIT_CONTENT\")\n602\t    ledger.reserve(activation_id=\"a\", job_id=\"M03_WRITE_UNIT_CONTENT\")\n603\t    with pytest.raises(tp.AttemptLimitExceeded):\n604\t        ledger.reserve(activation_id=\"a\", job_id=\"M03_WRITE_UNIT_CONTENT\")\n605\t\n606\t\n607\t# --------------------------------------------- TEST 10: reservation before launch, receipts\n608\t\n609\t\n610\t@requires_sandbox\n611\tdef test_attempt_is_reserved_before_the_process_starts(tmp_path: Path):\n612\t    runner = FakeRunner(Step(stdout=codex_events(), result_text=json.dumps(M03_CANDIDATE)))\n613\t    transport = make_transport(tmp_path, runner)\n614\t    run_m03(transport)\n615\t    assert runner.reserved_at_call == [1]\n616\t\n617\t\n618\t@requires_sandbox\n619\tdef test_receipt_carries_every_required_piece_of_evidence(tmp_path: Path):"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"445fdec5-e4fa-496c-9aaa-3a231600421f","timestamp":"2026-08-12T15:12:56.416Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
