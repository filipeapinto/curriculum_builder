{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cdy5515SDRDy1yQMDu35v","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XUGfxihc1RAqByZtQTdXQM","name":"Read","input":{"file_path":"/Users/filipepinto/Projects/curriculum_builder/tests/runtime/test_plan26_repair_acceptance.py","offset":200,"limit":320},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3983,"cache_read_input_tokens":128679,"cache_creation":{"ephemeral_5m_input_tokens":3983,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"7f479d03-8eff-4731-ba47-98b714f24a19","timestamp":"2026-08-12T15:13:11.055Z","request_id":"req_011Cdy54z7tQHAwtdQR3epbd","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XUGfxihc1RAqByZtQTdXQM","type":"tool_result","content":"200\t\n201\t# ---------------------------------------------------------------------------\n202\t# TEST 2: local repair changes only named paths/descendants\n203\t# ---------------------------------------------------------------------------\n204\t\n205\t\n206\tdef _repair_cycle_state(*, boundary_pointer: str = \"/facts/0/statement\") -> dict[str, Any]:\n207\t    state = _passing_state()\n208\t    state[\"pending_guard\"] = {\n209\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n210\t        \"detail\": {\n211\t            \"unit_id\": UNIT,\n212\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": boundary_pointer, \"message\": \"bad\"}],\n213\t        },\n214\t    }\n215\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n216\t    state = _apply(state, repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None))\n217\t    return state\n218\t\n219\t\n220\tdef test_a_correctly_scoped_model_repair_admits() -> None:\n221\t    state = _repair_cycle_state()\n222\t    request = state[\"repair_requests\"][-1]\n223\t    domain_stream = stream_id(UNIT, \"domain\")\n224\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n225\t    new_body = dict(_domain_body())\n226\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n227\t    candidate = {\n228\t        \"key\": \"candidate:m06-1\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n229\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n230\t        \"parent_sha256\": parent_hash,\n231\t        \"payload\": {\n232\t            \"candidate_child\": {\n233\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n234\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n235\t            },\n236\t            \"changed_path_manifest\": [\n237\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n238\t            ],\n239\t        },\n240\t    }\n241\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n242\t    update = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n243\t    assert update[\"pending_guard\"][\"value\"] == \"repair_admitted\"\n244\t    assert update[\"artifact_heads\"][domain_stream][\"version\"] == 2\n245\t\n246\t\n247\tdef test_a_broad_repair_outside_its_boundary_is_refused() -> None:\n248\t    state = _repair_cycle_state()\n249\t    request = state[\"repair_requests\"][-1]\n250\t    domain_stream = stream_id(UNIT, \"domain\")\n251\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n252\t    new_body = dict(_domain_body())\n253\t    # Touches an undeclared pointer (verifier_result) in addition to the named one.\n254\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n255\t    new_body[\"verifier_result\"] = {\"result\": \"not_run\"}\n256\t    candidate = {\n257\t        \"key\": \"candidate:m06-broad\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n258\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n259\t        \"parent_sha256\": parent_hash,\n260\t        \"payload\": {\n261\t            \"candidate_child\": {\n262\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n263\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n264\t            },\n265\t            \"changed_path_manifest\": [\n266\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]},\n267\t                {\"json_pointer\": \"/verifier_result\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]},\n268\t            ],\n269\t        },\n270\t    }\n271\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n272\t    with pytest.raises(SystemFailure):\n273\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n274\t\n275\t\n276\tdef test_an_in_place_no_op_repair_is_refused() -> None:\n277\t    state = _repair_cycle_state()\n278\t    request = state[\"repair_requests\"][-1]\n279\t    domain_stream = stream_id(UNIT, \"domain\")\n280\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n281\t    unchanged_body = _domain_body()  # identical to parent\n282\t    candidate = {\n283\t        \"key\": \"candidate:m06-noop\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n284\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n285\t        \"parent_sha256\": parent_hash,\n286\t        \"payload\": {\n287\t            \"candidate_child\": {\n288\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(unchanged_body, sort_keys=True),\n289\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n290\t            },\n291\t            \"changed_path_manifest\": [\n292\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n293\t            ],\n294\t        },\n295\t    }\n296\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n297\t    with pytest.raises(SystemFailure):\n298\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n299\t\n300\t\n301\tdef test_a_stale_parent_repair_is_refused() -> None:\n302\t    state = _repair_cycle_state()\n303\t    request = state[\"repair_requests\"][-1]\n304\t    new_body = dict(_domain_body())\n305\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n306\t    candidate = {\n307\t        \"key\": \"candidate:m06-stale\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n308\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n309\t        \"parent_sha256\": \"0\" * 64,  # not the current head\n310\t        \"payload\": {\n311\t            \"candidate_child\": {\n312\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n313\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n314\t            },\n315\t            \"changed_path_manifest\": [\n316\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n317\t            ],\n318\t        },\n319\t    }\n320\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n321\t    with pytest.raises(SystemFailure):\n322\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n323\t\n324\t\n325\tdef test_a_deterministic_layout_repair_changes_only_its_allowed_pointer() -> None:\n326\t    state = _passing_state()\n327\t    layout_stream = stream_id(UNIT, \"layout\")\n328\t    layout_body = {\"unit_id\": UNIT, \"template\": \"v1\", \"page_count\": 1}\n329\t    layout_hash = canonical_digest(layout_body)\n330\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [\n331\t        {\"key\": f\"{layout_stream}@1\", \"stream\": layout_stream, \"version\": 1, \"parent_hash\": None, \"hash\": layout_hash, \"body\": layout_body}\n332\t    ]\n333\t    state[\"pending_guard\"] = {\n334\t        \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"layout_repairable\",\n335\t        \"detail\": {\n336\t            \"unit_id\": UNIT,\n337\t            \"findings\": [{\n338\t                \"owner\": \"unit layout\", \"check_id\": \"unit_page_inventory\", \"pointer\": \"/template\",\n339\t                \"message\": \"wrong template\", \"allowed_facts\": {\"/template\": \"v2\"},\n340\t            }],\n341\t        },\n342\t    }\n343\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n344\t    state = _apply(state, repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None))\n345\t    assert state[\"pending_guard\"][\"value\"] == \"repair_planned\"\n346\t    update = repair.D19_ROUTE_UNIT_REPAIR(state, None)\n347\t    assert update[\"pending_guard\"][\"value\"] == \"deterministic_repair\"\n348\t    candidate = update[\"artifact_versions\"][0]\n349\t    assert candidate[\"body\"][\"template\"] == \"v2\"\n350\t    assert candidate[\"body\"][\"page_count\"] == 1  # only the named pointer changed\n351\t    state = _apply(state, update)\n352\t    admitted = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n353\t    # layout is append-only versioned, not `artifact_heads`-tracked (matching\n354\t    # `review.py`'s own `latest_candidate` convention for this channel).\n355\t    assert \"artifact_heads\" not in admitted\n356\t    admitted_versions = [v for v in admitted[\"artifact_versions\"] if v[\"stream\"] == layout_stream]\n357\t    assert admitted_versions[0][\"version\"] == 2\n358\t    assert admitted_versions[0][\"body\"][\"template\"] == \"v2\"\n359\t\n360\t\n361\t# ---------------------------------------------------------------------------\n362\t# TEST 3: attempt/repeat bounds stop before an over-bound M06 call\n363\t# ---------------------------------------------------------------------------\n364\t\n365\t\n366\tdef test_attempt_bound_exhausts_before_a_fourth_repair_child() -> None:\n367\t    state = _passing_state()\n368\t    state[\"attempt_counters\"] = {\n369\t        f\"repair|{UNIT}|curriculum domain|{canonical_digest([repair.finding_fingerprint('curriculum domain', ['/facts/0/statement'], 'bad')])}\": repair.MAX_REPAIR_CHILDREN_PER_CHAIN\n370\t    }\n371\t    state[\"pending_guard\"] = {\n372\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n373\t        \"detail\": {\n374\t            \"unit_id\": UNIT,\n375\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n376\t        },\n377\t    }\n378\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n379\t    update = repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None)\n380\t    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n381\t    assert update[\"terminal_candidate\"][\"kind\"] == \"CONVERGENCE_EXHAUSTED\"\n382\t    assert update[\"terminal_candidate\"][\"bound\"] == \"attempt_bound\"\n383\t\n384\t\n385\tdef test_fingerprint_repeat_bound_exhausts_at_d17() -> None:\n386\t    state = _passing_state()\n387\t    fingerprint = canonical_digest(\n388\t        [repair.finding_fingerprint(\"curriculum domain\", [\"/facts/0/statement\"], \"bad\")]\n389\t    )\n390\t    state[\"attempt_counters\"] = {\n391\t        f\"repeat|{UNIT}|curriculum domain|{fingerprint}\": repair.MAX_FINGERPRINT_REPEATS\n392\t    }\n393\t    state[\"pending_guard\"] = {\n394\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n395\t        \"detail\": {\n396\t            \"unit_id\": UNIT,\n397\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n398\t        },\n399\t    }\n400\t    update = repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n401\t    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n402\t    assert update[\"terminal_candidate\"][\"bound\"] == \"fingerprint_bound\"\n403\t\n404\t\n405\t# ---------------------------------------------------------------------------\n406\t# TEST 4: all invalidated descendants retest; stale evidence cannot pass\n407\t# ---------------------------------------------------------------------------\n408\t\n409\t\n410\tdef test_d21_dispatches_the_first_retest_node_of_the_owners_fixed_chain() -> None:\n411\t    state = _repair_cycle_state()\n412\t    state = _apply(state, repair.D19_ROUTE_UNIT_REPAIR(state, None))\n413\t    update = repair.D21_RETEST_REQUIRED_DESCENDANTS(state, None)\n414\t    assert update[\"pending_guard\"][\"value\"] == \"retest_frontier_incomplete\"\n415\t    assert update[\"pending_guard\"][\"detail\"][\"destination\"] == repair.RETEST_FIRST_NODE[\"curriculum domain\"]\n416\t    assert update[\"retest_results\"][0][\"dispatched_to\"] == \"D08_VALIDATE_DOMAIN\"\n417\t\n418\t\n419\tdef test_stale_evidence_at_an_old_head_cannot_pass_the_denominator() -> None:\n420\t    \"\"\"A check recorded against a superseded head is invisible to the reduction.\"\"\"\n421\t\n422\t    state = _passing_state()\n423\t    domain_stream = stream_id(UNIT, \"domain\")\n424\t    # Advance the domain head without refreshing its checks: the old checks\n425\t    # were recorded against the old (now-stale) head_hash.\n426\t    new_hash = canonical_digest({\"unit_id\": UNIT, \"facts\": []})\n427\t    state[\"artifact_heads\"][domain_stream] = _head(2, state[\"artifact_heads\"][domain_stream][\"hash\"], new_hash)\n428\t    result = acceptance.compute_unit_denominator(state, UNIT)\n429\t    assert not result.passed\n430\t    assert any(f[\"owner\"] == \"curriculum domain\" for f in result.findings)\n431\t\n432\t\n433\t# ---------------------------------------------------------------------------\n434\t# TEST 5: removing/failing/staling each acceptance member makes D22 reject\n435\t# ---------------------------------------------------------------------------\n436\t\n437\t\n438\tdef test_d22_accepts_a_fully_passing_denominator() -> None:\n439\t    state = _passing_state()\n440\t    update = acceptance.D22_ACCEPT_UNIT(state, None)\n441\t    assert update[\"pending_guard\"][\"value\"] == \"unit_accepted\"\n442\t    assert UNIT in update[\"accepted_unit_receipts\"]\n443\t\n444\t\n445\t@pytest.mark.parametrize(\n446\t    \"mutate\",\n447\t    [\n448\t        lambda s: s.__setitem__(\"source_admissions\", []),\n449\t        lambda s: s[\"deterministic_checks\"].__setitem__(0, {**s[\"deterministic_checks\"][0], \"result\": \"FAIL\"}),\n450\t        lambda s: s.__setitem__(\"visual_join_evidence\", []),\n451\t        lambda s: s.__setitem__(\"unit_page_inspections\", []),\n452\t        lambda s: s.__setitem__(\"unit_reviews\", []),\n453\t    ],\n454\t    ids=[\"source\", \"domain_check\", \"visuals\", \"pages\", \"review\"],\n455\t)\n456\tdef test_removing_or_failing_any_single_member_makes_d22_reject(mutate) -> None:\n457\t    state = _passing_state()\n458\t    mutate(state)\n459\t    with pytest.raises(SystemFailure):\n460\t        acceptance.D22_ACCEPT_UNIT(state, None)\n461\t\n462\t\n463\tdef test_staling_the_content_head_makes_d22_reject() -> None:\n464\t    state = _passing_state()\n465\t    content_stream = stream_id(UNIT, \"content\")\n466\t    new_hash = canonical_digest({\"unit_id\": UNIT, \"sections\": []})\n467\t    state[\"artifact_heads\"][content_stream] = _head(2, state[\"artifact_heads\"][content_stream][\"hash\"], new_hash)\n468\t    with pytest.raises(SystemFailure):\n469\t        acceptance.D22_ACCEPT_UNIT(state, None)\n470\t\n471\t\n472\t# ---------------------------------------------------------------------------\n473\t# TEST 6: accepted bytes remain immutable across resume, later units, and repair\n474\t# ---------------------------------------------------------------------------\n475\t\n476\t\n477\tdef test_accept_once_refuses_a_differing_second_write_for_the_same_unit() -> None:\n478\t    state = _passing_state()\n479\t    # Two independent computations against the same pre-acceptance state (as a\n480\t    # crash-before-durable-write replay would see) agree byte-for-byte.\n481\t    first = acceptance.D22_ACCEPT_UNIT(state, None)\n482\t    second = acceptance.D22_ACCEPT_UNIT(state, None)\n483\t    assert first[\"accepted_unit_receipts\"] == second[\"accepted_unit_receipts\"]\n484\t\n485\t    merged = _apply(state, first)\n486\t    replayed = red.accept_once(merged[\"accepted_unit_receipts\"], second[\"accepted_unit_receipts\"])\n487\t    assert replayed == merged[\"accepted_unit_receipts\"]\n488\t\n489\t    tampered = {UNIT: {**merged[\"accepted_unit_receipts\"][UNIT], \"receipt_hash\": \"deadbeef\"}}\n490\t    with pytest.raises(red.AcceptOnceConflict):\n491\t        red.accept_once(merged[\"accepted_unit_receipts\"], tampered)\n492\t\n493\t    # D22 itself refuses to reconsider a unit its own state already accepted.\n494\t    with pytest.raises(SystemFailure):\n495\t        acceptance.D22_ACCEPT_UNIT(merged, None)\n496\t\n497\t\n498\tdef test_an_already_accepted_unit_can_never_re_enter_classification_or_planning() -> None:\n499\t    state = _passing_state()\n500\t    state[\"accepted_unit_receipts\"] = {UNIT: {\"receipt_hash\": \"x\" * 64}}\n501\t    state[\"pending_guard\"] = {\n502\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n503\t        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n504\t    }\n505\t    with pytest.raises(SystemFailure):\n506\t        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n507\t\n508\t\n509\t# ---------------------------------------------------------------------------\n510\t# TEST 7: cursor advances only after checkpoint/evidence/log correlation flush\n511\t# ---------------------------------------------------------------------------\n512\t\n513\t\n514\tdef test_d23_writes_checkpoint_metadata_and_cursor_in_the_same_update() -> None:\n515\t    state = _passing_state()\n516\t    accept_update = acceptance.D22_ACCEPT_UNIT(state, None)\n517\t    state = _apply(state, accept_update)\n518\t    update = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n519\t    assert \"checkpoint_metadata\" in update and \"cursor\" in update"}]},"parent_