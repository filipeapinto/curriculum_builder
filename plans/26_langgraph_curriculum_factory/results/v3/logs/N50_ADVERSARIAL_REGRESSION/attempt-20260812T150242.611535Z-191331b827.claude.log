{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LJE7f3pZWSaEMkXFSiTmEb","type":"tool_result","content":"1\t\"\"\"Episode bootstrap, identity freeze, effective run, capability, and resume nodes.\n2\t\n3\tOwns D00, D00R, D01, D02, D03, D04, D92, and D96. These are the nodes that\n4\tdecide what run this is, what it is allowed to build, and whether it may build\n5\tanything at all. None of them produces curriculum content.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport re\n11\tfrom pathlib import Path\n12\tfrom typing import Any\n13\t\n14\timport yaml\n15\t\n16\tfrom . import (\n17\t    PrerequisitePause,\n18\t    SystemFailure,\n19\t    canonical_digest,\n20\t    deterministic_node,\n21\t    guard,\n22\t    require,\n23\t)\n24\t\n25\t__all__ = [\n26\t    \"BOOTSTRAP_KINDS\",\n27\t    \"RESUMABLE_TERMINAL_KINDS\",\n28\t    \"RUN_MODES\",\n29\t    \"REQUIRED_CAPABILITIES\",\n30\t    \"EPISODE_INVOCATION_FIELDS\",\n31\t    \"compile_prerequisite_closure\",\n32\t    \"manifest_unit_records\",\n33\t    \"D00_BOOTSTRAP_EPISODE\",\n34\t    \"D00R_REVALIDATE_RESUME_IDENTITY\",\n35\t    \"D01_VALIDATE_AND_FREEZE_INPUTS\",\n36\t    \"D02_COMPILE_EFFECTIVE_RUN\",\n37\t    \"D03_PROVE_CAPABILITIES\",\n38\t    \"D04_INITIALIZE_OR_RESUME\",\n39\t    \"D92_REENTER_VALIDATED_FRONTIER\",\n40\t    \"D96_GRACEFUL_INTERRUPT_GATE\",\n41\t]\n42\t\n43\t\n44\tBOOTSTRAP_KINDS: tuple[str, ...] = (\"fresh\", \"resume\", \"recover_orphan\")\n45\t\n46\t# Spec section 14's `Resume` column: only these two terminals may legally be\n47\t# resumed. Everything else is a final episode outcome.\n48\tRESUMABLE_TERMINAL_KINDS: tuple[str, ...] = (\"INTERRUPTED\", \"PAUSED_PREREQUISITE\")\n49\t\n50\tRUN_MODES: tuple[str, ...] = (\"one\", \"all\")\n51\t\n52\tREQUIRED_CAPABILITIES: tuple[str, ...] = (\n53\t    \"model_cli_identity\",\n54\t    \"retrieval\",\n55\t    \"renderer\",\n56\t    \"rasterizer\",\n57\t    \"persistence\",\n58\t    \"logger\",\n59\t)\n60\t\n61\t# The envelope the pre-invocation helper supplies as `FactoryInput[\"invocation\"]`.\n62\t# D00 is the only node that reads it raw; every later node reads frozen state.\n63\tEPISODE_INVOCATION_FIELDS: tuple[str, ...] = (\n64\t    \"kind\",\n65\t    \"contract_version\",\n66\t    \"engine_root\",\n67\t    \"curriculum_root\",\n68\t    \"output_root\",\n69\t    \"mode\",\n70\t    \"requested_unit_id\",\n71\t    \"authorization\",\n72\t    \"episode_ordinal\",\n73\t    \"prior_identity\",\n74\t    \"prior_terminal\",\n75\t    \"lease_open\",\n76\t)\n77\t\n78\t_MANIFEST_UNITS_KEY = \"labs\"\n79\t_UNIT_ID_KEY = \"id\"\n80\t\n81\t\n82\tdef _record(value: Any, label: str) -> dict[str, Any]:\n83\t    require(isinstance(value, dict), \"schema_contract\", f\"{label} must be a JSON object\")\n84\t    return dict(value)\n85\t\n86\t\n87\tdef _text(value: Any, label: str) -> str:\n88\t    require(\n89\t        isinstance(value, str) and value.strip() != \"\",\n90\t        \"schema_contract\",\n91\t        f\"{label} must be a non-empty string\",\n92\t    )\n93\t    return value\n94\t\n95\t\n96\tdef _canonical_path(value: Any, label: str) -> Path:\n97\t    \"\"\"Canonicalize an absolute path, rejecting relative traversal segments.\n98\t\n99\t    Symlinked parents are resolved rather than rejected (macOS `/var` is one),\n100\t    but a `..` segment is refused outright: it is the form a containment escape\n101\t    takes, and resolving it silently would hide where the run actually points.\n102\t    \"\"\"\n103\t\n104\t    path = Path(_text(value, label))\n105\t    require(path.is_absolute(), \"invalid_input\", f\"{label} must be an absolute path\", value=str(path))\n106\t    require(\n107\t        \"..\" not in path.parts,\n108\t        \"invalid_input\",\n109\t        f\"{label} must not contain a relative traversal segment\",\n110\t        value=str(path),\n111\t    )\n112\t    return path.resolve()\n113\t\n114\t\n115\tdef _sha256_file(path: Path) -> str:\n116\t    import hashlib\n117\t\n118\t    digest = hashlib.sha256()\n119\t    with path.open(\"rb\") as handle:\n120\t        for block in iter(lambda: handle.read(1 << 20), b\"\"):\n121\t            digest.update(block)\n122\t    return digest.hexdigest()\n123\t\n124\t\n125\tdef _now(runtime_context: Any) -> str:\n126\t    clock = getattr(runtime_context, \"clock\", None)\n127\t    require(callable(clock), \"capability\", \"runtime context exposes no clock\")\n128\t    return str(clock())\n129\t\n130\t\n131\t# --------------------------------------------------------------------------\n132\t# D00\n133\t# --------------------------------------------------------------------------\n134\t\n135\t\n136\t@deterministic_node(\"D00_BOOTSTRAP_EPISODE\")\n137\tdef D00_BOOTSTRAP_EPISODE(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n138\t    \"\"\"Classify this episode as fresh, legal resume, or orphan recovery.\"\"\"\n139\t\n140\t    invocation = projection[\"invocation\"]\n141\t    require(invocation is not None, \"invalid_input\", \"no episode invocation was supplied\")\n142\t    envelope = _record(invocation, \"invocation\")\n143\t\n144\t    unknown = sorted(set(envelope) - set(EPISODE_INVOCATION_FIELDS))\n145\t    require(\n146\t        not unknown,\n147\t        \"schema_contract\",\n148\t        \"invocation envelope declares undeclared fields\",\n149\t        unknown=unknown,\n150\t    )\n151\t\n152\t    kind = envelope.get(\"kind\")\n153\t    require(\n154\t        kind in BOOTSTRAP_KINDS,\n155\t        \"invalid_input\",\n156\t        f\"invocation kind {kind!r} is not one of {list(BOOTSTRAP_KINDS)}\",\n157\t    )\n158\t\n159\t    prior_identity_present = bool(projection[\"run_id\"]) or bool(envelope.get(\"prior_identity\"))\n160\t    prior_terminal = envelope.get(\"prior_terminal\") or projection[\"terminal\"]\n161\t    lease_open = bool(envelope.get(\"lease_open\"))\n162\t\n163\t    if kind == \"fresh\":\n164\t        require(\n165\t            not prior_identity_present,\n166\t            \"identity\",\n167\t            \"a fresh invocation cannot start against an existing run identity\",\n168\t        )\n169\t        require(\n170\t            not lease_open,\n171\t            \"identity\",\n172\t            \"a fresh invocation cannot start while a prior episode lease is open\",\n173\t        )\n174\t        classification = \"fresh\"\n175\t    elif kind == \"resume\":\n176\t        require(\n177\t            prior_identity_present,\n178\t            \"identity\",\n179\t            \"a resume invocation requires a prior immutable run identity\",\n180\t        )\n181\t        require(\n182\t            isinstance(prior_terminal, dict),\n183\t            \"identity\",\n184\t            \"a resume invocation requires a prior terminal record\",\n185\t        )\n186\t        terminal_kind = prior_terminal.get(\"kind\")\n187\t        require(\n188\t            terminal_kind in RESUMABLE_TERMINAL_KINDS,\n189\t            \"identity\",\n190\t            f\"terminal {terminal_kind!r} is not legally resumable\",\n191\t            resumable=list(RESUMABLE_TERMINAL_KINDS),\n192\t        )\n193\t        classification = \"resume\"\n194\t    else:\n195\t        require(\n196\t            prior_identity_present,\n197\t            \"identity\",\n198\t            \"orphan recovery requires a prior immutable run identity\",\n199\t        )\n200\t        require(\n201\t            lease_open and prior_terminal is None,\n202\t            \"identity\",\n203\t            \"orphan recovery requires an open prior lease with no terminal\",\n204\t            lease_open=lease_open,\n205\t            has_terminal=prior_terminal is not None,\n206\t        )\n207\t        classification = \"recover_orphan\"\n208\t\n209\t    # The sanitized envelope is what every later node sees: the raw prior\n210\t    # terminal/lease summary is bootstrap-only evidence and is not carried\n211\t    # forward as if it were this episode's state.\n212\t    sanitized = {\n213\t        field: envelope.get(field)\n214\t        for field in EPISODE_INVOCATION_FIELDS\n215\t        if field not in (\"prior_terminal\", \"lease_open\")\n216\t    }\n217\t    sanitized[\"kind\"] = classification\n218\t\n219\t    return {\n220\t        \"bootstrap_kind\": classification,\n221\t        \"invocation\": sanitized,\n222\t        \"pending_guard\": guard(\"D00_BOOTSTRAP_EPISODE\", classification),\n223\t    }\n224\t\n225\t\n226\t# --------------------------------------------------------------------------\n227\t# D00R\n228\t# --------------------------------------------------------------------------\n229\t\n230\t\n231\t@deterministic_node(\"D00R_REVALIDATE_RESUME_IDENTITY\")\n232\tdef D00R_REVALIDATE_RESUME_IDENTITY("}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"6c9a4658-4ed6-4bb2-b955-b2f5860434b4","timestamp":"2026-08-12T15:17:55.397Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
