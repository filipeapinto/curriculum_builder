{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012fdbG8qRENVWth8FTmFRSe","type":"tool_result","content":"1\t\"\"\"N31 acceptance tests: targeted repair (D17-D21) and unit acceptance (D16, D22, D23).\n2\t\n3\tTen TEST items from `prompts/N31_repair_acceptance.prompt.v2.md`. Every function\n4\tunder test is called directly and unmodified from `runtime.langgraph_factory.repair`\n5\t/ `acceptance`; TEST 9 additionally calls the real, unmodified\n6\t`runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's D98) rather than a\n7\tstand-in, and no test in this file writes to `nodes/terminal.py`.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport json\n13\tfrom typing import Any\n14\t\n15\timport pytest\n16\t\n17\tfrom runtime.langgraph_factory import acceptance, repair\n18\tfrom runtime.langgraph_factory.nodes import terminal\n19\tfrom runtime.langgraph_factory.nodes.domain import DOMAIN_CHECK_IDS\n20\tfrom runtime.langgraph_factory.nodes.content import CONTENT_CHECK_IDS\n21\tfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id\n22\tfrom runtime.langgraph_factory.state import FIELD_REDUCERS\n23\tfrom runtime.langgraph_factory import reducers as red\n24\t\n25\tRUN = \"run-n31\"\n26\tEPISODE = \"ep-n31\"\n27\tUNIT = \"U001\"\n28\t\n29\t\n30\tdef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n31\t    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n32\t\n33\t    merged = dict(state)\n34\t    for field, value in update.items():\n35\t        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n36\t    return merged\n37\t\n38\t\n39\tdef _domain_body() -> dict[str, Any]:\n40\t    return {\n41\t        \"unit_id\": UNIT,\n42\t        \"facts\": [{\"fact_id\": \"f1\", \"statement\": \"a fact\"}],\n43\t        \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n44\t    }\n45\t\n46\t\n47\tdef _content_body() -> dict[str, Any]:\n48\t    return {\n49\t        \"unit_id\": UNIT,\n50\t        \"sections\": [{\"section_id\": \"s1\", \"heading\": \"h\", \"body\": \"b\"}],\n51\t        \"claims\": [],\n52\t        \"derivations\": [],\n53\t    }\n54\t\n55\t\n56\tdef _visuals_body() -> dict[str, Any]:\n57\t    return {\"unit_id\": UNIT}\n58\t\n59\t\n60\tdef _head(version: int, parent_hash: str | None, hash_: str) -> dict[str, Any]:\n61\t    return {\"version\": version, \"parent_hash\": parent_hash, \"hash\": hash_}\n62\t\n63\t\n64\tdef _passing_state() -> dict[str, Any]:\n65\t    \"\"\"A unit whose full denominator currently passes (spec section 13.1).\"\"\"\n66\t\n67\t    domain_body = _domain_body()\n68\t    content_body = _content_body()\n69\t    visuals_body = _visuals_body()\n70\t    domain_hash = canonical_digest(domain_body)\n71\t    content_hash = canonical_digest(content_body)\n72\t    visuals_hash = canonical_digest(visuals_body)\n73\t    pdf_sha256 = \"f\" * 64\n74\t    page_sha = \"a\" * 64\n75\t\n76\t    domain_stream = stream_id(UNIT, \"domain\")\n77\t    content_stream = stream_id(UNIT, \"content\")\n78\t    visuals_stream = stream_id(UNIT, \"visuals\")\n79\t\n80\t    deterministic_checks = [\n81\t        {\n82\t            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash,\n83\t            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n84\t        }\n85\t        for check_id in DOMAIN_CHECK_IDS\n86\t    ] + [\n87\t        {\n88\t            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash,\n89\t            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n90\t        }\n91\t        for check_id in CONTENT_CHECK_IDS\n92\t    ]\n93\t\n94\t    review_candidate = {\n95\t        \"key\": \"candidate:review-1\",\n96\t        \"record_kind\": \"model_candidate\",\n97\t        \"pre_admission\": True,\n98\t        \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\",\n99\t        \"unit_pdf_sha256\": pdf_sha256,\n100\t        \"payload\": {"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"09e00d3b-5322-48dd-b3dd-a08811995a26","timestamp":"2026-08-12T15:13:10.891Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
