{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015yoaLHZCQ4Dir9jJ9Xywyw","type":"tool_result","content":"130\t                                  receipt=receipt, attempts=(receipt,))\n131\t\n132\t\n133\t# ------------------------------------------------------------------------- candidates\n134\t\n135\t\n136\tCANDIDATES: dict[str, dict[str, Any]] = {\n137\t    \"M01_discovery\": {\n138\t        \"locators\": [{\"request_id\": \"REQ-1\", \"url\": \"https://example.org/datasheet\",\n139\t                      \"title\": \"Datasheet\", \"publisher\": \"Acme\",\n140\t                      \"locator_kind\": \"primary\", \"rationale\": \"manufacturer document\"}],\n141\t    },\n142\t    \"M01_interpretation\": {\n143\t        \"interpretations\": [{\"request_id\": \"REQ-1\", \"retrieval_id\": \"RET-1\",\n144\t                             \"claims\": [{\"claim_text\": \"rated 20 mA\",\n145\t                                         \"source_quote\": \"20 mA\",\n146\t                                         \"source_location\": \"p. 2\"}],\n147\t                             \"limitations\": []}],\n148\t    },\n149\t    \"M02_CREATE_UNIT_DOMAIN_DATA\": {\n150\t        \"domain_version\": {\"unit_id\": \"U01\", \"fields\": {\"forward_current_ma\": 20},\n151\t                           \"evidence_references\": [{\"source_id\": \"SRC-1\",\n152\t                                                    \"source_location\": \"p. 2\"}]},\n153\t    },\n154\t    \"M03_WRITE_UNIT_CONTENT\": {\n155\t        \"unit_content\": {\"unit_id\": \"U01\",\n156\t                         \"sections\": [{\"section_id\": \"s1\", \"heading\": \"Levers\",\n157\t                                       \"body\": \"A lever pivots.\"}],\n158\t                         \"evidence_references\": [{\"section_id\": \"s1\", \"source_id\": \"SRC-1\",\n159\t                                                  \"source_location\": \"p. 2\"}]},\n160\t    },\n161\t    \"M04_CREATE_UNIT_VISUALS\": {\n162\t        \"visual_candidate\": {\"brief_id\": \"B1\", \"prompt_text\": \"a pivoting lever\",\n163\t                             \"dimensions\": {\"width_px\": 1024, \"height_px\": 768},\n164\t                             \"image_format\": \"png\",\n165\t                             \"accessibility_text\": \"a lever on a fulcrum\"},\n166\t        \"provenance_declaration\": {\"brief_id\": \"B1\",\n167\t                                   \"permitted_facts_used\": [\"a lever pivots\"],\n168\t                                   \"asserts_authoritative_detail\": False},\n169\t    },\n170\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": {\n171\t        \"candidate_child\": {\"artifact_name\": \"content.json\", \"artifact_body\": \"{}\",\n172\t                            \"addressed_finding_ids\": [\"F1\"]},\n173\t        \"changed_path_manifest\": [{\"json_pointer\": \"/sections/0/body\",\n174\t                                   \"change_kind\": \"replace\", \"finding_id\": \"F1\"}],\n175\t    },\n176\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": {\n177\t        \"candidate_child\": {\"artifact_name\": \"workbook.typ\", \"artifact_body\": \"#set page()\",\n178\t                            \"addressed_defect_id\": \"D1\"},\n179\t        \"changed_file_manifest\": [{\"staged_file_name\": \"navigation.typ\",\n180\t                                   \"change_kind\": \"replace\", \"defect_id\": \"D1\"}],\n181\t    },\n182\t}\n183\t\n184\t\n185\tdef page_hash(number: int) -> str:\n186\t    return f\"{number:x}\" * 64\n187\t\n188\t\n189\tdef review_candidate(page_count: int = 2) -> dict[str, Any]:\n190\t    return {\n191\t        \"overall_findings\": [],\n192\t        \"page_findings\": [{\"page_number\": number, \"page_sha256\": page_hash(number),\n193\t                           \"findings\": []}\n194\t                          for number in range(1, page_count + 1)],\n195\t    }\n196\t\n197\t\n198\tCANDIDATES[\"M05_REVIEW_ACTUAL_UNIT\"] = review_candidate()\n199\tCANDIDATES[\"M07_REVIEW_ACTUAL_WORKBOOK\"] = review_candidate()\n200\t\n201\t\n202\t# ---------------------------------------------------------------------------- packets\n203\t\n204\t\n205\tdef reservation_for(job_id: str, *, correlation_key: str = \"corr-1\",\n206\t                    activation_id: str = \"act-1\",\n207\t                    state: dict[str, Any] | None = None) -> dict[str, Any]:\n208\t    update = mn.reserve_model_attempt(state or {}, job_id=job_id,\n209\t                                      correlation_key=correlation_key,\n210\t                                      activation_id=activation_id)\n211\t    return update[\"pending_guard\"][\"reservation\"]\n212\t\n213\t\n214\tdef correlation(correlation_key: str = \"corr-1\") -> dict[str, Any]:\n215\t    return {\"run_id\": RUN_ID, \"episode_id\": EPISODE_ID, \"correlation_key\": correlation_key}\n216\t\n217\t\n218\tUNIT = {\"unit_id\": \"U01\", \"title\": \"Levers\", \"objectives\": [\"explain a lever\"]}\n219\tSOURCE_RULES = {\"primary_source_required\": True, \"admission_policy\": \"primary_only\"}\n220\tREQUEST = {\"request_id\": \"REQ-1\", \"question\": \"What is the rated forward current?\"}\n221\t\n222\t\n223\tdef packet_for(spec_name: str) -> dict[str, Any]:\n224\t    job_id = mn.PROJECTION_SPECS[spec_name].job_id\n225\t    base = {\"correlation\": correlation(),\n226\t            \"reservation\": reservation_for(job_id)}\n227\t    if spec_name == \"M01_discovery\":\n228\t        base.update({\"phase\": \"DISCOVER\", \"request\": dict(REQUEST), \"unit\": dict(UNIT),\n229\t                     \"source_rules\": dict(SOURCE_RULES),\n230\t                     \"discovery_authority\": {\"granted\": True, \"scope\": \"hosted_discovery\"}})\n231\t    elif spec_name == \"M01_interpretation\":\n232\t        base.update({\"phase\": \"INTERPRET\", \"request\": dict(REQUEST), \"unit\": dict(UNIT),\n233\t                     \"source_rules\": dict(SOURCE_RULES),\n234\t                     \"retrieval_group\": {\n235\t                         \"retrieval_group_hash\": SHA,\n236\t                         \"retrieved_records\": [{\"retrieval_id\": \"RET-1\", \"sha256\": SHA,\n237\t                                         \"content_type\": \"text/html\",\n238\t                                         \"staged_name\": \"ret-1.html\"}]}})\n239\t    elif spec_name == \"M02_domain\":\n240\t        base.update({\"unit\": dict(UNIT),\n241\t                     \"admitted_sources\": [{\"source_id\": \"SRC-1\", \"excerpt\": \"20 mA\",\n242\t                                           \"source_scope\": \"unit\"}],\n243\t                     \"domain_schema\": {\"$id\": \"domain.v1\", \"type\": \"object\"},\n244\t                     \"domain_config\": {\"unit_system\": \"SI\"},\n245\t                     \"verifier_interface\": {\"name\": \"verify_domain\",\n246\t                                            \"signature\": \"(domain) -> findings\"},\n247\t                     \"calibration\": {\"fixtures\": [\"fx-1\"]}})\n248\t    elif spec_name == \"M03_content\":\n249\t        base.update({\"unit\": dict(UNIT),\n250\t                     \"admitted_domain\": {\"unit_id\": \"U01\", \"domain_sha256\": SHA,\n251\t                                         \"fields\": {\"forward_current_ma\": 20}},\n252\t                     \"curriculum_contracts\": {\"schema\": \"unit.v1\",\n253\t                                              \"readability\": \"grade-6\",\n254\t                                              \"safety\": \"no live mains\"},\n255\t                     \"admitted_evidence_references\": [{\"source_id\": \"SRC-1\",\n256\t                                                       \"source_location\": \"p. 2\"}]})\n257\t    elif spec_name == \"M04_visual\":\n258\t        base.update({\"brief\": {\"brief_id\": \"B1\", \"unit_id\": \"U01\",\n259\t                               \"visual_class\": \"conceptual\", \"content_hash\": CONTENT_HASH,\n260\t                               \"eligibility\": \"model_eligible\", \"authoritative\": False,\n261\t                               \"description\": \"a lever on a fulcrum\"},\n262\t                     \"permitted_facts\": [\"a lever pivots\"],\n263\t                     \"visual_contract\": {\"width_px\": 1024, \"height_px\": 768,\n264\t                                         \"image_format\": \"png\",\n265\t                                         \"accessibility\": \"alt text required\"}})\n266\t    elif spec_name == \"M05_unit_review\":\n267\t        base.update({\"unit_artifacts\": {\"domain_sha256\": SHA, \"content_sha256\": SHA,\n268\t                                        \"visual_sha256\": [SHA]},\n269\t                     \"unit_pdf\": {\"name\": \"unit.pdf\", \"sha256\": SHA},\n270\t                     \"page_inventory\": page_inventory(2),\n271\t                     \"pages\": page_images(2),\n272\t                     \"deterministic_evidence\": {\"checks\": [{\"check_id\": \"render\",\n273\t                                                            \"observed\": \"2 pages\"}]},\n274\t                     \"rubric\": {\"rubric_sha256\": SHA, \"criteria\": [\"legibility\"]}})\n275\t    elif spec_name == \"M06_unit_repair\":\n276\t        base.update({\"owner\": \"unit_content\",\n277\t                     \"findings\": [{\"finding_id\": \"F1\", \"owner\": \"unit_content\",\n278\t                                   \"severity\": \"blocking\", \"description\": \"unclear body\"}],\n279\t                     \"parent\": {\"artifact_name\": \"content.json\", \"unit_id\": \"U01\",\n280\t                                \"channel\": \"content\", \"parent_sha256\": SHA},\n281\t                     \"boundary\": {\"json_pointers\": [\"/sections/0/body\"],\n282\t                                  \"files\": [\"content.json\"], \"region\": \"section s1\"},\n283\t                     \"allowed_facts\": [\"a lever pivots\"],\n284\t                     \"invalidated_descendants\": [\"render\", \"review\"],\n285\t                     \"retest_order\": [\"render\", \"pages\", \"review\"]})\n286\t    elif spec_name == \"M07_workbook_review\":\n287\t        base.update({\"coverage_map\": [{\"position\": 1, \"unit_id\": \"U01\", \"unit_sha256\": SHA}],\n288\t                     \"accepted_unit_hashes\": {\"U01\": SHA},\n289\t                     \"workbook_pdf\": {\"name\": \"workbook.pdf\", \"sha256\": SHA},\n290\t                     \"page_inventory\": page_inventory(2),\n291\t                     \"pages\": page_images(2),\n292\t                     \"deterministic_evidence\": {\"checks\": [{\"check_id\": \"assemble\",\n293\t                                                            \"observed\": \"2 pages\"}]},\n294\t                     \"rubric\": {\"rubric_sha256\": SHA, \"criteria\": [\"navigation\"]}})\n295\t    elif spec_name == \"M08_workbook_repair\":\n296\t        base.update({\"defect\": {\"defect_id\": \"D1\", \"component\": \"navigation\",\n297\t                                \"description\": \"table of contents is stale\"},\n298\t                     \"parent\": {\"artifact_name\": \"workbook.typ\", \"parent_sha256\": SHA},\n299\t                     \"allowed_files\": {\"files\": [\"navigation.typ\", \"front_matter.typ\"]},\n300\t                     \"accepted_unit_hashes\": {\"U01\": SHA},\n301\t                     \"workbook_pdf_hash\": SHA,\n302\t                     \"invalidated_descendants\": [\"assemble\", \"render\"],\n303\t                     \"retest_order\": [\"assemble\", \"render\", \"pages\"]})\n304\t    else:  # pragma: no cover - the table above is exhaustive\n305\t        raise AssertionError(spec_name)\n306\t    return base\n307\t\n308\t\n309\tdef page_inventory(count: int) -> dict[str, Any]:\n310\t    return {\"page_count\": count,\n311\t            \"pages\": [{\"page_number\": number, \"page_sha256\": page_hash(number)}\n312\t                      for number in range(1, count + 1)]}\n313\t\n314\t\n315\tdef page_images(count: int) -> list[dict[str, Any]]:\n316\t    return [{\"page_number\": number, \"page_sha256\": page_hash(number),\n317\t             \"image_name\": f\"page-{number}.png\"}\n318\t            for number in range(1, count + 1)]\n319\t\n320\t\n321\tADAPTER_FOR_SPEC = {\n322\t    \"M01_discovery\": mn.m01_discover_unit_sources,\n323\t    \"M01_interpretation\": mn.m01_interpret_unit_sources,\n324\t    \"M02_domain\": mn.m02_create_unit_domain_data,\n325\t    \"M03_content\": mn.m03_write_unit_content,\n326\t    \"M04_visual\": mn.m04_create_unit_visuals,\n327\t    \"M05_unit_review\": mn.m05_review_actual_unit,\n328\t    \"M06_unit_repair\": mn.m06_repair_named_unit_artifact,\n329\t    \"M07_workbook_review\": mn.m07_review_actual_workbook,\n330\t    \"M08_workbook_repair\": mn.m08_repair_named_workbook_defect,\n331\t}\n332\t\n333\t\n334\tdef candidate_for(spec_name: str) -> dict[str, Any]:\n335\t    if spec_name.startswith(\"M01\"):\n336\t        return copy.deepcopy(CANDIDATES[spec_name])\n337\t    return copy.deepcopy(CANDIDATES[mn.PROJECTION_SPECS[spec_name].job_id])\n338\t\n339\t\n340\tdef context_for(spec_name: str, *, candidate: dict[str, Any] | None = None,\n341\t                errors: list[Exception] | None = None,\n342\t                observed_family: dict[str, str] | None = None,\n343\t                ) -> tuple[mn.ModelNodeContext, RecordingTransport]:\n344\t    job_id = mn.PROJECTION_SPECS[spec_name].job_id\n345\t    payload = candidate if candidate is not None else candidate_for(spec_name)\n346\t    transport = RecordingTransport({job_id: payload}, errors=errors,\n347\t                                   observed_family=observed_family)\n348\t    return mn.ModelNodeContext(transport=transport, registry=tp.load_job_registry()), transport\n349\t\n350\t\n351\tdef run(spec_name: str, *, packet: dict[str, Any] | None = None,\n352\t        candidate: dict[str, Any] | None = None,\n353\t        errors: list[Exception] | None = None,\n354\t        observed_family: dict[str, str] | None = None) -> dict[str, Any]:\n355\t    context, _ = context_for(spec_name, candidate=candidate, errors=errors,\n356\t                             observed_family=observed_family)\n357\t    return ADAPTER_FOR_SPEC[spec_name](packet or packet_for(spec_name), context)\n358\t\n359\t\n360\t# ==================================================== TEST 1: eight jobs, family split\n361\t\n362\t\n363\tdef test_exactly_eight_model_nodes_and_adapters():\n364\t    assert len(mn.MODEL_NODE_IDS) == 8\n365\t    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n366\t    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n367\t    assert set(mn.MODEL_NODE_IDS) == set(tp.load_job_registry())\n368\t\n369\t\n370\tdef test_family_split_matches_the_frozen_registry():\n371\t    registry = tp.load_job_registry()\n372\t    assert mn.MODEL_NODE_FAMILIES == EXPECTED_FAMILY\n373\t    for job_id, family in EXPECTED_FAMILY.items():\n374\t        assert registry[job_id].family == family\n375\t        assert registry[job_id].cli == (\"gemini\" if family == \"google\" else \"codex\")\n376\t    codex = {job for job, family in EXPECTED_FAMILY.items() if family == \"openai\"}\n377\t    gemini = {job for job, family in EXPECTED_FAMILY.items() if family == \"google\"}\n378\t    assert codex == {\"M01_RESEARCH_UNIT_SOURCES\", \"M02_CREATE_UNIT_DOMAIN_DATA\",\n379\t                     \"M03_WRITE_UNIT_CONTENT\", \"M04_CREATE_UNIT_VISUALS\",\n380\t                     \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n381\t                     \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\"}\n382\t    assert gemini == {\"M05_REVIEW_ACTUAL_UNIT\", \"M07_REVIEW_ACTUAL_WORKBOOK\"}\n383\t\n384\t\n385\tdef test_a_projection_exists_for_every_job_and_both_m01_phases():\n386\t    assert set(mn.PROJECTION_SPECS) == set(SPEC_SECTION_9)\n387\t    covered = {spec.job_id for spec in mn.PROJECTION_SPECS.values()}\n388\t    assert covered == set(mn.MODEL_NODE_IDS)\n389\t    m01 = [name for name, spec in mn.PROJECTION_SPECS.items()\n390\t           if spec.job_id == \"M01_RESEARCH_UNIT_SOURCES\"]\n391\t    assert sorted(m01) == [\"M01_discovery\", \"M01_interpretation\"]\n392\t\n393\t\n394\tdef test_build_model_nodes_registers_exactly_eight_callables(tmp_path):\n395\t    context = mn.build_test_model_node_context(\n396\t        sandbox_root=tmp_path, responses={\"M03_WRITE_UNIT_CONTENT\":\n397\t                                          CANDIDATES[\"M03_WRITE_UNIT_CONTENT\"]})\n398\t    nodes = mn.build_model_nodes(context)\n399\t    assert sorted(nodes) == sorted(mn.MODEL_NODE_IDS)\n400\t    assert all(callable(node) for node in nodes.values())\n401\t\n402\t\n403\t# ============================================ TEST 2: projections equal spec section 9\n404\t\n405\t\n406\t@pytest.mark.parametrize(\"spec_name\", sorted(SPEC_SECTION_9))\n407\tdef test_every_projection_equals_the_spec_section_9_row(spec_name):\n408\t    spec = mn.PROJECTION_SPECS[spec_name]\n409\t    expected = SPEC_SECTION_9[spec_name]\n410\t    assert spec.allowed == expected[\"included\"]\n411\t    assert spec.excluded_doc == expected[\"excluded_doc\"]\n412\t    projection = mn.build_projection(spec_name, packet_for(spec_name))\n413\t    assert set(projection) <= set(spec.allowed)\n414\t    assert set(spec.required) <= set(projection)\n415\t\n416\t\n417\t@pytest.mark.parametrize(\"spec_name\", sorted(SPEC_SECTION_9))\n418\tdef test_a_poisoned_full_state_cannot_widen_any_projection(spec_name):\n419\t    \"\"\"Handing a builder the whole state must not leak one field past its allowlist.\"\"\""}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"9534b5e5-1f2b-435f-a790-1684ae06dc90","timestamp":"2026-08-12T15:13:35.067Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
