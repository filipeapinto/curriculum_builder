{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016uEdj8n6wDW2tLXNyuREaG","type":"tool_result","content":"1\t\"\"\"N21 persistence/resume proof against the real SqliteSaver (spec section 11).\n2\t\n3\tEvery checkpoint assertion here runs against a real `langgraph.checkpoint.sqlite`\n4\tsaver over a real `sqlite3` file, a real compiled multi-node graph, and — for the\n5\tcrash and lock-race matrices — real operating-system processes that are actually\n6\tSIGKILLed. Nothing in this module substitutes a mock for the durability it\n7\tclaims to prove.\n8\t\n9\tSkips only where the hash-locked environment is absent (same technique as\n10\ttests/runtime/test_plan26_api_contract.py), so the repository's ambient\n11\t`python3 -m pytest -q` stays green; CI installs requirements/plan26.lock with\n12\t--require-hashes and therefore runs the whole module for real.\n13\t\"\"\"\n14\t\n15\timport ast\n16\timport hashlib\n17\timport json\n18\timport operator\n19\timport os\n20\timport signal\n21\timport sqlite3\n22\timport subprocess\n23\timport sys\n24\timport tempfile\n25\timport textwrap\n26\timport unittest\n27\tfrom pathlib import Path\n28\tfrom typing import Annotated, Any, TypedDict\n29\t\n30\ttry:  # pragma: no cover - environment probe, not behavior\n31\t    import langgraph  # noqa: F401\n32\t    import langgraph.checkpoint.sqlite  # noqa: F401\n33\texcept ModuleNotFoundError as exc:  # pragma: no cover\n34\t    raise unittest.SkipTest(\n35\t        \"plan26 hash-locked environment not installed \"\n36\t        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n37\t        f\"{exc}\"\n38\t    ) from exc\n39\t\n40\tfrom langgraph.graph import END, START, StateGraph\n41\t\n42\tfrom runtime.langgraph_factory import persistence as P\n43\tfrom runtime.langgraph_factory.evidence import EvidenceStore\n44\tfrom runtime.langgraph_factory.nodes import project as project_for_node\n45\tfrom runtime.langgraph_factory.nodes import terminal as D98\n46\tfrom runtime.langgraph_factory.state import RuntimeContext\n47\t\n48\tREPO_ROOT = Path(__file__).resolve().parents[2]\n49\tPERSISTENCE_SOURCE = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"persistence.py\"\n50\t\n51\tIDENTITY_SEED = {\n52\t    \"contract_version\": \"plan26.v1\",\n53\t    \"created_at\": \"2026-08-11T00:00:00Z\",\n54\t    \"engine_root\": \"/engine\",\n55\t    \"curriculum_root\": \"/curriculum\",\n56\t    \"active_manifest_path\": \"/curriculum/manifest.yaml\",\n57\t    \"output_root\": \"/output\",\n58\t    \"mode\": \"one\",\n59\t    \"requested_unit_id\": \"U01\",\n60\t}\n61\t\n62\t\n63\tclass LinearState(TypedDict, total=False):\n64\t    seen: Annotated[list, operator.add]\n65\t\n66\t\n67\tclass FanoutState(TypedDict, total=False):\n68\t    ok: Annotated[list, operator.add]\n69\t\n70\t\n71\tdef _tree_snapshot(root: Path, *, skip_control: bool = True) -> dict[str, tuple[int, str]]:\n72\t    \"\"\"mtime_ns + sha256 of every file under ``root``, for before/after proofs.\"\"\"\n73\t    out: dict[str, tuple[int, str]] = {}\n74\t    for path in sorted(root.rglob(\"*\")):\n75\t        if not path.is_file():\n76\t            continue\n77\t        relative = path.relative_to(root).as_posix()\n78\t        if skip_control and relative.startswith(f\"{P.LANGGRAPH_DIRNAME}/\"):\n79\t            continue\n80\t        out[relative] = (\n81\t            path.stat().st_mtime_ns,\n82\t            hashlib.sha256(path.read_bytes()).hexdigest(),\n83\t        )\n84\t    return out\n85\t\n86\t\n87\tdef _run_child(script: str, *args: str) -> subprocess.CompletedProcess:\n88\t    with tempfile.NamedTemporaryFile(\"w\", suffix=\".py\", delete=False) as handle:\n89\t        handle.write(textwrap.dedent(script))\n90\t        child_path = handle.name\n91\t    try:\n92\t        return subprocess.run(\n93\t            [sys.executable, child_path, str(REPO_ROOT), *args],\n94\t            capture_output=True,\n95\t            text=True,\n96\t            timeout=180,\n97\t        )\n98\t    finally:\n99\t        os.unlink(child_path)\n100\t\n101\t\n102\tCRASH_CHILD = \"\"\"\n103\t    import operator, os, signal, sys\n104\t    from pathlib import Path\n105\t    from typing import Annotated, TypedDict\n106\t\n107\t    sys.path.insert(0, sys.argv[1])\n108\t    from runtime.langgraph_factory import persistence as P\n109\t    from langgraph.graph import END, START, StateGraph\n110\t\n111\t    output_root = Path(sys.argv[2])\n112\t    boundary = sys.argv[3]\n113\t    thread_id = sys.argv[4]\n114\t\n115\t    lock = P.ExecutionLock(output_root).acquire()\n116\t    saver, conn = P.open_checkpoint_saver(output_root)\n117\t    admissions = P.AdmissionLedger(output_root)\n118\t\n119\t    class S(TypedDict, total=False):\n120\t        done: Annotated[list, operator.add]\n121\t\n122\t    def render(state):\n123\t        if boundary == \"before_admit\":\n124\t            os.kill(os.getpid(), signal.SIGKILL)\n125\t        admissions.admit(\"unit-a:render:1\", {\"bytes\": \"ACCEPTED\"})\n126\t        if boundary == \"after_admit\":\n127\t            os.kill(os.getpid(), signal.SIGKILL)\n128\t        return {\"done\": [\"render\"]}\n129\t\n130\t    builder = StateGraph(S)\n131\t    builder.add_node(\"D13\", render)\n132\t    builder.add_edge(START, \"D13\")\n133\t    builder.add_edge(\"D13\", END)\n134\t    graph = builder.compile(checkpointer=saver, name=P.COMPILED_GRAPH_NAME)\n135\t    graph.invoke({\"done\": []}, config=P.invoke_config(thread_id))\n136\t    P.flush_checkpoint_durability(conn, output_root)\n137\t    if boundary == \"after_checkpoint\":\n138\t        os.kill(os.getpid(), signal.SIGKILL)\n139\t    sys.exit(0)\n140\t\"\"\"\n141\t\n142\tLOCK_CHILD = \"\"\"\n143\t    import sys\n144\t    from pathlib import Path\n145\t\n146\t    sys.path.insert(0, sys.argv[1])\n147\t    from runtime.langgraph_factory import persistence as P\n148\t\n149\t    try:\n150\t        P.ExecutionLock(Path(sys.argv[2])).acquire()\n151\t    except P.ExecutionLockUnavailable:\n152\t        sys.stderr.write(\"LOSER\\\\n\")\n153\t        sys.exit(P.LOCK_LOSER_EXIT_CODE)\n154\t    sys.stdout.write(\"WINNER\\\\n\")\n155\t    sys.exit(0)\n156\t\"\"\"\n157\t\n158\tORPHAN_CHILD = \"\"\"\n159\t    import operator, os, signal, sys\n160\t    from pathlib import Path\n161\t    from typing import Annotated, TypedDict\n162\t\n163\t    sys.path.insert(0, sys.argv[1])\n164\t    from runtime.langgraph_factory import persistence as P\n165\t    from langgraph.graph import END, START, StateGraph\n166\t\n167\t    output_root = Path(sys.argv[2])\n168\t    seed = {\n169\t        \"contract_version\": \"plan26.v1\",\n170\t        \"created_at\": \"2026-08-11T00:00:00Z\",\n171\t        \"engine_root\": \"/engine\",\n172\t        \"curriculum_root\": \"/curriculum\",\n173\t        \"active_manifest_path\": \"/curriculum/manifest.yaml\",\n174\t        \"output_root\": \"/output\",\n175\t        \"mode\": \"one\",\n176\t        \"requested_unit_id\": \"U01\",\n177\t    }\n178\t\n179\t    lock = P.ExecutionLock(output_root).acquire()\n180\t    saver, conn = P.open_checkpoint_saver(output_root)\n181\t    invocation = P.prepare_episode_invocation(\n182\t        output_root=output_root, lock=lock, identity_seed=seed\n183\t    )\n184\t\n185\t    class S(TypedDict, total=False):\n186\t        seen: Annotated[list, operator.add]\n187\t\n188\t    builder = StateGraph(S)\n189\t    builder.add_node(\"D05\", lambda state: {\"seen\": [\"D05\"]})\n190\t    builder.add_node(\"M03\", lambda state: {\"seen\": [\"M03\"]})\n191\t    builder.add_edge(START, \"D05\")\n192\t    builder.add_edge(\"D05\", \"M03\")\n193\t    builder.add_edge(\"M03\", END)\n194\t    graph = builder.compile(checkpointer=saver, name=P.COMPILED_GRAPH_NAME)\n195\t    graph.invoke({\"seen\": []}, config=invocation.config)\n196\t    P.flush_checkpoint_durability(conn, output_root)\n197\t    sys.stdout.write(invocation.thread_id + \"\\\\n\")\n198\t    sys.stdout.flush()\n199\t    # Power loss: D98 never runs, so the episode lease is left open.\n200\t    os.kill(os.getpid(), signal.SIGKILL)\n201\t\"\"\"\n202\t\n203\t\n204\tclass PersistenceTestCase(unittest.TestCase):\n205\t    \"\"\"Shared fixture: one temp output root with a held lock and a real saver.\"\"\"\n206\t\n207\t    def setUp(self) -> None:\n208\t        self.output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_\")).resolve()\n209\t        self.lock = P.ExecutionLock(self.output_root).acquire()\n210\t        self.addCleanup(self.lock.release)\n211\t        self.saver, self.conn = P.open_checkpoint_saver(self.output_root)\n212\t        self.addCleanup(self.conn.close)\n213\t\n214\t    def compile_graph(self, builder: StateGraph) -> Any:\n215\t        return builder.compile(checkpointer=self.saver, name=P.COMPILED_GRAPH_NAME)\n216\t\n217\t    def linear_graph(self) -> Any:\n218\t        builder = StateGraph(LinearState)\n219\t        builder.add_node(\"D05\", lambda state: {\"seen\": [\"D05\"]})\n220\t        builder.add_node(\"D13\", lambda state: {\"seen\": [\"D13\"]})\n221\t        builder.add_edge(START, \"D05\")\n222\t        builder.add_edge(\"D05\", \"D13\")\n223\t        builder.add_edge(\"D13\", END)\n224\t        return self.compile_graph(builder)\n225\t\n226\t    def fresh_invocation(self, **overrides: Any) -> P.EpisodeInvocation:\n227\t        seed = {**IDENTITY_SEED, \"output_root\": str(self.output_root), **overrides}\n228\t        return P.prepare_episode_invocation(\n229\t            output_root=self.output_root, lock=self.lock, identity_seed=seed\n230\t        )\n231\t\n232\t\n233\t# --------------------------------------------------------------------------\n234\t# TEST 1 — checkpoint path, pragmas, thread ids, namespace\n235\t# --------------------------------------------------------------------------\n236\t\n237\t\n238\tclass TestCheckpointConfiguration(PersistenceTestCase):\n239\t    def test_checkpoint_database_lives_at_the_spec_path(self) -> None:\n240\t        expected = self.output_root / \".langgraph\" / \"checkpoints.sqlite3\"\n241\t        self.assertEqual(P.checkpoint_db_path(self.output_root), expected)\n242\t        self.assertTrue(expected.is_file(), \"SqliteSaver.setup() did not create the database file\")\n243\t        self.assertEqual(\n244\t            P.execution_lock_path(self.output_root),\n245\t            self.output_root / \".langgraph\" / \"execution.lock\",\n246\t        )\n247\t\n248\t    def test_live_connection_reports_the_required_pragmas(self) -> None:\n249\t        observed = P.read_connection_pragmas(self.conn)\n250\t        self.assertEqual(observed[\"journal_mode\"], \"wal\")\n251\t        self.assertEqual(observed[\"synchronous\"], 2, \"synchronous must be FULL (2)\")\n252\t        self.assertEqual(observed[\"foreign_keys\"], 1)\n253\t        self.assertEqual(observed[\"busy_timeout\"], P.SQLITE_BUSY_TIMEOUT_MS)\n254\t        self.assertEqual(P.verify_connection_pragmas(self.conn), observed)\n255\t\n256\t    def test_wal_mode_is_visible_in_the_actual_sqlite_file_header(self) -> None:\n257\t        # Byte 18/19 of the SQLite header are the file format read/write versions;\n258\t        # WAL sets both to 2. This reads the committed file, not the connection.\n259\t        self.conn.commit()\n260\t        header = P.checkpoint_db_path(self.output_root).read_bytes()[:20]\n261\t        self.assertEqual((header[18], header[19]), (2, 2), \"database file is not in WAL format\")\n262\t\n263\t    def test_a_relaxed_pragma_is_refused_rather_than_silently_accepted(self) -> None:\n264\t        self.conn.execute(\"PRAGMA synchronous=OFF\")\n265\t        with self.assertRaises(P.CheckpointCorrupt):\n266\t            P.verify_connection_pragmas(self.conn)\n267\t\n268\t    def test_saver_tables_exist_in_the_real_database(self) -> None:\n269\t        names = {\n270\t            row[0]\n271\t            for row in self.conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")\n272\t        }\n273\t        self.assertIn(\"checkpoints\", names)\n274\t        self.assertIn(\"writes\", names)\n275\t\n276\t    def test_thread_ids_follow_the_frozen_format(self) -> None:\n277\t        self.assertEqual(P.episode_thread_id(\"run-x\", 1), \"run-x:episode:000001\")\n278\t        self.assertEqual(P.episode_thread_id(\"run-x\", 123456), \"run-x:episode:123456\")\n279\t        self.assertEqual(P.recovery_thread_id(\"run-x\", 7), \"run-x:recover:7\")\n280\t        for bad in (0, -1):\n281\t            with self.subTest(ordinal=bad), self.assertRaises(P.PersistenceError):\n282\t                P.episode_thread_id(\"run-x\", bad)\n283\t\n284\t    def test_invoke_config_is_exactly_thread_id_and_root_namespace(self) -> None:\n285\t        config = P.invoke_config(\"run-x:episode:000001\")\n286\t        self.assertEqual(\n287\t            config, {\"configurable\": {\"thread_id\": \"run-x:episode:000001\", \"checkpoint_ns\": \"\"}}\n288\t        )\n289\t        self.assertEqual(P.CHECKPOINT_NS, \"\")\n290\t\n291\t    def test_strict_msgpack_is_enforced_for_persisted_values(self) -> None:\n292\t        self.assertEqual(os.environ[P.STRICT_MSGPACK_ENV], \"true\")\n293\t\n294\t    def test_a_real_checkpoint_is_stored_under_the_root_namespace(self) -> None:\n295\t        invocation = self.fresh_invocation()\n296\t        self.linear_graph().invoke({\"seen\": []}, config=invocation.config)\n297\t        rows = self.conn.execute(\n298\t            \"SELECT DISTINCT thread_id, checkpoint_ns FROM checkpoints\"\n299\t        ).fetchall()\n300\t        self.assertEqual(rows, [(invocation.thread_id, \"\")])\n301\t        self.assertTrue(invocation.thread_id.endswith(\":episode:000001\"))\n302\t        self.assertTrue(invocation.thread_id.startswith(invocation.run_id))\n303\t\n304\t    def test_run_id_is_deterministic_and_seed_sensitive(self) -> None:\n305\t        first = P.compute_fresh_run_id(IDENTITY_SEED)\n306\t        self.assertEqual(first, P.compute_fresh_run_id(dict(IDENTITY_SEED)))\n307\t        drifted = {**IDENTITY_SEED, \"mode\": \"all\"}\n308\t        self.assertNotEqual(first, P.compute_fresh_run_id(drifted))\n309\t\n310\t    def test_prepare_requires_the_exclusive_lock(self) -> None:\n311\t        idle = P.ExecutionLock(self.output_root)\n312\t        with self.assertRaises(P.PersistenceError):\n313\t            P.prepare_episode_invocation(\n314\t                output_root=self.output_root, lock=idle, identity_seed=IDENTITY_SEED\n315\t            )\n316\t\n317\t\n318\t# --------------------------------------------------------------------------\n319\t# TEST 2 — snapshots, next/tasks, pending writes, evidence high-water marks\n320\t# --------------------------------------------------------------------------\n321\t\n322\t\n323\tclass TestSupersepCorrelation(PersistenceTestCase):\n324\t    def test_snapshot_next_tasks_and_evidence_marks_correlate_after_a_superstep(self) -> None:\n325\t        invocation = self.fresh_invocation()\n326\t        graph = self.linear_graph()\n327\t        result = graph.invoke({\"seen\": []}, config=invocation.config)\n328\t        self.assertEqual(result[\"seen\"], [\"D05\", \"D13\"])\n329\t\n330\t        view = P.ReadOnlyCheckpointView(graph, self.saver)\n331\t        readout = P.extract_prior_episode(view, invocation.thread_id)\n332\t        self.assertEqual(readout.next, (), \"a completed episode still has a task frontier\")\n333\t        self.assertEqual(readout.tasks, ())\n334\t        self.assertEqual(readout.pending_writes, ())\n335\t        self.assertGreater(readout.history_length, 1)\n336\t        self.assertIsNotNone(readout.checkpoint_id)\n337\t        self.assertEqual(readout.state_digest, P.state_digest({\"seen\": [\"D05\", \"D13\"]}))\n338\t\n339\t        store = EvidenceStore(self.output_root)\n340\t        store.append(\n341\t            \"activations\",\n342\t            {\n343\t                \"run_id\": invocation.run_id,\n344\t                \"episode_id\": invocation.episode_id,\n345\t                \"activation_id\": \"act-1\",\n346\t                \"node_id\": \"D13\",\n347\t                \"phase\": \"ACT\",\n348\t            },\n349\t        )\n350\t        store.append(\n351\t            \"executions\",\n352\t            {\n353\t                \"run_id\": invocation.run_id,\n354\t                \"episode_id\": invocation.episode_id,\n355\t                \"activation_id\": \"act-1\",\n356\t                \"node_id\": \"D13\",\n357\t                \"status\": \"OK\",\n358\t            },\n359\t        )\n360\t        record = P.record_checkpoint_correlation(\n361\t            store,\n362\t            run_id=invocation.run_id,\n363\t            episode_id=invocation.episode_id,\n364\t            node_id=\"D13\",\n365\t            activation_id=\"act-1\",\n366\t            readout=readout,\n367\t        )\n368\t        payload = record.payload\n369\t        self.assertEqual(payload[\"checkpoint_id\"], readout.checkpoint_id)\n370\t        self.assertEqual(payload[\"checkpoint_ns\"], \"\")\n371\t        self.assertEqual(payload[\"state_digest\"], readout.state_digest)\n372\t        self.assertEqual(payload[\"thread_id\"], invocation.thread_id)\n373\t        self.assertEqual(payload[\"evidence_ordinal\"], 1)\n374\t        self.assertEqual(payload[\"evidence_high_water\"][\"activations\"], 1)\n375\t        self.assertEqual(payload[\"evidence_high_water\"][\"executions\"], 1)\n376\t        self.assertTrue(store.audit_all()[\"checkpoints\"].passed)\n377\t\n378\t    def test_a_correlation_record_is_hash_chained_and_tamper_evident(self) -> None:\n379\t        invocation = self.fresh_invocation()\n380\t        graph = self.linear_graph()\n381\t        graph.invoke({\"seen\": []}, config=invocation.config)\n382\t        view = P.ReadOnlyCheckpointView(graph, self.saver)\n383\t        readout = P.extract_prior_episode(view, invocation.thread_id)\n384\t        store = EvidenceStore(self.output_root)\n385\t        P.record_checkpoint_correlation(\n386\t            store,\n387\t            run_id=invocation.run_id,\n388\t            episode_id=invocation.episode_id,\n389\t            node_id=\"D13\",\n390\t            activation_id=\"act-1\",\n391\t            readout=readout,\n392\t        )\n393\t        log = store.log(\"checkpoints\")\n394\t        self.assertTrue(log.audit().passed)\n395\t        tampered = log.path.read_text(encoding=\"utf-8\").replace(readout.state_digest, \"0\" * 64)\n396\t        log.path.write_text(tampered, encoding=\"utf-8\")\n397\t        self.assertFalse(log.audit().passed)\n398\t\n399\t\n400\t# --------------------------------------------------------------------------\n401\t# TEST 3 — crash matrix around checkpoint/admission boundaries\n402\t# --------------------------------------------------------------------------\n403\t\n404\t\n405\tclass TestCrashMatrix(unittest.TestCase):\n406\t    BOUNDARIES = (\"before_admit\", \"after_admit\", \"after_checkpoint\")\n407\t\n408\t    def test_a_real_sigkill_at_every_boundary_duplicates_no_committed_work(self) -> None:\n409\t        for boundary in self.BOUNDARIES:\n410\t            with self.subTest(boundary=boundary):\n411\t                output_root = Path(tempfile.mkdtemp(prefix=f\"plan26_n21_crash_{boundary}_\"))\n412\t                thread_id = \"run-crash:episode:000001\"\n413\t                child = _run_child(CRASH_CHILD, str(output_root), boundary, thread_id)\n414\t                self.assertEqual(\n415\t                    child.returncode,\n416\t                    -signal.SIGKILL,\n417\t                    f\"child did not die by SIGKILL at {boundary}: {child.stderr[-400:]}\",\n418\t                )\n419\t\n420\t                admissions = P.AdmissionLedger(output_root)\n421\t                before = [\n422\t                    r for r in admissions.records() if r[\"payload\"][\"key\"] == \"unit-a:render:1\"\n423\t                ]\n424\t                self.assertEqual(len(before), 0 if boundary == \"before_admit\" else 1)\n425\t\n426\t                # Retry the same committed work under the same activation key.\n427\t                was_new, digest = admissions.admit(\"unit-a:render:1\", {\"bytes\": \"ACCEPTED\"})\n428\t                self.assertEqual(was_new, boundary == \"before_admit\")\n429\t                after = [\n430\t                    r for r in admissions.records() if r[\"payload\"][\"key\"] == \"unit-a:render:1\"\n431\t                ]\n432\t                self.assertEqual(len(after), 1, \"retry duplicated committed work\")\n433\t                self.assertEqual(after[0][\"payload\"][\"output_hash\"], digest)\n434\t\n435\t                # A second retry is still idempotent, and the lock the dead\n436\t                # process held was released by the kernel.\n437\t                admissions.admit(\"unit-a:render:1\", {\"bytes\": \"ACCEPTED\"})\n438\t                self.assertEqual(\n439\t                    len([r for r in admissions.records() if r[\"payload\"][\"key\"] == \"unit-a:render:1\"]),\n440\t                    1,\n441\t                )\n442\t                P.ExecutionLock(output_root).acquire().release()\n443\t\n444\t    def test_a_differing_replay_under_a_committed_key_is_an_integrity_failure(self) -> None:\n445\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_admit_\"))\n446\t        admissions = P.AdmissionLedger(output_root)\n447\t        admissions.admit(\"unit-a:render:1\", {\"bytes\": \"ACCEPTED\"})\n448\t        with self.assertRaises(P.AdmissionConflict):\n449\t            admissions.admit(\"unit-a:render:1\", {\"bytes\": \"DIFFERENT\"})\n450\t        self.assertEqual(len(admissions.records()), 1)\n451\t\n452\t    def test_completed_sibling_work_replays_its_write_instead_of_re_executing(self) -> None:\n453\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_replay_\"))\n454\t        lock = P.ExecutionLock(output_root).acquire()\n455\t        self.addCleanup(lock.release)\n456\t        saver, conn = P.open_checkpoint_saver(output_root)\n457\t        self.addCleanup(conn.close)\n458\t\n459\t        executions: list[str] = []\n460\t        failures: list[int] = []\n461\t\n462\t        def good(_state):\n463\t            executions.append(\"good\")\n464\t            return {\"ok\": [\"good\"]}\n465\t\n466\t        def bad(_state):\n467\t            if not failures:\n468\t                failures.append(1)\n469\t                raise RuntimeError(\"deliberate superstep failure\")\n470\t            return {\"ok\": [\"bad\"]}\n471\t\n472\t        builder = StateGraph(FanoutState)\n473\t        builder.add_node(\"good\", good)\n474\t        builder.add_node(\"bad\", bad)\n475\t        builder.add_edge(START, \"good\")\n476\t        builder.add_edge(START, \"bad\")\n477\t        builder.add_edge(\"good\", END)\n478\t        builder.add_edge(\"bad\", END)\n479\t        graph = builder.compile(checkpointer=saver, name=P.COMPILED_GRAPH_NAME)\n480\t        config = P.invoke_config(\"run-replay:episode:000001\")\n481\t\n482\t        with self.assertRaises(RuntimeError):\n483\t            graph.invoke({\"ok\": []}, config=config)\n484\t        resumed = graph.invoke(None, config=config)\n485\t        self.assertEqual(resumed[\"ok\"].count(\"good\"), 1, \"committed sibling work ran twice\")\n486\t        self.assertEqual(executions, [\"good\"], \"the completed task re-executed on retry\")\n487\t\n488\t\n489\t# --------------------------------------------------------------------------\n490\t# TEST 4 — fan-out sibling crash: pending writes survive, join stays unsatisfied\n491\t# --------------------------------------------------------------------------\n492\t\n493\t\n494\tclass TestFanoutSiblingCrash(PersistenceTestCase):\n495\t    def test_surviving_pending_write_cannot_satisfy_a_partial_join(self) -> None:\n496\t        builder = StateGraph(FanoutState)\n497\t        builder.add_node(\"good\", lambda state: {\"ok\": [\"good\"]})\n498\t\n499\t        def bad(_state):\n500\t            raise RuntimeError(\"sibling crashed\")\n501\t\n502\t        builder.add_node(\"bad\", bad)\n503\t        builder.add_edge(START, \"good\")\n504\t        builder.add_edge(START, \"bad\")\n505\t        builder.add_edge(\"good\", END)\n506\t        builder.add_edge(\"bad\", END)\n507\t        graph = self.compile_graph(builder)\n508\t        config = P.invoke_config(\"run-fanout:episode:000001\")\n509\t\n510\t        with self.assertRaises(RuntimeError):\n511\t            graph.invoke({\"ok\": []}, config=config)\n512\t\n513\t        checkpoint_tuple = self.saver.get_tuple(config)\n514\t        self.assertIsNotNone(checkpoint_tuple)\n515\t        channels = {write[1] for write in checkpoint_tuple.pending_writes}\n516\t        self.assertIn(\"ok\", channels, \"surviving sibling's pending write was lost\")\n517\t\n518\t        view = P.ReadOnlyCheckpointView(graph, self.saver)\n519\t        readout = P.extract_prior_episode(view, \"run-fanout:episode:000001\")\n520\t        self.assertIn(\"bad\", readout.next, \"crashed sibling left the frontier\")\n521\t        self.assertTrue(\n522\t            any(write[\"channel\"] == \"ok\" for write in readout.pending_writes),\n523\t            \"readout dropped the surviving pending write\",\n524\t        )\n525\t\n526\t        frontier = P.compute_resume_frontier(\n527\t            readout=readout,\n528\t            denominators={\"visual_result\": {\"expected\": [\"good\", \"bad\"], \"completed\": [\"good\"]}},\n529\t        )\n530\t        join = frontier[\"joins\"][\"visual_result\"]\n531\t        self.assertFalse(join[\"satisfied\"], \"a partial fan-out was admitted as a join\")\n532\t        self.assertEqual(join[\"pending\"], [\"bad\"])\n533\t        self.assertEqual(join[\"completed\"], [\"good\"])\n534\t\n535\t    def test_join_is_satisfied_only_when_every_denominator_member_completed(self) -> None:\n536\t        self.assertTrue(\n537\t            P.classify_join_members(expected_keys=[\"a\", \"b\"], completed_keys=[\"b\", \"a\"])[\"satisfied\"]\n538\t        )\n539\t        self.assertFalse(\n540\t            P.classify_join_members(expected_keys=[\"a\", \"b\"], completed_keys=[\"a\"])[\"satisfied\"]\n541\t        )\n542\t        self.assertFalse(\n543\t            P.classify_join_members(expected_keys=[], completed_keys=[])[\"satisfied\"],\n544\t            \"an empty denominator must not count as a satisfied join\",\n545\t        )\n546\t        with self.assertRaises(P.PersistenceError):\n547\t            P.classify_join_members(expected_keys=[\"a\"], completed_keys=[\"a\", \"zz\"])\n548\t\n549\t\n550\t# --------------------------------------------------------------------------\n551\t# TEST 5 — resume refusal on identity/digest/executable/evidence/accepted drift\n552\t# --------------------------------------------------------------------------\n553\t\n554\t\n555\tclass TestResumeRefusal(PersistenceTestCase):\n556\t    BASELINE = {\n557\t        \"frozen_digest\": \"a\" * 64,\n558\t        \"frozen_inputs\": [{\"path\": \"m.yaml\", \"sha256\": \"b\" * 64, \"role\": \"manifest\"}],\n559\t        \"frozen_executable_identities\": [{\"name\": \"codex\", \"sha256\": \"c\" * 64}],\n560\t        \"evidence_chain_hashes\": {\"activations\": \"d\" * 64},\n561\t        \"accepted_receipt_hashes\": {\"U01\": \"e\" * 64},\n562\t        \"accepted_byte_digests\": {\"units/U01/unit.pdf\": \"f\" * 64},\n563\t    }\n564\t\n565\t    DRIFTS = (\n566\t        (\"identity\", \"contract_version\", \"plan26.v2\"),\n567\t        (\"frozen_digest\", \"frozen_digest\", \"0\" * 64),\n568\t        (\"executable\", \"frozen_executable_identities\", [{\"name\": \"codex\", \"sha256\": \"0\" * 64}]),\n569\t        (\"evidence\", \"evidence_chain_hashes\", {\"activations\": \"0\" * 64}),\n570\t        (\"accepted_bytes\", \"accepted_byte_digests\", {\"units/U01/unit.pdf\": \"0\" * 64}),\n571\t        (\"accepted_bytes\", \"accepted_receipt_hashes\", {\"U01\": \"0\" * 64}),\n572\t    )\n573\t\n574\t    def _expected(self) -> dict[str, Any]:\n575\t        return {**IDENTITY_SEED, \"run_id\": \"run-x\", **self.BASELINE}\n576\t\n577\t    def test_every_drift_class_refuses_resume(self) -> None:\n578\t        for drift_class, field, mutated in self.DRIFTS:\n579\t            with self.subTest(drift_class=drift_class, field=field):\n580\t                with self.assertRaises(P.ResumeRefused) as caught:\n581\t                    P.validate_resume_inputs(\n582\t                        expected=self._expected(), observed={field: mutated}\n583\t                    )\n584\t                self.assertEqual(caught.exception.drift_class, drift_class)\n585\t                self.assertEqual(caught.exception.field, field)\n586\t\n587\t    def test_matching_inputs_are_admitted(self) -> None:\n588\t        expected = self._expected()\n589\t        observed = {field: expected[field] for _, field, _ in self.DRIFTS}\n590\t        P.validate_resume_inputs(expected=expected, observed=observed)\n591\t\n592\t    def test_an_unclassified_input_is_refused_rather_than_ignored(self) -> None:\n593\t        with self.assertRaises(P.ResumeRefused) as caught:\n594\t            P.validate_resume_inputs(expected=self._expected(), observed={\"surprise\": 1})\n595\t        self.assertEqual(caught.exception.drift_class, \"identity\")\n596\t\n597\t    def test_a_missing_baseline_key_is_refused(self) -> None:\n598\t        with self.assertRaises(P.ResumeRefused) as caught:\n599\t            P.validate_resume_inputs(expected={}, observed={\"frozen_digest\": \"a\" * 64})\n600\t        self.assertEqual(caught.exception.drift_class, \"frozen_digest\")\n601\t\n602\t    def test_non_resumable_terminals_are_rejected(self) -> None:\n603\t        for name in sorted(P.NON_RESUMABLE_TERMINALS):\n604\t            with self.subTest(terminal=name):\n605\t                with self.assertRaises(P.ResumeRefused) as caught:\n606\t                    P._validate_terminal_legality({\"terminal\": name})\n607\t                self.assertEqual(caught.exception.drift_class, \"terminal_legality\")\n608\t        for name in sorted(P.RESUMABLE_TERMINALS):\n609\t            with self.subTest(terminal=name):\n610\t                self.assertEqual(P._validate_terminal_legality({\"terminal\": name}), name)\n611\t\n612\t    def test_refused_resume_performs_no_product_work(self) -> None:\n613\t        invocation = self.fresh_invocation()\n614\t        self.linear_graph().invoke({\"seen\": []}, config=invocation.config)\n615\t        P.EpisodeLeaseLedger(self.output_root).close_episode(\n616\t            episode_ordinal=invocation.episode_ordinal,\n617\t            terminal={\"terminal\": \"INTERRUPTED\", \"reason\": \"test\"},\n618\t        )\n619\t        product = self.output_root / \"units\" / \"U01\"\n620\t        product.mkdir(parents=True)\n621\t        (product / \"unit.pdf\").write_bytes(b\"ACCEPTED BYTES\")\n622\t        before_product = _tree_snapshot(self.output_root)\n623\t        before_ledger = P.EpisodeLeaseLedger(self.output_root).records()\n624\t\n625\t        with self.assertRaises(P.ResumeRefused) as caught:\n626\t            P.prepare_episode_invocation(\n627\t                output_root=self.output_root,\n628\t                lock=self.lock,\n629\t                resume=True,\n630\t                resume_baseline={\"frozen_digest\": \"a\" * 64},\n631\t                recomputed={\"frozen_digest\": \"0\" * 64},\n632\t            )\n633\t        self.assertEqual(caught.exception.drift_class, \"frozen_digest\")\n634\t        self.assertEqual(_tree_snapshot(self.output_root), before_product)\n635\t        self.assertEqual(P.EpisodeLeaseLedger(self.output_root).records(), before_ledger)\n636\t\n637\t    def test_run_id_disagreement_with_the_envelope_refuses(self) -> None:\n638\t        invocation = self.fresh_invocation()\n639\t        self.assertEqual(invocation.bootstrap_kind, P.BOOTSTRAP_FRESH)\n640\t        P.EpisodeLeaseLedger(self.output_root).close_episode(\n641\t            episode_ordinal=1, terminal={\"terminal\": \"INTERRUPTED\"}\n642\t        )\n643\t        with self.assertRaises(P.ResumeRefused) as caught:\n644\t            P.prepare_episode_invocation(\n645\t                output_root=self.output_root,\n646\t                lock=self.lock,\n647\t                resume=True,\n648\t                identity_seed={**IDENTITY_SEED, \"output_root\": \"/somewhere/else\"},\n649\t            )\n650\t        self.assertEqual(caught.exception.drift_class, \"identity\")\n651\t        self.assertEqual(caught.exception.field, \"run_id\")\n652\t\n653\t    def test_a_fresh_invocation_over_a_prior_identity_is_refused(self) -> None:\n654\t        self.fresh_invocation()\n655\t        with self.assertRaises(P.ResumeRefused):\n656\t            self.fresh_invocation()\n657\t\n658\t    def test_identity_envelope_bytes_are_immutable(self) -> None:\n659\t        invocation = self.fresh_invocation()\n660\t        with self.assertRaises(P.ResumeRefused):\n661\t            P.write_identity_envelope(self.output_root, {\"run_id\": \"run-other\"})\n662\t        self.assertEqual(\n663\t            P.read_identity_envelope(self.output_root)[\"run_id\"], invocation.run_id\n664\t        )\n665\t\n666\t\n667\t# --------------------------------------------------------------------------\n668\t# TEST 6 — graceful interrupt: one terminal candidate, deterministic frontier\n669\t# --------------------------------------------------------------------------\n670\t\n671\t\n672\tclass TestGracefulInterrupt(PersistenceTestCase):\n673\t    def test_sigint_sets_the_token_and_blocks_new_transmission(self) -> None:\n674\t        token = P.InterruptToken(self.output_root).install()\n675\t        self.addCleanup(token.close)\n676\t        self.assertFalse(token.is_set())\n677\t        token.guard_transmission(\"M03 dispatch\")  # allowed before the signal\n678\t\n679\t        signal.raise_signal(signal.SIGINT)\n680\t\n681\t        self.assertTrue(token.is_set())\n682\t        self.assertEqual(token.reason, \"SIGINT\")\n683\t        with self.assertRaises(P.InterruptionRequested):\n684\t            token.guard_transmission(\"M03 dispatch\")\n685\t        self.assertIn(b\"INTERRUPTED\", token.marker_path.read_bytes())\n686\t\n687\t    def test_sigterm_is_handled_the_same_way(self) -> None:\n688\t        token = P.InterruptToken(self.output_root).install()\n689\t        self.addCleanup(token.close)\n690\t        signal.raise_signal(signal.SIGTERM)\n691\t        self.assertTrue(token.is_set())\n692\t        self.assertEqual(token.reason, \"SIGTERM\")\n693\t\n694\t    def test_interrupt_writes_one_terminal_and_a_deterministic_safe_frontier(self) -> None:\n695\t        invocation = self.fresh_invocation()\n696\t        builder = StateGraph(LinearState)\n697\t        builder.add_node(\"D05\", lambda state: {\"seen\": [\"D05\"]})\n698\t\n699\t        def interrupted(_state):\n700\t            raise RuntimeError(\"aborted at the atomic boundary\")\n701\t\n702\t        builder.add_node(\"D13\", interrupted)\n703\t        builder.add_edge(START, \"D05\")\n704\t        builder.add_edge(\"D05\", \"D13\")\n705\t        builder.add_edge(\"D13\", END)\n706\t        graph = self.compile_graph(builder)\n707\t        with self.assertRaises(RuntimeError):\n708\t            graph.invoke({\"seen\": []}, config=invocation.config)\n709\t\n710\t        view = P.ReadOnlyCheckpointView(graph, self.saver)\n711\t        readout = P.extract_prior_episode(view, invocation.thread_id)\n712\t        first = P.compute_resume_frontier(readout=readout, reason=\"interrupt\")\n713\t        second = P.compute_resume_frontier(readout=readout, reason=\"interrupt\")\n714\t        self.assertEqual(first[\"frontier_digest\"], second[\"frontier_digest\"])\n715\t        self.assertEqual(first[\"destinations\"], [\"D13\"])\n716\t        self.assertEqual(first, second)\n717\t\n718\t        candidate = P.build_interrupt_terminal_candidate(\n719\t            run_id=invocation.run_id,\n720\t            episode_id=invocation.episode_id,\n721\t            frontier=first,\n722\t            classification=\"graceful_signal\",\n723\t            heads={},\n724\t            high_water_marks={\"checkpoint_records\": 1, \"evidence_records\": 0},\n725\t        )\n726\t        self.assertEqual(candidate[\"kind\"], \"INTERRUPTED\")\n727\t        self.assertEqual(candidate[\"resume_frontier\"], first)\n728\t        self.assertEqual(candidate[\"resume_frontier_digest\"], first[\"frontier_digest\"])\n729\t\n730\t        ledger = P.EpisodeLeaseLedger(self.output_root)\n731\t        ledger.close_episode(episode_ordinal=invocation.episode_ordinal, terminal=candidate)\n732\t        closed = [\n733\t            record\n734\t            for record in ledger.records()\n735\t            if record[\"payload\"][\"state\"] == \"CLOSED\"\n736\t            and record[\"payload\"][\"episode_ordinal\"] == invocation.episode_ordinal\n737\t        ]\n738\t        self.assertEqual(len(closed), 1, \"the episode wrote more than one terminal\")\n739\t        with self.assertRaises(P.EpisodeLedgerError):\n740\t            ledger.close_episode(episode_ordinal=invocation.episode_ordinal, terminal=candidate)\n741\t\n742\t    def test_the_candidate_is_accepted_by_the_real_d98_validator(self) -> None:\n743\t        \"\"\"The cross-node contract: D98 must accept what this node builds.\n744\t\n745\t        D98 re-derives the INTERRUPTED precondition itself and downgrades any\n746\t        candidate it cannot confirm to SYSTEM_FAILURE, so an interoperable shape\n747\t        is the only thing that makes a graceful interrupt actually interrupt.\n748\t        \"\"\"\n749\t        invocation = self.fresh_invocation()\n750\t        readout = P.PriorEpisodeReadout(\n751\t            thread_id=invocation.thread_id, checkpoint_id=\"ckpt-9\",\n752\t            parent_checkpoint_id=None, values={}, next=(\"D13\",), tasks=(),\n753\t            pending_writes=(), state_digest=\"a\" * 64, history_length=2, terminal=None,\n754\t        )\n755\t        frontier = P.compute_resume_frontier(readout=readout, reason=\"interrupt\")\n756\t        heads = {\"units/U01/content\": \"c\" * 64}\n757\t\n758\t        candidate = P.build_interrupt_terminal_candidate(\n759\t            run_id=invocation.run_id,\n760\t            episode_id=invocation.episode_id,\n761\t            frontier=frontier,\n762\t            classification=\"graceful_signal\",\n763\t            heads=heads,\n764\t            high_water_marks={\n765\t                \"checkpoint_records\": 1,\n766\t                \"evidence_records\": 2,\n767\t                \"last_checkpoint_id\": \"ckpt-9\",\n768\t            },\n769\t        )\n770\t\n771\t        state = {\n772\t            \"terminal_candidate\": candidate,\n773\t            \"terminal\": None,\n774\t            \"terminal_history\": [],\n775\t            \"episode_id\": invocation.episode_id,\n776\t            \"run_id\": invocation.run_id,\n777\t            \"mode\": \"one\",\n778\t            \"requested_unit_id\": \"U01\",\n779\t            \"effective_run\": {\"ordered_unit_ids\": [\"U01\"], \"target_closure\": [\"U01\"]},\n780\t            \"accepted_unit_receipts\": {},\n781\t            \"final_release_audits\": [],\n782\t            \"workbook_head\": {},\n783\t            \"artifact_heads\": {\n784\t                \"units/U01/content\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"c\" * 64}\n785\t            },\n786\t            \"attempt_counters\": {},\n787\t            \"failure_fingerprints\": [],\n788\t            \"checkpoint_metadata\": [{\"checkpoint_id\": \"ckpt-9\"}],\n789\t            \"evidence_index_entries\": [{\"key\": \"e1\"}, {\"key\": \"e2\"}],\n790\t            \"pending_failure\": None,\n791\t            \"resume_frontier\": None,\n792\t            \"output_root\": str(self.output_root),\n793\t        }\n794\t        projection = project_for_node(\"D98_WRITE_TERMINAL\", state)\n795\t\n796\t        validation = D98.validate_terminal_candidate(candidate, projection)\n797\t        self.assertTrue(validation.accepted, f\"D98 rejected the candidate: {validation.rejections}\")\n798\t        self.assertEqual(validation.kind, \"INTERRUPTED\")\n799\t\n800\t        record = D98.write_terminal(projection)[\"terminal\"]\n801\t        self.assertEqual(record[\"kind\"], \"INTERRUPTED\")\n802\t        self.assertEqual(record[\"exit_code\"], 10)\n803\t        self.assertTrue(record[\"resumable\"])\n804\t        self.assertEqual(record[\"evidence\"][\"resume_frontier\"], frontier)\n805\t\n806\t        # A stale head is what D98 exists to catch; the shape alone must not pass.\n807\t        stale = dict(candidate, heads={\"units/U01/content\": \"d\" * 64})\n808\t        self.assertFalse(D98.validate_terminal_candidate(stale, projection).accepted)\n809\t\n810\t    def test_the_classification_vocabulary_matches_d98s_authority(self) -> None:\n811\t        self.assertEqual(P.INTERRUPT_CLASSIFICATIONS, D98._INTERRUPT_CLASSIFICATIONS)\n812\t        with self.assertRaises(P.PersistenceError):\n813\t            P.build_interrupt_terminal_candidate(\n814\t                run_id=\"run-1\", episode_id=\"ep-1\",\n815\t                frontier={\"frontier_digest\": \"0\" * 64, \"destinations\": []},\n816\t                classification=\"SIGINT\", heads={}, high_water_marks={},\n817\t            )\n818\t\n819\t    def test_frontier_digest_changes_when_the_frontier_changes(self) -> None:\n820\t        base = P.PriorEpisodeReadout(\n821\t            thread_id=\"t\", checkpoint_id=\"c\", parent_checkpoint_id=None, values={},\n822\t            next=(\"D13\",), tasks=(), pending_writes=(), state_digest=\"0\" * 64,\n823\t            history_length=1, terminal=None,\n824\t        )\n825\t        other = dataclasses_replace(base, next=(\"D15\",))\n826\t        self.assertNotEqual(\n827\t            P.compute_resume_frontier(readout=base)[\"frontier_digest\"],\n828\t            P.compute_resume_frontier(readout=other)[\"frontier_digest\"],\n829\t        )\n830\t\n831\t\n832\tdef dataclasses_replace(instance: P.PriorEpisodeReadout, **changes: Any) -> P.PriorEpisodeReadout:\n833\t    import dataclasses\n834\t\n835\t    return dataclasses.replace(instance, **changes)\n836\t\n837\t\n838\t# --------------------------------------------------------------------------\n839\t# TEST 7 — orphan recovery performs zero product side effects\n840\t# --------------------------------------------------------------------------\n841\t\n842\t\n843\tclass TestOrphanRecovery(unittest.TestCase):\n844\t    def test_recovery_after_sigkill_uses_a_new_thread_and_touches_no_product(self) -> None:\n845\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_orphan_\")).resolve()\n846\t        product = output_root / \"units\" / \"U01\"\n847\t        product.mkdir(parents=True)\n848\t        (product / \"unit.pdf\").write_bytes(b\"ACCEPTED BYTES\")\n849\t        (product / \"receipt.json\").write_text(json.dumps({\"accepted\": True}), encoding=\"utf-8\")\n850\t\n851\t        child = _run_child(ORPHAN_CHILD, str(output_root))\n852\t        self.assertEqual(\n853\t            child.returncode, -signal.SIGKILL, f\"orphan child survived: {child.stderr[-400:]}\"\n854\t        )\n855\t        orphan_thread = child.stdout.strip()\n856\t        self.assertTrue(orphan_thread.endswith(\":episode:000001\"), orphan_thread)\n857\t\n858\t        ledger = P.EpisodeLeaseLedger(output_root)\n859\t        self.assertIsNotNone(ledger.open_lease(), \"unclean exit did not leave an open lease\")\n860\t\n861\t        before = _tree_snapshot(output_root)\n862\t        lock = P.ExecutionLock(output_root).acquire()\n863\t        self.addCleanup(lock.release)\n864\t        saver, conn = P.open_checkpoint_saver(output_root)\n865\t        self.addCleanup(conn.close)\n866\t        builder = StateGraph(LinearState)\n867\t        builder.add_node(\"D05\", lambda state: {\"seen\": [\"D05\"]})\n868\t        builder.add_edge(START, \"D05\")\n869\t        builder.add_edge(\"D05\", END)\n870\t        graph = builder.compile(checkpointer=saver, name=P.COMPILED_GRAPH_NAME)\n871\t        view = P.ReadOnlyCheckpointView(graph, saver)\n872\t\n873\t        invocation = P.prepare_episode_invocation(\n874\t            output_root=output_root, lock=lock, resume=True, read_view=view\n875\t        )\n876\t        self.assertEqual(invocation.bootstrap_kind, P.BOOTSTRAP_RECOVER_ORPHAN)\n877\t        self.assertEqual(invocation.prior_thread_id, orphan_thread)\n878\t        self.assertNotEqual(invocation.thread_id, orphan_thread)\n879\t        self.assertEqual(invocation.thread_id, f\"{invocation.run_id}:recover:1\")\n880\t        self.assertEqual(invocation.config[\"configurable\"][\"checkpoint_ns\"], \"\")\n881\t        self.assertIsNotNone(invocation.resume_from)\n882\t        self.assertEqual(invocation.resume_from[\"thread_id\"], orphan_thread)\n883\t\n884\t        self.assertEqual(\n885\t            _tree_snapshot(output_root), before, \"recovery mutated product bytes\"\n886\t        )\n887\t\n888\t    def test_recovery_services_raise_on_any_touch(self) -> None:\n889\t        services = P.build_recovery_services()\n890\t        self.assertEqual(\n891\t            sorted(services), [\"renderer\", \"source_retriever\", \"transport_registry\"]\n892\t        )\n893\t        for name, service in services.items():\n894\t            with self.subTest(service=name):\n895\t                with self.assertRaises(P.RecoveryServiceForbidden):\n896\t                    service.send({\"job\": \"M01\"})\n897\t                with self.assertRaises(P.RecoveryServiceForbidden):\n898\t                    service()\n899\t                with self.assertRaises(P.RecoveryServiceForbidden):\n900\t                    service.anything  # noqa: B018 - any attribute touch must raise\n901\t\n902\t    def test_a_recovery_runtime_context_carries_only_forbidden_product_services(self) -> None:\n903\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_ctx_\")).resolve()\n904\t        services = P.build_recovery_services()\n905\t        context = RuntimeContext(\n906\t            engine_root=Path(\"/engine\"),\n907\t            output_root=output_root,\n908\t            path_guard=object(),\n909\t            evidence_service=EvidenceStore(output_root),\n910\t            transport_registry=services[\"transport_registry\"],\n911\t            source_retriever=services[\"source_retriever\"],\n912\t            signal_token=P.InterruptToken(),\n913\t            clock=lambda: 0,\n914\t        )\n915\t        with self.assertRaises(P.RecoveryServiceForbidden):\n916\t            context.transport_registry.dispatch(\"M01\")\n917\t        with self.assertRaises(P.RecoveryServiceForbidden):\n918\t            context.source_retriever.fetch(\"https://example.invalid\")\n919\t        # The evidence writer stays real: D96/D98 must still record the closure.\n920\t        context.evidence_service.append(\n921\t            \"events\",\n922\t            {\"run_id\": \"run-x\", \"episode_id\": \"run-x:recover:1\", \"kind\": \"RECOVER\", \"node_id\": \"D96\"},\n923\t        )\n924\t        self.assertEqual(context.evidence_service.high_water_marks()[\"events\"], 1)\n925\t\n926\t    def test_the_read_only_view_cannot_continue_a_prior_thread(self) -> None:\n927\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_ro_\")).resolve()\n928\t        lock = P.ExecutionLock(output_root).acquire()\n929\t        self.addCleanup(lock.release)\n930\t        saver, conn = P.open_checkpoint_saver(output_root)\n931\t        self.addCleanup(conn.close)\n932\t        builder = StateGraph(LinearState)\n933\t        builder.add_node(\"D05\", lambda state: {\"seen\": [\"D05\"]})\n934\t        builder.add_edge(START, \"D05\")\n935\t        builder.add_edge(\"D05\", END)\n936\t        graph = builder.compile(checkpointer=saver, name=P.COMPILED_GRAPH_NAME)\n937\t        view = P.ReadOnlyCheckpointView(graph, saver)\n938\t        for forbidden in (\"invoke\", \"stream\", \"update_state\", \"ainvoke\", \"batch\"):\n939\t            with self.subTest(method=forbidden):\n940\t                self.assertFalse(hasattr(view, forbidden))\n941\t        with self.assertRaises(AttributeError):\n942\t            view.invoke(None, config=P.invoke_config(\"t\"))\n943\t\n944\t    def test_persistence_module_never_calls_invoke_or_update_state(self) -> None:\n945\t        tree = ast.parse(PERSISTENCE_SOURCE.read_text(encoding=\"utf-8\"))\n946\t        called = {\n947\t            node.func.attr\n948\t            for node in ast.walk(tree)\n949\t            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)\n950\t        }\n951\t        for forbidden in (\"invoke\", \"ainvoke\", \"stream\", \"astream\", \"update_state\", \"batch\"):\n952\t            with self.subTest(method=forbidden):\n953\t                self.assertNotIn(\n954\t                    forbidden, called, f\"persistence.py calls .{forbidden}() on something\"\n955\t                )\n956\t\n957\t    def test_persistence_module_imports_no_product_or_model_module(self) -> None:\n958\t        tree = ast.parse(PERSISTENCE_SOURCE.read_text(encoding=\"utf-8\"))\n959\t        imported: set[str] = set()\n960\t        for node in ast.walk(tree):\n961\t            if isinstance(node, ast.Import):\n962\t                imported.update(alias.name for alias in node.names)\n963\t            elif isinstance(node, ast.ImportFrom) and node.module:\n964\t                imported.add(node.module)\n965\t        forbidden_prefixes = (\n966\t            \"runtime.langgraph_factory.transport\",\n967\t            \"runtime.langgraph_factory.egress\",\n968\t            \"runtime.langgraph_factory.model_nodes\",\n969\t            \"runtime.langgraph_factory.nodes\",\n970\t            \"runtime.langgraph_factory.workbook\",\n971\t            \"langchain\",\n972\t            \"openai\",\n973\t            \"google.generativeai\",\n974\t            \"httpx\",\n975\t            \"requests\",\n976\t            \"urllib\",\n977\t            \"socket\",\n978\t        )\n979\t        offenders = sorted(\n980\t            name\n981\t            for name in imported\n982\t            if any(name == prefix or name.startswith(prefix + \".\") for prefix in forbidden_prefixes)\n983\t        )\n984\t        self.assertEqual(offenders, [], \"persistence.py reached a product or transport module\")\n985\t\n986\t\n987\t# --------------------------------------------------------------------------\n988\t# TEST 8 — an incomplete model activation routes to D91, never back to a model\n989\t# --------------------------------------------------------------------------\n990\t\n991\t\n992\tclass TestModelFrontierRouting(PersistenceTestCase):\n993\t    def test_an_aborted_model_node_frontier_becomes_d91(self) -> None:\n994\t        invocation = self.fresh_invocation()\n995\t        builder = StateGraph(LinearState)\n996\t        builder.add_node(\"D03\", lambda state: {\"seen\": [\"D03\"]})\n997\t\n998\t        def aborted_model(_state):\n999\t            raise RuntimeError(\"model subprocess aborted by the timeout protocol\")\n1000\t\n1001\t        builder.add_node(\"M03\", aborted_model)\n1002\t        builder.add_edge(START, \"D03\")\n1003\t        builder.add_edge(\"D03\", \"M03\")\n1004\t        builder.add_edge(\"M03\", END)\n1005\t        graph = self.compile_graph(builder)\n1006\t        with self.assertRaises(RuntimeError):\n1007\t            graph.invoke({\"seen\": []}, config=invocation.config)\n1008\t\n1009\t        view = P.ReadOnlyCheckpointView(graph, self.saver)\n1010\t        readout = P.extract_prior_episode(view, invocation.thread_id)\n1011\t        self.assertEqual(readout.next, (\"M03\",), \"the real frontier is not the model node\")\n1012\t\n1013\t        frontier = P.compute_resume_frontier(readout=readout, reason=\"resume\")\n1014\t        self.assertEqual(frontier[\"destinations\"], [\"D91\"])\n1015\t        self.assertEqual(\n1016\t            frontier[\"reclassified_model_destinations\"], [{\"from\": \"M03\", \"to\": \"D91\"}]\n1017\t        )\n1018\t        self.assertFalse(\n1019\t            set(frontier[\"destinations\"]) & P.MODEL_NODE_IDS,\n1020\t            \"a model node survived as a resume destination\",\n1021\t        )\n1022\t\n1023\t    def test_every_model_node_id_is_reclassified(self) -> None:\n1024\t        for model_id in sorted(P.MODEL_NODE_IDS):\n1025\t            with self.subTest(model=model_id):\n1026\t                readout = P.PriorEpisodeReadout(\n1027\t                    thread_id=\"t\", checkpoint_id=\"c\", parent_checkpoint_id=None, values={},\n1028\t                    next=(model_id,), tasks=({\"id\": \"1\", \"name\": model_id, \"error\": None,\n1029\t                                              \"interrupts\": 0},),\n1030\t                    pending_writes=(), state_digest=\"0\" * 64, history_length=1, terminal=None,\n1031\t                )\n1032\t                frontier = P.compute_resume_frontier(readout=readout)\n1033\t                self.assertEqual(frontier[\"destinations\"], [\"D91\"])\n1034\t\n1035\t    def test_deterministic_destinations_are_preserved_unchanged(self) -> None:\n1036\t        readout = P.PriorEpisodeReadout(\n1037\t            thread_id=\"t\", checkpoint_id=\"c\", parent_checkpoint_id=None, values={},\n1038\t            next=(\"D07\", \"D13\"), tasks=(), pending_writes=(), state_digest=\"0\" * 64,\n1039\t            history_length=1, terminal=None,\n1040\t        )\n1041\t        self.assertEqual(P.compute_resume_frontier(readout=readout)[\"destinations\"], [\"D07\", \"D13\"])\n1042\t\n1043\t\n1044\t# --------------------------------------------------------------------------\n1045\t# TEST 9 — one lock winner; the loser mutates nothing\n1046\t# --------------------------------------------------------------------------\n1047\t\n1048\t\n1049\tclass TestExecutionLockRace(unittest.TestCase):\n1050\t    def test_two_real_processes_race_and_the_loser_mutates_nothing(self) -> None:\n1051\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_lock_\")).resolve()\n1052\t        winner = P.ExecutionLock(output_root).acquire()\n1053\t        self.addCleanup(winner.release)\n1054\t        saver, conn = P.open_checkpoint_saver(output_root)\n1055\t        self.addCleanup(conn.close)\n1056\t        (output_root / \"units\").mkdir()\n1057\t        (output_root / \"units\" / \"unit.pdf\").write_bytes(b\"ACCEPTED BYTES\")\n1058\t\n1059\t        before = _tree_snapshot(output_root, skip_control=False)\n1060\t        loser = _run_child(LOCK_CHILD, str(output_root))\n1061\t        after = _tree_snapshot(output_root, skip_control=False)\n1062\t\n1063\t        self.assertEqual(loser.returncode, P.LOCK_LOSER_EXIT_CODE, loser.stderr[-400:])\n1064\t        self.assertIn(\"LOSER\", loser.stderr)\n1065\t        self.assertNotIn(\"WINNER\", loser.stdout)\n1066\t        self.assertEqual(before, after, \"the losing process mutated the output root\")\n1067\t        self.assertEqual(sorted(before), sorted(after))\n1068\t\n1069\t    def test_the_lock_is_reacquirable_once_the_winner_releases(self) -> None:\n1070\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_lock2_\")).resolve()\n1071\t        winner = P.ExecutionLock(output_root).acquire()\n1072\t        self.assertEqual(_run_child(LOCK_CHILD, str(output_root)).returncode, P.LOCK_LOSER_EXIT_CODE)\n1073\t        winner.release()\n1074\t        self.assertEqual(_run_child(LOCK_CHILD, str(output_root)).returncode, 0)\n1075\t\n1076\t    def test_a_second_in_process_acquisition_is_also_refused(self) -> None:\n1077\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_lock3_\")).resolve()\n1078\t        first = P.ExecutionLock(output_root).acquire()\n1079\t        self.addCleanup(first.release)\n1080\t        with self.assertRaises(P.ExecutionLockUnavailable):\n1081\t            P.ExecutionLock(output_root).acquire()\n1082\t\n1083\t\n1084\t# --------------------------------------------------------------------------\n1085\t# TEST 10 — either layer's corruption blocks recovery, with no self-repair\n1086\t# --------------------------------------------------------------------------\n1087\t\n1088\t\n1089\tclass TestCorruptionBlocksRecovery(unittest.TestCase):\n1090\t    def _populated_root(self) -> tuple[Path, P.ExecutionLock, sqlite3.Connection]:\n1091\t        output_root = Path(tempfile.mkdtemp(prefix=\"plan26_n21_corrupt_\")).resolve()\n1092\t        lock = P.ExecutionLock(output_root).acquire()\n1093\t        self.addCleanup(lock.release)\n1094\t        saver, conn = P.open_checkpoint_saver(output_root)\n1095\t        invocation = P.prepare_episode_invocation(\n1096\t            output_root=output_root,\n1097\t            lock=lock,\n1098\t            identity_seed={**IDENTITY_SEED, \"output_root\": str(output_root)},\n1099\t        )\n1100\t        builder = StateGraph(LinearState)\n1101\t        builder.add_node(\"D05\", lambda state: {\"seen\": [\"D05\"]})\n1102\t        builder.add_edge(START, \"D05\")\n1103\t        builder.add_edge(\"D05\", END)\n1104\t        graph = builder.compile(checkpointer=saver, name=P.COMPILED_GRAPH_NAME)\n1105\t        graph.invoke({\"seen\": []}, config=invocation.config)\n1106\t        P.AdmissionLedger(output_root).admit(\"unit-a:render:1\", {\"bytes\": \"ACCEPTED\"})\n1107\t        P.EpisodeLeaseLedger(output_root).close_episode(\n1108\t            episode_ordinal=invocation.episode_ordinal, terminal={\"terminal\": \"INTERRUPTED\"}\n1109\t        )\n1110\t        P.flush_checkpoint_durability(conn, output_root)\n1111\t        conn.execute(\"PRAGMA wal_checkpoint(TRUNCATE)\")\n1112\t        conn.commit()\n1113\t        conn.close()\n1114\t        return output_root, lock, conn\n1115\t\n1116\t    def test_a_healthy_root_verifies_on_both_layers(self) -> None:\n1117\t        output_root, _lock, _conn = self._populated_root()\n1118\t        report = P.verify_persistence_integrity(output_root, EvidenceStore(output_root))\n1119\t        self.assertEqual(report[\"checkpoint\"][\"integrity_check\"], \"ok\")\n1120\t        self.assertEqual(report[\"episode_ledger\"][\"status\"], \"PASS\")\n1121\t        self.assertEqual(report[\"admission_ledger\"][\"status\"], \"PASS\")\n1122\t\n1123\t    def test_corrupt_sqlite_blocks_recovery_and_is_not_repaired(self) -> None:\n1124\t        output_root, lock, _conn = self._populated_root()\n1125\t        db_path = P.checkpoint_db_path(output_root)\n1126\t        raw = bytearray(db_path.read_bytes())\n1127\t        page_size = int.from_bytes(raw[16:18], \"big\")\n1128\t        self.assertGreater(len(raw), page_size * 2, \"database is too small to corrupt a data page\")\n1129\t        raw[page_size : page_size + 512] = b\"\\xff\" * 512\n1130\t        db_path.write_bytes(bytes(raw))\n1131\t        corrupted_digest = hashlib.sha256(db_path.read_bytes()).hexdigest()\n1132\t\n1133\t        # The append-only layer is untouched and still verifies on its own.\n1134\t        self.assertEqual(P.EpisodeLeaseLedger(output_root).audit()[\"status\"], \"PASS\")\n1135\t        self.assertEqual(P.AdmissionLedger(output_root).audit()[\"status\"], \"PASS\")\n1136\t\n1137\t        with self.assertRaises(P.CheckpointCorrupt):\n1138\t            P.verify_checkpoint_integrity(output_root)\n1139\t        with self.assertRaises(P.CheckpointCorrupt):\n1140\t            P.verify_persistence_integrity(output_root, EvidenceStore(output_root))\n1141\t        with self.assertRaises(P.CheckpointCorrupt):\n1142\t            P.prepare_episode_invocation(output_root=output_root, lock=lock, resume=True)\n1143\t        self.assertEqual(\n1144\t            hashlib.sha256(db_path.read_bytes()).hexdigest(),\n1145\t            corrupted_digest,\n1146\t            \"a failed integrity check repaired the database\",\n1147\t        )\n1148\t\n1149\t    def test_corrupt_append_log_blocks_recovery_and_is_not_repaired(self) -> None:\n1150\t        output_root, lock, _conn = self._populated_root()\n1151\t        ledger_path = P.EpisodeLeaseLedger(output_root).path\n1152\t        text = ledger_path.read_text(encoding=\"utf-8\")\n1153\t        ledger_path.write_text(text.replace('\"OPEN\"', '\"OPENX\"', 1), encoding=\"utf-8\")\n1154\t        corrupted_digest = hashlib.sha256(ledger_path.read_bytes()).hexdigest()\n1155\t\n1156\t        # The checkpoint layer is untouched and still verifies on its own.\n1157\t        self.assertEqual(P.verify_checkpoint_integrity(output_root)[\"integrity_check\"], \"ok\")\n1158\t\n1159\t        self.assertEqual(P.EpisodeLeaseLedger(output_root).audit()[\"status\"], \"FAIL\")\n1160\t        with self.assertRaises(P.CheckpointCorrupt):\n1161\t            P.verify_persistence_integrity(output_root)\n1162\t        with self.assertRaises(P.CheckpointCorrupt):\n1163\t            P.prepare_episode_invocation(output_root=output_root, lock=lock, resume=True)\n1164\t        self.assertEqual(\n1165\t            hashlib.sha256(ledger_path.read_bytes()).hexdigest(),\n1166\t            corrupted_digest,\n1167\t            \"a failed integrity check rewrote the append log\",\n1168\t        )\n1169\t\n1170\t    def test_a_truncated_append_log_is_detected(self) -> None:\n1171\t        output_root, _lock, _conn = self._populated_root()\n1172\t        ledger_path = P.AdmissionLedger(output_root).path\n1173\t        raw = ledger_path.read_bytes()\n1174\t        ledger_path.write_bytes(raw[:-5])\n1175\t        self.assertEqual(P.AdmissionLedger(output_root).audit()[\"status\"], \"FAIL\")\n1176\t\n1177\t    def test_evidence_log_corruption_alone_blocks_recovery(self) -> None:\n1178\t        output_root, _lock, _conn = self._populated_root()\n1179\t        store = EvidenceStore(output_root)\n1180\t        store.append(\n1181\t            \"events\",\n1182\t            {\"run_id\": \"run-x\", \"episode_id\": \"e1\", \"kind\": \"START\", \"node_id\": \"D00\"},\n1183\t        )\n1184\t        log = store.log(\"events\")\n1185\t        log.path.write_text(\n1186\t            log.path.read_text(encoding=\"utf-8\").replace('\"START\"', '\"STARTX\"'), encoding=\"utf-8\"\n1187\t        )\n1188\t        self.assertEqual(P.verify_checkpoint_integrity(output_root)[\"integrity_check\"], \"ok\")\n1189\t        with self.assertRaises(P.CheckpointCorrupt):\n1190\t            P.verify_persistence_integrity(output_root, EvidenceStore(output_root))\n1191\t\n1192\t\n1193\t# --------------------------------------------------------------------------\n1194\t# Episode lifecycle: new empty thread per episode (spec 11.1, 11.4 step 6)\n1195\t# --------------------------------------------------------------------------\n1196\t\n1197\t\n1198\tclass TestEpisodeLifecycle(PersistenceTestCase):\n1199\t    def test_each_episode_gets_a_new_thread_with_empty_langgraph_state(self) -> None:\n1200\t        first = self.fresh_invocation()\n1201\t        graph = self.linear_graph()\n1202\t        graph.invoke({\"seen\": []}, config=first.config)\n1203\t        P.EpisodeLeaseLedger(self.output_root).close_episode(\n1204\t            episode_ordinal=first.episode_ordinal, terminal={\"terminal\": \"INTERRUPTED\"}\n1205\t        )\n1206\t\n1207\t        view = P.ReadOnlyCheckpointView(graph, self.saver)\n1208\t        second = P.prepare_episode_invocation(\n1209\t            output_root=self.output_root, lock=self.lock, resume=True, read_view=view\n1210\t        )\n1211\t        self.assertEqual(second.bootstrap_kind, P.BOOTSTRAP_RESUME)\n1212\t        self.assertEqual(second.episode_ordinal, 2)\n1213\t        self.assertEqual(second.thread_id, P.episode_thread_id(first.run_id, 2))\n1214\t        self.assertEqual(second.prior_thread_id, first.thread_id)\n1215\t        self.assertEqual(second.run_id, first.run_id)\n1216\t\n1217\t        # The new thread genuinely starts empty; D04 (N22) is what imports state.\n1218\t        self.assertIsNone(self.saver.get_tuple(second.config))\n1219\t        self.assertEqual(graph.get_state(second.config).values, {})\n1220\t        self.assertEqual(second.resume_from[\"thread_id\"], first.thread_id)\n1221\t        self.assertEqual(second.resume_from[\"checkpoint_ns\"], \"\")\n1222\t\n1223\t    def test_a_lease_cannot_be_opened_twice_or_out_of_order(self) -> None:\n1224\t        ledger = P.EpisodeLeaseLedger(self.output_root)\n1225\t        ledger.open_episode(\n1226\t            run_id=\"run-x\", episode_ordinal=1, thread_id=\"t1\", bootstrap_kind=P.BOOTSTRAP_FRESH\n1227\t        )\n1228\t        with self.assertRaises(P.EpisodeLedgerError):\n1229\t            ledger.open_episode(\n1230\t                run_id=\"run-x\", episode_ordinal=2, thread_id=\"t2\", bootstrap_kind=P.BOOTSTRAP_RESUME\n1231\t            )\n1232\t        ledger.close_episode(episode_ordinal=1, terminal={\"terminal\": \"INTERRUPTED\"})\n1233\t        with self.assertRaises(P.EpisodeLedgerError):\n1234\t            ledger.open_episode(\n1235\t                run_id=\"run-x\", episode_ordinal=3, thread_id=\"t3\", bootstrap_kind=P.BOOTSTRAP_RESUME\n1236\t            )\n1237\t\n1238\t    def test_episode_state_update_matches_the_frozen_state_fields(self) -> None:\n1239\t        from runtime.langgraph_factory.state import FACTORY_STATE_FIELDS\n1240\t\n1241\t        update = self.fresh_invocation().as_state_update()\n1242\t        for field in update:\n1243\t            with self.subTest(field=field):\n1244\t                self.assertIn(field, FACTORY_STATE_FIELDS)\n1245\t        self.assertEqual(update[\"checkpoint_namespace\"], \"\")\n1246\t        self.assertEqual(update[\"bootstrap_kind\"], P.BOOTSTRAP_FRESH)\n1247\t\n1248\t\n1249\tif __name__ == \"__main__\":  # pragma: no cover\n1250\t    unittest.main()\n1251\t"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"4bc891a0-4c9d-45a8-b972-8336a1c39107","timestamp":"2026-08-12T15:12:46.389Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
