{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EVo5jUx2DvQHEuQoYFNdvu","type":"tool_result","content":"1\t\"\"\"N13 CLI model transport tests (spec 6.3, 7.1-7.4, 9, 14).\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport json\n5\timport shutil\n6\timport subprocess\n7\timport sys\n8\tfrom dataclasses import dataclass\n9\tfrom datetime import datetime, timedelta, timezone\n10\tfrom pathlib import Path\n11\t\n12\timport jsonschema\n13\timport pytest\n14\timport yaml\n15\t\n16\tfrom runtime.langgraph_factory import transport as tp\n17\tfrom runtime.langgraph_factory.artifacts import (\n18\t    UNIT_SCOPE,\n19\t    ArtifactStore,\n20\t    ArtifactStream,\n21\t    canonical_json_bytes,\n22\t)\n23\tfrom runtime.langgraph_factory.egress import (\n24\t    PROVIDER_DATA_CLASSES,\n25\t    AuthorizationDenied,\n26\t    AuthorizationRecord,\n27\t    EgressGuard,\n28\t    ReceiptLog,\n29\t)\n30\t\n31\tCURRICULUM_DIGEST = \"c\" * 64\n32\tRUN_ID = \"run-plan26-transport\"\n33\t\n34\tEXPECTED_ROUTES = {\n35\t    \"M01_RESEARCH_UNIT_SOURCES\": (\"research_unit_sources\", \"codex\", \"openai\",\n36\t                                  \"gpt-5.6-sol\", \"component_research\", \"xhigh\"),\n37\t    \"M02_CREATE_UNIT_DOMAIN_DATA\": (\"create_unit_domain_data\", \"codex\", \"openai\",\n38\t                                    \"gpt-5.6-sol\", \"final_acceptance\", \"max\"),\n39\t    \"M03_WRITE_UNIT_CONTENT\": (\"write_unit_content\", \"codex\", \"openai\",\n40\t                               \"gpt-5.6-sol\", \"child_explanatory_writing\", \"high\"),\n41\t    \"M04_CREATE_UNIT_VISUALS\": (\"create_unit_visuals\", \"codex\", \"openai\",\n42\t                                \"gpt-5.6-sol\", \"photorealistic_visual_prompt\", \"high\"),\n43\t    \"M05_REVIEW_ACTUAL_UNIT\": (\"review_actual_unit\", \"gemini\", \"google\",\n44\t                               \"gemini-3-pro-preview\", None, \"cli_model_default\"),\n45\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": (\"repair_named_unit_artifact\", \"codex\", \"openai\",\n46\t                                       \"gpt-5.6-sol\", \"final_acceptance\", \"max\"),\n47\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": (\"review_actual_workbook\", \"gemini\", \"google\",\n48\t                                   \"gemini-3-pro-preview\", None, \"cli_model_default\"),\n49\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": (\"repair_named_workbook_defect\", \"codex\", \"openai\",\n50\t                                         \"gpt-5.6-sol\", \"workbook_assembly\", \"high\"),\n51\t}\n52\t\n53\tM03_CANDIDATE = {\n54\t    \"unit_content\": {\n55\t        \"unit_id\": \"U01\",\n56\t        \"sections\": [{\"section_id\": \"s1\", \"heading\": \"Levers\", \"body\": \"A lever pivots.\"}],\n57\t        \"evidence_references\": [\n58\t            {\"section_id\": \"s1\", \"source_id\": \"src-1\", \"source_location\": \"p. 3\"}],\n59\t    }\n60\t}\n61\t\n62\trequires_sandbox = pytest.mark.skipif(\n63\t    tp.sandbox_mechanism() == tp.SANDBOX_UNAVAILABLE,\n64\t    reason=\"host provides no process sandbox; transport fails closed instead of running\")\n65\t\n66\t\n67\tdef codex_events(model: str = \"gpt-5.6-sol\", reroute: str | None = None) -> str:\n68\t    lines = [\n69\t        json.dumps({\"id\": \"0\", \"msg\": {\"type\": \"session_configured\", \"session_id\": \"s0\",\n70\t                                       \"model\": model, \"reasoning_effort\": \"high\"}}),\n71\t        json.dumps({\"id\": \"1\", \"msg\": {\"type\": \"agent_message\", \"message\": \"working\"}}),\n72\t    ]\n73\t    if reroute:\n74\t        lines.append(json.dumps({\"id\": \"2\", \"msg\": {\"type\": \"model_reroute\", \"model\": reroute}}))\n75\t    lines.append(json.dumps({\"id\": \"3\", \"msg\": {\"type\": \"turn.completed\"}}))\n76\t    return \"\\n\".join(lines) + \"\\n\"\n77\t\n78\t\n79\tdef gemini_envelope(model: str = \"gemini-3-pro-preview\", response: str = \"{}\",\n80\t                    requests: int = 1) -> str:\n81\t    return json.dumps({\n82\t        \"session_id\": \"abc\",\n83\t        \"response\": response,\n84\t        \"stats\": {\"models\": {model: {\"api\": {\"totalRequests\": requests, \"totalErrors\": 0,\n85\t                                             \"totalLatencyMs\": 10},\n86\t                                     \"tokens\": {\"total\": 10}}}},\n87\t    })\n88\t\n89\t\n90\t@dataclass\n91\tclass Step:\n92\t    stdout: str\n93\t    result_text: str | None = None\n94\t    returncode: int = 0\n95\t    termination: str = \"exited\"\n96\t\n97\t\n98\tclass FakeRunner:\n99\t    def __init__(self, *steps: Step) -> None:\n100\t        self.steps = list(steps)\n101\t        self.calls: list[dict] = []\n102\t        self.reserved_at_call: list[int] = []\n103\t        self.ledger: tp.AttemptLedger | None = None\n104\t\n105\t    def __call__(self, argv, *, cwd, env, timeout_seconds):\n106\t        step = self.steps[min(len(self.calls), len(self.steps) - 1)]\n107\t        self.calls.append({\"argv\": list(argv), \"cwd\": Path(cwd), \"env\": dict(env),\n108\t                           \"timeout\": timeout_seconds})\n109\t        if self.ledger is not None:\n110\t            self.reserved_at_call.append(self.ledger.total_reserved)\n111\t        if step.result_text is not None:\n112\t            (Path(cwd) / \"result.json\").write_text(step.result_text, encoding=\"utf-8\")\n113\t        return tp.ProcessOutcome(returncode=step.returncode, stdout=step.stdout,\n114\t                                 stderr=\"\", pid=4242, termination=step.termination)\n115\t\n116\t\n117\tdef capability_proof(*, enforced: bool = True) -> dict:\n118\t    facets = {\n119\t        name: {\"required\": True, \"enforced\": enforced, \"mechanism\": \"test\",\n120\t               \"evidence\": \"test fixture\", \"limitation\": None}"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"b55e0a56-f389-4dd2-8446-687ca217701a","timestamp":"2026-08-12T15:12:50.884Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
