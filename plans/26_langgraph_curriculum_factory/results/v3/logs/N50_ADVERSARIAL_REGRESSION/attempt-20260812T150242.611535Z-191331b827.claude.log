{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016dngQuWewPuDnyCJNafGXn","type":"tool_result","content":"1\t\"\"\"N23 model node tests (spec 6.3 model job table, spec 9 context isolation).\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport ast\n5\timport copy\n6\tfrom pathlib import Path\n7\tfrom typing import Any\n8\t\n9\timport jsonschema\n10\timport pytest\n11\t\n12\tfrom runtime.langgraph_factory import model_nodes as mn\n13\tfrom runtime.langgraph_factory import transport as tp\n14\tfrom runtime.langgraph_factory.reducers import (\n15\t    DuplicateConflict,\n16\t    HeadAdvanceError,\n17\t    advance_head,\n18\t    append_unique,\n19\t    monotonic_max,\n20\t    union_disjoint,\n21\t)\n22\tfrom runtime.langgraph_factory.state import (\n23\t    FACTORY_STATE_FIELDS,\n24\t    FIELD_REDUCER_CLASSES,\n25\t    RuntimeContext,\n26\t)\n27\t\n28\tRUN_ID = \"run-plan26-model-nodes\"\n29\tEPISODE_ID = \"ep-n23\"\n30\tSHA = \"0\" * 64\n31\tCONTENT_HASH = \"c\" * 64\n32\t\n33\t# Spec section 9's table, transcribed. The test asserts the code equals this, so a\n34\t# projection can never quietly widen without this literal transcription changing too.\n35\tSPEC_SECTION_9 = {\n36\t    \"M01_discovery\": {\n37\t        \"included\": (\"request\", \"unit\", \"source_rules\", \"discovery_authority\"),\n38\t        \"excluded_doc\": \"sibling requests/units, author history, acceptance, output tree\",\n39\t    },\n40\t    \"M01_interpretation\": {\n41\t        \"included\": (\"request\", \"unit\", \"source_rules\", \"retrieval_group\"),\n42\t        \"excluded_doc\": \"network/repository access, other retrieval groups, \"\n43\t                        \"routing/acceptance state\",\n44\t    },\n45\t    \"M02_domain\": {\n46\t        \"included\": (\"unit\", \"admitted_sources\", \"domain_schema\", \"domain_config\",\n47\t                     \"verifier_interface\", \"calibration\"),\n48\t        \"excluded_doc\": \"content drafts, reviews, sibling units, terminals\",\n49\t    },\n50\t    \"M03_content\": {\n51\t        \"included\": (\"unit\", \"admitted_domain\", \"curriculum_contracts\",\n52\t                     \"admitted_evidence_references\"),\n53\t        \"excluded_doc\": \"rejected domain versions, reviewer history, sibling artifacts, \"\n54\t                        \"acceptance state\",\n55\t    },\n56\t    \"M04_visual\": {\n57\t        \"included\": (\"brief\", \"permitted_facts\", \"visual_contract\"),\n58\t        \"excluded_doc\": \"authoritative circuit/pin/electrical invention, other briefs, \"\n59\t                        \"full state\",\n60\t    },\n61\t    \"M05_unit_review\": {\n62\t        \"included\": (\"unit_artifacts\", \"unit_pdf\", \"page_inventory\", \"pages\",\n63\t                     \"deterministic_evidence\", \"rubric\"),\n64\t        \"excluded_doc\": \"author/repair history, prompts/outputs from M01-M04/M06, counters, \"\n65\t                        \"desired verdict\",\n66\t    },\n67\t    \"M06_unit_repair\": {\n68\t        \"included\": (\"owner\", \"findings\", \"parent\", \"boundary\", \"allowed_facts\",\n69\t                     \"invalidated_descendants\", \"retest_order\"),\n70\t        \"excluded_doc\": \"unrelated findings/artifacts, accepted bytes, sibling units, \"\n71\t                        \"routing/terminal state\",\n72\t    },\n73\t    \"M07_workbook_review\": {\n74\t        \"included\": (\"coverage_map\", \"accepted_unit_hashes\", \"workbook_pdf\",\n75\t                     \"page_inventory\", \"pages\", \"deterministic_evidence\", \"rubric\"),\n76\t        \"excluded_doc\": \"author and unit repair history, desired verdict, mutable unit sources\",\n77\t    },\n78\t    \"M08_workbook_repair\": {\n79\t        \"included\": (\"defect\", \"parent\", \"allowed_files\", \"accepted_unit_hashes\",\n80\t                     \"workbook_pdf_hash\", \"invalidated_descendants\", \"retest_order\"),\n81\t        \"excluded_doc\": \"unit content/domain/visual sources, unrelated workbook defects, \"\n82\t                        \"acceptance/terminal authority\",\n83\t    },\n84\t}\n85\t\n86\tEXPECTED_FAMILY = {\n87\t    \"M01_RESEARCH_UNIT_SOURCES\": \"openai\",\n88\t    \"M02_CREATE_UNIT_DOMAIN_DATA\": \"openai\",\n89\t    \"M03_WRITE_UNIT_CONTENT\": \"openai\",\n90\t    \"M04_CREATE_UNIT_VISUALS\": \"openai\",\n91\t    \"M05_REVIEW_ACTUAL_UNIT\": \"google\",\n92\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"openai\",\n93\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"google\",\n94\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"openai\",\n95\t}\n96\t\n97\t\n98\t# ------------------------------------------------------------------- transport double\n99\t\n100\t\n101\tclass RecordingTransport:\n102\t    \"\"\"Records every dispatch. Not a graph-buildable transport: only tests hold it.\"\"\"\n103\t\n104\t    def __init__(self, responses: dict[str, dict[str, Any]],\n105\t                 errors: list[Exception] | None = None,\n106\t                 observed_family: dict[str, str] | None = None) -> None:\n107\t        self.responses = responses\n108\t        self.errors = list(errors or [])\n109\t        self.observed_family = observed_family or {}\n110\t        self.calls: list[dict[str, Any]] = []\n111\t\n112\t    def execute(self, *, job_id: str, activation_id: str, episode_id: str,\n113\t                projection: Any, staged_inputs: Any = (), **_: Any) -> tp.TransportResult:\n114\t        self.calls.append({\"job_id\": job_id, \"activation_id\": activation_id,\n115\t                           \"episode_id\": episode_id, \"projection\": copy.deepcopy(projection),\n116\t                           \"staged_inputs\": tuple(staged_inputs)})\n117\t        if self.errors:\n118\t            raise self.errors.pop(0)\n119\t        route = tp.resolve_route(job_id)\n120\t        receipt = {\n121\t            \"activation_id\": activation_id,\n122\t            \"job_id\": job_id,\n123\t            \"decided_family\": route.family,\n124\t            \"decided_model\": route.model,\n125\t            \"observed_family\": self.observed_family.get(job_id, route.family),\n126\t            \"observed_model\": route.model,\n127\t            \"outcome\": \"candidate_produced\",\n128\t        }\n129\t        return tp.TransportResult(candidate=copy.deepcopy(self.responses[job_id]),\n130\t                                  receipt=receipt, attempts=(receipt,))"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"8f2dc5f0-fa76-4b7b-bcd6-b498be339907","timestamp":"2026-08-12T15:13:30.152Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
