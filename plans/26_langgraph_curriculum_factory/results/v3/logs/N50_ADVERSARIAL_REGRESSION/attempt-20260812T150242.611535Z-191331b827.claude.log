{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TeNk52GBurJY2zuuxSGQuS","type":"tool_result","content":"230\t    \"curriculum_root\",\n231\t    \"active_manifest_path\",\n232\t    \"output_root\",\n233\t    \"mode\",\n234\t    \"requested_unit_id\",\n235\t)\n236\t\n237\t# Strict persisted values, set before any langgraph serde module is imported.\n238\tos.environ.setdefault(STRICT_MSGPACK_ENV, \"true\")\n239\t\n240\t\n241\tdef langgraph_dir(output_root: Path | str) -> Path:\n242\t    return Path(output_root) / LANGGRAPH_DIRNAME\n243\t\n244\t\n245\tdef checkpoint_db_path(output_root: Path | str) -> Path:\n246\t    return Path(output_root) / CHECKPOINT_DB_RELATIVE\n247\t\n248\t\n249\tdef execution_lock_path(output_root: Path | str) -> Path:\n250\t    return Path(output_root) / EXECUTION_LOCK_RELATIVE\n251\t\n252\t\n253\tdef episode_thread_id(run_id: str, episode_ordinal: int) -> str:\n254\t    if not isinstance(run_id, str) or not run_id:\n255\t        raise PersistenceError(\"run_id must be a non-empty string\")\n256\t    if not isinstance(episode_ordinal, int) or isinstance(episode_ordinal, bool):\n257\t        raise PersistenceError(\"episode_ordinal must be an int\")\n258\t    if episode_ordinal < 1:\n259\t        raise PersistenceError(\"episode_ordinal is one-based\")\n260\t    return f\"{run_id}:episode:{episode_ordinal:06d}\"\n261\t\n262\t\n263\tdef recovery_thread_id(run_id: str, orphan_episode_ordinal: int) -> str:\n264\t    if not isinstance(run_id, str) or not run_id:\n265\t        raise PersistenceError(\"run_id must be a non-empty string\")\n266\t    if not isinstance(orphan_episode_ordinal, int) or isinstance(orphan_episode_ordinal, bool):\n267\t        raise PersistenceError(\"orphan_episode_ordinal must be an int\")\n268\t    if orphan_episode_ordinal < 1:\n269\t        raise PersistenceError(\"orphan_episode_ordinal is one-based\")\n270\t    return f\"{run_id}:recover:{orphan_episode_ordinal}\"\n271\t\n272\t\n273\tdef invoke_config(thread_id: str) -> dict[str, dict[str, str]]:\n274\t    \"\"\"The exact invoke config of spec 11.1 — no extra configurable keys.\"\"\"\n275\t    if not isinstance(thread_id, str) or not thread_id:\n276\t        raise PersistenceError(\"thread_id must be a non-empty string\")\n277\t    return {\"configurable\": {\"thread_id\": thread_id, \"checkpoint_ns\": CHECKPOINT_NS}}\n278\t\n279\t"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"adde2081-6d6e-4cc8-b042-79736afe3844","timestamp":"2026-08-12T15:16:38.350Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
