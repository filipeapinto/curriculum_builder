{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NL4EKzkzXtx2rE76iwEdC2","type":"tool_result","content":"650\tdef test_m08_refuses_a_unit_owned_defect():\n651\t    packet = packet_for(\"M08_workbook_repair\")\n652\t    packet[\"defect\"] = {**packet[\"defect\"], \"component\": \"unit_content\"}\n653\t    context, transport = context_for(\"M08_workbook_repair\")\n654\t    with pytest.raises(mn.RepairBoundaryViolation, match=\"not workbook-owned\"):\n655\t        mn.m08_repair_named_workbook_defect(packet, context)\n656\t    assert transport.calls == []\n657\t\n658\t\n659\tdef test_m08_rejects_a_child_addressing_another_defect():\n660\t    candidate = candidate_for(\"M08_workbook_repair\")\n661\t    candidate[\"candidate_child\"][\"addressed_defect_id\"] = \"D2\"\n662\t    assert run(\"M08_workbook_repair\", candidate=candidate)[\"pending_failure\"][\n663\t        \"failure_class\"] == \"candidate_boundary_violation\"\n664\t\n665\t\n666\t# ======================== TEST 4: M05/M07 exact page denominator and different family\n667\t\n668\t\n669\t@pytest.mark.parametrize(\"spec_name\", [\"M05_unit_review\", \"M07_workbook_review\"])\n670\t@pytest.mark.parametrize(\"mutation\", [\"missing_page\", \"extra_page\", \"duplicate_page\",\n671\t                                      \"zero_pages\", \"wrong_hash\"])\n672\tdef test_review_packets_require_the_exact_frozen_page_denominator(spec_name, mutation):\n673\t    packet = packet_for(spec_name)\n674\t    if mutation == \"missing_page\":\n675\t        packet[\"pages\"] = packet[\"pages\"][:1]\n676\t    elif mutation == \"extra_page\":\n677\t        packet[\"pages\"] = packet[\"pages\"] + [{\"page_number\": 3,\n678\t                                              \"page_sha256\": page_hash(3),\n679\t                                              \"image_name\": \"page-3.png\"}]\n680\t    elif mutation == \"duplicate_page\":\n681\t        packet[\"pages\"] = packet[\"pages\"] + [dict(packet[\"pages\"][0])]\n682\t    elif mutation == \"zero_pages\":\n683\t        packet[\"page_inventory\"] = {\"page_count\": 0, \"pages\": []}\n684\t    else:\n685\t        packet[\"pages\"][1][\"page_sha256\"] = \"f\" * 64\n686\t\n687\t    context, transport = context_for(spec_name)\n688\t    with pytest.raises(mn.PageDenominatorViolation):\n689\t        ADAPTER_FOR_SPEC[spec_name](packet, context)\n690\t    assert transport.calls == []\n691\t\n692\t\n693\t@pytest.mark.parametrize(\"spec_name\", [\"M05_unit_review\", \"M07_workbook_review\"])\n694\t@pytest.mark.parametrize(\"mutation\", [\"missing_finding\", \"extra_finding\",\n695\t                                      \"duplicate_finding\", \"wrong_page_hash\"])\n696\tdef test_review_findings_must_cover_every_page_exactly(spec_name, mutation):\n697\t    candidate = review_candidate(2)\n698\t    if mutation == \"missing_finding\":\n699\t        candidate[\"page_findings\"] = candidate[\"page_findings\"][:1]\n700\t    elif mutation == \"extra_finding\":\n701\t        candidate[\"page_findings\"].append({\"page_number\": 3, \"page_sha256\": page_hash(3),\n702\t                                           \"findings\": []})\n703\t    elif mutation == \"duplicate_finding\":\n704\t        candidate[\"page_findings\"].append(dict(candidate[\"page_findings\"][0]))\n705\t    else:\n706\t        candidate[\"page_findings\"][1][\"page_sha256\"] = \"f\" * 64\n707\t\n708\t    update = run(spec_name, candidate=candidate)\n709\t    channel = \"unit_reviews\" if spec_name == \"M05_unit_review\" else \"workbook_reviews\"\n710\t    assert channel not in update\n711\t    assert update[\"pending_failure\"][\"failure_class\"] == \"candidate_page_denominator\"\n712\t\n713\t\n714\t@pytest.mark.parametrize(\"spec_name\", [\"M05_unit_review\", \"M07_workbook_review\"])\n715\tdef test_a_review_executing_in_the_authoring_family_is_a_system_fault(spec_name):\n716\t    job_id = mn.PROJECTION_SPECS[spec_name].job_id\n717\t    with pytest.raises(mn.FamilyViolation, match=\"authoring family\"):\n718\t        run(spec_name, observed_family={job_id: tp.AUTHORING_FAMILY})\n719\t\n720\t\n721\t@pytest.mark.parametrize(\"job_id\", [\"M05_REVIEW_ACTUAL_UNIT\", \"M07_REVIEW_ACTUAL_WORKBOOK\"])\n722\tdef test_n13_identity_primitive_also_rejects_the_authoring_family(job_id):\n723\t    route = tp.resolve_route(job_id)\n724\t    assert route.is_review\n725\t    observed = tp.ObservedIdentity(model=route.model, family=tp.AUTHORING_FAMILY,\n726\t                                   model_source=\"test\", family_source=\"test\")\n727\t    with pytest.raises(tp.IdentityMismatch):\n728\t        tp.assert_identity_matches(route, observed)\n729\t\n730\t\n731\t@pytest.mark.parametrize(\"spec_name\", [\"M05_unit_review\", \"M07_workbook_review\"])\n732\tdef test_a_conforming_review_records_the_page_denominator(spec_name):\n733\t    update = run(spec_name)\n734\t    channel = \"unit_reviews\" if spec_name == \"M05_unit_review\" else \"workbook_reviews\"\n735\t    assert update[channel][0][\"page_count\"] == 2\n736\t    assert update[channel][0][\"review_kind\"] == (\n737\t        \"unit\" if spec_name == \"M05_unit_review\" else \"workbook\")\n738\t\n739\t\n740\t# ======================================== TEST 5: retry always traverses D91 then D90\n741\t\n742\t\n743\tdef test_transport_is_invoked_from_exactly_one_call_site():\n744\t    assert mn.transport_call_sites() == [\"_dispatch\"]\n745\t\n746\t\n747\tdef test_no_adapter_holds_a_second_transport_reference():\n748\t    source = Path(mn.__file__).read_text(encoding=\"utf-8\")\n749\t    tree = ast.parse(source)"}]},"parent_tool_use_id":"toolu_01NeCmjuxKDcAbksKJ6Yq96c","session_id":"913d8145-a69b-41ae-866d-8d539cb6c5e2","uuid":"803087d7-c90c-4134-bb37-a96533a15b06","timestamp":"2026-08-12T15:13:30.752Z","subagent_type":"general-purpose","task_description":"Write test_plan26_adversarial.py"}
