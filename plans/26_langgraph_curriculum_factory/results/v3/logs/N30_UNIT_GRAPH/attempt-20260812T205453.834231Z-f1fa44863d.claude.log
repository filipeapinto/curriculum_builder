93-    # The gap N13 named is real and still open: nothing in `nodes/` persists bodies.\n2594-    from runtime.langgraph_factory import artifacts as A\n2595-\n2596-    assert hasattr(A.ArtifactStore, \"admit_version\")\n2597-    nodes_dir = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"nodes\"\n2598-    callers = [\n2599-        path.name\n2600-        for path in sorted(nodes_dir.glob(\"*.py\"))\n2601-        if \"admit_version\" in path.read_text(encoding=\"utf-8\")\n2602-    ]\n2603-    assert callers == [], f\"{callers} now persists artifact bodies; revisit this note\"\n2604-\n2605-    # This node's renderers do not depend on it: no method of the harness registry\n2606-    # names the store, the path guard, or the output root.\n2607-    source = inspect.getsource(_StubRegistry)\n2608-    for forbidden in (\"ArtifactStore\", \"admit_version\", \"path_guard\", \"output_root\"):\n2609-        assert forbidden not in source\n2610-\n2611-    # And the episode really renders, inspects and admits without a single blob.\n2612-    fixture = _build_episode_fixture(tmp_path)\n2613-    result = _run_episode(monkeypatch, fixture)","numLines":41,"totalLines":41}}
