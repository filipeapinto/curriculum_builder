{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0192qA2L7ZLumLXqKv7s8hqN","type":"tool_result","content":"2613\t    result = _run_episode(monkeypatch, fixture)\n2614\t    store_root = fixture[\"output_root\"]\n2615\t    blobs = [path for path in store_root.rglob(\"*\") if path.is_file() and \"artifact\" in str(path)]\n2616\t    assert blobs == [], blobs\n2617\t    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n2618\t    assert result[\"state\"][\"unit_page_inventories\"][0][\"result\"] == \"PASS\"\n2619\t\n2620\t\n2621\tdef test_blocked_the_review_handoff_to_n31_is_declared_not_wired(available) -> None:\n2622\t    \"\"\"A clean D16 is N31's handoff; D16 has no body, so the edge is declared.\n2623\t\n2624\t    This is the prompt's own frontier (\"clean D16 evidence is a handoff to\n2625\t    N31\"), recorded as a deferred edge rather than a fabricated destination.\n2626\t    \"\"\"\n2627\t\n2628\t    assert \"D16_REDUCE_UNIT_EVIDENCE\" not in available\n2629\t    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n2630\t            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES\n2631\t    assert R.GUARD_DESTINATIONS[\"D16_REDUCE_UNIT_EVIDENCE\"][\"unit_denominator_passed\"] == \"D22_ACCEPT_UNIT\"\n2632\t"}]},"parent_tool_use_id":null,"session_id":"630859f1-b31d-4626-a279-8e4616817ce2","uuid":"e885fc6a-57b5-47be-a1b4-b23a896942f5","timestamp":"2026-08-12T20:56:13.785Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N30_UNIT_GRAPH/attempt-20260812T205453.834231Z-f1fa44863d/repo/tests/runtime/test_plan26_unit_graph.py","content":"    result = _run_episode(monkeypatch, fixture)\n    store_root = fixture[\"output_root\"]\n    blobs = [path for path in store_root.rglob(\"*\") if path.is_file() and \"artifact\" in str(path)]\n    assert blobs == [], blobs\n    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n    assert result[\"state\"][\"unit_page_inventories\"][0][\"result\"] == \"PASS\"\n\n\ndef test_blocked_the_review_handoff_to_n31_is_declared_not_wired(available) -> None:\n    \"\"\"A clean D16 is N31's handoff; D16 has no body, so the edge is declared.\n\n    This is the prompt's own frontier (\"clean D16 evidence is a handoff to\n    N31\"), recorded as a deferred edge rather than a fabricated destination.\n    \"\"\"\n\n    assert \"D16_REDUCE_UNIT_EVIDENCE\" not in available\n    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES\n    assert R.GUARD_DESTINATIONS[\"D16_REDUCE_UNIT_EVIDENCE\"][\"unit_denominator_passed\"] == \"D22_ACCEPT_UNIT\"\n","numLines":20,"startLine":2613,"totalLines":2632}}}
