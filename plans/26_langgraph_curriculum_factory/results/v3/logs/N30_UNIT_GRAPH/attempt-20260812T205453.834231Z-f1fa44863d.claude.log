{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cm9fGBg8BQQfA2mit4JNLi","type":"tool_result","content":"1274\t    state = result[\"state\"]\n1275\t    assert state[\"bootstrap_kind\"] == \"fresh\"\n1276\t    assert state[\"run_id\"]\n1277\t    assert state[\"mode\"] == \"one\"\n1278\t    assert state[\"effective_run\"][\"target_closure\"] == [\"U001\"]\n1279\t    assert state[\"selected_unit_id\"] == \"U001\"\n1280\t    # No product success, and no second terminal, however the episode ends.\n1281\t    assert result[\"trace\"].count(\"D98_WRITE_TERMINAL\") <= 1\n1282\t    if state.get(\"terminal\") is not None:\n1283\t        assert state[\"terminal\"][\"kind\"] not in (\"UNIT_ACCEPTED\", \"COMPLETE\")\n1284\t\n1285\t\n1286\tdef test_the_source_map_reduce_supersteps_execute_as_real_send_fanouts(\n1287\t    tmp_path: Path, monkeypatch\n1288\t) -> None:\n1289\t    \"\"\"Both M01 supersteps run as `Send` maps, join at their barriers, and admit.\n1290\t\n1291\t    With B-6 and B-7 closed this is a real reduction, not a trace of a refusal:\n1292\t    each map reserves through D90 first, runs two real M01 workers in one\n1293\t    superstep, and D07's exact join admits both sources.\n1294\t    \"\"\"\n1295\t\n1296\t    fixture = _build_episode_fixture(tmp_path)\n1297\t    result = _run_episode(monkeypatch, fixture)\n1298\t    trace = result[\"trace\"]\n1299\t\n1300\t    # Two `Send` maps of two members each: four M01 activations, no more.\n1301\t    assert trace.count(\"M01_RESEARCH_UNIT_SOURCES\") == 4\n1302\t    # Each map is preceded by its reservation, and each superstep is contiguous.\n1303\t    first = trace.index(\"M01_RESEARCH_UNIT_SOURCES\")\n1304\t    assert trace[first - 1] == \"D90_RESERVE_MODEL_ATTEMPT\"\n1305\t    assert trace[first : first + 2] == [\"M01_RESEARCH_UNIT_SOURCES\"] * 2\n1306\t    assert trace[first + 2] == \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n1307\t\n1308\t    # No model failure at all: every dispatch carried a committed counter.\n1309\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in trace\n1310\t\n1311\t    # The join really admitted, and the denominator it joined is the one D06 committed.\n1312\t    admission = next(\n1313\t        update for node_id, update in result[\"updates\"]\n1314\t        if node_id == \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n1315\t    )\n1316\t    assert admission[\"pending_guard\"][\"value\"] == \"sources_admitted\"\n1317\t    denominator = next(\n1318\t        iter(\n1319\t            next(\n1320\t                update for node_id, update in result[\"updates\"]\n1321\t                if node_id == \"D06_COMPILE_SOURCE_REQUESTS\"\n1322\t            )[\"source_denominators\"].values()\n1323\t        )\n1324\t    )\n1325\t    assert sorted(record[\"key\"] for record in admission[\"source_admissions\"]) == sorted(\n1326\t        denominator[\"request_keys\"]\n1327\t    )\n1328\t\n1329\t\n1330\tdef test_the_domain_head_advances_only_after_code_owned_admission(\n1331\t    tmp_path: Path, monkeypatch\n1332\t) -> None:\n1333\t    \"\"\"Prompt TEST 4, on a real episode: M02 writes a candidate, D08 mints the head.\n1334\t\n1335\t    The head that exists at the end of the episode was minted by D08, not by the\n1336\t    model: the M02 record in the same episode carries no `version`/`hash`, and the\n1337\t    admitted head's hash is not any hash the model supplied.\n1338\t    \"\"\"\n1339\t\n1340\t    fixture = _build_episode_fixture(tmp_path)\n1341\t    result = _run_episode(monkeypatch, fixture)\n1342\t    trace = result[\"trace\"]\n1343\t    assert trace.index(\"M02_CREATE_UNIT_DOMAIN_DATA\") < trace.index(\"D08_VALIDATE_DOMAIN\")\n1344\t\n1345\t    candidate = next(\n1346\t        update for node_id, update in result[\"updates\"]\n1347\t        if node_id == \"M02_CREATE_UNIT_DOMAIN_DATA\"\n1348\t    )[\"artifact_versions\"][0]\n1349\t    assert candidate[\"record_kind\"] == \"model_candidate\"\n1350\t    assert not {\"version\", \"hash\", \"parent_hash\"} & set(candidate)\n1351\t\n1352\t    heads = result[\"state\"][\"artifact_heads\"]\n1353\t    domain_head = heads[\"units/U001/domain\"]\n1354\t    assert domain_head[\"version\"] == 1\n1355\t    assert domain_head[\"parent_hash\"] is None\n1356\t    assert domain_head[\"hash\"] != candidate.get(\"candidate_sha256\")\n1357\t    # And no model node ever wrote the channel that carries it.\n1358\t    for node_id, update in result[\"updates\"]:\n1359\t        if node_id in MODEL_NODE_IDS:\n1360\t            assert \"artifact_heads\" not in update\n1361\t\n1362\t\n1363\tdef test_the_content_head_advances_only_after_code_owned_admission(\n1364\t    tmp_path: Path, monkeypatch\n1365\t) -> None:\n1366\t    \"\"\"Prompt TEST 4's second half, now that D09 can admit.\n1367\t\n1368\t    The content head is minted by D09 off the current head, not read off M03's\n1369\t    record — and it is anchored to the domain head it was written against, so a\n1370\t    content version cannot outlive the domain it cites.\n1371\t    \"\"\"\n1372\t\n1373\t    fixture = _build_episode_fixture(tmp_path)\n1374\t    result = _run_episode(monkeypatch, fixture)\n1375\t    trace = result[\"trace\"]\n1376\t    assert trace.index(\"M03_WRITE_UNIT_CONTENT\") < trace.index(\"D09_VALIDATE_CONTENT\")\n1377\t\n1378\t    candidate = next(\n1379\t        update for node_id, update in result[\"updates\"]\n1380\t        if node_id == \"M03_WRITE_UNIT_CONTENT\"\n1381\t    )[\"artifact_versions\"][0]\n1382\t    assert candidate[\"record_kind\"] == \"model_candidate\"\n1383\t    assert not {\"version\", \"hash\", \"parent_hash\"} & set(candidate)\n1384\t\n1385\t    heads = result[\"state\"][\"artifact_heads\"]\n1386\t    content_head = heads[\"units/U001/content\"]\n1387\t    assert content_head[\"version\"] == 1\n1388\t    assert content_head[\"parent_hash\"] is None\n1389\t    assert content_head[\"hash\"] != candidate.get(\"candidate_sha256\")\n1390\t\n1391\t    minted = next(\n1392\t        record for record in result[\"state\"][\"artifact_versions\"]\n1393\t        if record.get(\"stream\") == \"units/U001/content\"\n1394\t    )\n1395\t    assert minted[\"minted_by\"] == \"deterministic_admission\"\n1396\t    assert minted[\"domain_hash\"] == heads[\"units/U001/domain\"][\"hash\"]\n1397\t\n1398\t    admission = next(\n1399\t        update for node_id, update in result[\"updates\"] if node_id == \"D09_VALIDATE_CONTENT\"\n1400\t    )\n1401\t    assert admission[\"pending_guard\"][\"value\"] == \"content_admitted\"\n1402\t    assert {check[\"check_id\"] for check in admission[\"deterministic_checks\"]} >= {\n1403\t        \"content_schema_valid\",\n1404\t        \"content_domain_current\",\n1405\t    }\n1406\t\n1407\t\n1408\tdef test_a_visual_denominator_permutation_produces_an_identical_admitted_head(\n1409\t    tmp_path: Path, monkeypatch\n1410\t) -> None:\n1411\t    \"\"\"Prompt TEST 5: the order the briefs are declared in cannot move the head.\n1412\t\n1413\t    Two real episodes, identical but for the order M03 declares its two visuals\n1414\t    in. The denominator members, the join, and the admitted `visuals` head hash\n1415\t    must all be identical: a join whose answer depended on arrival or declaration\n1416\t    order would admit a different artifact for the same content, which is exactly\n1417\t    what a content-addressed head is supposed to make impossible.\n1418\t    \"\"\"\n1419\t\n1420\t    def run(order: list[dict[str, Any]]) -> dict[str, Any]:\n1421\t        monkeypatch.setattr(\n1422\t            sys.modules[__name__], \"DECLARED_VISUALS\", order, raising=True\n1423\t        )\n1424\t        fixture = _build_episode_fixture(tmp_path / f\"perm-{len(order)}-{order[0]['role']}\")\n1425\t        return _run_episode(monkeypatch, fixture)\n1426\t\n1427\t    forward = run(list(DECLARED_VISUALS))\n1428\t    reverse = run(list(reversed(DECLARED_VISUALS)))\n1429\t\n1430\t    for result in (forward, reverse):\n1431\t        assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n1432\t        assert result[\"trace\"].count(\"D11_CREATE_DETERMINISTIC_VISUALS\") == 1\n1433\t        assert result[\"trace\"].count(\"M04_CREATE_UNIT_VISUALS\") == 1\n1434\t\n1435\t    def denominator(result: dict[str, Any]) -> dict[str, Any]:\n1436\t        record = dict(next(iter(result[\"state\"][\"visual_denominators\"].values())))\n1437\t        record.pop(\"content_hash\", None)\n1438\t        return record\n1439\t\n1440\t    assert denominator(forward) == denominator(reverse)\n1441\t    assert (\n1442\t        forward[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n1443\t        == reverse[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n1444\t    )\n1445\t\n1446\t    join = [\n1447\t        record for record in forward[\"state\"][\"visual_join_evidence\"]\n1448\t        if record[\"phase\"] == \"join\"\n1449\t    ]\n1450\t    assert [record[\"result\"] for record in join] == [\"PASS\"]\n1451\t    assert join[0][\"denominator_size\"] == join[0][\"actual_size\"] == 2\n1452\t\n1453\t\n1454\tdef test_an_actual_pdf_and_a_positive_contiguous_page_inventory_are_required(\n1455\t    tmp_path: Path, monkeypatch\n1456\t) -> None:\n1457\t    \"\"\"Prompt TEST 6, positive half, on a real episode.\n1458\t\n1459\t    D13's declared PDF hash is re-derived from the bytes on disk by D13 itself and\n1460\t    again by D14, and D14's inventory is positive and numbered 1..N with a real\n1461\t    image and a real hash per page.\n1462\t    \"\"\"\n1463\t\n1464\t    fixture = _build_episode_fixture(tmp_path)\n1465\t    result = _run_episode(monkeypatch, fixture)\n1466\t    state = result[\"state\"]\n1467\t\n1468\t    layout = next(\n1469\t        record for record in state[\"artifact_versions\"]\n1470\t        if record.get(\"stream\") == \"units/U001/layout\"\n1471\t    )\n1472\t    pdf = Path(layout[\"pdf_path\"])\n1473\t    assert pdf.is_file()\n1474\t    assert _sha256_file(pdf) == layout[\"pdf_sha256\"]\n1475\t    assert Path(layout[\"layout_path\"]).is_file()\n1476\t\n1477\t    inventory = state[\"unit_page_inventories\"][0]\n1478\t    assert inventory[\"result\"] == \"PASS\"\n1479\t    assert inventory[\"contiguous\"] is True\n1480\t    assert inventory[\"page_count\"] == 2\n1481\t    assert inventory[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n1482\t\n1483\t    inspections = state[\"unit_page_inspections\"]\n1484\t    assert [record[\"page\"] for record in inspections] == [1, 2]\n1485\t    seen: set[str] = set()\n1486\t    for record in inspections:\n1487\t        assert record[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n1488\t        image = Path(record[\"image_path\"])\n1489\t        assert image.is_file()\n1490\t        assert record[\"page_sha256\"] == _sha256_file(image)\n1491\t        assert record[\"page_sha256\"] not in seen\n1492\t        seen.add(record[\"page_sha256\"])\n1493\t        assert record[\"result\"] == \"PASS\"\n1494\t\n1495\t    # The deterministic renderer's own asset is real too, and was written by D11\n1496\t    # rather than described by a model.\n1497\t    visual = state[\"visual_results\"][\"U001/visual/build_map\"]\n1498\t    assert visual[\"provenance\"] == \"deterministic_renderer\"\n1499\t    asset = Path(visual[\"asset_path\"])\n1500\t    assert asset.is_file()\n1501\t    assert visual[\"sha256\"] == _sha256_file(asset)\n1502\t\n1503\t\n1504\t@pytest.mark.parametrize(\n1505\t    \"defect\",\n1506\t    [\"empty_inventory\", \"non_contiguous\", \"renderer_lies_about_the_hash\", \"pdf_absent\"],\n1507\t)\n1508\tdef test_a_render_or_inventory_that_cannot_be_proven_is_refused(\n1509\t    tmp_path: Path, defect: str\n1510\t) -> None:\n1511\t    \"\"\"Prompt TEST 6, negative half: each way the proof can fail, and how it fails.\n1512\t\n1513\t    A renderer that misreports its own bytes, or names a PDF that does not exist,\n1514\t    is an integrity fault and admits nothing. An empty or non-contiguous page set\n1515\t    is not a tool fault but a product finding, so D14 records a `FAIL` inventory\n1516\t    and the guard routes to the repair classifier — never to a rendered unit.\n1517\t    \"\"\"\n1518\t\n1519\t    sandbox = Path(tempfile.mkdtemp(prefix=\"plan26-n30-render-\"))\n1520\t    registry = _StubRegistry(sandbox)\n1521\t    if defect == \"renderer_lies_about_the_hash\":\n1522\t        registry.render_unit = lambda unit_id, parents: {  # type: ignore[method-assign]\n1523\t            **_StubRegistry.render_unit(registry, unit_id, parents),\n1524\t            \"pdf_sha256\": \"0\" * 64,\n1525\t        }\n1526\t    if defect == \"pdf_absent\":\n1527\t        registry.render_unit = lambda unit_id, parents: {  # type: ignore[method-assign]\n1528\t            **_StubRegistry.render_unit(registry, unit_id, parents),\n1529\t            \"pdf_path\": str(sandbox / \"does-not-exist.pdf\"),\n1530\t        }\n1531\t\n1532\t    state: dict[str, Any] = {\n1533\t        \"selected_unit_id\": \"U001\",\n1534\t        \"artifact_heads\": {\n1535\t            \"units/U001/domain\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"d\" * 64},\n1536\t            \"units/U001/content\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"c\" * 64},\n1537\t            \"units/U001/visuals\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"v\" * 64},\n1538\t        },\n1539\t        \"artifact_versions\": [],\n1540\t        \"engine_root\": str(REPO_ROOT),\n1541\t        \"output_root\": str(sandbox),\n1542\t    }\n1543\t    context = _Context(transport_registry=registry)\n1544\t    rendered = render.D13_RENDER_UNIT(state, context)\n1545\t\n1546\t    if defect in (\"renderer_lies_about_the_hash\", \"pdf_absent\"):\n1547\t        assert \"artifact_versions\" not in rendered\n1548\t        assert rendered[\"pending_failure\"][\"class\"] == \"system\"\n1549\t        assert rendered[\"pending_failure\"][\"cause\"] == \"integrity\"\n1550\t        return\n1551\t\n1552\t    assert rendered[\"pending_guard\"][\"value\"] == \"unit_rendered\"\n1553\t    if defect == \"empty_inventory\":\n1554\t        registry.inspect_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n1555\t    else:\n1556\t        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n1557\t            report = _StubRegistry.inspect_pages(registry, pdf_path, pdf_sha256)\n1558\t            report[\"pages\"][1][\"number\"] = 3\n1559\t            return report\n1560\t\n1561\t        registry.inspect_pages = _skewed  # type: ignore[method-assign]\n1562\t\n1563\t    inspected = render.D14_INVENTORY_AND_INSPECT_UNIT_PAGES(\n1564\t        {**state, \"artifact_versions\": rendered[\"artifact_versions\"]}, context\n1565\t    )\n1566\t    inventory = inspected[\"unit_page_inventories\"][0]\n1567\t    assert inventory[\"result\"] == \"FAIL\"\n1568\t    assert inspected[\"pending_guard\"][\"value\"] == \"layout_repairable\"\n1569\t    assert R.route_page_inspection({**state, **inspected}) == \"D17_CLASSIFY_UNIT_FINDINGS\"\n1570\t\n1571\t\n1572\tdef test_the_review_packet_names_the_exact_pdf_and_every_page_once(\n1573\t    tmp_path: Path, monkeypatch\n1574\t) -> None:\n1575\t    \"\"\"Prompt TEST 7, on a real episode: the packet is the denominator M05 answers.\n1576\t\n1577\t    D15 freezes the PDF D14 measured and every inspected page exactly once, and\n1578\t    the review M05 really returned answers that page set by number *and* by hash,\n1579\t    with nothing invented and nothing dropped. This is the evidence D16 reduces,\n1580\t    so it is the last thing this node is responsible for handing N31.\n1581\t    \"\"\"\n1582\t\n1583\t    fixture = _build_episode_fixture(tmp_path)\n1584\t    result = _run_episode(monkeypatch, fixture)\n1585\t    state = result[\"state\"]\n1586\t\n1587\t    packet = state[\"review_packets\"][0]\n1588\t    inventory = state[\"unit_page_inventories\"][0]\n1589\t    inspections = state[\"unit_page_inspections\"]\n1590\t\n1591\t    assert packet[\"pdf_sha256\"] == inventory[\"pdf_sha256\"]\n1592\t    assert packet[\"page_count\"] == inventory[\"page_count\"] == len(inspections)\n1593\t    assert packet[\"page_keys\"] == [record[\"key\"] for record in inspections]\n1594\t    assert len(set(packet[\"page_keys\"])) == len(packet[\"page_keys\"])\n1595\t    assert packet[\"denominator\"] == {\n1596\t        \"pages\": len(inspections),\n1597\t        \"artifacts\": len(packet[\"artifact_hashes\"]),\n1598\t        \"checks\": len(packet[\"deterministic_check_keys\"]),\n1599\t        \"sources\": len(packet[\"admitted_source_keys\"]),\n1600\t    }\n1601\t    for channel in (\"domain\", \"content\", \"visuals\"):\n1602\t        assert packet[\"artifact_hashes\"][channel] == state[\"artifact_heads\"][f\"units/U001/{channel}\"][\"hash\"]\n1603\t\n1604\t    # M05's dispatch carried that exact packet, and its answer matches it by hash.\n1605\t    dispatched = next(\n1606\t        update for node_id, update in result[\"updates\"]\n1607\t        if node_id == \"D15_FREEZE_UNIT_REVIEW_PACKET\"\n1608\t    )[\"pending_packet\"][\"packets\"]\n1609\t    assert len(dispatched) == 1\n1610\t    projected_pages = dispatched[0][\"pages\"]\n1611\t    assert [page[\"page_number\"] for page in projected_pages] == [1, 2]\n1612\t    assert [page[\"page_sha256\"] for page in projected_pages] == [\n1613\t        record[\"page_sha256\"] for record in inspections\n1614\t    ]\n1615\t\n1616\t    review_record = state[\"unit_reviews\"][0]\n1617\t    assert review_record[\"unit_pdf_sha256\"] == packet[\"pdf_sha256\"]\n1618\t    assert review_record[\"page_count\"] == packet[\"page_count\"]\n1619\t    findings = review_record[\"payload\"][\"page_findings\"]\n1620\t    assert [entry[\"page_number\"] for entry in findings] == [1, 2]\n1621\t    assert [entry[\"page_sha256\"] for entry in findings] == [\n1622\t        record[\"page_sha256\"] for record in inspections\n1623\t    ]\n1624\t\n1625\t    # And the review is a candidate, not an admission: no head moved for it.\n1626\t    assert review_record[\"pre_admission\"] is True\n1627\t    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n1628\t\n1629\t\n1630\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1631\t    tmp_path: Path, monkeypatch\n1632\t) -> None:\n1633\t    \"\"\"The episode's real frontier is this node's own GOAL boundary.\n1634\t\n1635\t    The whole unit path now executes and M05 returns a real independent review;\n1636\t    its `review_returned` guard resolves to `D16_REDUCE_UNIT_EVIDENCE`, which has\n1637\t    no node body because reducing unit evidence is N31's. The episode therefore\n1638\t    ends on the exact row of `DEFERRED_EDGES` the prompt names as the handoff,\n1639\t    with no failure, no terminal, and no fabricated destination.\n1640\t    \"\"\"\n1641\t\n1642\t    fixture = _build_episode_fixture(tmp_path)\n1643\t    result = _run_episode(monkeypatch, fixture)\n1644\t\n1645\t    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n1646\t    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n1647\t            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES\n1648\t\n1649\t    state = result[\"state\"]\n1650\t    assert state.get(\"pending_failure\") is None\n1651\t    assert state.get(\"terminal\") is None\n1652\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1653\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1654\t    # handoff rather than a repair loop that happens to stop here.\n1655\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1656\t    assert sorted(state[\"artifact_heads\"]) == [\n1657\t        \"units/U001/content\",\n1658\t        \"units/U001/domain\",\n1659\t        \"units/U001/visuals\",\n1660\t    ]\n1661\t\n1662\t\n1663\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1664\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n1665\t    tmp_path: Path, monkeypatch, boundary: str\n1666\t) -> None:\n1667\t    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n1668\t\n1669\t    The signal is raised after `boundary` returns. The next boundary observes it,\n1670\t    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n1671\t    resume frontier — never two terminals, and never a product success. The\n1672\t    interrupt takes precedence over the guard value at every boundary, which is\n1673\t    why a signal raised after D09 still reaches the gate rather than D09's own\n1674\t    deferred destination.\n1675\t    \"\"\"\n1676\t\n1677\t    fixture = _build_episode_fixture(tmp_path, units=1)\n1678\t    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n1679\t    trace = result[\"trace\"]\n1680\t    terminal = result[\"state\"].get(\"terminal\")\n1681\t\n1682\t    assert boundary in trace\n1683\t    assert result[\"deferred_frontier\"] is None, (\n1684\t        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n1685\t    )\n1686\t    assert terminal is not None\n1687\t    assert terminal[\"kind\"] == \"INTERRUPTED\"\n1688\t    assert terminal[\"resumable\"] is True\n1689\t    assert terminal[\"exit_code\"] == 10\n1690\t    assert terminal[\"evidence\"][\"resume_frontier\"]\n1691\t    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n1692\t\n1693\t    # Exactly one terminal, counted as terminals and not as D98 entries. An\n1694\t    # interrupt raised inside a `Send` map sends every in-flight branch to the\n1695\t    # gate, so D96 and D98 legitimately run once per branch; what must never\n1696\t    # happen is a second terminal. The extra entries refuse rather than write.\n1697\t    assert len(result[\"state\"][\"terminal_history\"]) == 1\n1698\t    written = [\n1699\t        update\n1700\t        for node_id, update in result[\"updates\"]\n1701\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n1702\t    ]\n1703\t    assert len(written) == 1\n1704\t    for node_id, update in result[\"updates\"]:\n1705\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n1706\t            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"\n1707\t            assert \"already holds a terminal record\" in update[\"pending_failure\"][\"message\"]\n1708\t\n1709\t    # Nothing chargeable ran after the interrupt. Stated as three separate\n1710\t    # properties, because \"nothing at all ran\" is not true at a `Send` map and\n1711\t    # asserting it would be asserting a race rather than an invariant: when the\n1712\t    # signal is observed between two in-flight map branches, one branch routes to\n1713\t    # the gate while the sibling's already-decided normal edge still fires, so a\n1714\t    # deterministic node can legitimately complete alongside the gate. It cannot\n1715\t    # dispatch, though — its own guard sees the signal — and that is what prompt\n1716\t    # TEST 9's \"without repeated valid calls\" actually requires.\n1717\t    gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1718\t    after = trace[gate:]\n1719\t    # 1. No model node runs after the gate: no valid model call is repeated.\n1720\t    assert not set(after) & MODEL_NODE_IDS\n1721\t    # 2. No attempt is even reserved after it, so nothing became chargeable.\n1722\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1723\t    for node_id, update in result[\"updates\"][gate:]:\n1724\t        assert \"attempt_counters\" not in (update or {}), node_id\n1725\t    # 3. Anything else that ran is a deterministic node that was already in\n1726\t    #    flight, and it is bounded: it may not be an admission node, so no\n1727\t    #    artifact head can advance behind the interrupt.\n1728\t    stragglers = set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"}\n1729\t    assert stragglers <= set(NODE_CATALOGUE), stragglers\n1730\t    for node_id, update in result[\"updates\"][gate:]:\n1731\t        assert \"artifact_heads\" not in (update or {}), node_id\n1732\t\n1733\t\n1734\tdef test_an_interrupt_inside_a_send_map_is_bounded_across_repeated_episodes(\n1735\t    tmp_path: Path, monkeypatch\n1736\t) -> None:\n1737\t    \"\"\"The one boundary whose post-gate trace is not deterministic, pinned.\n1738\t\n1739\t    An interrupt observed between two in-flight `Send` branches is a real race:\n1740\t    across repeated runs of the *same* input, the sibling branch sometimes routes\n1741\t    to the gate and sometimes completes its own normal edge first. The matrix row\n1742\t    for this boundary would otherwise be asserting whichever outcome happened to\n1743\t    occur. Twelve episodes are run and the bound is asserted over all of them:\n1744\t    whatever the interleaving, exactly one terminal is written, no model node and\n1745\t    no attempt reservation ever follows the gate, and the only deterministic node\n1746\t    that can straggle is the sibling's own join target.\n1747\t    \"\"\"\n1748\t\n1749\t    shapes: set[tuple[str, ...]] = set()\n1750\t    for index in range(12):\n1751\t        fixture = _build_episode_fixture(tmp_path / f\"map-interrupt-{index}\")\n1752\t        result = _run_episode(\n1753\t            monkeypatch, fixture, interrupt_after=\"M01_RESEARCH_UNIT_SOURCES\"\n1754\t        )\n1755\t        trace = result[\"trace\"]\n1756\t        gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1757\t        after = trace[gate:]\n1758\t        shapes.add(tuple(after))\n1759\t\n1760\t        assert len(result[\"state\"][\"terminal_history\"]) == 1\n1761\t        assert result[\"state\"][\"terminal\"][\"kind\"] == \"INTERRUPTED\"\n1762\t        assert not set(after) & MODEL_NODE_IDS\n1763\t        assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1764\t        assert set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"} <= {\n1765\t            \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n1766\t        }\n1767\t\n1768\t    # The race is real and is recorded as such rather than asserted away: if a\n1769\t    # future change made it deterministic this would still pass, but the bound\n1770\t    # above is what the matrix row is entitled to claim.\n1771\t    assert shapes\n1772\t\n1773\t"}]},"parent_tool_use_id":null,"session_id":"630859f1-b31d-4626-a279-8e4616817ce2","uuid":"4be6965b-2ca7-43ba-9479-8361c2c7a7b1","timestamp":"2026-08-12T20:56:02.298Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N30_UNIT_GRAPH/attempt-20260812T205453.834231Z-f1fa44863d/repo/tests/runtime/test_plan26_unit_graph.py","content":"    state = result[\"state\"]\n    assert state[\"bootstrap_kind\"] == \"fresh\"\n    assert state[\"run_id\"]\n    assert state[\"mode\"] == \"one\"\n    assert state[\"effective_run\"][\"target_closure\"] == [\"U001\"]\n    assert state[\"selected_unit_id\"] == \"U001\"\n    # No product success, and no second terminal, however the episode ends.\n    assert result[\"trace\"].count(\"D98_WRITE_TERMINAL\") <= 1\n    if state.get(\"terminal\") is not None:\n        assert state[\"terminal\"][\"kind\"] not in (\"UNIT_ACCEPTED\", \"COMPLETE\")\n\n\ndef test_the_source_map_reduce_supersteps_execute_as_real_send_fanouts(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Both M01 supersteps run as `Send` maps, join at their barriers, and admit.\n\n    With B-6 and B-7 closed this is a real reduction, not a trace of a refusal:\n    each map reserves through D90 first, runs two real M01 workers in one\n    superstep, and D07's exact join admits both sources.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    trace = result[\"trace\"]\n\n    # Two `Send` maps of two members each: four M01 activations, no more.\n    assert trace.count(\"M01_RESEARCH_UNIT_SOURCES\") == 4\n    # Each map is preceded by its reservation, and each superstep is contiguous.\n    first = trace.index(\"M01_RESEARCH_UNIT_SOURCES\")\n    assert trace[first - 1] == \"D90_RESERVE_MODEL_ATTEMPT\"\n    assert trace[first : first + 2] == [\"M01_RESEARCH_UNIT_SOURCES\"] * 2\n    assert trace[first + 2] == \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n\n    # No model failure at all: every dispatch carried a committed counter.\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in trace\n\n    # The join really admitted, and the denominator it joined is the one D06 committed.\n    admission = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n    )\n    assert admission[\"pending_guard\"][\"value\"] == \"sources_admitted\"\n    denominator = next(\n        iter(\n            next(\n                update for node_id, update in result[\"updates\"]\n                if node_id == \"D06_COMPILE_SOURCE_REQUESTS\"\n            )[\"source_denominators\"].values()\n        )\n    )\n    assert sorted(record[\"key\"] for record in admission[\"source_admissions\"]) == sorted(\n        denominator[\"request_keys\"]\n    )\n\n\ndef test_the_domain_head_advances_only_after_code_owned_admission(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 4, on a real episode: M02 writes a candidate, D08 mints the head.\n\n    The head that exists at the end of the episode was minted by D08, not by the\n    model: the M02 record in the same episode carries no `version`/`hash`, and the\n    admitted head's hash is not any hash the model supplied.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    trace = result[\"trace\"]\n    assert trace.index(\"M02_CREATE_UNIT_DOMAIN_DATA\") < trace.index(\"D08_VALIDATE_DOMAIN\")\n\n    candidate = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"M02_CREATE_UNIT_DOMAIN_DATA\"\n    )[\"artifact_versions\"][0]\n    assert candidate[\"record_kind\"] == \"model_candidate\"\n    assert not {\"version\", \"hash\", \"parent_hash\"} & set(candidate)\n\n    heads = result[\"state\"][\"artifact_heads\"]\n    domain_head = heads[\"units/U001/domain\"]\n    assert domain_head[\"version\"] == 1\n    assert domain_head[\"parent_hash\"] is None\n    assert domain_head[\"hash\"] != candidate.get(\"candidate_sha256\")\n    # And no model node ever wrote the channel that carries it.\n    for node_id, update in result[\"updates\"]:\n        if node_id in MODEL_NODE_IDS:\n            assert \"artifact_heads\" not in update\n\n\ndef test_the_content_head_advances_only_after_code_owned_admission(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 4's second half, now that D09 can admit.\n\n    The content head is minted by D09 off the current head, not read off M03's\n    record — and it is anchored to the domain head it was written against, so a\n    content version cannot outlive the domain it cites.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    trace = result[\"trace\"]\n    assert trace.index(\"M03_WRITE_UNIT_CONTENT\") < trace.index(\"D09_VALIDATE_CONTENT\")\n\n    candidate = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"M03_WRITE_UNIT_CONTENT\"\n    )[\"artifact_versions\"][0]\n    assert candidate[\"record_kind\"] == \"model_candidate\"\n    assert not {\"version\", \"hash\", \"parent_hash\"} & set(candidate)\n\n    heads = result[\"state\"][\"artifact_heads\"]\n    content_head = heads[\"units/U001/content\"]\n    assert content_head[\"version\"] == 1\n    assert content_head[\"parent_hash\"] is None\n    assert content_head[\"hash\"] != candidate.get(\"candidate_sha256\")\n\n    minted = next(\n        record for record in result[\"state\"][\"artifact_versions\"]\n        if record.get(\"stream\") == \"units/U001/content\"\n    )\n    assert minted[\"minted_by\"] == \"deterministic_admission\"\n    assert minted[\"domain_hash\"] == heads[\"units/U001/domain\"][\"hash\"]\n\n    admission = next(\n        update for node_id, update in result[\"updates\"] if node_id == \"D09_VALIDATE_CONTENT\"\n    )\n    assert admission[\"pending_guard\"][\"value\"] == \"content_admitted\"\n    assert {check[\"check_id\"] for check in admission[\"deterministic_checks\"]} >= {\n        \"content_schema_valid\",\n        \"content_domain_current\",\n    }\n\n\ndef test_a_visual_denominator_permutation_produces_an_identical_admitted_head(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 5: the order the briefs are declared in cannot move the head.\n\n    Two real episodes, identical but for the order M03 declares its two visuals\n    in. The denominator members, the join, and the admitted `visuals` head hash\n    must all be identical: a join whose answer depended on arrival or declaration\n    order would admit a different artifact for the same content, which is exactly\n    what a content-addressed head is supposed to make impossible.\n    \"\"\"\n\n    def run(order: list[dict[str, Any]]) -> dict[str, Any]:\n        monkeypatch.setattr(\n            sys.modules[__name__], \"DECLARED_VISUALS\", order, raising=True\n        )\n        fixture = _build_episode_fixture(tmp_path / f\"perm-{len(order)}-{order[0]['role']}\")\n        return _run_episode(monkeypatch, fixture)\n\n    forward = run(list(DECLARED_VISUALS))\n    reverse = run(list(reversed(DECLARED_VISUALS)))\n\n    for result in (forward, reverse):\n        assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n        assert result[\"trace\"].count(\"D11_CREATE_DETERMINISTIC_VISUALS\") == 1\n        assert result[\"trace\"].count(\"M04_CREATE_UNIT_VISUALS\") == 1\n\n    def denominator(result: dict[str, Any]) -> dict[str, Any]:\n        record = dict(next(iter(result[\"state\"][\"visual_denominators\"].values())))\n        record.pop(\"content_hash\", None)\n        return record\n\n    assert denominator(forward) == denominator(reverse)\n    assert (\n        forward[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n        == reverse[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n    )\n\n    join = [\n        record for record in forward[\"state\"][\"visual_join_evidence\"]\n        if record[\"phase\"] == \"join\"\n    ]\n    assert [record[\"result\"] for record in join] == [\"PASS\"]\n    assert join[0][\"denominator_size\"] == join[0][\"actual_size\"] == 2\n\n\ndef test_an_actual_pdf_and_a_positive_contiguous_page_inventory_are_required(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 6, positive half, on a real episode.\n\n    D13's declared PDF hash is re-derived from the bytes on disk by D13 itself and\n    again by D14, and D14's inventory is positive and numbered 1..N with a real\n    image and a real hash per page.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    state = result[\"state\"]\n\n    layout = next(\n        record for record in state[\"artifact_versions\"]\n        if record.get(\"stream\") == \"units/U001/layout\"\n    )\n    pdf = Path(layout[\"pdf_path\"])\n    assert pdf.is_file()\n    assert _sha256_file(pdf) == layout[\"pdf_sha256\"]\n    assert Path(layout[\"layout_path\"]).is_file()\n\n    inventory = state[\"unit_page_inventories\"][0]\n    assert inventory[\"result\"] == \"PASS\"\n    assert inventory[\"contiguous\"] is True\n    assert inventory[\"page_count\"] == 2\n    assert inventory[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n\n    inspections = state[\"unit_page_inspections\"]\n    assert [record[\"page\"] for record in inspections] == [1, 2]\n    seen: set[str] = set()\n    for record in inspections:\n        assert record[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n        image = Path(record[\"image_path\"])\n        assert image.is_file()\n        assert record[\"page_sha256\"] == _sha256_file(image)\n        assert record[\"page_sha256\"] not in seen\n        seen.add(record[\"page_sha256\"])\n        assert record[\"result\"] == \"PASS\"\n\n    # The deterministic renderer's own asset is real too, and was written by D11\n    # rather than described by a model.\n    visual = state[\"visual_results\"][\"U001/visual/build_map\"]\n    assert visual[\"provenance\"] == \"deterministic_renderer\"\n    asset = Path(visual[\"asset_path\"])\n    assert asset.is_file()\n    assert visual[\"sha256\"] == _sha256_file(asset)\n\n\n@pytest.mark.parametrize(\n    \"defect\",\n    [\"empty_inventory\", \"non_contiguous\", \"renderer_lies_about_the_hash\", \"pdf_absent\"],\n)\ndef test_a_render_or_inventory_that_cannot_be_proven_is_refused(\n    tmp_path: Path, defect: str\n) -> None:\n    \"\"\"Prompt TEST 6, negative half: each way the proof can fail, and how it fails.\n\n    A renderer that misreports its own bytes, or names a PDF that does not exist,\n    is an integrity fault and admits nothing. An empty or non-contiguous page set\n    is not a tool fault but a product finding, so D14 records a `FAIL` inventory\n    and the guard routes to the repair classifier — never to a rendered unit.\n    \"\"\"\n\n    sandbox = Path(tempfile.mkdtemp(prefix=\"plan26-n30-render-\"))\n    registry = _StubRegistry(sandbox)\n    if defect == \"renderer_lies_about_the_hash\":\n        registry.render_unit = lambda unit_id, parents: {  # type: ignore[method-assign]\n            **_StubRegistry.render_unit(registry, unit_id, parents),\n            \"pdf_sha256\": \"0\" * 64,\n        }\n    if defect == \"pdf_absent\":\n        registry.render_unit = lambda unit_id, parents: {  # type: ignore[method-assign]\n            **_StubRegistry.render_unit(registry, unit_id, parents),\n            \"pdf_path\": str(sandbox / \"does-not-exist.pdf\"),\n        }\n\n    state: dict[str, Any] = {\n        \"selected_unit_id\": \"U001\",\n        \"artifact_heads\": {\n            \"units/U001/domain\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"d\" * 64},\n            \"units/U001/content\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"c\" * 64},\n            \"units/U001/visuals\": {\"version\": 1, \"parent_hash\": None, \"hash\": \"v\" * 64},\n        },\n        \"artifact_versions\": [],\n        \"engine_root\": str(REPO_ROOT),\n        \"output_root\": str(sandbox),\n    }\n    context = _Context(transport_registry=registry)\n    rendered = render.D13_RENDER_UNIT(state, context)\n\n    if defect in (\"renderer_lies_about_the_hash\", \"pdf_absent\"):\n        assert \"artifact_versions\" not in rendered\n        assert rendered[\"pending_failure\"][\"class\"] == \"system\"\n        assert rendered[\"pending_failure\"][\"cause\"] == \"integrity\"\n        return\n\n    assert rendered[\"pending_guard\"][\"value\"] == \"unit_rendered\"\n    if defect == \"empty_inventory\":\n        registry.inspect_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n    else:\n        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n            report = _StubRegistry.inspect_pages(registry, pdf_path, pdf_sha256)\n            report[\"pages\"][1][\"number\"] = 3\n            return report\n\n        registry.inspect_pages = _skewed  # type: ignore[method-assign]\n\n    inspected = render.D14_INVENTORY_AND_INSPECT_UNIT_PAGES(\n        {**state, \"artifact_versions\": rendered[\"artifact_versions\"]}, context\n    )\n    inventory = inspected[\"unit_page_inventories\"][0]\n    assert inventory[\"result\"] == \"FAIL\"\n    assert inspected[\"pending_guard\"][\"value\"] == \"layout_repairable\"\n    assert R.route_page_inspection({**state, **inspected}) == \"D17_CLASSIFY_UNIT_FINDINGS\"\n\n\ndef test_the_review_packet_names_the_exact_pdf_and_every_page_once(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 7, on a real episode: the packet is the denominator M05 answers.\n\n    D15 freezes the PDF D14 measured and every inspected page exactly once, and\n    the review M05 really returned answers that page set by number *and* by hash,\n    with nothing invented and nothing dropped. This is the evidence D16 reduces,\n    so it is the last thing this node is responsible for handing N31.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    state = result[\"state\"]\n\n    packet = state[\"review_packets\"][0]\n    inventory = state[\"unit_page_inventories\"][0]\n    inspections = state[\"unit_page_inspections\"]\n\n    assert packet[\"pdf_sha256\"] == inventory[\"pdf_sha256\"]\n    assert packet[\"page_count\"] == inventory[\"page_count\"] == len(inspections)\n    assert packet[\"page_keys\"] == [record[\"key\"] for record in inspections]\n    assert len(set(packet[\"page_keys\"])) == len(packet[\"page_keys\"])\n    assert packet[\"denominator\"] == {\n        \"pages\": len(inspections),\n        \"artifacts\": len(packet[\"artifact_hashes\"]),\n        \"checks\": len(packet[\"deterministic_check_keys\"]),\n        \"sources\": len(packet[\"admitted_source_keys\"]),\n    }\n    for channel in (\"domain\", \"content\", \"visuals\"):\n        assert packet[\"artifact_hashes\"][channel] == state[\"artifact_heads\"][f\"units/U001/{channel}\"][\"hash\"]\n\n    # M05's dispatch carried that exact packet, and its answer matches it by hash.\n    dispatched = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"D15_FREEZE_UNIT_REVIEW_PACKET\"\n    )[\"pending_packet\"][\"packets\"]\n    assert len(dispatched) == 1\n    projected_pages = dispatched[0][\"pages\"]\n    assert [page[\"page_number\"] for page in projected_pages] == [1, 2]\n    assert [page[\"page_sha256\"] for page in projected_pages] == [\n        record[\"page_sha256\"] for record in inspections\n    ]\n\n    review_record = state[\"unit_reviews\"][0]\n    assert review_record[\"unit_pdf_sha256\"] == packet[\"pdf_sha256\"]\n    assert review_record[\"page_count\"] == packet[\"page_count\"]\n    findings = review_record[\"payload\"][\"page_findings\"]\n    assert [entry[\"page_number\"] for entry in findings] == [1, 2]\n    assert [entry[\"page_sha256\"] for entry in findings] == [\n        record[\"page_sha256\"] for record in inspections\n    ]\n\n    # And the review is a candidate, not an admission: no head moved for it.\n    assert review_record[\"pre_admission\"] is True\n    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n\n\ndef test_the_committed_path_stops_at_a_declared_deferred_edge(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The episode's real frontier is this node's own GOAL boundary.\n\n    The whole unit path now executes and M05 returns a real independent review;\n    its `review_returned` guard resolves to `D16_REDUCE_UNIT_EVIDENCE`, which has\n    no node body because reducing unit evidence is N31's. The episode therefore\n    ends on the exact row of `DEFERRED_EDGES` the prompt names as the handoff,\n    with no failure, no terminal, and no fabricated destination.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES\n\n    state = result[\"state\"]\n    assert state.get(\"pending_failure\") is None\n    assert state.get(\"terminal\") is None\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n    # Every deterministic check the path ran passed, so the frontier is a clean\n    # handoff rather than a repair loop that happens to stop here.\n    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n    assert sorted(state[\"artifact_heads\"]) == [\n        \"units/U001/content\",\n        \"units/U001/domain\",\n        \"units/U001/visuals\",\n    ]\n\n\n@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\ndef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n    tmp_path: Path, monkeypatch, boundary: str\n) -> None:\n    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n\n    The signal is raised after `boundary` returns. The next boundary observes it,\n    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n    resume frontier — never two terminals, and never a product success. The\n    interrupt takes precedence over the guard value at every boundary, which is\n    why a signal raised after D09 still reaches the gate rather than D09's own\n    deferred destination.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path, units=1)\n    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n    trace = result[\"trace\"]\n    terminal = result[\"state\"].get(\"terminal\")\n\n    assert boundary in trace\n    assert result[\"deferred_frontier\"] is None, (\n        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n    )\n    assert terminal is not None\n    assert terminal[\"kind\"] == \"INTERRUPTED\"\n    assert terminal[\"resumable\"] is True\n    assert terminal[\"exit_code\"] == 10\n    assert terminal[\"evidence\"][\"resume_frontier\"]\n    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n\n    # Exactly one terminal, counted as terminals and not as D98 entries. An\n    # interrupt raised inside a `Send` map sends every in-flight branch to the\n    # gate, so D96 and D98 legitimately run once per branch; what must never\n    # happen is a second terminal. The extra entries refuse rather than write.\n    assert len(result[\"state\"][\"terminal_history\"]) == 1\n    written = [\n        update\n        for node_id, update in result[\"updates\"]\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n    ]\n    assert len(written) == 1\n    for node_id, update in result[\"updates\"]:\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"\n            assert \"already holds a terminal record\" in update[\"pending_failure\"][\"message\"]\n\n    # Nothing chargeable ran after the interrupt. Stated as three separate\n    # properties, because \"nothing at all ran\" is not true at a `Send` map and\n    # asserting it would be asserting a race rather than an invariant: when the\n    # signal is observed between two in-flight map branches, one branch routes to\n    # the gate while the sibling's already-decided normal edge still fires, so a\n    # deterministic node can legitimately complete alongside the gate. It cannot\n    # dispatch, though — its own guard sees the signal — and that is what prompt\n    # TEST 9's \"without repeated valid calls\" actually requires.\n    gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n    after = trace[gate:]\n    # 1. No model node runs after the gate: no valid model call is repeated.\n    assert not set(after) & MODEL_NODE_IDS\n    # 2. No attempt is even reserved after it, so nothing became chargeable.\n    assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n    for node_id, update in result[\"updates\"][gate:]:\n        assert \"attempt_counters\" not in (update or {}), node_id\n    # 3. Anything else that ran is a deterministic node that was already in\n    #    flight, and it is bounded: it may not be an admission node, so no\n    #    artifact head can advance behind the interrupt.\n    stragglers = set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"}\n    assert stragglers <= set(NODE_CATALOGUE), stragglers\n    for node_id, update in result[\"updates\"][gate:]:\n        assert \"artifact_heads\" not in (update or {}), node_id\n\n\ndef test_an_interrupt_inside_a_send_map_is_bounded_across_repeated_episodes(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The one boundary whose post-gate trace is not deterministic, pinned.\n\n    An interrupt observed between two in-flight `Send` branches is a real race:\n    across repeated runs of the *same* input, the sibling branch sometimes routes\n    to the gate and sometimes completes its own normal edge first. The matrix row\n    for this boundary would otherwise be asserting whichever outcome happened to\n    occur. Twelve episodes are run and the bound is asserted over all of them:\n    whatever the interleaving, exactly one terminal is written, no model node and\n    no attempt reservation ever follows the gate, and the only deterministic node\n    that can straggle is the sibling's own join target.\n    \"\"\"\n\n    shapes: set[tuple[str, ...]] = set()\n    for index in range(12):\n        fixture = _build_episode_fixture(tmp_path / f\"map-interrupt-{index}\")\n        result = _run_episode(\n            monkeypatch, fixture, interrupt_after=\"M01_RESEARCH_UNIT_SOURCES\"\n        )\n        trace = result[\"trace\"]\n        gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n        after = trace[gate:]\n        shapes.add(tuple(after))\n\n        assert len(result[\"state\"][\"terminal_history\"]) == 1\n        assert result[\"state\"][\"terminal\"][\"kind\"] == \"INTERRUPTED\"\n        assert not set(after) & MODEL_NODE_IDS\n        assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n        assert set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"} <= {\n            \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n        }\n\n    # The race is real and is recorded as such rather than asserted away: if a\n    # future change made it deterministic this would still pass, but the bound\n    # above is what the matrix row is entitled to claim.\n    assert shapes\n\n","numLines":500,"startLine":1274,"totalLines":2632}}}
