{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Emo8XBLgcZvj5F5oSuooJ3","type":"tool_result","content":"1630\t    assert [entry[\"page_sha256\"] for entry in findings] == [\n1631\t        record[\"page_sha256\"] for record in inspections\n1632\t    ]\n1633\t\n1634\t    # And the review is a candidate, not an admission: no head moved for it.\n1635\t    assert review_record[\"pre_admission\"] is True\n1636\t    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n1637\t\n1638\t\n1639\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1640\t    tmp_path: Path, monkeypatch\n1641\t) -> None:\n1642\t    \"\"\"The episode's real frontier is this node's own GOAL boundary.\n1643\t\n1644\t    The whole unit path now executes and M05 returns a real independent review;\n1645\t    its `review_returned` guard resolves to `D16_REDUCE_UNIT_EVIDENCE`, which has\n1646\t    no node body because reducing unit evidence is N31's. The episode therefore\n1647\t    ends on the exact row of `DEFERRED_EDGES` the prompt names as the handoff,\n1648\t    with no failure, no terminal, and no fabricated destination.\n1649\t    \"\"\"\n1650\t\n1651\t    fixture = _build_episode_fixture(tmp_path)\n1652\t    result = _run_episode(monkeypatch, fixture)\n1653\t\n1654\t    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n1655\t    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n1656\t            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES\n1657\t\n1658\t    state = result[\"state\"]\n1659\t    assert state.get(\"pending_failure\") is None\n1660\t    assert state.get(\"terminal\") is None\n1661\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1662\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1663\t    # handoff rather than a repair loop that happens to stop here.\n1664\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1665\t    assert sorted(state[\"artifact_heads\"]) == [\n1666\t        \"units/U001/content\",\n1667\t        \"units/U001/domain\",\n1668\t        \"units/U001/visuals\",\n1669\t    ]\n1670\t\n1671\t\n1672\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1673\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n1674\t    tmp_path: Path, monkeypatch, boundary: str\n1675\t) -> None:\n1676\t    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n1677\t\n1678\t    The signal is raised after `boundary` returns. The next boundary observes it,\n1679\t    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n1680\t    resume frontier — never two terminals, and never a product success. The\n1681\t    interrupt takes precedence over the guard value at every boundary, which is\n1682\t    why a signal raised after D09 still reaches the gate rather than D09's own\n1683\t    deferred destination.\n1684\t    \"\"\"\n1685\t\n1686\t    fixture = _build_episode_fixture(tmp_path, units=1)\n1687\t    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n1688\t    trace = result[\"trace\"]\n1689\t    terminal = result[\"state\"].get(\"terminal\")\n1690\t\n1691\t    assert boundary in trace\n1692\t    assert result[\"deferred_frontier\"] is None, (\n1693\t        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n1694\t    )\n1695\t    assert terminal is not None\n1696\t    assert terminal[\"kind\"] == \"INTERRUPTED\"\n1697\t    assert terminal[\"resumable\"] is True\n1698\t    assert terminal[\"exit_code\"] == 10\n1699\t    assert terminal[\"evidence\"][\"resume_frontier\"]\n1700\t    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n1701\t\n1702\t    # Exactly one terminal, counted as terminals and not as D98 entries. An\n1703\t    # interrupt raised inside a `Send` map sends every in-flight branch to the\n1704\t    # gate, so D96 and D98 legitimately run once per branch; what must never\n1705\t    # happen is a second terminal. The extra entries refuse rather than write.\n1706\t    assert len(result[\"state\"][\"terminal_history\"]) == 1\n1707\t    written = [\n1708\t        update\n1709\t        for node_id, update in result[\"updates\"]\n1710\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n1711\t    ]\n1712\t    assert len(written) == 1\n1713\t    for node_id, update in result[\"updates\"]:\n1714\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n1715\t            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"\n1716\t            assert \"already holds a terminal record\" in update[\"pending_failure\"][\"message\"]\n1717\t\n1718\t    # Nothing chargeable ran after the interrupt. Stated as three separate\n1719\t    # properties, because \"nothing at all ran\" is not true at a `Send` map and\n1720\t    # asserting it would be asserting a race rather than an invariant: when the\n1721\t    # signal is observed between two in-flight map branches, one branch routes to\n1722\t    # the gate while the sibling's already-decided normal edge still fires, so a\n1723\t    # deterministic node can legitimately complete alongside the gate. It cannot\n1724\t    # dispatch, though — its own guard sees the signal — and that is what prompt\n1725\t    # TEST 9's \"without repeated valid calls\" actually requires.\n1726\t    gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1727\t    after = trace[gate:]\n1728\t    # 1. No model node runs after the gate: no valid model call is repeated.\n1729\t    assert not set(after) & MODEL_NODE_IDS\n1730\t    # 2. No attempt is even reserved after it, so nothing became chargeable.\n1731\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1732\t    for node_id, update in result[\"updates\"][gate:]:\n1733\t        assert \"attempt_counters\" not in (update or {}), node_id\n1734\t    # 3. Anything else that ran is a deterministic node that was already in\n1735\t    #    flight, and it is bounded: it may not be an admission node, so no\n1736\t    #    artifact head can advance behind the interrupt.\n1737\t    stragglers = set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"}\n1738\t    assert stragglers <= set(NODE_CATALOGUE), stragglers\n1739\t    for node_id, update in result[\"updates\"][gate:]:\n1740\t        assert \"artifact_heads\" not in (update or {}), node_id\n1741\t\n1742\t\n1743\tdef test_an_interrupt_inside_a_send_map_is_bounded_across_repeated_episodes(\n1744\t    tmp_path: Path, monkeypatch\n1745\t) -> None:\n1746\t    \"\"\"The one boundary whose post-gate trace is not deterministic, pinned.\n1747\t\n1748\t    An interrupt observed between two in-flight `Send` branches is a real race:\n1749\t    across repeated runs of the *same* input, the sibling branch sometimes routes\n1750\t    to the gate and sometimes completes its own normal edge first. The matrix row\n1751\t    for this boundary would otherwise be asserting whichever outcome happened to\n1752\t    occur. Twelve episodes are run and the bound is asserted over all of them:\n1753\t    whatever the interleaving, exactly one terminal is written, no model node and\n1754\t    no attempt reservation ever follows the gate, and the only deterministic node\n1755\t    that can straggle is the sibling's own join target.\n1756\t    \"\"\"\n1757\t\n1758\t    shapes: set[tuple[str, ...]] = set()\n1759\t    for index in range(12):\n1760\t        fixture = _build_episode_fixture(tmp_path / f\"map-interrupt-{index}\")\n1761\t        result = _run_episode(\n1762\t            monkeypatch, fixture, interrupt_after=\"M01_RESEARCH_UNIT_SOURCES\"\n1763\t        )\n1764\t        trace = result[\"trace\"]\n1765\t        gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1766\t        after = trace[gate:]\n1767\t        shapes.add(tuple(after))\n1768\t\n1769\t        assert len(result[\"state\"][\"terminal_history\"]) == 1\n1770\t        assert result[\"state\"][\"terminal\"][\"kind\"] == \"INTERRUPTED\"\n1771\t        assert not set(after) & MODEL_NODE_IDS\n1772\t        assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1773\t        assert set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"} <= {\n1774\t            \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n1775\t        }\n1776\t\n1777\t    # The race is real and is recorded as such rather than asserted away: if a\n1778\t    # future change made it deterministic this would still pass, but the bound\n1779\t    # above is what the matrix row is entitled to claim.\n1780\t    assert shapes\n1781\t\n1782\t\n1783\tdef test_the_unobservable_boundary_is_excluded_for_a_stated_reason(\n1784\t    tmp_path: Path, monkeypatch\n1785\t) -> None:\n1786\t    \"\"\"M05 is left out of the crash matrix because it cannot be observed, not\n1787\t    because it is inconvenient.\n1788\t\n1789\t    M05 really executes — the committed state holds its execution receipt, its\n1790\t    candidate record and its page findings — but the branch that would emit its\n1791\t    update resolves to the deferred `D16_REDUCE_UNIT_EVIDENCE` and aborts the\n1792\t    superstep, so no stream consumer ever sees it. Both halves are asserted, so\n1793\t    the exclusion stops being true (and this test fails) the moment the path\n1794\t    extends past M05, exactly as it did when the frontier was D09.\n1795\t    \"\"\"\n1796\t\n1797\t    assert UNOBSERVABLE_BOUNDARY not in REACHABLE_BOUNDARIES\n1798\t\n1799\t    fixture = _build_episode_fixture(tmp_path)\n1800\t    result = _run_episode(monkeypatch, fixture)\n1801\t    state = result[\"state\"]\n1802\t\n1803\t    assert UNOBSERVABLE_BOUNDARY not in result[\"trace\"]\n1804\t    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n1805\t\n1806\t    # It ran, though: the receipt, the candidate and the review are all committed.\n1807\t    assert [\n1808\t        receipt[\"job_id\"] for receipt in state[\"model_execution_receipts\"]\n1809\t    ].count(UNOBSERVABLE_BOUNDARY) == 1\n1810\t    review_record = state[\"unit_reviews\"][0]\n1811\t    assert review_record[\"job_id\"] == UNOBSERVABLE_BOUNDARY\n1812\t    assert review_record[\"pre_admission\"] is True\n1813\t\n1814\t    # And every other boundary the path reaches is in the matrix, so the\n1815\t    # exclusion is exactly one node rather than a convenient shortfall.\n1816\t    executed = [node_id for node_id in result[\"trace\"] if node_id not in (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\")]\n1817\t    assert set(executed) <= set(REACHABLE_BOUNDARIES)\n1818\t    assert set(REACHABLE_BOUNDARIES) <= set(executed)\n1819\t\n1820\t\n1821\tdef test_a_hard_crash_is_recovered_as_an_orphan_without_continuing_its_thread(\n1822\t    tmp_path: Path, monkeypatch\n1823\t) -> None:\n1824\t    \"\"\"Prompt TEST 9's SIGKILL half: the orphan thread is read, never resumed.\"\"\"\n1825\t\n1826\t    fixture = _build_episode_fixture(tmp_path)\n1827\t    lock, invocation, envelope = _prepare_episode(fixture)\n1828\t    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n1829\t    monkeypatch.setattr(\n1830\t        G,\n1831\t        \"build_model_node_context\",\n1832\t        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n1833\t    )\n1834\t    compiled = G.build_curriculum_factory_graph(\n1835\t        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n1836\t    )\n1837\t\n1838\t    # Simulate the power loss: stop consuming the stream mid-episode and never\n1839\t    # let D98 run, leaving the episode lease open."}]},"parent_tool_use_id":null,"session_id":"e29286fb-f991-47f0-8e19-a325c46ee82a","uuid":"8462bafb-a5a4-4cfa-a46f-0a36a66c6092","timestamp":"2026-08-12T21:00:20.981Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curricu