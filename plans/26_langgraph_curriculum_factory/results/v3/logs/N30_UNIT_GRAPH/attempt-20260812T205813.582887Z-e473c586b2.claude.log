{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D2bHuYFegRK8Sg135PCaQh","type":"tool_result","content":"700\t        \"requested_unit_id\": requested,\n701\t        \"authorization\": {\"scope\": \"test\", \"executables\": []},\n702\t        \"episode_ordinal\": 1,\n703\t        \"prior_identity\": None,\n704\t        \"prior_terminal\": None,\n705\t        \"lease_open\": False,\n706\t    }\n707\t    # D03 requires the authorization to name this run's frozen digest, which the\n708\t    # CLI computes before invocation; D01 is the one function that derives it.\n709\t    probe = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n710\t    digest = inputs.D01_VALIDATE_AND_FREEZE_INPUTS({\"invocation\": envelope}, probe)[\"frozen_digest\"]\n711\t    envelope[\"authorization\"] = {\n712\t        \"scope\": \"test\",\n713\t        \"executables\": [],\n714\t        \"curriculum_digest\": digest,\n715\t    }\n716\t    return lock, invocation, envelope\n717\t\n718\t\n719\tdef _run_episode(\n720\t    monkeypatch: Any,\n721\t    fixture: dict[str, Any],\n722\t    *,\n723\t    interrupt_after: str | None = None,\n724\t) -> dict[str, Any]:\n725\t    \"\"\"Execute one real episode of the real compiled graph, end to end.\n726\t\n727\t    Returns the ordered node trace, the per-node updates, and the final state.\n728\t    \"\"\"\n729\t\n730\t    lock, invocation, envelope = _prepare_episode(fixture)\n731\t    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n732\t    monkeypatch.setattr(\n733\t        G,\n734\t        \"build_model_node_context\",\n735\t        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n736\t    )\n737\t    compiled = G.build_curriculum_factory_graph(\n738\t        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n739\t    )\n740\t\n741\t    trace: list[str] = []\n742\t    updates: list[tuple[str, dict[str, Any]]] = []\n743\t    deferred_frontier: str | None = None\n744\t    try:\n745\t        for chunk in compiled.stream(\n746\t            {\"invocation\": envelope},\n747\t            config=invocation.config,\n748\t            stream_mode=\"updates\",\n749\t            context=context,\n750\t        ):\n751\t            for node_id, update in chunk.items():\n752\t                trace.append(node_id)\n753\t                updates.append((node_id, dict(update or {})))\n754\t                if interrupt_after is not None and node_id == interrupt_after:\n755\t                    context.signal_token.trip()\n756\t    except KeyError as error:\n757\t        # A guard resolved a destination whose node body does not exist yet.\n758\t        # That is a *declared* deferred edge, not a defect, so it is recorded as\n759\t        # the episode's frontier — but only if it really is one of the declared\n760\t        # rows, so an undeclared missing destination still fails loudly.\n761\t        missing = error.args[0] if error.args else None\n762\t        declared = {row[2] for row in U.DEFERRED_EDGES}\n763\t        if missing not in declared:\n764\t            raise\n765\t        deferred_frontier = str(missing)\n766\t    lock.release()\n767\t    return {\n768\t        \"trace\": trace,\n769\t        \"updates\": updates,\n770\t        \"deferred_frontier\": deferred_frontier,\n771\t        \"state\": compiled.get_state(invocation.config).values,\n772\t        \"context\": context,\n773\t        \"invocation\": invocation,\n774\t        \"compiled\": compiled,\n775\t    }\n776\t\n777\t\n778\t# ---------------------------------------------------------------------------\n779\t# Registered unit topology (spec 8.1 / 8.2)\n780\t# ---------------------------------------------------------------------------\n781\t\n782\t\n783\tdef test_the_compiled_graph_registers_every_declared_unit_branch(topology, compiled) -> None:\n784\t    \"\"\"Each conditional edge exists with exactly the destinations that exist.\n785\t\n786\t    `available` here is the real compiled graph's own node set, not\n787\t    `binding_inventory()`: the latter is deliberately narrow (it names only what\n788\t    this generation is allowed to bind), while this test's real job is a\n789\t    self-consistency check against whatever the production compile point\n790\t    actually wired — so it has to stay correct both before and after a later\n791\t    generation widens the set of nodes that have real bodies.\n792\t    \"\"\"\n793\t\n794\t    graph_nodes = set(compiled.get_graph().nodes)\n795\t    registered: dict[str, set[str]] = {}\n796\t    for source, target, conditional in topology[\"edges\"]:\n797\t        if conditional:\n798\t            registered.setdefault(source, set()).add(target)\n799\t\n800\t    for source, _guard in U.UNIT_BRANCHES:\n801\t        expected = set(U.branch_destinations(source, graph_nodes))\n802\t        assert expected, f\"{source} has no registerable destination\"\n803\t        assert registered.get(source) == expected, source\n804\t\n805\t\n806\tdef test_the_two_map_reduce_return_edges_are_normal_edges(topology) -> None:\n807\t    \"\"\"Spec 8.2 names these exactly: `add_edge(worker, barrier)`, not a branch.\n808\t\n809\t    Registering the worker's return conditionally would let the worker's own\n810\t    result decide where the map/reduce goes, which is the barrier's authority.\n811\t    \"\"\"\n812\t\n813\t    normal = {(source, target) for source, target, conditional in topology[\"edges\"] if not conditional}\n814\t    for edge in U.UNIT_NORMAL_EDGES:\n815\t        assert edge in normal, edge\n816\t    assert (\"D11_CREATE_DETERMINISTIC_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\") in normal\n817\t    assert (\"M04_CREATE_UNIT_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\") in normal\n818\t\n819\t\n820\tdef test_the_unit_path_creates_no_second_graph_and_compiles_nothing() -> None:\n821\t    \"\"\"N30 is additive registration over N20's one builder.\"\"\"\n822\t\n823\t    source = UNIT_GRAPH_PY.read_text(encoding=\"utf-8\")\n824\t    tree = ast.parse(source)\n825\t    calls = [\n826\t        node.func.id if isinstance(node.func, ast.Name) else getattr(node.func, \"attr\", \"\")\n827\t        for node in ast.walk(tree)\n828\t        if isinstance(node, ast.Call)\n829\t    ]\n830\t    assert \"StateGraph\" not in calls\n831\t    assert \"compile\" not in calls\n832\t    assert \"add_node\" not in calls\n833\t\n834\t\n835\tdef test_a_node_body_authored_in_the_unit_path_module_is_refused() -> None:\n836\t    \"\"\"The D90/D91 gap cannot be closed by writing a wrapper in this module.\n837\t\n838\t    N20's `validate_bindings` restricts a production binding to the two owned\n839\t    node modules, so a callable authored here is rejected by stable ID. This is\n840\t    why blocking gap `plan26/n30/d90-d91-not-registrable` is owed to N23 and\n841\t    cannot be absorbed as coordination.\n842\t    \"\"\"\n843\t\n844\t    def D90_RESERVE_MODEL_ATTEMPT(state: Any, context: Any) -> dict[str, Any]:\n845\t        return {}\n846\t\n847\t    D90_RESERVE_MODEL_ATTEMPT.__module__ = \"runtime.langgraph_factory.unit_graph\"\n848\t    bindings = dict(G.binding_inventory())\n849\t    bindings[\"D90_RESERVE_MODEL_ATTEMPT\"] = D90_RESERVE_MODEL_ATTEMPT\n850\t\n851\t    with pytest.raises(G.GraphBindingError) as error:\n852\t        G.validate_bindings(bindings, required=(\"D90_RESERVE_MODEL_ATTEMPT\",))\n853\t    assert \"N20-BIND-PLACEHOLDER\" in str(error.value)\n854\t\n855\t\n856\tdef test_deferred_edges_are_exactly_the_destinations_with_no_node_body(available) -> None:\n857\t    \"\"\"Silence about an unwireable edge is how a topology gap becomes a halt.\"\"\"\n858\t\n859\t    observed: set[tuple[str, str]] = set()\n860\t    for source, _guard in U.UNIT_BRANCHES:\n861\t        for destination in U.deferred_destinations(source, available):\n862\t            observed.add((source, destination))\n863\t    declared = {(source, destination) for source, _value, destination, _owner in U.DEFERRED_EDGES}\n864\t    assert observed == declared\n865\t\n866\t\n867\tdef test_every_deferred_edge_names_a_real_owning_graph_node() -> None:\n868\t    owners = {owner for _s, _v, _d, owner in U.DEFERRED_EDGES}\n869\t    assert owners <= {\"N23_MODEL_NODES\", \"N31_REPAIR_ACCEPTANCE\", \"N32_WORKBOOK_TERMINALS\"}\n870\t    for _source, value, destination, owner in U.DEFERRED_EDGES:\n871\t        assert value and destination and owner\n872\t\n873\t\n874\tdef test_registering_an_undeclared_deferred_destination_fails(monkeypatch, available) -> None:\n875\t    \"\"\"A future unwireable destination must be declared, not silently dropped.\"\"\"\n876\t\n877\t    monkeypatch.setattr(U, \"DEFERRED_EDGES\", U.DEFERRED_EDGES[1:])\n878\t\n879\t    class _Builder:\n880\t        def add_edge(self, *args: Any) -> None:\n881\t            pass\n882\t\n883\t        def add_conditional_edges(self, *args: Any) -> None:\n884\t            pass\n885\t\n886\t    with pytest.raises(U.UnitTopologyError) as error:\n887\t        U.register_unit_path(_Builder(), available)\n888\t    assert \"N30-EDGE-UNDECLARED\" in str(error.value)\n889\t\n890\t\n891\tdef test_no_model_node_can_be_a_resume_reentry_destination(topology) -> None:\n892\t    \"\"\"Spec 6.2 D92: a model node as stored destination is a system failure.\"\"\"\n893\t\n894\t    assert not set(U.RESUME_REENTRY_DESTINATIONS) & MODEL_NODE_IDS\n895\t    reentry = {\n896\t        target\n897\t        for source, target, conditional in topology[\"edges\"]\n898\t        if source == \"D92_REENTER_VALIDATED_FRONTIER\" and conditional\n899\t    }\n900\t    assert not reentry & MODEL_NODE_IDS\n901\t    assert set(U.RESUME_REENTRY_DESTINATIONS) <= reentry\n902\t\n903\t\n904\tdef test_a_stored_model_frontier_is_refused_by_the_reentry_guard() -> None:\n905\t    state = {\n906\t        \"pending_guard\": {\n907\t            \"node\": \"D92_REENTER_VALIDATED_FRONTIER\",\n908\t            \"value\": \"deterministic_reentry\",\n909\t            \"detail\": {\"destination\": \"M03_WRITE_UNIT_CONTENT\"},\n910\t        }\n911\t    }\n912\t    with pytest.raises(R.RoutingViolation):\n913\t        R.route_frontier_reentry(state)\n914\t\n915\t\n916\tdef test_the_unit_path_names_no_unit_id_and_no_manifest_length() -> None:\n917\t    \"\"\"Spec 8.2: the builder never creates a node per known unit.\"\"\"\n918\t\n919\t    source = UNIT_GRAPH_PY.read_text(encoding=\"utf-8\")"}]},"parent_tool_use_id":null,"session_id":"e29286fb-f991-47f0-8e19-a325c46ee82a","uuid":"f59ce850-62ed-442f-ba09-7b02cdce3065","timestamp":"2026-08-12T20:59:03.282Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N30_UNIT_GRAPH/attempt-20260812T205813.582887Z-e473c586b2/repo/tests/runtime/test_plan26_unit_graph.py","content":"        \"requested_unit_id\": requested,\n        \"authorization\": {\"scope\": \"test\", \"executables\": []},\n        \"episode_ordinal\": 1,\n        \"prior_identity\": None,\n        \"prior_terminal\": None,\n        \"lease_open\": False,\n    }\n    # D03 requires the authorization to name this run's frozen digest, which the\n    # CLI computes before invocation; D01 is the one function that derives it.\n    probe = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    digest = inputs.D01_VALIDATE_AND_FREEZE_INPUTS({\"invocation\": envelope}, probe)[\"frozen_digest\"]\n    envelope[\"authorization\"] = {\n        \"scope\": \"test\",\n        \"executables\": [],\n        \"curriculum_digest\": digest,\n    }\n    return lock, invocation, envelope\n\n\ndef _run_episode(\n    monkeypatch: Any,\n    fixture: dict[str, Any],\n    *,\n    interrupt_after: str | None = None,\n) -> dict[str, Any]:\n    \"\"\"Execute one real episode of the real compiled graph, end to end.\n\n    Returns the ordered node trace, the per-node updates, and the final state.\n    \"\"\"\n\n    lock, invocation, envelope = _prepare_episode(fixture)\n    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    monkeypatch.setattr(\n        G,\n        \"build_model_node_context\",\n        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n    )\n    compiled = G.build_curriculum_factory_graph(\n        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n    )\n\n    trace: list[str] = []\n    updates: list[tuple[str, dict[str, Any]]] = []\n    deferred_frontier: str | None = None\n    try:\n        for chunk in compiled.stream(\n            {\"invocation\": envelope},\n            config=invocation.config,\n            stream_mode=\"updates\",\n            context=context,\n        ):\n            for node_id, update in chunk.items():\n                trace.append(node_id)\n                updates.append((node_id, dict(update or {})))\n                if interrupt_after is not None and node_id == interrupt_after:\n                    context.signal_token.trip()\n    except KeyError as error:\n        # A guard resolved a destination whose node body does not exist yet.\n        # That is a *declared* deferred edge, not a defect, so it is recorded as\n        # the episode's frontier — but only if it really is one of the declared\n        # rows, so an undeclared missing destination still fails loudly.\n        missing = error.args[0] if error.args else None\n        declared = {row[2] for row in U.DEFERRED_EDGES}\n        if missing not in declared:\n            raise\n        deferred_frontier = str(missing)\n    lock.release()\n    return {\n        \"trace\": trace,\n        \"updates\": updates,\n        \"deferred_frontier\": deferred_frontier,\n        \"state\": compiled.get_state(invocation.config).values,\n        \"context\": context,\n        \"invocation\": invocation,\n        \"compiled\": compiled,\n    }\n\n\n# ---------------------------------------------------------------------------\n# Registered unit topology (spec 8.1 / 8.2)\n# ---------------------------------------------------------------------------\n\n\ndef test_the_compiled_graph_registers_every_declared_unit_branch(topology, compiled) -> None:\n    \"\"\"Each conditional edge exists with exactly the destinations that exist.\n\n    `available` here is the real compiled graph's own node set, not\n    `binding_inventory()`: the latter is deliberately narrow (it names only what\n    this generation is allowed to bind), while this test's real job is a\n    self-consistency check against whatever the production compile point\n    actually wired — so it has to stay correct both before and after a later\n    generation widens the set of nodes that have real bodies.\n    \"\"\"\n\n    graph_nodes = set(compiled.get_graph().nodes)\n    registered: dict[str, set[str]] = {}\n    for source, target, conditional in topology[\"edges\"]:\n        if conditional:\n            registered.setdefault(source, set()).add(target)\n\n    for source, _guard in U.UNIT_BRANCHES:\n        expected = set(U.branch_destinations(source, graph_nodes))\n        assert expected, f\"{source} has no registerable destination\"\n        assert registered.get(source) == expected, source\n\n\ndef test_the_two_map_reduce_return_edges_are_normal_edges(topology) -> None:\n    \"\"\"Spec 8.2 names these exactly: `add_edge(worker, barrier)`, not a branch.\n\n    Registering the worker's return conditionally would let the worker's own\n    result decide where the map/reduce goes, which is the barrier's authority.\n    \"\"\"\n\n    normal = {(source, target) for source, target, conditional in topology[\"edges\"] if not conditional}\n    for edge in U.UNIT_NORMAL_EDGES:\n        assert edge in normal, edge\n    assert (\"D11_CREATE_DETERMINISTIC_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\") in normal\n    assert (\"M04_CREATE_UNIT_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\") in normal\n\n\ndef test_the_unit_path_creates_no_second_graph_and_compiles_nothing() -> None:\n    \"\"\"N30 is additive registration over N20's one builder.\"\"\"\n\n    source = UNIT_GRAPH_PY.read_text(encoding=\"utf-8\")\n    tree = ast.parse(source)\n    calls = [\n        node.func.id if isinstance(node.func, ast.Name) else getattr(node.func, \"attr\", \"\")\n        for node in ast.walk(tree)\n        if isinstance(node, ast.Call)\n    ]\n    assert \"StateGraph\" not in calls\n    assert \"compile\" not in calls\n    assert \"add_node\" not in calls\n\n\ndef test_a_node_body_authored_in_the_unit_path_module_is_refused() -> None:\n    \"\"\"The D90/D91 gap cannot be closed by writing a wrapper in this module.\n\n    N20's `validate_bindings` restricts a production binding to the two owned\n    node modules, so a callable authored here is rejected by stable ID. This is\n    why blocking gap `plan26/n30/d90-d91-not-registrable` is owed to N23 and\n    cannot be absorbed as coordination.\n    \"\"\"\n\n    def D90_RESERVE_MODEL_ATTEMPT(state: Any, context: Any) -> dict[str, Any]:\n        return {}\n\n    D90_RESERVE_MODEL_ATTEMPT.__module__ = \"runtime.langgraph_factory.unit_graph\"\n    bindings = dict(G.binding_inventory())\n    bindings[\"D90_RESERVE_MODEL_ATTEMPT\"] = D90_RESERVE_MODEL_ATTEMPT\n\n    with pytest.raises(G.GraphBindingError) as error:\n        G.validate_bindings(bindings, required=(\"D90_RESERVE_MODEL_ATTEMPT\",))\n    assert \"N20-BIND-PLACEHOLDER\" in str(error.value)\n\n\ndef test_deferred_edges_are_exactly_the_destinations_with_no_node_body(available) -> None:\n    \"\"\"Silence about an unwireable edge is how a topology gap becomes a halt.\"\"\"\n\n    observed: set[tuple[str, str]] = set()\n    for source, _guard in U.UNIT_BRANCHES:\n        for destination in U.deferred_destinations(source, available):\n            observed.add((source, destination))\n    declared = {(source, destination) for source, _value, destination, _owner in U.DEFERRED_EDGES}\n    assert observed == declared\n\n\ndef test_every_deferred_edge_names_a_real_owning_graph_node() -> None:\n    owners = {owner for _s, _v, _d, owner in U.DEFERRED_EDGES}\n    assert owners <= {\"N23_MODEL_NODES\", \"N31_REPAIR_ACCEPTANCE\", \"N32_WORKBOOK_TERMINALS\"}\n    for _source, value, destination, owner in U.DEFERRED_EDGES:\n        assert value and destination and owner\n\n\ndef test_registering_an_undeclared_deferred_destination_fails(monkeypatch, available) -> None:\n    \"\"\"A future unwireable destination must be declared, not silently dropped.\"\"\"\n\n    monkeypatch.setattr(U, \"DEFERRED_EDGES\", U.DEFERRED_EDGES[1:])\n\n    class _Builder:\n        def add_edge(self, *args: Any) -> None:\n            pass\n\n        def add_conditional_edges(self, *args: Any) -> None:\n            pass\n\n    with pytest.raises(U.UnitTopologyError) as error:\n        U.register_unit_path(_Builder(), available)\n    assert \"N30-EDGE-UNDECLARED\" in str(error.value)\n\n\ndef test_no_model_node_can_be_a_resume_reentry_destination(topology) -> None:\n    \"\"\"Spec 6.2 D92: a model node as stored destination is a system failure.\"\"\"\n\n    assert not set(U.RESUME_REENTRY_DESTINATIONS) & MODEL_NODE_IDS\n    reentry = {\n        target\n        for source, target, conditional in topology[\"edges\"]\n        if source == \"D92_REENTER_VALIDATED_FRONTIER\" and conditional\n    }\n    assert not reentry & MODEL_NODE_IDS\n    assert set(U.RESUME_REENTRY_DESTINATIONS) <= reentry\n\n\ndef test_a_stored_model_frontier_is_refused_by_the_reentry_guard() -> None:\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D92_REENTER_VALIDATED_FRONTIER\",\n            \"value\": \"deterministic_reentry\",\n            \"detail\": {\"destination\": \"M03_WRITE_UNIT_CONTENT\"},\n        }\n    }\n    with pytest.raises(R.RoutingViolation):\n        R.route_frontier_reentry(state)\n\n\ndef test_the_unit_path_names_no_unit_id_and_no_manifest_length() -> None:\n    \"\"\"Spec 8.2: the builder never creates a node per known unit.\"\"\"\n\n    source = UNIT_GRAPH_PY.read_text(encoding=\"utf-8\")","numLines":220,"startLine":700,"totalLines":2641}}}
