{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BGpmpbA9jPQGTu1mNuWTGS","type":"tool_result","content":"2570\t\n2571\t    required = (\n2572\t        \"prove_capability\",\n2573\t        \"observe_executable\",\n2574\t        \"render_unit\",\n2575\t        \"inspect_pages\",\n2576\t        \"render_deterministic_visual\",\n2577\t    )\n2578\t    missing = [name for name in required if not callable(getattr(mn.tp.CliTransport, name, None))]\n2579\t    assert missing == []\n2580\t\n2581\t\n2582\tdef test_this_nodes_renderers_are_a_test_double_and_not_exposed_to_n13s_store_gap(\n2583\t    tmp_path: Path, monkeypatch\n2584\t) -> None:\n2585\t    \"\"\"N13 generation 2 raised two gaps this node must state a position on.\n2586\t\n2587\t    `plan26/n13/artifact-bodies-never-reach-the-store`: no deterministic node\n2588\t    calls `ArtifactStore.admit_version`, so D08/D09/D12 advance heads in graph\n2589\t    state only and nothing writes the admitted *bytes*. A production\n2590\t    `CliTransport.render_unit`, which is handed head hashes and must resolve the\n2591\t    bodies out of the content store, therefore raises `RenderFault`.\n2592\t    `plan26/n13/visual-assets-are-unreachable-from-d13`: D13 passes no asset map,\n2593\t    so a production unit PDF is prose-only.\n2594\t\n2595\t    Neither is inherited by this node's proof, and that is checked rather than\n2596\t    assumed: the harness `transport_registry` is a test double that composes its\n2597\t    own bytes from the arguments it is handed and never reads the store, so the\n2598\t    graph-orchestration claims here hold with or without the store gap. Both\n2599\t    findings are real and both are N22/N31/N32/N40's to close before a live run.\n2600\t    \"\"\"\n2601\t\n2602\t    # The gap N13 named is real and still open: nothing in `nodes/` persists bodies.\n2603\t    from runtime.langgraph_factory import artifacts as A\n2604\t\n2605\t    assert hasattr(A.ArtifactStore, \"admit_version\")\n2606\t    nodes_dir = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"nodes\"\n2607\t    callers = [\n2608\t        path.name\n2609\t        for path in sorted(nodes_dir.glob(\"*.py\"))\n2610\t        if \"admit_version\" in path.read_text(encoding=\"utf-8\")\n2611\t    ]\n2612\t    assert callers == [], f\"{callers} now persists artifact bodies; revisit this note\"\n2613\t\n2614\t    # This node's renderers do not depend on it: no method of the harness registry\n2615\t    # names the store, the path guard, or the output root.\n2616\t    source = inspect.getsource(_StubRegistry)\n2617\t    for forbidden in (\"ArtifactStore\", \"admit_version\", \"path_guard\", \"output_root\"):\n2618\t        assert forbidden not in source\n2619\t\n2620\t    # And the episode really renders, inspects and admits without a single blob.\n2621\t    fixture = _build_episode_fixture(tmp_path)\n2622\t    result = _run_episode(monkeypatch, fixture)\n2623\t    store_root = fixture[\"output_root\"]\n2624\t    blobs = [path for path in store_root.rglob(\"*\") if path.is_file() and \"artifact\" in str(path)]\n2625\t    assert blobs == [], blobs\n2626\t    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n2627\t    assert result[\"state\"][\"unit_page_inventories\"][0][\"result\"] == \"PASS\"\n2628\t\n2629\t\n2630\tdef test_blocked_the_review_handoff_to_n31_is_declared_not_wired(available) -> None:\n2631\t    \"\"\"A clean D16 is N31's handoff; D16 has no body, so the edge is declared.\n2632\t\n2633\t    This is the prompt's own frontier (\"clean D16 evidence is a handoff to\n2634\t    N31\"), recorded as a deferred edge rather than a fabricated destination.\n2635\t    \"\"\"\n2636\t\n2637\t    assert \"D16_REDUCE_UNIT_EVIDENCE\" not in available\n2638\t    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n2639\t            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES"}]},"parent_tool_use_id":null,"session_id":"e29286fb-f991-47f0-8e19-a325c46ee82a","uuid":"148295df-fc3a-4d3d-86fa-8c436f85a0c9","timestamp":"2026-08-12T21:00:25.572Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N30_UNIT_GRAPH/attempt-20260812T205813.582887Z-e473c586b2/repo/tests/runtime/test_plan26_unit_graph.py","content":"\n    required = (\n        \"prove_capability\",\n        \"observe_executable\",\n        \"render_unit\",\n        \"inspect_pages\",\n        \"render_deterministic_visual\",\n    )\n    missing = [name for name in required if not callable(getattr(mn.tp.CliTransport, name, None))]\n    assert missing == []\n\n\ndef test_this_nodes_renderers_are_a_test_double_and_not_exposed_to_n13s_store_gap(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"N13 generation 2 raised two gaps this node must state a position on.\n\n    `plan26/n13/artifact-bodies-never-reach-the-store`: no deterministic node\n    calls `ArtifactStore.admit_version`, so D08/D09/D12 advance heads in graph\n    state only and nothing writes the admitted *bytes*. A production\n    `CliTransport.render_unit`, which is handed head hashes and must resolve the\n    bodies out of the content store, therefore raises `RenderFault`.\n    `plan26/n13/visual-assets-are-unreachable-from-d13`: D13 passes no asset map,\n    so a production unit PDF is prose-only.\n\n    Neither is inherited by this node's proof, and that is checked rather than\n    assumed: the harness `transport_registry` is a test double that composes its\n    own bytes from the arguments it is handed and never reads the store, so the\n    graph-orchestration claims here hold with or without the store gap. Both\n    findings are real and both are N22/N31/N32/N40's to close before a live run.\n    \"\"\"\n\n    # The gap N13 named is real and still open: nothing in `nodes/` persists bodies.\n    from runtime.langgraph_factory import artifacts as A\n\n    assert hasattr(A.ArtifactStore, \"admit_version\")\n    nodes_dir = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"nodes\"\n    callers = [\n        path.name\n        for path in sorted(nodes_dir.glob(\"*.py\"))\n        if \"admit_version\" in path.read_text(encoding=\"utf-8\")\n    ]\n    assert callers == [], f\"{callers} now persists artifact bodies; revisit this note\"\n\n    # This node's renderers do not depend on it: no method of the harness registry\n    # names the store, the path guard, or the output root.\n    source = inspect.getsource(_StubRegistry)\n    for forbidden in (\"ArtifactStore\", \"admit_version\", \"path_guard\", \"output_root\"):\n        assert forbidden not in source\n\n    # And the episode really renders, inspects and admits without a single blob.\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    store_root = fixture[\"output_root\"]\n    blobs = [path for path in store_root.rglob(\"*\") if path.is_file() and \"artifact\" in str(path)]\n    assert blobs == [], blobs\n    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n    assert result[\"state\"][\"unit_page_inventories\"][0][\"result\"] == \"PASS\"\n\n\ndef test_blocked_the_review_handoff_to_n31_is_declared_not_wired(available) -> None:\n    \"\"\"A clean D16 is N31's handoff; D16 has no body, so the edge is declared.\n\n    This is the prompt's own frontier (\"clean D16 evidence is a handoff to\n    N31\"), recorded as a deferred edge rather than a fabricated destination.\n    \"\"\"\n\n    assert \"D16_REDUCE_UNIT_EVIDENCE\" not in available\n    assert (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\", \"D16_REDUCE_UNIT_EVIDENCE\",\n            \"N31_REPAIR_ACCEPTANCE\") in U.DEFERRED_EDGES","numLines":70,"startLine":2570,"totalLines":2641}}}
