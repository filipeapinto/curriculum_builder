{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UqjGCYBFxUe4fkaeLSy8t1","type":"tool_result","content":"1665\t    assert review_record[\"unit_pdf_sha256\"] == packet[\"pdf_sha256\"]\n1666\t    assert review_record[\"page_count\"] == packet[\"page_count\"]\n1667\t    findings = review_record[\"payload\"][\"page_findings\"]\n1668\t    assert [entry[\"page_number\"] for entry in findings] == [1, 2]\n1669\t    assert [entry[\"page_sha256\"] for entry in findings] == [\n1670\t        record[\"page_sha256\"] for record in inspections\n1671\t    ]\n1672\t\n1673\t    # And the review is a candidate, not an admission: no head moved for it.\n1674\t    assert review_record[\"pre_admission\"] is True\n1675\t    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n1676\t\n1677\t\n1678\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1679\t    tmp_path: Path, monkeypatch\n1680\t) -> None:\n1681\t    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n1682\t\n1683\t    The whole unit path now executes and M05 returns a real independent review.\n1684\t    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n1685\t    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n1686\t    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n1687\t    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n1688\t    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n1689\t    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n1690\t    F1). The frontier is derived from the episode's own trace rather than pinned\n1691\t    to today's row, so this keeps proving \"no fabricated destination\" rather than\n1692\t    just \"today's specific one.\"\n1693\t    \"\"\"\n1694\t\n1695\t    fixture = _build_episode_fixture(tmp_path)\n1696\t    result = _run_episode(monkeypatch, fixture)\n1697\t\n1698\t    expected_frontier = _expected_deferred_frontier(result[\"trace\"])\n1699\t    assert expected_frontier is not None\n1700\t    assert result[\"deferred_frontier\"] == expected_frontier\n1701\t    matching = [row for row in U.DEFERRED_EDGES if row[2] == expected_frontier]\n1702\t    assert len(matching) == 1\n1703\t    assert matching[0][0] == result[\"trace\"][-1]\n1704\t"}]},"parent_tool_use_id":null,"session_id":"e29286fb-f991-47f0-8e19-a325c46ee82a","uuid":"505a25e9-814a-4c74-8628-f693bddf59f5","timestamp":"2026-08-12T21:05:13.794Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N30_UNIT_GRAPH/attempt-20260812T205813.582887Z-e473c586b2/repo/tests/runtime/test_plan26_unit_graph.py","content":"    assert review_record[\"unit_pdf_sha256\"] == packet[\"pdf_sha256\"]\n    assert review_record[\"page_count\"] == packet[\"page_count\"]\n    findings = review_record[\"payload\"][\"page_findings\"]\n    assert [entry[\"page_number\"] for entry in findings] == [1, 2]\n    assert [entry[\"page_sha256\"] for entry in findings] == [\n        record[\"page_sha256\"] for record in inspections\n    ]\n\n    # And the review is a candidate, not an admission: no head moved for it.\n    assert review_record[\"pre_admission\"] is True\n    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n\n\ndef test_the_committed_path_stops_at_a_declared_deferred_edge(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n\n    The whole unit path now executes and M05 returns a real independent review.\n    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n    F1). The frontier is derived from the episode's own trace rather than pinned\n    to today's row, so this keeps proving \"no fabricated destination\" rather than\n    just \"today's specific one.\"\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    expected_frontier = _expected_deferred_frontier(result[\"trace\"])\n    assert expected_frontier is not None\n    assert result[\"deferred_frontier\"] == expected_frontier\n    matching = [row for row in U.DEFERRED_EDGES if row[2] == expected_frontier]\n    assert len(matching) == 1\n    assert matching[0][0] == result[\"trace\"][-1]\n","numLines":40,"startLine":1665,"totalLines":2700}}}
