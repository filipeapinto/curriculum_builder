 try:\n303\t            results: dict[str, dict[str, Any]] = {}\n304\t            missing: list[str] = []\n305\t            for capability in REQUIRED_CAPABILITIES:\n306\t                proof = transport.prove_capability(capability)\n307\t                results[capability] = proof\n308\t                if proof.get(\"result\") != \"PASS\":\n309\t                    missing.append(capability)\n310\t        finally:\n311\t            guard.uninstall()\n312\t    return results, missing\n313\t\n314\t\n315\t# --------------------------------------------------------------------------- preflight\n316\t\n317\t\n318\tdef _run_preflight(engine_root: Path, curriculum_root: Path, output_root: Path) -> tuple[dict[str, Any], int]:\n319\t    collision = _collision_reason(output_root)\n320\t    capabilities, missing = _preflight_capabilities()\n321\t    ready = collision is None and not missing\n322\t    payload: dict[str, Any] = {\n323\t        \"contract_version\": CONTRACT_VERSION,\n324\t        \"kind\": \"PREFLIGHT\",\n325\t        \"ready\": ready,\n326\t        \"engine_root\": str(engine_root),\n327\t        \"curriculum_root\": str(curriculum_root),\n328\t        \"output_root\": str(output_root),\n329\t        \"capabilities\": capabilities,\n330\t        \"missing_capabilities\": missing,\n331\t        \"collision\": collision,\n332\t    }\n333\t    return payload, (0 if ready else NOT_READY_EXIT)\n334\t\n335\t\n336\t# --------------------------------------------------------------------------- live invocation\n337\t\n338\t\n339\tdef _acquire_lock(output_root: Path) -> P.ExecutionLock:\n340\t    lock = P.ExecutionLock(output_root)\n341\t    try:\n342\t        lock.acquire()\n343\t    except P.ExecutionLockUnavailable as error:\n344\t        raise CliNotReadyError(\"LOCK-UNAVAILABLE\", str(error)) from error\n345\t    return lock\n346\t\n347\t\n348\tdef _prepare_fresh(\n349\t    *, engine_root: Path, curriculum_root: Path, output_root: Path, mode: str, requested_unit_id: