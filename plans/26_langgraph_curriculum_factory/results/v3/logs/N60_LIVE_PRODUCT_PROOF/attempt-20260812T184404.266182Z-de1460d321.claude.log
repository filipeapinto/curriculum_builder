{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MuprtgmACa5UgSNbUpbNqN","type":"tool_result","content":"1\t\"\"\"Episode bootstrap, identity freeze, effective run, capability, and resume nodes.\n2\t\n3\tOwns D00, D00R, D01, D02, D03, D04, D92, and D96. These are the nodes that\n4\tdecide what run this is, what it is allowed to build, and whether it may build\n5\tanything at all. None of them produces curriculum content.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport re\n11\tfrom pathlib import Path\n12\tfrom typing import Any\n13\t\n14\timport yaml\n15\t\n16\tfrom . import (\n17\t    PrerequisitePause,\n18\t    SystemFailure,\n19\t    canonical_digest,\n20\t    deterministic_node,\n21\t    guard,\n22\t    require,\n23\t)\n24\t\n25\t__all__ = [\n26\t    \"BOOTSTRAP_KINDS\",\n27\t    \"RESUMABLE_TERMINAL_KINDS\",\n28\t    \"RUN_MODES\",\n29\t    \"REQUIRED_CAPABILITIES\",\n30\t    \"EPISODE_INVOCATION_FIELDS\",\n31\t    \"compile_prerequisite_closure\",\n32\t    \"manifest_unit_records\",\n33\t    \"D00_BOOTSTRAP_EPISODE\",\n34\t    \"D00R_REVALIDATE_RESUME_IDENTITY\",\n35\t    \"D01_VALIDATE_AND_FREEZE_INPUTS\",\n36\t    \"D02_COMPILE_EFFECTIVE_RUN\",\n37\t    \"D03_PROVE_CAPABILITIES\",\n38\t    \"D04_INITIALIZE_OR_RESUME\",\n39\t    \"D92_REENTER_VALIDATED_FRONTIER\",\n40\t    \"D96_GRACEFUL_INTERRUPT_GATE\",\n41\t]\n42\t\n43\t\n44\tBOOTSTRAP_KINDS: tuple[str, ...] = (\"fresh\", \"resume\", \"recover_orphan\")\n45\t\n46\t# Spec section 14's `Resume` column: only these two terminals may legally be\n47\t# resumed. Everything else is a final episode outcome.\n48\tRESUMABLE_TERMINAL_KINDS: tuple[str, ...] = (\"INTERRUPTED\", \"PAUSED_PREREQUISITE\")\n49\t\n50\tRUN_MODES: tuple[str, ...] = (\"one\", \"all\")\n51\t\n52\tREQUIRED_CAPABILITIES: tuple[str, ...] = (\n53\t    \"model_cli_identity\",\n54\t    \"retrieval\",\n55\t    \"renderer\",\n56\t    \"rasterizer\",\n57\t    \"persistence\",\n58\t    \"logger\",\n59\t)\n60\t\n61\t# The envelope the pre-invocation helper supplies as `FactoryInput[\"invocation\"]`.\n62\t# D00 is the only node that reads it raw; every later node reads frozen state.\n63\tEPISODE_INVOCATION_FIELDS: tuple[str, ...] = (\n64\t    \"kind\",\n65\t    \"contract_version\",\n66\t    \"engine_root\",\n67\t    \"curriculum_root\",\n68\t    \"output_root\",\n69\t    \"mode\",\n70\t    \"requested_unit_id\",\n71\t    \"authorization\",\n72\t    \"episode_ordinal\",\n73\t    \"prior_identity\",\n74\t    \"prior_terminal\",\n75\t    \"lease_open\",\n76\t)\n77\t\n78\t_MANIFEST_UNITS_KEY = \"labs\"\n79\t_UNIT_ID_KEY = \"id\"\n80\t\n81\t\n82\tdef _record(value: Any, label: str) -> dict[str, Any]:\n83\t    require(isinstance(value, dict), \"schema_contract\", f\"{label} must be a JSON object\")\n84\t    return dict(value)\n85\t\n86\t\n87\tdef _text(value: Any, label: str) -> str:\n88\t    require(\n89\t        isinstance(value, str) and value.strip() != \"\",\n90\t        \"schema_contract\",\n91\t        f\"{label} must be a non-empty string\",\n92\t    )\n93\t    return value\n94\t\n95\t\n96\tdef _canonical_path(value: Any, label: str) -> Path:\n97\t    \"\"\"Canonicalize an absolute path, rejecting relative traversal segments.\n98\t\n99\t    Symlinked parents are resolved rather than rejected (macOS `/var` is one),\n100\t    but a `..` segment is refused outright: it is the form a containment escape\n101\t    takes, and resolving it silently would hide where the run actually points.\n102\t    \"\"\"\n103\t\n104\t    path = Path(_text(value, label))\n105\t    require(path.is_absolute(), \"invalid_input\", f\"{label} must be an absolute path\", value=str(path))\n106\t    require(\n107\t        \"..\" not in path.parts,\n108\t        \"invalid_input\",\n109\t        f\"{label} must not contain a relative traversal segment\",\n110\t        value=str(path),\n111\t    )\n112\t    return path.resolve()\n113\t\n114\t\n115\tdef _sha256_file(path: Path) -> str:\n116\t    import hashlib\n117\t\n118\t    digest = hashlib.sha256()\n119\t    with path.open(\"rb\") as handle:\n120\t        for block in iter(lambda: handle.read(1 << 20), b\"\"):\n121\t            digest.update(block)\n122\t    return digest.hexdigest()\n123\t\n124\t\n125\tdef _now(runtime_context: Any) -> str:\n126\t    clock = getattr(runtime_context, \"clock\", None)\n127\t    require(callable(clock), \"capability\", \"runtime context exposes no clock\")\n128\t    return str(clock())\n129\t\n130\t\n131\t# --------------------------------------------------------------------------\n132\t# D00\n133\t# --------------------------------------------------------------------------\n134\t\n135\t\n136\t@deterministic_node(\"D00_BOOTSTRAP_EPISODE\")\n137\tdef D00_BOOTSTRAP_EPISODE(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n138\t    \"\"\"Classify this episode as fresh, legal resume, or orphan recovery.\"\"\"\n139\t\n140\t    invocation = projection[\"invocation\"]\n141\t    require(invocation is not None, \"invalid_input\", \"no episode invocation was supplied\")\n142\t    envelope = _record(invocation, \"invocation\")\n143\t\n144\t    unknown = sorted(set(envelope) - set(EPISODE_INVOCATION_FIELDS))\n145\t    require(\n146\t        not unknown,\n147\t        \"schema_contract\",\n148\t        \"invocation envelope declares undeclared fields\",\n149\t        unknown=unknown,\n150\t    )\n151\t\n152\t    kind = envelope.get(\"kind\")\n153\t    require(\n154\t        kind in BOOTSTRAP_KINDS,\n155\t        \"invalid_input\",\n156\t        f\"invocation kind {kind!r} is not one of {list(BOOTSTRAP_KINDS)}\",\n157\t    )\n158\t\n159\t    prior_identity_present = bool(projection[\"run_id\"]) or bool(envelope.get(\"prior_identity\"))\n160\t    prior_terminal = envelope.get(\"prior_terminal\") or projection[\"terminal\"]\n161\t    lease_open = bool(envelope.get(\"lease_open\"))\n162\t\n163\t    if kind == \"fresh\":\n164\t        require(\n165\t            not prior_identity_present,\n166\t            \"identity\",\n167\t            \"a fresh invocation cannot start against an existing run identity\",\n168\t        )\n169\t        require(\n170\t            not lease_open,\n171\t            \"identity\",\n172\t            \"a fresh invocation cannot start while a prior episode lease is open\",\n173\t        )\n174\t        classification = \"fresh\"\n175\t    elif kind == \"resume\":\n176\t        require(\n177\t            prior_identity_present,\n178\t            \"identity\",\n179\t            \"a resume invocation requires a prior immutable run identity\",\n180\t        )\n181\t        require(\n182\t            isinstance(prior_terminal, dict),\n183\t            \"identity\",\n184\t            \"a resume invocation requires a prior terminal record\",\n185\t        )\n186\t        terminal_kind = prior_terminal.get(\"kind\")\n187\t        require(\n188\t            terminal_kind in RESUMABLE_TERMINAL_KINDS,\n189\t            \"identity\",\n190\t            f\"terminal {terminal_kind!r} is not legally resumable\",\n191\t            resumable=list(RESUMABLE_TERMINAL_KINDS),\n192\t        )\n193\t        classification = \"resume\"\n194\t    else:\n195\t        require(\n196\t            prior_identity_present,\n197\t            \"identity\",\n198\t            \"orphan recovery requires a prior immutable run identity\",\n199\t        )\n200\t        require(\n201\t            lease_open and prior_terminal is None,\n202\t            \"identity\",\n203\t            \"orphan recovery requires an open prior lease with no terminal\",\n204\t            lease_open=lease_open,\n205\t            has_terminal=prior_terminal is not None,\n206\t        )\n207\t        classification = \"recover_orphan\"\n208\t\n209\t    # The sanitized envelope is what every later node sees: the raw prior\n210\t    # terminal/lease summary is bootstrap-only evidence and is not carried\n211\t    # forward as if it were this episode's state.\n212\t    sanitized = {\n213\t        field: envelope.get(field)\n214\t        for field in EPISODE_INVOCATION_FIELDS\n215\t        if field not in (\"prior_terminal\", \"lease_open\")\n216\t    }\n217\t    sanitized[\"kind\"] = classification\n218\t\n219\t    return {\n220\t        \"bootstrap_kind\": classification,\n221\t        \"invocation\": sanitized,\n222\t        \"pending_guard\": guard(\"D00_BOOTSTRAP_EPISODE\", classification),\n223\t    }\n224\t\n225\t\n226\t# --------------------------------------------------------------------------\n227\t# D00R\n228\t# --------------------------------------------------------------------------\n229\t\n230\t\n231\t@deterministic_node(\"D00R_REVALIDATE_RESUME_IDENTITY\")\n232\tdef D00R_REVALIDATE_RESUME_IDENTITY(\n233\t    projection: dict[str, Any], runtime_context: Any\n234\t) -> dict[str, Any]:\n235\t    \"\"\"Prove the supplied resume identity equals the frozen prior identity exactly.\"\"\"\n236\t\n237\t    envelope = _record(projection[\"invocation\"], \"invocation\")\n238\t    comparisons: list[dict[str, Any]] = []\n239\t    mismatched: list[str] = []\n240\t\n241\t    supplied_by_field = {\n242\t        \"contract_version\": envelope.get(\"contract_version\"),\n243\t        \"engine_root\": envelope.get(\"engine_root\"),\n244\t        \"curriculum_root\": envelope.get(\"curriculum_root\"),\n245\t        \"output_root\": envelope.get(\"output_root\"),\n246\t        \"mode\": envelope.get(\"mode\"),\n247\t        \"requested_unit_id\": envelope.get(\"requested_unit_id\"),\n248\t    }\n249\t    for field, supplied in supplied_by_field.items():\n250\t        frozen = projection[field]\n251\t        equal = supplied == frozen\n252\t        comparisons.append({\"field\": field, \"frozen\": frozen, \"supplied\": supplied, \"equal\": equal})\n253\t        if not equal:\n254\t            mismatched.append(field)\n255\t\n256\t    frozen_inputs = projection[\"frozen_inputs\"]\n257\t    frozen_digest = projection[\"frozen_digest\"]\n258\t    recomputed = canonical_digest(frozen_inputs)\n259\t    digest_equal = recomputed == frozen_digest\n260\t    comparisons.append(\n261\t        {\n262\t            \"field\": \"frozen_digest\",\n263\t            \"frozen\": frozen_digest,\n264\t            \"supplied\": recomputed,\n265\t            \"equal\": digest_equal,\n266\t        }\n267\t    )\n268\t    if not digest_equal:\n269\t        mismatched.append(\"frozen_digest\")\n270\t\n271\t    # Every frozen input must still hash to its recorded value: a resume that\n272\t    # re-reads changed engine bytes is a different run wearing the same identity.\n273\t    drifted: list[dict[str, str]] = []\n274\t    for entry in frozen_inputs:\n275\t        record = _record(entry, \"frozen input\")\n276\t        path = Path(_text(record.get(\"path\"), \"frozen input path\"))\n277\t        expected = _text(record.get(\"sha256\"), \"frozen input sha256\")\n278\t        if not path.is_file():\n279\t            drifted.append({\"path\": str(path), \"expected\": expected, \"actual\": \"MISSING\"})\n280\t            continue\n281\t        actual = _sha256_file(path)\n282\t        if actual != expected:\n283\t            drifted.append({\"path\": str(path), \"expected\": expected, \"actual\": actual})\n284\t    if drifted:\n285\t        mismatched.append(\"frozen_inputs\")\n286\t\n287\t    supplied_authorization = envelope.get(\"authorization\")\n288\t    frozen_authorizations = projection[\"external_authorizations\"]\n289\t    authorization_equal = canonical_digest(supplied_authorization) == canonical_digest(\n290\t        frozen_authorizations\n291\t    )\n292\t    comparisons.append(\n293\t        {\n294\t            \"field\": \"external_authorizations\",\n295\t            \"frozen\": canonical_digest(frozen_authorizations),\n296\t            \"supplied\": canonical_digest(supplied_authorization),\n297\t            \"equal\": authorization_equal,\n298\t        }\n299\t    )\n300\t    if not authorization_equal:\n301\t        mismatched.append(\"external_authorizations\")\n302\t\n303\t    history = projection[\"terminal_history\"]\n304\t    last_terminal = history[-1] if history else None\n305\t    terminal_kind = last_terminal.get(\"kind\") if isinstance(last_terminal, dict) else None\n306\t    terminal_legal = terminal_kind in RESUMABLE_TERMINAL_KINDS\n307\t    comparisons.append(\n308\t        {\n309\t            \"field\": \"prior_terminal\",\n310\t            \"frozen\": terminal_kind,\n311\t            \"supplied\": terminal_kind,\n312\t            \"equal\": terminal_legal,\n313\t        }\n314\t    )\n315\t    if not terminal_legal:\n316\t        mismatched.append(\"prior_terminal\")\n317\t\n318\t    require(\n319\t        not mismatched,\n320\t        \"identity\",\n321\t        \"resume identity revalidation failed\",\n322\t        mismatched=sorted(set(mismatched)),\n323\t        drifted_inputs=drifted,\n324\t    )\n325\t\n326\t    receipt = {\n327\t        \"kind\": \"resume_identity_comparison\",\n328\t        \"run_id\": projection[\"run_id\"],\n329\t        \"comparisons\": comparisons,\n330\t        \"result\": \"PASS\",\n331\t    }\n332\t    receipt[\"key\"] = canonical_digest(receipt)\n333\t\n334\t    validated = {\n335\t        \"run_id\": projection[\"run_id\"],\n336\t        \"contract_version\": projection[\"contract_version\"],\n337\t        \"frozen_digest\": frozen_digest,\n338\t        \"mode\": projection[\"mode\"],\n339\t        \"requested_unit_id\": projection[\"requested_unit_id\"],\n340\t        \"engine_root\": projection[\"engine_root\"],\n341\t        \"curriculum_root\": projection[\"curriculum_root\"],\n342\t        \"active_manifest_path\": projection[\"active_manifest_path\"],\n343\t        \"output_root\": projection[\"output_root\"],\n344\t        \"prior_terminal_kind\": terminal_kind,\n345\t        \"comparison_key\": receipt[\"key\"],\n346\t    }\n347\t\n348\t    return {\n349\t        \"validated_recovery_envelope\": validated,\n350\t        \"evidence_index_entries\": [receipt],\n351\t        \"pending_guard\": guard(\"D00R_REVALIDATE_RESUME_IDENTITY\", \"resume_identity_proven\"),\n352\t    }\n353\t\n354\t\n355\t# --------------------------------------------------------------------------\n356\t# D01\n357\t# --------------------------------------------------------------------------\n358\t\n359\t\n360\tdef _frozen_input_records(\n361\t    engine_root: Path, curriculum_root: Path, manifest_path: Path\n362\t) -> list[dict[str, str]]:\n363\t    \"\"\"Hash every file whose bytes define what this run is allowed to build.\"\"\"\n364\t\n365\t    records: list[dict[str, str]] = [\n366\t        {\"path\": str(manifest_path), \"sha256\": _sha256_file(manifest_path), \"role\": \"active_manifest\"}\n367\t    ]\n368\t    for relative, role in (\n369\t        (\"schemas\", \"engine_schema\"),\n370\t        (\"policy\", \"engine_policy\"),\n371\t        (\"meta_prompt\", \"engine_contract\"),\n372\t    ):\n373\t        directory = engine_root / relative\n374\t        if not directory.is_dir():\n375\t            continue\n376\t        for path in sorted(directory.rglob(\"*\")):\n377\t            if path.is_file():\n378\t                records.append({\"path\": str(path), \"sha256\": _sha256_file(path), \"role\": role})\n379\t    for path in sorted(curriculum_root.rglob(\"*\")):\n380\t        if path.is_file() and \"deprecated\" not in path.parts:\n381\t            records.append({\"path\": str(path), \"sha256\": _sha256_file(path), \"role\": \"curriculum\"})\n382\t    seen: set[str] = set()\n383\t    unique: list[dict[str, str]] = []\n384\t    for record in records:\n385\t        if record[\"path\"] in seen:\n386\t            continue\n387\t        seen.add(record[\"path\"])\n388\t        unique.append(record)\n389\t    return sorted(unique, key=lambda item: item[\"path\"])\n390\t\n391\t\n392\tdef _resolve_active_manifest(curriculum_root: Path) -> Path:\n393\t    \"\"\"Select the highest-versioned active manifest without naming a curriculum.\"\"\"\n394\t\n395\t    candidates = [\n396\t        path\n397\t        for path in curriculum_root.glob(\"*curriculum.v*.yaml\")\n398\t        if \"deprecated\" not in path.parts\n399\t    ]\n400\t    require(\n401\t        bool(candidates),\n402\t        \"invalid_input\",\n403\t        \"no active curriculum manifest under the curriculum root\",\n404\t        curriculum_root=str(curriculum_root),\n405\t    )\n406\t\n407\t    def version(path: Path) -> int:\n408\t        match = re.search(r\"\\.v(\\d+)\\.yaml$\", path.name)\n409\t        return int(match.group(1)) if match else -1\n410\t\n411\t    return max(candidates, key=lambda path: (version(path), path.name))\n412\t\n413\t\n414\t@deterministic_node(\"D01_VALIDATE_AND_FREEZE_INPUTS\")\n415\tdef D01_VALIDATE_AND_FREEZE_INPUTS(\n416\t    projection: dict[str, Any], runtime_context: Any\n417\t) -> dict[str, Any]:\n418\t    \"\"\"Freeze the immutable run identity, input hashes, and authorization declaration.\"\"\"\n419\t\n420\t    envelope = _record(projection[\"invocation\"], \"invocation\")\n421\t\n422\t    engine_root = _canonical_path(envelope.get(\"engine_root\"), \"engine_root\")\n423\t    curriculum_root = _canonical_path(envelope.get(\"curriculum_root\"), \"curriculum_root\")\n424\t    output_root = _canonical_path(envelope.get(\"output_root\"), \"output_root\")\n425\t\n426\t    require(engine_root.is_dir(), \"invalid_input\", \"engine root is not a directory\")\n427\t    require(curriculum_root.is_dir(), \"invalid_input\", \"curriculum root is not a directory\")\n428\t    require(\n429\t        engine_root in curriculum_root.parents,\n430\t        \"invalid_input\",\n431\t        \"curriculum root escapes the engine root\",\n432\t        engine_root=str(engine_root),\n433\t        curriculum_root=str(curriculum_root),\n434\t    )\n435\t    require(\n436\t        output_root != engine_root and curriculum_root not in (output_root, *output_root.parents),\n437\t        \"invalid_input\",\n438\t        \"output root must not be, or sit inside, the engine or curriculum roots\",\n439\t        output_root=str(output_root),\n440\t    )\n441\t\n442\t    mode = envelope.get(\"mode\")\n443\t    require(mode in RUN_MODES, \"invalid_input\", f\"mode {mode!r} is not one of {list(RUN_MODES)}\")\n444\t    requested_unit_id = envelope.get(\"requested_unit_id\")\n445\t    if mode == \"one\":\n446\t        require(\n447\t            isinstance(requested_unit_id, str) and requested_unit_id != \"\",\n448\t            \"invalid_input\",\n449\t            \"mode 'one' requires a requested unit id\",\n450\t        )\n451\t    else:\n452\t        require(\n453\t            requested_unit_id is None,\n454\t            \"invalid_input\",\n455\t            \"mode 'all' must not name a requested unit id\",\n456\t        )\n457\t\n458\t    authorization = envelope.get(\"authorization\")\n459\t    require(\n460\t        isinstance(authorization, dict) and bool(authorization),\n461\t        \"authorization\",\n462\t        \"a run requires an explicit external-data authorization record\",\n463\t    )\n464\t\n465\t    manifest_path = _resolve_active_manifest(curriculum_root)\n466\t    frozen_inputs = _frozen_input_records(engine_root, curriculum_root, manifest_path)\n467\t    frozen_digest = canonical_digest(frozen_inputs)\n468\t\n469\t    executables: list[dict[str, Any]] = []\n470\t    for declaration in authorization.get(\"executables\", []) or []:\n471\t        record = _record(declaration, \"executable declaration\")\n472\t        name = _text(record.get(\"name\"), \"executable name\")\n473\t        resolved = record.get(\"path\")\n474\t        entry: dict[str, Any] = {\"name\": name, \"path\": resolved}\n475\t        if isinstance(resolved, str) and Path(resolved).is_file():\n476\t            entry[\"sha256\"] = _sha256_file(Path(resolved))\n477\t        executables.append(entry)\n478\t\n479\t    created_at = _now(runtime_context)\n480\t    identity_seed = {\n481\t        \"contract_version\": envelope.get(\"contract_version\"),\n482\t        \"engine_root\": str(engine_root),\n483\t        \"curriculum_root\": str(curriculum_root),\n484\t        \"output_root\": str(output_root),\n485\t        \"mode\": mode,\n486\t        \"requested_unit_id\": requested_unit_id,\n487\t        \"frozen_digest\": frozen_digest,\n488\t        \"created_at\": created_at,\n489\t    }\n490\t\n491\t    return {\n492\t        \"contract_version\": _text(envelope.get(\"contract_version\"), \"contract_version\"),\n493\t        \"run_id\": canonical_digest(identity_seed),\n494\t        \"created_at\": created_at,\n495\t        \"engine_root\": str(engine_root),\n496\t        \"curriculum_root\": str(curriculum_root),\n497\t        \"active_manifest_path\": str(manifest_path),\n498\t        \"output_root\": str(output_root),\n499\t        \"mode\": mode,\n500\t        \"requested_unit_id\": requested_unit_id,\n501\t        \"frozen_inputs\": frozen_inputs,\n502\t        \"frozen_digest\": frozen_digest,\n503\t        \"frozen_executable_identities\": executables,\n504\t        \"external_authorizations\": [authorization],\n505\t        \"pending_guard\": guard(\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"inputs_frozen\"),\n506\t    }\n507\t\n508\t\n509\t# --------------------------------------------------------------------------\n510\t# D02\n511\t# --------------------------------------------------------------------------\n512\t\n513\t\n514\tdef manifest_unit_records(manifest: Any) -> list[dict[str, Any]]:\n515\t    \"\"\"Extract the ordered unit records of an arbitrary manifest.\n516\t\n517\t    Manifest-neutral: the number of units, their identifiers, and their order all\n518\t    come from the document. Nothing here knows any curriculum.\n519\t    \"\"\"\n520\t\n521\t    require(isinstance(manifest, dict), \"schema_contract\", \"manifest must be a mapping\")\n522\t    units = manifest.get(_MANIFEST_UNITS_KEY)\n523\t    require(\n524\t        isinstance(units, list) and bool(units),\n525\t        \"schema_contract\",\n526\t        f\"manifest {_MANIFEST_UNITS_KEY!r} must be a non-empty list\",\n527\t    )\n528\t    records: list[dict[str, Any]] = []\n529\t    seen: set[str] = set()\n530\t    for index, unit in enumerate(units):\n531\t        record = _record(unit, f\"manifest unit at index {index}\")\n532\t        unit_id = record.get(_UNIT_ID_KEY)\n533\t        require(\n534\t            isinstance(unit_id, str) and unit_id != \"\",\n535\t            \"schema_contract\",\n536\t            f\"manifest unit at index {index} has no string {_UNIT_ID_KEY!r}\",\n537\t        )\n538\t        require(\n539\t            unit_id not in seen,\n540\t            \"schema_contract\",\n541\t            f\"manifest declares duplicate unit id {unit_id!r}\",\n542\t        )\n543\t        seen.add(unit_id)\n544\t        records.append(record)\n545\t    return records\n546\t\n547\t\n548\tdef _declared_prerequisites(unit: dict[str, Any]) -> list[str]:\n549\t    sequence = unit.get(\"sequence\")\n550\t    if isinstance(sequence, dict) and \"prerequisites\" in sequence:\n551\t        declared = sequence[\"prerequisites\"]\n552\t    else:\n553\t        declared = unit.get(\"prerequisites\", [])\n554\t    if declared is None:\n555\t        return []\n556\t    require(\n557\t        isinstance(declared, list),\n558\t        \"schema_contract\",\n559\t        f\"unit {unit.get(_UNIT_ID_KEY)!r} declares a non-list prerequisites value\",\n560\t    )\n561\t    for value in declared:\n562\t        require(\n563\t            isinstance(value, str),\n564\t            \"schema_contract\",\n565\t            f\"unit {unit.get(_UNIT_ID_KEY)!r} declares a non-string prerequisite\",\n566\t        )\n567\t    return list(declared)\n568\t\n569\t\n570\tdef compile_prerequisite_closure(\n571\t    unit_records: list[dict[str, Any]], target_unit_id: str\n572\t) -> list[str]:\n573\t    \"\"\"Return the target's complete transitive prerequisite closure, in manifest order.\n574\t\n575\t    Iterative rather than recursive so an arbitrarily deep chain cannot exhaust\n576\t    the interpreter stack, and cycle-detecting rather than depth-bounded so a\n577\t    malformed DAG is rejected by name instead of by timeout.\n578\t    \"\"\"\n579\t\n580\t    by_id = {unit[_UNIT_ID_KEY]: unit for unit in unit_records}\n581\t    require(\n582\t        target_unit_id in by_id,\n583\t        \"invalid_input\",\n584\t        f\"requested unit {target_unit_id!r} is not in the manifest\",\n585\t        known_unit_count=len(by_id),\n586\t    )\n587\t\n588\t    required: set[str] = set()\n589\t    # Explicit DFS with an on-stack marker set: an edge back into the current\n590\t    # path is a cycle, an edge into an already-closed node is simple reuse.\n591\t    on_path: set[str] = set()\n592\t    stack: list[tuple[str, bool]] = [(target_unit_id, False)]\n593\t    while stack:\n594\t        unit_id, expanded = stack.pop()\n595\t        if expanded:\n596\t            on_path.discard(unit_id)\n597\t            required.add(unit_id)\n598\t            continue\n599\t        if unit_id in required:\n600\t            continue\n601\t        if unit_id in on_path:\n602\t            raise SystemFailure(\n603\t                \"schema_contract\",\n604\t                f\"manifest prerequisite graph contains a cycle through {unit_id!r}\",\n605\t                {\"unit_id\": unit_id, \"path\": sorted(on_path)},\n606\t            )\n607\t        on_path.add(unit_id)\n608\t        stack.append((unit_id, True))\n609\t        for prerequisite in _declared_prerequisites(by_id[unit_id]):\n610\t            if prerequisite not in by_id:\n611\t                raise SystemFailure(\n612\t                    \"schema_contract\",\n613\t                    f\"unit {unit_id!r} declares unknown prerequisite {prerequisite!r}\",\n614\t                    {\"unit_id\": unit_id, \"prerequisite\": prerequisite},\n615\t                )\n616\t            if prerequisite not in required:\n617\t                stack.append((prerequisite, False))\n618\t\n619\t    return [unit[_UNIT_ID_KEY] for unit in unit_records if unit[_UNIT_ID_KEY] in required]\n620\t\n621\t\n622\t@deterministic_node(\"D02_COMPILE_EFFECTIVE_RUN\")\n623\tdef D02_COMPILE_EFFECTIVE_RUN(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n624\t    \"\"\"Freeze the ordered unit list, target closure, and acceptance denominator.\"\"\"\n625\t\n626\t    manifest_path = Path(_text(projection[\"active_manifest_path\"], \"active_manifest_path\"))\n627\t    frozen = {record[\"path\"]: record[\"sha256\"] for record in projection[\"frozen_inputs\"]}\n628\t    require(\n629\t        str(manifest_path) in frozen,\n630\t        \"integrity\",\n631\t        \"the active manifest is not in the frozen input set\",\n632\t        manifest=str(manifest_path),\n633\t    )\n634\t    require(manifest_path.is_file(), \"integrity\", \"the frozen active manifest is missing\")\n635\t    actual = _sha256_file(manifest_path)\n636\t    require(\n637\t        actual == frozen[str(manifest_path)],\n638\t        \"integrity\",\n639\t        \"the active manifest changed after it was frozen\",\n640\t        expected=frozen[str(manifest_path)],\n641\t        actual=actual,\n642\t    )\n643\t\n644\t    try:\n645\t        manifest = yaml.safe_load(manifest_path.read_text(encoding=\"utf-8\"))\n646\t    except yaml.YAMLError as error:\n647\t        raise SystemFailure(\n648\t            \"schema_contract\", f\"active manifest is not parseable YAML: {error}\"\n649\t        ) from error\n650\t\n651\t    unit_records = manifest_unit_records(manifest)\n652\t    ordered_ids = [unit[_UNIT_ID_KEY] for unit in unit_records]\n653\t\n654\t    # A declared prerequisite must exist even in `all` mode: an unresolvable\n655\t    # edge means the manifest's own ordering claim is unverifiable.\n656\t    known = set(ordered_ids)\n657\t    for unit in unit_records:\n658\t        for prerequisite in _declared_prerequisites(unit):\n659\t            require(\n660\t                prerequisite in known,\n661\t                \"schema_contract\",\n662\t                f\"unit {unit[_UNIT_ID_KEY]!r} declares unknown prerequisite {prerequisite!r}\",\n663\t            )\n664\t\n665\t    mode = projection[\"mode\"]\n666\t    requested_unit_id = projection[\"requested_unit_id\"]\n667\t    if mode == \"all\":\n668\t        # `all` mode must still prove the whole graph is acyclic, which the\n669\t        # per-target closure does for every node at once.\n670\t        for unit_id in ordered_ids:\n671\t            compile_prerequisite_closure(unit_records, unit_id)\n672\t        target_closure = list(ordered_ids)\n673\t    else:\n674\t        require(\n675\t            isinstance(requested_unit_id, str) and requested_unit_id != \"\",\n676\t            \"invalid_input\",\n677\t            \"mode 'one' requires a requested unit id\",\n678\t        )\n679\t        target_closure = compile_prerequisite_closure(unit_records, requested_unit_id)\n680\t\n681\t    # The curriculum's own domain contract. The engine's metaschema constrains the\n682\t    # shape of this file; the file constrains the domain a unit's artifacts assert.\n683\t    declared_domain = manifest.get(\"domain\") if isinstance(manifest, dict) else None\n684\t    manifest_schema = (\n685\t        declared_domain.get(\"manifest_schema\") if isinstance(declared_domain, dict) else None\n686\t    )\n687\t\n688\t    effective_run = {\n689\t        \"mode\": mode,\n690\t        \"requested_unit_id\": requested_unit_id,\n691\t        \"manifest_schema\": manifest_schema,\n692\t        \"ordered_unit_ids\": ordered_ids,\n693\t        \"unit_records\": unit_records,\n694\t        \"target_closure\": target_closure,\n695\t        \"manifest_path\": str(manifest_path),\n696\t        \"manifest_digest\": actual,\n697\t    }\n698\t    effective_run[\"denominator_id\"] = canonical_digest(\n699\t        {\n700\t            \"manifest_digest\": actual,\n701\t            \"mode\": mode,\n702\t            \"target_closure\": target_closure,\n703\t        }\n704\t    )\n705\t\n706\t    return {\n707\t        \"effective_run\": effective_run,\n708\t        \"pending_guard\": guard(\"D02_COMPILE_EFFECTIVE_RUN\", \"effective_run_compiled\"),\n709\t    }\n710\t\n711\t\n712\t# --------------------------------------------------------------------------\n713\t# D03\n714\t# --------------------------------------------------------------------------\n715\t\n716\t\n717\t@deterministic_node(\"D03_PROVE_CAPABILITIES\")\n718\tdef D03_PROVE_CAPABILITIES(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n719\t    \"\"\"Prove every required capability and authorization before any transmission.\"\"\"\n720\t\n721\t    envelope = _record(projection[\"invocation\"], \"invocation\")\n722\t    recovery = projection[\"validated_recovery_envelope\"]\n723\t    frozen_digest = projection[\"frozen_digest\"]\n724\t    if recovery is not None:\n725\t        require(\n726\t            recovery.get(\"frozen_digest\") == frozen_digest,\n727\t            \"identity\",\n728\t            \"the validated recovery envelope does not carry the frozen digest\",\n729\t        )\n730\t\n731\t    effective_run = projection[\"effective_run\"]\n732\t    require(\n733\t        bool(effective_run) or recovery is not None,\n734\t        \"invalid_input\",\n735\t        \"capability proof requires either a fresh effective run or a validated recovery envelope\",\n736\t    )\n737\t\n738\t    registry = getattr(runtime_context, \"transport_registry\", None)\n739\t    require(registry is not None, \"capability\", \"runtime context exposes no transport registry\")\n740\t\n741\t    # The probe is a bounded local capability check, never a curriculum model job.\n742\t    prober = getattr(registry, \"prove_capability\", None)\n743\t    require(callable(prober), \"capability\", \"transport registry exposes no capability prober\")\n744\t\n745\t    receipts: list[dict[str, Any]] = []\n746\t    missing: list[str] = []\n747\t    unavailable_facts: list[dict[str, Any]] = []\n748\t    for capability in REQUIRED_CAPABILITIES:\n749\t        try:\n750\t            proof = prober(capability)\n751\t        except FileNotFoundError as error:\n752\t            missing.append(capability)\n753\t            proof = {\"result\": \"MISSING\", \"detail\": str(error)}\n754\t        proof_record = _record(proof, f\"{capability} capability proof\")\n755\t        result = proof_record.get(\"result\")\n756\t        if result == \"UNAVAILABLE_EXTERNAL_FACT\":\n757\t            unavailable_facts.append({\"capability\": capability, \"detail\": proof_record})\n758\t        elif result != \"PASS\":\n759\t            missing.append(capability)\n760\t        receipt = {\n761\t            \"kind\": \"capability_receipt\",\n762\t            \"capability\": capability,\n763\t            \"run_id\": projection[\"run_id\"],\n764\t            \"frozen_digest\": frozen_digest,\n765\t            \"proof\": proof_record,\n766\t        }\n767\t        receipt[\"key\"] = canonical_digest(receipt)\n768\t        receipts.append(receipt)\n769\t\n770\t    frozen_executables = {entry[\"name\"]: entry for entry in projection[\"frozen_executable_identities\"]}\n771\t    observer = getattr(registry, \"observe_executable\", None)\n772\t    identity_mismatches: list[dict[str, Any]] = []\n773\t    if callable(observer):\n774\t        for name, frozen_entry in sorted(frozen_executables.items()):\n775\t            observed = observer(name)\n776\t            observed_record = _record(observed, f\"{name} executable identity\")\n777\t            for field in (\"path\", \"sha256\"):\n778\t                expected = frozen_entry.get(field)\n779\t                if expected is None:\n780\t                    continue\n781\t                if observed_record.get(field) != expected:\n782\t                    identity_mismatches.append(\n783\t                        {\n784\t                            \"executable\": name,\n785\t                            \"field\": field,\n786\t                            \"frozen\": expected,\n787\t                            \"observed\": observed_record.get(field),\n788\t                        }\n789\t                    )\n790\t            receipt = {\n791\t                \"kind\": \"executable_identity_receipt\",\n792\t                \"capability\": \"model_cli_identity\",\n793\t                \"executable\": name,\n794\t                \"run_id\": projection[\"run_id\"],\n795\t                \"frozen\": frozen_entry,\n796\t                \"observed\": observed_record,\n797\t            }\n798\t            receipt[\"key\"] = canonical_digest(receipt)\n799\t            receipts.append(receipt)\n800\t\n801\t    require(\n802\t        not identity_mismatches,\n803\t        \"identity\",\n804\t        \"a frozen executable identity does not match the installed executable\",\n805\t        mismatches=identity_mismatches,\n806\t    )\n807\t\n808\t    authorizations = projection[\"external_authorizations\"]\n809\t    require(\n810\t        bool(authorizations),\n811\t        \"authorization\",\n812\t        \"no external-data authorization record covers this run\",\n813\t    )\n814\t    for authorization in authorizations:\n815\t        record = _record(authorization, \"authorization record\")\n816\t        require(\n817\t            record.get(\"curriculum_digest\") == frozen_digest,\n818\t            \"authorization\",\n819\t            \"the authorization record does not cover this run's frozen inputs\",\n820\t            authorized=record.get(\"curriculum_digest\"),\n821\t            frozen=frozen_digest,\n822\t        )\n823\t        require(\n824\t            record.get(\"output_root\") in (None, projection[\"output_root\"]),\n825\t            \"authorization\",\n826\t            \"the authorization record is scoped to a different output root\",\n827\t        )\n828\t\n829\t    require(\n830\t        not missing,\n831\t        \"capability\",\n832\t        \"required capabilities are unavailable\",\n833\t        missing=sorted(missing),\n834\t    )\n835\t\n836\t    if unavailable_facts:\n837\t        require(\n838\t            len(unavailable_facts) == 1,\n839\t            \"capability\",\n840\t            \"more than one capability reported an unavailable external fact\",\n841\t            facts=unavailable_facts,\n842\t        )\n843\t        raise PrerequisitePause(\n844\t            \"required_external_fact_unavailable\",\n845\t            \"a named required external fact is unavailable at capability proof\",\n846\t            {\"facts\": unavailable_facts, \"receipts\": [r[\"key\"] for r in receipts]},\n847\t        )\n848\t\n849\t    _ = envelope  # the envelope is proven against frozen state, not consumed further\n850\t    return {\n851\t        \"capability_receipts\": receipts,\n852\t        \"pending_guard\": guard(\"D03_PROVE_CAPABILITIES\", \"capabilities_proven\"),\n853\t    }\n854\t\n855\t\n856\t# --------------------------------------------------------------------------\n857\t# D04\n858\t# --------------------------------------------------------------------------\n859\t\n860\t\n861\t@deterministic_node(\"D04_INITIALIZE_OR_RESUME\")\n862\tdef D04_INITIALIZE_OR_RESUME(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n863\t    \"\"\"Open a fresh episode, or import a prior episode's proven state byte-identically.\"\"\"\n864\t\n865\t    bootstrap_kind = projection[\"bootstrap_kind\"]\n866\t    require(\n867\t        bootstrap_kind in BOOTSTRAP_KINDS,\n868\t        \"invalid_input\",\n869\t        f\"unknown bootstrap kind {bootstrap_kind!r}\",\n870\t    )\n871\t    require(\n872\t        bool(projection[\"capability_receipts\"]),\n873\t        \"capability\",\n874\t        \"an episode cannot be initialized without capability proof receipts\",\n875\t    )\n876\t\n877\t    envelope = _record(projection[\"invocation\"], \"invocation\")\n878\t    ordinal = envelope.get(\"episode_ordinal\")\n879\t    require(\n880\t        isinstance(ordinal, int) and not isinstance(ordinal, bool) and ordinal >= 0,\n881\t        \"invalid_input\",\n882\t        \"invocation must carry a non-negative integer episode ordinal\",\n883\t    )\n884\t    run_id = _text(projection[\"run_id\"], \"run_id\")\n885\t\n886\t    if bootstrap_kind == \"recover_orphan\":\n887\t        thread_id = f\"{run_id}:recover:{ordinal}\"\n888\t    else:\n889\t        thread_id = f\"{run_id}:episode:{ordinal:06d}\"\n890\t    episode_id = canonical_digest({\"run_id\": run_id, \"thread_id\": thread_id})\n891\t\n892\t    update: dict[str, Any] = {\n893\t        \"episode_id\": episode_id,\n894\t        \"checkpoint_thread_id\": thread_id,\n895\t        \"checkpoint_namespace\": \"\",\n896\t    }\n897\t\n898\t    if bootstrap_kind == \"fresh\":\n899\t        require(\n900\t            projection[\"validated_recovery_envelope\"] is None,\n901\t            \"invalid_input\",\n902\t            \"a fresh episode must not carry a validated recovery envelope\",\n903\t        )\n904\t        update[\"resume_from\"] = None\n905\t        update[\"pending_guard\"] = guard(\"D04_INITIALIZE_OR_RESUME\", \"fresh_initialized\")\n906\t        return update\n907\t\n908\t    recovery = projection[\"validated_recovery_envelope\"]\n909\t    require(\n910\t        isinstance(recovery, dict),\n911\t        \"invalid_input\",\n912\t        \"a resume episode requires D00R's validated recovery envelope\",\n913\t    )\n914\t    require(\n915\t        recovery.get(\"run_id\") == run_id,\n916\t        \"identity\",\n917\t        \"the validated recovery envelope names a different run\",\n918\t    )\n919\t    require(\n920\t        recovery.get(\"frozen_digest\") == projection[\"frozen_digest\"],\n921\t        \"identity\",\n922\t        \"the validated recovery envelope carries a different frozen digest\",\n923\t    )\n924\t\n925\t    history = projection[\"terminal_history\"]\n926\t    prior = history[-1] if history else None\n927\t    require(\n928\t        isinstance(prior, dict) and prior.get(\"kind\") in RESUMABLE_TERMINAL_KINDS,\n929\t        \"identity\",\n930\t        \"resume requires a legally resumable prior terminal in the history ledger\",\n931\t        prior_kind=prior.get(\"kind\") if isinstance(prior, dict) else None,\n932\t    )\n933\t\n934\t    # Accepted bytes are the one thing a resume may never rewrite: the import\n935\t    # re-presents the recorded heads unchanged and lets `advance_head` and\n936\t    # `accept_once` reject anything that is not byte-identical.\n937\t    accepted = projection[\"accepted_unit_receipts\"]\n938\t    for unit_id, receipt in sorted(accepted.items()):\n939\t        record = _record(receipt, f\"accepted receipt for {unit_id}\")\n940\t        require(\n941\t            isinstance(record.get(\"receipt_hash\"), str),\n942\t            \"integrity\",\n943\t            f\"accepted receipt for {unit_id!r} has no receipt hash\",\n944\t        )\n945\t\n946\t    resume_from = {\n947\t        \"prior_terminal_kind\": prior[\"kind\"],\n948\t        \"comparison_key\": recovery.get(\"comparison_key\"),\n949\t        \"imported_head_keys\": sorted(projection[\"artifact_heads\"]),\n950\t        \"imported_counter_keys\": sorted(projection[\"attempt_counters\"]),\n951\t        \"accepted_unit_ids\": sorted(accepted),\n952\t    }\n953\t\n954\t    update.update(\n955\t        {\n956\t            \"resume_from\": resume_from,\n957\t            \"artifact_heads\": dict(projection[\"artifact_heads\"]),\n958\t            \"attempt_counters\": dict(projection[\"attempt_counters\"]),\n959\t            \"cursor\": dict(projection[\"cursor\"]),\n960\t            \"unit_status\": dict(projection[\"unit_status\"]),\n961\t            \"pending_guard\": guard(\"D04_INITIALIZE_OR_RESUME\", \"resume_imported\"),\n962\t        }\n963\t    )\n964\t    return update\n965\t\n966\t\n967\t# --------------------------------------------------------------------------\n968\t# D92\n969\t# --------------------------------------------------------------------------\n970\t\n971\t# A stored frontier naming any of these is a resume that would re-enter a model\n972\t# without passing the attempt counter; it is a system failure, not a retry.\n973\t_MODEL_NODE_PREFIX = \"M\"\n974\t\n975\t\n976\t@deterministic_node(\"D92_REENTER_VALIDATED_FRONTIER\")\n977\tdef D92_REENTER_VALIDATED_FRONTIER(\n978\t    projection: dict[str, Any], runtime_context: Any\n979\t) -> dict[str, Any]:\n980\t    \"\"\"Validate the persisted resume frontier and name one deterministic destination.\"\"\"\n981\t\n982\t    frontier = projection[\"resume_frontier\"]\n983\t    require(\n984\t        isinstance(frontier, dict) and bool(frontier),\n985\t        \"invalid_input\",\n986\t        \"resume re-entry requires a persisted deterministic frontier\",\n987\t    )\n988\t    destination = frontier.get(\"destination\")\n989\t    require(\n990\t        isinstance(destination, str) and destination != \"\",\n991\t        \"invalid_input\",\n992\t        \"the stored frontier names no destination node\",\n993\t    )\n994\t    require(\n995\t        not re.fullmatch(rf\"{_MODEL_NODE_PREFIX}\\d+_[A-Z0-9_]+\", destination),\n996\t        \"invalid_input\",\n997\t        f\"stored frontier destination {destination!r} is a model node\",\n998\t        destination=destination,\n999\t    )\n1000\t\n1001\t    # An activation with no matching execution receipt is an attempt whose\n1002\t    # outcome nobody observed; re-entering deterministically would silently\n1003\t    # abandon it.\n1004\t    executed = {\n1005\t        receipt.get(\"activation_id\")\n1006\t        for receipt in projection[\"model_execution_receipts\"]\n1007\t        if isinstance(receipt, dict)\n1008\t    }\n1009\t    unaccounted = sorted(\n1010\t        activation.get(\"activation_id\")\n1011\t        for activation in projection[\"activation_receipts\"]\n1012\t        if isinstance(activation, dict)\n1013\t        and activation.get(\"activation_id\") not in executed\n1014\t        and activation.get(\"activation_id\") is not None\n1015\t    )\n1016\t\n1017\t    heads = projection[\"artifact_heads\"]\n1018\t    stale: list[dict[str, Any]] = []\n1019\t    for key, expected_hash in sorted((frontier.get(\"parent_hashes\") or {}).items()):\n1020\t        current = heads.get(key)\n1021\t        current_hash = current.get(\"hash\") if isinstance(current, dict) else None\n1022\t        if current_hash != expected_hash:\n1023\t            stale.append({\"stream\": key, \"expected\": expected_hash, \"current\": current_hash})\n1024\t    require(\n1025\t        not stale,\n1026\t        \"integrity\",\n1027\t        \"the stored frontier names parents that are no longer current heads\",\n1028\t        stale=stale,\n1029\t    )\n1030\t\n1031\t    receipt = {\n1032\t        \"kind\": \"frontier_validation\",\n1033\t        \"destination\": destination,\n1034\t        \"unaccounted_activations\": unaccounted,\n1035\t        \"validated_parent_streams\": sorted((frontier.get(\"parent_hashes\") or {})),\n1036\t        \"counter_keys\": sorted(projection[\"attempt_counters\"]),\n1037\t    }\n1038\t    receipt[\"key\"] = canonical_digest(receipt)\n1039\t\n1040\t    if unaccounted:\n1041\t        return {\n1042\t            \"evidence_index_entries\": [receipt],\n1043\t            \"pending_guard\": guard(\n1044\t                \"D92_REENTER_VALIDATED_FRONTIER\",\n1045\t                \"incomplete_model_activation\",\n1046\t                activations=unaccounted,\n1047\t            ),\n1048\t        }\n1049\t\n1050\t    require(\n1051\t        bool(projection[\"capability_receipts\"]),\n1052\t        \"capability\",\n1053\t        \"re-entry requires current capability proof receipts\",\n1054\t    )\n1055\t    require(\n1056\t        bool(projection[\"external_authorizations\"]),\n1057\t        \"authorization\",\n1058\t        \"re-entry requires a current external-data authorization record\",\n1059\t    )\n1060\t\n1061\t    return {\n1062\t        \"evidence_index_entries\": [receipt],\n1063\t        \"pending_guard\": guard(\n1064\t            \"D92_REENTER_VALIDATED_FRONTIER\", \"deterministic_reentry\", destination=destination\n1065\t        ),\n1066\t    }\n1067\t\n1068\t\n1069\t# --------------------------------------------------------------------------\n1070\t# D96\n1071\t# --------------------------------------------------------------------------\n1072\t\n1073\t\n1074\t@deterministic_node(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1075\tdef D96_GRACEFUL_INTERRUPT_GATE(\n1076\t    projection: dict[str, Any], runtime_context: Any\n1077\t) -> dict[str, Any]:\n1078\t    \"\"\"Record an interrupted-episode candidate and the frontier it can resume from.\n1079\t\n1080\t    This node reaches no transport, retrieval, or renderer: it runs when the\n1081\t    episode is already stopping, and any external call here could block or fail\n1082\t    on the way out and lose the frontier it exists to preserve.\n1083\t    \"\"\"\n1084\t\n1085\t    recovery = projection[\"validated_recovery_envelope\"]\n1086\t    token = getattr(runtime_context, \"signal_token\", None)\n1087\t    signal_set = bool(token is not None and getattr(token, \"is_set\", lambda: False)())\n1088\t\n1089\t    if recovery is not None:\n1090\t        classification = \"crashed_episode\"\n1091\t    elif signal_set:\n1092\t        classification = \"graceful_signal\"\n1093\t    else:\n1094\t        raise SystemFailure(\n1095\t            \"invalid_input\",\n1096\t            \"the interrupt gate ran with neither a graceful signal nor a recovery envelope\",\n1097\t        )\n1098\t\n1099\t    checkpoints = projection[\"checkpoint_metadata\"]\n1100\t    evidence = projection[\"evidence_index_entries\"]\n1101\t    frontier = projection[\"resume_frontier\"] or {}\n1102\t\n1103\t    high_water = {\n1104\t        \"checkpoint_records\": len(checkpoints),\n1105\t        \"evidence_records\": len(evidence),\n1106\t        \"last_checkpoint_id\": (\n1107\t            checkpoints[-1].get(\"checkpoint_id\") if checkpoints else None\n1108\t        ),\n1109\t    }\n1110\t\n1111\t    resume_frontier = {\n1112\t        \"destination\": frontier.get(\"destination\"),\n1113\t        \"parent_hashes\": {\n1114\t            stream: head.get(\"hash\")\n1115\t            for stream, head in sorted(projection[\"artifact_heads\"].items())\n1116\t            if isinstance(head, dict)\n1117\t        },\n1118\t        \"selected_unit_id\": projection[\"selected_unit_id\"],\n1119\t        \"attempt_counters\": dict(projection[\"attempt_counters\"]),\n1120\t        \"classification\": classification,\n1121\t    }\n1122\t\n1123\t    candidate = {\n1124\t        \"kind\": \"INTERRUPTED\",\n1125\t        \"classification\": classification,\n1126\t        \"episode_id\": projection[\"episode_id\"],\n1127\t        \"run_id\": projection[\"run_id\"],\n1128\t        \"resume_frontier\": resume_frontier,\n1129\t        \"high_water_marks\": high_water,\n1130\t        \"heads\": resume_frontier[\"parent_hashes\"],\n1131\t    }\n1132\t\n1133\t    return {\n1134\t        \"terminal_candidate\": candidate,\n1135\t        \"resume_frontier\": resume_frontier,\n1136\t        \"pending_guard\": guard(\"D96_GRACEFUL_INTERRUPT_GATE\", \"interrupted\"),\n1137\t    }\n1138\t"}]},"parent_tool_use_id":"toolu_0145v59DnGRuohwg4vAD5WV5","session_id":"85b1df9e-c45e-4a47-a419-3ef807d4ad98","uuid":"075ff7c5-6664-4936-9606-f4f6b8191967","timestamp":"2026-08-12T18:45:53.283Z","subagent_type":"general-purpose","task_description":"Locate real curriculum/engine roots for live run"}
