{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Btbrkq7B3ZbgSVP7f9Fp4","type":"tool_result","content":"1\t\"\"\"Plan 26 topology gate (spec sections 3.3, 4, 8): N20's compiled skeleton.\n2\t\n3\tEvery assertion here runs against a real `StateGraph`/`CompiledStateGraph` built\n4\tfrom the real N22/N23 callables. Nothing is mocked: a simulated compilation\n5\twould prove that a stand-in compiles, which is the one thing this file exists to\n6\trule out.\n7\t\n8\tScope. N20 registers the fixed skeleton:\n9\t\n10\t    START -> D00 -> {D01 -> D02, D00R} -> D03 -> D04 -> {D05, D92}\n11\t    D00 -> D96 -> D98 -> END        (orphan recovery)\n12\t\n13\tN30 has since registered the per-unit path (D05-D15 with its source and visual\n14\t`Send` map/reduce) into the same builder, and N31/N32 still owe the repair,\n15\tacceptance, and workbook branches. So these tests assert N20's properties —\n16\tbinding rejection by stable ID, bounded cycles, worker->barrier fan-out shape,\n17\tmodel nodes holding no routing or acceptance authority — against whatever\n18\ttopology is actually compiled now, rather than against a frozen skeleton\n19\tsnapshot that a later graph node would falsify by doing its job.\n20\t\n21\tSkips only where the hash-locked environment is absent; the node's evidence was\n22\tproduced by running this file inside it.\n23\t\"\"\"\n24\t\n25\timport ast\n26\timport hashlib\n27\timport re\n28\timport shutil\n29\timport tempfile\n30\timport unittest\n31\tfrom pathlib import Path\n32\t\n33\ttry:  # pragma: no cover - environment probe, not behavior\n34\t    import langgraph  # noqa: F401\n35\t    import langgraph.checkpoint.sqlite  # noqa: F401\n36\texcept ModuleNotFoundError as exc:  # pragma: no cover\n37\t    raise unittest.SkipTest(\n38\t        \"plan26 hash-locked environment not installed \"\n39\t        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n40\t        f\"{exc}\"\n41\t    ) from exc\n42\t\n43\timport pytest\n44\tfrom langgraph._internal._constants import RESERVED\n45\tfrom langgraph.graph import END, START, StateGraph\n46\tfrom langgraph.graph.state import CompiledStateGraph\n47\tfrom langgraph.types import Send\n48\t\n49\tfrom runtime.langgraph_factory import graph as G\n50\tfrom runtime.langgraph_factory import model_nodes as mn\n51\tfrom runtime.langgraph_factory import routing as R\n52\tfrom runtime.langgraph_factory import transport as tp\n53\tfrom runtime.langgraph_factory.nodes import NODE_CATALOGUE, node_registry\n54\tfrom runtime.langgraph_factory.state import (\n55\t    FACTORY_STATE_FIELDS,\n56\t    FactoryInput,\n57\t    FactoryOutput,\n58\t    FactoryState,\n59\t    RuntimeContext,\n60\t)\n61\t\n62\tREPO_ROOT = Path(__file__).resolve().parents[2]\n63\tGRAPH_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"graph.py\"\n64\tROUTING_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"routing.py\"\n65\t\n66\t# Spec 8.1: \"There is no edge from a model directly to acceptance, terminal,\n67\t# checkpoint initialization, unit selection, workbook assembly, or release\",\n68\t# plus resume re-entry (spec 6.2 D92 forbids a model as a stored destination).\n69\t#\n70\t# The reduction nodes D16/D28 are deliberately NOT here: spec 8.1 wires\n71\t# `M05 -> D16` and `M07 -> D28` on purpose, because a review is *evidence for*\n72\t# the code-computed denominator, not the reduction itself. \"Models hold no\n73\t# reduction authority\" is proven below as a channel-authority property, which is\n74\t# where that authority actually lives.\n75\tAUTHORITY_NODES = frozenset({\n76\t    \"D04_INITIALIZE_OR_RESUME\",\n77\t    \"D05_SELECT_NEXT_UNIT\",\n78\t    \"D22_ACCEPT_UNIT\",\n79\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n80\t    \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n81\t    \"D25_ASSEMBLE_WORKBOOK\",\n82\t    \"D32_RECOMPUTE_FINAL_RELEASE\",\n83\t    \"D92_REENTER_VALIDATED_FRONTIER\",\n84\t    \"D98_WRITE_TERMINAL\",\n85\t    END,\n86\t})\n87\t\n88\t# (dispatching node, fan-out guard value) -> (dispatching guard, worker, barrier).\n89\t# The barrier is the deterministic node that owns the fan-out's denominator and to\n90\t# which the worker returns; for M01 that is the next node of whichever superstep\n91\t# the phase advance selects. A model fan-out's dispatching guard resolves to D90,\n92\t# not to the worker: the `Send`s are emitted by D90's guard, from the packet D90\n93\t# restaged with one committed attempt reservation per member.\n94\tFANOUT_SHAPES = {\n95\t    (\"D06_COMPILE_SOURCE_REQUESTS\", \"discovery_fanout\"): (\n96\t        R.route_source_discovery_fanout,\n97\t        \"M01_RESEARCH_UNIT_SOURCES\",\n98\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n99\t    ),\n100\t    (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"interpretation_fanout\"): (\n101\t        R.route_source_interpretation_fanout,\n102\t        \"M01_RESEARCH_UNIT_SOURCES\",\n103\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n104\t    ),\n105\t    (\"D10_COMPILE_VISUAL_BRIEFS\", \"deterministic_visual_fanout\"): (\n106\t        R.route_visual_briefs,\n107\t        \"D11_CREATE_DETERMINISTIC_VISUALS\",\n108\t        \"D12_VISUAL_BARRIER_AND_JOIN\",\n109\t    ),\n110\t    (\"D12_VISUAL_BARRIER_AND_JOIN\", \"model_visual_fanout\"): (\n111\t        R.route_visual_barrier,\n112\t        \"M04_CREATE_UNIT_VISUALS\",\n113\t        \"D12_VISUAL_BARRIER_AND_JOIN\",\n114\t    ),\n115\t}\n116\t\n117\t\n118\tdef _send_emitting_guard(source: str, value: str):\n119\t    \"\"\"The guard that actually emits the `Send`s for this fan-out, and its record.\n120\t\n121\t    For a model fan-out that is D90's guard reading D90's restaged packet, because\n122\t    spec 6.2 requires the attempt counter to be committed before dispatch; for a\n123\t    deterministic fan-out it is the dispatching node's own guard.\n124\t    \"\"\"\n125\t\n126\t    if R.FANOUT_GUARDS[source][value] == R.ATTEMPT_RESERVATION:\n127\t        return R.route_attempt_reservation, R.ATTEMPT_RESERVATION, \"authorized\"\n128\t    return FANOUT_SHAPES[(source, value)][0], source, value\n129\t\n130\t\n131\t@pytest.fixture(scope=\"module\")\n132\tdef output_root():\n133\t    root = Path(tempfile.mkdtemp(prefix=\"plan26_n20_topology_\"))\n134\t    yield root\n135\t    shutil.rmtree(root, ignore_errors=True)\n136\t\n137\t\n138\t@pytest.fixture(scope=\"module\")\n139\tdef compiled(output_root) -> CompiledStateGraph:\n140\t    return G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n141\t\n142\t\n143\tdef fresh_builder() -> StateGraph:\n144\t    return StateGraph(\n145\t        FactoryState,\n146\t        context_schema=RuntimeContext,\n147\t        input_schema=FactoryInput,\n148\t        output_schema=FactoryOutput,\n149\t    )\n150\t\n151\t\n152\t# ======================================================= state/channel precondition\n153\t\n154\t\n155\tdef test_the_state_schema_declares_no_langgraph_reserved_channel_name():\n156\t    \"\"\"A reserved channel name makes the production state schema uncompilable.\n157\t\n158\t    LangGraph 1.2.9 rejects `checkpoint_ns` (and `checkpoint_id`, `configurable`,\n159\t    ...) as channel names in `validate_graph`, so any such field in\n160\t    `FactoryState` fails compilation of the one production graph.\n161\t    \"\"\"\n162\t\n163\t    clashes = sorted(set(FACTORY_STATE_FIELDS) & set(RESERVED))\n164\t    assert clashes == [], (\n165\t        f\"FactoryState declares LangGraph-reserved channel name(s) {clashes}; \"\n166\t        f\"owner N11_STATE_REDUCERS (rework edge `state_or_reducer`)\"\n167\t    )\n168\t\n169\t\n170\t# ====================================================== TEST 1: the catalogue compiles\n171\t\n172\t\n173\tdef test_the_available_catalogue_compiles_against_real_node_callables(compiled):\n174\t    bindings = G.binding_inventory()\n175\t    registry = node_registry()\n176\t\n177\t    assert compiled.name == G.GRAPH_NAME == \"plan26_curriculum_factory\"\n178\t    assert isinstance(compiled, CompiledStateGraph)\n179\t\n180\t    # 22 deterministic bodies (N22) + 8 model adapters + D90/D91 (N23), all real\n181\t    # callables.\n182\t    assert set(registry) == set(NODE_CATALOGUE)\n183\t    assert len(registry) == 22\n184\t    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n185\t    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n186\t    assert set(mn.MODEL_BOOKKEEPING_NODES) == {R.ATTEMPT_RESERVATION, R.MODEL_FAILURE_CLASSIFIER}\n187\t    assert set(bindings) == (\n188\t        set(registry) | set(mn.MODEL_NODE_ADAPTERS) | set(mn.MODEL_BOOKKEEPING_NODES)\n189\t    )\n190\t    assert len(bindings) == 32\n191\t\n192\t    # P-N20-001 (root cause: N90 finding F1, closed by N31's approved rework\n193\t    # P-N31-001): once a downstream graph node correctly wires D16-D23/M06 into\n194\t    # the one production graph, the compiled node set is wider than\n195\t    # `binding_inventory()` by design — D16-D23 carry no `NODE_CATALOGUE` row\n196\t    # and were never part of that function's contract (see its own docstring).\n197\t    # This asserts the invariant that actually holds in every generation: every\n198\t    # node this node's own skeleton requires, plus everything `binding_\n199\t    # inventory()` declares, is present in the compiled graph. A genuinely\n200\t    # missing or wrong skeleton node still fails this.\n201\t    drawn = compiled.get_graph()\n202\t    compiled_nodes = set(drawn.nodes) - {START, END}\n203\t    skeleton_required = set(G._skeleton_required_nodes()) | set(bindings)\n204\t    assert skeleton_required <= compiled_nodes, sorted(skeleton_required - compiled_nodes)\n205\t\n206\t    for node_id, body in bindings.items():\n207\t        module = G._binding_record(node_id, body)[\"module\"]\n208\t        assert module.startswith(\"runtime.langgraph_factory.\"), (node_id, module)\n209\t\n210\t\n211\tdef test_start_has_exactly_one_edge_and_d98_is_the_only_registered_end_edge(compiled):\n212\t    drawn = compiled.get_graph()\n213\t    starts = [edge for edge in drawn.edges if edge.source == START]\n214\t    assert [edge.target for edge in starts] == [\"D00_BOOTSTRAP_EPISODE\"]\n215\t\n216\t    registered_end_sources = sorted(\n217\t        source for source, target in G.SKELETON_NORMAL_EDGES if target == END\n218\t    )\n219\t    assert registered_end_sources == [\"D98_WRITE_TERMINAL\"]\n220\t\n221\t    # D98's body is the real N22-owned terminal writer, not a local shim.\n222\t    d98 = node_registry()[\"D98_WRITE_TERMINAL\"]\n223\t    assert G._binding_record(\"D98_WRITE_TERMINAL\", d98)[\"module\"] == (\n224\t        \"runtime.langgraph_factory.nodes.terminal\"\n225\t    )\n226\t\n227\t    # LangGraph draws a dead-end node as reaching END. In this skeleton the only\n228\t    # such nodes are the frontier N30 still owes; nothing else leaks to END.\n229\t    drawn_end = {edge.source for edge in drawn.edges if edge.target == END}\n230\t    assert drawn_end - {\"D98_WRITE_TERMINAL\"} <= set(G.DEFERRED_TOPOLOGY)\n231\t    for node_id in drawn_end - {\"D98_WRITE_TERMINAL\"}:\n232\t        assert G.DEFERRED_TOPOLOGY[node_id] == \"N30_UNIT_GRAPH\"\n233\t\n234\t\n235\tdef test_the_skeleton_wires_exactly_the_declared_edges(compiled):\n236\t    topology = G.compiled_topology(compiled)\n237\t    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n238\t\n239\t    for source, target in (\n240\t        (START, \"D00_BOOTSTRAP_EPISODE\"),\n241\t        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n242\t        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n243\t        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n244\t        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n245\t        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n246\t        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n247\t        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n248\t        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n249\t        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n250\t        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n251\t        (\"D98_WRITE_TERMINAL\", END),\n252\t    ):\n253\t        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n254\t\n255\t    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n256\t    # single successor are the whole of it.\n257\t    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n258\t        \"D98_WRITE_TERMINAL\"\n259\t    }\n260\t\n261\t\n262\t# ============================================ TEST 2: bad bindings fail by stable ID\n263\t\n264\t\n265\tdef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n266\t    return {}\n267\t\n268\t\n269\tdef test_a_missing_callable_fails_the_build_by_stable_id():\n270\t    bindings = G.binding_inventory()\n271\t    bindings.pop(\"D98_WRITE_TERMINAL\")\n272\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n273\t        G.register_skeleton(fresh_builder(), bindings)\n274\t\n275\t\n276\tdef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n277\t    bindings = G.binding_inventory()\n278\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n279\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n280\t        G.register_skeleton(fresh_builder(), bindings)\n281\t\n282\t\n283\tdef test_a_duplicate_callable_fails_the_build_by_stable_id():\n284\t    bindings = G.binding_inventory()\n285\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n286\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n287\t        G.register_skeleton(fresh_builder(), bindings)\n288\t\n289\t\n290\tdef test_an_uncallable_binding_fails_the_build_by_stable_id():\n291\t    bindings = G.binding_inventory()\n292\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n293\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n294\t        G.register_skeleton(fresh_builder(), bindings)\n295\t\n296\t\n297\tdef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n298\t    # Pin the required set to the real skeleton so the dangling-endpoint check is\n299\t    # what rejects the edge, not the missing-binding check that shadows it.\n300\t    required = G._skeleton_required_nodes()\n301\t    monkeypatch.setattr(G, \"_skeleton_required_nodes\", lambda: required)\n302\t    monkeypatch.setattr(\n303\t        G,\n304\t        \"SKELETON_NORMAL_EDGES\",\n305\t        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n306\t    )\n307\t    with pytest.raises(G.GraphBindingError, match=r\"N20-EDGE-DANGLING:D99_NOT_A_NODE\"):\n308\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n309\t\n310\t\n311\tdef test_a_wired_node_with_no_callable_fails_the_build_by_stable_id(monkeypatch):\n312\t    monkeypatch.setattr(\n313\t        G,\n314\t        \"SKELETON_NORMAL_EDGES\",\n315\t        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n316\t    )\n317\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D99_NOT_A_NODE\"):\n318\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n319\t\n320\t\n321\tdef test_an_unwired_undeclared_node_fails_the_build_by_stable_id(compiled, monkeypatch):\n322\t    # P-N20-001: the victim is read from the live table AND filtered against the\n323\t    # live compiled topology, not just picked as the alphabetically-first key. A\n324\t    # `DEFERRED_TOPOLOGY` entry whose node a downstream graph node has since\n325\t    # wired is no longer undeclared-and-unwired -- popping it would not\n326\t    # reproduce N20-NODE-UNDECLARED, so it is not a valid victim any more. Only\n327\t    # a key with no compiled edge at all is still what this negative case needs.\n328\t    wired_endpoints = {\n329\t        endpoint\n330\t        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n331\t        for endpoint in (source, target)\n332\t    }\n333\t    candidates = sorted(set(G.DEFERRED_TOPOLOGY) - wired_endpoints)\n334\t    assert candidates, (\n335\t        \"every DEFERRED_TOPOLOGY entry is now wired into the compiled graph, so \"\n336\t        \"this fixture needs a human decision (a real registered-but-unwired-and-\"\n337\t        \"undeclared node to pop), not a silent skip\"\n338\t    )\n339\t    node_id = candidates[0]\n340\t    deferred = dict(G.DEFERRED_TOPOLOGY)\n341\t    deferred.pop(node_id)\n342\t    monkeypatch.setattr(G, \"DEFERRED_TOPOLOGY\", deferred)\n343\t    with pytest.raises(\n344\t        G.GraphBindingError, match=rf\"N20-NODE-UNDECLARED:{re.escape(node_id)}\"\n345\t    ):\n346\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n347\t\n348\t\n349\tdef test_an_unrouted_declared_guard_value_fails_the_build_by_stable_id(monkeypatch):\n350\t    destinations = {k: dict(v) for k, v in R.GUARD_DESTINATIONS.items()}\n351\t    destinations[\"D05_SELECT_NEXT_UNIT\"].pop(\"manifest_exhausted\")\n352\t    monkeypatch.setattr(R, \"GUARD_DESTINATIONS\", destinations)\n353\t    with pytest.raises(R.RoutingViolation, match=r\"N20-GUARD-UNROUTED:D05_SELECT_NEXT_UNIT\"):\n354\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n355\t\n356\t\n357\t# ================================================= TEST 3: cycles cross a real guard\n358\t\n359\t\n360\tdef _simple_cycles(edges) -> set[frozenset[str]]:\n361\t    \"\"\"Every simple cycle of the compiled graph, as its node set.\n362\t\n363\t    Each cycle is enumerated once by only extending a path through nodes that\n364\t    sort after its entry point, so `A -> B -> A` is not also reported as\n365\t    `B -> A -> B`.\n366\t    \"\"\"\n367\t\n368\t    successors: dict[str, set[str]] = {}\n369\t    for source, target in edges:\n370\t        successors.setdefault(source, set()).add(target)\n371\t\n372\t    cycles: set[frozenset[str]] = set()\n373\t\n374\t    def walk(node, start, path):\n375\t        for target in sorted(successors.get(node, ())):\n376\t            if target == start and len(path) >= 2:\n377\t                cycles.add(frozenset(path))\n378\t            elif target not in path and target > start:\n379\t                walk(target, start, path | {target})\n380\t\n381\t    for start in sorted(successors):\n382\t        walk(start, start, {start})\n383\t    return cycles\n384\t\n385\t\n386\tdef _cycle_bounds(cycle: frozenset[str]) -> list[str]:\n387\t    \"\"\"The members of `cycle` that stop it repeating indefinitely.\n388\t\n389\t    A node bounds a cycle if it either declares an exhaustion guard value whose\n390\t    destination leaves the cycle, or dispatches a fan-out that refuses to repeat\n391\t    without a freshly staged worker projection — the guard invents no projection,\n392\t    so a further lap requires work some node committed a denominator to.\n393\t    \"\"\"\n394\t\n395\t    bounds: list[str] = []\n396\t    for node_id in sorted(cycle):\n397\t        row = R.GUARD_DESTINATIONS.get(node_id, {})\n398\t        if any(\"exhausted\" in value and row[value] not in cycle for value in row):\n399\t            bounds.append(node_id)\n400\t            continue\n401\t        if node_id not in R.FANOUT_GUARDS:\n402\t            continue\n403\t        for value in R.FANOUT_GUARDS[node_id]:\n404\t            guard, guard_node, guard_value = _send_emitting_guard(node_id, value)\n405\t            with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n406\t                guard({\"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}}})\n407\t        bounds.append(node_id)\n408\t    return bounds\n409\t\n410\t\n411\tdef test_every_cycle_in_the_compiled_graph_crosses_an_exhaustion_guard(compiled):\n412\t    \"\"\"No wired cycle can repeat forever, and none of them is a closed trap.\n413\t\n414\t    Spec 8.1 wires real loops — the M01 discovery superstep, the visual barrier's\n415\t    worker/barrier join, and (once N31/N32 land) the repair and workbook cycles.\n416\t    What the graph must never contain is a cycle with no deterministic bound, so\n417\t    this asserts the bound for every cycle that is actually compiled and holds\n418\t    the frozen guard rows the not-yet-wired cycles will close through.\n419\t    \"\"\"\n420\t\n421\t    edges = {\n422\t        (source, target)\n423\t        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n424\t        if target != END\n425\t    }\n426\t    cycles = _simple_cycles(edges)\n427\t\n428\t    # Not vacuous: spec 8.1's own discovery superstep is wired and is a cycle. It\n429\t    # runs through D90, which is where the attempt bound that closes it is committed.\n430\t    assert frozenset({\n431\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n432\t        R.ATTEMPT_RESERVATION,\n433\t        \"M01_RESEARCH_UNIT_SOURCES\",\n434\t    }) in cycles\n435\t\n436\t    for cycle in sorted(cycles, key=sorted):\n437\t        assert _cycle_bounds(cycle), (\n438\t            f\"cycle {sorted(cycle)} crosses no exhaustion guard and no fan-out \"\n439\t            \"dispatcher, so nothing stops it repeating\"\n440\t        )\n441\t        exits = {\n442\t            target\n443\t            for source, target in edges\n444\t            if source in cycle and target not in cycle\n445\t        } - {R.INTERRUPT_GATE, R.TERMINAL}\n446\t        assert exits, f\"cycle {sorted(cycle)} reaches no product node outside itself\"\n447\t\n448\t    # Every loop-closing guard row exhausts deterministically before repeating.\n449\t    for node_id in (\"D17_CLASSIFY_UNIT_FINDINGS\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"):\n450\t        assert R.GUARD_DESTINATIONS[node_id][\"convergence_exhausted\"] == R.TERMINAL\n451\t    assert R.GUARD_DESTINATIONS[\"D18_PLAN_TARGETED_UNIT_REPAIR\"][\"convergence_exhausted\"] == (\n452\t        R.TERMINAL\n453\t    )\n454\t    assert R.GUARD_DESTINATIONS[\"D90_RESERVE_MODEL_ATTEMPT\"][\"exhausted\"] == R.TERMINAL\n455\t    assert R.GUARD_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"][\"exhausted\"] == R.TERMINAL\n456\t    # The unit loop only closes back to D05 through acceptance, never directly.\n457\t    assert R.GUARD_DESTINATIONS[\"D23_CHECKPOINT_ACCEPTED_UNIT\"][\"checkpoint_correlated\"] == (\n458\t        \"D05_SELECT_NEXT_UNIT\"\n459\t    )\n460\t\n461\t\n462\t# ================================== TEST 4: models hold no acceptance/route authority\n463\t\n464\t\n465\tdef test_no_model_node_has_an_edge_to_an_authority_node(compiled):\n466\t    edges = {\n467\t        (source, target)\n468\t        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n469\t    }\n470\t    for source, target in edges:\n471\t        if source in mn.MODEL_NODE_IDS:\n472\t            assert target not in AUTHORITY_NODES, f\"model edge {source} -> {target}\"\n473\t\n474\t    for job_id, destination in R.MODEL_RESULT_DESTINATIONS.items():\n475\t        assert job_id in mn.MODEL_NODE_IDS\n476\t        assert destination not in AUTHORITY_NODES, (job_id, destination)\n477\t\n478\t    # M01's two supersteps are the remaining model successors.\n479\t    assert R.route_m01_research({\"source_discoveries\": {\"k\": {}}}) == (\n480\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n481\t    )\n482\t    assert R.route_m01_research({\"source_interpretations\": {\"k\": {}}}) == (\n483\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n484\t    )\n485\t    for destination in (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"):\n486\t        assert destination not in AUTHORITY_NODES\n487\t\n488\t\n489\tdef test_a_model_node_holds_no_acceptance_reduction_or_terminal_channel_authority():\n490\t    \"\"\"Where the authority actually lives: the channels a model may write.\n491\t\n492\t    `M05 -> D16` is a legal edge precisely because M05 cannot write the reduction\n493\t    result, the accepted receipt, any artifact head, or the terminal — D16\n494\t    recomputes the denominator from evidence it does not control.\n495\t    \"\"\"\n496\t\n497\t    forbidden = {\n498\t        \"artifact_heads\",\n499\t        \"accepted_unit_receipts\",\n500\t        \"accepted_unit_checkpoint_receipts\",\n501\t        \"deterministic_checks\",\n502\t        \"workbook_head\",\n503\t        \"final_release_audits\",\n504\t        \"cursor\",\n505\t        \"resume_frontier\",\n506\t        \"terminal\",\n507\t        \"terminal_history\",\n508\t        \"terminal_candidate\",\n509\t    }\n510\t    assert mn.MODEL_NODE_WRITABLE_FIELDS & forbidden == set()\n511\t    assert forbidden <= set(FACTORY_STATE_FIELDS)\n512\t    assert mn.FORBIDDEN_MODEL_NODE_FIELDS & mn.MODEL_NODE_WRITABLE_FIELDS == set()\n513\t\n514\t    # The reducers that consume a review are deterministic nodes, and their\n515\t    # destinations are decided by the code-owned table, not by the review body.\n516\t    assert R.GUARD_DESTINATIONS[\"D16_REDUCE_UNIT_EVIDENCE\"] == {\n517\t        \"unit_denominator_passed\": \"D22_ACCEPT_UNIT\",\n518\t        \"unit_findings_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n519\t    }\n520\t    assert R.GUARD_DESTINATIONS[\"D28_REDUCE_WORKBOOK_EVIDENCE\"] == {\n521\t        \"workbook_denominator_passed\": \"D32_RECOMPUTE_FINAL_RELEASE\",\n522\t        \"workbook_findings_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n523\t    }\n524\t\n525\t\n526\tdef test_routing_never_lets_a_model_result_name_its_own_destination():\n527\t    \"\"\"A guard reads code-owned tables and result *presence*, never a model body.\"\"\"\n528\t\n529\t    tree = ast.parse(ROUTING_PY.read_text(encoding=\"utf-8\"))\n530\t    model_result_guards = {\n531\t        \"_route_model_result\",\n532\t        \"route_m01_research\",\n533\t        \"route_m02_domain\",\n534\t        \"route_m03_content\",\n535\t        \"route_m04_visual\",\n536\t        \"route_m05_unit_review\",\n537\t        \"route_m06_unit_repair\",\n538\t        \"route_m07_workbook_review\",\n539\t        \"route_m08_workbook_repair\",\n540\t    }\n541\t    # The only model-written channels a guard may touch, and only to test that a\n542\t    # result set exists — never to read a value out of a model's output body.\n543\t    allowed_reads = {\"source_discoveries\", \"source_interpretations\"}\n544\t    seen = set()\n545\t    for node in ast.walk(tree):\n546\t        if not isinstance(node, ast.FunctionDef) or node.name not in model_result_guards:\n547\t            continue\n548\t        seen.add(node.name)\n549\t        body = list(node.body)\n550\t        if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):\n551\t            body = body[1:]  # the docstring is prose, not behavior\n552\t        for statement in body:\n553\t            for inner in ast.walk(statement):\n554\t                if not (isinstance(inner, ast.Constant) and isinstance(inner.value, str)):\n555\t                    continue\n556\t                value = inner.value\n557\t                if value in allowed_reads:\n558\t                    continue\n559\t                assert value not in mn.MODEL_NODE_WRITABLE_FIELDS, (\n560\t                    f\"{node.name} reads model-written channel {value!r}\"\n561\t                )\n562\t                assert value in R.MODEL_RESULT_DESTINATIONS.values() or value in (\n563\t                    set(R.MODEL_RESULT_DESTINATIONS)\n564\t                    | {\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"}\n565\t                ) or \"no result set exists\" in value, (\n566\t                    f\"{node.name} names non-destination string {value!r}\"\n567\t                )\n568\t    assert seen == model_result_guards\n569\t\n570\t\n571\tdef test_a_stored_frontier_may_not_name_a_model_node():\n572\t    state = {\n573\t        \"pending_guard\": {\n574\t            \"node\": \"D92_REENTER_VALIDATED_FRONTIER\",\n575\t            \"value\": \"deterministic_reentry\",\n576\t            \"detail\": {\"destination\": \"M03_WRITE_UNIT_CONTENT\"},\n577\t        }\n578\t    }\n579\t    with pytest.raises(R.RoutingViolation, match=\"is a model node\"):\n580\t        R.route_frontier_reentry(state)\n581\t\n582\t\n583\t# ========================================== TEST 5: Send follows worker->barrier only\n584\t\n585\t\n586\tdef test_every_registered_fanout_has_the_worker_to_barrier_shape(compiled):\n587\t    \"\"\"Every compiled fan-out is worker->barrier, the only shape spec 10 allows.\n588\t\n589\t    One `Send` per staged worker projection, all naming a single worker node, and\n590\t    the worker's only forward destination is the deterministic node that owns the\n591\t    denominator — never a second fan-out and never an authority node. This is the\n592\t    same property the guard-level tests below prove in isolation, asserted here\n593\t    against the graph that actually compiled.\n594\t\n595\t    A model fan-out reaches its worker through D90, so the compiled shape is\n596\t    dispatcher -> D90 -> worker -> barrier: spec 6.2 requires the attempt counter\n597\t    committed before dispatch, and every adapter refuses an unreserved packet.\n598\t    \"\"\"\n599\t\n600\t    declared = {\n601\t        (source, value): dispatch\n602\t        for source, row in R.FANOUT_GUARDS.items()\n603\t        for value, dispatch in row.items()\n604\t    }\n605\t    assert set(FANOUT_SHAPES) == set(declared), (\n606\t        \"a fan-out guard was registered or removed without updating the shape \"\n607\t        \"table this test checks it against\"\n608\t    )\n609\t\n610\t    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n611\t    for (source, value), (dispatch_guard, worker, barrier) in sorted(FANOUT_SHAPES.items()):\n612\t        dispatch = declared[(source, value)]\n613\t        assert dispatch not in mn.MODEL_NODE_IDS, (\n614\t            f\"{source} dispatches straight to model node {dispatch} with no reservation\"\n615\t        )\n616\t        assert (source, dispatch) in edges, f\"{source} has no compiled edge to {dispatch}\"\n617\t        if dispatch == R.ATTEMPT_RESERVATION:\n618\t            assert (dispatch, worker) in edges, f\"D90 has no compiled edge to worker {worker}\"\n619\t        else:\n620\t            assert dispatch == worker\n621\t        assert (worker, barrier) in edges, f\"worker {worker} has no compiled edge to {barrier}\"\n622\t        assert barrier not in mn.MODEL_NODE_IDS, f\"{barrier} is a model node, not a barrier\"\n623\t\n624\t        projections = [{\"key\": f\"{source}/{index}\"} for index in range(3)]\n625\t        packet = {\"dispatch\": worker, \"packets\": projections}\n626\t        routed = dispatch_guard(\n627\t            {\"pending_guard\": {\"node\": source, \"value\": value, \"detail\": {}},\n628\t             \"pending_packet\": packet}\n629\t        )\n630\t        if dispatch == R.ATTEMPT_RESERVATION:\n631\t            assert routed == R.ATTEMPT_RESERVATION\n632\t\n633\t        emitting, guard_node, guard_value = _send_emitting_guard(source, value)\n634\t        sends = emitting(\n635\t            {\n636\t                \"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}},\n637\t                \"pending_packet\": packet,\n638\t            }\n639\t        )\n640\t        assert [type(item) for item in sends] == [Send, Send, Send]\n641\t        assert {item.node for item in sends} == {worker}\n642\t        assert [item.arg for item in sends] == projections\n643\t\n644\t    # A worker's forward successors are exactly the barriers declared for it, so\n645\t    # a fanned-out worker rejoins a denominator and fans out no further. D91 is\n646\t    # excluded with the other non-forward edges: a model worker's failure edge is\n647\t    # a recovery edge, not a second barrier.\n648\t    barriers: dict[str, set[str]] = {}\n649\t    for _guard, worker, barrier in FANOUT_SHAPES.values():\n650\t        barriers.setdefault(worker, set()).add(barrier)\n651\t    for worker, expected in sorted(barriers.items()):\n652\t        successors = {target for source, target in edges if source == worker} - {\n653\t            R.INTERRUPT_GATE,\n654\t            R.TERMINAL,\n655\t            R.MODEL_FAILURE_CLASSIFIER,\n656\t            END,\n657\t        }\n658\t        assert successors == expected, (worker, sorted(successors), sorted(expected))\n659\t\n660\t\n661\tdef test_no_compiled_edge_enters_a_model_node_except_from_d90(compiled):\n662\t    \"\"\"Spec 6.2 D90: the attempt counter is committed *before* dispatch.\n663\t\n664\t    The counter cannot be minted by the dispatching node (it would be committed\n665\t    in the same superstep as the dispatch) nor invented at routing time, so the\n666\t    only compiled predecessor a model worker may have is D90. Every N23 adapter\n667\t    enforces the same rule from the other side by raising `AttemptNotReserved`.\n668\t    \"\"\"\n669\t\n670\t    for node_id, row in R.GUARD_DESTINATIONS.items():\n671\t        for value, destination in row.items():\n672\t            assert destination not in mn.MODEL_NODE_IDS, (\n673\t                f\"{node_id}.{value} routes to {destination} with no reservation\"\n674\t            )\n675\t\n676\t    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n677\t    entered = {target for _source, target in edges if target in mn.MODEL_NODE_IDS}\n678\t    assert entered, \"no model node is wired, so this would pass vacuously\"\n679\t    for worker in sorted(entered):\n680\t        predecessors = {source for source, target in edges if target == worker}\n681\t        assert predecessors == {R.ATTEMPT_RESERVATION}, (worker, sorted(predecessors))\n682\t\n683\t\n684\tdef test_a_fanout_guard_emits_one_send_per_staged_worker_projection():\n685\t    packet = {\n686\t        \"dispatch\": \"M04_CREATE_UNIT_VISUALS\",\n687\t        \"briefs\": [{\"key\": \"u1/visual/a\"}, {\"key\": \"u1/visual/b\"}],\n688\t    }\n689\t    # The dispatcher hands the staged map to D90 rather than to the worker: no\n690\t    # `Send` may be emitted before the attempt counter is committed (spec 6.2).\n691\t    assert R.route_visual_barrier(\n692\t        {\n693\t            \"pending_guard\": {\n694\t                \"node\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n695\t                \"value\": \"model_visual_fanout\",\n696\t                \"detail\": {},\n697\t            },\n698\t            \"pending_packet\": packet,\n699\t        }\n700\t    ) == R.ATTEMPT_RESERVATION\n701\t\n702\t    sends = R.route_attempt_reservation(\n703\t        {\n704\t            \"pending_guard\": {\n705\t                \"node\": R.ATTEMPT_RESERVATION,\n706\t                \"value\": \"authorized\",\n707\t                \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n708\t            },\n709\t            \"pending_packet\": packet,\n710\t        }\n711\t    )\n712\t    assert [type(item) for item in sends] == [Send, Send]\n713\t    assert {item.node for item in sends} == {\"M04_CREATE_UNIT_VISUALS\"}\n714\t    assert [item.arg[\"key\"] for item in sends] == [\"u1/visual/a\", \"u1/visual/b\"]\n715\t    # Worker -> barrier: the worker's declared return destination is the barrier\n716\t    # that owns the denominator, which is a normal edge, not another Send.\n717\t    assert R.MODEL_RESULT_DESTINATIONS[\"M04_CREATE_UNIT_VISUALS\"] == (\n718\t        \"D12_VISUAL_BARRIER_AND_JOIN\"\n719\t    )\n720\t\n721\t\n722\tdef test_a_fanout_guard_refuses_an_unstaged_or_mixed_dispatch():\n723\t    base = {\n724\t        \"pending_guard\": {\n725\t            \"node\": R.ATTEMPT_RESERVATION,\n726\t            \"value\": \"authorized\",\n727\t            \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n728\t        }\n729\t    }\n730\t    with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n731\t        R.route_attempt_reservation(dict(base))\n732\t    with pytest.raises(R.RoutingViolation, match=\"no dispatch destination\"):\n733\t        R.route_attempt_reservation({**base, \"pending_packet\": {\"briefs\": [{\"key\": \"a\"}]}})\n734\t    with pytest.raises(R.RoutingViolation, match=\"no non-empty worker projection\"):\n735\t        R.route_attempt_reservation(\n736\t            {**base, \"pending_packet\": {\"dispatch\": \"M04_CREATE_UNIT_VISUALS\", \"briefs\": []}}\n737\t        )\n738\t\n739\t\n740\t# ============================= TEST 6: arbitrary manifest lengths and empty subsets\n741\t\n742\t\n743\tdef test_no_curriculum_specific_manifest_length_or_order_is_hardcoded():\n744\t    for path in (GRAPH_PY, ROUTING_PY):\n745\t        source = path.read_text(encoding=\"utf-8\")\n746\t        tree = ast.parse(source)\n747\t        for node in ast.walk(tree):\n748\t            if isinstance(node, ast.Constant) and isinstance(node.value, str):\n749\t                assert not re.match(r\"^(U|L)\\d{2,}\", node.value), (\n750\t                    f\"{path.name} names curriculum unit {node.value!r}\"\n751\t                )\n752\t        for forbidden in (\n753\t            \"unit_count\",\n754\t            \"UNIT_COUNT\",\n755\t            \"MANIFEST_LENGTH\",\n756\t            \"manifest_length\",\n757\t            \"expected_units\",\n758\t        ):\n759\t            assert forbidden not in source, f\"{path.name} hardcodes {forbidden!r}\"\n760\t        # No node is created per known unit: registration reads only the frozen\n761\t        # catalogue, never a manifest.\n762\t        assert \"manifest\" not in source.replace(\"manifest_path\", \"\").replace(\n763\t            \"manifest coverage\", \"\"\n764\t        ).replace(\"MANIFEST_COVERAGE\", \"\").lower() or \"for unit\" not in source\n765\t\n766\t\n767\tdef test_the_builder_registers_a_fixed_node_set_independent_of_any_manifest(compiled):\n768\t    # P-N20-001: subset, not equality, for the same reason as the catalogue test\n769\t    # above — a downstream node's legitimate widening of the compiled graph\n770\t    # beyond `binding_inventory()` must not falsify this fixture.\n771\t    drawn = set(compiled.get_graph().nodes) - {START, END}\n772\t    skeleton_required = set(G._skeleton_required_nodes()) | set(G.binding_inventory())\n773\t    assert skeleton_required <= drawn\n774\t    assert not [node for node in drawn if re.search(r\"(unit|lesson)_\\d\", node.lower())]\n775\t\n776\t\n777\tdef test_an_empty_deterministic_visual_subset_routes_straight_to_the_barrier():\n778\t    state = {\n779\t        \"pending_guard\": {\n780\t            \"node\": \"D10_COMPILE_VISUAL_BRIEFS\",\n781\t            \"value\": \"no_deterministic_visuals\",\n782\t            \"detail\": {},\n783\t        }\n784\t    }\n785\t    assert R.route_visual_briefs(state) == \"D12_VISUAL_BARRIER_AND_JOIN\"\n786\t\n787\t\n788\tdef test_an_exhausted_manifest_routes_to_coverage_proof_at_any_length():\n789\t    state = {\n790\t        \"pending_guard\": {\n791\t            \"node\": \"D05_SELECT_NEXT_UNIT\",\n792\t            \"value\": \"manifest_exhausted\",\n793\t            \"detail\": {},\n794\t        }\n795\t    }\n796\t    assert R.route_unit_selection(state) == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n797\t\n798\t\n799\t# ================================================ TEST 7: digest stability and drift\n800\t\n801\t\n802\tdef test_identical_real_bindings_yield_an_identical_digest(output_root):\n803\t    first = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n804\t    second = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n805\t    assert first is not second\n806\t    assert G.graph_digest(first) == G.graph_digest(second)\n807\t    assert len(G.graph_digest(first)) == 64\n808\t\n809\t\n810\tdef test_a_changed_callable_changes_the_digest(compiled, monkeypatch):\n811\t    baseline = G.graph_digest(compiled)\n812\t    drifted = G.binding_inventory()\n813\t    drifted[\"D05_SELECT_NEXT_UNIT\"] = drifted[\"D13_RENDER_UNIT\"]\n814\t    monkeypatch.setattr(G, \"binding_inventory\", lambda: drifted)\n815\t    assert G.graph_digest(compiled) != baseline\n816\t\n817\t\n818\tdef test_a_changed_state_schema_changes_the_digest(compiled, monkeypatch):\n819\t    baseline = G.graph_digest(compiled)\n820\t    reducers = dict(G.FIELD_REDUCER_CLASSES)\n821\t    reducers[\"cursor\"] = \"append_unique\"\n822\t    monkeypatch.setattr(G, \"FIELD_REDUCER_CLASSES\", reducers)\n823\t    assert G.graph_digest(compiled) != baseline\n824\t\n825\t\n826\tdef test_a_changed_prompt_or_schema_file_changes_the_digest(compiled, monkeypatch, tmp_path):\n827\t    baseline = G.graph_digest(compiled)\n828\t    real = tp.resolve_prompt_path(tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\"))\n829\t    drifted = tmp_path / real.name\n830\t    drifted.write_bytes(real.read_bytes() + b\"\\n# drift\\n\")\n831\t    assert hashlib.sha256(drifted.read_bytes()).hexdigest() != (\n832\t        hashlib.sha256(real.read_bytes()).hexdigest()\n833\t    )\n834\t\n835\t    original = tp.resolve_prompt_path\n836\t\n837\t    def patched(route):\n838\t        path = original(route)\n839\t        return drifted if path.name == real.name else path\n840\t\n841\t    monkeypatch.setattr(G.tp, \"resolve_prompt_path\", patched)\n842\t    assert G.graph_digest(compiled) != baseline\n843\t\n844\t\n845\tdef test_the_digest_ignores_python_object_identity(compiled):\n846\t    payload_one = G.compiled_topology(compiled)\n847\t    payload_two = G.compiled_topology(compiled)\n848\t    assert payload_one == payload_two\n849\t    assert G._canonical_digest(payload_one) == G._canonical_digest(payload_two)\n850\t\n851\t\n852\t# ============================================ TEST 8: no handwritten fallback controller\n853\t\n854\t\n855\tdef test_production_graph_imports_contain_no_fallback_controller():\n856\t    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n857\t    imported: set[str] = set()\n858\t    for node in ast.walk(tree):\n859\t        if isinstance(node, ast.Import):\n860\t            imported.update(alias.name for alias in node.names)\n861\t        elif isinstance(node, ast.ImportFrom):\n862\t            imported.add(node.module or \"\")\n863\t            imported.update(f\"{node.module or ''}.{alias.name}\" for alias in node.names)\n864\t\n865\t    for forbidden in (\n866\t        \"runtime.curriculum_factory_graph\",\n867\t        \"curriculum_factory_graph\",\n868\t        \"CurriculumFactoryGraph\",\n869\t        \"runtime.session_bridge\",\n870\t    ):\n871\t        assert not any(forbidden in name for name in imported), forbidden\n872\t\n873\t    source = GRAPH_PY.read_text(encoding=\"utf-8\")\n874\t    for forbidden in (\"CurriculumFactoryGraph\", \"test_simulated\", \"fallback_controller\"):\n875\t        assert forbidden not in source, f\"graph.py references {forbidden!r}\"\n876\t\n877\t    # The forbidden model-invocation dependencies stay out of the production path.\n878\t    for forbidden in (\n879\t        \"langchain\",\n880\t        \"langchain_openai\",\n881\t        \"langchain_google_genai\",\n882\t        \"openai\",\n883\t        \"google.generativeai\",\n884\t    ):\n885\t        assert not any(\n886\t            name == forbidden or name.startswith(f\"{forbidden}.\") for name in imported\n887\t        ), forbidden\n888\t\n889\t\n890\tdef test_only_one_builder_and_one_compile_call_exist():\n891\t    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n892\t    builders = [\n893\t        node.name\n894\t        for node in ast.walk(tree)\n895\t        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"build_\")\n896\t        and \"graph\" in node.name\n897\t    ]\n898\t    assert builders == [\"build_curriculum_factory_graph\"]\n899\t\n900\t    compiles = [\n901\t        node\n902\t        for node in ast.walk(tree)\n903\t        if isinstance(node, ast.Call)\n904\t        and isinstance(node.func, ast.Attribute)\n905\t        and node.func.attr == \"compile\"\n906\t    ]\n907\t    assert len(compiles) == 1\n908\t\n909\t\n910\t# ================================================== boundary and context behaviour\n911\t\n912\t\n913\tdef test_the_node_boundary_injects_the_runtime_context_langgraph_would_not():\n914\t    \"\"\"LangGraph passes `Runtime`, never the opened services.\n915\t\n916\t    N22/N23 bodies take the context as an explicit second argument, so without\n917\t    this boundary every node would silently run with `runtime_context=None`.\n918\t    \"\"\"\n919\t\n920\t    seen = {}\n921\t\n922\t    def body(state, context):\n923\t        seen[\"context\"] = context\n924\t        return {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n925\t\n926\t    bound = G._boundary(\"X\", body, model_node=False)\n927\t\n928\t    class FakeRuntime:\n929\t        context = \"the-context\"\n930\t\n931\t    assert bound({}, FakeRuntime()) == {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n932\t    assert seen[\"context\"] == \"the-context\"\n933\t\n934\t\n935\tdef test_the_node_boundary_classifies_an_unexpected_exception_as_a_system_failure():\n936\t    def body(state, context):\n937\t        raise ValueError(\"unexpected\")\n938\t\n939\t    bound = G._boundary(\"X\", body, model_node=False)\n940\t\n941\t    class FakeRuntime:\n942\t        context = None\n943\t\n944\t    update = bound({}, FakeRuntime())\n945\t    assert update[\"pending_failure\"][\"class\"] == \"system\"\n946\t    assert update[\"pending_failure\"][\"cause\"] == \"unhandled\"\n947\t    assert update[\"pending_guard\"] is None\n948\t    assert R.decide(\"X\", update) == R.TERMINAL\n949\t\n950\t\n951\tdef test_a_graceful_signal_at_the_boundary_routes_through_the_interrupt_gate():\n952\t    class Token:\n953\t        def is_set(self):\n954\t            return True\n955\t\n956\t    class FakeRuntime:\n957\t        class context:\n958\t            signal_token = Token()\n959\t\n960\t    def body(state, context):\n961\t        return {\"pending_guard\": {\"node\": \"D01_VALIDATE_AND_FREEZE_INPUTS\", \"value\": \"inputs_frozen\"}}\n962\t\n963\t    update = G._boundary(\"D01_VALIDATE_AND_FREEZE_INPUTS\", body, model_node=False)({}, FakeRuntime())\n964\t    assert update[\"pending_guard\"][\"interrupt_requested\"] is True\n965\t    assert R.route_frozen_inputs(update) == R.INTERRUPT_GATE\n966\t\n967\t\n968\tdef test_a_classified_failure_outranks_a_graceful_interrupt():\n969\t    state = {\n970\t        \"pending_failure\": {\"class\": \"system\", \"cause\": \"integrity\"},\n971\t        \"pending_guard\": {\"node\": \"D01\", \"value\": None, \"interrupt_requested\": True},\n972\t    }\n973\t    assert R.route_frozen_inputs(state) == R.TERMINAL\n974\t\n975\t\n976\tdef test_an_undeclared_guard_value_raises_rather_than_routing():\n977\t    state = {\"pending_guard\": {\"node\": \"D05_SELECT_NEXT_UNIT\", \"value\": \"invented\"}}\n978\t    with pytest.raises(R.RoutingViolation, match=\"undeclared guard value\"):\n979\t        R.route_unit_selection(state)\n980\t\n981\t\n982\tdef test_every_declared_guard_value_of_every_owned_node_has_a_destination():\n983\t    R.assert_guard_table_total(NODE_CATALOGUE)\n984\t    for node_id, spec in NODE_CATALOGUE.items():\n985\t        for value in spec.guards:\n986\t            if (node_id, value) in R.NORMAL_EDGE_GUARDS:\n987\t                continue\n988\t            assert (\n989\t                value in R.GUARD_DESTINATIONS.get(node_id, {})\n990\t                or value in R.DYNAMIC_GUARDS.get(node_id, {})\n991\t                or value in R.FANOUT_GUARDS.get(node_id, {})\n992\t            ), (node_id, value)\n993\t\n994\t\n995\tdef test_the_runtime_context_factory_holds_no_model_client_or_routing_authority(tmp_path):\n996\t    context = G.build_runtime_context(\n997\t        engine_root=REPO_ROOT,\n998\t        output_root=tmp_path,\n999\t        run_id=\"run-topology\",\n1000\t        curriculum_digest=\"0\" * 64,\n1001\t    )\n1002\t    assert isinstance(context, RuntimeContext)\n1003\t    for forbidden in (\"model_client\", \"llm\", \"router\", \"routing_authority\", \"state\"):\n1004\t        assert not hasattr(context, forbidden)\n1005\t    assert isinstance(context.transport_registry, tp.CliTransport)\n1006\t    assert not isinstance(context.transport_registry, tp.FakeCliTransport)\n1007\t    assert callable(context.clock)\n1008\t"}]},"parent_tool_use_id":null,"session_id":"ecb92824-fcd4-43ba-98d1-1ef83779793e","uuid":"075bc0e6-0e3b-4802-b6b2-2d3b48141306","timestamp":"2026-08-13T00:01:32.081Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N20_GRAPH_COMPILER/attempt-20260813T000113.051334Z-9295ad0812/repo/tests/runtime/test_plan26_topology.py","content":"\"\"\"Plan 26 topology gate (spec sections 3.3, 4, 8): N20's compiled skeleton.\n\nEvery assertion here runs against a real `StateGraph`/`CompiledStateGraph` built\nfrom the real N22/N23 callables. Nothing is mocked: a simulated compilation\nwould prove that a stand-in compiles, which is the one thing this file exists to\nrule out.\n\nScope. N20 registers the fixed skeleton:\n\n    START -> D00 -> {D01 -> D02, D00R} -> D03 -> D04 -> {D05, D92}\n    D00 -> D96 -> D98 -> END        (orphan recovery)\n\nN30 has since registered the per-unit path (D05-D15 with its source and visual\n`Send` map/reduce) into the same builder, and N31/N32 still owe the repair,\nacceptance, and workbook branches. So these tests assert N20's properties —\nbinding rejection by stable ID, bounded cycles, worker->barrier fan-out shape,\nmodel nodes holding no routing or acceptance authority — against whatever\ntopology is actually compiled now, rather than against a frozen skeleton\nsnapshot that a later graph node would falsify by doing its job.\n\nSkips only where the hash-locked environment is absent; the node's evidence was\nproduced by running this file inside it.\n\"\"\"\n\nimport ast\nimport hashlib\nimport re\nimport shutil\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\ntry:  # pragma: no cover - environment probe, not behavior\n    import langgraph  # noqa: F401\n    import langgraph.checkpoint.sqlite  # noqa: F401\nexcept ModuleNotFoundError as exc:  # pragma: no cover\n    raise unittest.SkipTest(\n        \"plan26 hash-locked environment not installed \"\n        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n        f\"{exc}\"\n    ) from exc\n\nimport pytest\nfrom langgraph._internal._constants import RESERVED\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.graph.state import CompiledStateGraph\nfrom langgraph.types import Send\n\nfrom runtime.langgraph_factory import graph as G\nfrom runtime.langgraph_factory import model_nodes as mn\nfrom runtime.langgraph_factory import routing as R\nfrom runtime.langgraph_factory import transport as tp\nfrom runtime.langgraph_factory.nodes import NODE_CATALOGUE, node_registry\nfrom runtime.langgraph_factory.state import (\n    FACTORY_STATE_FIELDS,\n    FactoryInput,\n    FactoryOutput,\n    FactoryState,\n    RuntimeContext,\n)\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nGRAPH_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"graph.py\"\nROUTING_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"routing.py\"\n\n# Spec 8.1: \"There is no edge from a model directly to acceptance, terminal,\n# checkpoint initialization, unit selection, workbook assembly, or release\",\n# plus resume re-entry (spec 6.2 D92 forbids a model as a stored destination).\n#\n# The reduction nodes D16/D28 are deliberately NOT here: spec 8.1 wires\n# `M05 -> D16` and `M07 -> D28` on purpose, because a review is *evidence for*\n# the code-computed denominator, not the reduction itself. \"Models hold no\n# reduction authority\" is proven below as a channel-authority property, which is\n# where that authority actually lives.\nAUTHORITY_NODES = frozenset({\n    \"D04_INITIALIZE_OR_RESUME\",\n    \"D05_SELECT_NEXT_UNIT\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n    \"D25_ASSEMBLE_WORKBOOK\",\n    \"D32_RECOMPUTE_FINAL_RELEASE\",\n    \"D92_REENTER_VALIDATED_FRONTIER\",\n    \"D98_WRITE_TERMINAL\",\n    END,\n})\n\n# (dispatching node, fan-out guard value) -> (dispatching guard, worker, barrier).\n# The barrier is the deterministic node that owns the fan-out's denominator and to\n# which the worker returns; for M01 that is the next node of whichever superstep\n# the phase advance selects. A model fan-out's dispatching guard resolves to D90,\n# not to the worker: the `Send`s are emitted by D90's guard, from the packet D90\n# restaged with one committed attempt reservation per member.\nFANOUT_SHAPES = {\n    (\"D06_COMPILE_SOURCE_REQUESTS\", \"discovery_fanout\"): (\n        R.route_source_discovery_fanout,\n        \"M01_RESEARCH_UNIT_SOURCES\",\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n    ),\n    (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"interpretation_fanout\"): (\n        R.route_source_interpretation_fanout,\n        \"M01_RESEARCH_UNIT_SOURCES\",\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    ),\n    (\"D10_COMPILE_VISUAL_BRIEFS\", \"deterministic_visual_fanout\"): (\n        R.route_visual_briefs,\n        \"D11_CREATE_DETERMINISTIC_VISUALS\",\n        \"D12_VISUAL_BARRIER_AND_JOIN\",\n    ),\n    (\"D12_VISUAL_BARRIER_AND_JOIN\", \"model_visual_fanout\"): (\n        R.route_visual_barrier,\n        \"M04_CREATE_UNIT_VISUALS\",\n        \"D12_VISUAL_BARRIER_AND_JOIN\",\n    ),\n}\n\n\ndef _send_emitting_guard(source: str, value: str):\n    \"\"\"The guard that actually emits the `Send`s for this fan-out, and its record.\n\n    For a model fan-out that is D90's guard reading D90's restaged packet, because\n    spec 6.2 requires the attempt counter to be committed before dispatch; for a\n    deterministic fan-out it is the dispatching node's own guard.\n    \"\"\"\n\n    if R.FANOUT_GUARDS[source][value] == R.ATTEMPT_RESERVATION:\n        return R.route_attempt_reservation, R.ATTEMPT_RESERVATION, \"authorized\"\n    return FANOUT_SHAPES[(source, value)][0], source, value\n\n\n@pytest.fixture(scope=\"module\")\ndef output_root():\n    root = Path(tempfile.mkdtemp(prefix=\"plan26_n20_topology_\"))\n    yield root\n    shutil.rmtree(root, ignore_errors=True)\n\n\n@pytest.fixture(scope=\"module\")\ndef compiled(output_root) -> CompiledStateGraph:\n    return G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n\n\ndef fresh_builder() -> StateGraph:\n    return StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n\n\n# ======================================================= state/channel precondition\n\n\ndef test_the_state_schema_declares_no_langgraph_reserved_channel_name():\n    \"\"\"A reserved channel name makes the production state schema uncompilable.\n\n    LangGraph 1.2.9 rejects `checkpoint_ns` (and `checkpoint_id`, `configurable`,\n    ...) as channel names in `validate_graph`, so any such field in\n    `FactoryState` fails compilation of the one production graph.\n    \"\"\"\n\n    clashes = sorted(set(FACTORY_STATE_FIELDS) & set(RESERVED))\n    assert clashes == [], (\n        f\"FactoryState declares LangGraph-reserved channel name(s) {clashes}; \"\n        f\"owner N11_STATE_REDUCERS (rework edge `state_or_reducer`)\"\n    )\n\n\n# ====================================================== TEST 1: the catalogue compiles\n\n\ndef test_the_available_catalogue_compiles_against_real_node_callables(compiled):\n    bindings = G.binding_inventory()\n    registry = node_registry()\n\n    assert compiled.name == G.GRAPH_NAME == \"plan26_curriculum_factory\"\n    assert isinstance(compiled, CompiledStateGraph)\n\n    # 22 deterministic bodies (N22) + 8 model adapters + D90/D91 (N23), all real\n    # callables.\n    assert set(registry) == set(NODE_CATALOGUE)\n    assert len(registry) == 22\n    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n    assert set(mn.MODEL_BOOKKEEPING_NODES) == {R.ATTEMPT_RESERVATION, R.MODEL_FAILURE_CLASSIFIER}\n    assert set(bindings) == (\n        set(registry) | set(mn.MODEL_NODE_ADAPTERS) | set(mn.MODEL_BOOKKEEPING_NODES)\n    )\n    assert len(bindings) == 32\n\n    # P-N20-001 (root cause: N90 finding F1, closed by N31's approved rework\n    # P-N31-001): once a downstream graph node correctly wires D16-D23/M06 into\n    # the one production graph, the compiled node set is wider than\n    # `binding_inventory()` by design — D16-D23 carry no `NODE_CATALOGUE` row\n    # and were never part of that function's contract (see its own docstring).\n    # This asserts the invariant that actually holds in every generation: every\n    # node this node's own skeleton requires, plus everything `binding_\n    # inventory()` declares, is present in the compiled graph. A genuinely\n    # missing or wrong skeleton node still fails this.\n    drawn = compiled.get_graph()\n    compiled_nodes = set(drawn.nodes) - {START, END}\n    skeleton_required = set(G._skeleton_required_nodes()) | set(bindings)\n    assert skeleton_required <= compiled_nodes, sorted(skeleton_required - compiled_nodes)\n\n    for node_id, body in bindings.items():\n        module = G._binding_record(node_id, body)[\"module\"]\n        assert module.startswith(\"runtime.langgraph_factory.\"), (node_id, module)\n\n\ndef test_start_has_exactly_one_edge_and_d98_is_the_only_registered_end_edge(compiled):\n    drawn = compiled.get_graph()\n    starts = [edge for edge in drawn.edges if edge.source == START]\n    assert [edge.target for edge in starts] == [\"D00_BOOTSTRAP_EPISODE\"]\n\n    registered_end_sources = sorted(\n        source for source, target in G.SKELETON_NORMAL_EDGES if target == END\n    )\n    assert registered_end_sources == [\"D98_WRITE_TERMINAL\"]\n\n    # D98's body is the real N22-owned terminal writer, not a local shim.\n    d98 = node_registry()[\"D98_WRITE_TERMINAL\"]\n    assert G._binding_record(\"D98_WRITE_TERMINAL\", d98)[\"module\"] == (\n        \"runtime.langgraph_factory.nodes.terminal\"\n    )\n\n    # LangGraph draws a dead-end node as reaching END. In this skeleton the only\n    # such nodes are the frontier N30 still owes; nothing else leaks to END.\n    drawn_end = {edge.source for edge in drawn.edges if edge.target == END}\n    assert drawn_end - {\"D98_WRITE_TERMINAL\"} <= set(G.DEFERRED_TOPOLOGY)\n    for node_id in drawn_end - {\"D98_WRITE_TERMINAL\"}:\n        assert G.DEFERRED_TOPOLOGY[node_id] == \"N30_UNIT_GRAPH\"\n\n\ndef test_the_skeleton_wires_exactly_the_declared_edges(compiled):\n    topology = G.compiled_topology(compiled)\n    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n\n    for source, target in (\n        (START, \"D00_BOOTSTRAP_EPISODE\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n        (\"D98_WRITE_TERMINAL\", END),\n    ):\n        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n\n    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n    # single successor are the whole of it.\n    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n        \"D98_WRITE_TERMINAL\"\n    }\n\n\n# ============================================ TEST 2: bad bindings fail by stable ID\n\n\ndef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n    return {}\n\n\ndef test_a_missing_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings.pop(\"D98_WRITE_TERMINAL\")\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_duplicate_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_an_uncallable_binding_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n    # Pin the required set to the real skeleton so the dangling-endpoint check is\n    # what rejects the edge, not the missing-binding check that shadows it.\n    required = G._skeleton_required_nodes()\n    monkeypatch.setattr(G, \"_skeleton_required_nodes\", lambda: required)\n    monkeypatch.setattr(\n        G,\n        \"SKELETON_NORMAL_EDGES\",\n        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n    )\n    with pytest.raises(G.GraphBindingError, match=r\"N20-EDGE-DANGLING:D99_NOT_A_NODE\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_a_wired_node_with_no_callable_fails_the_build_by_stable_id(monkeypatch):\n    monkeypatch.setattr(\n        G,\n        \"SKELETON_NORMAL_EDGES\",\n        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n    )\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D99_NOT_A_NODE\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_an_unwired_undeclared_node_fails_the_build_by_stable_id(compiled, monkeypatch):\n    # P-N20-001: the victim is read from the live table AND filtered against the\n    # live compiled topology, not just picked as the alphabetically-first key. A\n    # `DEFERRED_TOPOLOGY` entry whose node a downstream graph node has since\n    # wired is no longer undeclared-and-unwired -- popping it would not\n    # reproduce N20-NODE-UNDECLARED, so it is not a valid victim any more. Only\n    # a key with no compiled edge at all is still what this negative case needs.\n    wired_endpoints = {\n        endpoint\n        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n        for endpoint in (source, target)\n    }\n    candidates = sorted(set(G.DEFERRED_TOPOLOGY) - wired_endpoints)\n    assert candidates, (\n        \"every DEFERRED_TOPOLOGY entry is now wired into the compiled graph, so \"\n        \"this fixture needs a human decision (a real registered-but-unwired-and-\"\n        \"undeclared node to pop), not a silent skip\"\n    )\n    node_id = candidates[0]\n    deferred = dict(G.DEFERRED_TOPOLOGY)\n    deferred.pop(node_id)\n    monkeypatch.setattr(G, \"DEFERRED_TOPOLOGY\", deferred)\n    with pytest.raises(\n        G.GraphBindingError, match=rf\"N20-NODE-UNDECLARED:{re.escape(node_id)}\"\n    ):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_an_unrouted_declared_guard_value_fails_the_build_by_stable_id(monkeypatch):\n    destinations = {k: dict(v) for k, v in R.GUARD_DESTINATIONS.items()}\n    destinations[\"D05_SELECT_NEXT_UNIT\"].pop(\"manifest_exhausted\")\n    monkeypatch.setattr(R, \"GUARD_DESTINATIONS\", destinations)\n    with pytest.raises(R.RoutingViolation, match=r\"N20-GUARD-UNROUTED:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\n# ================================================= TEST 3: cycles cross a real guard\n\n\ndef _simple_cycles(edges) -> set[frozenset[str]]:\n    \"\"\"Every simple cycle of the compiled graph, as its node set.\n\n    Each cycle is enumerated once by only extending a path through nodes that\n    sort after its entry point, so `A -> B -> A` is not also reported as\n    `B -> A -> B`.\n    \"\"\"\n\n    successors: dict[str, set[str]] = {}\n    for source, target in edges:\n        successors.setdefault(source, set()).add(target)\n\n    cycles: set[frozenset[str]] = set()\n\n    def walk(node, start, path):\n        for target in sorted(successors.get(node, ())):\n            if target == start and len(path) >= 2:\n                cycles.add(frozenset(path))\n            elif target not in path and target > start:\n                walk(target, start, path | {target})\n\n    for start in sorted(successors):\n        walk(start, start, {start})\n    return cycles\n\n\ndef _cycle_bounds(cycle: frozenset[str]) -> list[str]:\n    \"\"\"The members of `cycle` that stop it repeating indefinitely.\n\n    A node bounds a cycle if it either declares an exhaustion guard value whose\n    destination leaves the cycle, or dispatches a fan-out that refuses to repeat\n    without a freshly staged worker projection — the guard invents no projection,\n    so a further lap requires work some node committed a denominator to.\n    \"\"\"\n\n    bounds: list[str] = []\n    for node_id in sorted(cycle):\n        row = R.GUARD_DESTINATIONS.get(node_id, {})\n        if any(\"exhausted\" in value and row[value] not in cycle for value in row):\n            bounds.append(node_id)\n            continue\n        if node_id not in R.FANOUT_GUARDS:\n            continue\n        for value in R.FANOUT_GUARDS[node_id]:\n            guard, guard_node, guard_value = _send_emitting_guard(node_id, value)\n            with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n                guard({\"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}}})\n        bounds.append(node_id)\n    return bounds\n\n\ndef test_every_cycle_in_the_compiled_graph_crosses_an_exhaustion_guard(compiled):\n    \"\"\"No wired cycle can repeat forever, and none of them is a closed trap.\n\n    Spec 8.1 wires real loops — the M01 discovery superstep, the visual barrier's\n    worker/barrier join, and (once N31/N32 land) the repair and workbook cycles.\n    What the graph must never contain is a cycle with no deterministic bound, so\n    this asserts the bound for every cycle that is actually compiled and holds\n    the frozen guard rows the not-yet-wired cycles will close through.\n    \"\"\"\n\n    edges = {\n        (source, target)\n        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n        if target != END\n    }\n    cycles = _simple_cycles(edges)\n\n    # Not vacuous: spec 8.1's own discovery superstep is wired and is a cycle. It\n    # runs through D90, which is where the attempt bound that closes it is committed.\n    assert frozenset({\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n        R.ATTEMPT_RESERVATION,\n        \"M01_RESEARCH_UNIT_SOURCES\",\n    }) in cycles\n\n    for cycle in sorted(cycles, key=sorted):\n        assert _cycle_bounds(cycle), (\n            f\"cycle {sorted(cycle)} crosses no exhaustion guard and no fan-out \"\n            \"dispatcher, so nothing stops it repeating\"\n        )\n        exits = {\n            target\n            for source, target in edges\n            if source in cycle and target not in cycle\n        } - {R.INTERRUPT_GATE, R.TERMINAL}\n        assert exits, f\"cycle {sorted(cycle)} reaches no product node outside itself\"\n\n    # Every loop-closing guard row exhausts deterministically before repeating.\n    for node_id in (\"D17_CLASSIFY_UNIT_FINDINGS\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"):\n        assert R.GUARD_DESTINATIONS[node_id][\"convergence_exhausted\"] == R.TERMINAL\n    assert R.GUARD_DESTINATIONS[\"D18_PLAN_TARGETED_UNIT_REPAIR\"][\"convergence_exhausted\"] == (\n        R.TERMINAL\n    )\n    assert R.GUARD_DESTINATIONS[\"D90_RESERVE_MODEL_ATTEMPT\"][\"exhausted\"] == R.TERMINAL\n    assert R.GUARD_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"][\"exhausted\"] == R.TERMINAL\n    # The unit loop only closes back to D05 through acceptance, never directly.\n    assert R.GUARD_DESTINATIONS[\"D23_CHECKPOINT_ACCEPTED_UNIT\"][\"checkpoint_correlated\"] == (\n        \"D05_SELECT_NEXT_UNIT\"\n    )\n\n\n# ================================== TEST 4: models hold no acceptance/route authority\n\n\ndef test_no_model_node_has_an_edge_to_an_authority_node(compiled):\n    edges = {\n        (source, target)\n        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n    }\n    for source, target in edges:\n        if source in mn.MODEL_NODE_IDS:\n            assert target not in AUTHORITY_NODES, f\"model edge {source} -> {target}\"\n\n    for job_id, destination in R.MODEL_RESULT_DESTINATIONS.items():\n        assert job_id in mn.MODEL_NODE_IDS\n        assert destination not in AUTHORITY_NODES, (job_id, destination)\n\n    # M01's two supersteps are the remaining model successors.\n    assert R.route_m01_research({\"source_discoveries\": {\"k\": {}}}) == (\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n    )\n    assert R.route_m01_research({\"source_interpretations\": {\"k\": {}}}) == (\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n    )\n    for destination in (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"):\n        assert destination not in AUTHORITY_NODES\n\n\ndef test_a_model_node_holds_no_acceptance_reduction_or_terminal_channel_authority():\n    \"\"\"Where the authority actually lives: the channels a model may write.\n\n    `M05 -> D16` is a legal edge precisely because M05 cannot write the reduction\n    result, the accepted receipt, any artifact head, or the terminal — D16\n    recomputes the denominator from evidence it does not control.\n    \"\"\"\n\n    forbidden = {\n        \"artifact_heads\",\n        \"accepted_unit_receipts\",\n        \"accepted_unit_checkpoint_receipts\",\n        \"deterministic_checks\",\n        \"workbook_head\",\n        \"final_release_audits\",\n        \"cursor\",\n        \"resume_frontier\",\n        \"terminal\",\n        \"terminal_history\",\n        \"terminal_candidate\",\n    }\n    assert mn.MODEL_NODE_WRITABLE_FIELDS & forbidden == set()\n    assert forbidden <= set(FACTORY_STATE_FIELDS)\n    assert mn.FORBIDDEN_MODEL_NODE_FIELDS & mn.MODEL_NODE_WRITABLE_FIELDS == set()\n\n    # The reducers that consume a review are deterministic nodes, and their\n    # destinations are decided by the code-owned table, not by the review body.\n    assert R.GUARD_DESTINATIONS[\"D16_REDUCE_UNIT_EVIDENCE\"] == {\n        \"unit_denominator_passed\": \"D22_ACCEPT_UNIT\",\n        \"unit_findings_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    }\n    assert R.GUARD_DESTINATIONS[\"D28_REDUCE_WORKBOOK_EVIDENCE\"] == {\n        \"workbook_denominator_passed\": \"D32_RECOMPUTE_FINAL_RELEASE\",\n        \"workbook_findings_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n    }\n\n\ndef test_routing_never_lets_a_model_result_name_its_own_destination():\n    \"\"\"A guard reads code-owned tables and result *presence*, never a model body.\"\"\"\n\n    tree = ast.parse(ROUTING_PY.read_text(encoding=\"utf-8\"))\n    model_result_guards = {\n        \"_route_model_result\",\n        \"route_m01_research\",\n        \"route_m02_domain\",\n        \"route_m03_content\",\n        \"route_m04_visual\",\n        \"route_m05_unit_review\",\n        \"route_m06_unit_repair\",\n        \"route_m07_workbook_review\",\n        \"route_m08_workbook_repair\",\n    }\n    # The only model-written channels a guard may touch, and only to test that a\n    # result set exists — never to read a value out of a model's output body.\n    allowed_reads = {\"source_discoveries\", \"source_interpretations\"}\n    seen = set()\n    for node in ast.walk(tree):\n        if not isinstance(node, ast.FunctionDef) or node.name not in model_result_guards:\n            continue\n        seen.add(node.name)\n        body = list(node.body)\n        if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):\n            body = body[1:]  # the docstring is prose, not behavior\n        for statement in body:\n            for inner in ast.walk(statement):\n                if not (isinstance(inner, ast.Constant) and isinstance(inner.value, str)):\n                    continue\n                value = inner.value\n                if value in allowed_reads:\n                    continue\n                assert value not in mn.MODEL_NODE_WRITABLE_FIELDS, (\n                    f\"{node.name} reads model-written channel {value!r}\"\n                )\n                assert value in R.MODEL_RESULT_DESTINATIONS.values() or value in (\n                    set(R.MODEL_RESULT_DESTINATIONS)\n                    | {\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"}\n                ) or \"no result set exists\" in value, (\n                    f\"{node.name} names non-destination string {value!r}\"\n                )\n    assert seen == model_result_guards\n\n\ndef test_a_stored_frontier_may_not_name_a_model_node():\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D92_REENTER_VALIDATED_FRONTIER\",\n            \"value\": \"deterministic_reentry\",\n            \"detail\": {\"destination\": \"M03_WRITE_UNIT_CONTENT\"},\n        }\n    }\n    with pytest.raises(R.RoutingViolation, match=\"is a model node\"):\n        R.route_frontier_reentry(state)\n\n\n# ========================================== TEST 5: Send follows worker->barrier only\n\n\ndef test_every_registered_fanout_has_the_worker_to_barrier_shape(compiled):\n    \"\"\"Every compiled fan-out is worker->barrier, the only shape spec 10 allows.\n\n    One `Send` per staged worker projection, all naming a single worker node, and\n    the worker's only forward destination is the deterministic node that owns the\n    denominator — never a second fan-out and never an authority node. This is the\n    same property the guard-level tests below prove in isolation, asserted here\n    against the graph that actually compiled.\n\n    A model fan-out reaches its worker through D90, so the compiled shape is\n    dispatcher -> D90 -> worker -> barrier: spec 6.2 requires the attempt counter\n    committed before dispatch, and every adapter refuses an unreserved packet.\n    \"\"\"\n\n    declared = {\n        (source, value): dispatch\n        for source, row in R.FANOUT_GUARDS.items()\n        for value, dispatch in row.items()\n    }\n    assert set(FANOUT_SHAPES) == set(declared), (\n        \"a fan-out guard was registered or removed without updating the shape \"\n        \"table this test checks it against\"\n    )\n\n    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n    for (source, value), (dispatch_guard, worker, barrier) in sorted(FANOUT_SHAPES.items()):\n        dispatch = declared[(source, value)]\n        assert dispatch not in mn.MODEL_NODE_IDS, (\n            f\"{source} dispatches straight to model node {dispatch} with no reservation\"\n        )\n        assert (source, dispatch) in edges, f\"{source} has no compiled edge to {dispatch}\"\n        if dispatch == R.ATTEMPT_RESERVATION:\n            assert (dispatch, worker) in edges, f\"D90 has no compiled edge to worker {worker}\"\n        else:\n            assert dispatch == worker\n        assert (worker, barrier) in edges, f\"worker {worker} has no compiled edge to {barrier}\"\n        assert barrier not in mn.MODEL_NODE_IDS, f\"{barrier} is a model node, not a barrier\"\n\n        projections = [{\"key\": f\"{source}/{index}\"} for index in range(3)]\n        packet = {\"dispatch\": worker, \"packets\": projections}\n        routed = dispatch_guard(\n            {\"pending_guard\": {\"node\": source, \"value\": value, \"detail\": {}},\n             \"pending_packet\": packet}\n        )\n        if dispatch == R.ATTEMPT_RESERVATION:\n            assert routed == R.ATTEMPT_RESERVATION\n\n        emitting, guard_node, guard_value = _send_emitting_guard(source, value)\n        sends = emitting(\n            {\n                \"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}},\n                \"pending_packet\": packet,\n            }\n        )\n        assert [type(item) for item in sends] == [Send, Send, Send]\n        assert {item.node for item in sends} == {worker}\n        assert [item.arg for item in sends] == projections\n\n    # A worker's forward successors are exactly the barriers declared for it, so\n    # a fanned-out worker rejoins a denominator and fans out no further. D91 is\n    # excluded with the other non-forward edges: a model worker's failure edge is\n    # a recovery edge, not a second barrier.\n    barriers: dict[str, set[str]] = {}\n    for _guard, worker, barrier in FANOUT_SHAPES.values():\n        barriers.setdefault(worker, set()).add(barrier)\n    for worker, expected in sorted(barriers.items()):\n        successors = {target for source, target in edges if source == worker} - {\n            R.INTERRUPT_GATE,\n            R.TERMINAL,\n            R.MODEL_FAILURE_CLASSIFIER,\n            END,\n        }\n        assert successors == expected, (worker, sorted(successors), sorted(expected))\n\n\ndef test_no_compiled_edge_enters_a_model_node_except_from_d90(compiled):\n    \"\"\"Spec 6.2 D90: the attempt counter is committed *before* dispatch.\n\n    The counter cannot be minted by the dispatching node (it would be committed\n    in the same superstep as the dispatch) nor invented at routing time, so the\n    only compiled predecessor a model worker may have is D90. Every N23 adapter\n    enforces the same rule from the other side by raising `AttemptNotReserved`.\n    \"\"\"\n\n    for node_id, row in R.GUARD_DESTINATIONS.items():\n        for value, destination in row.items():\n            assert destination not in mn.MODEL_NODE_IDS, (\n                f\"{node_id}.{value} routes to {destination} with no reservation\"\n            )\n\n    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n    entered = {target for _source, target in edges if target in mn.MODEL_NODE_IDS}\n    assert entered, \"no model node is wired, so this would pass vacuously\"\n    for worker in sorted(entered):\n        predecessors = {source for source, target in edges if target == worker}\n        assert predecessors == {R.ATTEMPT_RESERVATION}, (worker, sorted(predecessors))\n\n\ndef test_a_fanout_guard_emits_one_send_per_staged_worker_projection():\n    packet = {\n        \"dispatch\": \"M04_CREATE_UNIT_VISUALS\",\n        \"briefs\": [{\"key\": \"u1/visual/a\"}, {\"key\": \"u1/visual/b\"}],\n    }\n    # The dispatcher hands the staged map to D90 rather than to the worker: no\n    # `Send` may be emitted before the attempt counter is committed (spec 6.2).\n    assert R.route_visual_barrier(\n        {\n            \"pending_guard\": {\n                \"node\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n                \"value\": \"model_visual_fanout\",\n                \"detail\": {},\n            },\n            \"pending_packet\": packet,\n        }\n    ) == R.ATTEMPT_RESERVATION\n\n    sends = R.route_attempt_reservation(\n        {\n            \"pending_guard\": {\n                \"node\": R.ATTEMPT_RESERVATION,\n                \"value\": \"authorized\",\n                \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n            },\n            \"pending_packet\": packet,\n        }\n    )\n    assert [type(item) for item in sends] == [Send, Send]\n    assert {item.node for item in sends} == {\"M04_CREATE_UNIT_VISUALS\"}\n    assert [item.arg[\"key\"] for item in sends] == [\"u1/visual/a\", \"u1/visual/b\"]\n    # Worker -> barrier: the worker's declared return destination is the barrier\n    # that owns the denominator, which is a normal edge, not another Send.\n    assert R.MODEL_RESULT_DESTINATIONS[\"M04_CREATE_UNIT_VISUALS\"] == (\n        \"D12_VISUAL_BARRIER_AND_JOIN\"\n    )\n\n\ndef test_a_fanout_guard_refuses_an_unstaged_or_mixed_dispatch():\n    base = {\n        \"pending_guard\": {\n            \"node\": R.ATTEMPT_RESERVATION,\n            \"value\": \"authorized\",\n            \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n        }\n    }\n    with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n        R.route_attempt_reservation(dict(base))\n    with pytest.raises(R.RoutingViolation, match=\"no dispatch destination\"):\n        R.route_attempt_reservation({**base, \"pending_packet\": {\"briefs\": [{\"key\": \"a\"}]}})\n    with pytest.raises(R.RoutingViolation, match=\"no non-empty worker projection\"):\n        R.route_attempt_reservation(\n            {**base, \"pending_packet\": {\"dispatch\": \"M04_CREATE_UNIT_VISUALS\", \"briefs\": []}}\n        )\n\n\n# ============================= TEST 6: arbitrary manifest lengths and empty subsets\n\n\ndef test_no_curriculum_specific_manifest_length_or_order_is_hardcoded():\n    for path in (GRAPH_PY, ROUTING_PY):\n        source = path.read_text(encoding=\"utf-8\")\n        tree = ast.parse(source)\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Constant) and isinstance(node.value, str):\n                assert not re.match(r\"^(U|L)\\d{2,}\", node.value), (\n                    f\"{path.name} names curriculum unit {node.value!r}\"\n                )\n        for forbidden in (\n            \"unit_count\",\n            \"UNIT_COUNT\",\n            \"MANIFEST_LENGTH\",\n            \"manifest_length\",\n            \"expected_units\",\n        ):\n            assert forbidden not in source, f\"{path.name} hardcodes {forbidden!r}\"\n        # No node is created per known unit: registration reads only the frozen\n        # catalogue, never a manifest.\n        assert \"manifest\" not in source.replace(\"manifest_path\", \"\").replace(\n            \"manifest coverage\", \"\"\n        ).replace(\"MANIFEST_COVERAGE\", \"\").lower() or \"for unit\" not in source\n\n\ndef test_the_builder_registers_a_fixed_node_set_independent_of_any_manifest(compiled):\n    # P-N20-001: subset, not equality, for the same reason as the catalogue test\n    # above — a downstream node's legitimate widening of the compiled graph\n    # beyond `binding_inventory()` must not falsify this fixture.\n    drawn = set(compiled.get_graph().nodes) - {START, END}\n    skeleton_required = set(G._skeleton_required_nodes()) | set(G.binding_inventory())\n    assert skeleton_required <= drawn\n    assert not [node for node in drawn if re.search(r\"(unit|lesson)_\\d\", node.lower())]\n\n\ndef test_an_empty_deterministic_visual_subset_routes_straight_to_the_barrier():\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D10_COMPILE_VISUAL_BRIEFS\",\n            \"value\": \"no_deterministic_visuals\",\n            \"detail\": {},\n        }\n    }\n    assert R.route_visual_briefs(state) == \"D12_VISUAL_BARRIER_AND_JOIN\"\n\n\ndef test_an_exhausted_manifest_routes_to_coverage_proof_at_any_length():\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D05_SELECT_NEXT_UNIT\",\n            \"value\": \"manifest_exhausted\",\n            \"detail\": {},\n        }\n    }\n    assert R.route_unit_selection(state) == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n\n\n# ================================================ TEST 7: digest stability and drift\n\n\ndef test_identical_real_bindings_yield_an_identical_digest(output_root):\n    first = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    second = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    assert first is not second\n    assert G.graph_digest(first) == G.graph_digest(second)\n    assert len(G.graph_digest(first)) == 64\n\n\ndef test_a_changed_callable_changes_the_digest(compiled, monkeypatch):\n    baseline = G.graph_digest(compiled)\n    drifted = G.binding_inventory()\n    drifted[\"D05_SELECT_NEXT_UNIT\"] = drifted[\"D13_RENDER_UNIT\"]\n    monkeypatch.setattr(G, \"binding_inventory\", lambda: drifted)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_a_changed_state_schema_changes_the_digest(compiled, monkeypatch):\n    baseline = G.graph_digest(compiled)\n    reducers = dict(G.FIELD_REDUCER_CLASSES)\n    reducers[\"cursor\"] = \"append_unique\"\n    monkeypatch.setattr(G, \"FIELD_REDUCER_CLASSES\", reducers)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_a_changed_prompt_or_schema_file_changes_the_digest(compiled, monkeypatch, tmp_path):\n    baseline = G.graph_digest(compiled)\n    real = tp.resolve_prompt_path(tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\"))\n    drifted = tmp_path / real.name\n    drifted.write_bytes(real.read_bytes() + b\"\\n# drift\\n\")\n    assert hashlib.sha256(drifted.read_bytes()).hexdigest() != (\n        hashlib.sha256(real.read_bytes()).hexdigest()\n    )\n\n    original = tp.resolve_prompt_path\n\n    def patched(route):\n        path = original(route)\n        return drifted if path.name == real.name else path\n\n    monkeypatch.setattr(G.tp, \"resolve_prompt_path\", patched)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_the_digest_ignores_python_object_identity(compiled):\n    payload_one = G.compiled_topology(compiled)\n    payload_two = G.compiled_topology(compiled)\n    assert payload_one == payload_two\n    assert G._canonical_digest(payload_one) == G._canonical_digest(payload_two)\n\n\n# ============================================ TEST 8: no handwritten fallback controller\n\n\ndef test_production_graph_imports_contain_no_fallback_controller():\n    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n    imported: set[str] = set()\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Import):\n            imported.update(alias.name for alias in node.names)\n        elif isinstance(node, ast.ImportFrom):\n            imported.add(node.module or \"\")\n            imported.update(f\"{node.module or ''}.{alias.name}\" for alias in node.names)\n\n    for forbidden in (\n        \"runtime.curriculum_factory_graph\",\n        \"curriculum_factory_graph\",\n        \"CurriculumFactoryGraph\",\n        \"runtime.session_bridge\",\n    ):\n        assert not any(forbidden in name for name in imported), forbidden\n\n    source = GRAPH_PY.read_text(encoding=\"utf-8\")\n    for forbidden in (\"CurriculumFactoryGraph\", \"test_simulated\", \"fallback_controller\"):\n        assert forbidden not in source, f\"graph.py references {forbidden!r}\"\n\n    # The forbidden model-invocation dependencies stay out of the production path.\n    for forbidden in (\n        \"langchain\",\n        \"langchain_openai\",\n        \"langchain_google_genai\",\n        \"openai\",\n        \"google.generativeai\",\n    ):\n        assert not any(\n            name == forbidden or name.startswith(f\"{forbidden}.\") for name in imported\n        ), forbidden\n\n\ndef test_only_one_builder_and_one_compile_call_exist():\n    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n    builders = [\n        node.name\n        for node in ast.walk(tree)\n        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"build_\")\n        and \"graph\" in node.name\n    ]\n    assert builders == [\"build_curriculum_factory_graph\"]\n\n    compiles = [\n        node\n        for node in ast.walk(tree)\n        if isinstance(node, ast.Call)\n        and isinstance(node.func, ast.Attribute)\n        and node.func.attr == \"compile\"\n    ]\n    assert len(compiles) == 1\n\n\n# ================================================== boundary and context behaviour\n\n\ndef test_the_node_boundary_injects_the_runtime_context_langgraph_would_not():\n    \"\"\"LangGraph passes `Runtime`, never the opened services.\n\n    N22/N23 bodies take the context as an explicit second argument, so without\n    this boundary every node would silently run with `runtime_context=None`.\n    \"\"\"\n\n    seen = {}\n\n    def body(state, context):\n        seen[\"context\"] = context\n        return {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n\n    bound = G._boundary(\"X\", body, model_node=False)\n\n    class FakeRuntime:\n        context = \"the-context\"\n\n    assert bound({}, FakeRuntime()) == {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n    assert seen[\"context\"] == \"the-context\"\n\n\ndef test_the_node_boundary_classifies_an_unexpected_exception_as_a_system_failure():\n    def body(state, context):\n        raise ValueError(\"unexpected\")\n\n    bound = G._boundary(\"X\", body, model_node=False)\n\n    class FakeRuntime:\n        context = None\n\n    update = bound({}, FakeRuntime())\n    assert update[\"pending_failure\"][\"class\"] == \"system\"\n    assert update[\"pending_failure\"][\"cause\"] == \"unhandled\"\n    assert update[\"pending_guard\"] is None\n    assert R.decide(\"X\", update) == R.TERMINAL\n\n\ndef test_a_graceful_signal_at_the_boundary_routes_through_the_interrupt_gate():\n    class Token:\n        def is_set(self):\n            return True\n\n    class FakeRuntime:\n        class context:\n            signal_token = Token()\n\n    def body(state, context):\n        return {\"pending_guard\": {\"node\": \"D01_VALIDATE_AND_FREEZE_INPUTS\", \"value\": \"inputs_frozen\"}}\n\n    update = G._boundary(\"D01_VALIDATE_AND_FREEZE_INPUTS\", body, model_node=False)({}, FakeRuntime())\n    assert update[\"pending_guard\"][\"interrupt_requested\"] is True\n    assert R.route_frozen_inputs(update) == R.INTERRUPT_GATE\n\n\ndef test_a_classified_failure_outranks_a_graceful_interrupt():\n    state = {\n        \"pending_failure\": {\"class\": \"system\", \"cause\": \"integrity\"},\n        \"pending_guard\": {\"node\": \"D01\", \"value\": None, \"interrupt_requested\": True},\n    }\n    assert R.route_frozen_inputs(state) == R.TERMINAL\n\n\ndef test_an_undeclared_guard_value_raises_rather_than_routing():\n    state = {\"pending_guard\": {\"node\": \"D05_SELECT_NEXT_UNIT\", \"value\": \"invented\"}}\n    with pytest.raises(R.RoutingViolation, match=\"undeclared guard value\"):\n        R.route_unit_selection(state)\n\n\ndef test_every_declared_guard_value_of_every_owned_node_has_a_destination():\n    R.assert_guard_table_total(NODE_CATALOGUE)\n    for node_id, spec in NODE_CATALOGUE.items():\n        for value in spec.guards:\n            if (node_id, value) in R.NORMAL_EDGE_GUARDS:\n                continue\n            assert (\n                value in R.GUARD_DESTINATIONS.get(node_id, {})\n                or value in R.DYNAMIC_GUARDS.get(node_id, {})\n                or value in R.FANOUT_GUARDS.get(node_id, {})\n            ), (node_id, value)\n\n\ndef test_the_runtime_context_factory_holds_no_model_client_or_routing_authority(tmp_path):\n    context = G.build_runtime_context(\n        engine_root=REPO_ROOT,\n        output_root=tmp_path,\n        run_id=\"run-topology\",\n        curriculum_digest=\"0\" * 64,\n    )\n    assert isinstance(context, RuntimeContext)\n    for forbidden in (\"model_client\", \"llm\", \"router\", \"routing_authority\", \"state\"):\n        assert not hasattr(context, forbidden)\n    assert isinstance(context.transport_registry, tp.CliTransport)\n    assert not isinstance(context.transport_registry, tp.FakeCliTransport)\n    assert callable(context.clock)\n","numLines":1008,"startLine":1,"totalLines":1008}}}
