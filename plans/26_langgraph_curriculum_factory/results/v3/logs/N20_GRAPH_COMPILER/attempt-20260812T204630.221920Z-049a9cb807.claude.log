{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UFEMAdQAAGxH6UvvQixyQP","type":"tool_result","content":"1\t\"\"\"Plan 26 topology gate (spec sections 3.3, 4, 8): N20's compiled skeleton.\n2\t\n3\tEvery assertion here runs against a real `StateGraph`/`CompiledStateGraph` built\n4\tfrom the real N22/N23 callables. Nothing is mocked: a simulated compilation\n5\twould prove that a stand-in compiles, which is the one thing this file exists to\n6\trule out.\n7\t\n8\tScope. N20 registers the fixed skeleton:\n9\t\n10\t    START -> D00 -> {D01 -> D02, D00R} -> D03 -> D04 -> {D05, D92}\n11\t    D00 -> D96 -> D98 -> END        (orphan recovery)\n12\t\n13\tN30 has since registered the per-unit path (D05-D15 with its source and visual\n14\t`Send` map/reduce) into the same builder, and N31/N32 still owe the repair,\n15\tacceptance, and workbook branches. So these tests assert N20's properties —\n16\tbinding rejection by stable ID, bounded cycles, worker->barrier fan-out shape,\n17\tmodel nodes holding no routing or acceptance authority — against whatever\n18\ttopology is actually compiled now, rather than against a frozen skeleton\n19\tsnapshot that a later graph node would falsify by doing its job.\n20\t\n21\tSkips only where the hash-locked environment is absent; the node's evidence was\n22\tproduced by running this file inside it.\n23\t\"\"\"\n24\t\n25\timport ast\n26\timport hashlib\n27\timport re\n28\timport shutil\n29\timport tempfile\n30\timport unittest\n31\tfrom pathlib import Path\n32\t\n33\ttry:  # pragma: no cover - environment probe, not behavior\n34\t    import langgraph  # noqa: F401\n35\t    import langgraph.checkpoint.sqlite  # noqa: F401\n36\texcept ModuleNotFoundError as exc:  # pragma: no cover\n37\t    raise unittest.SkipTest(\n38\t        \"plan26 hash-locked environment not installed \"\n39\t        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n40\t        f\"{exc}\"\n41\t    ) from exc\n42\t\n43\timport pytest\n44\tfrom langgraph._internal._constants import RESERVED\n45\tfrom langgraph.graph import END, START, StateGraph\n46\tfrom langgraph.graph.state import CompiledStateGraph\n47\tfrom langgraph.types import Send\n48\t\n49\tfrom runtime.langgraph_factory import graph as G\n50\tfrom runtime.langgraph_factory import model_nodes as mn\n51\tfrom runtime.langgraph_factory import routing as R\n52\tfrom runtime.langgraph_factory import transport as tp\n53\tfrom runtime.langgraph_factory.nodes import NODE_CATALOGUE, node_registry\n54\tfrom runtime.langgraph_factory.state import (\n55\t    FACTORY_STATE_FIELDS,\n56\t    FactoryInput,\n57\t    FactoryOutput,\n58\t    FactoryState,\n59\t    RuntimeContext,\n60\t)\n61\t\n62\tREPO_ROOT = Path(__file__).resolve().parents[2]\n63\tGRAPH_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"graph.py\"\n64\tROUTING_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"routing.py\"\n65\t\n66\t# Spec 8.1: \"There is no edge from a model directly to acceptance, terminal,\n67\t# checkpoint initialization, unit selection, workbook assembly, or release\",\n68\t# plus resume re-entry (spec 6.2 D92 forbids a model as a stored destination).\n69\t#\n70\t# The reduction nodes D16/D28 are deliberately NOT here: spec 8.1 wires\n71\t# `M05 -> D16` and `M07 -> D28` on purpose, because a review is *evidence for*\n72\t# the code-computed denominator, not the reduction itself. \"Models hold no\n73\t# reduction authority\" is proven below as a channel-authority property, which is\n74\t# where that authority actually lives.\n75\tAUTHORITY_NODES = frozenset({\n76\t    \"D04_INITIALIZE_OR_RESUME\",\n77\t    \"D05_SELECT_NEXT_UNIT\",\n78\t    \"D22_ACCEPT_UNIT\",\n79\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n80\t    \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n81\t    \"D25_ASSEMBLE_WORKBOOK\",\n82\t    \"D32_RECOMPUTE_FINAL_RELEASE\",\n83\t    \"D92_REENTER_VALIDATED_FRONTIER\",\n84\t    \"D98_WRITE_TERMINAL\",\n85\t    END,\n86\t})\n87\t\n88\t# (dispatching node, fan-out guard value) -> (dispatching guard, worker, barrier).\n89\t# The barrier is the deterministic node that owns the fan-out's denominator and to\n90\t# which the worker returns; for M01 that is the next node of whichever superstep\n91\t# the phase advance selects. A model fan-out's dispatching guard resolves to D90,\n92\t# not to the worker: the `Send`s are emitted by D90's guard, from the packet D90\n93\t# restaged with one committed attempt reservation per member.\n94\tFANOUT_SHAPES = {\n95\t    (\"D06_COMPILE_SOURCE_REQUESTS\", \"discovery_fanout\"): (\n96\t        R.route_source_discovery_fanout,\n97\t        \"M01_RESEARCH_UNIT_SOURCES\",\n98\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n99\t    ),\n100\t    (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"interpretation_fanout\"): (\n101\t        R.route_source_interpretation_fanout,\n102\t        \"M01_RESEARCH_UNIT_SOURCES\",\n103\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n104\t    ),\n105\t    (\"D10_COMPILE_VISUAL_BRIEFS\", \"deterministic_visual_fanout\"): (\n106\t        R.route_visual_briefs,\n107\t        \"D11_CREATE_DETERMINISTIC_VISUALS\",\n108\t        \"D12_VISUAL_BARRIER_AND_JOIN\",\n109\t    ),\n110\t    (\"D12_VISUAL_BARRIER_AND_JOIN\", \"model_visual_fanout\"): (\n111\t        R.route_visual_barrier,\n112\t        \"M04_CREATE_UNIT_VISUALS\",\n113\t        \"D12_VISUAL_BARRIER_AND_JOIN\",\n114\t    ),\n115\t}\n116\t\n117\t\n118\tdef _send_emitting_guard(source: str, value: str):\n119\t    \"\"\"The guard that actually emits the `Send`s for this fan-out, and its record.\n120\t\n121\t    For a model fan-out that is D90's guard reading D90's restaged packet, because\n122\t    spec 6.2 requires the attempt counter to be committed before dispatch; for a\n123\t    deterministic fan-out it is the dispatching node's own guard.\n124\t    \"\"\"\n125\t\n126\t    if R.FANOUT_GUARDS[source][value] == R.ATTEMPT_RESERVATION:\n127\t        return R.route_attempt_reservation, R.ATTEMPT_RESERVATION, \"authorized\"\n128\t    return FANOUT_SHAPES[(source, value)][0], source, value\n129\t\n130\t\n131\t@pytest.fixture(scope=\"module\")\n132\tdef output_root():\n133\t    root = Path(tempfile.mkdtemp(prefix=\"plan26_n20_topology_\"))\n134\t    yield root\n135\t    shutil.rmtree(root, ignore_errors=True)\n136\t\n137\t\n138\t@pytest.fixture(scope=\"module\")\n139\tdef compiled(output_root) -> CompiledStateGraph:\n140\t    return G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n141\t\n142\t\n143\tdef fresh_builder() -> StateGraph:\n144\t    return StateGraph(\n145\t        FactoryState,\n146\t        context_schema=RuntimeContext,\n147\t        input_schema=FactoryInput,\n148\t        output_schema=FactoryOutput,\n149\t    )\n150\t\n151\t\n152\t# ======================================================= state/channel precondition\n153\t\n154\t\n155\tdef test_the_state_schema_declares_no_langgraph_reserved_channel_name():\n156\t    \"\"\"A reserved channel name makes the production state schema uncompilable.\n157\t\n158\t    LangGraph 1.2.9 rejects `checkpoint_ns` (and `checkpoint_id`, `configurable`,\n159\t    ...) as channel names in `validate_graph`, so any such field in\n160\t    `FactoryState` fails compilation of the one production graph.\n161\t    \"\"\"\n162\t\n163\t    clashes = sorted(set(FACTORY_STATE_FIELDS) & set(RESERVED))\n164\t    assert clashes == [], (\n165\t        f\"FactoryState declares LangGraph-reserved channel name(s) {clashes}; \"\n166\t        f\"owner N11_STATE_REDUCERS (rework edge `state_or_reducer`)\"\n167\t    )\n168\t\n169\t\n170\t# ====================================================== TEST 1: the catalogue compiles\n171\t\n172\t\n173\tdef test_the_available_catalogue_compiles_against_real_node_callables(compiled):\n174\t    bindings = G.binding_inventory()\n175\t    registry = node_registry()\n176\t\n177\t    assert compiled.name == G.GRAPH_NAME == \"plan26_curriculum_factory\"\n178\t    assert isinstance(compiled, CompiledStateGraph)\n179\t\n180\t    # 22 deterministic bodies (N22) + 8 model adapters + D90/D91 (N23), all real\n181\t    # callables.\n182\t    assert set(registry) == set(NODE_CATALOGUE)\n183\t    assert len(registry) == 22\n184\t    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n185\t    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n186\t    assert set(mn.MODEL_BOOKKEEPING_NODES) == {R.ATTEMPT_RESERVATION, R.MODEL_FAILURE_CLASSIFIER}\n187\t    assert set(bindings) == (\n188\t        set(registry) | set(mn.MODEL_NODE_ADAPTERS) | set(mn.MODEL_BOOKKEEPING_NODES)\n189\t    )\n190\t    assert len(bindings) == 32\n191\t\n192\t    drawn = compiled.get_graph()\n193\t    assert set(drawn.nodes) - {START, END} == set(bindings)\n194\t\n195\t    for node_id, body in bindings.items():\n196\t        module = G._binding_record(node_id, body)[\"module\"]\n197\t        assert module.startswith(\"runtime.langgraph_factory.\"), (node_id, module)\n198\t\n199\t\n200\tdef test_start_has_exactly_one_edge_and_d98_is_the_only_registered_end_edge(compiled):\n201\t    drawn = compiled.get_graph()\n202\t    starts = [edge for edge in drawn.edges if edge.source == START]\n203\t    assert [edge.target for edge in starts] == [\"D00_BOOTSTRAP_EPISODE\"]\n204\t\n205\t    registered_end_sources = sorted(\n206\t        source for source, target in G.SKELETON_NORMAL_EDGES if target == END\n207\t    )\n208\t    assert registered_end_sources == [\"D98_WRITE_TERMINAL\"]\n209\t\n210\t    # D98's body is the real N22-owned terminal writer, not a local shim.\n211\t    d98 = node_registry()[\"D98_WRITE_TERMINAL\"]\n212\t    assert G._binding_record(\"D98_WRITE_TERMINAL\", d98)[\"module\"] == (\n213\t        \"runtime.langgraph_factory.nodes.terminal\"\n214\t    )\n215\t\n216\t    # LangGraph draws a dead-end node as reaching END. In this skeleton the only\n217\t    # such nodes are the frontier N30 still owes; nothing else leaks to END.\n218\t    drawn_end = {edge.source for edge in drawn.edges if edge.target == END}\n219\t    assert drawn_end - {\"D98_WRITE_TERMINAL\"} <= set(G.DEFERRED_TOPOLOGY)\n220\t    for node_id in drawn_end - {\"D98_WRITE_TERMINAL\"}:\n221\t        assert G.DEFERRED_TOPOLOGY[node_id] == \"N30_UNIT_GRAPH\"\n222\t\n223\t\n224\tdef test_the_skeleton_wires_exactly_the_declared_edges(compiled):\n225\t    topology = G.compiled_topology(compiled)\n226\t    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n227\t\n228\t    for source, target in (\n229\t        (START, \"D00_BOOTSTRAP_EPISODE\"),\n230\t        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n231\t        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n232\t        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n233\t        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n234\t        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n235\t        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n236\t        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n237\t        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n238\t        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n239\t        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n240\t        (\"D98_WRITE_TERMINAL\", END),\n241\t    ):\n242\t        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n243\t\n244\t    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n245\t    # single successor are the whole of it.\n246\t    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n247\t        \"D98_WRITE_TERMINAL\"\n248\t    }\n249\t\n250\t\n251\t# ============================================ TEST 2: bad bindings fail by stable ID\n252\t\n253\t\n254\tdef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n255\t    return {}\n256\t\n257\t\n258\tdef test_a_missing_callable_fails_the_build_by_stable_id():\n259\t    bindings = G.binding_inventory()\n260\t    bindings.pop(\"D98_WRITE_TERMINAL\")\n261\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n262\t        G.register_skeleton(fresh_builder(), bindings)\n263\t\n264\t\n265\tdef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n266\t    bindings = G.binding_inventory()\n267\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n268\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n269\t        G.register_skeleton(fresh_builder(), bindings)\n270\t\n271\t\n272\tdef test_a_duplicate_callable_fails_the_build_by_stable_id():\n273\t    bindings = G.binding_inventory()\n274\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n275\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n276\t        G.register_skeleton(fresh_builder(), bindings)\n277\t\n278\t\n279\tdef test_an_uncallable_binding_fails_the_build_by_stable_id():\n280\t    bindings = G.binding_inventory()\n281\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n282\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n283\t        G.register_skeleton(fresh_builder(), bindings)\n284\t\n285\t\n286\tdef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n287\t    # Pin the required set to the real skeleton so the dangling-endpoint check is\n288\t    # what rejects the edge, not the missing-binding check that shadows it.\n289\t    required = G._skeleton_required_nodes()\n290\t    monkeypatch.setattr(G, \"_skeleton_required_nodes\", lambda: required)\n291\t    monkeypatch.setattr(\n292\t        G,\n293\t        \"SKELETON_NORMAL_EDGES\",\n294\t        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n295\t    )\n296\t    with pytest.raises(G.GraphBindingError, match=r\"N20-EDGE-DANGLING:D99_NOT_A_NODE\"):\n297\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n298\t\n299\t\n300\tdef test_a_wired_node_with_no_callable_fails_the_build_by_stable_id(monkeypatch):\n301\t    monkeypatch.setattr(\n302\t        G,\n303\t        \"SKELETON_NORMAL_EDGES\",\n304\t        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n305\t    )\n306\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D99_NOT_A_NODE\"):\n307\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n308\t\n309\t\n310\tdef test_an_unwired_undeclared_node_fails_the_build_by_stable_id(monkeypatch):\n311\t    # The example node is read from the live table rather than pinned: a node\n312\t    # deferred today is wired tomorrow by the graph node that owns it, and this\n313\t    # negative case is about the rejection, not about any particular node.\n314\t    assert G.DEFERRED_TOPOLOGY, (\n315\t        \"every registered node is now wired, so this case needs a different \"\n316\t        \"fixture: a registered node that is neither wired nor declared deferred\"\n317\t    )\n318\t    node_id = sorted(G.DEFERRED_TOPOLOGY)[0]\n319\t    deferred = dict(G.DEFERRED_TOPOLOGY)\n320\t    deferred.pop(node_id)\n321\t    monkeypatch.setattr(G, \"DEFERRED_TOPOLOGY\", deferred)\n322\t    with pytest.raises(\n323\t        G.GraphBindingError, match=rf\"N20-NODE-UNDECLARED:{re.escape(node_id)}\"\n324\t    ):\n325\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n326\t\n327\t\n328\tdef test_an_unrouted_declared_guard_value_fails_the_build_by_stable_id(monkeypatch):\n329\t    destinations = {k: dict(v) for k, v in R.GUARD_DESTINATIONS.items()}\n330\t    destinations[\"D05_SELECT_NEXT_UNIT\"].pop(\"manifest_exhausted\")\n331\t    monkeypatch.setattr(R, \"GUARD_DESTINATIONS\", destinations)\n332\t    with pytest.raises(R.RoutingViolation, match=r\"N20-GUARD-UNROUTED:D05_SELECT_NEXT_UNIT\"):\n333\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n334\t\n335\t\n336\t# ================================================= TEST 3: cycles cross a real guard\n337\t\n338\t\n339\tdef _simple_cycles(edges) -> set[frozenset[str]]:\n340\t    \"\"\"Every simple cycle of the compiled graph, as its node set.\n341\t\n342\t    Each cycle is enumerated once by only extending a path through nodes that\n343\t    sort after its entry point, so `A -> B -> A` is not also reported as\n344\t    `B -> A -> B`.\n345\t    \"\"\"\n346\t\n347\t    successors: dict[str, set[str]] = {}\n348\t    for source, target in edges:\n349\t        successors.setdefault(source, set()).add(target)\n350\t\n351\t    cycles: set[frozenset[str]] = set()\n352\t\n353\t    def walk(node, start, path):\n354\t        for target in sorted(successors.get(node, ())):\n355\t            if target == start and len(path) >= 2:\n356\t                cycles.add(frozenset(path))\n357\t            elif target not in path and target > start:\n358\t                walk(target, start, path | {target})\n359\t\n360\t    for start in sorted(successors):\n361\t        walk(start, start, {start})\n362\t    return cycles\n363\t\n364\t\n365\tdef _cycle_bounds(cycle: frozenset[str]) -> list[str]:\n366\t    \"\"\"The members of `cycle` that stop it repeating indefinitely.\n367\t\n368\t    A node bounds a cycle if it either declares an exhaustion guard value whose\n369\t    destination leaves the cycle, or dispatches a fan-out that refuses to repeat\n370\t    without a freshly staged worker projection — the guard invents no projection,\n371\t    so a further lap requires work some node committed a denominator to.\n372\t    \"\"\"\n373\t\n374\t    bounds: list[str] = []\n375\t    for node_id in sorted(cycle):\n376\t        row = R.GUARD_DESTINATIONS.get(node_id, {})\n377\t        if any(\"exhausted\" in value and row[value] not in cycle for value in row):\n378\t            bounds.append(node_id)\n379\t            continue\n380\t        if node_id not in R.FANOUT_GUARDS:\n381\t            continue\n382\t        for value in R.FANOUT_GUARDS[node_id]:\n383\t            guard, guard_node, guard_value = _send_emitting_guard(node_id, value)\n384\t            with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n385\t                guard({\"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}}})\n386\t        bounds.append(node_id)\n387\t    return bounds\n388\t\n389\t\n390\tdef test_every_cycle_in_the_compiled_graph_crosses_an_exhaustion_guard(compiled):\n391\t    \"\"\"No wired cycle can repeat forever, and none of them is a closed trap.\n392\t\n393\t    Spec 8.1 wires real loops — the M01 discovery superstep, the visual barrier's\n394\t    worker/barrier join, and (once N31/N32 land) the repair and workbook cycles.\n395\t    What the graph must never contain is a cycle with no deterministic bound, so\n396\t    this asserts the bound for every cycle that is actually compiled and holds\n397\t    the frozen guard rows the not-yet-wired cycles will close through.\n398\t    \"\"\"\n399\t\n400\t    edges = {\n401\t        (source, target)\n402\t        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n403\t        if target != END\n404\t    }\n405\t    cycles = _simple_cycles(edges)\n406\t\n407\t    # Not vacuous: spec 8.1's own discovery superstep is wired and is a cycle. It\n408\t    # runs through D90, which is where the attempt bound that closes it is committed.\n409\t    assert frozenset({\n410\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n411\t        R.ATTEMPT_RESERVATION,\n412\t        \"M01_RESEARCH_UNIT_SOURCES\",\n413\t    }) in cycles\n414\t\n415\t    for cycle in sorted(cycles, key=sorted):\n416\t        assert _cycle_bounds(cycle), (\n417\t            f\"cycle {sorted(cycle)} crosses no exhaustion guard and no fan-out \"\n418\t            \"dispatcher, so nothing stops it repeating\"\n419\t        )\n420\t        exits = {\n421\t            target\n422\t            for source, target in edges\n423\t            if source in cycle and target not in cycle\n424\t        } - {R.INTERRUPT_GATE, R.TERMINAL}\n425\t        assert exits, f\"cycle {sorted(cycle)} reaches no product node outside itself\"\n426\t\n427\t    # Every loop-closing guard row exhausts deterministically before repeating.\n428\t    for node_id in (\"D17_CLASSIFY_UNIT_FINDINGS\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"):\n429\t        assert R.GUARD_DESTINATIONS[node_id][\"convergence_exhausted\"] == R.TERMINAL\n430\t    assert R.GUARD_DESTINATIONS[\"D18_PLAN_TARGETED_UNIT_REPAIR\"][\"convergence_exhausted\"] == (\n431\t        R.TERMINAL\n432\t    )\n433\t    assert R.GUARD_DESTINATIONS[\"D90_RESERVE_MODEL_ATTEMPT\"][\"exhausted\"] == R.TERMINAL\n434\t    assert R.GUARD_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"][\"exhausted\"] == R.TERMINAL\n435\t    # The unit loop only closes back to D05 through acceptance, never directly.\n436\t    assert R.GUARD_DESTINATIONS[\"D23_CHECKPOINT_ACCEPTED_UNIT\"][\"checkpoint_correlated\"] == (\n437\t        \"D05_SELECT_NEXT_UNIT\"\n438\t    )\n439\t\n440\t\n441\t# ================================== TEST 4: models hold no acceptance/route authority\n442\t\n443\t\n444\tdef test_no_model_node_has_an_edge_to_an_authority_node(compiled):\n445\t    edges = {\n446\t        (source, target)\n447\t        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n448\t    }\n449\t    for source, target in edges:\n450\t        if source in mn.MODEL_NODE_IDS:\n451\t            assert target not in AUTHORITY_NODES, f\"model edge {source} -> {target}\"\n452\t\n453\t    for job_id, destination in R.MODEL_RESULT_DESTINATIONS.items():\n454\t        assert job_id in mn.MODEL_NODE_IDS\n455\t        assert destination not in AUTHORITY_NODES, (job_id, destination)\n456\t\n457\t    # M01's two supersteps are the remaining model successors.\n458\t    assert R.route_m01_research({\"source_discoveries\": {\"k\": {}}}) == (\n459\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n460\t    )\n461\t    assert R.route_m01_research({\"source_interpretations\": {\"k\": {}}}) == (\n462\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n463\t    )\n464\t    for destination in (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"):\n465\t        assert destination not in AUTHORITY_NODES\n466\t\n467\t\n468\tdef test_a_model_node_holds_no_acceptance_reduction_or_terminal_channel_authority():\n469\t    \"\"\"Where the authority actually lives: the channels a model may write.\n470\t\n471\t    `M05 -> D16` is a legal edge precisely because M05 cannot write the reduction\n472\t    result, the accepted receipt, any artifact head, or the terminal — D16\n473\t    recomputes the denominator from evidence it does not control.\n474\t    \"\"\"\n475\t\n476\t    forbidden = {\n477\t        \"artifact_heads\",\n478\t        \"accepted_unit_receipts\",\n479\t        \"accepted_unit_checkpoint_receipts\",\n480\t        \"deterministic_checks\",\n481\t        \"workbook_head\",\n482\t        \"final_release_audits\",\n483\t        \"cursor\",\n484\t        \"resume_frontier\",\n485\t        \"terminal\",\n486\t        \"terminal_history\",\n487\t        \"terminal_candidate\",\n488\t    }\n489\t    assert mn.MODEL_NODE_WRITABLE_FIELDS & forbidden == set()\n490\t    assert forbidden <= set(FACTORY_STATE_FIELDS)\n491\t    assert mn.FORBIDDEN_MODEL_NODE_FIELDS & mn.MODEL_NODE_WRITABLE_FIELDS == set()\n492\t\n493\t    # The reducers that consume a review are deterministic nodes, and their\n494\t    # destinations are decided by the code-owned table, not by the review body.\n495\t    assert R.GUARD_DESTINATIONS[\"D16_REDUCE_UNIT_EVIDENCE\"] == {\n496\t        \"unit_denominator_passed\": \"D22_ACCEPT_UNIT\",\n497\t        \"unit_findings_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n498\t    }\n499\t    assert R.GUARD_DESTINATIONS[\"D28_REDUCE_WORKBOOK_EVIDENCE\"] == {\n500\t        \"workbook_denominator_passed\": \"D32_RECOMPUTE_FINAL_RELEASE\",\n501\t        \"workbook_findings_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n502\t    }\n503\t\n504\t\n505\tdef test_routing_never_lets_a_model_result_name_its_own_destination():\n506\t    \"\"\"A guard reads code-owned tables and result *presence*, never a model body.\"\"\"\n507\t\n508\t    tree = ast.parse(ROUTING_PY.read_text(encoding=\"utf-8\"))\n509\t    model_result_guards = {\n510\t        \"_route_model_result\",\n511\t        \"route_m01_research\",\n512\t        \"route_m02_domain\",\n513\t        \"route_m03_content\",\n514\t        \"route_m04_visual\",\n515\t        \"route_m05_unit_review\",\n516\t        \"route_m06_unit_repair\",\n517\t        \"route_m07_workbook_review\",\n518\t        \"route_m08_workbook_repair\",\n519\t    }\n520\t    # The only model-written channels a guard may touch, and only to test that a\n521\t    # result set exists — never to read a value out of a model's output body.\n522\t    allowed_reads = {\"source_discoveries\", \"source_interpretations\"}\n523\t    seen = set()\n524\t    for node in ast.walk(tree):\n525\t        if not isinstance(node, ast.FunctionDef) or node.name not in model_result_guards:\n526\t            continue\n527\t        seen.add(node.name)\n528\t        body = list(node.body)\n529\t        if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):\n530\t            body = body[1:]  # the docstring is prose, not behavior\n531\t        for statement in body:\n532\t            for inner in ast.walk(statement):\n533\t                if not (isinstance(inner, ast.Constant) and isinstance(inner.value, str)):\n534\t                    continue\n535\t                value = inner.value\n536\t                if value in allowed_reads:\n537\t                    continue\n538\t                assert value not in mn.MODEL_NODE_WRITABLE_FIELDS, (\n539\t                    f\"{node.name} reads model-written channel {value!r}\"\n540\t                )\n541\t                assert value in R.MODEL_RESULT_DESTINATIONS.values() or value in (\n542\t                    set(R.MODEL_RESULT_DESTINATIONS)\n543\t                    | {\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"}\n544\t                ) or \"no result set exists\" in value, (\n545\t                    f\"{node.name} names non-destination string {value!r}\"\n546\t                )\n547\t    assert seen == model_result_guards\n548\t\n549\t\n550\tdef test_a_stored_frontier_may_not_name_a_model_node():\n551\t    state = {\n552\t        \"pending_guard\": {\n553\t            \"node\": \"D92_REENTER_VALIDATED_FRONTIER\",\n554\t            \"value\": \"deterministic_reentry\",\n555\t            \"detail\": {\"destination\": \"M03_WRITE_UNIT_CONTENT\"},\n556\t        }\n557\t    }\n558\t    with pytest.raises(R.RoutingViolation, match=\"is a model node\"):\n559\t        R.route_frontier_reentry(state)\n560\t\n561\t\n562\t# ========================================== TEST 5: Send follows worker->barrier only\n563\t\n564\t\n565\tdef test_every_registered_fanout_has_the_worker_to_barrier_shape(compiled):\n566\t    \"\"\"Every compiled fan-out is worker->barrier, the only shape spec 10 allows.\n567\t\n568\t    One `Send` per staged worker projection, all naming a single worker node, and\n569\t    the worker's only forward destination is the deterministic node that owns the\n570\t    denominator — never a second fan-out and never an authority node. This is the\n571\t    same property the guard-level tests below prove in isolation, asserted here\n572\t    against the graph that actually compiled.\n573\t\n574\t    A model fan-out reaches its worker through D90, so the compiled shape is\n575\t    dispatcher -> D90 -> worker -> barrier: spec 6.2 requires the attempt counter\n576\t    committed before dispatch, and every adapter refuses an unreserved packet.\n577\t    \"\"\"\n578\t\n579\t    declared = {\n580\t        (source, value): dispatch\n581\t        for source, row in R.FANOUT_GUARDS.items()\n582\t        for value, dispatch in row.items()\n583\t    }\n584\t    assert set(FANOUT_SHAPES) == set(declared), (\n585\t        \"a fan-out guard was registered or removed without updating the shape \"\n586\t        \"table this test checks it against\"\n587\t    )\n588\t\n589\t    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n590\t    for (source, value), (dispatch_guard, worker, barrier) in sorted(FANOUT_SHAPES.items()):\n591\t        dispatch = declared[(source, value)]\n592\t        assert dispatch not in mn.MODEL_NODE_IDS, (\n593\t            f\"{source} dispatches straight to model node {dispatch} with no reservation\"\n594\t        )\n595\t        assert (source, dispatch) in edges, f\"{source} has no compiled edge to {dispatch}\"\n596\t        if dispatch == R.ATTEMPT_RESERVATION:\n597\t            assert (dispatch, worker) in edges, f\"D90 has no compiled edge to worker {worker}\"\n598\t        else:\n599\t            assert dispatch == worker\n600\t        assert (worker, barrier) in edges, f\"worker {worker} has no compiled edge to {barrier}\"\n601\t        assert barrier not in mn.MODEL_NODE_IDS, f\"{barrier} is a model node, not a barrier\"\n602\t\n603\t        projections = [{\"key\": f\"{source}/{index}\"} for index in range(3)]\n604\t        packet = {\"dispatch\": worker, \"packets\": projections}\n605\t        routed = dispatch_guard(\n606\t            {\"pending_guard\": {\"node\": source, \"value\": value, \"detail\": {}},\n607\t             \"pending_packet\": packet}\n608\t        )\n609\t        if dispatch == R.ATTEMPT_RESERVATION:\n610\t            assert routed == R.ATTEMPT_RESERVATION\n611\t\n612\t        emitting, guard_node, guard_value = _send_emitting_guard(source, value)\n613\t        sends = emitting(\n614\t            {\n615\t                \"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}},\n616\t                \"pending_packet\": packet,\n617\t            }\n618\t        )\n619\t        assert [type(item) for item in sends] == [Send, Send, Send]\n620\t        assert {item.node for item in sends} == {worker}\n621\t        assert [item.arg for item in sends] == projections\n622\t\n623\t    # A worker's forward successors are exactly the barriers declared for it, so\n624\t    # a fanned-out worker rejoins a denominator and fans out no further. D91 is\n625\t    # excluded with the other non-forward edges: a model worker's failure edge is\n626\t    # a recovery edge, not a second barrier.\n627\t    barriers: dict[str, set[str]] = {}\n628\t    for _guard, worker, barrier in FANOUT_SHAPES.values():\n629\t        barriers.setdefault(worker, set()).add(barrier)\n630\t    for worker, expected in sorted(barriers.items()):\n631\t        successors = {target for source, target in edges if source == worker} - {\n632\t            R.INTERRUPT_GATE,\n633\t            R.TERMINAL,\n634\t            R.MODEL_FAILURE_CLASSIFIER,\n635\t            END,\n636\t        }\n637\t        assert successors == expected, (worker, sorted(successors), sorted(expected))\n638\t\n639\t\n640\tdef test_no_compiled_edge_enters_a_model_node_except_from_d90(compiled):\n641\t    \"\"\"Spec 6.2 D90: the attempt counter is committed *before* dispatch.\n642\t\n643\t    The counter cannot be minted by the dispatching node (it would be committed\n644\t    in the same superstep as the dispatch) nor invented at routing time, so the\n645\t    only compiled predecessor a model worker may have is D90. Every N23 adapter\n646\t    enforces the same rule from the other side by raising `AttemptNotReserved`.\n647\t    \"\"\"\n648\t\n649\t    for node_id, row in R.GUARD_DESTINATIONS.items():\n650\t        for value, destination in row.items():\n651\t            assert destination not in mn.MODEL_NODE_IDS, (\n652\t                f\"{node_id}.{value} routes to {destination} with no reservation\"\n653\t            )\n654\t\n655\t    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n656\t    entered = {target for _source, target in edges if target in mn.MODEL_NODE_IDS}\n657\t    assert entered, \"no model node is wired, so this would pass vacuously\"\n658\t    for worker in sorted(entered):\n659\t        predecessors = {source for source, target in edges if target == worker}\n660\t        assert predecessors == {R.ATTEMPT_RESERVATION}, (worker, sorted(predecessors))\n661\t\n662\t\n663\tdef test_a_fanout_guard_emits_one_send_per_staged_worker_projection():\n664\t    packet = {\n665\t        \"dispatch\": \"M04_CREATE_UNIT_VISUALS\",\n666\t        \"briefs\": [{\"key\": \"u1/visual/a\"}, {\"key\": \"u1/visual/b\"}],\n667\t    }\n668\t    # The dispatcher hands the staged map to D90 rather than to the worker: no\n669\t    # `Send` may be emitted before the attempt counter is committed (spec 6.2).\n670\t    assert R.route_visual_barrier(\n671\t        {\n672\t            \"pending_guard\": {\n673\t                \"node\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n674\t                \"value\": \"model_visual_fanout\",\n675\t                \"detail\": {},\n676\t            },\n677\t            \"pending_packet\": packet,\n678\t        }\n679\t    ) == R.ATTEMPT_RESERVATION\n680\t\n681\t    sends = R.route_attempt_reservation(\n682\t        {\n683\t            \"pending_guard\": {\n684\t                \"node\": R.ATTEMPT_RESERVATION,\n685\t                \"value\": \"authorized\",\n686\t                \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n687\t            },\n688\t            \"pending_packet\": packet,\n689\t        }\n690\t    )\n691\t    assert [type(item) for item in sends] == [Send, Send]\n692\t    assert {item.node for item in sends} == {\"M04_CREATE_UNIT_VISUALS\"}\n693\t    assert [item.arg[\"key\"] for item in sends] == [\"u1/visual/a\", \"u1/visual/b\"]\n694\t    # Worker -> barrier: the worker's declared return destination is the barrier\n695\t    # that owns the denominator, which is a normal edge, not another Send.\n696\t    assert R.MODEL_RESULT_DESTINATIONS[\"M04_CREATE_UNIT_VISUALS\"] == (\n697\t        \"D12_VISUAL_BARRIER_AND_JOIN\"\n698\t    )\n699\t\n700\t\n701\tdef test_a_fanout_guard_refuses_an_unstaged_or_mixed_dispatch():\n702\t    base = {\n703\t        \"pending_guard\": {\n704\t            \"node\": R.ATTEMPT_RESERVATION,\n705\t            \"value\": \"authorized\",\n706\t            \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n707\t        }\n708\t    }\n709\t    with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n710\t        R.route_attempt_reservation(dict(base))\n711\t    with pytest.raises(R.RoutingViolation, match=\"no dispatch destination\"):\n712\t        R.route_attempt_reservation({**base, \"pending_packet\": {\"briefs\": [{\"key\": \"a\"}]}})\n713\t    with pytest.raises(R.RoutingViolation, match=\"no non-empty worker projection\"):\n714\t        R.route_attempt_reservation(\n715\t            {**base, \"pending_packet\": {\"dispatch\": \"M04_CREATE_UNIT_VISUALS\", \"briefs\": []}}\n716\t        )\n717\t\n718\t\n719\t# ============================= TEST 6: arbitrary manifest lengths and empty subsets\n720\t\n721\t\n722\tdef test_no_curriculum_specific_manifest_length_or_order_is_hardcoded():\n723\t    for path in (GRAPH_PY, ROUTING_PY):\n724\t        source = path.read_text(encoding=\"utf-8\")\n725\t        tree = ast.parse(source)\n726\t        for node in ast.walk(tree):\n727\t            if isinstance(node, ast.Constant) and isinstance(node.value, str):\n728\t                assert not re.match(r\"^(U|L)\\d{2,}\", node.value), (\n729\t                    f\"{path.name} names curriculum unit {node.value!r}\"\n730\t                )\n731\t        for forbidden in (\n732\t            \"unit_count\",\n733\t            \"UNIT_COUNT\",\n734\t            \"MANIFEST_LENGTH\",\n735\t            \"manifest_length\",\n736\t            \"expected_units\",\n737\t        ):\n738\t            assert forbidden not in source, f\"{path.name} hardcodes {forbidden!r}\"\n739\t        # No node is created per known unit: registration reads only the frozen\n740\t        # catalogue, never a manifest.\n741\t        assert \"manifest\" not in source.replace(\"manifest_path\", \"\").replace(\n742\t            \"manifest coverage\", \"\"\n743\t        ).replace(\"MANIFEST_COVERAGE\", \"\").lower() or \"for unit\" not in source\n744\t\n745\t\n746\tdef test_the_builder_registers_a_fixed_node_set_independent_of_any_manifest(compiled):\n747\t    drawn = set(compiled.get_graph().nodes) - {START, END}\n748\t    assert drawn == set(G.binding_inventory())\n749\t    assert not [node for node in drawn if re.search(r\"(unit|lesson)_\\d\", node.lower())]\n750\t\n751\t\n752\tdef test_an_empty_deterministic_visual_subset_routes_straight_to_the_barrier():\n753\t    state = {\n754\t        \"pending_guard\": {\n755\t            \"node\": \"D10_COMPILE_VISUAL_BRIEFS\",\n756\t            \"value\": \"no_deterministic_visuals\",\n757\t            \"detail\": {},\n758\t        }\n759\t    }\n760\t    assert R.route_visual_briefs(state) == \"D12_VISUAL_BARRIER_AND_JOIN\"\n761\t\n762\t\n763\tdef test_an_exhausted_manifest_routes_to_coverage_proof_at_any_length():\n764\t    state = {\n765\t        \"pending_guard\": {\n766\t            \"node\": \"D05_SELECT_NEXT_UNIT\",\n767\t            \"value\": \"manifest_exhausted\",\n768\t            \"detail\": {},\n769\t        }\n770\t    }\n771\t    assert R.route_unit_selection(state) == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n772\t\n773\t\n774\t# ================================================ TEST 7: digest stability and drift\n775\t\n776\t\n777\tdef test_identical_real_bindings_yield_an_identical_digest(output_root):\n778\t    first = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n779\t    second = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n780\t    assert first is not second\n781\t    assert G.graph_digest(first) == G.graph_digest(second)\n782\t    assert len(G.graph_digest(first)) == 64\n783\t\n784\t\n785\tdef test_a_changed_callable_changes_the_digest(compiled, monkeypatch):\n786\t    baseline = G.graph_digest(compiled)\n787\t    drifted = G.binding_inventory()\n788\t    drifted[\"D05_SELECT_NEXT_UNIT\"] = drifted[\"D13_RENDER_UNIT\"]\n789\t    monkeypatch.setattr(G, \"binding_inventory\", lambda: drifted)\n790\t    assert G.graph_digest(compiled) != baseline\n791\t\n792\t\n793\tdef test_a_changed_state_schema_changes_the_digest(compiled, monkeypatch):\n794\t    baseline = G.graph_digest(compiled)\n795\t    reducers = dict(G.FIELD_REDUCER_CLASSES)\n796\t    reducers[\"cursor\"] = \"append_unique\"\n797\t    monkeypatch.setattr(G, \"FIELD_REDUCER_CLASSES\", reducers)\n798\t    assert G.graph_digest(compiled) != baseline\n799\t\n800\t\n801\tdef test_a_changed_prompt_or_schema_file_changes_the_digest(compiled, monkeypatch, tmp_path):\n802\t    baseline = G.graph_digest(compiled)\n803\t    real = tp.resolve_prompt_path(tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\"))\n804\t    drifted = tmp_path / real.name\n805\t    drifted.write_bytes(real.read_bytes() + b\"\\n# drift\\n\")\n806\t    assert hashlib.sha256(drifted.read_bytes()).hexdigest() != (\n807\t        hashlib.sha256(real.read_bytes()).hexdigest()\n808\t    )\n809\t\n810\t    original = tp.resolve_prompt_path\n811\t\n812\t    def patched(route):\n813\t        path = original(route)\n814\t        return drifted if path.name == real.name else path\n815\t\n816\t    monkeypatch.setattr(G.tp, \"resolve_prompt_path\", patched)\n817\t    assert G.graph_digest(compiled) != baseline\n818\t\n819\t\n820\tdef test_the_digest_ignores_python_object_identity(compiled):\n821\t    payload_one = G.compiled_topology(compiled)\n822\t    payload_two = G.compiled_topology(compiled)\n823\t    assert payload_one == payload_two\n824\t    assert G._canonical_digest(payload_one) == G._canonical_digest(payload_two)\n825\t\n826\t\n827\t# ============================================ TEST 8: no handwritten fallback controller\n828\t\n829\t\n830\tdef test_production_graph_imports_contain_no_fallback_controller():\n831\t    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n832\t    imported: set[str] = set()\n833\t    for node in ast.walk(tree):\n834\t        if isinstance(node, ast.Import):\n835\t            imported.update(alias.name for alias in node.names)\n836\t        elif isinstance(node, ast.ImportFrom):\n837\t            imported.add(node.module or \"\")\n838\t            imported.update(f\"{node.module or ''}.{alias.name}\" for alias in node.names)\n839\t\n840\t    for forbidden in (\n841\t        \"runtime.curriculum_factory_graph\",\n842\t        \"curriculum_factory_graph\",\n843\t        \"CurriculumFactoryGraph\",\n844\t        \"runtime.session_bridge\",\n845\t    ):\n846\t        assert not any(forbidden in name for name in imported), forbidden\n847\t\n848\t    source = GRAPH_PY.read_text(encoding=\"utf-8\")\n849\t    for forbidden in (\"CurriculumFactoryGraph\", \"test_simulated\", \"fallback_controller\"):\n850\t        assert forbidden not in source, f\"graph.py references {forbidden!r}\"\n851\t\n852\t    # The forbidden model-invocation dependencies stay out of the production path.\n853\t    for forbidden in (\n854\t        \"langchain\",\n855\t        \"langchain_openai\",\n856\t        \"langchain_google_genai\",\n857\t        \"openai\",\n858\t        \"google.generativeai\",\n859\t    ):\n860\t        assert not any(\n861\t            name == forbidden or name.startswith(f\"{forbidden}.\") for name in imported\n862\t        ), forbidden\n863\t\n864\t\n865\tdef test_only_one_builder_and_one_compile_call_exist():\n866\t    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n867\t    builders = [\n868\t        node.name\n869\t        for node in ast.walk(tree)\n870\t        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"build_\")\n871\t        and \"graph\" in node.name\n872\t    ]\n873\t    assert builders == [\"build_curriculum_factory_graph\"]\n874\t\n875\t    compiles = [\n876\t        node\n877\t        for node in ast.walk(tree)\n878\t        if isinstance(node, ast.Call)\n879\t        and isinstance(node.func, ast.Attribute)\n880\t        and node.func.attr == \"compile\"\n881\t    ]\n882\t    assert len(compiles) == 1\n883\t\n884\t\n885\t# ================================================== boundary and context behaviour\n886\t\n887\t\n888\tdef test_the_node_boundary_injects_the_runtime_context_langgraph_would_not():\n889\t    \"\"\"LangGraph passes `Runtime`, never the opened services.\n890\t\n891\t    N22/N23 bodies take the context as an explicit second argument, so without\n892\t    this boundary every node would silently run with `runtime_context=None`.\n893\t    \"\"\"\n894\t\n895\t    seen = {}\n896\t\n897\t    def body(state, context):\n898\t        seen[\"context\"] = context\n899\t        return {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n900\t\n901\t    bound = G._boundary(\"X\", body, model_node=False)\n902\t\n903\t    class FakeRuntime:\n904\t        context = \"the-context\"\n905\t\n906\t    assert bound({}, FakeRuntime()) == {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n907\t    assert seen[\"context\"] == \"the-context\"\n908\t\n909\t\n910\tdef test_the_node_boundary_classifies_an_unexpected_exception_as_a_system_failure():\n911\t    def body(state, context):\n912\t        raise ValueError(\"unexpected\")\n913\t\n914\t    bound = G._boundary(\"X\", body, model_node=False)\n915\t\n916\t    class FakeRuntime:\n917\t        context = None\n918\t\n919\t    update = bound({}, FakeRuntime())\n920\t    assert update[\"pending_failure\"][\"class\"] == \"system\"\n921\t    assert update[\"pending_failure\"][\"cause\"] == \"unhandled\"\n922\t    assert update[\"pending_guard\"] is None\n923\t    assert R.decide(\"X\", update) == R.TERMINAL\n924\t\n925\t\n926\tdef test_a_graceful_signal_at_the_boundary_routes_through_the_interrupt_gate():\n927\t    class Token:\n928\t        def is_set(self):\n929\t            return True\n930\t\n931\t    class FakeRuntime:\n932\t        class context:\n933\t            signal_token = Token()\n934\t\n935\t    def body(state, context):\n936\t        return {\"pending_guard\": {\"node\": \"D01_VALIDATE_AND_FREEZE_INPUTS\", \"value\": \"inputs_frozen\"}}\n937\t\n938\t    update = G._boundary(\"D01_VALIDATE_AND_FREEZE_INPUTS\", body, model_node=False)({}, FakeRuntime())\n939\t    assert update[\"pending_guard\"][\"interrupt_requested\"] is True\n940\t    assert R.route_frozen_inputs(update) == R.INTERRUPT_GATE\n941\t\n942\t\n943\tdef test_a_classified_failure_outranks_a_graceful_interrupt():\n944\t    state = {\n945\t        \"pending_failure\": {\"class\": \"system\", \"cause\": \"integrity\"},\n946\t        \"pending_guard\": {\"node\": \"D01\", \"value\": None, \"interrupt_requested\": True},\n947\t    }\n948\t    assert R.route_frozen_inputs(state) == R.TERMINAL\n949\t\n950\t\n951\tdef test_an_undeclared_guard_value_raises_rather_than_routing():\n952\t    state = {\"pending_guard\": {\"node\": \"D05_SELECT_NEXT_UNIT\", \"value\": \"invented\"}}\n953\t    with pytest.raises(R.RoutingViolation, match=\"undeclared guard value\"):\n954\t        R.route_unit_selection(state)\n955\t\n956\t\n957\tdef test_every_declared_guard_value_of_every_owned_node_has_a_destination():\n958\t    R.assert_guard_table_total(NODE_CATALOGUE)\n959\t    for node_id, spec in NODE_CATALOGUE.items():\n960\t        for value in spec.guards:\n961\t            if (node_id, value) in R.NORMAL_EDGE_GUARDS:\n962\t                continue\n963\t            assert (\n964\t                value in R.GUARD_DESTINATIONS.get(node_id, {})\n965\t                or value in R.DYNAMIC_GUARDS.get(node_id, {})\n966\t                or value in R.FANOUT_GUARDS.get(node_id, {})\n967\t            ), (node_id, value)\n968\t\n969\t\n970\tdef test_the_runtime_context_factory_holds_no_model_client_or_routing_authority(tmp_path):\n971\t    context = G.build_runtime_context(\n972\t        engine_root=REPO_ROOT,\n973\t        output_root=tmp_path,\n974\t        run_id=\"run-topology\",\n975\t        curriculum_digest=\"0\" * 64,\n976\t    )\n977\t    assert isinstance(context, RuntimeContext)\n978\t    for forbidden in (\"model_client\", \"llm\", \"router\", \"routing_authority\", \"state\"):\n979\t        assert not hasattr(context, forbidden)\n980\t    assert isinstance(context.transport_registry, tp.CliTransport)\n981\t    assert not isinstance(context.transport_registry, tp.FakeCliTransport)\n982\t    assert callable(context.clock)\n983\t"}]},"parent_tool_use_id":null,"session_id":"c99ac6b6-b2e1-439f-807d-525bac88ba75","uuid":"8b716e5b-bbbe-40f6-bb58-8f0d04f827a9","timestamp":"2026-08-12T20:46:44.976Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N20_GRAPH_COMPILER/attempt-20260812T204630.221920Z-049a9cb807/repo/tests/runtime/test_plan26_topology.py","content":"\"\"\"Plan 26 topology gate (spec sections 3.3, 4, 8): N20's compiled skeleton.\n\nEvery assertion here runs against a real `StateGraph`/`CompiledStateGraph` built\nfrom the real N22/N23 callables. Nothing is mocked: a simulated compilation\nwould prove that a stand-in compiles, which is the one thing this file exists to\nrule out.\n\nScope. N20 registers the fixed skeleton:\n\n    START -> D00 -> {D01 -> D02, D00R} -> D03 -> D04 -> {D05, D92}\n    D00 -> D96 -> D98 -> END        (orphan recovery)\n\nN30 has since registered the per-unit path (D05-D15 with its source and visual\n`Send` map/reduce) into the same builder, and N31/N32 still owe the repair,\nacceptance, and workbook branches. So these tests assert N20's properties —\nbinding rejection by stable ID, bounded cycles, worker->barrier fan-out shape,\nmodel nodes holding no routing or acceptance authority — against whatever\ntopology is actually compiled now, rather than against a frozen skeleton\nsnapshot that a later graph node would falsify by doing its job.\n\nSkips only where the hash-locked environment is absent; the node's evidence was\nproduced by running this file inside it.\n\"\"\"\n\nimport ast\nimport hashlib\nimport re\nimport shutil\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\ntry:  # pragma: no cover - environment probe, not behavior\n    import langgraph  # noqa: F401\n    import langgraph.checkpoint.sqlite  # noqa: F401\nexcept ModuleNotFoundError as exc:  # pragma: no cover\n    raise unittest.SkipTest(\n        \"plan26 hash-locked environment not installed \"\n        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n        f\"{exc}\"\n    ) from exc\n\nimport pytest\nfrom langgraph._internal._constants import RESERVED\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.graph.state import CompiledStateGraph\nfrom langgraph.types import Send\n\nfrom runtime.langgraph_factory import graph as G\nfrom runtime.langgraph_factory import model_nodes as mn\nfrom runtime.langgraph_factory import routing as R\nfrom runtime.langgraph_factory import transport as tp\nfrom runtime.langgraph_factory.nodes import NODE_CATALOGUE, node_registry\nfrom runtime.langgraph_factory.state import (\n    FACTORY_STATE_FIELDS,\n    FactoryInput,\n    FactoryOutput,\n    FactoryState,\n    RuntimeContext,\n)\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nGRAPH_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"graph.py\"\nROUTING_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"routing.py\"\n\n# Spec 8.1: \"There is no edge from a model directly to acceptance, terminal,\n# checkpoint initialization, unit selection, workbook assembly, or release\",\n# plus resume re-entry (spec 6.2 D92 forbids a model as a stored destination).\n#\n# The reduction nodes D16/D28 are deliberately NOT here: spec 8.1 wires\n# `M05 -> D16` and `M07 -> D28` on purpose, because a review is *evidence for*\n# the code-computed denominator, not the reduction itself. \"Models hold no\n# reduction authority\" is proven below as a channel-authority property, which is\n# where that authority actually lives.\nAUTHORITY_NODES = frozenset({\n    \"D04_INITIALIZE_OR_RESUME\",\n    \"D05_SELECT_NEXT_UNIT\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n    \"D25_ASSEMBLE_WORKBOOK\",\n    \"D32_RECOMPUTE_FINAL_RELEASE\",\n    \"D92_REENTER_VALIDATED_FRONTIER\",\n    \"D98_WRITE_TERMINAL\",\n    END,\n})\n\n# (dispatching node, fan-out guard value) -> (dispatching guard, worker, barrier).\n# The barrier is the deterministic node that owns the fan-out's denominator and to\n# which the worker returns; for M01 that is the next node of whichever superstep\n# the phase advance selects. A model fan-out's dispatching guard resolves to D90,\n# not to the worker: the `Send`s are emitted by D90's guard, from the packet D90\n# restaged with one committed attempt reservation per member.\nFANOUT_SHAPES = {\n    (\"D06_COMPILE_SOURCE_REQUESTS\", \"discovery_fanout\"): (\n        R.route_source_discovery_fanout,\n        \"M01_RESEARCH_UNIT_SOURCES\",\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n    ),\n    (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"interpretation_fanout\"): (\n        R.route_source_interpretation_fanout,\n        \"M01_RESEARCH_UNIT_SOURCES\",\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    ),\n    (\"D10_COMPILE_VISUAL_BRIEFS\", \"deterministic_visual_fanout\"): (\n        R.route_visual_briefs,\n        \"D11_CREATE_DETERMINISTIC_VISUALS\",\n        \"D12_VISUAL_BARRIER_AND_JOIN\",\n    ),\n    (\"D12_VISUAL_BARRIER_AND_JOIN\", \"model_visual_fanout\"): (\n        R.route_visual_barrier,\n        \"M04_CREATE_UNIT_VISUALS\",\n        \"D12_VISUAL_BARRIER_AND_JOIN\",\n    ),\n}\n\n\ndef _send_emitting_guard(source: str, value: str):\n    \"\"\"The guard that actually emits the `Send`s for this fan-out, and its record.\n\n    For a model fan-out that is D90's guard reading D90's restaged packet, because\n    spec 6.2 requires the attempt counter to be committed before dispatch; for a\n    deterministic fan-out it is the dispatching node's own guard.\n    \"\"\"\n\n    if R.FANOUT_GUARDS[source][value] == R.ATTEMPT_RESERVATION:\n        return R.route_attempt_reservation, R.ATTEMPT_RESERVATION, \"authorized\"\n    return FANOUT_SHAPES[(source, value)][0], source, value\n\n\n@pytest.fixture(scope=\"module\")\ndef output_root():\n    root = Path(tempfile.mkdtemp(prefix=\"plan26_n20_topology_\"))\n    yield root\n    shutil.rmtree(root, ignore_errors=True)\n\n\n@pytest.fixture(scope=\"module\")\ndef compiled(output_root) -> CompiledStateGraph:\n    return G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n\n\ndef fresh_builder() -> StateGraph:\n    return StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n\n\n# ======================================================= state/channel precondition\n\n\ndef test_the_state_schema_declares_no_langgraph_reserved_channel_name():\n    \"\"\"A reserved channel name makes the production state schema uncompilable.\n\n    LangGraph 1.2.9 rejects `checkpoint_ns` (and `checkpoint_id`, `configurable`,\n    ...) as channel names in `validate_graph`, so any such field in\n    `FactoryState` fails compilation of the one production graph.\n    \"\"\"\n\n    clashes = sorted(set(FACTORY_STATE_FIELDS) & set(RESERVED))\n    assert clashes == [], (\n        f\"FactoryState declares LangGraph-reserved channel name(s) {clashes}; \"\n        f\"owner N11_STATE_REDUCERS (rework edge `state_or_reducer`)\"\n    )\n\n\n# ====================================================== TEST 1: the catalogue compiles\n\n\ndef test_the_available_catalogue_compiles_against_real_node_callables(compiled):\n    bindings = G.binding_inventory()\n    registry = node_registry()\n\n    assert compiled.name == G.GRAPH_NAME == \"plan26_curriculum_factory\"\n    assert isinstance(compiled, CompiledStateGraph)\n\n    # 22 deterministic bodies (N22) + 8 model adapters + D90/D91 (N23), all real\n    # callables.\n    assert set(registry) == set(NODE_CATALOGUE)\n    assert len(registry) == 22\n    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n    assert set(mn.MODEL_BOOKKEEPING_NODES) == {R.ATTEMPT_RESERVATION, R.MODEL_FAILURE_CLASSIFIER}\n    assert set(bindings) == (\n        set(registry) | set(mn.MODEL_NODE_ADAPTERS) | set(mn.MODEL_BOOKKEEPING_NODES)\n    )\n    assert len(bindings) == 32\n\n    drawn = compiled.get_graph()\n    assert set(drawn.nodes) - {START, END} == set(bindings)\n\n    for node_id, body in bindings.items():\n        module = G._binding_record(node_id, body)[\"module\"]\n        assert module.startswith(\"runtime.langgraph_factory.\"), (node_id, module)\n\n\ndef test_start_has_exactly_one_edge_and_d98_is_the_only_registered_end_edge(compiled):\n    drawn = compiled.get_graph()\n    starts = [edge for edge in drawn.edges if edge.source == START]\n    assert [edge.target for edge in starts] == [\"D00_BOOTSTRAP_EPISODE\"]\n\n    registered_end_sources = sorted(\n        source for source, target in G.SKELETON_NORMAL_EDGES if target == END\n    )\n    assert registered_end_sources == [\"D98_WRITE_TERMINAL\"]\n\n    # D98's body is the real N22-owned terminal writer, not a local shim.\n    d98 = node_registry()[\"D98_WRITE_TERMINAL\"]\n    assert G._binding_record(\"D98_WRITE_TERMINAL\", d98)[\"module\"] == (\n        \"runtime.langgraph_factory.nodes.terminal\"\n    )\n\n    # LangGraph draws a dead-end node as reaching END. In this skeleton the only\n    # such nodes are the frontier N30 still owes; nothing else leaks to END.\n    drawn_end = {edge.source for edge in drawn.edges if edge.target == END}\n    assert drawn_end - {\"D98_WRITE_TERMINAL\"} <= set(G.DEFERRED_TOPOLOGY)\n    for node_id in drawn_end - {\"D98_WRITE_TERMINAL\"}:\n        assert G.DEFERRED_TOPOLOGY[node_id] == \"N30_UNIT_GRAPH\"\n\n\ndef test_the_skeleton_wires_exactly_the_declared_edges(compiled):\n    topology = G.compiled_topology(compiled)\n    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n\n    for source, target in (\n        (START, \"D00_BOOTSTRAP_EPISODE\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n        (\"D98_WRITE_TERMINAL\", END),\n    ):\n        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n\n    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n    # single successor are the whole of it.\n    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n        \"D98_WRITE_TERMINAL\"\n    }\n\n\n# ============================================ TEST 2: bad bindings fail by stable ID\n\n\ndef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n    return {}\n\n\ndef test_a_missing_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings.pop(\"D98_WRITE_TERMINAL\")\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_duplicate_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_an_uncallable_binding_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n    # Pin the required set to the real skeleton so the dangling-endpoint check is\n    # what rejects the edge, not the missing-binding check that shadows it.\n    required = G._skeleton_required_nodes()\n    monkeypatch.setattr(G, \"_skeleton_required_nodes\", lambda: required)\n    monkeypatch.setattr(\n        G,\n        \"SKELETON_NORMAL_EDGES\",\n        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n    )\n    with pytest.raises(G.GraphBindingError, match=r\"N20-EDGE-DANGLING:D99_NOT_A_NODE\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_a_wired_node_with_no_callable_fails_the_build_by_stable_id(monkeypatch):\n    monkeypatch.setattr(\n        G,\n        \"SKELETON_NORMAL_EDGES\",\n        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n    )\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D99_NOT_A_NODE\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_an_unwired_undeclared_node_fails_the_build_by_stable_id(monkeypatch):\n    # The example node is read from the live table rather than pinned: a node\n    # deferred today is wired tomorrow by the graph node that owns it, and this\n    # negative case is about the rejection, not about any particular node.\n    assert G.DEFERRED_TOPOLOGY, (\n        \"every registered node is now wired, so this case needs a different \"\n        \"fixture: a registered node that is neither wired nor declared deferred\"\n    )\n    node_id = sorted(G.DEFERRED_TOPOLOGY)[0]\n    deferred = dict(G.DEFERRED_TOPOLOGY)\n    deferred.pop(node_id)\n    monkeypatch.setattr(G, \"DEFERRED_TOPOLOGY\", deferred)\n    with pytest.raises(\n        G.GraphBindingError, match=rf\"N20-NODE-UNDECLARED:{re.escape(node_id)}\"\n    ):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_an_unrouted_declared_guard_value_fails_the_build_by_stable_id(monkeypatch):\n    destinations = {k: dict(v) for k, v in R.GUARD_DESTINATIONS.items()}\n    destinations[\"D05_SELECT_NEXT_UNIT\"].pop(\"manifest_exhausted\")\n    monkeypatch.setattr(R, \"GUARD_DESTINATIONS\", destinations)\n    with pytest.raises(R.RoutingViolation, match=r\"N20-GUARD-UNROUTED:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\n# ================================================= TEST 3: cycles cross a real guard\n\n\ndef _simple_cycles(edges) -> set[frozenset[str]]:\n    \"\"\"Every simple cycle of the compiled graph, as its node set.\n\n    Each cycle is enumerated once by only extending a path through nodes that\n    sort after its entry point, so `A -> B -> A` is not also reported as\n    `B -> A -> B`.\n    \"\"\"\n\n    successors: dict[str, set[str]] = {}\n    for source, target in edges:\n        successors.setdefault(source, set()).add(target)\n\n    cycles: set[frozenset[str]] = set()\n\n    def walk(node, start, path):\n        for target in sorted(successors.get(node, ())):\n            if target == start and len(path) >= 2:\n                cycles.add(frozenset(path))\n            elif target not in path and target > start:\n                walk(target, start, path | {target})\n\n    for start in sorted(successors):\n        walk(start, start, {start})\n    return cycles\n\n\ndef _cycle_bounds(cycle: frozenset[str]) -> list[str]:\n    \"\"\"The members of `cycle` that stop it repeating indefinitely.\n\n    A node bounds a cycle if it either declares an exhaustion guard value whose\n    destination leaves the cycle, or dispatches a fan-out that refuses to repeat\n    without a freshly staged worker projection — the guard invents no projection,\n    so a further lap requires work some node committed a denominator to.\n    \"\"\"\n\n    bounds: list[str] = []\n    for node_id in sorted(cycle):\n        row = R.GUARD_DESTINATIONS.get(node_id, {})\n        if any(\"exhausted\" in value and row[value] not in cycle for value in row):\n            bounds.append(node_id)\n            continue\n        if node_id not in R.FANOUT_GUARDS:\n            continue\n        for value in R.FANOUT_GUARDS[node_id]:\n            guard, guard_node, guard_value = _send_emitting_guard(node_id, value)\n            with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n                guard({\"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}}})\n        bounds.append(node_id)\n    return bounds\n\n\ndef test_every_cycle_in_the_compiled_graph_crosses_an_exhaustion_guard(compiled):\n    \"\"\"No wired cycle can repeat forever, and none of them is a closed trap.\n\n    Spec 8.1 wires real loops — the M01 discovery superstep, the visual barrier's\n    worker/barrier join, and (once N31/N32 land) the repair and workbook cycles.\n    What the graph must never contain is a cycle with no deterministic bound, so\n    this asserts the bound for every cycle that is actually compiled and holds\n    the frozen guard rows the not-yet-wired cycles will close through.\n    \"\"\"\n\n    edges = {\n        (source, target)\n        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n        if target != END\n    }\n    cycles = _simple_cycles(edges)\n\n    # Not vacuous: spec 8.1's own discovery superstep is wired and is a cycle. It\n    # runs through D90, which is where the attempt bound that closes it is committed.\n    assert frozenset({\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n        R.ATTEMPT_RESERVATION,\n        \"M01_RESEARCH_UNIT_SOURCES\",\n    }) in cycles\n\n    for cycle in sorted(cycles, key=sorted):\n        assert _cycle_bounds(cycle), (\n            f\"cycle {sorted(cycle)} crosses no exhaustion guard and no fan-out \"\n            \"dispatcher, so nothing stops it repeating\"\n        )\n        exits = {\n            target\n            for source, target in edges\n            if source in cycle and target not in cycle\n        } - {R.INTERRUPT_GATE, R.TERMINAL}\n        assert exits, f\"cycle {sorted(cycle)} reaches no product node outside itself\"\n\n    # Every loop-closing guard row exhausts deterministically before repeating.\n    for node_id in (\"D17_CLASSIFY_UNIT_FINDINGS\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"):\n        assert R.GUARD_DESTINATIONS[node_id][\"convergence_exhausted\"] == R.TERMINAL\n    assert R.GUARD_DESTINATIONS[\"D18_PLAN_TARGETED_UNIT_REPAIR\"][\"convergence_exhausted\"] == (\n        R.TERMINAL\n    )\n    assert R.GUARD_DESTINATIONS[\"D90_RESERVE_MODEL_ATTEMPT\"][\"exhausted\"] == R.TERMINAL\n    assert R.GUARD_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"][\"exhausted\"] == R.TERMINAL\n    # The unit loop only closes back to D05 through acceptance, never directly.\n    assert R.GUARD_DESTINATIONS[\"D23_CHECKPOINT_ACCEPTED_UNIT\"][\"checkpoint_correlated\"] == (\n        \"D05_SELECT_NEXT_UNIT\"\n    )\n\n\n# ================================== TEST 4: models hold no acceptance/route authority\n\n\ndef test_no_model_node_has_an_edge_to_an_authority_node(compiled):\n    edges = {\n        (source, target)\n        for source, target, _ in G.compiled_topology(compiled)[\"edges\"]\n    }\n    for source, target in edges:\n        if source in mn.MODEL_NODE_IDS:\n            assert target not in AUTHORITY_NODES, f\"model edge {source} -> {target}\"\n\n    for job_id, destination in R.MODEL_RESULT_DESTINATIONS.items():\n        assert job_id in mn.MODEL_NODE_IDS\n        assert destination not in AUTHORITY_NODES, (job_id, destination)\n\n    # M01's two supersteps are the remaining model successors.\n    assert R.route_m01_research({\"source_discoveries\": {\"k\": {}}}) == (\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n    )\n    assert R.route_m01_research({\"source_interpretations\": {\"k\": {}}}) == (\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n    )\n    for destination in (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"):\n        assert destination not in AUTHORITY_NODES\n\n\ndef test_a_model_node_holds_no_acceptance_reduction_or_terminal_channel_authority():\n    \"\"\"Where the authority actually lives: the channels a model may write.\n\n    `M05 -> D16` is a legal edge precisely because M05 cannot write the reduction\n    result, the accepted receipt, any artifact head, or the terminal — D16\n    recomputes the denominator from evidence it does not control.\n    \"\"\"\n\n    forbidden = {\n        \"artifact_heads\",\n        \"accepted_unit_receipts\",\n        \"accepted_unit_checkpoint_receipts\",\n        \"deterministic_checks\",\n        \"workbook_head\",\n        \"final_release_audits\",\n        \"cursor\",\n        \"resume_frontier\",\n        \"terminal\",\n        \"terminal_history\",\n        \"terminal_candidate\",\n    }\n    assert mn.MODEL_NODE_WRITABLE_FIELDS & forbidden == set()\n    assert forbidden <= set(FACTORY_STATE_FIELDS)\n    assert mn.FORBIDDEN_MODEL_NODE_FIELDS & mn.MODEL_NODE_WRITABLE_FIELDS == set()\n\n    # The reducers that consume a review are deterministic nodes, and their\n    # destinations are decided by the code-owned table, not by the review body.\n    assert R.GUARD_DESTINATIONS[\"D16_REDUCE_UNIT_EVIDENCE\"] == {\n        \"unit_denominator_passed\": \"D22_ACCEPT_UNIT\",\n        \"unit_findings_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    }\n    assert R.GUARD_DESTINATIONS[\"D28_REDUCE_WORKBOOK_EVIDENCE\"] == {\n        \"workbook_denominator_passed\": \"D32_RECOMPUTE_FINAL_RELEASE\",\n        \"workbook_findings_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n    }\n\n\ndef test_routing_never_lets_a_model_result_name_its_own_destination():\n    \"\"\"A guard reads code-owned tables and result *presence*, never a model body.\"\"\"\n\n    tree = ast.parse(ROUTING_PY.read_text(encoding=\"utf-8\"))\n    model_result_guards = {\n        \"_route_model_result\",\n        \"route_m01_research\",\n        \"route_m02_domain\",\n        \"route_m03_content\",\n        \"route_m04_visual\",\n        \"route_m05_unit_review\",\n        \"route_m06_unit_repair\",\n        \"route_m07_workbook_review\",\n        \"route_m08_workbook_repair\",\n    }\n    # The only model-written channels a guard may touch, and only to test that a\n    # result set exists — never to read a value out of a model's output body.\n    allowed_reads = {\"source_discoveries\", \"source_interpretations\"}\n    seen = set()\n    for node in ast.walk(tree):\n        if not isinstance(node, ast.FunctionDef) or node.name not in model_result_guards:\n            continue\n        seen.add(node.name)\n        body = list(node.body)\n        if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):\n            body = body[1:]  # the docstring is prose, not behavior\n        for statement in body:\n            for inner in ast.walk(statement):\n                if not (isinstance(inner, ast.Constant) and isinstance(inner.value, str)):\n                    continue\n                value = inner.value\n                if value in allowed_reads:\n                    continue\n                assert value not in mn.MODEL_NODE_WRITABLE_FIELDS, (\n                    f\"{node.name} reads model-written channel {value!r}\"\n                )\n                assert value in R.MODEL_RESULT_DESTINATIONS.values() or value in (\n                    set(R.MODEL_RESULT_DESTINATIONS)\n                    | {\"D06B_RETRIEVE_SOURCE_CANDIDATES\", \"D07_CORRELATE_AND_ADMIT_SOURCES\"}\n                ) or \"no result set exists\" in value, (\n                    f\"{node.name} names non-destination string {value!r}\"\n                )\n    assert seen == model_result_guards\n\n\ndef test_a_stored_frontier_may_not_name_a_model_node():\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D92_REENTER_VALIDATED_FRONTIER\",\n            \"value\": \"deterministic_reentry\",\n            \"detail\": {\"destination\": \"M03_WRITE_UNIT_CONTENT\"},\n        }\n    }\n    with pytest.raises(R.RoutingViolation, match=\"is a model node\"):\n        R.route_frontier_reentry(state)\n\n\n# ========================================== TEST 5: Send follows worker->barrier only\n\n\ndef test_every_registered_fanout_has_the_worker_to_barrier_shape(compiled):\n    \"\"\"Every compiled fan-out is worker->barrier, the only shape spec 10 allows.\n\n    One `Send` per staged worker projection, all naming a single worker node, and\n    the worker's only forward destination is the deterministic node that owns the\n    denominator — never a second fan-out and never an authority node. This is the\n    same property the guard-level tests below prove in isolation, asserted here\n    against the graph that actually compiled.\n\n    A model fan-out reaches its worker through D90, so the compiled shape is\n    dispatcher -> D90 -> worker -> barrier: spec 6.2 requires the attempt counter\n    committed before dispatch, and every adapter refuses an unreserved packet.\n    \"\"\"\n\n    declared = {\n        (source, value): dispatch\n        for source, row in R.FANOUT_GUARDS.items()\n        for value, dispatch in row.items()\n    }\n    assert set(FANOUT_SHAPES) == set(declared), (\n        \"a fan-out guard was registered or removed without updating the shape \"\n        \"table this test checks it against\"\n    )\n\n    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n    for (source, value), (dispatch_guard, worker, barrier) in sorted(FANOUT_SHAPES.items()):\n        dispatch = declared[(source, value)]\n        assert dispatch not in mn.MODEL_NODE_IDS, (\n            f\"{source} dispatches straight to model node {dispatch} with no reservation\"\n        )\n        assert (source, dispatch) in edges, f\"{source} has no compiled edge to {dispatch}\"\n        if dispatch == R.ATTEMPT_RESERVATION:\n            assert (dispatch, worker) in edges, f\"D90 has no compiled edge to worker {worker}\"\n        else:\n            assert dispatch == worker\n        assert (worker, barrier) in edges, f\"worker {worker} has no compiled edge to {barrier}\"\n        assert barrier not in mn.MODEL_NODE_IDS, f\"{barrier} is a model node, not a barrier\"\n\n        projections = [{\"key\": f\"{source}/{index}\"} for index in range(3)]\n        packet = {\"dispatch\": worker, \"packets\": projections}\n        routed = dispatch_guard(\n            {\"pending_guard\": {\"node\": source, \"value\": value, \"detail\": {}},\n             \"pending_packet\": packet}\n        )\n        if dispatch == R.ATTEMPT_RESERVATION:\n            assert routed == R.ATTEMPT_RESERVATION\n\n        emitting, guard_node, guard_value = _send_emitting_guard(source, value)\n        sends = emitting(\n            {\n                \"pending_guard\": {\"node\": guard_node, \"value\": guard_value, \"detail\": {}},\n                \"pending_packet\": packet,\n            }\n        )\n        assert [type(item) for item in sends] == [Send, Send, Send]\n        assert {item.node for item in sends} == {worker}\n        assert [item.arg for item in sends] == projections\n\n    # A worker's forward successors are exactly the barriers declared for it, so\n    # a fanned-out worker rejoins a denominator and fans out no further. D91 is\n    # excluded with the other non-forward edges: a model worker's failure edge is\n    # a recovery edge, not a second barrier.\n    barriers: dict[str, set[str]] = {}\n    for _guard, worker, barrier in FANOUT_SHAPES.values():\n        barriers.setdefault(worker, set()).add(barrier)\n    for worker, expected in sorted(barriers.items()):\n        successors = {target for source, target in edges if source == worker} - {\n            R.INTERRUPT_GATE,\n            R.TERMINAL,\n            R.MODEL_FAILURE_CLASSIFIER,\n            END,\n        }\n        assert successors == expected, (worker, sorted(successors), sorted(expected))\n\n\ndef test_no_compiled_edge_enters_a_model_node_except_from_d90(compiled):\n    \"\"\"Spec 6.2 D90: the attempt counter is committed *before* dispatch.\n\n    The counter cannot be minted by the dispatching node (it would be committed\n    in the same superstep as the dispatch) nor invented at routing time, so the\n    only compiled predecessor a model worker may have is D90. Every N23 adapter\n    enforces the same rule from the other side by raising `AttemptNotReserved`.\n    \"\"\"\n\n    for node_id, row in R.GUARD_DESTINATIONS.items():\n        for value, destination in row.items():\n            assert destination not in mn.MODEL_NODE_IDS, (\n                f\"{node_id}.{value} routes to {destination} with no reservation\"\n            )\n\n    edges = {(source, target) for source, target, _ in G.compiled_topology(compiled)[\"edges\"]}\n    entered = {target for _source, target in edges if target in mn.MODEL_NODE_IDS}\n    assert entered, \"no model node is wired, so this would pass vacuously\"\n    for worker in sorted(entered):\n        predecessors = {source for source, target in edges if target == worker}\n        assert predecessors == {R.ATTEMPT_RESERVATION}, (worker, sorted(predecessors))\n\n\ndef test_a_fanout_guard_emits_one_send_per_staged_worker_projection():\n    packet = {\n        \"dispatch\": \"M04_CREATE_UNIT_VISUALS\",\n        \"briefs\": [{\"key\": \"u1/visual/a\"}, {\"key\": \"u1/visual/b\"}],\n    }\n    # The dispatcher hands the staged map to D90 rather than to the worker: no\n    # `Send` may be emitted before the attempt counter is committed (spec 6.2).\n    assert R.route_visual_barrier(\n        {\n            \"pending_guard\": {\n                \"node\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n                \"value\": \"model_visual_fanout\",\n                \"detail\": {},\n            },\n            \"pending_packet\": packet,\n        }\n    ) == R.ATTEMPT_RESERVATION\n\n    sends = R.route_attempt_reservation(\n        {\n            \"pending_guard\": {\n                \"node\": R.ATTEMPT_RESERVATION,\n                \"value\": \"authorized\",\n                \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n            },\n            \"pending_packet\": packet,\n        }\n    )\n    assert [type(item) for item in sends] == [Send, Send]\n    assert {item.node for item in sends} == {\"M04_CREATE_UNIT_VISUALS\"}\n    assert [item.arg[\"key\"] for item in sends] == [\"u1/visual/a\", \"u1/visual/b\"]\n    # Worker -> barrier: the worker's declared return destination is the barrier\n    # that owns the denominator, which is a normal edge, not another Send.\n    assert R.MODEL_RESULT_DESTINATIONS[\"M04_CREATE_UNIT_VISUALS\"] == (\n        \"D12_VISUAL_BARRIER_AND_JOIN\"\n    )\n\n\ndef test_a_fanout_guard_refuses_an_unstaged_or_mixed_dispatch():\n    base = {\n        \"pending_guard\": {\n            \"node\": R.ATTEMPT_RESERVATION,\n            \"value\": \"authorized\",\n            \"detail\": {\"job_id\": \"M04_CREATE_UNIT_VISUALS\"},\n        }\n    }\n    with pytest.raises(R.RoutingViolation, match=\"no staged\"):\n        R.route_attempt_reservation(dict(base))\n    with pytest.raises(R.RoutingViolation, match=\"no dispatch destination\"):\n        R.route_attempt_reservation({**base, \"pending_packet\": {\"briefs\": [{\"key\": \"a\"}]}})\n    with pytest.raises(R.RoutingViolation, match=\"no non-empty worker projection\"):\n        R.route_attempt_reservation(\n            {**base, \"pending_packet\": {\"dispatch\": \"M04_CREATE_UNIT_VISUALS\", \"briefs\": []}}\n        )\n\n\n# ============================= TEST 6: arbitrary manifest lengths and empty subsets\n\n\ndef test_no_curriculum_specific_manifest_length_or_order_is_hardcoded():\n    for path in (GRAPH_PY, ROUTING_PY):\n        source = path.read_text(encoding=\"utf-8\")\n        tree = ast.parse(source)\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Constant) and isinstance(node.value, str):\n                assert not re.match(r\"^(U|L)\\d{2,}\", node.value), (\n                    f\"{path.name} names curriculum unit {node.value!r}\"\n                )\n        for forbidden in (\n            \"unit_count\",\n            \"UNIT_COUNT\",\n            \"MANIFEST_LENGTH\",\n            \"manifest_length\",\n            \"expected_units\",\n        ):\n            assert forbidden not in source, f\"{path.name} hardcodes {forbidden!r}\"\n        # No node is created per known unit: registration reads only the frozen\n        # catalogue, never a manifest.\n        assert \"manifest\" not in source.replace(\"manifest_path\", \"\").replace(\n            \"manifest coverage\", \"\"\n        ).replace(\"MANIFEST_COVERAGE\", \"\").lower() or \"for unit\" not in source\n\n\ndef test_the_builder_registers_a_fixed_node_set_independent_of_any_manifest(compiled):\n    drawn = set(compiled.get_graph().nodes) - {START, END}\n    assert drawn == set(G.binding_inventory())\n    assert not [node for node in drawn if re.search(r\"(unit|lesson)_\\d\", node.lower())]\n\n\ndef test_an_empty_deterministic_visual_subset_routes_straight_to_the_barrier():\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D10_COMPILE_VISUAL_BRIEFS\",\n            \"value\": \"no_deterministic_visuals\",\n            \"detail\": {},\n        }\n    }\n    assert R.route_visual_briefs(state) == \"D12_VISUAL_BARRIER_AND_JOIN\"\n\n\ndef test_an_exhausted_manifest_routes_to_coverage_proof_at_any_length():\n    state = {\n        \"pending_guard\": {\n            \"node\": \"D05_SELECT_NEXT_UNIT\",\n            \"value\": \"manifest_exhausted\",\n            \"detail\": {},\n        }\n    }\n    assert R.route_unit_selection(state) == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n\n\n# ================================================ TEST 7: digest stability and drift\n\n\ndef test_identical_real_bindings_yield_an_identical_digest(output_root):\n    first = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    second = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    assert first is not second\n    assert G.graph_digest(first) == G.graph_digest(second)\n    assert len(G.graph_digest(first)) == 64\n\n\ndef test_a_changed_callable_changes_the_digest(compiled, monkeypatch):\n    baseline = G.graph_digest(compiled)\n    drifted = G.binding_inventory()\n    drifted[\"D05_SELECT_NEXT_UNIT\"] = drifted[\"D13_RENDER_UNIT\"]\n    monkeypatch.setattr(G, \"binding_inventory\", lambda: drifted)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_a_changed_state_schema_changes_the_digest(compiled, monkeypatch):\n    baseline = G.graph_digest(compiled)\n    reducers = dict(G.FIELD_REDUCER_CLASSES)\n    reducers[\"cursor\"] = \"append_unique\"\n    monkeypatch.setattr(G, \"FIELD_REDUCER_CLASSES\", reducers)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_a_changed_prompt_or_schema_file_changes_the_digest(compiled, monkeypatch, tmp_path):\n    baseline = G.graph_digest(compiled)\n    real = tp.resolve_prompt_path(tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\"))\n    drifted = tmp_path / real.name\n    drifted.write_bytes(real.read_bytes() + b\"\\n# drift\\n\")\n    assert hashlib.sha256(drifted.read_bytes()).hexdigest() != (\n        hashlib.sha256(real.read_bytes()).hexdigest()\n    )\n\n    original = tp.resolve_prompt_path\n\n    def patched(route):\n        path = original(route)\n        return drifted if path.name == real.name else path\n\n    monkeypatch.setattr(G.tp, \"resolve_prompt_path\", patched)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_the_digest_ignores_python_object_identity(compiled):\n    payload_one = G.compiled_topology(compiled)\n    payload_two = G.compiled_topology(compiled)\n    assert payload_one == payload_two\n    assert G._canonical_digest(payload_one) == G._canonical_digest(payload_two)\n\n\n# ============================================ TEST 8: no handwritten fallback controller\n\n\ndef test_production_graph_imports_contain_no_fallback_controller():\n    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n    imported: set[str] = set()\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Import):\n            imported.update(alias.name for alias in node.names)\n        elif isinstance(node, ast.ImportFrom):\n            imported.add(node.module or \"\")\n            imported.update(f\"{node.module or ''}.{alias.name}\" for alias in node.names)\n\n    for forbidden in (\n        \"runtime.curriculum_factory_graph\",\n        \"curriculum_factory_graph\",\n        \"CurriculumFactoryGraph\",\n        \"runtime.session_bridge\",\n    ):\n        assert not any(forbidden in name for name in imported), forbidden\n\n    source = GRAPH_PY.read_text(encoding=\"utf-8\")\n    for forbidden in (\"CurriculumFactoryGraph\", \"test_simulated\", \"fallback_controller\"):\n        assert forbidden not in source, f\"graph.py references {forbidden!r}\"\n\n    # The forbidden model-invocation dependencies stay out of the production path.\n    for forbidden in (\n        \"langchain\",\n        \"langchain_openai\",\n        \"langchain_google_genai\",\n        \"openai\",\n        \"google.generativeai\",\n    ):\n        assert not any(\n            name == forbidden or name.startswith(f\"{forbidden}.\") for name in imported\n        ), forbidden\n\n\ndef test_only_one_builder_and_one_compile_call_exist():\n    tree = ast.parse(GRAPH_PY.read_text(encoding=\"utf-8\"))\n    builders = [\n        node.name\n        for node in ast.walk(tree)\n        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"build_\")\n        and \"graph\" in node.name\n    ]\n    assert builders == [\"build_curriculum_factory_graph\"]\n\n    compiles = [\n        node\n        for node in ast.walk(tree)\n        if isinstance(node, ast.Call)\n        and isinstance(node.func, ast.Attribute)\n        and node.func.attr == \"compile\"\n    ]\n    assert len(compiles) == 1\n\n\n# ================================================== boundary and context behaviour\n\n\ndef test_the_node_boundary_injects_the_runtime_context_langgraph_would_not():\n    \"\"\"LangGraph passes `Runtime`, never the opened services.\n\n    N22/N23 bodies take the context as an explicit second argument, so without\n    this boundary every node would silently run with `runtime_context=None`.\n    \"\"\"\n\n    seen = {}\n\n    def body(state, context):\n        seen[\"context\"] = context\n        return {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n\n    bound = G._boundary(\"X\", body, model_node=False)\n\n    class FakeRuntime:\n        context = \"the-context\"\n\n    assert bound({}, FakeRuntime()) == {\"pending_guard\": {\"node\": \"X\", \"value\": \"ok\"}}\n    assert seen[\"context\"] == \"the-context\"\n\n\ndef test_the_node_boundary_classifies_an_unexpected_exception_as_a_system_failure():\n    def body(state, context):\n        raise ValueError(\"unexpected\")\n\n    bound = G._boundary(\"X\", body, model_node=False)\n\n    class FakeRuntime:\n        context = None\n\n    update = bound({}, FakeRuntime())\n    assert update[\"pending_failure\"][\"class\"] == \"system\"\n    assert update[\"pending_failure\"][\"cause\"] == \"unhandled\"\n    assert update[\"pending_guard\"] is None\n    assert R.decide(\"X\", update) == R.TERMINAL\n\n\ndef test_a_graceful_signal_at_the_boundary_routes_through_the_interrupt_gate():\n    class Token:\n        def is_set(self):\n            return True\n\n    class FakeRuntime:\n        class context:\n            signal_token = Token()\n\n    def body(state, context):\n        return {\"pending_guard\": {\"node\": \"D01_VALIDATE_AND_FREEZE_INPUTS\", \"value\": \"inputs_frozen\"}}\n\n    update = G._boundary(\"D01_VALIDATE_AND_FREEZE_INPUTS\", body, model_node=False)({}, FakeRuntime())\n    assert update[\"pending_guard\"][\"interrupt_requested\"] is True\n    assert R.route_frozen_inputs(update) == R.INTERRUPT_GATE\n\n\ndef test_a_classified_failure_outranks_a_graceful_interrupt():\n    state = {\n        \"pending_failure\": {\"class\": \"system\", \"cause\": \"integrity\"},\n        \"pending_guard\": {\"node\": \"D01\", \"value\": None, \"interrupt_requested\": True},\n    }\n    assert R.route_frozen_inputs(state) == R.TERMINAL\n\n\ndef test_an_undeclared_guard_value_raises_rather_than_routing():\n    state = {\"pending_guard\": {\"node\": \"D05_SELECT_NEXT_UNIT\", \"value\": \"invented\"}}\n    with pytest.raises(R.RoutingViolation, match=\"undeclared guard value\"):\n        R.route_unit_selection(state)\n\n\ndef test_every_declared_guard_value_of_every_owned_node_has_a_destination():\n    R.assert_guard_table_total(NODE_CATALOGUE)\n    for node_id, spec in NODE_CATALOGUE.items():\n        for value in spec.guards:\n            if (node_id, value) in R.NORMAL_EDGE_GUARDS:\n                continue\n            assert (\n                value in R.GUARD_DESTINATIONS.get(node_id, {})\n                or value in R.DYNAMIC_GUARDS.get(node_id, {})\n                or value in R.FANOUT_GUARDS.get(node_id, {})\n            ), (node_id, value)\n\n\ndef test_the_runtime_context_factory_holds_no_model_client_or_routing_authority(tmp_path):\n    context = G.build_runtime_context(\n        engine_root=REPO_ROOT,\n        output_root=tmp_path,\n        run_id=\"run-topology\",\n        curriculum_digest=\"0\" * 64,\n    )\n    assert isinstance(context, RuntimeContext)\n    for forbidden in (\"model_client\", \"llm\", \"router\", \"routing_authority\", \"state\"):\n        assert not hasattr(context, forbidden)\n    assert isinstance(context.transport_registry, tp.CliTransport)\n    assert not isinstance(context.transport_registry, tp.FakeCliTransport)\n    assert callable(context.clock)\n","numLines":983,"startLine":1,"totalLines":983}}}
