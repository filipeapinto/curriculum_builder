{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016FJyPMvFAodtbVzFiKviCn","type":"tool_result","content":"941\tdef test_a_real_compiled_graph_run_completes_a_full_d17_through_d21_repair_and_retest_loop_back_to_d16(\n942\t    tmp_path: Path,\n943\t) -> None:\n944\t    \"\"\"A real `D14 -> D17 -> D18 -> D19 -> D20 -> D21 -> ... -> D16` loop, then acceptance.\n945\t\n946\t    Enters at `D14_INVENTORY_AND_INSPECT_UNIT_PAGES`'s own `layout_repairable`\n947\t    guard -- a second one of the six DEFERRED_EDGES rows this test file's first\n948\t    section proves wired -- with a deterministically-repairable `unit layout`\n949\t    finding (module docstring above names exactly which of D13/D14/D15/M05 run\n950\t    for real vs. are seeded). D17 classifies it, D18 plans one deterministic\n951\t    repair child, D19 stages and produces the boundary-scoped candidate, D20\n952\t    admits it, and D21 dispatches the real fixed retest chain\n953\t    (`repair.RETEST_FIRST_NODE[\"unit layout\"]`) -- all through the real\n954\t    compiled graph. D16 then runs a second time, for real, over the retested\n955\t    evidence, and this time its denominator passes.\n956\t    \"\"\"\n957\t\n958\t    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n959\t    config = {\"configurable\": {\"thread_id\": \"repair-retest-loop\"}}\n960\t\n961\t    seed = _seeded_unit_id_state(pdf_sha256=\"f\" * 64, page_sha256=\"a\" * 64)\n962\t    seed[\"pending_guard\"] = {\n963\t        \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"layout_repairable\",\n964\t        \"detail\": {\n965\t            \"unit_id\": UNIT,\n966\t            \"findings\": [{\n967\t                \"owner\": \"unit layout\", \"check_id\": \"unit_page_inventory\", \"pointer\": \"/template\",\n968\t                \"message\": \"wrong template\", \"allowed_facts\": {\"/template\": \"v2\"},\n969\t            }],\n970\t        },\n971\t    }\n972\t    compiled.update_state(config, seed, as_node=\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\")\n973\t\n974\t    compiled.invoke(None, config=config, context=_NullRuntimeContext(), interrupt_before=[\"D13_RENDER_UNIT\"])\n975\t    mid = compiled.get_state(config).values\n976\t    assert repair.RETEST_FIRST_NODE[\"unit layout\"] == \"D13_RENDER_UNIT\"\n977\t    assert mid[\"retest_results\"][-1][\"dispatched_to\"] == \"D13_RENDER_UNIT\"\n978\t    assert mid[\"repair_requests\"][-1][\"owner\"] == \"unit layout\"\n979\t    layout_body_repaired = next(\n980\t        record for record in mid[\"artifact_versions\"]\n981\t        if record[\"stream\"] == stream_id(UNIT, \"layout\") and record.get(\"version\") == 2\n982\t    )\n983\t    assert layout_body_repaired[\"body\"][\"template\"] == \"v2\"  # only the granted pointer changed\n984\t\n985\t    # D13/D14/D15/M05 are not this node's write set (module docstring above);\n986\t    # their real return shapes are supplied directly rather than executed.\n987\t    retest_pdf_sha256, retest_page_sha256 = \"e\" * 64, \"1\" * 64\n988\t    compiled.update_state(\n989\t        config,\n990\t        {\n991\t            \"artifact_versions\": [{\n992\t                \"key\": \"layout-retest\", \"stream\": stream_id(UNIT, \"layout\"), \"version\": 3, \"parent_hash\": None,\n993\t                \"hash\": \"layout-hash-retest\", \"pdf_path\": \"/dev/null\", \"pdf_sha256\": retest_pdf_sha256,\n994\t                \"layout_path\": \"/dev/null\", \"layout_sha256\": \"l\" * 64,\n995\t                \"parents\": {\"domain\": None, \"content\": None, \"visuals\": None},\n996\t                \"renderer\": \"seeded-for-retest\", \"attempt\": 1,\n997\t            }],\n998\t            \"deterministic_checks\": [check_record(\n999\t                scope=\"unit\", owner=UNIT, head_hash=\"layout-hash-retest\",\n1000\t                check_id=\"unit_render_receipt\", attempt=1, result=\"PASS\", detail={},\n1001\t            )],\n1002\t            \"pending_guard\": {\"node\": \"D13_RENDER_UNIT\", \"value\": \"unit_rendered\", \"detail\": {\"unit_id\": UNIT}},\n1003\t        },\n1004\t        as_node=\"D13_RENDER_UNIT\",\n1005\t    )\n1006\t    compiled.update_state(\n1007\t        config,\n1008\t        {\n1009\t            \"unit_page_inventories\": [{\n1010\t                \"key\": \"inv-retest\", \"unit_id\": UNIT, \"pdf_sha256\": retest_pdf_sha256,\n1011\t                \"page_count\": 1, \"contiguous\": True, \"result\": \"PASS\",\n1012\t            }],\n1013\t            \"unit_page_inspections\": [{\n1014\t                \"key\": \"insp-retest\", \"unit_id\": UNIT, \"pdf_sha256\": retest_pdf_sha256, \"page\": 1,\n1015\t                \"page_sha256\": retest_page_sha256, \"problems\": [], \"result\": \"PASS\",\n1016\t            }],\n1017\t            \"deterministic_checks\": [check_record(\n1018\t                scope=\"unit\", owner=UNIT, head_hash=retest_pdf_sha256,\n1019\t                check_id=\"unit_page_inventory_receipt\", attempt=1, result=\"PASS\", detail={},\n1020\t            )],\n1021\t            \"pending_guard\": {\"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"pages_inspected\", \"detail\": {\"unit_id\": UNIT}},\n1022\t        },\n1023\t        as_node=\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n1024\t    )\n1025\t    packet = worker_packet(\n1026\t        run_id=RUN, episode_id=EPISODE, correlation_key=f\"retest/{UNIT}/review\",\n1027\t        projection={\"unit_pdf_sha256\": retest_pdf_sha256},\n1028\t    )\n1029\t    compiled.update_state(\n1030\t        config,\n1031\t        {\n1032\t            \"pending_packet\": staged_dispatch(\"M05_REVIEW_ACTUAL_UNIT\", [packet]),\n1033\t            \"pending_guard\": {\"node\": \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"value\": \"review_packet_frozen\", \"detail\": {\"unit_id\": UNIT}},\n1034\t        },\n1035\t        as_node=\"D15_FREEZE_UNIT_REVIEW_PACKET\",\n1036\t    )\n1037\t\n1038\t    # D90 (attempt reservation, N22-owned, pure bookkeeping) runs for real here.\n1039\t    compiled.invoke(None, config=config, context=_NullRuntimeContext(), interrupt_before=[\"M05_REVIEW_ACTUAL_UNIT\"])\n1040\t    assert compiled.get_state(config).next == (\"M05_REVIEW_ACTUAL_UNIT\",)\n1041\t\n1042\t    compiled.update_state(\n1043\t        config,\n1044\t        {\"unit_reviews\": [{\n1045\t            \"key\": \"candidate:review-retest\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n1046\t            \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\", \"unit_pdf_sha256\": retest_pdf_sha256,\n1047\t            \"payload\": {\"overall_findings\": [], \"page_findings\": [{\"page_number\": 1, \"page_sha256\": retest_page_sha256, \"findings\": []}]},\n1048\t        }]},\n1049\t        as_node=\"M05_REVIEW_ACTUAL_UNIT\",\n1050\t    )\n1051\t\n1052\t    with pytest.raises(KeyError) as excinfo:\n1053\t        compiled.invoke(None, config=config, context=_NullRuntimeContext())\n1054\t    assert excinfo.value.args[0] == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n1055\t\n1056\t    final = compiled.get_state(config).values\n1057\t    assert final.get(\"pending_failure\") is None\n1058\t    receipt = final[\"accepted_unit_receipts\"][UNIT]\n1059\t    assert receipt[\"denominator\"][\"repair\"] == {\"result\": \"PASS\", \"open_requests\": 0}\n1060\t    assert receipt[\"denominator\"][\"pages\"][\"pdf_sha256\"] == retest_pdf_sha256\n1061\t    assert final[\"checkpoint_metadata\"][-1][\"receipt_hash\"] == receipt[\"receipt_hash\"]\n1062\t"}]},"parent_tool_use_id":null,"session_id":"b21865dd-1a72-43f4-8cf1-c4fe980203a9","uuid":"84e35f5f-b801-43f5-80ff-3e8aa2f5241d","timestamp":"2026-08-12T20:31:35.388Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T202440.205845Z-fce9d2b124/repo/tests/runtime/test_plan26_repair_acceptance.py","content":"def test_a_real_compiled_graph_run_completes_a_full_d17_through_d21_repair_and_retest_loop_back_to_d16(\n    tmp_path: Path,\n) -> None:\n    \"\"\"A real `D14 -> D17 -> D18 -> D19 -> D20 -> D21 -> ... -> D16` loop, then acceptance.\n\n    Enters at `D14_INVENTORY_AND_INSPECT_UNIT_PAGES`'s own `layout_repairable`\n    guard -- a second one of the six DEFERRED_EDGES rows this test file's first\n    section proves wired -- with a deterministically-repairable `unit layout`\n    finding (module docstring above names exactly which of D13/D14/D15/M05 run\n    for real vs. are seeded). D17 classifies it, D18 plans one deterministic\n    repair child, D19 stages and produces the boundary-scoped candidate, D20\n    admits it, and D21 dispatches the real fixed retest chain\n    (`repair.RETEST_FIRST_NODE[\"unit layout\"]`) -- all through the real\n    compiled graph. D16 then runs a second time, for real, over the retested\n    evidence, and this time its denominator passes.\n    \"\"\"\n\n    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n    config = {\"configurable\": {\"thread_id\": \"repair-retest-loop\"}}\n\n    seed = _seeded_unit_id_state(pdf_sha256=\"f\" * 64, page_sha256=\"a\" * 64)\n    seed[\"pending_guard\"] = {\n        \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"layout_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [{\n                \"owner\": \"unit layout\", \"check_id\": \"unit_page_inventory\", \"pointer\": \"/template\",\n                \"message\": \"wrong template\", \"allowed_facts\": {\"/template\": \"v2\"},\n            }],\n        },\n    }\n    compiled.update_state(config, seed, as_node=\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\")\n\n    compiled.invoke(None, config=config, context=_NullRuntimeContext(), interrupt_before=[\"D13_RENDER_UNIT\"])\n    mid = compiled.get_state(config).values\n    assert repair.RETEST_FIRST_NODE[\"unit layout\"] == \"D13_RENDER_UNIT\"\n    assert mid[\"retest_results\"][-1][\"dispatched_to\"] == \"D13_RENDER_UNIT\"\n    assert mid[\"repair_requests\"][-1][\"owner\"] == \"unit layout\"\n    layout_body_repaired = next(\n        record for record in mid[\"artifact_versions\"]\n        if record[\"stream\"] == stream_id(UNIT, \"layout\") and record.get(\"version\") == 2\n    )\n    assert layout_body_repaired[\"body\"][\"template\"] == \"v2\"  # only the granted pointer changed\n\n    # D13/D14/D15/M05 are not this node's write set (module docstring above);\n    # their real return shapes are supplied directly rather than executed.\n    retest_pdf_sha256, retest_page_sha256 = \"e\" * 64, \"1\" * 64\n    compiled.update_state(\n        config,\n        {\n            \"artifact_versions\": [{\n                \"key\": \"layout-retest\", \"stream\": stream_id(UNIT, \"layout\"), \"version\": 3, \"parent_hash\": None,\n                \"hash\": \"layout-hash-retest\", \"pdf_path\": \"/dev/null\", \"pdf_sha256\": retest_pdf_sha256,\n                \"layout_path\": \"/dev/null\", \"layout_sha256\": \"l\" * 64,\n                \"parents\": {\"domain\": None, \"content\": None, \"visuals\": None},\n                \"renderer\": \"seeded-for-retest\", \"attempt\": 1,\n            }],\n            \"deterministic_checks\": [check_record(\n                scope=\"unit\", owner=UNIT, head_hash=\"layout-hash-retest\",\n                check_id=\"unit_render_receipt\", attempt=1, result=\"PASS\", detail={},\n            )],\n            \"pending_guard\": {\"node\": \"D13_RENDER_UNIT\", \"value\": \"unit_rendered\", \"detail\": {\"unit_id\": UNIT}},\n        },\n        as_node=\"D13_RENDER_UNIT\",\n    )\n    compiled.update_state(\n        config,\n        {\n            \"unit_page_inventories\": [{\n                \"key\": \"inv-retest\", \"unit_id\": UNIT, \"pdf_sha256\": retest_pdf_sha256,\n                \"page_count\": 1, \"contiguous\": True, \"result\": \"PASS\",\n            }],\n            \"unit_page_inspections\": [{\n                \"key\": \"insp-retest\", \"unit_id\": UNIT, \"pdf_sha256\": retest_pdf_sha256, \"page\": 1,\n                \"page_sha256\": retest_page_sha256, \"problems\": [], \"result\": \"PASS\",\n            }],\n            \"deterministic_checks\": [check_record(\n                scope=\"unit\", owner=UNIT, head_hash=retest_pdf_sha256,\n                check_id=\"unit_page_inventory_receipt\", attempt=1, result=\"PASS\", detail={},\n            )],\n            \"pending_guard\": {\"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"pages_inspected\", \"detail\": {\"unit_id\": UNIT}},\n        },\n        as_node=\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n    )\n    packet = worker_packet(\n        run_id=RUN, episode_id=EPISODE, correlation_key=f\"retest/{UNIT}/review\",\n        projection={\"unit_pdf_sha256\": retest_pdf_sha256},\n    )\n    compiled.update_state(\n        config,\n        {\n            \"pending_packet\": staged_dispatch(\"M05_REVIEW_ACTUAL_UNIT\", [packet]),\n            \"pending_guard\": {\"node\": \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"value\": \"review_packet_frozen\", \"detail\": {\"unit_id\": UNIT}},\n        },\n        as_node=\"D15_FREEZE_UNIT_REVIEW_PACKET\",\n    )\n\n    # D90 (attempt reservation, N22-owned, pure bookkeeping) runs for real here.\n    compiled.invoke(None, config=config, context=_NullRuntimeContext(), interrupt_before=[\"M05_REVIEW_ACTUAL_UNIT\"])\n    assert compiled.get_state(config).next == (\"M05_REVIEW_ACTUAL_UNIT\",)\n\n    compiled.update_state(\n        config,\n        {\"unit_reviews\": [{\n            \"key\": \"candidate:review-retest\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n            \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\", \"unit_pdf_sha256\": retest_pdf_sha256,\n            \"payload\": {\"overall_findings\": [], \"page_findings\": [{\"page_number\": 1, \"page_sha256\": retest_page_sha256, \"findings\": []}]},\n        }]},\n        as_node=\"M05_REVIEW_ACTUAL_UNIT\",\n    )\n\n    with pytest.raises(KeyError) as excinfo:\n        compiled.invoke(None, config=config, context=_NullRuntimeContext())\n    assert excinfo.value.args[0] == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n\n    final = compiled.get_state(config).values\n    assert final.get(\"pending_failure\") is None\n    receipt = final[\"accepted_unit_receipts\"][UNIT]\n    assert receipt[\"denominator\"][\"repair\"] == {\"result\": \"PASS\", \"open_requests\": 0}\n    assert receipt[\"denominator\"][\"pages\"][\"pdf_sha256\"] == retest_pdf_sha256\n    assert final[\"checkpoint_metadata\"][-1][\"receipt_hash\"] == receipt[\"receipt_hash\"]\n","numLines":122,"startLine":941,"totalLines":1062}}}
