{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V1xosdzYmWcYe3KpG3NJqU","type":"tool_result","content":"780\t# genuinely skipped, and named at every call site below, is the *body* of\n781\t# nodes this generation does not own (D13/D14/D15/M05/M06): their return\n782\t# values are supplied directly, in the same shape their own real functions\n783\t# produce (`nodes.check_record`/`worker_packet`/`staged_dispatch`), rather\n784\t# than executed through a fake renderer/rasterizer/model transport. D90\n785\t# (bookkeeping, N22-owned, no I/O) and every D16-D23 node this generation\n786\t# does own run for real, through the real `_boundary` wrapper, on every hop.\n787\t# ===========================================================================\n788\t\n789\t\n790\tdef test_d16_through_d23_and_m06_are_real_members_of_the_compiled_production_graph(\n791\t    tmp_path: Path,\n792\t) -> None:\n793\t    \"\"\"N90's own check, repeated here: `compiled_topology()`, not a declared table.\"\"\"\n794\t\n795\t    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n796\t    topology = G.compiled_topology(compiled)\n797\t    nodes = set(topology[\"nodes\"])\n798\t\n799\t    owned = {\n800\t        \"D16_REDUCE_UNIT_EVIDENCE\", \"D17_CLASSIFY_UNIT_FINDINGS\", \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n801\t        \"D19_ROUTE_UNIT_REPAIR\", \"D20_ADMIT_UNIT_REPAIR\", \"D21_RETEST_REQUIRED_DESCENDANTS\",\n802\t        \"D22_ACCEPT_UNIT\", \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n803\t    }\n804\t    assert owned <= nodes, sorted(owned - nodes)\n805\t\n806\t    edges = {(source, target) for source, target, _conditional in topology[\"edges\"]}\n807\t    for source, value, destination, owner in U.DEFERRED_EDGES:\n808\t        if owner != \"N31_REPAIR_ACCEPTANCE\":\n809\t            continue\n810\t        assert (source, destination) in edges, (\n811\t            f\"{source!r} --[{value}]--> {destination!r} is still not a real edge in the compiled graph\"\n812\t        )\n813\t\n814\t\n815\tdef test_binding_inventory_stays_unchanged_by_the_widened_production_compile() -> None:\n816\t    \"\"\"The docstring promise `graph.py` makes: N30's own frozen tests keep trusting this.\n817\t\n818\t    `binding_inventory()` is exactly what it was before this node -- 32 entries,\n819\t    none of them D16-D23 -- even though `build_curriculum_factory_graph` now\n820\t    compiles a wider set (`unit_repair_binding_inventory()`).\n821\t    \"\"\"\n822\t\n823\t    bindings = G.binding_inventory()\n824\t    assert len(bindings) == 32\n825\t    assert not (set(bindings) & set(acceptance.UNIT_REPAIR_NODE_BODIES))\n826\t\n827\t    wide = G.unit_repair_binding_inventory()\n828\t    assert set(wide) == set(bindings) | set(acceptance.UNIT_REPAIR_NODE_BODIES)\n829\t\n830\t\n831\tdef test_register_skeleton_accepts_the_widened_bindings_with_no_topology_error(tmp_path: Path) -> None:\n832\t    \"\"\"`validate_bindings`'s placeholder/duplicate/uncallable checks, and N30-EDGE-*,\n833\t    all pass for D16-D23 exactly as they already do for the existing skeleton --\n834\t    proven by the fact that `build_curriculum_factory_graph` (which runs both)\n835\t    raised neither `GraphBindingError` nor `unit_graph.UnitTopologyError`.\"\"\"\n836\t\n837\t    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n838\t    assert compiled.name == G.GRAPH_NAME\n839\t\n840\t\n841\tclass _NullSignalToken:\n842\t    def is_set(self) -> bool:\n843\t        return False\n844\t\n845\t\n846\tclass _NullRuntimeContext:\n847\t    \"\"\"Every node exercised below reads only `state`; none reaches a service.\"\"\"\n848\t\n849\t    signal_token = _NullSignalToken()\n850\t\n851\t\n852\tdef _seeded_unit_id_state(*, pdf_sha256: str, page_sha256: str) -> dict[str, Any]:\n853\t    domain_body_v = _domain_body()\n854\t    content_body_v = _content_body()\n855\t    visuals_body_v = _visuals_body()\n856\t    domain_hash = canonical_digest(domain_body_v)\n857\t    content_hash = canonical_digest(content_body_v)\n858\t    visuals_hash = canonical_digest(visuals_body_v)\n859\t    domain_stream = stream_id(UNIT, \"domain\")\n860\t    content_stream = stream_id(UNIT, \"content\")\n861\t    visuals_stream = stream_id(UNIT, \"visuals\")\n862\t    layout_stream = stream_id(UNIT, \"layout\")\n863\t    layout_body = {\"unit_id\": UNIT, \"template\": \"v1\", \"page_count\": 1}\n864\t    layout_hash = canonical_digest(layout_body)\n865\t\n866\t    deterministic_checks = [\n867\t        {\"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash, \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {}}\n868\t        for check_id in DOMAIN_CHECK_IDS\n869\t    ] + [\n870\t        {\"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash, \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {}}\n871\t        for check_id in CONTENT_CHECK_IDS\n872\t    ]\n873\t\n874\t    return {\n875\t        \"run_id\": RUN, \"episode_id\": EPISODE, \"selected_unit_id\": UNIT,\n876\t        \"engine_root\": str(Path(__file__).resolve().parents[2]),\n877\t        \"effective_run\": {\"target_closure\": [UNIT]},\n878\t        \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0},\n879\t        \"unit_status\": {UNIT: \"SELECTED\"},\n880\t        \"artifact_heads\": {\n881\t            domain_stream: {\"version\": 1, \"parent_hash\": None, \"hash\": domain_hash},\n882\t            content_stream: {\"version\": 1, \"parent_hash\": None, \"hash\": content_hash},\n883\t            visuals_stream: {\"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash},\n884\t        },\n885\t        \"artifact_versions\": [\n886\t            {\"key\": f\"{domain_stream}@1\", \"stream\": domain_stream, \"version\": 1, \"parent_hash\": None, \"hash\": domain_hash, \"body\": domain_body_v},\n887\t            {\"key\": f\"{content_stream}@1\", \"stream\": content_stream, \"version\": 1, \"parent_hash\": None, \"hash\": content_hash, \"body\": content_body_v},\n888\t            {\"key\": f\"{visuals_stream}@1\", \"stream\": visuals_stream, \"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash, \"body\": visuals_body_v},\n889\t            {\"key\": f\"{layout_stream}@1\", \"stream\": layout_stream, \"version\": 1, \"parent_hash\": None, \"hash\": layout_hash, \"body\": layout_body},\n890\t        ],\n891\t        \"deterministic_checks\": deterministic_checks,\n892\t        \"source_admissions\": [{\"key\": \"s1\", \"unit_id\": UNIT, \"sha256\": \"b\" * 64}],\n893\t        \"visual_join_evidence\": [{\"key\": \"vje1\", \"unit_id\": UNIT, \"phase\": \"join\", \"result\": \"PASS\"}],\n894\t        \"unit_page_inventories\": [\n895\t            {\"key\": \"inv1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page_count\": 1, \"contiguous\": True, \"result\": \"PASS\"}\n896\t        ],\n897\t        \"unit_page_inspections\": [\n898\t            {\"key\": \"insp1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page\": 1, \"page_sha256\": page_sha256, \"problems\": [], \"result\": \"PASS\"}\n899\t        ],\n900\t        \"unit_reviews\": [{\n901\t            \"key\": \"candidate:review-1\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n902\t            \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\", \"unit_pdf_sha256\": pdf_sha256,\n903\t            \"payload\": {\"overall_findings\": [], \"page_findings\": [{\"page_number\": 1, \"page_sha256\": page_sha256, \"findings\": []}]},\n904\t        }],\n905\t    }\n906\t\n907\t\n908\tdef test_a_real_compiled_graph_run_reaches_d22_accept_unit_via_the_d16_pass_fast_path(\n909\t    tmp_path: Path,\n910\t) -> None:\n911\t    \"\"\"TEST 9's compiled-graph counterpart: the D16 PASS fast path, for real.\n912\t\n913\t    Seeds the checkpoint as if M05 had just returned a clean review (the last\n914\t    thing N30's own harness proves), then really `.invoke()`s the production\n915\t    compiled graph. D16, D22, D23, and D05 all run for real; the episode ends\n916\t    on the exact next declared-deferred row (`D24`, owned by N32) rather than\n917\t    on any fabricated destination -- the identical, honest halt condition\n918\t    `test_plan26_unit_graph.py` already establishes as the correct shape of an\n919\t    incomplete-but-real run.\n920\t    \"\"\"\n921\t\n922\t    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n923\t    config = {\"configurable\": {\"thread_id\": \"pass-fast-path\"}}\n924\t\n925\t    seed = _seeded_unit_id_state(pdf_sha256=\"f\" * 64, page_sha256=\"a\" * 64)\n926\t    compiled.update_state(config, seed, as_node=\"M05_REVIEW_ACTUAL_UNIT\")\n927\t\n928\t    with pytest.raises(KeyError) as excinfo:\n929\t        compiled.invoke(None, config=config, context=_NullRuntimeContext())\n930\t    assert excinfo.value.args[0] == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n931\t    assert (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\") in U.DEFERRED_EDGES\n932\t\n933\t    final = compiled.get_state(config).values\n934\t    assert final.get(\"pending_failure\") is None\n935\t    receipt = final[\"accepted_unit_receipts\"][UNIT]\n936\t    assert receipt[\"denominator\"][\"repair\"] == {\"result\": \"PASS\", \"open_requests\": 0}\n937\t    assert final[\"checkpoint_metadata\"][-1][\"receipt_hash\"] == receipt[\"receipt_hash\"]\n938\t    assert final[\"cursor\"][\"accepted_ordinal\"] == 1\n939\t"}]},"parent_tool_use_id":null,"session_id":"b21865dd-1a72-43f4-8cf1-c4fe980203a9","uuid":"6f747a4e-60e2-4492-8bae-2d13ff0f9e6b","timestamp":"2026-08-12T20:36:18.538Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T202440.205845Z-fce9d2b124/repo/tests/runtime/test_plan26_repair_acceptance.py","content":"# genuinely skipped, and named at every call site below, is the *body* of\n# nodes this generation does not own (D13/D14/D15/M05/M06): their return\n# values are supplied directly, in the same shape their own real functions\n# produce (`nodes.check_record`/`worker_packet`/`staged_dispatch`), rather\n# than executed through a fake renderer/rasterizer/model transport. D90\n# (bookkeeping, N22-owned, no I/O) and every D16-D23 node this generation\n# does own run for real, through the real `_boundary` wrapper, on every hop.\n# ===========================================================================\n\n\ndef test_d16_through_d23_and_m06_are_real_members_of_the_compiled_production_graph(\n    tmp_path: Path,\n) -> None:\n    \"\"\"N90's own check, repeated here: `compiled_topology()`, not a declared table.\"\"\"\n\n    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n    topology = G.compiled_topology(compiled)\n    nodes = set(topology[\"nodes\"])\n\n    owned = {\n        \"D16_REDUCE_UNIT_EVIDENCE\", \"D17_CLASSIFY_UNIT_FINDINGS\", \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n        \"D19_ROUTE_UNIT_REPAIR\", \"D20_ADMIT_UNIT_REPAIR\", \"D21_RETEST_REQUIRED_DESCENDANTS\",\n        \"D22_ACCEPT_UNIT\", \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n    }\n    assert owned <= nodes, sorted(owned - nodes)\n\n    edges = {(source, target) for source, target, _conditional in topology[\"edges\"]}\n    for source, value, destination, owner in U.DEFERRED_EDGES:\n        if owner != \"N31_REPAIR_ACCEPTANCE\":\n            continue\n        assert (source, destination) in edges, (\n            f\"{source!r} --[{value}]--> {destination!r} is still not a real edge in the compiled graph\"\n        )\n\n\ndef test_binding_inventory_stays_unchanged_by_the_widened_production_compile() -> None:\n    \"\"\"The docstring promise `graph.py` makes: N30's own frozen tests keep trusting this.\n\n    `binding_inventory()` is exactly what it was before this node -- 32 entries,\n    none of them D16-D23 -- even though `build_curriculum_factory_graph` now\n    compiles a wider set (`unit_repair_binding_inventory()`).\n    \"\"\"\n\n    bindings = G.binding_inventory()\n    assert len(bindings) == 32\n    assert not (set(bindings) & set(acceptance.UNIT_REPAIR_NODE_BODIES))\n\n    wide = G.unit_repair_binding_inventory()\n    assert set(wide) == set(bindings) | set(acceptance.UNIT_REPAIR_NODE_BODIES)\n\n\ndef test_register_skeleton_accepts_the_widened_bindings_with_no_topology_error(tmp_path: Path) -> None:\n    \"\"\"`validate_bindings`'s placeholder/duplicate/uncallable checks, and N30-EDGE-*,\n    all pass for D16-D23 exactly as they already do for the existing skeleton --\n    proven by the fact that `build_curriculum_factory_graph` (which runs both)\n    raised neither `GraphBindingError` nor `unit_graph.UnitTopologyError`.\"\"\"\n\n    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n    assert compiled.name == G.GRAPH_NAME\n\n\nclass _NullSignalToken:\n    def is_set(self) -> bool:\n        return False\n\n\nclass _NullRuntimeContext:\n    \"\"\"Every node exercised below reads only `state`; none reaches a service.\"\"\"\n\n    signal_token = _NullSignalToken()\n\n\ndef _seeded_unit_id_state(*, pdf_sha256: str, page_sha256: str) -> dict[str, Any]:\n    domain_body_v = _domain_body()\n    content_body_v = _content_body()\n    visuals_body_v = _visuals_body()\n    domain_hash = canonical_digest(domain_body_v)\n    content_hash = canonical_digest(content_body_v)\n    visuals_hash = canonical_digest(visuals_body_v)\n    domain_stream = stream_id(UNIT, \"domain\")\n    content_stream = stream_id(UNIT, \"content\")\n    visuals_stream = stream_id(UNIT, \"visuals\")\n    layout_stream = stream_id(UNIT, \"layout\")\n    layout_body = {\"unit_id\": UNIT, \"template\": \"v1\", \"page_count\": 1}\n    layout_hash = canonical_digest(layout_body)\n\n    deterministic_checks = [\n        {\"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash, \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {}}\n        for check_id in DOMAIN_CHECK_IDS\n    ] + [\n        {\"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash, \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {}}\n        for check_id in CONTENT_CHECK_IDS\n    ]\n\n    return {\n        \"run_id\": RUN, \"episode_id\": EPISODE, \"selected_unit_id\": UNIT,\n        \"engine_root\": str(Path(__file__).resolve().parents[2]),\n        \"effective_run\": {\"target_closure\": [UNIT]},\n        \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0},\n        \"unit_status\": {UNIT: \"SELECTED\"},\n        \"artifact_heads\": {\n            domain_stream: {\"version\": 1, \"parent_hash\": None, \"hash\": domain_hash},\n            content_stream: {\"version\": 1, \"parent_hash\": None, \"hash\": content_hash},\n            visuals_stream: {\"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash},\n        },\n        \"artifact_versions\": [\n            {\"key\": f\"{domain_stream}@1\", \"stream\": domain_stream, \"version\": 1, \"parent_hash\": None, \"hash\": domain_hash, \"body\": domain_body_v},\n            {\"key\": f\"{content_stream}@1\", \"stream\": content_stream, \"version\": 1, \"parent_hash\": None, \"hash\": content_hash, \"body\": content_body_v},\n            {\"key\": f\"{visuals_stream}@1\", \"stream\": visuals_stream, \"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash, \"body\": visuals_body_v},\n            {\"key\": f\"{layout_stream}@1\", \"stream\": layout_stream, \"version\": 1, \"parent_hash\": None, \"hash\": layout_hash, \"body\": layout_body},\n        ],\n        \"deterministic_checks\": deterministic_checks,\n        \"source_admissions\": [{\"key\": \"s1\", \"unit_id\": UNIT, \"sha256\": \"b\" * 64}],\n        \"visual_join_evidence\": [{\"key\": \"vje1\", \"unit_id\": UNIT, \"phase\": \"join\", \"result\": \"PASS\"}],\n        \"unit_page_inventories\": [\n            {\"key\": \"inv1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page_count\": 1, \"contiguous\": True, \"result\": \"PASS\"}\n        ],\n        \"unit_page_inspections\": [\n            {\"key\": \"insp1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page\": 1, \"page_sha256\": page_sha256, \"problems\": [], \"result\": \"PASS\"}\n        ],\n        \"unit_reviews\": [{\n            \"key\": \"candidate:review-1\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n            \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\", \"unit_pdf_sha256\": pdf_sha256,\n            \"payload\": {\"overall_findings\": [], \"page_findings\": [{\"page_number\": 1, \"page_sha256\": page_sha256, \"findings\": []}]},\n        }],\n    }\n\n\ndef test_a_real_compiled_graph_run_reaches_d22_accept_unit_via_the_d16_pass_fast_path(\n    tmp_path: Path,\n) -> None:\n    \"\"\"TEST 9's compiled-graph counterpart: the D16 PASS fast path, for real.\n\n    Seeds the checkpoint as if M05 had just returned a clean review (the last\n    thing N30's own harness proves), then really `.invoke()`s the production\n    compiled graph. D16, D22, D23, and D05 all run for real; the episode ends\n    on the exact next declared-deferred row (`D24`, owned by N32) rather than\n    on any fabricated destination -- the identical, honest halt condition\n    `test_plan26_unit_graph.py` already establishes as the correct shape of an\n    incomplete-but-real run.\n    \"\"\"\n\n    compiled = G.build_curriculum_factory_graph(engine_root=Path(__file__).resolve().parents[2], output_root=tmp_path)\n    config = {\"configurable\": {\"thread_id\": \"pass-fast-path\"}}\n\n    seed = _seeded_unit_id_state(pdf_sha256=\"f\" * 64, page_sha256=\"a\" * 64)\n    compiled.update_state(config, seed, as_node=\"M05_REVIEW_ACTUAL_UNIT\")\n\n    with pytest.raises(KeyError) as excinfo:\n        compiled.invoke(None, config=config, context=_NullRuntimeContext())\n    assert excinfo.value.args[0] == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n    assert (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\") in U.DEFERRED_EDGES\n\n    final = compiled.get_state(config).values\n    assert final.get(\"pending_failure\") is None\n    receipt = final[\"accepted_unit_receipts\"][UNIT]\n    assert receipt[\"denominator\"][\"repair\"] == {\"result\": \"PASS\", \"open_requests\": 0}\n    assert final[\"checkpoint_metadata\"][-1][\"receipt_hash\"] == receipt[\"receipt_hash\"]\n    assert final[\"cursor\"][\"accepted_ordinal\"] == 1\n","numLines":160,"startLine":780,"totalLines":1062}}}
