{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DhNJxtADTAkcHnr84Jw2pN","type":"tool_result","content":"1\t\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n2\t\n3\t`compute_unit_denominator()` is the one reduction engine spec section 13.1\n4\tdescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\n5\tbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\n6\treceipt, off whatever the *current* heads are at that moment. A retest that\n7\tchanged a head between the two calls changes what this function sees; nothing\n8\there caches or trusts its own earlier answer.\n9\t\n10\tLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\n11\tyet -- registration into the compiled graph is N32's write, once `workbook.py`\n12\texists to dispatch the workbook branch alongside them.\n13\t\n14\tKnown scope of this generation's denominator (documented rather than silently\n15\tassumed): it enforces source admission, the domain and content check sets, the\n16\tvisual join, the page inventory/inspection set, one independent unit review\n17\twith all findings mapped through a code-owned owner table, and open-repair\n18\tclosure. It treats the append-only evidence/log layer and the LangGraph\n19\tcheckpoint layer as structurally present rather than independently\n20\tre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n21\t`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\n22\treducers themselves (`reducers.py`), and this generation does not yet call an\n23\texternal hash-chain audit from inside D22. A denominator category is never\n24\tremoved to make a fixture pass; a future generation only ever tightens this.\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom dataclasses import dataclass, field\n31\tfrom typing import Any\n32\t\n33\tfrom . import repair, routing\n34\tfrom .nodes import (\n35\t    SystemFailure,\n36\t    candidate_payload,\n37\t    canonical_digest,\n38\t    check_record,\n39\t    require,\n40\t    stream_id,\n41\t)\n42\tfrom .nodes.content import CONTENT_CHECK_IDS\n43\tfrom .nodes.domain import DOMAIN_CHECK_IDS\n44\t\n45\t__all__ = [\n46\t    \"DenominatorResult\",\n47\t    \"compute_unit_denominator\",\n48\t    \"prove_exact_manifest_coverage\",\n49\t    \"D16_REDUCE_UNIT_EVIDENCE\",\n50\t    \"D22_ACCEPT_UNIT\",\n51\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n52\t    \"UNIT_REPAIR_NODE_BODIES\",\n53\t    \"UNIT_REPAIR_TOPOLOGY_SOURCES\",\n54\t    \"register_unit_repair_path\",\n55\t]\n56\t\n57\t\n58\t@dataclass(frozen=True)\n59\tclass DenominatorResult:\n60\t    passed: bool\n61\t    check: dict[str, Any]\n62\t    findings: list[dict[str, Any]] = field(default_factory=list)\n63\t    denominator: dict[str, Any] = field(default_factory=dict)\n64\t\n65\t\n66\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n67\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n68\t\n69\t\n70\tdef legal_status_advance(current: Mapping[str, str] | None, unit_id: str, target: str) -> dict[str, str] | None:\n71\t    \"\"\"The `unit_status` write for `unit_id`, or `None` when `target` is not a legal hop.\n72\t\n73\t    `unit_status`'s reducer (`reducers.monotonic_status`) enforces one declared\n74\t    forward hop per write; this generation's D06/D13 producers do not yet write\n75\t    the intermediate `SOURCING`/`BUILDING` hops the reducer's own transition\n76\t    table declares (a gap in N22_DETERMINISTIC_NODES's node bodies, not in this\n77\t    module or in the reducer itself -- `deterministic_node` is its rework\n78\t    edge). Forcing `target` past an illegal hop here would either corrupt the\n79\t    one append-only status ledger with a fabricated intermediate value this\n80\t    module never actually observed, or crash the run outright; skipping the\n81\t    write and leaving the last legally-observed status in place is the one\n82\t    choice that stays honest about what this generation has actually proven.\n83\t    No control-flow decision in this codebase reads `unit_status` (`D05_SELECT_\n84\t    NEXT_UNIT` reads only `cursor`/`accepted_unit_receipts`), so a skipped\n85\t    write here changes no routing or acceptance outcome.\n86\t    \"\"\"\n87\t\n88\t    from .reducers import INITIAL_UNIT_STATUSES, UNIT_STATUS_TRANSITIONS\n89\t\n90\t    existing = (current or {}).get(unit_id)\n91\t    if existing is None:\n92\t        return {unit_id: target} if target in INITIAL_UNIT_STATUSES else None\n93\t    if target in UNIT_STATUS_TRANSITIONS.get(existing, frozenset()):\n94\t        return {unit_id: target}\n95\t    return None\n96\t\n97\t\n98\tdef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n99\t    if not pdf_sha256:\n100\t        return None\n101\t    matches = [\n102\t        dict(record)\n103\t        for record in unit_reviews or []\n104\t        if isinstance(record, Mapping)\n105\t        and record.get(\"record_kind\") == \"model_candidate\"\n106\t        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n107\t        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n108\t    ]\n109\t    return matches[-1] if matches else None\n110\t\n111\t\n112\tdef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n113\t    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n114\t\n115\t    heads = state.get(\"artifact_heads\") or {}\n116\t    checks = [\n117\t        record\n118\t        for record in state.get(\"deterministic_checks\") or []\n119\t        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n120\t    ]\n121\t    findings: list[dict[str, Any]] = []\n122\t    categories: dict[str, Any] = {}\n123\t\n124\t    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n125\t        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n126\t\n127\t    # 1-2. source admission and correlation.\n128\t    admissions = [\n129\t        record\n130\t        for record in state.get(\"source_admissions\") or []\n131\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n132\t    ]\n133\t    admissions_ok = bool(admissions) and all(\n134\t        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n135\t    )\n136\t    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n137\t    if not admissions_ok:\n138\t        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n139\t\n140\t    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n141\t    domain_stream = stream_id(unit_id, \"domain\")\n142\t    domain_head = heads.get(domain_stream)\n143\t    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n144\t    domain_checks = {\n145\t        record[\"check_id\"]: record\n146\t        for record in checks\n147\t        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n148\t    }\n149\t    domain_ok = domain_hash is not None and all(\n150\t        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n151\t    )\n152\t    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n153\t    if not domain_ok:\n154\t        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n155\t\n156\t    # 4, 6. unit schema and every sourced claim resolved.\n157\t    content_stream = stream_id(unit_id, \"content\")\n158\t    content_head = heads.get(content_stream)\n159\t    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n160\t    content_checks = {\n161\t        record[\"check_id\"]: record\n162\t        for record in checks\n163\t        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n164\t    }\n165\t    content_ok = content_hash is not None and all(\n166\t        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n167\t    )\n168\t    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n169\t    if not content_ok:\n170\t        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n171\t\n172\t    # 8. every required actual visual, provenance, and asset resolution.\n173\t    visual_join = [\n174\t        record\n175\t        for record in state.get(\"visual_join_evidence\") or []\n176\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n177\t    ]\n178\t    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n179\t    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n180\t    if not visuals_ok:\n181\t        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n182\t\n183\t    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n184\t    inventories = [\n185\t        record\n186\t        for record in state.get(\"unit_page_inventories\") or []\n187\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n188\t    ]\n189\t    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n190\t    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n191\t    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n192\t    inspections = [\n193\t        record\n194\t        for record in state.get(\"unit_page_inspections\") or []\n195\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n196\t    ]\n197\t    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n198\t    inspections_ok = (\n199\t        inventory_ok\n200\t        and len(inspections) == expected_pages\n201\t        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n202\t    )\n203\t    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n204\t    if not inspections_ok:\n205\t        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n206\t\n207\t    # 11. one independent review of the frozen actual unit, every page included.\n208\t    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n209\t    review_ok = review is not None\n210\t    if review is not None:\n211\t        payload = candidate_payload(review, \"unit review\")\n212\t        blocking = [\n213\t            entry\n214\t            for entry in payload.get(\"overall_findings\", [])\n215\t            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n216\t        ]\n217\t        for page_entry in payload.get(\"page_findings\", []):\n218\t            if isinstance(page_entry, Mapping):\n219\t                blocking.extend(\n220\t                    entry for entry in page_entry.get(\"findings\", [])\n221\t                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n222\t                )\n223\t        for entry in blocking:\n224\t            owner = repair.owner_for_review_category(entry.get(\"category\"))\n225\t            require(\n226\t                owner is not None,\n227\t                \"invalid_input\",\n228\t                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n229\t                unit_id=unit_id,\n230\t            )\n231\t            findings.append(\n232\t                {\n233\t                    \"check_id\": \"unit_review_finding\",\n234\t                    \"owner\": owner,\n235\t                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n236\t                    \"message\": entry.get(\"description\", \"\"),\n237\t                }\n238\t            )\n239\t        review_ok = not blocking\n240\t    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n241\t    if review is None:\n242\t        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n243\t\n244\t    # 12. complete repair partition, immutable history, and required current retests.\n245\t    unit_repair_requests = [\n246\t        record\n247\t        for record in state.get(\"repair_requests\") or []\n248\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n249\t    ]\n250\t    resolved_keys = {\n251\t        record.get(\"request_key\")\n252\t        for record in state.get(\"retest_results\") or []\n253\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n254\t    }\n255\t    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n256\t    repair_ok = not open_requests\n257\t    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n258\t    if not repair_ok:\n259\t        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n260\t\n261\t    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n262\t    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n263\t    check = check_record(\n264\t        scope=\"unit\",\n265\t        owner=unit_id,\n266\t        head_hash=summary_hash,\n267\t        check_id=\"unit_denominator\",\n268\t        attempt=1,\n269\t        result=\"PASS\" if passed else \"FAIL\",\n270\t        detail={\"categories\": categories},\n271\t    )\n272\t    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n273\t\n274\t\n275\tdef prove_exact_manifest_coverage(\n276\t    ordered_unit_ids: Any,\n277\t    accepted_unit_receipts: Mapping[str, Any],\n278\t    declared_coverage: Any,\n279\t) -> tuple[bool, list[str]]:\n280\t    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n281\t\n282\t    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n283\t    this function is the exact predicate it needs and is exercised directly\n284\t    here so the coverage rule itself -- exact order, exact membership, exact\n285\t    current hash -- is proven against this module's own receipt shape before\n286\t    N32 ever calls it.\n287\t    \"\"\"\n288\t\n289\t    ordered = list(ordered_unit_ids)\n290\t    declared = [dict(entry) for entry in declared_coverage]\n291\t    rejections: list[str] = []\n292\t\n293\t    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n294\t    if declared_ids != ordered:\n295\t        rejections.append(\n296\t            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n297\t        )\n298\t\n299\t    for entry in declared:\n300\t        unit_id = entry.get(\"unit_id\")\n301\t        receipt = accepted_unit_receipts.get(unit_id)\n302\t        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n303\t        if current_hash is None:\n304\t            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n305\t        elif entry.get(\"receipt_hash\") != current_hash:\n306\t            rejections.append(\n307\t                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n308\t                f\"receipt hash {current_hash!r}\"\n309\t            )\n310\t\n311\t    return (not rejections, rejections)\n312\t\n313\t\n314\t# --------------------------------------------------------------------------\n315\t# D16_REDUCE_UNIT_EVIDENCE\n316\t# --------------------------------------------------------------------------\n317\t\n318\t\n319\tdef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n320\t    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n321\t\n322\t    unit_id = state.get(\"selected_unit_id\")\n323\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n324\t    require(\n325\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n326\t        \"integrity\",\n327\t        \"an accepted unit can never re-enter denominator reduction\",\n328\t        unit_id=unit_id,\n329\t    )\n330\t\n331\t    result = compute_unit_denominator(state, unit_id)\n332\t    status_update = legal_status_advance(state.get(\"unit_status\"), unit_id, \"REVIEWING\")\n333\t    if result.passed:\n334\t        update: dict[str, Any] = {\n335\t            \"deterministic_checks\": [result.check],\n336\t            \"pending_guard\": _guard(\n337\t                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n338\t            ),\n339\t        }\n340\t        if status_update:\n341\t            update[\"unit_status\"] = status_update\n342\t        return update\n343\t    update = {\n344\t        \"deterministic_checks\": [result.check],\n345\t        \"pending_guard\": _guard(\n346\t            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n347\t            unit_id=unit_id, findings=result.findings,\n348\t        ),\n349\t    }\n350\t    if status_update:\n351\t        update[\"unit_status\"] = status_update\n352\t    return update\n353\t\n354\t\n355\t# --------------------------------------------------------------------------\n356\t# D22_ACCEPT_UNIT\n357\t# --------------------------------------------------------------------------\n358\t\n359\t\n360\tdef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n361\t    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n362\t\n363\t    Never trusts D16's earlier pass: a retest that changed a head between the\n364\t    two calls, or evidence that went stale, makes this recomputation fail even\n365\t    though D16 once passed. Any absent, stale, or failing member blocks\n366\t    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n367\t    warned acceptance path.\n368\t    \"\"\"\n369\t\n370\t    unit_id = state.get(\"selected_unit_id\")\n371\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n372\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n373\t    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n374\t\n375\t    result = compute_unit_denominator(state, unit_id)\n376\t    require(\n377\t        result.passed,\n378\t        \"integrity\",\n379\t        \"D22 recomputation does not currently pass; acceptance is refused\",\n380\t        unit_id=unit_id, categories=result.denominator,\n381\t    )\n382\t\n383\t    heads = state.get(\"artifact_heads\") or {}\n384\t    unit_stream_hashes = {\n385\t        stream: head.get(\"hash\")\n386\t        for stream, head in heads.items()\n387\t        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n388\t    }\n389\t    receipt_body = {\n390\t        \"unit_id\": unit_id,\n391\t        \"denominator\": result.denominator,\n392\t        \"artifact_head_hashes\": unit_stream_hashes,\n393\t        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n394\t    }\n395\t    receipt = dict(receipt_body)\n396\t    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n397\t\n398\t    return {\n399\t        \"accepted_unit_receipts\": {unit_id: receipt},\n400\t        \"deterministic_checks\": [result.check],\n401\t        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n402\t    }\n403\t\n404\t\n405\t# --------------------------------------------------------------------------\n406\t# D23_CHECKPOINT_ACCEPTED_UNIT\n407\t# --------------------------------------------------------------------------\n408\t\n409\t\n410\tdef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n411\t    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n412\t\n413\t    The cursor's `accepted_ordinal` is written in the same update as the\n414\t    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n415\t    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n416\t    would otherwise be satisfiable by a cursor that outran its correlation\n417\t    evidence, which is exactly the ordering spec section 6.2's D23 row and\n418\t    this node's own TEST 7 forbid.\n419\t    \"\"\"\n420\t\n421\t    unit_id = state.get(\"selected_unit_id\")\n422\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n423\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n424\t    receipt = accepted.get(unit_id)\n425\t    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n426\t\n427\t    evidence_entries = state.get(\"evidence_index_entries\") or []\n428\t    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n429\t    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n430\t\n431\t    checkpoint_record = {\n432\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n433\t        \"unit_id\": unit_id,\n434\t        \"checkpoint_id\": checkpoint_id,\n435\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n436\t        \"run_id\": state.get(\"run_id\"),\n437\t        \"episode_id\": state.get(\"episode_id\"),\n438\t        \"evidence_ordinal\": len(evidence_entries),\n439\t        \"prior_checkpoint_count\": len(existing_checkpoints),\n440\t    }\n441\t\n442\t    correlation_record = {\n443\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n444\t        \"unit_id\": unit_id,\n445\t        \"checkpoint_id\": checkpoint_id,\n446\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n447\t    }\n448\t\n449\t    effective_run = state.get(\"effective_run\") or {}\n450\t    closure = effective_run.get(\"target_closure\") or []\n451\t    cursor = dict(state.get(\"cursor\") or {})\n452\t    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n453\t    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n454\t    if unit_id not in closure:\n455\t        # Defensive: D05 always selects from the closure, so this is unreachable\n456\t        # in the real pipeline; kept explicit rather than silently trusting\n457\t        # an out-of-closure cursor advance.\n458\t        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n459\t\n460\t    return {\n461\t        \"checkpoint_metadata\": [checkpoint_record],\n462\t        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n463\t        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n464\t        \"pending_guard\": _guard(\n465\t            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n466\t            unit_id=unit_id, checkpoint_id=checkpoint_id,\n467\t        ),\n468\t    }\n469\t\n470\t\n471\t# --------------------------------------------------------------------------\n472\t# Topology registration (spec sections 8.2/12's D16-D23 sub-cycle, plus M06)\n473\t# --------------------------------------------------------------------------\n474\t#\n475\t# Additive registration over the one builder N20/N30 already populated, in the\n476\t# same convention `workbook.register_workbook_path` uses for D24-D32/M07/M08:\n477\t# no `add_node`, no `StateGraph()`, no `compile()`. Called once from `graph.py`'s\n478\t# one production compile point (`build_curriculum_factory_graph`), after\n479\t# `register_skeleton` (and therefore `unit_graph.register_unit_path`) has\n480\t# already run over the same builder with D16-D23 included in `available` --\n481\t# which is what resolves the six `unit_graph.DEFERRED_EDGES` rows this node\n482\t# owns (D08/D09/D12/D14/D91 -> D17, M05 -> D16) automatically, the same way\n483\t# widening `available` already resolves any other guard destination whose\n484\t# node body newly exists.\n485\t\n486\t\n487\tUNIT_REPAIR_NODE_BODIES: Mapping[str, Any] = {\n488\t    \"D16_REDUCE_UNIT_EVIDENCE\": D16_REDUCE_UNIT_EVIDENCE,\n489\t    \"D17_CLASSIFY_UNIT_FINDINGS\": repair.D17_CLASSIFY_UNIT_FINDINGS,\n490\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\": repair.D18_PLAN_TARGETED_UNIT_REPAIR,\n491\t    \"D19_ROUTE_UNIT_REPAIR\": repair.D19_ROUTE_UNIT_REPAIR,\n492\t    \"D20_ADMIT_UNIT_REPAIR\": repair.D20_ADMIT_UNIT_REPAIR,\n493\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": repair.D21_RETEST_REQUIRED_DESCENDANTS,\n494\t    \"D22_ACCEPT_UNIT\": D22_ACCEPT_UNIT,\n495\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\": D23_CHECKPOINT_ACCEPTED_UNIT,\n496\t}\n497\t\n498\t# M06 is included here, not in `unit_graph.UNIT_BRANCHES` (frozen, N30-owned):\n499\t# like M07/M08 in `workbook.py`, M06's own outgoing edge (its accepted result\n500\t# to D20) has nowhere else to be registered once M06 is a real graph node, so\n501\t# this module -- the one that owns D20, the destination that edge names --\n502\t# registers it, exactly the pattern `workbook.WORKBOOK_TOPOLOGY_SOURCES`\n503\t# already established for M07/M08.\n504\tUNIT_REPAIR_TOPOLOGY_SOURCES: tuple[str, ...] = (\n505\t    \"D16_REDUCE_UNIT_EVIDENCE\",\n506\t    \"D17_CLASSIFY_UNIT_FINDINGS\",\n507\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n508\t    \"D19_ROUTE_UNIT_REPAIR\",\n509\t    \"D20_ADMIT_UNIT_REPAIR\",\n510\t    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n511\t    \"D22_ACCEPT_UNIT\",\n512\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n513\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n514\t)\n515\t\n516\t\n517\tdef register_unit_repair_path(builder: Any, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n518\t    \"\"\"Add the D16-D23/M06 sub-cycle's own outgoing edges to the shared builder.\n519\t\n520\t    Called by `graph.py` after `unit_graph.register_unit_path`, over the same\n521\t    `StateGraph` -- every node this names as a source must already be\n522\t    `add_node`-registered by the caller. Returns the resolved per-source\n523\t    destination map so a caller can assert the registered topology, the way\n524\t    `unit_graph.register_unit_path`/`workbook.register_workbook_path` already\n525\t    do.\n526\t\n527\t    Two destination sets `routing.guard_destinations` cannot derive alone are\n528\t    widened in here explicitly:\n529\t\n530\t    - D21's own guard may name any fixed retest-chain entry point\n531\t      (`repair.RETEST_FIRST_NODE`) as a dynamic stored destination; the frozen\n532\t      `routing.GUARD_DESTINATIONS` table only carries the frontier-complete\n533\t      row. This is the same widening `unit_graph.py` already does for D92's\n534\t      own declared set with `RESUME_REENTRY_DESTINATIONS`.\n535\t    - M06's accepted result routes through `routing.MODEL_RESULT_DESTINATIONS`,\n536\t      a table `guard_destinations` does not consult (the same reason\n537\t      `workbook.register_workbook_path` widens M07/M08 explicitly).\n538\t    \"\"\"\n539\t\n540\t    available_set = set(available)\n541\t    for node_id in UNIT_REPAIR_TOPOLOGY_SOURCES:\n542\t        if node_id not in available_set:\n543\t            raise routing.RoutingViolation(\n544\t                f\"N31-EDGE-DANGLING:{node_id}: the unit repair/acceptance path \"\n545\t                f\"names a node with no registered body\"\n546\t            )\n547\t\n548\t    guards: dict[str, Any] = {\n549\t        \"D16_REDUCE_UNIT_EVIDENCE\": routing.route_unit_reduction,\n550\t        \"D17_CLASSIFY_UNIT_FINDINGS\": routing.route_finding_classification,\n551\t        \"D18_PLAN_TARGETED_UNIT_REPAIR\": routing.route_repair_plan,\n552\t        \"D19_ROUTE_UNIT_REPAIR\": routing.route_repair_dispatch,\n553\t        \"D20_ADMIT_UNIT_REPAIR\": routing.route_repair_admission,\n554\t        \"D21_RETEST_REQUIRED_DESCENDANTS\": routing.route_retest_frontier,\n555\t        \"D22_ACCEPT_UNIT\": routing.route_unit_acceptance,\n556\t        \"D23_CHECKPOINT_ACCEPTED_UNIT\": routing.route_accepted_checkpoint,\n557\t        \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": routing.route_m06_unit_repair,\n558\t    }\n559\t\n560\t    extra_destinations: Mapping[str, tuple[str, ...]] = {\n561\t        \"D21_RETEST_REQUIRED_DESCENDANTS\": tuple(sorted(set(repair.RETEST_FIRST_NODE.values()))),\n562\t        \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": (\n563\t            routing.MODEL_RESULT_DESTINATIONS[\"M06_REPAIR_NAMED_UNIT_ARTIFACT\"],\n564\t        ),\n565\t    }\n566\t\n567\t    resolved: dict[str, tuple[str, ...]] = {}\n568\t    for source in UNIT_REPAIR_TOPOLOGY_SOURCES:\n569\t        path = guards[source]\n570\t        declared = set(routing.guard_destinations(source)) | set(extra_destinations.get(source, ()))\n571\t        destinations = tuple(sorted(declared & available_set))\n572\t        if not destinations:\n573\t            raise routing.RoutingViolation(\n574\t                f\"N31-EDGE-EMPTY:{source}: every declared destination is deferred\"\n575\t            )\n576\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n577\t        resolved[source] = destinations\n578\t    return resolved\n579\t"}]},"parent_tool_use_id":null,"session_id":"b21865dd-1a72-43f4-8cf1-c4fe980203a9","uuid":"d5f46b5d-785c-46c7-8710-cfdb3c7b47d4","timestamp":"2026-08-12T20:26:11.415Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T202440.205845Z-fce9d2b124/repo/runtime/langgraph_factory/acceptance.py","content":"\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n\n`compute_unit_denominator()` is the one reduction engine spec section 13.1\ndescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\nbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\nreceipt, off whatever the *current* heads are at that moment. A retest that\nchanged a head between the two calls changes what this function sees; nothing\nhere caches or trusts its own earlier answer.\n\nLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\nyet -- registration into the compiled graph is N32's write, once `workbook.py`\nexists to dispatch the workbook branch alongside them.\n\nKnown scope of this generation's denominator (documented rather than silently\nassumed): it enforces source admission, the domain and content check sets, the\nvisual join, the page inventory/inspection set, one independent unit review\nwith all findings mapped through a code-owned owner table, and open-repair\nclosure. It treats the append-only evidence/log layer and the LangGraph\ncheckpoint layer as structurally present rather than independently\nre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\nreducers themselves (`reducers.py`), and this generation does not yet call an\nexternal hash-chain audit from inside D22. A denominator category is never\nremoved to make a fixture pass; a future generation only ever tightens this.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping, Sequence\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom . import repair, routing\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    check_record,\n    require,\n    stream_id,\n)\nfrom .nodes.content import CONTENT_CHECK_IDS\nfrom .nodes.domain import DOMAIN_CHECK_IDS\n\n__all__ = [\n    \"DenominatorResult\",\n    \"compute_unit_denominator\",\n    \"prove_exact_manifest_coverage\",\n    \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    \"UNIT_REPAIR_NODE_BODIES\",\n    \"UNIT_REPAIR_TOPOLOGY_SOURCES\",\n    \"register_unit_repair_path\",\n]\n\n\n@dataclass(frozen=True)\nclass DenominatorResult:\n    passed: bool\n    check: dict[str, Any]\n    findings: list[dict[str, Any]] = field(default_factory=list)\n    denominator: dict[str, Any] = field(default_factory=dict)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef legal_status_advance(current: Mapping[str, str] | None, unit_id: str, target: str) -> dict[str, str] | None:\n    \"\"\"The `unit_status` write for `unit_id`, or `None` when `target` is not a legal hop.\n\n    `unit_status`'s reducer (`reducers.monotonic_status`) enforces one declared\n    forward hop per write; this generation's D06/D13 producers do not yet write\n    the intermediate `SOURCING`/`BUILDING` hops the reducer's own transition\n    table declares (a gap in N22_DETERMINISTIC_NODES's node bodies, not in this\n    module or in the reducer itself -- `deterministic_node` is its rework\n    edge). Forcing `target` past an illegal hop here would either corrupt the\n    one append-only status ledger with a fabricated intermediate value this\n    module never actually observed, or crash the run outright; skipping the\n    write and leaving the last legally-observed status in place is the one\n    choice that stays honest about what this generation has actually proven.\n    No control-flow decision in this codebase reads `unit_status` (`D05_SELECT_\n    NEXT_UNIT` reads only `cursor`/`accepted_unit_receipts`), so a skipped\n    write here changes no routing or acceptance outcome.\n    \"\"\"\n\n    from .reducers import INITIAL_UNIT_STATUSES, UNIT_STATUS_TRANSITIONS\n\n    existing = (current or {}).get(unit_id)\n    if existing is None:\n        return {unit_id: target} if target in INITIAL_UNIT_STATUSES else None\n    if target in UNIT_STATUS_TRANSITIONS.get(existing, frozenset()):\n        return {unit_id: target}\n    return None\n\n\ndef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n    if not pdf_sha256:\n        return None\n    matches = [\n        dict(record)\n        for record in unit_reviews or []\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == \"model_candidate\"\n        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n    ]\n    return matches[-1] if matches else None\n\n\ndef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    checks = [\n        record\n        for record in state.get(\"deterministic_checks\") or []\n        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n    ]\n    findings: list[dict[str, Any]] = []\n    categories: dict[str, Any] = {}\n\n    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n\n    # 1-2. source admission and correlation.\n    admissions = [\n        record\n        for record in state.get(\"source_admissions\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    admissions_ok = bool(admissions) and all(\n        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n    )\n    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n    if not admissions_ok:\n        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n\n    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n    domain_stream = stream_id(unit_id, \"domain\")\n    domain_head = heads.get(domain_stream)\n    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n    domain_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n    }\n    domain_ok = domain_hash is not None and all(\n        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n    )\n    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n    if not domain_ok:\n        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n\n    # 4, 6. unit schema and every sourced claim resolved.\n    content_stream = stream_id(unit_id, \"content\")\n    content_head = heads.get(content_stream)\n    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n    content_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n    }\n    content_ok = content_hash is not None and all(\n        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n    )\n    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n    if not content_ok:\n        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n\n    # 8. every required actual visual, provenance, and asset resolution.\n    visual_join = [\n        record\n        for record in state.get(\"visual_join_evidence\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n    ]\n    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n    if not visuals_ok:\n        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n\n    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n    inventories = [\n        record\n        for record in state.get(\"unit_page_inventories\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n    inspections = [\n        record\n        for record in state.get(\"unit_page_inspections\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n    ]\n    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n    inspections_ok = (\n        inventory_ok\n        and len(inspections) == expected_pages\n        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n    )\n    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n    if not inspections_ok:\n        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n\n    # 11. one independent review of the frozen actual unit, every page included.\n    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n    review_ok = review is not None\n    if review is not None:\n        payload = candidate_payload(review, \"unit review\")\n        blocking = [\n            entry\n            for entry in payload.get(\"overall_findings\", [])\n            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n        ]\n        for page_entry in payload.get(\"page_findings\", []):\n            if isinstance(page_entry, Mapping):\n                blocking.extend(\n                    entry for entry in page_entry.get(\"findings\", [])\n                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n                )\n        for entry in blocking:\n            owner = repair.owner_for_review_category(entry.get(\"category\"))\n            require(\n                owner is not None,\n                \"invalid_input\",\n                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n                unit_id=unit_id,\n            )\n            findings.append(\n                {\n                    \"check_id\": \"unit_review_finding\",\n                    \"owner\": owner,\n                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n                    \"message\": entry.get(\"description\", \"\"),\n                }\n            )\n        review_ok = not blocking\n    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n    if review is None:\n        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n\n    # 12. complete repair partition, immutable history, and required current retests.\n    unit_repair_requests = [\n        record\n        for record in state.get(\"repair_requests\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    resolved_keys = {\n        record.get(\"request_key\")\n        for record in state.get(\"retest_results\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n    }\n    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n    repair_ok = not open_requests\n    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n    if not repair_ok:\n        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n\n    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n    check = check_record(\n        scope=\"unit\",\n        owner=unit_id,\n        head_hash=summary_hash,\n        check_id=\"unit_denominator\",\n        attempt=1,\n        result=\"PASS\" if passed else \"FAIL\",\n        detail={\"categories\": categories},\n    )\n    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n\n\ndef prove_exact_manifest_coverage(\n    ordered_unit_ids: Any,\n    accepted_unit_receipts: Mapping[str, Any],\n    declared_coverage: Any,\n) -> tuple[bool, list[str]]:\n    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n\n    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n    this function is the exact predicate it needs and is exercised directly\n    here so the coverage rule itself -- exact order, exact membership, exact\n    current hash -- is proven against this module's own receipt shape before\n    N32 ever calls it.\n    \"\"\"\n\n    ordered = list(ordered_unit_ids)\n    declared = [dict(entry) for entry in declared_coverage]\n    rejections: list[str] = []\n\n    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n    if declared_ids != ordered:\n        rejections.append(\n            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n        )\n\n    for entry in declared:\n        unit_id = entry.get(\"unit_id\")\n        receipt = accepted_unit_receipts.get(unit_id)\n        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n        if current_hash is None:\n            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n        elif entry.get(\"receipt_hash\") != current_hash:\n            rejections.append(\n                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n                f\"receipt hash {current_hash!r}\"\n            )\n\n    return (not rejections, rejections)\n\n\n# --------------------------------------------------------------------------\n# D16_REDUCE_UNIT_EVIDENCE\n# --------------------------------------------------------------------------\n\n\ndef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter denominator reduction\",\n        unit_id=unit_id,\n    )\n\n    result = compute_unit_denominator(state, unit_id)\n    status_update = legal_status_advance(state.get(\"unit_status\"), unit_id, \"REVIEWING\")\n    if result.passed:\n        update: dict[str, Any] = {\n            \"deterministic_checks\": [result.check],\n            \"pending_guard\": _guard(\n                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n            ),\n        }\n        if status_update:\n            update[\"unit_status\"] = status_update\n        return update\n    update = {\n        \"deterministic_checks\": [result.check],\n        \"pending_guard\": _guard(\n            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n            unit_id=unit_id, findings=result.findings,\n        ),\n    }\n    if status_update:\n        update[\"unit_status\"] = status_update\n    return update\n\n\n# --------------------------------------------------------------------------\n# D22_ACCEPT_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n\n    Never trusts D16's earlier pass: a retest that changed a head between the\n    two calls, or evidence that went stale, makes this recomputation fail even\n    though D16 once passed. Any absent, stale, or failing member blocks\n    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n    warned acceptance path.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n\n    result = compute_unit_denominator(state, unit_id)\n    require(\n        result.passed,\n        \"integrity\",\n        \"D22 recomputation does not currently pass; acceptance is refused\",\n        unit_id=unit_id, categories=result.denominator,\n    )\n\n    heads = state.get(\"artifact_heads\") or {}\n    unit_stream_hashes = {\n        stream: head.get(\"hash\")\n        for stream, head in heads.items()\n        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n    }\n    receipt_body = {\n        \"unit_id\": unit_id,\n        \"denominator\": result.denominator,\n        \"artifact_head_hashes\": unit_stream_hashes,\n        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n    }\n    receipt = dict(receipt_body)\n    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n\n    return {\n        \"accepted_unit_receipts\": {unit_id: receipt},\n        \"deterministic_checks\": [result.check],\n        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n    }\n\n\n# --------------------------------------------------------------------------\n# D23_CHECKPOINT_ACCEPTED_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n\n    The cursor's `accepted_ordinal` is written in the same update as the\n    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n    would otherwise be satisfiable by a cursor that outran its correlation\n    evidence, which is exactly the ordering spec section 6.2's D23 row and\n    this node's own TEST 7 forbid.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    receipt = accepted.get(unit_id)\n    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n\n    evidence_entries = state.get(\"evidence_index_entries\") or []\n    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n\n    checkpoint_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n        \"run_id\": state.get(\"run_id\"),\n        \"episode_id\": state.get(\"episode_id\"),\n        \"evidence_ordinal\": len(evidence_entries),\n        \"prior_checkpoint_count\": len(existing_checkpoints),\n    }\n\n    correlation_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n    }\n\n    effective_run = state.get(\"effective_run\") or {}\n    closure = effective_run.get(\"target_closure\") or []\n    cursor = dict(state.get(\"cursor\") or {})\n    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n    if unit_id not in closure:\n        # Defensive: D05 always selects from the closure, so this is unreachable\n        # in the real pipeline; kept explicit rather than silently trusting\n        # an out-of-closure cursor advance.\n        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n\n    return {\n        \"checkpoint_metadata\": [checkpoint_record],\n        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n        \"pending_guard\": _guard(\n            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n            unit_id=unit_id, checkpoint_id=checkpoint_id,\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# Topology registration (spec sections 8.2/12's D16-D23 sub-cycle, plus M06)\n# --------------------------------------------------------------------------\n#\n# Additive registration over the one builder N20/N30 already populated, in the\n# same convention `workbook.register_workbook_path` uses for D24-D32/M07/M08:\n# no `add_node`, no `StateGraph()`, no `compile()`. Called once from `graph.py`'s\n# one production compile point (`build_curriculum_factory_graph`), after\n# `register_skeleton` (and therefore `unit_graph.register_unit_path`) has\n# already run over the same builder with D16-D23 included in `available` --\n# which is what resolves the six `unit_graph.DEFERRED_EDGES` rows this node\n# owns (D08/D09/D12/D14/D91 -> D17, M05 -> D16) automatically, the same way\n# widening `available` already resolves any other guard destination whose\n# node body newly exists.\n\n\nUNIT_REPAIR_NODE_BODIES: Mapping[str, Any] = {\n    \"D16_REDUCE_UNIT_EVIDENCE\": D16_REDUCE_UNIT_EVIDENCE,\n    \"D17_CLASSIFY_UNIT_FINDINGS\": repair.D17_CLASSIFY_UNIT_FINDINGS,\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\": repair.D18_PLAN_TARGETED_UNIT_REPAIR,\n    \"D19_ROUTE_UNIT_REPAIR\": repair.D19_ROUTE_UNIT_REPAIR,\n    \"D20_ADMIT_UNIT_REPAIR\": repair.D20_ADMIT_UNIT_REPAIR,\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": repair.D21_RETEST_REQUIRED_DESCENDANTS,\n    \"D22_ACCEPT_UNIT\": D22_ACCEPT_UNIT,\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\": D23_CHECKPOINT_ACCEPTED_UNIT,\n}\n\n# M06 is included here, not in `unit_graph.UNIT_BRANCHES` (frozen, N30-owned):\n# like M07/M08 in `workbook.py`, M06's own outgoing edge (its accepted result\n# to D20) has nowhere else to be registered once M06 is a real graph node, so\n# this module -- the one that owns D20, the destination that edge names --\n# registers it, exactly the pattern `workbook.WORKBOOK_TOPOLOGY_SOURCES`\n# already established for M07/M08.\nUNIT_REPAIR_TOPOLOGY_SOURCES: tuple[str, ...] = (\n    \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"D17_CLASSIFY_UNIT_FINDINGS\",\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n    \"D19_ROUTE_UNIT_REPAIR\",\n    \"D20_ADMIT_UNIT_REPAIR\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n)\n\n\ndef register_unit_repair_path(builder: Any, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n    \"\"\"Add the D16-D23/M06 sub-cycle's own outgoing edges to the shared builder.\n\n    Called by `graph.py` after `unit_graph.register_unit_path`, over the same\n    `StateGraph` -- every node this names as a source must already be\n    `add_node`-registered by the caller. Returns the resolved per-source\n    destination map so a caller can assert the registered topology, the way\n    `unit_graph.register_unit_path`/`workbook.register_workbook_path` already\n    do.\n\n    Two destination sets `routing.guard_destinations` cannot derive alone are\n    widened in here explicitly:\n\n    - D21's own guard may name any fixed retest-chain entry point\n      (`repair.RETEST_FIRST_NODE`) as a dynamic stored destination; the frozen\n      `routing.GUARD_DESTINATIONS` table only carries the frontier-complete\n      row. This is the same widening `unit_graph.py` already does for D92's\n      own declared set with `RESUME_REENTRY_DESTINATIONS`.\n    - M06's accepted result routes through `routing.MODEL_RESULT_DESTINATIONS`,\n      a table `guard_destinations` does not consult (the same reason\n      `workbook.register_workbook_path` widens M07/M08 explicitly).\n    \"\"\"\n\n    available_set = set(available)\n    for node_id in UNIT_REPAIR_TOPOLOGY_SOURCES:\n        if node_id not in available_set:\n            raise routing.RoutingViolation(\n                f\"N31-EDGE-DANGLING:{node_id}: the unit repair/acceptance path \"\n                f\"names a node with no registered body\"\n            )\n\n    guards: dict[str, Any] = {\n        \"D16_REDUCE_UNIT_EVIDENCE\": routing.route_unit_reduction,\n        \"D17_CLASSIFY_UNIT_FINDINGS\": routing.route_finding_classification,\n        \"D18_PLAN_TARGETED_UNIT_REPAIR\": routing.route_repair_plan,\n        \"D19_ROUTE_UNIT_REPAIR\": routing.route_repair_dispatch,\n        \"D20_ADMIT_UNIT_REPAIR\": routing.route_repair_admission,\n        \"D21_RETEST_REQUIRED_DESCENDANTS\": routing.route_retest_frontier,\n        \"D22_ACCEPT_UNIT\": routing.route_unit_acceptance,\n        \"D23_CHECKPOINT_ACCEPTED_UNIT\": routing.route_accepted_checkpoint,\n        \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": routing.route_m06_unit_repair,\n    }\n\n    extra_destinations: Mapping[str, tuple[str, ...]] = {\n        \"D21_RETEST_REQUIRED_DESCENDANTS\": tuple(sorted(set(repair.RETEST_FIRST_NODE.values()))),\n        \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": (\n            routing.MODEL_RESULT_DESTINATIONS[\"M06_REPAIR_NAMED_UNIT_ARTIFACT\"],\n        ),\n    }\n\n    resolved: dict[str, tuple[str, ...]] = {}\n    for source in UNIT_REPAIR_TOPOLOGY_SOURCES:\n        path = guards[source]\n        declared = set(routing.guard_destinations(source)) | set(extra_destinations.get(source, ()))\n        destinations = tuple(sorted(declared & available_set))\n        if not destinations:\n            raise routing.RoutingViolation(\n                f\"N31-EDGE-EMPTY:{source}: every declared destination is deferred\"\n            )\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n        resolved[source] = destinations\n    return resolved\n","numLines":579,"startLine":1,"totalLines":579}}}
