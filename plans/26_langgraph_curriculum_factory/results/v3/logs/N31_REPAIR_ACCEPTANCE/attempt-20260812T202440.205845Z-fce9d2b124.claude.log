{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RKXu7cBR8mW4kuUAymB1Js","type":"tool_result","content":"1\t\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n2\t\n3\tThis module owns registration, not node bodies. Every callable it registers is\n4\tresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\n5\tthat is missing, placeholder, test-only, duplicated, or dangling fails the build\n6\tby stable ID rather than compiling into a graph that would look complete.\n7\t\n8\tIt also owns the two things no node body can own:\n9\t\n10\t- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n11\t  records a graceful interrupt observed at the node's atomic boundary, and turns\n12\t  an unexpected exception into a classified `pending_failure` instead of letting\n13\t  an unproven state continue;\n14\t- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n15\t  guard, evidence writer, transport registry, source retriever, signal token and\n16\t  clock, and holds no model client and no routing authority.\n17\t\n18\tScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\n19\tpath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n20\t`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\n21\tmap/reduce, and the workbook branch are registered by N30 and N32 into this same\n22\tbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\n23\tbut not yet wired, so an undeclared unwired node still fails compilation.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport inspect\n30\timport json\n31\timport re\n32\tfrom collections.abc import Callable, Mapping, Sequence\n33\tfrom datetime import datetime, timezone\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom langgraph.errors import GraphBubbleUp\n38\tfrom langgraph.graph import END, START, StateGraph\n39\tfrom langgraph.graph.state import CompiledStateGraph\n40\tfrom langgraph.runtime import Runtime\n41\t\n42\tfrom . import acceptance, routing, transport as tp, unit_graph, workbook\n43\tfrom .artifacts import ArtifactStore\n44\tfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\n45\tfrom .evidence import EvidenceStore\n46\tfrom .model_nodes import (\n47\t    MODEL_BOOKKEEPING_NODES,\n48\t    MODEL_NODE_ADAPTERS,\n49\t    build_model_node_context,\n50\t)\n51\tfrom .nodes import NODE_CATALOGUE, node_registry\n52\tfrom .persistence import InterruptToken, open_checkpoint_saver\n53\tfrom .state import (\n54\t    FACTORY_INPUT_FIELDS,\n55\t    FACTORY_OUTPUT_FIELDS,\n56\t    FACTORY_STATE_FIELDS,\n57\t    FIELD_REDUCER_CLASSES,\n58\t    FactoryInput,\n59\t    FactoryOutput,\n60\t    FactoryState,\n61\t    RuntimeContext,\n62\t)\n63\t\n64\t__all__ = [\n65\t    \"GRAPH_NAME\",\n66\t    \"GraphBindingError\",\n67\t    \"DEFERRED_TOPOLOGY\",\n68\t    \"SKELETON_NORMAL_EDGES\",\n69\t    \"SKELETON_BRANCHES\",\n70\t    \"build_runtime_context\",\n71\t    \"binding_inventory\",\n72\t    \"full_binding_inventory\",\n73\t    \"unit_repair_binding_inventory\",\n74\t    \"validate_bindings\",\n75\t    \"register_skeleton\",\n76\t    \"build_curriculum_factory_graph\",\n77\t    \"compiled_topology\",\n78\t    \"graph_digest\",\n79\t    \"contract_digests\",\n80\t]\n81\t\n82\tGRAPH_NAME = \"plan26_curriculum_factory\"\n83\t\n84\t\n85\tclass GraphBindingError(RuntimeError):\n86\t    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n87\t\n88\t\n89\t# Only these modules may supply a production node body. A callable from anywhere\n90\t# else — a test module, a notebook, a locally defined lambda — is rejected by\n91\t# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n92\t# a stand-in\".\n93\tPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n94\t    \"runtime.langgraph_factory.nodes\",\n95\t    \"runtime.langgraph_factory.model_nodes\",\n96\t    \"runtime.langgraph_factory.workbook\",\n97\t    \"runtime.langgraph_factory.repair\",\n98\t    \"runtime.langgraph_factory.acceptance\",\n99\t)\n100\t\n101\tPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n102\t    \"stub\",\n103\t    \"placeholder\",\n104\t    \"fake\",\n105\t    \"dummy\",\n106\t    \"mock\",\n107\t    \"sample\",\n108\t    \"example\",\n109\t    \"todo\",\n110\t    \"noop\",\n111\t    \"test\",\n112\t)\n113\t\n114\tPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n115\t    \"raise NotImplementedError\",\n116\t    \"TODO: implement\",\n117\t    \"placeholder implementation\",\n118\t)\n119\t\n120\t# Registered here, wired by a later graph node. A node that is neither wired by\n121\t# the skeleton nor declared here fails the build: silence about an unwired node\n122\t# is how a topology gap becomes a silent halt at runtime.\n123\t#\n124\t# D16-D23 and M06 are wired by this same node (`N31_REPAIR_ACCEPTANCE`), not by\n125\t# `register_skeleton`/`unit_graph.register_unit_path` themselves: D16 and D17\n126\t# already land in `_validate_topology`'s own `wired` set as declared\n127\t# destinations of D08/D09/D12/D14/D91/M05 (once they are in `available` at\n128\t# all), but D18-D23 and M06's own outgoing edges have no such existing entry\n129\t# point -- `acceptance.register_unit_repair_path` adds them, additively, right\n130\t# after `register_skeleton` returns (see `build_curriculum_factory_graph`).\n131\t# Listing all eight here regardless keeps the declaration uniform and true for\n132\t# every node this sub-cycle owns, not just the ones that would otherwise fail.\n133\tDEFERRED_TOPOLOGY: Mapping[str, str] = {\n134\t    \"D16_REDUCE_UNIT_EVIDENCE\": \"N31_REPAIR_ACCEPTANCE\",\n135\t    \"D17_CLASSIFY_UNIT_FINDINGS\": \"N31_REPAIR_ACCEPTANCE\",\n136\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n137\t    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n138\t    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n139\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n140\t    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n141\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n142\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n143\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n144\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n145\t}\n146\t\n147\tSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n148\t    (START, \"D00_BOOTSTRAP_EPISODE\"),\n149\t    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n150\t    (\"D98_WRITE_TERMINAL\", END),\n151\t)\n152\t\n153\tSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n154\t    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n155\t    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n156\t    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n157\t    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n158\t    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n159\t    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n160\t)\n161\t\n162\t\n163\t# --------------------------------------------------------------- runtime context\n164\t\n165\t\n166\tdef _utc_clock() -> str:\n167\t    return datetime.now(timezone.utc).isoformat()\n168\t\n169\t\n170\tdef build_runtime_context(\n171\t    *,\n172\t    engine_root: Path | str,\n173\t    output_root: Path | str,\n174\t    run_id: str,\n175\t    curriculum_digest: str,\n176\t    authorization: Any = None,\n177\t    capability_proof: Mapping[str, Any] | None = None,\n178\t    retrieval_hosts: Sequence[str] = (),\n179\t    clock: Callable[[], Any] = _utc_clock,\n180\t    env_passthrough: Sequence[str] = (),\n181\t) -> RuntimeContext:\n182\t    \"\"\"Open the services one invocation may reach (spec section 5.2).\n183\t\n184\t    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n185\t    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n186\t    inside the builder, because the transport and the authorization it enforces\n187\t    are bound to a run identity that does not exist at build time.\n188\t    \"\"\"\n189\t\n190\t    engine_root = Path(engine_root).resolve()\n191\t    output_root = Path(output_root).resolve()\n192\t    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n193\t    egress_guard = EgressGuard(receipts)\n194\t    return RuntimeContext(\n195\t        engine_root=engine_root,\n196\t        output_root=output_root,\n197\t        path_guard=ArtifactStore(output_root),\n198\t        evidence_service=EvidenceStore(output_root),\n199\t        transport_registry=tp.CliTransport(\n200\t            output_root=output_root,\n201\t            run_id=run_id,\n202\t            curriculum_digest=curriculum_digest,\n203\t            authorization=authorization,\n204\t            receipts=receipts,\n205\t            guard=egress_guard,\n206\t            ledger=tp.AttemptLedger(),\n207\t            capability_proof=capability_proof,\n208\t            env_passthrough=env_passthrough,\n209\t        ),\n210\t        source_retriever=SourceRetriever(\n211\t            guard=egress_guard,\n212\t            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n213\t        ),\n214\t        signal_token=InterruptToken(output_root),\n215\t        clock=clock,\n216\t    )\n217\t\n218\t\n219\t# ----------------------------------------------------------------- node boundary\n220\t\n221\t\n222\tdef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n223\t    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n224\t\n225\t    marked = dict(update)\n226\t    guard = marked.get(\"pending_guard\")\n227\t    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n228\t    guard[\"interrupt_requested\"] = True\n229\t    marked[\"pending_guard\"] = guard\n230\t    return marked\n231\t\n232\t\n233\tdef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n234\t    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n235\t\n236\t    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n237\t    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n238\t    callables take it as an explicit argument precisely so they cannot fetch it\n239\t    themselves.\n240\t    \"\"\"\n241\t\n242\t    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n243\t        context = getattr(runtime, \"context\", None)\n244\t        try:\n245\t            if model_node:\n246\t                update = body(state, build_model_node_context(context))\n247\t            else:\n248\t                update = body(state, context)\n249\t        except GraphBubbleUp:\n250\t            # LangGraph's own control flow (interrupt/resume propagation) is not a\n251\t            # product failure and must reach the engine untouched.\n252\t            raise\n253\t        except Exception as error:  # the classified-failure contract of spec 6.1\n254\t            return {\n255\t                \"pending_failure\": {\n256\t                    \"node\": node_id,\n257\t                    \"class\": \"system\",\n258\t                    \"cause\": \"unhandled\",\n259\t                    \"message\": f\"{type(error).__name__}: {error}\",\n260\t                    \"evidence\": {\"boundary\": \"node\"},\n261\t                },\n262\t                \"pending_guard\": None,\n263\t            }\n264\t        token = getattr(context, \"signal_token\", None)\n265\t        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n266\t            return _mark_interrupt(update, node_id)\n267\t        return dict(update)\n268\t\n269\t    node.__name__ = node_id\n270\t    node.__qualname__ = node_id\n271\t    node.__doc__ = getattr(body, \"__doc__\", None)\n272\t    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n273\t    return node\n274\t\n275\t\n276\tdef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n277\t    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n278\t\n279\t    return getattr(body, \"node_body\", body)\n280\t\n281\t\n282\tdef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n283\t    target = _underlying(body)\n284\t    try:\n285\t        source = inspect.getsource(target)\n286\t    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n287\t        source = \"\"\n288\t    return {\n289\t        \"node_id\": node_id,\n290\t        \"module\": getattr(target, \"__module__\", \"\"),\n291\t        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n292\t        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n293\t        \"source_lines\": len(source.splitlines()),\n294\t    }\n295\t\n296\t\n297\t# ------------------------------------------------------------ binding validation\n298\t\n299\t\n300\tdef binding_inventory() -> dict[str, Callable[..., Any]]:\n301\t    \"\"\"Every node callable the *skeleton and unit path* resolve against.\n302\t\n303\t    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n304\t    are absent here: they are exercised at the function level by N31's own\n305\t    tests, and this generation does not wire their topology (spec section\n306\t    8.1's D08/D09/D12/D14/D91 -> D17 and M05 -> D16 edges stay the declared\n307\t    `unit_graph.DEFERRED_EDGES` rows they already are).\n308\t\n309\t    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n310\t    likewise absent from *this* function deliberately, not by oversight: D24\n311\t    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n312\t    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n313\t    already-verified tables) declare that edge deferred to N32 by name. If D24\n314\t    entered this function, `unit_graph.register_unit_path`'s *own*\n315\t    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n316\t    silently widen to include it -- correct for a production run, but it\n317\t    would falsify N30's own already-passing topology tests, which independently\n318\t    recompute their expectation from this exact function's return value.\n319\t    `register_workbook_topology` registers the workbook engine as an additive\n320\t    step over its own separate builder (N32 exercises it directly, not through\n321\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n322\t    byte-identical to what they were before N32 and the workbook branch is\n323\t    still fully real -- just not reachable from `D05` in this generation,\n324\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n325\t    \"\"\"\n326\t\n327\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n328\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n329\t        bindings[job_id] = adapter\n330\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n331\t    return bindings\n332\t\n333\t\n334\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n335\t    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n336\t\n337\t    The complete node set the compiled graph actually registers. Kept\n338\t    separate from `binding_inventory()` itself for the reason documented\n339\t    there: several of N30's own tests recompute their expectation directly\n340\t    from `binding_inventory()`'s return value, so that function's contract\n341\t    (the skeleton/unit-path view) must stay exactly what it was before N32.\n342\t    \"\"\"\n343\t\n344\t    bindings = dict(binding_inventory())\n345\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n346\t    return bindings\n347\t\n348\t\n349\tdef unit_repair_binding_inventory() -> dict[str, Callable[..., Any]]:\n350\t    \"\"\"`binding_inventory()` plus N31's unit repair/acceptance cycle (D16-D23).\n351\t\n352\t    Kept separate from `binding_inventory()` itself for the same reason\n353\t    `full_binding_inventory()` is kept separate from it: several of N30's own\n354\t    tests recompute their expectation directly from `binding_inventory()`'s\n355\t    return value, so that function's contract must stay exactly what it was\n356\t    before this node. This is the set `build_curriculum_factory_graph` passes\n357\t    to `register_skeleton` -- D16-D23 joining `available` there is what\n358\t    resolves the six `unit_graph.DEFERRED_EDGES` rows this node owns.\n359\t    \"\"\"\n360\t\n361\t    bindings = dict(binding_inventory())\n362\t    bindings.update(acceptance.UNIT_REPAIR_NODE_BODIES)\n363\t    return bindings\n364\t\n365\t\n366\tdef _reject(code: str, node_id: str, detail: str) -> None:\n367\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n368\t\n369\t\n370\tdef validate_bindings(\n371\t    bindings: Mapping[str, Callable[..., Any]],\n372\t    *,\n373\t    required: Sequence[str],\n374\t) -> dict[str, dict[str, Any]]:\n375\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n376\t\n377\t    for node_id in required:\n378\t        if node_id not in bindings:\n379\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n380\t\n381\t    seen: dict[tuple[str, str], str] = {}\n382\t    inventory: dict[str, dict[str, Any]] = {}\n383\t    for node_id in sorted(bindings):\n384\t        body = bindings[node_id]\n385\t        if not callable(body):\n386\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n387\t        record = _binding_record(node_id, body)\n388\t        module = record[\"module\"]\n389\t        if not any(\n390\t            module == allowed or module.startswith(f\"{allowed}.\")\n391\t            for allowed in PRODUCTION_BINDING_MODULES\n392\t        ):\n393\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n394\t        lowered = f\"{module}.{record['qualname']}\".lower()\n395\t        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n396\t        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n397\t        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n398\t        # positive on the spec's own vocabulary, not a caught stand-in.\n399\t        marker = next(\n400\t            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n401\t            None,\n402\t        )\n403\t        if marker is not None:\n404\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n405\t        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n406\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n407\t        source = inspect.getsource(_underlying(body))\n408\t        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n409\t        if marker is not None:\n410\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n411\t        identity = (module, record[\"qualname\"])\n412\t        if identity in seen:\n413\t            _reject(\n414\t                \"N20-BIND-DUPLICATE\",\n415\t                node_id,\n416\t                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n417\t            )\n418\t        seen[identity] = node_id\n419\t        inventory[node_id] = record\n420\t    return inventory\n421\t\n422\t\n423\tdef _validate_topology(registered: Sequence[str]) -> None:\n424\t    known = set(registered) | {START, END}\n425\t    wired: set[str] = set()\n426\t    for source, target in SKELETON_NORMAL_EDGES:\n427\t        for endpoint in (source, target):\n428\t            if endpoint not in known:\n429\t                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n430\t        wired.update({source, target})\n431\t    for source, path in SKELETON_BRANCHES:\n432\t        if source not in known:\n433\t            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n434\t        wired.add(source)\n435\t        for target in routing.guard_destinations(source):\n436\t            if target not in known:\n437\t                _reject(\n438\t                    \"N20-EDGE-DANGLING\",\n439\t                    target,\n440\t                    f\"{source} branch {path.__name__} names an unregistered destination\",\n441\t                )\n442\t            wired.add(target)\n443\t    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n444\t        wired.update({source, target})\n445\t    for source, _ in unit_graph.UNIT_BRANCHES:\n446\t        wired.add(source)\n447\t        wired.update(unit_graph.branch_destinations(source, registered))\n448\t    for node_id in registered:\n449\t        if node_id in wired:\n450\t            continue\n451\t        owner = DEFERRED_TOPOLOGY.get(node_id)\n452\t        if owner is None:\n453\t            _reject(\n454\t                \"N20-NODE-UNDECLARED\",\n455\t                node_id,\n456\t                \"is registered but neither wired by the skeleton nor declared deferred\",\n457\t            )\n458\t\n459\t\n460\t# ---------------------------------------------------------------- registration\n461\t\n462\t\n463\tdef register_skeleton(\n464\t    builder: StateGraph,\n465\t    bindings: Mapping[str, Callable[..., Any]],\n466\t) -> dict[str, dict[str, Any]]:\n467\t    \"\"\"Register every available node and the fixed skeleton edges.\n468\t\n469\t    N30 and N32 extend the same builder by adding their own `add_node`-free\n470\t    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n471\t    rewritten by them, so the skeleton stays the one place START, the recovery\n472\t    branch, and the single edge to END are decided.\n473\t    \"\"\"\n474\t\n475\t    routing.assert_guard_table_total(NODE_CATALOGUE)\n476\t    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n477\t    _validate_topology(sorted(bindings))\n478\t\n479\t    for node_id in sorted(bindings):\n480\t        model_node = node_id in MODEL_NODE_ADAPTERS\n481\t        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n482\t\n483\t    for source, target in SKELETON_NORMAL_EDGES:\n484\t        builder.add_edge(source, target)\n485\t\n486\t    for source, path in SKELETON_BRANCHES:\n487\t        destinations = routing.guard_destinations(source)\n488\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n489\t\n490\t    unit_graph.register_unit_path(builder, sorted(bindings))\n491\t\n492\t    return inventory\n493\t\n494\t\n495\tdef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n496\t    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n497\t\n498\t    Not called by `build_curriculum_factory_graph`: this generation's single\n499\t    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n500\t    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n501\t    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n502\t    this function into whatever the production compile point becomes once the\n503\t    workbook branch is in scope; until then it is exercised directly, over its\n504\t    own builder, the way N32's own topology test already does.\n505\t    `register_skeleton` itself must never see these bindings; this function\n506\t    adds exactly the nodes `register_skeleton` did not, then wires them over\n507\t    the *full* merged node set so `workbook.register_workbook_path` can\n508\t    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n509\t    \"\"\"\n510\t\n511\t    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n512\t    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n513\t    for node_id in sorted(workbook_bindings):\n514\t        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n515\t    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n516\t\n517\t\n518\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n519\t    required = {source for source, _ in SKELETON_BRANCHES}\n520\t    for source, target in SKELETON_NORMAL_EDGES:\n521\t        required.update({source, target})\n522\t    for source, _ in SKELETON_BRANCHES:\n523\t        required.update(routing.guard_destinations(source))\n524\t    return tuple(sorted(required - {START, END}))\n525\t\n526\t\n527\tdef build_curriculum_factory_graph(\n528\t    *, engine_root: Path, output_root: Path\n529\t) -> CompiledStateGraph:\n530\t    \"\"\"Build and compile the one production graph (spec section 4).\n531\t\n532\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n533\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n534\t    services are captured at build time, so the compiled object carries no\n535\t    run identity and no authorization.\n536\t    \"\"\"\n537\t\n538\t    engine_root = Path(engine_root).resolve()\n539\t    output_root = Path(output_root).resolve()\n540\t    builder: StateGraph = StateGraph(\n541\t        FactoryState,\n542\t        context_schema=RuntimeContext,\n543\t        input_schema=FactoryInput,\n544\t        output_schema=FactoryOutput,\n545\t    )\n546\t    bindings = unit_repair_binding_inventory()\n547\t    register_skeleton(builder, bindings)\n548\t    acceptance.register_unit_repair_path(builder, sorted(bindings))\n549\t    saver, _connection = open_checkpoint_saver(output_root)\n550\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n551\t\n552\t\n553\t# ---------------------------------------------------------------------- digest\n554\t\n555\t\n556\tdef _canonical_digest(payload: Any) -> str:\n557\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n558\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n559\t\n560\t\n561\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n562\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n563\t\n564\t    drawn = compiled.get_graph()\n565\t    return {\n566\t        \"name\": compiled.name,\n567\t        \"nodes\": sorted(drawn.nodes),\n568\t        \"edges\": sorted(\n569\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n570\t        ),\n571\t    }\n572\t\n573\t\n574\tdef contract_digests() -> dict[str, str]:\n575\t    \"\"\"File digests of every frozen model prompt and output schema.\n576\t\n577\t    Folded into the graph digest so prompt or schema drift is visible as graph\n578\t    drift: the same topology over a changed prompt is not the same graph.\n579\t    \"\"\"\n580\t\n581\t    digests: dict[str, str] = {}\n582\t    registry = tp.load_job_registry()\n583\t    for job_id in sorted(registry):\n584\t        route = registry[job_id]\n585\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n586\t            path = Path(path)\n587\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n588\t    return digests\n589\t\n590\t\n591\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n592\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n593\t\n594\t    Identical real bindings give an identical digest; a changed node body,\n595\t    reducer declaration, prompt, or schema changes it. Python object identity is\n596\t    deliberately not an input, so two builds in one process and two builds in two\n597\t    processes agree.\n598\t    \"\"\"\n599\t\n600\t    payload = {\n601\t        \"topology\": compiled_topology(compiled),\n602\t        \"bindings\": [\n603\t            _binding_record(node_id, body)\n604\t            for node_id, body in sorted(binding_inventory().items())\n605\t        ],\n606\t        \"state\": {\n607\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n608\t            \"input\": list(FACTORY_INPUT_FIELDS),\n609\t            \"output\": list(FACTORY_OUTPUT_FIELDS),\n610\t        },\n611\t        \"contracts\": contract_digests(),\n612\t    }\n613\t    return _canonical_digest(payload)\n614\t"}]},"parent_tool_use_id":null,"session_id":"b21865dd-1a72-43f4-8cf1-c4fe980203a9","uuid":"0177d247-c706-4dc2-beb6-a8cb30c9c955","timestamp":"2026-08-12T20:24:49.162Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T202440.205845Z-fce9d2b124/repo/runtime/langgraph_factory/graph.py","content":"\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n\nThis module owns registration, not node bodies. Every callable it registers is\nresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\nthat is missing, placeholder, test-only, duplicated, or dangling fails the build\nby stable ID rather than compiling into a graph that would look complete.\n\nIt also owns the two things no node body can own:\n\n- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n  records a graceful interrupt observed at the node's atomic boundary, and turns\n  an unexpected exception into a classified `pending_failure` instead of letting\n  an unproven state continue;\n- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n  guard, evidence writer, transport registry, source retriever, signal token and\n  clock, and holds no model client and no routing authority.\n\nScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\npath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\nmap/reduce, and the workbook branch are registered by N30 and N32 into this same\nbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\nbut not yet wired, so an undeclared unwired node still fails compilation.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport inspect\nimport json\nimport re\nfrom collections.abc import Callable, Mapping, Sequence\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom langgraph.errors import GraphBubbleUp\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.graph.state import CompiledStateGraph\nfrom langgraph.runtime import Runtime\n\nfrom . import acceptance, routing, transport as tp, unit_graph, workbook\nfrom .artifacts import ArtifactStore\nfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\nfrom .evidence import EvidenceStore\nfrom .model_nodes import (\n    MODEL_BOOKKEEPING_NODES,\n    MODEL_NODE_ADAPTERS,\n    build_model_node_context,\n)\nfrom .nodes import NODE_CATALOGUE, node_registry\nfrom .persistence import InterruptToken, open_checkpoint_saver\nfrom .state import (\n    FACTORY_INPUT_FIELDS,\n    FACTORY_OUTPUT_FIELDS,\n    FACTORY_STATE_FIELDS,\n    FIELD_REDUCER_CLASSES,\n    FactoryInput,\n    FactoryOutput,\n    FactoryState,\n    RuntimeContext,\n)\n\n__all__ = [\n    \"GRAPH_NAME\",\n    \"GraphBindingError\",\n    \"DEFERRED_TOPOLOGY\",\n    \"SKELETON_NORMAL_EDGES\",\n    \"SKELETON_BRANCHES\",\n    \"build_runtime_context\",\n    \"binding_inventory\",\n    \"full_binding_inventory\",\n    \"unit_repair_binding_inventory\",\n    \"validate_bindings\",\n    \"register_skeleton\",\n    \"build_curriculum_factory_graph\",\n    \"compiled_topology\",\n    \"graph_digest\",\n    \"contract_digests\",\n]\n\nGRAPH_NAME = \"plan26_curriculum_factory\"\n\n\nclass GraphBindingError(RuntimeError):\n    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n\n\n# Only these modules may supply a production node body. A callable from anywhere\n# else — a test module, a notebook, a locally defined lambda — is rejected by\n# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n# a stand-in\".\nPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n    \"runtime.langgraph_factory.nodes\",\n    \"runtime.langgraph_factory.model_nodes\",\n    \"runtime.langgraph_factory.workbook\",\n    \"runtime.langgraph_factory.repair\",\n    \"runtime.langgraph_factory.acceptance\",\n)\n\nPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n    \"stub\",\n    \"placeholder\",\n    \"fake\",\n    \"dummy\",\n    \"mock\",\n    \"sample\",\n    \"example\",\n    \"todo\",\n    \"noop\",\n    \"test\",\n)\n\nPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n    \"raise NotImplementedError\",\n    \"TODO: implement\",\n    \"placeholder implementation\",\n)\n\n# Registered here, wired by a later graph node. A node that is neither wired by\n# the skeleton nor declared here fails the build: silence about an unwired node\n# is how a topology gap becomes a silent halt at runtime.\n#\n# D16-D23 and M06 are wired by this same node (`N31_REPAIR_ACCEPTANCE`), not by\n# `register_skeleton`/`unit_graph.register_unit_path` themselves: D16 and D17\n# already land in `_validate_topology`'s own `wired` set as declared\n# destinations of D08/D09/D12/D14/D91/M05 (once they are in `available` at\n# all), but D18-D23 and M06's own outgoing edges have no such existing entry\n# point -- `acceptance.register_unit_repair_path` adds them, additively, right\n# after `register_skeleton` returns (see `build_curriculum_factory_graph`).\n# Listing all eight here regardless keeps the declaration uniform and true for\n# every node this sub-cycle owns, not just the ones that would otherwise fail.\nDEFERRED_TOPOLOGY: Mapping[str, str] = {\n    \"D16_REDUCE_UNIT_EVIDENCE\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D17_CLASSIFY_UNIT_FINDINGS\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n}\n\nSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n    (START, \"D00_BOOTSTRAP_EPISODE\"),\n    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n    (\"D98_WRITE_TERMINAL\", END),\n)\n\nSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n)\n\n\n# --------------------------------------------------------------- runtime context\n\n\ndef _utc_clock() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef build_runtime_context(\n    *,\n    engine_root: Path | str,\n    output_root: Path | str,\n    run_id: str,\n    curriculum_digest: str,\n    authorization: Any = None,\n    capability_proof: Mapping[str, Any] | None = None,\n    retrieval_hosts: Sequence[str] = (),\n    clock: Callable[[], Any] = _utc_clock,\n    env_passthrough: Sequence[str] = (),\n) -> RuntimeContext:\n    \"\"\"Open the services one invocation may reach (spec section 5.2).\n\n    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n    inside the builder, because the transport and the authorization it enforces\n    are bound to a run identity that does not exist at build time.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n    egress_guard = EgressGuard(receipts)\n    return RuntimeContext(\n        engine_root=engine_root,\n        output_root=output_root,\n        path_guard=ArtifactStore(output_root),\n        evidence_service=EvidenceStore(output_root),\n        transport_registry=tp.CliTransport(\n            output_root=output_root,\n            run_id=run_id,\n            curriculum_digest=curriculum_digest,\n            authorization=authorization,\n            receipts=receipts,\n            guard=egress_guard,\n            ledger=tp.AttemptLedger(),\n            capability_proof=capability_proof,\n            env_passthrough=env_passthrough,\n        ),\n        source_retriever=SourceRetriever(\n            guard=egress_guard,\n            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n        ),\n        signal_token=InterruptToken(output_root),\n        clock=clock,\n    )\n\n\n# ----------------------------------------------------------------- node boundary\n\n\ndef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n\n    marked = dict(update)\n    guard = marked.get(\"pending_guard\")\n    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n    guard[\"interrupt_requested\"] = True\n    marked[\"pending_guard\"] = guard\n    return marked\n\n\ndef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n\n    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n    callables take it as an explicit argument precisely so they cannot fetch it\n    themselves.\n    \"\"\"\n\n    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n        context = getattr(runtime, \"context\", None)\n        try:\n            if model_node:\n                update = body(state, build_model_node_context(context))\n            else:\n                update = body(state, context)\n        except GraphBubbleUp:\n            # LangGraph's own control flow (interrupt/resume propagation) is not a\n            # product failure and must reach the engine untouched.\n            raise\n        except Exception as error:  # the classified-failure contract of spec 6.1\n            return {\n                \"pending_failure\": {\n                    \"node\": node_id,\n                    \"class\": \"system\",\n                    \"cause\": \"unhandled\",\n                    \"message\": f\"{type(error).__name__}: {error}\",\n                    \"evidence\": {\"boundary\": \"node\"},\n                },\n                \"pending_guard\": None,\n            }\n        token = getattr(context, \"signal_token\", None)\n        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n            return _mark_interrupt(update, node_id)\n        return dict(update)\n\n    node.__name__ = node_id\n    node.__qualname__ = node_id\n    node.__doc__ = getattr(body, \"__doc__\", None)\n    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n    return node\n\n\ndef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n\n    return getattr(body, \"node_body\", body)\n\n\ndef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n    target = _underlying(body)\n    try:\n        source = inspect.getsource(target)\n    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n        source = \"\"\n    return {\n        \"node_id\": node_id,\n        \"module\": getattr(target, \"__module__\", \"\"),\n        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n        \"source_lines\": len(source.splitlines()),\n    }\n\n\n# ------------------------------------------------------------ binding validation\n\n\ndef binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"Every node callable the *skeleton and unit path* resolve against.\n\n    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n    are absent here: they are exercised at the function level by N31's own\n    tests, and this generation does not wire their topology (spec section\n    8.1's D08/D09/D12/D14/D91 -> D17 and M05 -> D16 edges stay the declared\n    `unit_graph.DEFERRED_EDGES` rows they already are).\n\n    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n    likewise absent from *this* function deliberately, not by oversight: D24\n    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n    already-verified tables) declare that edge deferred to N32 by name. If D24\n    entered this function, `unit_graph.register_unit_path`'s *own*\n    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n    silently widen to include it -- correct for a production run, but it\n    would falsify N30's own already-passing topology tests, which independently\n    recompute their expectation from this exact function's return value.\n    `register_workbook_topology` registers the workbook engine as an additive\n    step over its own separate builder (N32 exercises it directly, not through\n    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n    byte-identical to what they were before N32 and the workbook branch is\n    still fully real -- just not reachable from `D05` in this generation,\n    exactly as `unit_graph.DEFERRED_EDGES` documents.\n    \"\"\"\n\n    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n        bindings[job_id] = adapter\n    bindings.update(MODEL_BOOKKEEPING_NODES)\n    return bindings\n\n\ndef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n\n    The complete node set the compiled graph actually registers. Kept\n    separate from `binding_inventory()` itself for the reason documented\n    there: several of N30's own tests recompute their expectation directly\n    from `binding_inventory()`'s return value, so that function's contract\n    (the skeleton/unit-path view) must stay exactly what it was before N32.\n    \"\"\"\n\n    bindings = dict(binding_inventory())\n    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n    return bindings\n\n\ndef unit_repair_binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"`binding_inventory()` plus N31's unit repair/acceptance cycle (D16-D23).\n\n    Kept separate from `binding_inventory()` itself for the same reason\n    `full_binding_inventory()` is kept separate from it: several of N30's own\n    tests recompute their expectation directly from `binding_inventory()`'s\n    return value, so that function's contract must stay exactly what it was\n    before this node. This is the set `build_curriculum_factory_graph` passes\n    to `register_skeleton` -- D16-D23 joining `available` there is what\n    resolves the six `unit_graph.DEFERRED_EDGES` rows this node owns.\n    \"\"\"\n\n    bindings = dict(binding_inventory())\n    bindings.update(acceptance.UNIT_REPAIR_NODE_BODIES)\n    return bindings\n\n\ndef _reject(code: str, node_id: str, detail: str) -> None:\n    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n\n\ndef validate_bindings(\n    bindings: Mapping[str, Callable[..., Any]],\n    *,\n    required: Sequence[str],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n\n    for node_id in required:\n        if node_id not in bindings:\n            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n\n    seen: dict[tuple[str, str], str] = {}\n    inventory: dict[str, dict[str, Any]] = {}\n    for node_id in sorted(bindings):\n        body = bindings[node_id]\n        if not callable(body):\n            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n        record = _binding_record(node_id, body)\n        module = record[\"module\"]\n        if not any(\n            module == allowed or module.startswith(f\"{allowed}.\")\n            for allowed in PRODUCTION_BINDING_MODULES\n        ):\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n        lowered = f\"{module}.{record['qualname']}\".lower()\n        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n        # positive on the spec's own vocabulary, not a caught stand-in.\n        marker = next(\n            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n            None,\n        )\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n        source = inspect.getsource(_underlying(body))\n        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n        identity = (module, record[\"qualname\"])\n        if identity in seen:\n            _reject(\n                \"N20-BIND-DUPLICATE\",\n                node_id,\n                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n            )\n        seen[identity] = node_id\n        inventory[node_id] = record\n    return inventory\n\n\ndef _validate_topology(registered: Sequence[str]) -> None:\n    known = set(registered) | {START, END}\n    wired: set[str] = set()\n    for source, target in SKELETON_NORMAL_EDGES:\n        for endpoint in (source, target):\n            if endpoint not in known:\n                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n        wired.update({source, target})\n    for source, path in SKELETON_BRANCHES:\n        if source not in known:\n            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n        wired.add(source)\n        for target in routing.guard_destinations(source):\n            if target not in known:\n                _reject(\n                    \"N20-EDGE-DANGLING\",\n                    target,\n                    f\"{source} branch {path.__name__} names an unregistered destination\",\n                )\n            wired.add(target)\n    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n        wired.update({source, target})\n    for source, _ in unit_graph.UNIT_BRANCHES:\n        wired.add(source)\n        wired.update(unit_graph.branch_destinations(source, registered))\n    for node_id in registered:\n        if node_id in wired:\n            continue\n        owner = DEFERRED_TOPOLOGY.get(node_id)\n        if owner is None:\n            _reject(\n                \"N20-NODE-UNDECLARED\",\n                node_id,\n                \"is registered but neither wired by the skeleton nor declared deferred\",\n            )\n\n\n# ---------------------------------------------------------------- registration\n\n\ndef register_skeleton(\n    builder: StateGraph,\n    bindings: Mapping[str, Callable[..., Any]],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Register every available node and the fixed skeleton edges.\n\n    N30 and N32 extend the same builder by adding their own `add_node`-free\n    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n    rewritten by them, so the skeleton stays the one place START, the recovery\n    branch, and the single edge to END are decided.\n    \"\"\"\n\n    routing.assert_guard_table_total(NODE_CATALOGUE)\n    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n    _validate_topology(sorted(bindings))\n\n    for node_id in sorted(bindings):\n        model_node = node_id in MODEL_NODE_ADAPTERS\n        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n\n    for source, target in SKELETON_NORMAL_EDGES:\n        builder.add_edge(source, target)\n\n    for source, path in SKELETON_BRANCHES:\n        destinations = routing.guard_destinations(source)\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n\n    unit_graph.register_unit_path(builder, sorted(bindings))\n\n    return inventory\n\n\ndef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n\n    Not called by `build_curriculum_factory_graph`: this generation's single\n    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n    this function into whatever the production compile point becomes once the\n    workbook branch is in scope; until then it is exercised directly, over its\n    own builder, the way N32's own topology test already does.\n    `register_skeleton` itself must never see these bindings; this function\n    adds exactly the nodes `register_skeleton` did not, then wires them over\n    the *full* merged node set so `workbook.register_workbook_path` can\n    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n    \"\"\"\n\n    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n    for node_id in sorted(workbook_bindings):\n        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n\n\ndef _skeleton_required_nodes() -> tuple[str, ...]:\n    required = {source for source, _ in SKELETON_BRANCHES}\n    for source, target in SKELETON_NORMAL_EDGES:\n        required.update({source, target})\n    for source, _ in SKELETON_BRANCHES:\n        required.update(routing.guard_destinations(source))\n    return tuple(sorted(required - {START, END}))\n\n\ndef build_curriculum_factory_graph(\n    *, engine_root: Path, output_root: Path\n) -> CompiledStateGraph:\n    \"\"\"Build and compile the one production graph (spec section 4).\n\n    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n    returned graph is invoked with `context=build_runtime_context(...)`; no\n    services are captured at build time, so the compiled object carries no\n    run identity and no authorization.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    builder: StateGraph = StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n    bindings = unit_repair_binding_inventory()\n    register_skeleton(builder, bindings)\n    acceptance.register_unit_repair_path(builder, sorted(bindings))\n    saver, _connection = open_checkpoint_saver(output_root)\n    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n\n\n# ---------------------------------------------------------------------- digest\n\n\ndef _canonical_digest(payload: Any) -> str:\n    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n\n\ndef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n\n    drawn = compiled.get_graph()\n    return {\n        \"name\": compiled.name,\n        \"nodes\": sorted(drawn.nodes),\n        \"edges\": sorted(\n            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n        ),\n    }\n\n\ndef contract_digests() -> dict[str, str]:\n    \"\"\"File digests of every frozen model prompt and output schema.\n\n    Folded into the graph digest so prompt or schema drift is visible as graph\n    drift: the same topology over a changed prompt is not the same graph.\n    \"\"\"\n\n    digests: dict[str, str] = {}\n    registry = tp.load_job_registry()\n    for job_id in sorted(registry):\n        route = registry[job_id]\n        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n            path = Path(path)\n            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return digests\n\n\ndef graph_digest(compiled: CompiledStateGraph) -> str:\n    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n\n    Identical real bindings give an identical digest; a changed node body,\n    reducer declaration, prompt, or schema changes it. Python object identity is\n    deliberately not an input, so two builds in one process and two builds in two\n    processes agree.\n    \"\"\"\n\n    payload = {\n        \"topology\": compiled_topology(compiled),\n        \"bindings\": [\n            _binding_record(node_id, body)\n            for node_id, body in sorted(binding_inventory().items())\n        ],\n        \"state\": {\n            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n            \"input\": list(FACTORY_INPUT_FIELDS),\n            \"output\": list(FACTORY_OUTPUT_FIELDS),\n        },\n        \"contracts\": contract_digests(),\n    }\n    return _canonical_digest(payload)\n","numLines":614,"startLine":1,"totalLines":614}}}
