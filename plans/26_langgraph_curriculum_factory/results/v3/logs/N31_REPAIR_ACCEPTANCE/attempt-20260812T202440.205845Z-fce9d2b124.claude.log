{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LvenDQQiq8JFK1CmDDKNXm","type":"tool_result","content":"1255\t# not an observable interrupt boundary and is excluded from the matrix above\n1256\t# rather than asserted vacuously. The same was true of D09 until B-10 was fixed\n1257\t# and the frontier moved past it.\n1258\tUNOBSERVABLE_BOUNDARY = \"M05_REVIEW_ACTUAL_UNIT\"\n1259\t\n1260\t\n1261\tdef test_a_fresh_episode_executes_the_bootstrap_spine_once_through_langgraph(\n1262\t    tmp_path: Path, monkeypatch\n1263\t) -> None:\n1264\t    \"\"\"Prompt TEST 1: the fresh path really runs, and D01 runs exactly once.\"\"\"\n1265\t\n1266\t    fixture = _build_episode_fixture(tmp_path)\n1267\t    result = _run_episode(monkeypatch, fixture)\n1268\t\n1269\t    assert result[\"trace\"][: len(BOOTSTRAP_SPINE)] == list(BOOTSTRAP_SPINE)\n1270\t    assert result[\"trace\"].count(\"D01_VALIDATE_AND_FREEZE_INPUTS\") == 1\n1271\t    assert \"D00R_REVALIDATE_RESUME_IDENTITY\" not in result[\"trace\"]\n1272\t    assert \"D92_REENTER_VALIDATED_FRONTIER\" not in result[\"trace\"]\n1273\t\n1274\t    state = result[\"state\"]\n1275\t    assert state[\"bootstrap_kind\"] == \"fresh\"\n1276\t    assert state[\"run_id\"]\n1277\t    assert state[\"mode\"] == \"one\"\n1278\t    assert state[\"effective_run\"][\"target_closure\"] == [\"U001\"]\n1279\t    assert state[\"selected_unit_id\"] == \"U001\"\n1280\t    # No product success, and no second terminal, however the episode ends.\n1281\t    assert result[\"trace\"].count(\"D98_WRITE_TERMINAL\") <= 1\n1282\t    if state.get(\"terminal\") is not None:\n1283\t        assert state[\"terminal\"][\"kind\"] not in (\"UNIT_ACCEPTED\", \"COMPLETE\")\n1284\t\n1285\t\n1286\tdef test_the_source_map_reduce_supersteps_execute_as_real_send_fanouts(\n1287\t    tmp_path: Path, monkeypatch\n1288\t) -> None:\n1289\t    \"\"\"Both M01 supersteps run as `Send` maps, join at their barriers, and admit.\n1290\t\n1291\t    With B-6 and B-7 closed this is a real reduction, not a trace of a refusal:\n1292\t    each map reserves through D90 first, runs two real M01 workers in one\n1293\t    superstep, and D07's exact join admits both sources.\n1294\t    \"\"\"\n1295\t\n1296\t    fixture = _build_episode_fixture(tmp_path)\n1297\t    result = _run_episode(monkeypatch, fixture)\n1298\t    trace = result[\"trace\"]\n1299\t\n1300\t    # Two `Send` maps of two members each: four M01 activations, no more.\n1301\t    assert trace.count(\"M01_RESEARCH_UNIT_SOURCES\") == 4\n1302\t    # Each map is preceded by its reservation, and each superstep is contiguous.\n1303\t    first = trace.index(\"M01_RESEARCH_UNIT_SOURCES\")\n1304\t    assert trace[first - 1] == \"D90_RESERVE_MODEL_ATTEMPT\"\n1305\t    assert trace[first : first + 2] == [\"M01_RESEARCH_UNIT_SOURCES\"] * 2\n1306\t    assert trace[first + 2] == \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n1307\t\n1308\t    # No model failure at all: every dispatch carried a committed counter.\n1309\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in trace\n1310\t\n1311\t    # The join really admitted, and the denominator it joined is the one D06 committed.\n1312\t    admission = next(\n1313\t        update for node_id, update in result[\"updates\"]\n1314\t        if node_id == \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n1315\t    )\n1316\t    assert admission[\"pending_guard\"][\"value\"] == \"sources_admitted\"\n1317\t    denominator = next(\n1318\t        iter(\n1319\t            next(\n1320\t                update for node_id, update in result[\"updates\"]\n1321\t                if node_id == \"D06_COMPILE_SOURCE_REQUESTS\"\n1322\t            )[\"source_denominators\"].values()\n1323\t        )\n1324\t    )\n1325\t    assert sorted(record[\"key\"] for record in admission[\"source_admissions\"]) == sorted(\n1326\t        denominator[\"request_keys\"]\n1327\t    )\n1328\t\n1329\t\n1330\tdef test_the_domain_head_advances_only_after_code_owned_admission(\n1331\t    tmp_path: Path, monkeypatch\n1332\t) -> None:\n1333\t    \"\"\"Prompt TEST 4, on a real episode: M02 writes a candidate, D08 mints the head.\n1334\t\n1335\t    The head that exists at the end of the episode was minted by D08, not by the\n1336\t    model: the M02 record in the same episode carries no `version`/`hash`, and the\n1337\t    admitted head's hash is not any hash the model supplied.\n1338\t    \"\"\"\n1339\t\n1340\t    fixture = _build_episode_fixture(tmp_path)\n1341\t    result = _run_episode(monkeypatch, fixture)\n1342\t    trace = result[\"trace\"]\n1343\t    assert trace.index(\"M02_CREATE_UNIT_DOMAIN_DATA\") < trace.index(\"D08_VALIDATE_DOMAIN\")\n1344\t\n1345\t    candidate = next(\n1346\t        update for node_id, update in result[\"updates\"]\n1347\t        if node_id == \"M02_CREATE_UNIT_DOMAIN_DATA\"\n1348\t    )[\"artifact_versions\"][0]\n1349\t    assert candidate[\"record_kind\"] == \"model_candidate\"\n1350\t    assert not {\"version\", \"hash\", \"parent_hash\"} & set(candidate)\n1351\t\n1352\t    heads = result[\"state\"][\"artifact_heads\"]\n1353\t    domain_head = heads[\"units/U001/domain\"]\n1354\t    assert domain_head[\"version\"] == 1"}]},"parent_tool_use_id":null,"session_id":"b21865dd-1a72-43f4-8cf1-c4fe980203a9","uuid":"c484b499-47bf-4ec5-ac2e-2220227911c7","timestamp":"2026-08-12T20:27:22.036Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T202440.205845Z-fce9d2b124/repo/tests/runtime/test_plan26_unit_graph.py","content":"# not an observable interrupt boundary and is excluded from the matrix above\n# rather than asserted vacuously. The same was true of D09 until B-10 was fixed\n# and the frontier moved past it.\nUNOBSERVABLE_BOUNDARY = \"M05_REVIEW_ACTUAL_UNIT\"\n\n\ndef test_a_fresh_episode_executes_the_bootstrap_spine_once_through_langgraph(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 1: the fresh path really runs, and D01 runs exactly once.\"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    assert result[\"trace\"][: len(BOOTSTRAP_SPINE)] == list(BOOTSTRAP_SPINE)\n    assert result[\"trace\"].count(\"D01_VALIDATE_AND_FREEZE_INPUTS\") == 1\n    assert \"D00R_REVALIDATE_RESUME_IDENTITY\" not in result[\"trace\"]\n    assert \"D92_REENTER_VALIDATED_FRONTIER\" not in result[\"trace\"]\n\n    state = result[\"state\"]\n    assert state[\"bootstrap_kind\"] == \"fresh\"\n    assert state[\"run_id\"]\n    assert state[\"mode\"] == \"one\"\n    assert state[\"effective_run\"][\"target_closure\"] == [\"U001\"]\n    assert state[\"selected_unit_id\"] == \"U001\"\n    # No product success, and no second terminal, however the episode ends.\n    assert result[\"trace\"].count(\"D98_WRITE_TERMINAL\") <= 1\n    if state.get(\"terminal\") is not None:\n        assert state[\"terminal\"][\"kind\"] not in (\"UNIT_ACCEPTED\", \"COMPLETE\")\n\n\ndef test_the_source_map_reduce_supersteps_execute_as_real_send_fanouts(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Both M01 supersteps run as `Send` maps, join at their barriers, and admit.\n\n    With B-6 and B-7 closed this is a real reduction, not a trace of a refusal:\n    each map reserves through D90 first, runs two real M01 workers in one\n    superstep, and D07's exact join admits both sources.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    trace = result[\"trace\"]\n\n    # Two `Send` maps of two members each: four M01 activations, no more.\n    assert trace.count(\"M01_RESEARCH_UNIT_SOURCES\") == 4\n    # Each map is preceded by its reservation, and each superstep is contiguous.\n    first = trace.index(\"M01_RESEARCH_UNIT_SOURCES\")\n    assert trace[first - 1] == \"D90_RESERVE_MODEL_ATTEMPT\"\n    assert trace[first : first + 2] == [\"M01_RESEARCH_UNIT_SOURCES\"] * 2\n    assert trace[first + 2] == \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n\n    # No model failure at all: every dispatch carried a committed counter.\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in trace\n\n    # The join really admitted, and the denominator it joined is the one D06 committed.\n    admission = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n    )\n    assert admission[\"pending_guard\"][\"value\"] == \"sources_admitted\"\n    denominator = next(\n        iter(\n            next(\n                update for node_id, update in result[\"updates\"]\n                if node_id == \"D06_COMPILE_SOURCE_REQUESTS\"\n            )[\"source_denominators\"].values()\n        )\n    )\n    assert sorted(record[\"key\"] for record in admission[\"source_admissions\"]) == sorted(\n        denominator[\"request_keys\"]\n    )\n\n\ndef test_the_domain_head_advances_only_after_code_owned_admission(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 4, on a real episode: M02 writes a candidate, D08 mints the head.\n\n    The head that exists at the end of the episode was minted by D08, not by the\n    model: the M02 record in the same episode carries no `version`/`hash`, and the\n    admitted head's hash is not any hash the model supplied.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    trace = result[\"trace\"]\n    assert trace.index(\"M02_CREATE_UNIT_DOMAIN_DATA\") < trace.index(\"D08_VALIDATE_DOMAIN\")\n\n    candidate = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"M02_CREATE_UNIT_DOMAIN_DATA\"\n    )[\"artifact_versions\"][0]\n    assert candidate[\"record_kind\"] == \"model_candidate\"\n    assert not {\"version\", \"hash\", \"parent_hash\"} & set(candidate)\n\n    heads = result[\"state\"][\"artifact_heads\"]\n    domain_head = heads[\"units/U001/domain\"]\n    assert domain_head[\"version\"] == 1","numLines":100,"startLine":1255,"totalLines":2632}}}
