{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018QVKVgTX4HNUG4o2cJcnka","type":"tool_result","content":"656\t# ---------------------------------------------------------------------- digest\n657\t\n658\t\n659\tdef _canonical_digest(payload: Any) -> str:\n660\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n661\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n662\t\n663\t\n664\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n665\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n666\t\n667\t    drawn = compiled.get_graph()\n668\t    return {\n669\t        \"name\": compiled.name,\n670\t        \"nodes\": sorted(drawn.nodes),\n671\t        \"edges\": sorted(\n672\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n673\t        ),\n674\t    }\n675\t\n676\t\n677\tdef contract_digests() -> dict[str, str]:\n678\t    \"\"\"File digests of every frozen model prompt and output schema.\n679\t\n680\t    Folded into the graph digest so prompt or schema drift is visible as graph\n681\t    drift: the same topology over a changed prompt is not the same graph.\n682\t    \"\"\"\n683\t\n684\t    digests: dict[str, str] = {}\n685\t    registry = tp.load_job_registry()\n686\t    for job_id in sorted(registry):\n687\t        route = registry[job_id]\n688\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n689\t            path = Path(path)\n690\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n691\t    return digests\n692\t\n693\t\n694\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n695\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n696\t\n697\t    Identical real bindings give an identical digest; a changed node body,\n698\t    reducer declaration, prompt, or schema changes it. Python object identity is\n699\t    deliberately not an input, so two builds in one process and two builds in two\n700\t    processes agree.\n701\t    \"\"\"\n702\t\n703\t    payload = {\n704\t        \"topology\": compiled_topology(compiled),\n705\t        \"bindings\": [\n706\t            _binding_record(node_id, body)\n707\t            for node_id, body in sorted(binding_inventory().items())\n708\t        ],\n709\t        \"state\": {\n710\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],"}]},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"cea8a249-ca12-4536-bfa5-adfd39be2567","timestamp":"2026-08-12T21:39:42.884Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/graph.py","content":"# ---------------------------------------------------------------------- digest\n\n\ndef _canonical_digest(payload: Any) -> str:\n    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n\n\ndef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n\n    drawn = compiled.get_graph()\n    return {\n        \"name\": compiled.name,\n        \"nodes\": sorted(drawn.nodes),\n        \"edges\": sorted(\n            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n        ),\n    }\n\n\ndef contract_digests() -> dict[str, str]:\n    \"\"\"File digests of every frozen model prompt and output schema.\n\n    Folded into the graph digest so prompt or schema drift is visible as graph\n    drift: the same topology over a changed prompt is not the same graph.\n    \"\"\"\n\n    digests: dict[str, str] = {}\n    registry = tp.load_job_registry()\n    for job_id in sorted(registry):\n        route = registry[job_id]\n        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n            path = Path(path)\n            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return digests\n\n\ndef graph_digest(compiled: CompiledStateGraph) -> str:\n    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n\n    Identical real bindings give an identical digest; a changed node body,\n    reducer declaration, prompt, or schema changes it. Python object identity is\n    deliberately not an input, so two builds in one process and two builds in two\n    processes agree.\n    \"\"\"\n\n    payload = {\n        \"topology\": compiled_topology(compiled),\n        \"bindings\": [\n            _binding_record(node_id, body)\n            for node_id, body in sorted(binding_inventory().items())\n        ],\n        \"state\": {\n            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],","numLines":55,"startLine":656,"totalLines":717}}}
