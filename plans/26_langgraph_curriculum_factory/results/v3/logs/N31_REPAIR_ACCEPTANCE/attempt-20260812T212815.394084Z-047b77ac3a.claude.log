    recompute their expectation from this exact function's return value.\n361\t    `register_workbook_topology` registers the workbook engine as an additive\n362\t    step over its own separate builder (N32 exercises it directly, not through\n363\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n364\t    byte-identical to what they were before N32 and the workbook branch is\n365\t    still fully real -- just not reachable from `D05` in this generation,\n366\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n367\t    \"\"\"\n368\t\n369\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n370\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n371\t        bindings[job_id] = adapter\n372\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n373\t    return bindings\n374\t\n375\t\n376\tdef repair_acceptance_bindings() -> dict[str, Callable[..., Any]]:\n377\t    \"\"\"`binding_inventory()` plus N31's repair/acceptance cycle (D16-D23).\n378\t\n379\t    The set `build_curriculum_factory_graph()` actually compiles against: the\n380\t    skeleton/unit-path view plus the eight node bodies `register_unit_repair_\n381\t    path` wires. Kept separate from `binding_inventory()` for the reason that\n382\t    function's own docstring records -- N30's tests trust its return value\n383\t    unchanged.\n384\t    \"\"\"\n385\t\n386\t    bindings = dict(binding_inventory())\n387\t    bindings.update(UNIT_REPAIR_NODE_BODIES)\n388\t    return bindings\n389\t\n390\t\n391\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n392\t    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n393\t\n394\t    Deliberately *not* `repair_acceptance_bindings()` plus workbook: this is\n395\t    N32's own pre-existing function, used only by `register_workbook_topology`\n396\t    to resolve D90/D91/D98/M07/M08 (none of which need D16-D23), and N32's own\n397\t    `test_plan26_workbook.py` may recompute its expectation directly from this\n398\t    exact return value the same way N30's tests trust `binding_inventory()`'s.\n399\t    Widening it here would be an unrequested, unreviewed change to a contract\n400\t    outside this generation's write set for no behavioral gain.\n401\t    \"\"\"\n402\t\n403\t    bindings = dict(binding_inventory())\n404\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n405\t    return bindings\n406\t\n407\t\n408\tdef _reject(code: str, node_id: str, detail: str) -> None:\n409\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n410\t\n411\t\n412\tdef validate_bindings(\n413\t    bindings: Mapping[str, Callable[..., Any]],\n414\t    *,\n415\t    required: Sequence[str],\n416\t) -> dict[str, dict[str, Any]]:\n417\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n418\t\n419\t    for node_id in required:\n420\t        if node_id not in bindings:\n421\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n422\t\n423\t    seen: dict[tuple[str, str], str] = {}\n424\t    inventory: dict[str, dict[str, Any]] = {}\n425\t    for node_id in sorted(bindings):\n426\t        body = bindings[node_id]\n427\t        if not callable(body):\n428\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n429\t        record = _binding_record(node_id, body)\n430\t        module = record[\"module\"]\n431\t        if not any(\n432\t            module == allowed or module.startswith(f\"{allowed}.\")\n433\t            for allowed in PRODUCTION_BINDING_MODULES\n434\t        ):\n435\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n436\t        lowered = f\"{module}.{record['qualname']}\".lower()\n437\t        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n438\t        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n439\t        # rejected every 