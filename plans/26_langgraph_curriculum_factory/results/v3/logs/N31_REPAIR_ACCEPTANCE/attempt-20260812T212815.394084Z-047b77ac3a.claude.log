{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014FbJdyfyhS2HDsVJ11qrYd","type":"tool_result","content":"500\t\n501\t\n502\tdef _run_episode(monkeypatch: Any, fixture: dict[str, Any], *, interrupt_after: str | None = None) -> dict[str, Any]:\n503\t    lock, invocation, envelope = _prepare_episode(fixture)\n504\t    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n505\t    monkeypatch.setattr(\n506\t        G, \"build_model_node_context\", lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"])\n507\t    )\n508\t    compiled = G.build_curriculum_factory_graph(engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"])\n509\t\n510\t    trace: list[str] = []\n511\t    updates: list[tuple[str, dict[str, Any]]] = []\n512\t    deferred_frontier: str | None = None\n513\t    try:\n514\t        for chunk in compiled.stream(\n515\t            {\"invocation\": envelope}, config=invocation.config, stream_mode=\"updates\", context=context\n516\t        ):\n517\t            for node_id, update in chunk.items():\n518\t                trace.append(node_id)\n519\t                updates.append((node_id, dict(update or {})))\n520\t                if interrupt_after is not None and node_id == interrupt_after:\n521\t                    context.signal_token.trip()\n522\t    except KeyError as error:\n523\t        missing = error.args[0] if error.args else None\n524\t        declared = {row[2] for row in U.DEFERRED_EDGES}\n525\t        if missing not in declared:\n526\t            raise\n527\t        deferred_frontier = str(missing)\n528\t    lock.release()\n529\t    return {\n530\t        \"trace\": trace, \"updates\": updates, \"deferred_frontier\": deferred_frontier,\n531\t        \"state\": compiled.get_state(invocation.config).values,\n532\t        \"context\": context, \"invocation\": invocation, \"compiled\": compiled,\n533\t    }\n534\t\n535\t\n536\tdef _synthetic_manifest(\n537\