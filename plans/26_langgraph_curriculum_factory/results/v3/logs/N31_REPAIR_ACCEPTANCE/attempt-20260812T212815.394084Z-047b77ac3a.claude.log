{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vgp5UjkdTNQw29THHp3ZE1","type":"tool_result","content":"100\t\n101\t\n102\tclass _Context:\n103\t    \"\"\"The narrow deterministic-node service surface (mirrors N30's `_Context`).\"\"\"\n104\t\n105\t    def __init__(self, **services: Any) -> None:\n106\t        self.engine_root = services.pop(\"engine_root\", Path(\"/tmp\"))\n107\t        self.output_root = services.pop(\"output_root\", Path(\"/tmp/out\"))\n108\t        self.path_guard = object()\n109\t        self.evidence_service = object()\n110\t        self.transport_registry = services.pop(\"transport_registry\", object())\n111\t        self.source_retriever = services.pop(\"source_retriever\", None)\n112\t        self.signal_token = services.pop(\"signal_token\", _Token())\n113\t        self.clock = services.pop(\"clock\", lambda: \"2026-01-01T00:00:00Z\")\n114\t\n115\t\n116\tdef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n117\t    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n118\t\n119\t    merged = dict(state)\n120\t    for field, value in update.items():\n121\t        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n122\t    return merged\n123\t\n124\t\n125\tdef _tree_snapshot(root: Path, *, skip_control: bool = True) -> dict[str, tuple[int, str]]:\n126\t    out: dict[str, tuple[int, str]] = {}\n127\t    for path in sorted(root.rglob(\"*\")):\n128\t        if not path.is_file():\n129\t            continue\n130\t        relative = path.relative_to(root).as_posix()\n131\t        if skip_control and relative.startswith(f\"{P.LANGGRAPH_DIRNAME}/\"):\n132\t            continue\n133\t        out[relative] = (path.stat().st_mtime_ns, hashlib.sha256(path.read_bytes()).hexdigest())\n134\t    return out\n135\t\n136\t\n137\tdef _run_child(script: str, *args: str) -> subprocess.CompletedProcess:\n138\t    with tempfile.NamedTemporaryFile(\"w\", suffix=\".py\", delete=False) as handle:\n139\t        handle.write(textwrap.dedent(script))\n140\t        child_path = handle.name\n141\t    try:\n142\t        return subprocess.run(\n143\t            [sys.executable, child_path, str(REPO_ROOT), *args],\n144\t            capture_output=True,\n145\t            text=True,\n146\t            timeout=180,\n147\t        )\n148\t    finally:\n149\t        os.unlink(child_path)\n150\t\n151\t\n152\tPERSISTENCE_IDENTITY_SEED = {\n153\t    \"contract_version\": \"plan26.v1\",\n154\t    \"created_at\": \"2026-08-11T00:00:00Z\",\n155\t    \"engine_root\": \"/engine\",\n156\t    \"curriculum_root\": \"/curriculum\",\n157\t    \"active_manifest_path\": \"/curriculum/manifest.yaml\",\n158\t    \"output_root\": \"/output\",\n159\t    \"mode\": \"one\",\n160\t    \"requested_unit_id\": \"U01\",\n161\t}\n162\t\n163\t\n164\tclass _LinearState(TypedDict, total=False):\n165\t    seen: Annotated[list, operator.add]\n166\t\n167\t\n168\t# ===========================================================================\n169\t# full-episode harness (rows 23, 24, 26): one real compiled graph, a\n170\t# test-only scripted transport. Adapted from N30's own harness\n171\t# (`test_plan26_unit_graph.py`), duplicated here rather than imported so this\n172\t# file stays self-contained per the suite's per-file convention.\n173\t# ===========================================================================\n174\t\n175\t\n176\tclass _StubRegistry:\n177\t    def __init__(self, sandbox: Path) -> None:\n178\t        self.sandbox = sandbox\n179\t        self.rendered_units: list[str] = []\n180\t        self.inspected: list[str] = []\n181\t\n182\t    def prove_capability(self, capability: str) -> dict[str, Any]:\n183\t        return {\"result\": \"PASS\", \"capability\": capability, \"detail\": \"test double\"}\n184\t\n185\t    def observe_executable(self, name: str) -> dict[str, Any]:\n186\t        return {\"name\": name, \"path\": f\"/usr/bin/{name}\", \"sha256\": \"0\" * 64}\n187\t\n188\t    def render_deterministic_visual(self, brief: Any, permitted_facts: Any) -> dict[str, Any]:\n189\t        path = self.sandbox / \"visuals\" / (str(brief[\"key\"]).replace(\"/\", \"_\") + \".svg\")\n190\t        path.parent.mkdir(parents=True, exist_ok=True)\n191\t        body = f\"<svg data-key='{brief['key']}'/>\".encode()\n192\t        path.write_bytes(body)\n193\t        return {\"asset_path\": str(path), \"sha256\": hashlib.sha256(body).hexdigest(), \"format\": \"svg\"}\n194\t\n195\t    def render_unit(self, unit_id: str, parents: Any) -> dict[str, Any]:\n196\t        self.rendered_units.append(unit_id)\n197\t        directory = self.sandbox / \"render\"\n198\t        directory.mkdir(parents=True, exist_ok=True)\n199\t        body = json.dumps({\"unit\": unit_id, \"parents\": parents}, sort_keys=True).encode()\n200\t        pdf, layout = directory / f\"{unit_id}.pdf\", directory / f\"{unit_id}.layout.json\"\n201\t        pdf.write_bytes(body)\n202\t        layout.write_bytes(body)\n203\t        digest = hashlib.sha256(body).hexdigest()\n204\t        return {\n205\t            \"layout_path\": str(layout),\n206\t            \"layout_sha256\": digest,\n207\t            \"pdf_path\": str(pdf),\n208\t            \"pdf_sha256\": digest,\n209\t            \"renderer\": \"test_double_renderer\",\n210\t            \"attempt\": 1,\n211\t        }\n212\t\n213\t    def inspect_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n214\t        self.inspected.append(pdf_sha256)\n215\t        pages = []\n216\t        for number in (1, 2):\n217\t            image = self.sandbox / \"pages\" / f\"{Path(pdf_path).stem}-{number}.png\"\n218\t            image.parent.mkdir(parents=True, exist_ok=True)\n219\t            body = f\"page-{number}-{pdf_sha256}\".encode()\n220\t            image.write_bytes(body)\n221\t            pages.append(\n222\t                {\n223\t                    \"number\": number,\n224\t                    \"page_sha256\": hashlib.sha256(body).hexdigest(),\n225\t                    \"image_path\": str(image),\n226\t                    \"problems\": [],\n227\t                    \"unreadable\": False,\n228\t                }\n229\t            )\n230\t        return {\"pages\": pages}\n231\t\n232\t\n233\tclass _StubRetriever:\n234\t    def __init__(self) -> None:\n235\t        self.fetched: list[str] = []\n236\t\n237\t    def fetch(self, locator: Any, authorization: Any, scope: Any) -> dict[str, Any]:\n238\t        self.fetched.append(str(locator))\n239\t        body = json.dumps({\"locator\": locator, \"scope\": scope}, sort_keys=True).encode()\n240\t        return {\n241\t            \"locator\": locator,\n242\t            \"sha256\": hashlib.sha256(body).hexdigest(),\n243\t            \"status\": 200,\n244\t            \"content_type\": \"text/html\",\n245\t            \"tls\": {\"verified\": True},\n246\t            \"bytes_path\": None,\n247\t        }\n248\t\n249\t\n250\tclass _SwitchableToken:\n251\t    def __init__(self, trip_after: str | None = None) -> None:\n252\t        self.trip_after = trip_after\n253\t        self.tripped = False\n254\t        self.observed: list[str] = []\n255\t\n256\t    def trip(self) -> None:\n257\t        self.tripped = True\n258\t\n259\t    def is_set(self) -> bool:\n260\t        return self.tripped\n261\t\n262\t\n263\tclass _HarnessContext:\n264\t    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n265\t\n266\t    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n267\t        self.engine_root = engine_root\n268\t        self.output_root = output_root\n269\t        self.path_guard = ArtifactStore(output_root)\n270\t        self.evidence_service = EvidenceStore(output_root)\n271\t        self.transport_registry = _StubRegistry(sandbox)\n272\t        self.source_retriever = _StubRetriever()\n273\t        self.signal_token = _SwitchableToken()\n274\t        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n275\t\n276\t\n277\tclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n278\t    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:\n279\t        super().__init__(sandbox_root=sandbox_root, responses={}, registry=registry)\n280\t        self.calls: list[tuple[str, str]] = []\n281\t\n282\t    def execute(self, *, job_id: str, activation_id: str, projection: Any = None, **kwargs: Any):\n283\t        projection = dict(projection or {})\n284\t        self.calls.append((job_id, activation_id))\n285\t        self.responses[job_id] = _scripted_candidate(job_id, projection)\n286\t        return super().execute(\n287\t            job_id=job_id, activation_id=activation_id, projection=projection, **kwargs\n288\t        )\n289\t\n290\t\n291\tDECLARED_VISUALS: list[dict[str, Any]] = [\n292\t    {\"role\": \"build_map\", \"kind\": \"schematic\", \"authoritative\": True, \"permitted_facts\": [\"fact-a\"]},\n293\t    {\"role\": \"overview\", \"kind\": \"diagram\", \"authoritative\": False, \"permitted_facts\": [\"fact-b\"]},\n294\t]\n295\t\n296\t\n297\tdef _scripted_candidate(job_id: str, projection: dict[str, Any]) -> dict[str, Any]:\n298\t    if job_id == \"M01_RESEARCH_UNIT_SOURCES\":\n299\t        request_id = projection[\"request\"].get(\"request_id\")\n300\t        group = projection.get(\"retrieval_group\")\n301\t        if group is None:\n302\t            return {\n303\t                \"locators\": [\n304\t                    {\n305\t                        \"request_id\": request_id,\n306\t                        \"url\": f\"https://example.invalid/{request_id}\",\n307\t                        \"title\": \"scripted source\",\n308\t                        \"publisher\": \"scripted publisher\",\n309\t                        \"locator_kind\": \"primary\",\n310\t                        \"rationale\": \"scripted rationale\",\n311\t                    }\n312\t                ]\n313\t            }\n314\t        return {\n315\t            \"interpretations\": [\n316\t                {\n317\t                    \"request_id\": request_id,\n318\t                    \"retrieval_id\": str(record.get(\"retrieval_id\")),\n319\t                    \"claims\": [\n320\t                        {\"claim_text\": \"scripted claim\", \"source_quote\": \"scripted quote\", \"source_location\": \"p.1\"}\n321\t                    ],\n322\t                    \"limitations\": [],\n323\t                }\n324\t                for record in group.get(\"retrieved_records\", [])\n325\t            ]\n326\t        }\n327\t    if job_id == \"M02_CREATE_UNIT_DOMAIN_DATA\":\n328\t        unit_id = projection[\"unit\"].get(\"unit_id\")\n329\t        admitted = projection.get(\"admitted_sources\") or []\n330\t        facts = [\n331\t            {\"fact_id\": str(source.get(\"fact_id\")), \"statement\": f\"scripted statement for {source.get('fact_id')}\"}\n332\t            for source in admitted\n333\t        ] or [{\"fact_id\": \"required_explanation:000\", \"statement\": \"scripted statement\"}]\n334\t        return {\n335\t            \"domain_version\": {\n336\t                \"unit_id\": unit_id,\n337\t                \"fields\": {\"unit_id\": unit_id, \"facts\": facts, \"verifier_result\": {\"result\": \"all_fixtures_behaved\"}},\n338\t                \"evidence_references\": [\n339\t                    {\"source_id\": str(source.get(\"source_id\") or source.get(\"key\") or \"s1\"), \"source_location\": \"p.1\"}\n340\t                    for source in admitted\n341\t                ]\n342\t                or [{\"source_id\": \"s1\", \"source_location\": \"p.1\"}],\n343\t            }\n344\t        }\n345\t    if job_id == \"M03_WRITE_UNIT_CONTENT\":\n346\t        admitted_domain = projection.get(\"admitted_domain\") or {}\n347\t        unit_id = str(admitted_domain.get(\"unit_id\") or projection[\"unit\"].get(\"unit_id\"))\n348\t        admissible = projection.get(\"admitted_evidence_references\") or []\n349\t        return {\n350\t            \"unit_content\": {\n351\t                \"unit_id\": unit_id,\n352\t                \"sections\": [\n353\t                    {\"section_id\": f\"s{index:03d}\", \"heading\": f\"scripted heading {index}\",\n354\t                     \"body\": f\"scripted body for {reference.get('fact_id')}\"}\n355\t                    for index, reference in enumerate(admissible, start=1)\n356\t                ],\n357\t                \"evidence_references\": [\n358\t                    {\"section_id\": f\"s{index:03d}\", \"source_id\": str(reference.get(\"source_id\")),\n359\t                     \"source_location\": \"p.1\"}\n360\t                    for index, reference in enumerate(admissible, start=1)\n361\t                ],\n362\t                \"visuals\": DECLARED_VISUALS,\n363\t            }\n364\t        }\n365\t    if job_id == \"M04_CREATE_UNIT_VISUALS\":\n366\t        brief_id = str(projection[\"brief\"].get(\"brief_id\") or projection[\"brief\"].get(\"key\"))\n367\t        return {\n368\t            \"visual_candidate\": {\n369\t                \"brief_id\": brief_id, \"prompt_text\": f\"scripted prompt for {brief_id}\",\n370\t                \"dimensions\": {\"width_px\": 1024, \"height_px\": 768}, \"image_format\": \"png\",\n371\t                \"accessibility_text\": f\"scripted alt text for {brief_id}\",\n372\t            },\n373\t            \"provenance_declaration\": {\n374\t                \"brief_id\": brief_id,\n375\t                \"permitted_facts_used\": [str(fact) for fact in (projection.get(\"permitted_facts\") or [])],\n376\t                \"asserts_authoritative_detail\": False,\n377\t            },\n378\t        }\n379\t    if job_id == \"M05_REVIEW_ACTUAL_UNIT\":\n380\t        pages = projection.get(\"pages\") or []\n381\t        return {\n382\t            \"overall_findings\": [],\n383\t            \"page_findings\": [\n384\t                {\"page_number\": int(page[\"page_number\"]), \"page_sha256\": str(page[\"page_sha256\"]), \"findings\": []}\n385\t                for page in pages\n386\t            ],\n387\t        }\n388\t    raise AssertionError(f\"no scripted candidate for {job_id}\")\n389\t\n390\t\n391\tdef _scripted_model_context(sandbox: Path) -> Any:\n392\t    routes = mn.tp.load_job_registry()\n393\t    return mn.ModelNodeContext(transport=_ScriptedFakeTransport(sandbox_root=sandbox, registry=routes), registry=routes)\n394\t\n395\t\n396\tENGINE_CONTRACTS: tuple[str, ...] = (\n397\t    \"schemas/manifest_domain.metaschema.v1.json\",\n398\t    \"policy/calibration.v1.yaml\",\n399\t    \"meta_prompt/assets/pedagogy.v1.md\",\n400\t    *domain.CURRICULUM_CONTRACTS,\n401\t)\n402\t\n403\tSYNTHETIC_DOMAIN_SCHEMA_RELATIVE = \"schemas/synthetic_domain.v1.json\"\n404\tSYNTHETIC_DOMAIN_SCHEMA: dict[str, Any] = {\n405\t    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n406\t    \"$id\": \"plan26/test/synthetic_domain.v1.json\",\n407\t    \"type\": \"object\",\n408\t    \"additionalProperties\": False,\n409\t    \"required\": [\"unit_id\", \"facts\", \"verifier_result\"],\n410\t    \"properties\": {\n411\t        \"unit_id\": {\"type\": \"string\", \"minLength\": 1},\n412\t        \"facts\": {\n413\t            \"type\": \"array\", \"minItems\": 1,\n414\t            \"items\": {\n415\t                \"type\": \"object\", \"additionalProperties\": False,\n416\t                \"required\": [\"fact_id\", \"statement\"],\n417\t                \"properties\": {\"fact_id\": {\"type\": \"string\", \"minLength\": 1}, \"statement\": {\"type\": \"string\", \"minLength\": 1}},\n418\t            },\n419\t        },\n420\t        \"verifier_result\": {\n421\t            \"type\": \"object\", \"additionalProperties\": True, \"required\": [\"result\"],\n422\t            \"properties\": {\"result\": {\"type\": \"string\"}},\n423\t        },\n424\t    },\n425\t}\n426\t\n427\t\n428\tdef _build_episode_fixture(tmp_path: Path, units: int = 1) -> dict[str, Any]:\n429\t    engine = tmp_path / \"engine\"\n430\t    curriculum = engine / \"curricula\" / \"synthetic\"\n431\t    curriculum.mkdir(parents=True)\n432\t    for name in (\"schemas\", \"policy\", \"meta_prompt\"):\n433\t        (engine / name).mkdir()\n434\t    (engine / \"schemas\" / \"placeholder.json\").write_text(\"{}\", encoding=\"utf-8\")\n435\t    for relative in ENGINE_CONTRACTS:\n436\t        target = engine / relative\n437\t        target.parent.mkdir(parents=True, exist_ok=True)\n438\t        target.write_bytes((REPO_ROOT / relative).read_bytes())\n439\t    (engine / SYNTHETIC_DOMAIN_SCHEMA_RELATIVE).write_text(\n440\t        json.dumps(SYNTHETIC_DOMAIN_SCHEMA, indent=2), encoding=\"utf-8\"\n441\t    )\n442\t    labs = [\n443\t        {\n444\t            \"id\": f\"U{index:03d}\",\n445\t            \"title\": f\"synthetic unit {index}\",\n446\t            \"sequence\": {\"prerequisites\": [f\"U{index - 1:03d}\"] if index > 1 else [], \"prepares_for\": []},\n447\t            \"required_explanation\": [f\"fact {index}\"],\n448\t            \"safety_focus\": [\"care\"],\n449\t        }\n450\t        for index in range(1, units + 1)\n451\t    ]\n452\t    manifest = curriculum / \"synthetic_curriculum.v1.yaml\"\n453\t    manifest.write_text(\n454\t        yaml.safe_dump(\n455\t            {\"domain\": {\"manifest_schema\": SYNTHETIC_DOMAIN_SCHEMA_RELATIVE}, \"labs\": labs}, sort_keys=False\n456\t        ),\n457\t        encoding=\"utf-8\",\n458\t    )\n459\t    output_root = tmp_path / \"out\"\n460\t    output_root.mkdir()\n461\t    sandbox = Path(tempfile.mkdtemp(prefix=\"plan26-n50-sandbox-\"))\n462\t    return {\n463\t        \"engine\": engine, \"curriculum\": curriculum, \"manifest\": manifest,\n464\t        \"output_root\": output_root, \"sandbox\": sandbox,\n465\t    }\n466\t\n467\t\n468\tdef _prepare_episode(fixture: dict[str, Any], *, mode: str = \"one\", requested: str | None = \"U001\"):\n469\t    lock = P.ExecutionLock(fixture[\"output_root\"])\n470\t    lock.acquire()\n471\t    seed = {\n472\t        \"engine_root\": str(fixture[\"engine\"]),\n473\t        \"curriculum_root\": str(fixture[\"curriculum\"]),\n474\t        \"active_manifest_path\": str(fixture[\"manifest\"]),\n475\t        \"output_root\": str(fixture[\"output_root\"]),\n476\t        \"created_at\": \"2026-01-01T00:00:00Z\",\n477\t        \"contract_version\": \"1\",\n478\t        \"mode\": mode,\n479\t        \"requested_unit_id\": requested,\n480\t    }\n481\t    invocation = P.prepare_episode_invocation(output_root=fixture[\"output_root\"], lock=lock, identity_seed=seed)\n482\t    envelope: dict[str, Any] = {\n483\t        \"kind\": \"fresh\",\n484\t        \"contract_version\": \"1\",\n485\t        \"engine_root\": str(fixture[\"engine\"]),\n486\t        \"curriculum_root\": str(fixture[\"curriculum\"]),\n487\t        \"output_root\": str(fixture[\"output_root\"]),\n488\t        \"mode\": mode,\n489\t        \"requested_unit_id\": requested,\n490\t        \"authorization\": {\"scope\": \"test\", \"executables\": []},\n491\t        \"episode_ordinal\": 1,\n492\t        \"prior_identity\": None,\n493\t        \"prior_terminal\": None,\n494\t        \"lease_open\": False,\n495\t    }\n496\t    probe = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n497\t    digest = inputs.D01_VALIDATE_AND_FREEZE_INPUTS({\"invocation\": envelope}, probe)[\"frozen_digest\"]\n498\t    envelope[\"authorization\"] = {\"scope\": \"test\", \"executables\": [], \"curriculum_digest\": digest}\n499\t    return lock, invocation, envelope\n500\t\n501\t\n502\tdef _run_episode(monkeypatch: Any, fixture: dict[str, Any], *, interrupt_after: str | None = None) -> dict[str, Any]:\n503\t    lock, invocation, envelope = _prepare_episode(fixture)\n504\t    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n505\t    monkeypatch.setattr(\n506\t        G, \"build_model_node_context\", lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"])\n507\t    )\n508\t    compiled = G.build_curriculum_factory_graph(engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"])\n509\t\n510\t    trace: list[str] = []\n511\t    updates: list[tuple[str, dict[str, Any]]] = []\n512\t    deferred_frontier: str | None = None\n513\t    try:\n514\t        for chunk in compiled.stream(\n515\t            {\"invocation\": envelope}, config=invocation.config, stream_mode=\"updates\", context=context\n516\t        ):\n517\t            for node_id, update in chunk.items():\n518\t                trace.append(node_id)\n519\t                updates.append((node_id, dict(update or {})))"}]},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"441bb24b-92ae-4048-bc8e-b27f1979379f","timestamp":"2026-08-12T21:33:50.731Z","tool_use_result":{"type":"text","file":{"filePath":"tests/runtime/test_plan26_adversarial.py","content":"\n\nclass _Context:\n    \"\"\"The narrow deterministic-node service surface (mirrors N30's `_Context`).\"\"\"\n\n    def __init__(self, **services: Any) -> None:\n        self.engine_root = services.pop(\"engine_root\", Path(\"/tmp\"))\n        self.output_root = services.pop(\"output_root\", Path(\"/tmp/out\"))\n        self.path_guard = object()\n        self.evidence_service = object()\n        self.transport_registry = services.pop(\"transport_registry\", object())\n        self.source_retriever = services.pop(\"source_retriever\", None)\n        self.signal_token = services.pop(\"signal_token\", _Token())\n        self.clock = services.pop(\"clock\", lambda: \"2026-01-01T00:00:00Z\")\n\n\ndef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n\n    merged = dict(state)\n    for field, value in update.items():\n        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n    return merged\n\n\ndef _tree_snapshot(root: Path, *, skip_control: bool = True) -> dict[str, tuple[int, str]]:\n    out: dict[str, tuple[int, str]] = {}\n    for path in sorted(root.rglob(\"*\")):\n        if not path.is_file():\n            continue\n        relative = path.relative_to(root).as_posix()\n        if skip_control and relative.startswith(f\"{P.LANGGRAPH_DIRNAME}/\"):\n            continue\n        out[relative] = (path.stat().st_mtime_ns, hashlib.sha256(path.read_bytes()).hexdigest())\n    return out\n\n\ndef _run_child(script: str, *args: str) -> subprocess.CompletedProcess:\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".py\", delete=False) as handle:\n        handle.write(textwrap.dedent(script))\n        child_path = handle.name\n    try:\n        return subprocess.run(\n            [sys.executable, child_path, str(REPO_ROOT), *args],\n            capture_output=True,\n            text=True,\n            timeout=180,\n        )\n    finally:\n        os.unlink(child_path)\n\n\nPERSISTENCE_IDENTITY_SEED = {\n    \"contract_version\": \"plan26.v1\",\n    \"created_at\": \"2026-08-11T00:00:00Z\",\n    \"engine_root\": \"/engine\",\n    \"curriculum_root\": \"/curriculum\",\n    \"active_manifest_path\": \"/curriculum/manifest.yaml\",\n    \"output_root\": \"/output\",\n    \"mode\": \"one\",\n    \"requested_unit_id\": \"U01\",\n}\n\n\nclass _LinearState(TypedDict, total=False):\n    seen: Annotated[list, operator.add]\n\n\n# ===========================================================================\n# full-episode harness (rows 23, 24, 26): one real compiled graph, a\n# test-only scripted transport. Adapted from N30's own harness\n# (`test_plan26_unit_graph.py`), duplicated here rather than imported so this\n# file stays self-contained per the suite's per-file convention.\n# ===========================================================================\n\n\nclass _StubRegistry:\n    def __init__(self, sandbox: Path) -> None:\n        self.sandbox = sandbox\n        self.rendered_units: list[str] = []\n        self.inspected: list[str] = []\n\n    def prove_capability(self, capability: str) -> dict[str, Any]:\n        return {\"result\": \"PASS\", \"capability\": capability, \"detail\": \"test double\"}\n\n    def observe_executable(self, name: str) -> dict[str, Any]:\n        return {\"name\": name, \"path\": f\"/usr/bin/{name}\", \"sha256\": \"0\" * 64}\n\n    def render_deterministic_visual(self, brief: Any, permitted_facts: Any) -> dict[str, Any]:\n        path = self.sandbox / \"visuals\" / (str(brief[\"key\"]).replace(\"/\", \"_\") + \".svg\")\n        path.parent.mkdir(parents=True, exist_ok=True)\n        body = f\"<svg data-key='{brief['key']}'/>\".encode()\n        path.write_bytes(body)\n        return {\"asset_path\": str(path), \"sha256\": hashlib.sha256(body).hexdigest(), \"format\": \"svg\"}\n\n    def render_unit(self, unit_id: str, parents: Any) -> dict[str, Any]:\n        self.rendered_units.append(unit_id)\n        directory = self.sandbox / \"render\"\n        directory.mkdir(parents=True, exist_ok=True)\n        body = json.dumps({\"unit\": unit_id, \"parents\": parents}, sort_keys=True).encode()\n        pdf, layout = directory / f\"{unit_id}.pdf\", directory / f\"{unit_id}.layout.json\"\n        pdf.write_bytes(body)\n        layout.write_bytes(body)\n        digest = hashlib.sha256(body).hexdigest()\n        return {\n            \"layout_path\": str(layout),\n            \"layout_sha256\": digest,\n            \"pdf_path\": str(pdf),\n            \"pdf_sha256\": digest,\n            \"renderer\": \"test_double_renderer\",\n            \"attempt\": 1,\n        }\n\n    def inspect_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n        self.inspected.append(pdf_sha256)\n        pages = []\n        for number in (1, 2):\n            image = self.sandbox / \"pages\" / f\"{Path(pdf_path).stem}-{number}.png\"\n            image.parent.mkdir(parents=True, exist_ok=True)\n            body = f\"page-{number}-{pdf_sha256}\".encode()\n            image.write_bytes(body)\n            pages.append(\n                {\n                    \"number\": number,\n                    \"page_sha256\": hashlib.sha256(body).hexdigest(),\n                    \"image_path\": str(image),\n                    \"problems\": [],\n                    \"unreadable\": False,\n                }\n            )\n        return {\"pages\": pages}\n\n\nclass _StubRetriever:\n    def __init__(self) -> None:\n        self.fetched: list[str] = []\n\n    def fetch(self, locator: Any, authorization: Any, scope: Any) -> dict[str, Any]:\n        self.fetched.append(str(locator))\n        body = json.dumps({\"locator\": locator, \"scope\": scope}, sort_keys=True).encode()\n        return {\n            \"locator\": locator,\n            \"sha256\": hashlib.sha256(body).hexdigest(),\n            \"status\": 200,\n            \"content_type\": \"text/html\",\n            \"tls\": {\"verified\": True},\n            \"bytes_path\": None,\n        }\n\n\nclass _SwitchableToken:\n    def __init__(self, trip_after: str | None = None) -> None:\n        self.trip_after = trip_after\n        self.tripped = False\n        self.observed: list[str] = []\n\n    def trip(self) -> None:\n        self.tripped = True\n\n    def is_set(self) -> bool:\n        return self.tripped\n\n\nclass _HarnessContext:\n    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n\n    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n        self.engine_root = engine_root\n        self.output_root = output_root\n        self.path_guard = ArtifactStore(output_root)\n        self.evidence_service = EvidenceStore(output_root)\n        self.transport_registry = _StubRegistry(sandbox)\n        self.source_retriever = _StubRetriever()\n        self.signal_token = _SwitchableToken()\n        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n\n\nclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:\n        super().__init__(sandbox_root=sandbox_root, responses={}, registry=registry)\n        self.calls: list[tuple[str, str]] = []\n\n    def execute(self, *, job_id: str, activation_id: str, projection: Any = None, **kwargs: Any):\n        projection = dict(projection or {})\n        self.calls.append((job_id, activation_id))\n        self.responses[job_id] = _scripted_candidate(job_id, projection)\n        return super().execute(\n            job_id=job_id, activation_id=activation_id, projection=projection, **kwargs\n        )\n\n\nDECLARED_VISUALS: list[dict[str, Any]] = [\n    {\"role\": \"build_map\", \"kind\": \"schematic\", \"authoritative\": True, \"permitted_facts\": [\"fact-a\"]},\n    {\"role\": \"overview\", \"kind\": \"diagram\", \"authoritative\": False, \"permitted_facts\": [\"fact-b\"]},\n]\n\n\ndef _scripted_candidate(job_id: str, projection: dict[str, Any]) -> dict[str, Any]:\n    if job_id == \"M01_RESEARCH_UNIT_SOURCES\":\n        request_id = projection[\"request\"].get(\"request_id\")\n        group = projection.get(\"retrieval_group\")\n        if group is None:\n            return {\n                \"locators\": [\n                    {\n                        \"request_id\": request_id,\n                        \"url\": f\"https://example.invalid/{request_id}\",\n                        \"title\": \"scripted source\",\n                        \"publisher\": \"scripted publisher\",\n                        \"locator_kind\": \"primary\",\n                        \"rationale\": \"scripted rationale\",\n                    }\n                ]\n            }\n        return {\n            \"interpretations\": [\n                {\n                    \"request_id\": request_id,\n                    \"retrieval_id\": str(record.get(\"retrieval_id\")),\n                    \"claims\": [\n                        {\"claim_text\": \"scripted claim\", \"source_quote\": \"scripted quote\", \"source_location\": \"p.1\"}\n                    ],\n                    \"limitations\": [],\n                }\n                for record in group.get(\"retrieved_records\", [])\n            ]\n        }\n    if job_id == \"M02_CREATE_UNIT_DOMAIN_DATA\":\n        unit_id = projection[\"unit\"].get(\"unit_id\")\n        admitted = projection.get(\"admitted_sources\") or []\n        facts = [\n            {\"fact_id\": str(source.get(\"fact_id\")), \"statement\": f\"scripted statement for {source.get('fact_id')}\"}\n            for source in admitted\n        ] or [{\"fact_id\": \"required_explanation:000\", \"statement\": \"scripted statement\"}]\n        return {\n            \"domain_version\": {\n                \"unit_id\": unit_id,\n                \"fields\": {\"unit_id\": unit_id, \"facts\": facts, \"verifier_result\": {\"result\": \"all_fixtures_behaved\"}},\n                \"evidence_references\": [\n                    {\"source_id\": str(source.get(\"source_id\") or source.get(\"key\") or \"s1\"), \"source_location\": \"p.1\"}\n                    for source in admitted\n                ]\n                or [{\"source_id\": \"s1\", \"source_location\": \"p.1\"}],\n            }\n        }\n    if job_id == \"M03_WRITE_UNIT_CONTENT\":\n        admitted_domain = projection.get(\"admitted_domain\") or {}\n        unit_id = str(admitted_domain.get(\"unit_id\") or projection[\"unit\"].get(\"unit_id\"))\n        admissible = projection.get(\"admitted_evidence_references\") or []\n        return {\n            \"unit_content\": {\n                \"unit_id\": unit_id,\n                \"sections\": [\n                    {\"section_id\": f\"s{index:03d}\", \"heading\": f\"scripted heading {index}\",\n                     \"body\": f\"scripted body for {reference.get('fact_id')}\"}\n                    for index, reference in enumerate(admissible, start=1)\n                ],\n                \"evidence_references\": [\n                    {\"section_id\": f\"s{index:03d}\", \"source_id\": str(reference.get(\"source_id\")),\n                     \"source_location\": \"p.1\"}\n                    for index, reference in enumerate(admissible, start=1)\n                ],\n                \"visuals\": DECLARED_VISUALS,\n            }\n        }\n    if job_id == \"M04_CREATE_UNIT_VISUALS\":\n        brief_id = str(projection[\"brief\"].get(\"brief_id\") or projection[\"brief\"].get(\"key\"))\n        return {\n            \"visual_candidate\": {\n                \"brief_id\": brief_id, \"prompt_text\": f\"scripted prompt for {brief_id}\",\n                \"dimensions\": {\"width_px\": 1024, \"height_px\": 768}, \"image_format\": \"png\",\n                \"accessibility_text\": f\"scripted alt text for {brief_id}\",\n            },\n            \"provenance_declaration\": {\n                \"brief_id\": brief_id,\n                \"permitted_facts_used\": [str(fact) for fact in (projection.get(\"permitted_facts\") or [])],\n                \"asserts_authoritative_detail\": False,\n            },\n        }\n    if job_id == \"M05_REVIEW_ACTUAL_UNIT\":\n        pages = projection.get(\"pages\") or []\n        return {\n            \"overall_findings\": [],\n            \"page_findings\": [\n                {\"page_number\": int(page[\"page_number\"]), \"page_sha256\": str(page[\"page_sha256\"]), \"findings\": []}\n                for page in pages\n            ],\n        }\n    raise AssertionError(f\"no scripted candidate for {job_id}\")\n\n\ndef _scripted_model_context(sandbox: Path) -> Any:\n    routes = mn.tp.load_job_registry()\n    return mn.ModelNodeContext(transport=_ScriptedFakeTransport(sandbox_root=sandbox, registry=routes), registry=routes)\n\n\nENGINE_CONTRACTS: tuple[str, ...] = (\n    \"schemas/manifest_domain.metaschema.v1.json\",\n    \"policy/calibration.v1.yaml\",\n    \"meta_prompt/assets/pedagogy.v1.md\",\n    *domain.CURRICULUM_CONTRACTS,\n)\n\nSYNTHETIC_DOMAIN_SCHEMA_RELATIVE = \"schemas/synthetic_domain.v1.json\"\nSYNTHETIC_DOMAIN_SCHEMA: dict[str, Any] = {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"$id\": \"plan26/test/synthetic_domain.v1.json\",\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"unit_id\", \"facts\", \"verifier_result\"],\n    \"properties\": {\n        \"unit_id\": {\"type\": \"string\", \"minLength\": 1},\n        \"facts\": {\n            \"type\": \"array\", \"minItems\": 1,\n            \"items\": {\n                \"type\": \"object\", \"additionalProperties\": False,\n                \"required\": [\"fact_id\", \"statement\"],\n                \"properties\": {\"fact_id\": {\"type\": \"string\", \"minLength\": 1}, \"statement\": {\"type\": \"string\", \"minLength\": 1}},\n            },\n        },\n        \"verifier_result\": {\n            \"type\": \"object\", \"additionalProperties\": True, \"required\": [\"result\"],\n            \"properties\": {\"result\": {\"type\": \"string\"}},\n        },\n    },\n}\n\n\ndef _build_episode_fixture(tmp_path: Path, units: int = 1) -> dict[str, Any]:\n    engine = tmp_path / \"engine\"\n    curriculum = engine / \"curricula\" / \"synthetic\"\n    curriculum.mkdir(parents=True)\n    for name in (\"schemas\", \"policy\", \"meta_prompt\"):\n        (engine / name).mkdir()\n    (engine / \"schemas\" / \"placeholder.json\").write_text(\"{}\", encoding=\"utf-8\")\n    for relative in ENGINE_CONTRACTS:\n        target = engine / relative\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_bytes((REPO_ROOT / relative).read_bytes())\n    (engine / SYNTHETIC_DOMAIN_SCHEMA_RELATIVE).write_text(\n        json.dumps(SYNTHETIC_DOMAIN_SCHEMA, indent=2), encoding=\"utf-8\"\n    )\n    labs = [\n        {\n            \"id\": f\"U{index:03d}\",\n            \"title\": f\"synthetic unit {index}\",\n            \"sequence\": {\"prerequisites\": [f\"U{index - 1:03d}\"] if index > 1 else [], \"prepares_for\": []},\n            \"required_explanation\": [f\"fact {index}\"],\n            \"safety_focus\": [\"care\"],\n        }\n        for index in range(1, units + 1)\n    ]\n    manifest = curriculum / \"synthetic_curriculum.v1.yaml\"\n    manifest.write_text(\n        yaml.safe_dump(\n            {\"domain\": {\"manifest_schema\": SYNTHETIC_DOMAIN_SCHEMA_RELATIVE}, \"labs\": labs}, sort_keys=False\n        ),\n        encoding=\"utf-8\",\n    )\n    output_root = tmp_path / \"out\"\n    output_root.mkdir()\n    sandbox = Path(tempfile.mkdtemp(prefix=\"plan26-n50-sandbox-\"))\n    return {\n        \"engine\": engine, \"curriculum\": curriculum, \"manifest\": manifest,\n        \"output_root\": output_root, \"sandbox\": sandbox,\n    }\n\n\ndef _prepare_episode(fixture: dict[str, Any], *, mode: str = \"one\", requested: str | None = \"U001\"):\n    lock = P.ExecutionLock(fixture[\"output_root\"])\n    lock.acquire()\n    seed = {\n        \"engine_root\": str(fixture[\"engine\"]),\n        \"curriculum_root\": str(fixture[\"curriculum\"]),\n        \"active_manifest_path\": str(fixture[\"manifest\"]),\n        \"output_root\": str(fixture[\"output_root\"]),\n        \"created_at\": \"2026-01-01T00:00:00Z\",\n        \"contract_version\": \"1\",\n        \"mode\": mode,\n        \"requested_unit_id\": requested,\n    }\n    invocation = P.prepare_episode_invocation(output_root=fixture[\"output_root\"], lock=lock, identity_seed=seed)\n    envelope: dict[str, Any] = {\n        \"kind\": \"fresh\",\n        \"contract_version\": \"1\",\n        \"engine_root\": str(fixture[\"engine\"]),\n        \"curriculum_root\": str(fixture[\"curriculum\"]),\n        \"output_root\": str(fixture[\"output_root\"]),\n        \"mode\": mode,\n        \"requested_unit_id\": requested,\n        \"authorization\": {\"scope\": \"test\", \"executables\": []},\n        \"episode_ordinal\": 1,\n        \"prior_identity\": None,\n        \"prior_terminal\": None,\n        \"lease_open\": False,\n    }\n    probe = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    digest = inputs.D01_VALIDATE_AND_FREEZE_INPUTS({\"invocation\": envelope}, probe)[\"frozen_digest\"]\n    envelope[\"authorization\"] = {\"scope\": \"test\", \"executables\": [], \"curriculum_digest\": digest}\n    return lock, invocation, envelope\n\n\ndef _run_episode(monkeypatch: Any, fixture: dict[str, Any], *, interrupt_after: str | None = None) -> dict[str, Any]:\n    lock, invocation, envelope = _prepare_episode(fixture)\n    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    monkeypatch.setattr(\n        G, \"build_model_node_context\", lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"])\n    )\n    compiled = G.build_curriculum_factory_graph(engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"])\n\n    trace: list[str] = []\n    updates: list[tuple[str, dict[str, Any]]] = []\n    deferred_frontier: str | None = None\n    try:\n        for chunk in compiled.stream(\n            {\"invocation\": envelope}, config=invocation.config, stream_mode=\"updates\", context=context\n        ):\n            for node_id, update in chunk.items():\n                trace.append(node_id)\n                updates.append((node_id, dict(update or {})))","numLines":420,"startLine":100,"totalLines":1856}}}
