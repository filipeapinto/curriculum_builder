e, dict)\n    assert failure[\"node\"] == \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\"\n    assert \"pdf hash\" in failure[\"message\"]\n    assert trace[-1] == \"D98_WRITE_TERMINAL\"\n    terminal_record = dict(next(update for node_id, update in updates if node_id == \"D98_WRITE_TERMINAL\"))\n    assert terminal_record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\""},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":521,"cache_read_input_tokens":225627,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":521},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"5efc7fa2-9c51-48ae-82cb-02fa348f8bb4","timestamp":"2026-08-12T21:43:37.913Z","request_id":"req_011CdyappaG9mZ6M5y2aBjwD"}
