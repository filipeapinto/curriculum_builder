{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G73okciUhpdtLgasiqWWPH","type":"tool_result","content":"1825\tdef test_the_unobservable_boundary_is_excluded_for_a_stated_reason(\n1826\t    tmp_path: Path, monkeypatch\n1827\t) -> None:\n1828\t    \"\"\"M05 is left out of the crash matrix because it cannot be observed, not\n1829\t    because it is inconvenient.\n1830\t\n1831\t    M05 really executes — the committed state holds its execution receipt, its\n1832\t    candidate record and its page findings — but the branch that would emit its\n1833\t    update resolves to the deferred `D16_REDUCE_UNIT_EVIDENCE` and aborts the\n1834\t    superstep, so no stream consumer ever sees it. Both halves are asserted, so\n1835\t    the exclusion stops being true (and this test fails) the moment the path\n1836\t    extends past M05, exactly as it did when the frontier was D09.\n1837\t\n1838\t    Deliberately still pinned to `D16_REDUCE_UNIT_EVIDENCE` rather than a\n1839\t    derived frontier (unlike its sibling tests fixed under P-N30-001, closing\n1840\t    N90 finding F1): this test's whole premise is that M05 specifically is\n1841\t    unobservable *because* today's M05->D16 edge is the one that is deferred.\n1842\t    Once N31 wires D16-D23 that premise inverts — M05's own update becomes\n1843\t    observable and belongs in `REACHABLE_BOUNDARIES` instead — so this test is\n1844\t    expected to start failing at that point, and rewriting it then is N31's\n1845\t    (or whichever generation wires D16) to do, not a fixture to route around\n1846\t    now. See `results/N30_UNIT_GRAPH.result.v1.md` for this call.\n1847\t    \"\"\"\n1848\t\n1849\t    assert UNOBSERVABLE_BOUNDARY not in REACHABLE_BOUNDARIES\n1850\t\n1851\t    fixture = _build_episode_fixture(tmp_path)\n1852\t    result = _run_episode(monkeypatch, fixture)\n1853\t    state = result[\"state\"]\n1854\t\n1855\t    assert UNOBSERVABLE_BOUNDARY not in result[\"trace\"]\n1856\t    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n1857\t\n1858\t    # It ran, though: the receipt, the candidate and the review are all committed.\n1859\t    assert [\n1860\t        receipt[\"job_id\"] for receipt in state[\"model_execution_receipts\"]\n1861\t    ].count(UNOBSERVABLE_BOUNDARY) == 1\n1862\t    review_record = state[\"unit_reviews\"][0]\n1863\t    assert review_record[\"job_id\"] == UNOBSERVABLE_BOUNDARY\n1864\t    assert review_record[\"pre_admission\"] is True\n1865\t\n1866\t    # And every other boundary the path reaches is in the matrix, so the\n1867\t    # exclusion is exactly one node rather than a convenient shortfall.\n1868\t    executed = [node_id for node_id in result[\"trace\"] if node_id not in (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\")]\n1869\t    assert set(executed) <= set(REACHABLE_BOUNDARIES)\n1870\t    assert set(REACHABLE_BOUNDARIES) <= set(executed)\n1871\t\n1872\t\n1873\tdef test_a_hard_crash_is_recovered_as_an_orphan_without_continuing_its_thread(\n1874\t    tmp_path: Path, monkeypatch"}]},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"c4c3b26c-2bfb-4ace-9dec-e145c6fba3b4","timestamp":"2026-08-12T21:32:04.952Z","tool_use_result":{"type":"text","file":{"filePath":"tests/runtime/test_plan26_unit_graph.py","content":"def test_the_unobservable_boundary_is_excluded_for_a_stated_reason(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"M05 is left out of the crash matrix because it cannot be observed, not\n    because it is inconvenient.\n\n    M05 really executes — the committed state holds its execution receipt, its\n    candidate record and its page findings — but the branch that would emit its\n    update resolves to the deferred `D16_REDUCE_UNIT_EVIDENCE` and aborts the\n    superstep, so no stream consumer ever sees it. Both halves are asserted, so\n    the exclusion stops being true (and this test fails) the moment the path\n    extends past M05, exactly as it did when the frontier was D09.\n\n    Deliberately still pinned to `D16_REDUCE_UNIT_EVIDENCE` rather than a\n    derived frontier (unlike its sibling tests fixed under P-N30-001, closing\n    N90 finding F1): this test's whole premise is that M05 specifically is\n    unobservable *because* today's M05->D16 edge is the one that is deferred.\n    Once N31 wires D16-D23 that premise inverts — M05's own update becomes\n    observable and belongs in `REACHABLE_BOUNDARIES` instead — so this test is\n    expected to start failing at that point, and rewriting it then is N31's\n    (or whichever generation wires D16) to do, not a fixture to route around\n    now. See `results/N30_UNIT_GRAPH.result.v1.md` for this call.\n    \"\"\"\n\n    assert UNOBSERVABLE_BOUNDARY not in REACHABLE_BOUNDARIES\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    state = result[\"state\"]\n\n    assert UNOBSERVABLE_BOUNDARY not in result[\"trace\"]\n    assert result[\"deferred_frontier\"] == \"D16_REDUCE_UNIT_EVIDENCE\"\n\n    # It ran, though: the receipt, the candidate and the review are all committed.\n    assert [\n        receipt[\"job_id\"] for receipt in state[\"model_execution_receipts\"]\n    ].count(UNOBSERVABLE_BOUNDARY) == 1\n    review_record = state[\"unit_reviews\"][0]\n    assert review_record[\"job_id\"] == UNOBSERVABLE_BOUNDARY\n    assert review_record[\"pre_admission\"] is True\n\n    # And every other boundary the path reaches is in the matrix, so the\n    # exclusion is exactly one node rather than a convenient shortfall.\n    executed = [node_id for node_id in result[\"trace\"] if node_id not in (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\")]\n    assert set(executed) <= set(REACHABLE_BOUNDARIES)\n    assert set(REACHABLE_BOUNDARIES) <= set(executed)\n\n\ndef test_a_hard_crash_is_recovered_as_an_orphan_without_continuing_its_thread(\n    tmp_path: Path, monkeypatch","numLines":50,"startLine":1825,"totalLines":2693}}}
