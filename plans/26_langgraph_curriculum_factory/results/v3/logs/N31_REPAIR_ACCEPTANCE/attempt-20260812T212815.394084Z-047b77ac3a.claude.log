{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cdya9R73GuNx4xAvw44Hr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PhB2kLC6A5g4YntnqggvUG","name":"Read","input":{"file_path":"runtime/langgraph_factory/repair.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2399,"cache_read_input_tokens":119954,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2399},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"b1a699f4-a560-443d-9ba5-ed4cbb8e3ed0","timestamp":"2026-08-12T21:34:36.757Z","request_id":"req_011Cdya9NtM42Gxo2o8wfMNE"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PhB2kLC6A5g4YntnqggvUG","type":"tool_result","content":"1\t\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n2\t\n3\tOwns finding classification, one-partition-member repair planning, deterministic\n4\tvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\n5\tunit repair cycle here and reused by the workbook repair cycle N32 builds over\n6\t`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\n7\tmachinery is one engine, not a per-caller copy).\n8\t\n9\tNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\n10\tregistered as graph nodes yet (that registration is N32's write, once\n11\t`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\n12\tscoped `(state, runtime_context) -> update` callables in the same shape N23's\n13\t`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n14\t`nodes.deterministic_node()`. A future registration step binds them to their\n15\tcatalogue rows without changing this module.\n16\t\n17\tEvery finding this engine classifies is normalized to spec section 12's\n18\t`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\n19\tOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n20\t(code-owned), and a model review's own `category` field is deliberately never\n21\tread as an owner -- `owner_for_review_category()` is the one place a category\n22\tstring is mapped to the five-owner vocabulary, and an unmapped category is a\n23\tsystem fault, not a silent guess.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport json\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom typing import Any\n31\t\n32\tfrom .nodes import (\n33\t    SystemFailure,\n34\t    candidate_payload,\n35\t    canonical_digest,\n36\t    latest_model_candidate,\n37\t    require,\n38\t    staged_dispatch,\n39\t    stream_id,\n40\t    worker_packet,\n41\t)\n42\tfrom .reducers import UNIT_STATUS_TRANSITIONS\n43\t\n44\t__all__ = [\n45\t    \"REPAIR_OWNERS\",\n46\t    \"CHANNEL_BY_OWNER\",\n47\t    \"MODEL_ONLY_OWNERS\",\n48\t    \"DETERMINISTIC_ONLY_OWNERS\",\n49\t    \"CONDITIONAL_OWNERS\",\n50\t    \"RETEST_FIRST_NODE\",\n51\t    \"RETEST_ORDER_BY_OWNER\",\n52\t    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n53\t    \"MAX_FINGERPRINT_REPEATS\",\n54\t    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n55\t    \"RepairEngineError\",\n56\t    \"owner_for_review_category\",\n57\t    \"normalize_findings\",\n58\t    \"finding_fingerprint\",\n59\t    \"route_owner\",\n60\t    \"json_pointer_diff\",\n61\t    \"within_boundary\",\n62\t    \"D17_CLASSIFY_UNIT_FINDINGS\",\n63\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n64\t    \"D19_ROUTE_UNIT_REPAIR\",\n65\t    \"D20_ADMIT_UNIT_REPAIR\",\n66\t    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n67\t]\n68\t\n69\t\n70\tclass RepairEngineError(SystemFailure):\n71\t    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n72\t\n73\t\n74\t# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n75\t# this set is a legal `owner`; a finding naming anything else fails closed.\n76\tREPAIR_OWNERS: tuple[str, ...] = (\n77\t    \"source interpretation\",\n78\t    \"curriculum domain\",\n79\t    \"unit content\",\n80\t    \"unit visual\",\n81\t    \"unit layout\",\n82\t)\n83\t\n84\t# The artifact-versions channel each owner's repair targets. Source\n85\t# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n86\t# is a pointer inside the same admitted domain body a curriculum-domain defect\n87\t# would touch, differing only in which pointers are named and in dispatch\n88\t# eligibility below.\n89\tCHANNEL_BY_OWNER: Mapping[str, str] = {\n90\t    \"curriculum domain\": \"domain\",\n91\t    \"source interpretation\": \"domain\",\n92\t    \"unit content\": \"content\",\n93\t    \"unit visual\": \"visuals\",\n94\t    \"unit layout\": \"layout\",\n95\t}\n96\t\n97\t# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n98\t# table. A curriculum-domain or unit-content defect is model-owned outright.\n99\t# Layout has a deterministic renderer/template repair path and no model path in\n100\t# this generation, so it is always deterministic. Source interpretation could\n101\t# legally refetch deterministically when a locator remains authorized; this\n102\t# generation always routes it to M06 rather than re-implementing a fetcher here\n103\t# (repair.py owns the routing table, not a second source-retrieval stack), and\n104\t# that choice is exactly the one spec section 12 leaves open (\"M06 repairs only\n105\t# the named interpretation ... admission is code-owned\"). Unit visual is the one\n106\t# genuinely conditional row: an authoritative/library visual is always\n107\t# rerun deterministically (a model may never assert authoritative circuit/pin\n108\t# detail per spec section 13), and a non-authoritative asset is model-eligible.\n109\tMODEL_ONLY_OWNERS: frozenset[str] = frozenset(\n110\t    {\"curriculum domain\", \"unit content\", \"source interpretation\"}\n111\t)\n112\tDETERMINISTIC_ONLY_OWNERS: frozenset[str] = frozenset({\"unit layout\"})\n113\tCONDITIONAL_OWNERS: frozenset[str] = frozenset({\"unit visual\"})\n114\t\n115\t# The first deterministic node of each owner's fixed retest chain (spec section\n116\t# 12's table). Every value here is a real `RESUME_REENTRY_DESTINATIONS` member\n117\t# of `unit_graph.py`; the remaining steps of a chain are not dispatched by D21 at\n118\t# all -- they are the already-wired unit-path edges the first node's own success\n119\t# guard reaches on its own (D07 -> D08 -> D09 -> D10 -> ... -> D16).\n120\tRETEST_FIRST_NODE: Mapping[str, str] = {\n121\t    \"source interpretation\": \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n122\t    \"curriculum domain\": \"D08_VALIDATE_DOMAIN\",\n123\t    \"unit content\": \"D09_VALIDATE_CONTENT\",\n124\t    \"unit visual\": \"D10_COMPILE_VISUAL_BRIEFS\",\n125\t    \"unit layout\": \"D13_RENDER_UNIT\",\n126\t}\n127\t\n128\tRETEST_ORDER_BY_OWNER: Mapping[str, tuple[str, ...]] = {\n129\t    \"source interpretation\": (\n130\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\", \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\",\n131\t        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n132\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n133\t    ),\n134\t    \"curriculum domain\": (\n135\t        \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\",\n136\t        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n137\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n138\t    ),\n139\t    \"unit content\": (\n140\t        \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\",\n141\t        \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n142\t        \"D16_REDUCE_UNIT_EVIDENCE\",\n143\t    ),\n144\t    \"unit visual\": (\n145\t        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n146\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n147\t    ),\n148\t    \"unit layout\": (\n149\t        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n150\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n151\t    ),\n152\t}\n153\t\n154\t# Frozen limits (spec section 12): three repair children per owner/finding\n155\t# chain, two occurrences of the same fingerprint. The earliest reached bound\n156\t# controls -- `D18_PLAN_TARGETED_UNIT_REPAIR` checks both and never dispatches\n157\t# a fourth child or a third repeat of the same defect.\n158\tMAX_REPAIR_CHILDREN_PER_CHAIN = 3\n159\tMAX_FINGERPRINT_REPEATS = 2\n160\t\n161\t# A model review's own `category` vocabulary is never trusted directly; this is\n162\t# the one code-owned mapping from a reviewer's free-text category to the fixed\n163\t# five-owner vocabulary. Substring match on a normalized (lowercased) category\n164\t# keeps the rubric free to phrase categories in prose while still refusing an\n165\t# unmapped one rather than guessing.\n166\t_REVIEW_CATEGORY_OWNER_KEYWORDS: tuple[tuple[str, str], ...] = (\n167\t    (\"source\", \"source interpretation\"),\n168\t    (\"citation\", \"source interpretation\"),\n169\t    (\"domain\", \"curriculum domain\"),\n170\t    (\"fact\", \"curriculum domain\"),\n171\t    (\"content\", \"unit content\"),\n172\t    (\"prose\", \"unit content\"),\n173\t    (\"pedagog\", \"unit content\"),\n174\t    (\"readab\", \"unit content\"),\n175\t    (\"safety\", \"unit content\"),\n176\t    (\"bloom\", \"unit content\"),\n177\t    (\"visual\", \"unit visual\"),\n178\t    (\"image\", \"unit visual\"),\n179\t    (\"diagram\", \"unit visual\"),\n180\t    (\"layout\", \"unit layout\"),\n181\t    (\"page\", \"unit layout\"),\n182\t    (\"render\", \"unit layout\"),\n183\t)\n184\t\n185\tDETERMINISTIC_REPAIR_CANDIDATE_KIND = \"deterministic_repair_candidate\"\n186\t\n187\t\n188\tdef owner_for_review_category(category: Any) -> str | None:\n189\t    \"\"\"Map one M05 review `category` string to a code-owned owner, or None.\n190\t\n191\t    Never returns the model's own words: the return value is always one member\n192\t    of `REPAIR_OWNERS`, decided by this frozen table, or None when no keyword\n193\t    matches -- which the caller treats as an unknown-owner system fault, not a\n194\t    best guess.\n195\t    \"\"\"\n196\t\n197\t    if not isinstance(category, str) or not category:\n198\t        return None\n199\t    lowered = category.lower()\n200\t    for keyword, owner in _REVIEW_CATEGORY_OWNER_KEYWORDS:\n201\t        if keyword in lowered:\n202\t            return owner\n203\t    return None\n204\t\n205\t\n206\tdef finding_fingerprint(owner: str, boundary: Sequence[str], message: Any) -> str:\n207\t    \"\"\"The stable identity of a defect across repeated repair attempts.\n208\t\n209\t    Keyed on owner, boundary pointers, and message -- not on `finding_id` (which\n210\t    a fresh classification pass may mint differently) and not on attempt number\n211\t    (which must never enter a fingerprint that exists to detect repeated\n212\t    failure across attempts).\n213\t    \"\"\"\n214\t\n215\t    return canonical_digest({\"owner\": owner, \"boundary\": sorted(boundary), \"message\": str(message)})\n216\t\n217\t\n218\tdef normalize_findings(\n219\t    raw_findings: Sequence[Mapping[str, Any]],\n220\t    *,\n221\t    unit_id: str,\n222\t    source_node: str,\n223\t    artifact_heads: Mapping[str, Any],\n224\t) -> list[dict[str, Any]]:\n225\t    \"\"\"Normalize a raw findings list to spec section 12's one shape.\n226\t\n227\t    Fails closed (`SystemFailure`) on any finding with no owner, an owner\n228\t    outside the fixed vocabulary, or a missing pointer -- `D17` never routes a\n229\t    zero- or unknown-owner finding into a partition; it raises before one is\n230\t    built. A caller with only one already-classified finding (the D91\n231\t    model-repair-failure case) still goes through this function, so the same\n232\t    checks apply uniformly.\n233\t    \"\"\"\n234\t\n235\t    normalized: list[dict[str, Any]] = []\n236\t    for raw in raw_findings:\n237\t        if not isinstance(raw, Mapping):\n238\t            raise SystemFailure(\n239\t                \"invalid_input\", \"a finding must be a JSON object\", {\"source_node\": source_node}\n240\t            )\n241\t        owner = raw.get(\"owner\")\n242\t        if owner not in REPAIR_OWNERS:\n243\t            raise SystemFailure(\n244\t                \"invalid_input\",\n245\t                f\"finding declares owner {owner!r}, which is not one of the five known owners\",\n246\t                {\"unit_id\": unit_id, \"source_node\": source_node, \"owner\": owner},\n247\t            )\n248\t        pointer = raw.get(\"pointer\")\n249\t        if not isinstance(pointer, str) or not pointer:\n250\t            raise SystemFailure(\n251\t                \"invalid_input\", \"finding declares no boundary pointer\",\n252\t                {\"unit_id\": unit_id, \"owner\": owner},\n253\t            )\n254\t        channel = CHANNEL_BY_OWNER[owner]\n255\t        parent_head = artifact_heads.get(stream_id(unit_id, channel))\n256\t        parent_hash = parent_head.get(\"hash\") if isinstance(parent_head, Mapping) else None\n257\t        message = raw.get(\"message\", \"\")\n258\t        finding_id = canonical_digest(\n259\t            {\"unit_id\": unit_id, \"owner\": owner, \"pointer\": pointer, \"message\": str(message)}\n260\t        )\n261\t        raw_facts = raw.get(\"allowed_facts\")\n262\t        allowed_facts = dict(raw_facts) if isinstance(raw_facts, Mapping) else {}\n263\t        normalized.append(\n264\t            {\n265\t                \"finding_id\": finding_id,\n266\t                \"evidence_key\": str(raw.get(\"check_id\", source_node)),\n267\t                \"owner\": owner,\n268\t                \"boundary\": pointer,\n269\t                \"parent_hash\": parent_hash,\n270\t                \"fingerprint\": finding_fingerprint(owner, [pointer], message),\n271\t                \"message\": str(message),\n272\t                \"unit_id\": unit_id,\n273\t                \"source_node\": source_node,\n274\t                \"allowed_facts\": allowed_facts,\n275\t            }\n276\t        )\n277\t    return normalized\n278\t\n279\t\n280\tdef route_owner(owner: str, *, state: Mapping[str, Any], findings: Sequence[Mapping[str, Any]]) -> str:\n281\t    \"\"\"Deterministic-vs-model dispatch for one owner's findings (spec section 12).\"\"\"\n282\t\n283\t    if owner in DETERMINISTIC_ONLY_OWNERS:\n284\t        return \"deterministic\"\n285\t    if owner in MODEL_ONLY_OWNERS:\n286\t        return \"model\"\n287\t    if owner not in CONDITIONAL_OWNERS:\n288\t        raise RepairEngineError(\"integrity\", f\"owner {owner!r} has no dispatch rule\", {\"owner\": owner})\n289\t    # unit visual: deterministic only if every named key is an authoritative or\n290\t    # library visual brief; a model may never touch one (spec section 13).\n291\t    briefs = {\n292\t        brief.get(\"key\"): brief\n293\t        for brief in state.get(\"visual_briefs\", [])\n294\t        if isinstance(brief, Mapping)\n295\t    }\n296\t    for finding in findings:\n297\t        key = str(finding.get(\"boundary\", \"\")).strip(\"/\").split(\"/\")[-1]\n298\t        brief = briefs.get(key)\n299\t        authoritative = bool(brief.get(\"authoritative\")) if isinstance(brief, Mapping) else False\n300\t        if not authoritative:\n301\t            return \"model\"\n302\t    return \"deterministic\"\n303\t\n304\t\n305\tdef _escape_token(token: str) -> str:\n306\t    return token.replace(\"~\", \"~0\").replace(\"/\", \"~1\")\n307\t\n308\t\n309\tdef json_pointer_diff(parent: Any, child: Any, path: str = \"\") -> set[str]:\n310\t    \"\"\"Every leaf JSON pointer at which ``parent`` and ``child`` differ.\"\"\"\n311\t\n312\t    if parent == child:\n313\t        return set()\n314\t    if isinstance(parent, Mapping) and isinstance(child, Mapping):\n315\t        diffs: set[str] = set()\n316\t        for key in sorted(set(parent) | set(child)):\n317\t            sub = f\"{path}/{_escape_token(str(key))}\"\n318\t            if key not in parent or key not in child:\n319\t                diffs.add(sub)\n320\t            else:\n321\t                diffs |= json_pointer_diff(parent[key], child[key], sub)\n322\t        return diffs\n323\t    if isinstance(parent, list) and isinstance(child, list):\n324\t        diffs = set()\n325\t        for index in range(max(len(parent), len(child))):\n326\t            sub = f\"{path}/{index}\"\n327\t            if index >= len(parent) or index >= len(child):\n328\t                diffs.add(sub)\n329\t            else:\n330\t                diffs |= json_pointer_diff(parent[index], child[index], sub)\n331\t        return diffs\n332\t    return {path or \"/\"}\n333\t\n334\t\n335\tdef within_boundary(pointer: str, allowed: Sequence[str]) -> bool:\n336\t    \"\"\"Whether ``pointer`` is exactly, or nested under, one declared boundary pointer.\"\"\"\n337\t\n338\t    return any(pointer == allow or pointer.startswith(f\"{allow}/\") for allow in allowed)\n339\t\n340\t\n341\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n342\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n343\t\n344\t\n345\tdef _legal_status_update(state: Mapping[str, Any], unit_id: str, target: str) -> dict[str, Any]:\n346\t    \"\"\"`{\"unit_status\": {unit_id: target}}`, or nothing when that jump is undeclared.\n347\t\n348\t    Mirrors `acceptance._legal_status_update`: a unit reaching D17 straight\n349\t    from D08/D09/D12/D14's repairable guard is still `SELECTED`, and\n350\t    `reducers.UNIT_STATUS_TRANSITIONS` does not declare `SELECTED ->\n351\t    REPAIRING` (no currently-wired producer node emits the intermediate\n352\t    `SOURCING`/`BUILDING` statuses that table assumes). Skipping the write\n353\t    rather than forcing an illegal one keeps this module honest about a gap\n354\t    it does not own.\n355\t    \"\"\"\n356\t\n357\t    current = (state.get(\"unit_status\") or {}).get(unit_id)\n358\t    if current is not None and target not in UNIT_STATUS_TRANSITIONS.get(current, frozenset()):\n359\t        return {}\n360\t    return {\"unit_status\": {unit_id: target}}\n361\t\n362\t\n363\tdef _attempt_key(unit_id: str, owner: str, fingerprint: str) -> str:\n364\t    return f\"repair|{unit_id}|{owner}|{fingerprint}\"\n365\t\n366\t\n367\tdef _repeat_key(unit_id: str, owner: str, fingerprint: str) -> str:\n368\t    return f\"repeat|{unit_id}|{owner}|{fingerprint}\"\n369\t\n370\t\n371\t# --------------------------------------------------------------------------\n372\t# D17_CLASSIFY_UNIT_FINDINGS\n373\t# --------------------------------------------------------------------------\n374\t\n375\t\n376\tdef D17_CLASSIFY_UNIT_FINDINGS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n377\t    \"\"\"Total one-owner partition of the current findings, or honest exhaustion.\n378\t\n379\t    Reads whichever repairable branch reached it: a `pending_guard` carrying a\n380\t    `findings` list from D08/D09/D12/D14/D16, or a `pending_failure` a D91\n381\t    model-repair classification left with no structured findings at all. Every\n382\t    blocking finding appears in exactly one owner's partition entry; an\n383\t    unowned or cross-owner-contaminated finding is a system fault, never a\n384\t    silently dropped one (spec section 6.2 D17 row).\n385\t    \"\"\"\n386\t\n387\t    unit_id = state.get(\"selected_unit_id\")\n388\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n389\t    require(\n390\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n391\t        \"integrity\",\n392\t        \"an accepted unit can never re-enter finding classification\",\n393\t        unit_id=unit_id,\n394\t    )\n395\t\n396\t    artifact_heads = state.get(\"artifact_heads\") or {}\n397\t    guard_record = state.get(\"pending_guard\")\n398\t    pending_failure = state.get(\"pending_failure\")\n399\t    update: dict[str, Any] = {}\n400\t\n401\t    if isinstance(pending_failure, Mapping) and pending_failure.get(\"classification\") == \"repair\":\n402\t        job_id = pending_failure.get(\"job_id\")\n403\t        owner = {\n404\t            \"M02_CREATE_UNIT_DOMAIN_DATA\": \"curriculum domain\",\n405\t            \"M03_WRITE_UNIT_CONTENT\": \"unit content\",\n406\t            \"M04_CREATE_UNIT_VISUALS\": \"unit visual\",\n407\t            \"M01_RESEARCH_UNIT_SOURCES\": \"source interpretation\",\n408\t            \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": None,\n409\t        }.get(job_id)\n410\t        require(\n411\t            owner in REPAIR_OWNERS,\n412\t            \"invalid_input\",\n413\t            f\"model failure for {job_id!r} maps to no known repair owner\",\n414\t            job_id=job_id,\n415\t        )\n416\t        raw_findings = [\n417\t            {\n418\t                \"owner\": owner,\n419\t                \"pointer\": f\"/{CHANNEL_BY_OWNER[owner]}\",\n420\t                \"check_id\": pending_failure.get(\"failure_class\"),\n421\t                \"message\": pending_failure.get(\"detail\") or pending_failure.get(\"message\") or \"\",\n422\t            }\n423\t        ]\n424\t        source_node = \"D91_CLASSIFY_MODEL_FAILURE\"\n425\t        update[\"pending_failure\"] = None\n426\t    else:\n427\t        require(isinstance(guard_record, Mapping), \"invalid_input\", \"D17 has no findings to classify\")\n428\t        detail = guard_record.get(\"detail\") if isinstance(guard_record.get(\"detail\"), Mapping) else {}\n429\t        raw_findings = detail.get(\"findings\")\n430\t        require(\n431\t            isinstance(raw_findings, list) and bool(raw_findings),\n432\t            \"invalid_input\",\n433\t            \"D17 was routed with an empty or missing findings list\",\n434\t        )\n435\t        source_node = str(guard_record.get(\"node\") or \"\")\n436\t\n437\t    normalized = normalize_findings(\n438\t        raw_findings, unit_id=unit_id, source_node=source_node, artifact_heads=artifact_heads\n439\t    )\n440\t\n441\t    by_owner: dict[str, list[dict[str, Any]]] = {}\n442\t    for finding in normalized:\n443\t        by_owner.setdefault(finding[\"owner\"], []).append(finding)\n444\t\n445\t    counters = dict(state.get(\"attempt_counters\") or {})\n446\t    exhausted: list[dict[str, Any]] = []\n447\t    partitions: list[dict[str, Any]] = []\n448\t    for owner in REPAIR_OWNERS:\n449\t        members = by_owner.get(owner)\n450\t        if not members:\n451\t            continue\n452\t        # D17 owns only the repeated-fingerprint bound; the numeric attempt\n453\t        # bound is D18's row of spec section 6.2 (\"D18 ... attempt bound =\n454\t        # exhaustion\"), checked once D18 has reserved the next attempt ordinal.\n455\t        fingerprint = canonical_digest(sorted(m[\"fingerprint\"] for m in members))\n456\t        repeat_key = _repeat_key(unit_id, owner, fingerprint)\n457\t        prior_repeats = int(counters.get(repeat_key, 0))\n458\t        if prior_repeats >= MAX_FINGERPRINT_REPEATS:\n459\t            exhausted.append({\"owner\": owner, \"fingerprint\": fingerprint, \"bound\": \"fingerprint_bound\", \"repeats\": prior_repeats})\n460\t            continue\n461\t        attempt_key = _attempt_key(unit_id, owner, fingerprint)\n462\t        prior_attempts = int(counters.get(attempt_key, 0))\n463\t        partitions.append(\n464\t            {\n465\t                \"key\": canonical_digest({\"unit_id\": unit_id, \"owner\": owner, \"fingerprint\": fingerprint, \"attempt\": prior_attempts + 1}),\n466\t                \"unit_id\": unit_id,\n467\t                \"owner\": owner,\n468\t                \"findings\": members,\n469\t                \"fingerprint\": fingerprint,\n470\t                \"prior_repeats\": prior_repeats,\n471\t                \"prior_attempts\": prior_attempts,\n472\t                \"source_node\": source_node,\n473\t            }\n474\t        )\n475\t\n476\t    if exhausted:\n477\t        update.update(\n478\t            {\n479\t                \"finding_partitions\": partitions,\n480\t                **_legal_status_update(state, unit_id, \"REPAIRING\"),\n481\t                \"pending_guard\": _guard(\n482\t                    \"D17_CLASSIFY_UNIT_FINDINGS\", \"convergence_exhausted\",\n483\t                    unit_id=unit_id, exhausted=exhausted,\n484\t                ),\n485\t                \"terminal_candidate\": {\n486\t                    \"kind\": \"CONVERGENCE_EXHAUSTED\",\n487\t                    \"bound\": exhausted[0][\"bound\"],\n488\t                    \"counters\": counters,\n489\t                    \"fingerprints\": [dict(item) for item in exhausted],\n490\t                    \"last_findings\": normalized,\n491\t                },\n492\t            }\n493\t        )\n494\t        return update\n495\t\n496\t    require(bool(partitions), \"invalid_input\", \"no owner produced a repair partition\")\n497\t\n498\t    update.update(\n499\t        {\n500\t            \"finding_partitions\": partitions,\n501\t            **_legal_status_update(state, unit_id, \"REPAIRING\"),\n502\t            \"pending_guard\": _guard(\n503\t                \"D17_CLASSIFY_UNIT_FINDINGS\", \"partition_complete\",\n504\t                unit_id=unit_id, owners=[entry[\"owner\"] for entry in partitions],\n505\t            ),\n506\t        }\n507\t    )\n508\t    return update\n509\t\n510\t\n511\t# --------------------------------------------------------------------------\n512\t# D18_PLAN_TARGETED_UNIT_REPAIR\n513\t# --------------------------------------------------------------------------\n514\t\n515\t\n516\tdef D18_PLAN_TARGETED_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n517\t    \"\"\"Select exactly one partition member, in fixed owner order, and plan its repair.\"\"\"\n518\t\n519\t    unit_id = state.get(\"selected_unit_id\")\n520\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n521\t\n522\t    partitions = [\n523\t        entry\n524\t        for entry in state.get(\"finding_partitions\") or []\n525\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n526\t    ]\n527\t    require(bool(partitions), \"invalid_input\", \"D18 requires at least one classified partition\")\n528\t\n529\t    resolved = {\n530\t        entry.get(\"request_key\")\n531\t        for entry in state.get(\"retest_results\") or []\n532\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id and entry.get(\"resolved\")\n533\t    }\n534\t    open_requests = {\n535\t        entry.get(\"partition_key\")\n536\t        for entry in state.get(\"repair_requests\") or []\n537\t        if isinstance(entry, Mapping)\n538\t        and entry.get(\"unit_id\") == unit_id\n539\t        and entry.get(\"key\") not in resolved\n540\t    }\n541\t\n542\t    latest_by_owner: dict[str, dict[str, Any]] = {}\n543\t    for entry in partitions:\n544\t        latest_by_owner[entry[\"owner\"]] = entry\n545\t\n546\t    selected = None\n547\t    for owner in REPAIR_OWNERS:\n548\t        entry = latest_by_owner.get(owner)\n549\t        if entry is None or entry[\"key\"] in open_requests:\n550\t            continue\n551\t        selected = entry\n552\t        break\n553\t    require(selected is not None, \"invalid_input\", \"every classified partition already has an open repair request\")\n554\t\n555\t    counters = dict(state.get(\"attempt_counters\") or {})\n556\t    attempt_key = _attempt_key(unit_id, selected[\"owner\"], selected[\"fingerprint\"])\n557\t    ordinal = int(counters.get(attempt_key, 0)) + 1\n558\t    if ordinal > MAX_REPAIR_CHILDREN_PER_CHAIN:\n559\t        return {\n560\t            \"pending_guard\": _guard(\n561\t                \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"convergence_exhausted\",\n562\t                unit_id=unit_id, owner=selected[\"owner\"], ordinal=ordinal,\n563\t            ),\n564\t            \"terminal_candidate\": {\n565\t                \"kind\": \"CONVERGENCE_EXHAUSTED\",\n566\t                \"bound\": \"attempt_bound\",\n567\t                \"counters\": counters,\n568\t                \"fingerprints\": [selected[\"fingerprint\"]],\n569\t                \"last_findings\": selected[\"findings\"],\n570\t            },\n571\t        }\n572\t\n573\t    channel = CHANNEL_BY_OWNER[selected[\"owner\"]]\n574\t    stream = stream_id(unit_id, channel)\n575\t    boundary_pointers = sorted({finding[\"boundary\"] for finding in selected[\"findings\"]})\n576\t    parent_hash = next(\n577\t        (finding[\"parent_hash\"] for finding in selected[\"findings\"] if finding.get(\"parent_hash\")),\n578\t        None,\n579\t    )\n580\t    allowed_facts: dict[str, Any] = {}\n581\t    for finding in selected[\"findings\"]:\n582\t        allowed_facts.update(finding.get(\"allowed_facts\") or {})\n583\t\n584\t    request = {\n585\t        \"key\": canonical_digest({\"partition_key\": selected[\"key\"], \"attempt\": ordinal}),\n586\t        \"partition_key\": selected[\"key\"],\n587\t        \"unit_id\": unit_id,\n588\t        \"owner\": selected[\"owner\"],\n589\t        \"channel\": channel,\n590\t        \"stream\": stream,\n591\t        \"finding_ids\": [finding[\"finding_id\"] for finding in selected[\"findings\"]],\n592\t        \"boundary\": {\"json_pointers\": boundary_pointers},\n593\t        \"parent_hash\": parent_hash,\n594\t        \"allowed_facts\": allowed_facts,\n595\t        \"next_child_version\": None,\n596\t        \"invalidated_descendants\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n597\t        \"retest_order\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n598\t        \"attempt_ordinal\": ordinal,\n599\t        \"fingerprint\": selected[\"fingerprint\"],\n600\t        \"prior_repeats\": selected[\"prior_repeats\"],\n601\t        \"max_children\": MAX_REPAIR_CHILDREN_PER_CHAIN,\n602\t        \"max_fingerprint_repeats\": MAX_FINGERPRINT_REPEATS,\n603\t    }\n604\t\n605\t    return {\n606\t        \"attempt_counters\": {attempt_key: ordinal},\n607\t        \"repair_requests\": [request],\n608\t        \"pending_guard\": _guard(\n609\t            \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"repair_planned\",\n610\t            unit_id=unit_id, request_key=request[\"key\"],\n611\t        ),\n612\t    }\n613\t\n614\t\n615\t# --------------------------------------------------------------------------\n616\t# D19_ROUTE_UNIT_REPAIR\n617\t# --------------------------------------------------------------------------\n618\t\n619\t\n620\tdef _apply_pointer(body: Any, pointer: str, value: Any) -> Any:\n621\t    \"\"\"Return a copy of ``body`` with ``pointer`` (RFC 6901) set to ``value``.\"\"\"\n622\t\n623\t    tokens = [tok.replace(\"~1\", \"/\").replace(\"~0\", \"~\") for tok in pointer.strip(\"/\").split(\"/\") if tok != \"\"]\n624\t    if not tokens:\n625\t        return json.loads(json.dumps(value))\n626\t    root = json.loads(json.dumps(body)) if isinstance(body, (dict, list)) else {}\n627\t    cursor = root\n628\t    for token in tokens[:-1]:\n629\t        if isinstance(cursor, list):\n630\t            index = int(token)\n631\t            cursor = cursor[index]\n632\t        else:\n633\t            cursor = cursor.setdefault(token, {})\n634\t    last = tokens[-1]\n635\t    if isinstance(cursor, list):\n636\t        index = int(last)\n637\t        while len(cursor) <= index:\n638\t            cursor.append(None)\n639\t        cursor[index] = value\n640\t    else:\n641\t        cursor[last] = value\n642\t    return root\n643\t\n644\t\n645\tdef _deterministic_repair_candidate(\n646\t    request: Mapping[str, Any], parent_body: Mapping[str, Any]\n647\t) -> dict[str, Any]:\n648\t    \"\"\"Apply a code-owned, boundary-scoped correction to the parent body.\n649\t\n650\t    Every value this writes is derived from the request's own `allowed_facts`\n651\t    (facts the run already admitted), never invented: a deterministic repair\n652\t    with nothing admitted to correct a pointer with raises rather than leaving\n653\t    the pointer untouched, because a no-op staged as a repair would be an\n654\t    in-place repair wearing a versioned child's clothes.\n655\t    \"\"\"\n656\t\n657\t    body = parent_body\n658\t    allowed_facts = request.get(\"allowed_facts\") or {}\n659\t    for pointer in request[\"boundary\"][\"json_pointers\"]:\n660\t        if pointer not in allowed_facts:\n661\t            raise SystemFailure(\n662\t                \"invalid_input\",\n663\t                f\"deterministic repair has no admitted fact for boundary pointer {pointer!r}\",\n664\t                {\"unit_id\": request[\"unit_id\"], \"owner\": request[\"owner\"]},\n665\t            )\n666\t        body = _apply_pointer(body, pointer, allowed_facts[pointer])\n667\t    return body\n668\t\n669\t\n670\tdef D19_ROUTE_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n671\t    \"\"\"Route the planned repair request to its deterministic producer or to M06.\"\"\"\n672\t\n673\t    unit_id = state.get(\"selected_unit_id\")\n674\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n675\t\n676\t    requests = [\n677\t        entry\n678\t        for entry in state.get(\"repair_requests\") or []\n679\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n680\t    ]\n681\t    require(bool(requests), \"invalid_input\", \"D19 requires a planned repair request\")\n682\t    request = requests[-1]\n683\t\n684\t    partitions = {\n685\t        entry[\"key\"]: entry\n686\t        for entry in state.get(\"finding_partitions\") or []\n687\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n688\t    }\n689\t    partition = partitions.get(request[\"partition_key\"])\n690\t    require(partition is not None, \"join\", \"the routed repair request names no known partition\")\n691\t    findings = partition[\"findings\"]\n692\t\n693\t    invalidation = {\n694\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"invalidation\"}),\n695\t        \"unit_id\": unit_id,\n696\t        \"request_key\": request[\"key\"],\n697\t        \"owner\": request[\"owner\"],\n698\t        \"invalidated_descendants\": request[\"invalidated_descendants\"],\n699\t        \"retest_order\": request[\"retest_order\"],\n700\t    }\n701\t\n702\t    route = route_owner(request[\"owner\"], state=state, findings=findings)\n703\t    stream = request[\"stream\"]\n704\t    heads = state.get(\"artifact_heads\") or {}\n705\t    parent_head = heads.get(stream)\n706\t\n707\t    if route == \"model\":\n708\t        artifact_versions = state.get(\"artifact_versions\") or []\n709\t        parent_body = None\n710\t        if isinstance(parent_head, Mapping):\n711\t            for record in artifact_versions:\n712\t                if (\n713\t                    isinstance(record, Mapping)\n714\t                    and record.get(\"stream\") == stream\n715\t                    and record.get(\"hash\") == parent_head.get(\"hash\")\n716\t                ):\n717\t                    parent_body = record.get(\"body\")\n718\t                    break\n719\t        require(isinstance(parent_body, Mapping), \"invalid_input\", \"no admitted parent body to repair\", stream=stream)\n720\t\n721\t        packet = worker_packet(\n722\t            run_id=state.get(\"run_id\"),\n723\t            episode_id=state.get(\"episode_id\"),\n724\t            correlation_key=f\"{request['key']}/M06\",\n725\t            projection={\n726\t                \"owner\": request[\"owner\"],\n727\t                \"findings\": [\n728\t                    {\n729\t                        \"finding_id\": finding[\"finding_id\"],\n730\t                        \"owner\": finding[\"owner\"],\n731\t                        \"pointer\": finding[\"boundary\"],\n732\t                        \"message\": finding[\"message\"],\n733\t                    }\n734\t                    for finding in findings\n735\t                ],\n736\t                \"parent\": {\n737\t                    \"artifact_name\": f\"{request['channel']}:{unit_id}\",\n738\t                    \"artifact_body\": json.dumps(parent_body, sort_keys=True),\n739\t                    \"channel\": request[\"channel\"],\n740\t                    \"unit_id\": unit_id,\n741\t                    \"parent_sha256\": parent_head.get(\"hash\"),\n742\t                },\n743\t                \"boundary\": request[\"boundary\"],\n744\t                \"allowed_facts\": request.get(\"allowed_facts\") or {},\n745\t                \"invalidated_descendants\": request[\"invalidated_descendants\"],\n746\t                \"retest_order\": request[\"retest_order\"],\n747\t            },\n748\t        )\n749\t        return {\n750\t            \"invalidations\": [invalidation],\n751\t            \"pending_packet\": staged_dispatch(\"M06_REPAIR_NAMED_UNIT_ARTIFACT\", [packet]),\n752\t            \"pending_guard\": _guard(\n753\t                \"D19_ROUTE_UNIT_REPAIR\", \"model_repair\", unit_id=unit_id, request_key=request[\"key\"]\n754\t            ),\n755\t        }\n756\t\n757\t    # Deterministic route: this node both selects and produces the candidate,\n758\t    # since D20 is the one and only admission authority and no intervening\n759\t    # dispatch node exists on the deterministic side (spec section 12: a\n760\t    # deterministic repair producer \"receives no prompt\").\n761\t    parent_body, current_hash, _current_version, _head_tracked = _current_parent(state, stream)\n762\t    new_body = _deterministic_repair_candidate(request, parent_body)\n763\t    candidate = {\n764\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n765\t        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n766\t        \"pre_admission\": True,\n767\t        \"stream\": stream,\n768\t        \"channel\": request[\"channel\"],\n769\t        \"unit_id\": unit_id,\n770\t        \"request_key\": request[\"key\"],\n771\t        \"owner\": request[\"owner\"],\n772\t        \"parent_sha256\": current_hash,\n773\t        \"addressed_finding_ids\": request[\"finding_ids\"],\n774\t        \"body\": new_body,\n775\t    }\n776\t    return {\n777\t        \"invalidations\": [invalidation],\n778\t        \"artifact_versions\": [candidate],\n779\t        \"pending_guard\": _guard(\n780\t            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n781\t        ),\n782\t    }\n783\t\n784\t\n785\t# --------------------------------------------------------------------------\n786\t# D20_ADMIT_UNIT_REPAIR\n787\t# --------------------------------------------------------------------------\n788\t\n789\t\n790\tdef _latest_deterministic_candidate(\n791\t    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n792\t) -> dict[str, Any] | None:\n793\t    matches = [\n794\t        dict(record)\n795\t        for record in artifact_versions\n796\t        if isinstance(record, Mapping)\n797\t        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n798\t        and record.get(\"stream\") == stream\n799\t        and record.get(\"request_key\") == request_key\n800\t    ]\n801\t    return matches[-1] if matches else None\n802\t\n803\t\n804\tdef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool]:\n805\t    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n806\t\n807\t    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n808\t    layout does not (it is admitted by D13 as a plain append-unique version,\n809\t    the same convention `review.py` already reads it under). Both shapes\n810\t    resolve to one parent here so D20 admits either uniformly, and the fourth\n811\t    element tells the caller whether `artifact_heads` may legally be written.\n812\t    \"\"\"\n813\t\n814\t    heads = state.get(\"artifact_heads\") or {}\n815\t    head = heads.get(stream)\n816\t    artifact_versions = state.get(\"artifact_versions\") or []\n817\t    if isinstance(head, Mapping):\n818\t        for record in artifact_versions:\n819\t            if (\n820\t                isinstance(record, Mapping)\n821\t                and record.get(\"stream\") == stream\n822\t                and record.get(\"hash\") == head.get(\"hash\")\n823\t            ):\n824\t                return record.get(\"body\") or {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n825\t        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n826\t\n827\t    candidates = [\n828\t        record\n829\t        for record in artifact_versions\n830\t        if isinstance(record, Mapping)\n831\t        and record.get(\"stream\") == stream\n832\t        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n833\t    ]\n834\t    if not candidates:\n835\t        return {}, None, 0, False\n836\t    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n837\t    return latest.get(\"body\") or {}, latest.get(\"hash\"), int(latest.get(\"version\", 0)), False\n838\t\n839\t\n840\tdef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n841\t    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n842\t\n843\t    Recomputes the parent/child diff itself rather than trusting a model's own\n844\t    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n845\t    child that does not descend from the current head, is `SystemFailure`\n846\t    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n847\t    routed repairable finding, because a boundary violation is a build/model\n848\t    defect, not a product outcome to retry.\n849\t    \"\"\"\n850\t\n851\t    unit_id = state.get(\"selected_unit_id\")\n852\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n853\t\n854\t    requests = [\n855\t        entry\n856\t        for entry in state.get(\"repair_requests\") or []\n857\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n858\t    ]\n859\t    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n860\t    request = requests[-1]\n861\t    stream = request[\"stream\"]\n862\t    boundary = request[\"boundary\"][\"json_pointers\"]\n863\t    heads = state.get(\"artifact_heads\") or {}\n864\t    parent_head = heads.get(stream)\n865\t    artifact_versions = state.get(\"artifact_versions\") or []\n866\t\n867\t    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n868\t\n869\t    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n870\t    deterministic_candidate = _latest_deterministic_candidate(\n871\t        artifact_versions, stream=stream, request_key=request[\"key\"]\n872\t    )\n873\t    require(\n874\t        (model_candidate is not None) != (deterministic_candidate is not None),\n875\t        \"join\",\n876\t        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n877\t        unit_id=unit_id,\n878\t    )\n879\t\n880\t    if model_candidate is not None:\n881\t        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n882\t        child = payload.get(\"candidate_child\") or {}\n883\t        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n884\t        try:\n885\t            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n886\t        except (TypeError, ValueError) as error:\n887\t            raise SystemFailure(\n888\t                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n889\t            ) from error\n890\t        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n891\t    else:\n892\t        new_body = deterministic_candidate[\"body\"]\n893\t        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n894\t\n895\t    require(\n896\t        declared_parent_sha == current_hash,\n897\t        \"integrity\",\n898\t        \"the repair candidate's declared parent is not the current head (stale repair)\",\n899\t        stream=stream, declared=declared_parent_sha, current=current_hash,\n900\t    )\n901\t\n902\t    diff = json_pointer_diff(parent_body, new_body)\n903\t    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n904\t    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n905\t    require(\n906\t        not out_of_bound,\n907\t        \"integrity\",\n908\t        \"a repair candidate changed bytes outside its declared boundary\",\n909\t        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n910\t    )\n911\t\n912\t    child_record = {\n913\t        \"stream\": stream,\n914\t        \"version\": current_version + 1,\n915\t        \"parent_hash\": current_hash,\n916\t        \"hash\": canonical_digest(new_body),\n917\t        \"body\": new_body,\n918\t        \"minted_by\": \"targeted_repair_admission\",\n919\t        \"unit_id\": unit_id,\n920\t        \"channel\": request[\"channel\"],\n921\t        \"request_key\": request[\"key\"],\n922\t        \"owner\": request[\"owner\"],\n923\t        \"attempt\": request[\"attempt_ordinal\"],\n924\t    }\n925\t    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n926\t\n927\t    update: dict[str, Any] = {\n928\t        \"artifact_versions\": [child_record],\n929\t        \"pending_guard\": _guard(\n930\t            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n931\t            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n932\t        ),\n933\t    }\n934\t    if head_tracked:\n935\t        update[\"artifact_heads\"] = {\n936\t            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n937\t        }\n938\t    return update\n939\t\n940\t\n941\t# --------------------------------------------------------------------------\n942\t# D21_RETEST_REQUIRED_DESCENDANTS\n943\t# --------------------------------------------------------------------------\n944\t\n945\t\n946\tdef D21_RETEST_REQUIRED_DESCENDANTS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n947\t    \"\"\"Dispatch the earliest node of the fixed retest DAG, or close the frontier.\n948\t\n949\t    Dispatches exactly once per repair admission: the first named node's own\n950\t    success guard already re-enters the rest of the normal unit path (D07\n951\t    through D16), so this never loops internally and never names a model node\n952\t    as the stored destination (spec section 6.2 D92/D21: a model destination in\n953\t    a stored frontier is a system fault).\n954\t    \"\"\"\n955\t\n956\t    unit_id = state.get(\"selected_unit_id\")\n957\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n958\t\n959\t    invalidations = [\n960\t        entry\n961\t        for entry in state.get(\"invalidations\") or []\n962\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n963\t    ]\n964\t    require(bool(invalidations), \"invalid_input\", \"D21 requires an admitted invalidation record\")\n965\t    invalidation = invalidations[-1]\n966\t\n967\t    dispatched = {\n968\t        entry.get(\"request_key\")\n969\t        for entry in state.get(\"retest_results\") or []\n970\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n971\t    }\n972\t\n973\t    retest_order = invalidation[\"retest_order\"]\n974\t    request_key = invalidation[\"request_key\"]\n975\t    if not retest_order:\n976\t        return {\n977\t            \"pending_guard\": _guard(\n978\t                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n979\t            )\n980\t        }\n981\t\n982\t    result = {\n983\t        \"key\": canonical_digest({\"request_key\": request_key, \"kind\": \"retest_dispatch\"}),\n984\t        \"unit_id\": unit_id,\n985\t        \"request_key\": request_key,\n986\t        \"owner\": invalidation[\"owner\"],\n987\t        \"retest_order\": list(retest_order),\n988\t        \"dispatched_to\": retest_order[0],\n989\t        \"resolved\": True,\n990\t    }\n991\t\n992\t    if request_key in dispatched:\n993\t        return {\n994\t            \"pending_guard\": _guard(\n995\t                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n996\t            )\n997\t        }\n998\t\n999\t    return {\n1000\t        \"retest_results\": [result],\n1001\t        \"pending_guard\": _guard(\n1002\t            \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_incomplete\",\n1003\t            unit_id=unit_id, destination=retest_order[0],\n1004\t        ),\n1005\t    }\n1006\t"}]},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"6f28344b-e566-4087-8d1b-f62cd0ce008e","timestamp":"2026-08-12T21:34:36.935Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/repair.py","content":"\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n\nOwns finding classification, one-partition-member repair planning, deterministic\nvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\nunit repair cycle here and reused by the workbook repair cycle N32 builds over\n`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\nmachinery is one engine, not a per-caller copy).\n\nNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\nregistered as graph nodes yet (that registration is N32's write, once\n`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\nscoped `(state, runtime_context) -> update` callables in the same shape N23's\n`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n`nodes.deterministic_node()`. A future registration step binds them to their\ncatalogue rows without changing this module.\n\nEvery finding this engine classifies is normalized to spec section 12's\n`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\nOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n(code-owned), and a model review's own `category` field is deliberately never\nread as an owner -- `owner_for_review_category()` is the one place a category\nstring is mapped to the five-owner vocabulary, and an unmapped category is a\nsystem fault, not a silent guess.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any\n\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    latest_model_candidate,\n    require,\n    staged_dispatch,\n    stream_id,\n    worker_packet,\n)\nfrom .reducers import UNIT_STATUS_TRANSITIONS\n\n__all__ = [\n    \"REPAIR_OWNERS\",\n    \"CHANNEL_BY_OWNER\",\n    \"MODEL_ONLY_OWNERS\",\n    \"DETERMINISTIC_ONLY_OWNERS\",\n    \"CONDITIONAL_OWNERS\",\n    \"RETEST_FIRST_NODE\",\n    \"RETEST_ORDER_BY_OWNER\",\n    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n    \"MAX_FINGERPRINT_REPEATS\",\n    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n    \"RepairEngineError\",\n    \"owner_for_review_category\",\n    \"normalize_findings\",\n    \"finding_fingerprint\",\n    \"route_owner\",\n    \"json_pointer_diff\",\n    \"within_boundary\",\n    \"D17_CLASSIFY_UNIT_FINDINGS\",\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n    \"D19_ROUTE_UNIT_REPAIR\",\n    \"D20_ADMIT_UNIT_REPAIR\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n]\n\n\nclass RepairEngineError(SystemFailure):\n    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n\n\n# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n# this set is a legal `owner`; a finding naming anything else fails closed.\nREPAIR_OWNERS: tuple[str, ...] = (\n    \"source interpretation\",\n    \"curriculum domain\",\n    \"unit content\",\n    \"unit visual\",\n    \"unit layout\",\n)\n\n# The artifact-versions channel each owner's repair targets. Source\n# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n# is a pointer inside the same admitted domain body a curriculum-domain defect\n# would touch, differing only in which pointers are named and in dispatch\n# eligibility below.\nCHANNEL_BY_OWNER: Mapping[str, str] = {\n    \"curriculum domain\": \"domain\",\n    \"source interpretation\": \"domain\",\n    \"unit content\": \"content\",\n    \"unit visual\": \"visuals\",\n    \"unit layout\": \"layout\",\n}\n\n# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n# table. A curriculum-domain or unit-content defect is model-owned outright.\n# Layout has a deterministic renderer/template repair path and no model path in\n# this generation, so it is always deterministic. Source interpretation could\n# legally refetch deterministically when a locator remains authorized; this\n# generation always routes it to M06 rather than re-implementing a fetcher here\n# (repair.py owns the routing table, not a second source-retrieval stack), and\n# that choice is exactly the one spec section 12 leaves open (\"M06 repairs only\n# the named interpretation ... admission is code-owned\"). Unit visual is the one\n# genuinely conditional row: an authoritative/library visual is always\n# rerun deterministically (a model may never assert authoritative circuit/pin\n# detail per spec section 13), and a non-authoritative asset is model-eligible.\nMODEL_ONLY_OWNERS: frozenset[str] = frozenset(\n    {\"curriculum domain\", \"unit content\", \"source interpretation\"}\n)\nDETERMINISTIC_ONLY_OWNERS: frozenset[str] = frozenset({\"unit layout\"})\nCONDITIONAL_OWNERS: frozenset[str] = frozenset({\"unit visual\"})\n\n# The first deterministic node of each owner's fixed retest chain (spec section\n# 12's table). Every value here is a real `RESUME_REENTRY_DESTINATIONS` member\n# of `unit_graph.py`; the remaining steps of a chain are not dispatched by D21 at\n# all -- they are the already-wired unit-path edges the first node's own success\n# guard reaches on its own (D07 -> D08 -> D09 -> D10 -> ... -> D16).\nRETEST_FIRST_NODE: Mapping[str, str] = {\n    \"source interpretation\": \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    \"curriculum domain\": \"D08_VALIDATE_DOMAIN\",\n    \"unit content\": \"D09_VALIDATE_CONTENT\",\n    \"unit visual\": \"D10_COMPILE_VISUAL_BRIEFS\",\n    \"unit layout\": \"D13_RENDER_UNIT\",\n}\n\nRETEST_ORDER_BY_OWNER: Mapping[str, tuple[str, ...]] = {\n    \"source interpretation\": (\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\", \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\",\n        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"curriculum domain\": (\n        \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\",\n        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit content\": (\n        \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\",\n        \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n        \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit visual\": (\n        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit layout\": (\n        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n}\n\n# Frozen limits (spec section 12): three repair children per owner/finding\n# chain, two occurrences of the same fingerprint. The earliest reached bound\n# controls -- `D18_PLAN_TARGETED_UNIT_REPAIR` checks both and never dispatches\n# a fourth child or a third repeat of the same defect.\nMAX_REPAIR_CHILDREN_PER_CHAIN = 3\nMAX_FINGERPRINT_REPEATS = 2\n\n# A model review's own `category` vocabulary is never trusted directly; this is\n# the one code-owned mapping from a reviewer's free-text category to the fixed\n# five-owner vocabulary. Substring match on a normalized (lowercased) category\n# keeps the rubric free to phrase categories in prose while still refusing an\n# unmapped one rather than guessing.\n_REVIEW_CATEGORY_OWNER_KEYWORDS: tuple[tuple[str, str], ...] = (\n    (\"source\", \"source interpretation\"),\n    (\"citation\", \"source interpretation\"),\n    (\"domain\", \"curriculum domain\"),\n    (\"fact\", \"curriculum domain\"),\n    (\"content\", \"unit content\"),\n    (\"prose\", \"unit content\"),\n    (\"pedagog\", \"unit content\"),\n    (\"readab\", \"unit content\"),\n    (\"safety\", \"unit content\"),\n    (\"bloom\", \"unit content\"),\n    (\"visual\", \"unit visual\"),\n    (\"image\", \"unit visual\"),\n    (\"diagram\", \"unit visual\"),\n    (\"layout\", \"unit layout\"),\n    (\"page\", \"unit layout\"),\n    (\"render\", \"unit layout\"),\n)\n\nDETERMINISTIC_REPAIR_CANDIDATE_KIND = \"deterministic_repair_candidate\"\n\n\ndef owner_for_review_category(category: Any) -> str | None:\n    \"\"\"Map one M05 review `category` string to a code-owned owner, or None.\n\n    Never returns the model's own words: the return value is always one member\n    of `REPAIR_OWNERS`, decided by this frozen table, or None when no keyword\n    matches -- which the caller treats as an unknown-owner system fault, not a\n    best guess.\n    \"\"\"\n\n    if not isinstance(category, str) or not category:\n        return None\n    lowered = category.lower()\n    for keyword, owner in _REVIEW_CATEGORY_OWNER_KEYWORDS:\n        if keyword in lowered:\n            return owner\n    return None\n\n\ndef finding_fingerprint(owner: str, boundary: Sequence[str], message: Any) -> str:\n    \"\"\"The stable identity of a defect across repeated repair attempts.\n\n    Keyed on owner, boundary pointers, and message -- not on `finding_id` (which\n    a fresh classification pass may mint differently) and not on attempt number\n    (which must never enter a fingerprint that exists to detect repeated\n    failure across attempts).\n    \"\"\"\n\n    return canonical_digest({\"owner\": owner, \"boundary\": sorted(boundary), \"message\": str(message)})\n\n\ndef normalize_findings(\n    raw_findings: Sequence[Mapping[str, Any]],\n    *,\n    unit_id: str,\n    source_node: str,\n    artifact_heads: Mapping[str, Any],\n) -> list[dict[str, Any]]:\n    \"\"\"Normalize a raw findings list to spec section 12's one shape.\n\n    Fails closed (`SystemFailure`) on any finding with no owner, an owner\n    outside the fixed vocabulary, or a missing pointer -- `D17` never routes a\n    zero- or unknown-owner finding into a partition; it raises before one is\n    built. A caller with only one already-classified finding (the D91\n    model-repair-failure case) still goes through this function, so the same\n    checks apply uniformly.\n    \"\"\"\n\n    normalized: list[dict[str, Any]] = []\n    for raw in raw_findings:\n        if not isinstance(raw, Mapping):\n            raise SystemFailure(\n                \"invalid_input\", \"a finding must be a JSON object\", {\"source_node\": source_node}\n            )\n        owner = raw.get(\"owner\")\n        if owner not in REPAIR_OWNERS:\n            raise SystemFailure(\n                \"invalid_input\",\n                f\"finding declares owner {owner!r}, which is not one of the five known owners\",\n                {\"unit_id\": unit_id, \"source_node\": source_node, \"owner\": owner},\n            )\n        pointer = raw.get(\"pointer\")\n        if not isinstance(pointer, str) or not pointer:\n            raise SystemFailure(\n                \"invalid_input\", \"finding declares no boundary pointer\",\n                {\"unit_id\": unit_id, \"owner\": owner},\n            )\n        channel = CHANNEL_BY_OWNER[owner]\n        parent_head = artifact_heads.get(stream_id(unit_id, channel))\n        parent_hash = parent_head.get(\"hash\") if isinstance(parent_head, Mapping) else None\n        message = raw.get(\"message\", \"\")\n        finding_id = canonical_digest(\n            {\"unit_id\": unit_id, \"owner\": owner, \"pointer\": pointer, \"message\": str(message)}\n        )\n        raw_facts = raw.get(\"allowed_facts\")\n        allowed_facts = dict(raw_facts) if isinstance(raw_facts, Mapping) else {}\n        normalized.append(\n            {\n                \"finding_id\": finding_id,\n                \"evidence_key\": str(raw.get(\"check_id\", source_node)),\n                \"owner\": owner,\n                \"boundary\": pointer,\n                \"parent_hash\": parent_hash,\n                \"fingerprint\": finding_fingerprint(owner, [pointer], message),\n                \"message\": str(message),\n                \"unit_id\": unit_id,\n                \"source_node\": source_node,\n                \"allowed_facts\": allowed_facts,\n            }\n        )\n    return normalized\n\n\ndef route_owner(owner: str, *, state: Mapping[str, Any], findings: Sequence[Mapping[str, Any]]) -> str:\n    \"\"\"Deterministic-vs-model dispatch for one owner's findings (spec section 12).\"\"\"\n\n    if owner in DETERMINISTIC_ONLY_OWNERS:\n        return \"deterministic\"\n    if owner in MODEL_ONLY_OWNERS:\n        return \"model\"\n    if owner not in CONDITIONAL_OWNERS:\n        raise RepairEngineError(\"integrity\", f\"owner {owner!r} has no dispatch rule\", {\"owner\": owner})\n    # unit visual: deterministic only if every named key is an authoritative or\n    # library visual brief; a model may never touch one (spec section 13).\n    briefs = {\n        brief.get(\"key\"): brief\n        for brief in state.get(\"visual_briefs\", [])\n        if isinstance(brief, Mapping)\n    }\n    for finding in findings:\n        key = str(finding.get(\"boundary\", \"\")).strip(\"/\").split(\"/\")[-1]\n        brief = briefs.get(key)\n        authoritative = bool(brief.get(\"authoritative\")) if isinstance(brief, Mapping) else False\n        if not authoritative:\n            return \"model\"\n    return \"deterministic\"\n\n\ndef _escape_token(token: str) -> str:\n    return token.replace(\"~\", \"~0\").replace(\"/\", \"~1\")\n\n\ndef json_pointer_diff(parent: Any, child: Any, path: str = \"\") -> set[str]:\n    \"\"\"Every leaf JSON pointer at which ``parent`` and ``child`` differ.\"\"\"\n\n    if parent == child:\n        return set()\n    if isinstance(parent, Mapping) and isinstance(child, Mapping):\n        diffs: set[str] = set()\n        for key in sorted(set(parent) | set(child)):\n            sub = f\"{path}/{_escape_token(str(key))}\"\n            if key not in parent or key not in child:\n                diffs.add(sub)\n            else:\n                diffs |= json_pointer_diff(parent[key], child[key], sub)\n        return diffs\n    if isinstance(parent, list) and isinstance(child, list):\n        diffs = set()\n        for index in range(max(len(parent), len(child))):\n            sub = f\"{path}/{index}\"\n            if index >= len(parent) or index >= len(child):\n                diffs.add(sub)\n            else:\n                diffs |= json_pointer_diff(parent[index], child[index], sub)\n        return diffs\n    return {path or \"/\"}\n\n\ndef within_boundary(pointer: str, allowed: Sequence[str]) -> bool:\n    \"\"\"Whether ``pointer`` is exactly, or nested under, one declared boundary pointer.\"\"\"\n\n    return any(pointer == allow or pointer.startswith(f\"{allow}/\") for allow in allowed)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef _legal_status_update(state: Mapping[str, Any], unit_id: str, target: str) -> dict[str, Any]:\n    \"\"\"`{\"unit_status\": {unit_id: target}}`, or nothing when that jump is undeclared.\n\n    Mirrors `acceptance._legal_status_update`: a unit reaching D17 straight\n    from D08/D09/D12/D14's repairable guard is still `SELECTED`, and\n    `reducers.UNIT_STATUS_TRANSITIONS` does not declare `SELECTED ->\n    REPAIRING` (no currently-wired producer node emits the intermediate\n    `SOURCING`/`BUILDING` statuses that table assumes). Skipping the write\n    rather than forcing an illegal one keeps this module honest about a gap\n    it does not own.\n    \"\"\"\n\n    current = (state.get(\"unit_status\") or {}).get(unit_id)\n    if current is not None and target not in UNIT_STATUS_TRANSITIONS.get(current, frozenset()):\n        return {}\n    return {\"unit_status\": {unit_id: target}}\n\n\ndef _attempt_key(unit_id: str, owner: str, fingerprint: str) -> str:\n    return f\"repair|{unit_id}|{owner}|{fingerprint}\"\n\n\ndef _repeat_key(unit_id: str, owner: str, fingerprint: str) -> str:\n    return f\"repeat|{unit_id}|{owner}|{fingerprint}\"\n\n\n# --------------------------------------------------------------------------\n# D17_CLASSIFY_UNIT_FINDINGS\n# --------------------------------------------------------------------------\n\n\ndef D17_CLASSIFY_UNIT_FINDINGS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Total one-owner partition of the current findings, or honest exhaustion.\n\n    Reads whichever repairable branch reached it: a `pending_guard` carrying a\n    `findings` list from D08/D09/D12/D14/D16, or a `pending_failure` a D91\n    model-repair classification left with no structured findings at all. Every\n    blocking finding appears in exactly one owner's partition entry; an\n    unowned or cross-owner-contaminated finding is a system fault, never a\n    silently dropped one (spec section 6.2 D17 row).\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter finding classification\",\n        unit_id=unit_id,\n    )\n\n    artifact_heads = state.get(\"artifact_heads\") or {}\n    guard_record = state.get(\"pending_guard\")\n    pending_failure = state.get(\"pending_failure\")\n    update: dict[str, Any] = {}\n\n    if isinstance(pending_failure, Mapping) and pending_failure.get(\"classification\") == \"repair\":\n        job_id = pending_failure.get(\"job_id\")\n        owner = {\n            \"M02_CREATE_UNIT_DOMAIN_DATA\": \"curriculum domain\",\n            \"M03_WRITE_UNIT_CONTENT\": \"unit content\",\n            \"M04_CREATE_UNIT_VISUALS\": \"unit visual\",\n            \"M01_RESEARCH_UNIT_SOURCES\": \"source interpretation\",\n            \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": None,\n        }.get(job_id)\n        require(\n            owner in REPAIR_OWNERS,\n            \"invalid_input\",\n            f\"model failure for {job_id!r} maps to no known repair owner\",\n            job_id=job_id,\n        )\n        raw_findings = [\n            {\n                \"owner\": owner,\n                \"pointer\": f\"/{CHANNEL_BY_OWNER[owner]}\",\n                \"check_id\": pending_failure.get(\"failure_class\"),\n                \"message\": pending_failure.get(\"detail\") or pending_failure.get(\"message\") or \"\",\n            }\n        ]\n        source_node = \"D91_CLASSIFY_MODEL_FAILURE\"\n        update[\"pending_failure\"] = None\n    else:\n        require(isinstance(guard_record, Mapping), \"invalid_input\", \"D17 has no findings to classify\")\n        detail = guard_record.get(\"detail\") if isinstance(guard_record.get(\"detail\"), Mapping) else {}\n        raw_findings = detail.get(\"findings\")\n        require(\n            isinstance(raw_findings, list) and bool(raw_findings),\n            \"invalid_input\",\n            \"D17 was routed with an empty or missing findings list\",\n        )\n        source_node = str(guard_record.get(\"node\") or \"\")\n\n    normalized = normalize_findings(\n        raw_findings, unit_id=unit_id, source_node=source_node, artifact_heads=artifact_heads\n    )\n\n    by_owner: dict[str, list[dict[str, Any]]] = {}\n    for finding in normalized:\n        by_owner.setdefault(finding[\"owner\"], []).append(finding)\n\n    counters = dict(state.get(\"attempt_counters\") or {})\n    exhausted: list[dict[str, Any]] = []\n    partitions: list[dict[str, Any]] = []\n    for owner in REPAIR_OWNERS:\n        members = by_owner.get(owner)\n        if not members:\n            continue\n        # D17 owns only the repeated-fingerprint bound; the numeric attempt\n        # bound is D18's row of spec section 6.2 (\"D18 ... attempt bound =\n        # exhaustion\"), checked once D18 has reserved the next attempt ordinal.\n        fingerprint = canonical_digest(sorted(m[\"fingerprint\"] for m in members))\n        repeat_key = _repeat_key(unit_id, owner, fingerprint)\n        prior_repeats = int(counters.get(repeat_key, 0))\n        if prior_repeats >= MAX_FINGERPRINT_REPEATS:\n            exhausted.append({\"owner\": owner, \"fingerprint\": fingerprint, \"bound\": \"fingerprint_bound\", \"repeats\": prior_repeats})\n            continue\n        attempt_key = _attempt_key(unit_id, owner, fingerprint)\n        prior_attempts = int(counters.get(attempt_key, 0))\n        partitions.append(\n            {\n                \"key\": canonical_digest({\"unit_id\": unit_id, \"owner\": owner, \"fingerprint\": fingerprint, \"attempt\": prior_attempts + 1}),\n                \"unit_id\": unit_id,\n                \"owner\": owner,\n                \"findings\": members,\n                \"fingerprint\": fingerprint,\n                \"prior_repeats\": prior_repeats,\n                \"prior_attempts\": prior_attempts,\n                \"source_node\": source_node,\n            }\n        )\n\n    if exhausted:\n        update.update(\n            {\n                \"finding_partitions\": partitions,\n                **_legal_status_update(state, unit_id, \"REPAIRING\"),\n                \"pending_guard\": _guard(\n                    \"D17_CLASSIFY_UNIT_FINDINGS\", \"convergence_exhausted\",\n                    unit_id=unit_id, exhausted=exhausted,\n                ),\n                \"terminal_candidate\": {\n                    \"kind\": \"CONVERGENCE_EXHAUSTED\",\n                    \"bound\": exhausted[0][\"bound\"],\n                    \"counters\": counters,\n                    \"fingerprints\": [dict(item) for item in exhausted],\n                    \"last_findings\": normalized,\n                },\n            }\n        )\n        return update\n\n    require(bool(partitions), \"invalid_input\", \"no owner produced a repair partition\")\n\n    update.update(\n        {\n            \"finding_partitions\": partitions,\n            **_legal_status_update(state, unit_id, \"REPAIRING\"),\n            \"pending_guard\": _guard(\n                \"D17_CLASSIFY_UNIT_FINDINGS\", \"partition_complete\",\n                unit_id=unit_id, owners=[entry[\"owner\"] for entry in partitions],\n            ),\n        }\n    )\n    return update\n\n\n# --------------------------------------------------------------------------\n# D18_PLAN_TARGETED_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef D18_PLAN_TARGETED_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Select exactly one partition member, in fixed owner order, and plan its repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    partitions = [\n        entry\n        for entry in state.get(\"finding_partitions\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(partitions), \"invalid_input\", \"D18 requires at least one classified partition\")\n\n    resolved = {\n        entry.get(\"request_key\")\n        for entry in state.get(\"retest_results\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id and entry.get(\"resolved\")\n    }\n    open_requests = {\n        entry.get(\"partition_key\")\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping)\n        and entry.get(\"unit_id\") == unit_id\n        and entry.get(\"key\") not in resolved\n    }\n\n    latest_by_owner: dict[str, dict[str, Any]] = {}\n    for entry in partitions:\n        latest_by_owner[entry[\"owner\"]] = entry\n\n    selected = None\n    for owner in REPAIR_OWNERS:\n        entry = latest_by_owner.get(owner)\n        if entry is None or entry[\"key\"] in open_requests:\n            continue\n        selected = entry\n        break\n    require(selected is not None, \"invalid_input\", \"every classified partition already has an open repair request\")\n\n    counters = dict(state.get(\"attempt_counters\") or {})\n    attempt_key = _attempt_key(unit_id, selected[\"owner\"], selected[\"fingerprint\"])\n    ordinal = int(counters.get(attempt_key, 0)) + 1\n    if ordinal > MAX_REPAIR_CHILDREN_PER_CHAIN:\n        return {\n            \"pending_guard\": _guard(\n                \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"convergence_exhausted\",\n                unit_id=unit_id, owner=selected[\"owner\"], ordinal=ordinal,\n            ),\n            \"terminal_candidate\": {\n                \"kind\": \"CONVERGENCE_EXHAUSTED\",\n                \"bound\": \"attempt_bound\",\n                \"counters\": counters,\n                \"fingerprints\": [selected[\"fingerprint\"]],\n                \"last_findings\": selected[\"findings\"],\n            },\n        }\n\n    channel = CHANNEL_BY_OWNER[selected[\"owner\"]]\n    stream = stream_id(unit_id, channel)\n    boundary_pointers = sorted({finding[\"boundary\"] for finding in selected[\"findings\"]})\n    parent_hash = next(\n        (finding[\"parent_hash\"] for finding in selected[\"findings\"] if finding.get(\"parent_hash\")),\n        None,\n    )\n    allowed_facts: dict[str, Any] = {}\n    for finding in selected[\"findings\"]:\n        allowed_facts.update(finding.get(\"allowed_facts\") or {})\n\n    request = {\n        \"key\": canonical_digest({\"partition_key\": selected[\"key\"], \"attempt\": ordinal}),\n        \"partition_key\": selected[\"key\"],\n        \"unit_id\": unit_id,\n        \"owner\": selected[\"owner\"],\n        \"channel\": channel,\n        \"stream\": stream,\n        \"finding_ids\": [finding[\"finding_id\"] for finding in selected[\"findings\"]],\n        \"boundary\": {\"json_pointers\": boundary_pointers},\n        \"parent_hash\": parent_hash,\n        \"allowed_facts\": allowed_facts,\n        \"next_child_version\": None,\n        \"invalidated_descendants\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n        \"retest_order\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n        \"attempt_ordinal\": ordinal,\n        \"fingerprint\": selected[\"fingerprint\"],\n        \"prior_repeats\": selected[\"prior_repeats\"],\n        \"max_children\": MAX_REPAIR_CHILDREN_PER_CHAIN,\n        \"max_fingerprint_repeats\": MAX_FINGERPRINT_REPEATS,\n    }\n\n    return {\n        \"attempt_counters\": {attempt_key: ordinal},\n        \"repair_requests\": [request],\n        \"pending_guard\": _guard(\n            \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"repair_planned\",\n            unit_id=unit_id, request_key=request[\"key\"],\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D19_ROUTE_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef _apply_pointer(body: Any, pointer: str, value: Any) -> Any:\n    \"\"\"Return a copy of ``body`` with ``pointer`` (RFC 6901) set to ``value``.\"\"\"\n\n    tokens = [tok.replace(\"~1\", \"/\").replace(\"~0\", \"~\") for tok in pointer.strip(\"/\").split(\"/\") if tok != \"\"]\n    if not tokens:\n        return json.loads(json.dumps(value))\n    root = json.loads(json.dumps(body)) if isinstance(body, (dict, list)) else {}\n    cursor = root\n    for token in tokens[:-1]:\n        if isinstance(cursor, list):\n            index = int(token)\n            cursor = cursor[index]\n        else:\n            cursor = cursor.setdefault(token, {})\n    last = tokens[-1]\n    if isinstance(cursor, list):\n        index = int(last)\n        while len(cursor) <= index:\n            cursor.append(None)\n        cursor[index] = value\n    else:\n        cursor[last] = value\n    return root\n\n\ndef _deterministic_repair_candidate(\n    request: Mapping[str, Any], parent_body: Mapping[str, Any]\n) -> dict[str, Any]:\n    \"\"\"Apply a code-owned, boundary-scoped correction to the parent body.\n\n    Every value this writes is derived from the request's own `allowed_facts`\n    (facts the run already admitted), never invented: a deterministic repair\n    with nothing admitted to correct a pointer with raises rather than leaving\n    the pointer untouched, because a no-op staged as a repair would be an\n    in-place repair wearing a versioned child's clothes.\n    \"\"\"\n\n    body = parent_body\n    allowed_facts = request.get(\"allowed_facts\") or {}\n    for pointer in request[\"boundary\"][\"json_pointers\"]:\n        if pointer not in allowed_facts:\n            raise SystemFailure(\n                \"invalid_input\",\n                f\"deterministic repair has no admitted fact for boundary pointer {pointer!r}\",\n                {\"unit_id\": request[\"unit_id\"], \"owner\": request[\"owner\"]},\n            )\n        body = _apply_pointer(body, pointer, allowed_facts[pointer])\n    return body\n\n\ndef D19_ROUTE_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Route the planned repair request to its deterministic producer or to M06.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    requests = [\n        entry\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(requests), \"invalid_input\", \"D19 requires a planned repair request\")\n    request = requests[-1]\n\n    partitions = {\n        entry[\"key\"]: entry\n        for entry in state.get(\"finding_partitions\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    }\n    partition = partitions.get(request[\"partition_key\"])\n    require(partition is not None, \"join\", \"the routed repair request names no known partition\")\n    findings = partition[\"findings\"]\n\n    invalidation = {\n        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"invalidation\"}),\n        \"unit_id\": unit_id,\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"invalidated_descendants\": request[\"invalidated_descendants\"],\n        \"retest_order\": request[\"retest_order\"],\n    }\n\n    route = route_owner(request[\"owner\"], state=state, findings=findings)\n    stream = request[\"stream\"]\n    heads = state.get(\"artifact_heads\") or {}\n    parent_head = heads.get(stream)\n\n    if route == \"model\":\n        artifact_versions = state.get(\"artifact_versions\") or []\n        parent_body = None\n        if isinstance(parent_head, Mapping):\n            for record in artifact_versions:\n                if (\n                    isinstance(record, Mapping)\n                    and record.get(\"stream\") == stream\n                    and record.get(\"hash\") == parent_head.get(\"hash\")\n                ):\n                    parent_body = record.get(\"body\")\n                    break\n        require(isinstance(parent_body, Mapping), \"invalid_input\", \"no admitted parent body to repair\", stream=stream)\n\n        packet = worker_packet(\n            run_id=state.get(\"run_id\"),\n            episode_id=state.get(\"episode_id\"),\n            correlation_key=f\"{request['key']}/M06\",\n            projection={\n                \"owner\": request[\"owner\"],\n                \"findings\": [\n                    {\n                        \"finding_id\": finding[\"finding_id\"],\n                        \"owner\": finding[\"owner\"],\n                        \"pointer\": finding[\"boundary\"],\n                        \"message\": finding[\"message\"],\n                    }\n                    for finding in findings\n                ],\n                \"parent\": {\n                    \"artifact_name\": f\"{request['channel']}:{unit_id}\",\n                    \"artifact_body\": json.dumps(parent_body, sort_keys=True),\n                    \"channel\": request[\"channel\"],\n                    \"unit_id\": unit_id,\n                    \"parent_sha256\": parent_head.get(\"hash\"),\n                },\n                \"boundary\": request[\"boundary\"],\n                \"allowed_facts\": request.get(\"allowed_facts\") or {},\n                \"invalidated_descendants\": request[\"invalidated_descendants\"],\n                \"retest_order\": request[\"retest_order\"],\n            },\n        )\n        return {\n            \"invalidations\": [invalidation],\n            \"pending_packet\": staged_dispatch(\"M06_REPAIR_NAMED_UNIT_ARTIFACT\", [packet]),\n            \"pending_guard\": _guard(\n                \"D19_ROUTE_UNIT_REPAIR\", \"model_repair\", unit_id=unit_id, request_key=request[\"key\"]\n            ),\n        }\n\n    # Deterministic route: this node both selects and produces the candidate,\n    # since D20 is the one and only admission authority and no intervening\n    # dispatch node exists on the deterministic side (spec section 12: a\n    # deterministic repair producer \"receives no prompt\").\n    parent_body, current_hash, _current_version, _head_tracked = _current_parent(state, stream)\n    new_body = _deterministic_repair_candidate(request, parent_body)\n    candidate = {\n        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n        \"pre_admission\": True,\n        \"stream\": stream,\n        \"channel\": request[\"channel\"],\n        \"unit_id\": unit_id,\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"parent_sha256\": current_hash,\n        \"addressed_finding_ids\": request[\"finding_ids\"],\n        \"body\": new_body,\n    }\n    return {\n        \"invalidations\": [invalidation],\n        \"artifact_versions\": [candidate],\n        \"pending_guard\": _guard(\n            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D20_ADMIT_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef _latest_deterministic_candidate(\n    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n) -> dict[str, Any] | None:\n    matches = [\n        dict(record)\n        for record in artifact_versions\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n        and record.get(\"stream\") == stream\n        and record.get(\"request_key\") == request_key\n    ]\n    return matches[-1] if matches else None\n\n\ndef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool]:\n    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n\n    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n    layout does not (it is admitted by D13 as a plain append-unique version,\n    the same convention `review.py` already reads it under). Both shapes\n    resolve to one parent here so D20 admits either uniformly, and the fourth\n    element tells the caller whether `artifact_heads` may legally be written.\n    \"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    head = heads.get(stream)\n    artifact_versions = state.get(\"artifact_versions\") or []\n    if isinstance(head, Mapping):\n        for record in artifact_versions:\n            if (\n                isinstance(record, Mapping)\n                and record.get(\"stream\") == stream\n                and record.get(\"hash\") == head.get(\"hash\")\n            ):\n                return record.get(\"body\") or {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n\n    candidates = [\n        record\n        for record in artifact_versions\n        if isinstance(record, Mapping)\n        and record.get(\"stream\") == stream\n        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n    ]\n    if not candidates:\n        return {}, None, 0, False\n    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n    return latest.get(\"body\") or {}, latest.get(\"hash\"), int(latest.get(\"version\", 0)), False\n\n\ndef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n\n    Recomputes the parent/child diff itself rather than trusting a model's own\n    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n    child that does not descend from the current head, is `SystemFailure`\n    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n    routed repairable finding, because a boundary violation is a build/model\n    defect, not a product outcome to retry.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    requests = [\n        entry\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n    request = requests[-1]\n    stream = request[\"stream\"]\n    boundary = request[\"boundary\"][\"json_pointers\"]\n    heads = state.get(\"artifact_heads\") or {}\n    parent_head = heads.get(stream)\n    artifact_versions = state.get(\"artifact_versions\") or []\n\n    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n\n    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n    deterministic_candidate = _latest_deterministic_candidate(\n        artifact_versions, stream=stream, request_key=request[\"key\"]\n    )\n    require(\n        (model_candidate is not None) != (deterministic_candidate is not None),\n        \"join\",\n        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n        unit_id=unit_id,\n    )\n\n    if model_candidate is not None:\n        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n        child = payload.get(\"candidate_child\") or {}\n        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n        try:\n            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n        except (TypeError, ValueError) as error:\n            raise SystemFailure(\n                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n            ) from error\n        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n    else:\n        new_body = deterministic_candidate[\"body\"]\n        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n\n    require(\n        declared_parent_sha == current_hash,\n        \"integrity\",\n        \"the repair candidate's declared parent is not the current head (stale repair)\",\n        stream=stream, declared=declared_parent_sha, current=current_hash,\n    )\n\n    diff = json_pointer_diff(parent_body, new_body)\n    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n    require(\n        not out_of_bound,\n        \"integrity\",\n        \"a repair candidate changed bytes outside its declared boundary\",\n        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n    )\n\n    child_record = {\n        \"stream\": stream,\n        \"version\": current_version + 1,\n        \"parent_hash\": current_hash,\n        \"hash\": canonical_digest(new_body),\n        \"body\": new_body,\n        \"minted_by\": \"targeted_repair_admission\",\n        \"unit_id\": unit_id,\n        \"channel\": request[\"channel\"],\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"attempt\": request[\"attempt_ordinal\"],\n    }\n    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n\n    update: dict[str, Any] = {\n        \"artifact_versions\": [child_record],\n        \"pending_guard\": _guard(\n            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n        ),\n    }\n    if head_tracked:\n        update[\"artifact_heads\"] = {\n            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n        }\n    return update\n\n\n# --------------------------------------------------------------------------\n# D21_RETEST_REQUIRED_DESCENDANTS\n# --------------------------------------------------------------------------\n\n\ndef D21_RETEST_REQUIRED_DESCENDANTS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Dispatch the earliest node of the fixed retest DAG, or close the frontier.\n\n    Dispatches exactly once per repair admission: the first named node's own\n    success guard already re-enters the rest of the normal unit path (D07\n    through D16), so this never loops internally and never names a model node\n    as the stored destination (spec section 6.2 D92/D21: a model destination in\n    a stored frontier is a system fault).\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    invalidations = [\n        entry\n        for entry in state.get(\"invalidations\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(invalidations), \"invalid_input\", \"D21 requires an admitted invalidation record\")\n    invalidation = invalidations[-1]\n\n    dispatched = {\n        entry.get(\"request_key\")\n        for entry in state.get(\"retest_results\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    }\n\n    retest_order = invalidation[\"retest_order\"]\n    request_key = invalidation[\"request_key\"]\n    if not retest_order:\n        return {\n            \"pending_guard\": _guard(\n                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n            )\n        }\n\n    result = {\n        \"key\": canonical_digest({\"request_key\": request_key, \"kind\": \"retest_dispatch\"}),\n        \"unit_id\": unit_id,\n        \"request_key\": request_key,\n        \"owner\": invalidation[\"owner\"],\n        \"retest_order\": list(retest_order),\n        \"dispatched_to\": retest_order[0],\n        \"resolved\": True,\n    }\n\n    if request_key in dispatched:\n        return {\n            \"pending_guard\": _guard(\n                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n            )\n        }\n\n    return {\n        \"retest_results\": [result],\n        \"pending_guard\": _guard(\n            \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_incomplete\",\n            unit_id=unit_id, destination=retest_order[0],\n        ),\n    }\n","numLines":1006,"startLine":1,"totalLines":1006}}}
