       if node_id in wired:\n514\t            continue\n515\t        owner = DEFERRED_TOPOLOGY.get(node_id)\n516\t        if owner is None:\n517\t            _reject(\n518\t                \"N20-NODE-UNDECLARED\",\n519\t                node_id,\n520\t                \"is registered but neither wired by the skeleton nor declared deferred\",\n521\t            )\n522\t\n523\t\n524\t# ---------------------------------------------------------------- registration\n525\t\n526\t\n527\tdef register_skeleton(\n528\t    builder: StateGraph,\n529\t    bindings: Mapping[str, Callable[..., Any]],\n530\t) -> dict[str, dict[str, Any]]:\n531\t    \"\"\"Register every available node and the fixed skeleton edges.\n532\t\n533\t    N30 and N32 extend the same builder by adding their own `add_node`-free\n534\t    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n535\t    rewritten by them, so the skeleton stays the one place START, the recovery\n536\t    branch, and the single edge to END are decided.\n537\t    \"\"\"\n538\t\n539\t    routing.assert_guard_table_total(NODE_CATALOGUE)\n540\t    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n541\t    _validate_topology(sorted(bindings))\n542\t\n543\t    for node_id in sorted(bindings):\n544\t        model_node = node_id in MODEL_NODE_ADAPTERS\n545\t        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n546\t\n547\t    for source, target in SKELETON_NORMAL_EDGES:\n548\t        builder.add_edge(source, target)\n549\t\n550\t    for source, path in SKELETON_BRANCHES:\n551\t        destinations = routing.guard_destinations(source)\n552\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n553\t\n554\t    unit_graph.register_unit_path(builder, sorted(bindings))\n555\t    register_unit_repair_path(builder, sorted(bindings))\n556\t\n557\t    return inventory\n558\t\n559\t\n560\tdef register_unit_repair_path(builder: StateGraph, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n561\t    \"\"\"Wire D16-D23's internal edges (spec section 8.2's repair/acceptance cycle).\n562\t\n563\t    Additive over the builder `register_skeleton` already added every node in\n564\t    `available` to -- the same division of labor `unit_graph.register_unit_\n565\t    path` uses for the normal unit path: this adds no node, only the\n566\t    conditional edges among D16-D23 and back out to `D05`/`D98` spec section\n567\t    8.2's own diagram describes (\"D16 PASS -> D22 -> D23 -> D05\", \"D16 FAIL ->\n568\t    D17 -> D18 -> D19 -> D20 -> D21 -> earliest invalidated producer -> D16\",\n569\t    \"D17/D18 repeat/attempt-bound exhaustion -> D98\").\n570\t\n571\t    A no-op when none of `UNIT_REPAIR_NODE_BODIES` is in `available` (N30's own\n572\t    tests call `register_skeleton` with the narrower `binding_inventory()`,\n573\t    which must keep behaving exactly as it did before this generation); once\n574\t    `build_curriculum_factory_graph()` passes the widened\n575\t    `repair_acceptance_bindings()` set, every branch here is real.\n576\t    \"\"\"\n577\t\n578\t    known = set(available)\n579\t    resolved: dict[str, tuple[str, ...]] = {}\n580\t    for source, path in UNIT_REPAIR_BRANCHES:\n581\t        if source not in known:\n582\t            continue\n583\t        destinations = _unit_repair_branch_destinations(source, available)\n584\t        if not destinations:\n585\t            _reject(\"N31-EDGE-EMPTY\", source, \"every declared destination is unavailable\")\n586\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n587\t        resolved[source] = destinations\n588\t    return resolved\n589\t\n590\t\n591\tdef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n592\t    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n593\t\n594\t    Not called by `build_curriculum_factory_graph`: this generation's single\n595\t    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n596\t    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n597\t    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n598\t    this function into whatever the production compile point becomes once the\n599\t    workbook branch is in scope; until then it is exercised directly, over its\n600\t    own builder, the way N32's own topology test already does.\n601\t    `register_skeleton` itself must never see these bindings; this function\n602\t    adds exactly the nodes `register_skeleton` did not, then wires them over\n603\t    the *full* merged node set so `workbook.register_workbook_path` can\n604\t    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n605\t    \"\"\"\n606\t\n607\t    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n608\t    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n609\t    for node_id in sorted(workbook_bindings):\n610\t        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n611\t    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n612\t\n613\t\n614\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n615\t    required = {source for source, _ in SKELETON_BRANCHES}\n616\t    for source, target in SKELETON_NORMAL_EDGES:\n617\t        required.update({source, target})\n618\t    for source, _ in SKELETON_BRANCHES:\n619\t        required.update(routing.guard_destinations(source))\n620\t    return tuple(sorted(required - {START, END}))\n621\t\n622\t\n623\tdef build_curriculum_factory_graph(\n624\t    *, engine_root: Path, output_root: Path\n625\t) -> CompiledStateGraph:\n626\t    \"\"\"Build and compile the one production graph (spec section 4).\n627\t\n628\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n629\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n630\t    services are captured at build time, so the compiled object carries no\n631\t    run identity and no authorization.\n632\t\n633\t    Compiles against `repair_acceptance_bindings()` (the skeleton/unit path\n634\t    plus D16-D23), not the narrower `binding_inventory()`: this is the one\n635\t    production compile point N90's audit (finding F1) found D16-D23 missing\n636\t    from, and `register_skeleton` wires their internal edges automatically\n637\t    once their bodies are present in the bindings it receives (`register_\n638\t    unit_repair_path`, called from inside `register_skeleton`). The workbook\n639\t    branch (D24-D32) stays absent here -- N32's own compile-point wiring, not\n640\t    this generation's.\n641\t    \"\"\"\n642\t\n643\t    engine_root = Path(engine_root).resolve()\n644\t    output_root = Path(output_root).resolve()\n645\t    builder: StateGraph = StateGraph(\n646\t        FactoryState,\n647\t        context_schema=RuntimeContext,\n648\t        input_schema=FactoryInput,\n649\t        output_schema=FactoryOutput,\n650\t    )\n651\t    register_skeleton(builder, repair_acceptance_bindings())\n652\t    saver, _connection = open_checkpoint_saver(output_root)\n653\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n654\t\n655\t\n656\t# ---------------------------------------------------------------------- digest\n657\t\n658\t\n659\tdef _canonical_digest(payload: Any) -> str:"}]},"parent_tool_use_id":null,"session_id":"85ccdb45-8482-4249-a92f-e9379e0b4244","uuid":"48ccad40-57ef-481d-9a6f-246db5aa8e9a","timestamp":"2026-08-12T21:30:16.078Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/graph.py","content":"        # positive on the spec's own vocabulary, not a caught stand-in.\n        marker = next(\n            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n            None,\n        )\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n        source = inspect.getsource(_underlying(body))\n        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n        identity = (module, record[\"qualname\"])\n        if identity in seen:\n            _reject(\n                \"N20-BIND-DUPLICATE\",\n                node_id,\n                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n            )\n        seen[identity] = node_id\n        inventory[node_id] = record\n    return inventory\n\n\ndef _unit_repair_branch_destinations(source: str, available: Sequence[str]) -> tuple[str, ...]:\n    \"\"\"Every destination `source` (one of `UNIT_REPAIR_BRANCHES`) can currently reach.\n\n    Unlike `unit_graph.deferred_destinations`, nothing here is ever legally\n    deferred: every declared destination of D16-D23 is either another member\n    of this same cycle, an already-registered skeleton/unit-path node (`D05`,\n    `D07`-`D10`, `D13`, `D90`), or `D98`/`D96` -- all present the moment\n    `UNIT_REPAIR_NODE_BODIES` itself is present. A destination absent from\n    `available` here is a real build defect, not a scope boundary.\n    \"\"\"\n\n    declared = set(routing.guard_destinations(source))\n    if source == \"D21_RETEST_REQUIRED_DESCENDANTS\":\n        declared.update(RETEST_DYNAMIC_DESTINATIONS)\n    return tuple(sorted(declared & set(available)))\n\n\ndef _validate_topology(registered: Sequence[str]) -> None:\n    known = set(registered) | {START, END}\n    wired: set[str] = set()\n    for source, target in SKELETON_NORMAL_EDGES:\n        for endpoint in (source, target):\n            if endpoint not in known:\n                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n        wired.update({source, target})\n    for source, path in SKELETON_BRANCHES:\n        if source not in known:\n            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n        wired.add(source)\n        for target in routing.guard_destinations(source):\n            if target not in known:\n                _reject(\n                    \"N20-EDGE-DANGLING\",\n                    target,\n                    f\"{source} branch {path.__name__} names an unregistered destination\",\n                )\n            wired.add(target)\n    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n        wired.update({source, target})\n    for source, _ in unit_graph.UNIT_BRANCHES:\n        wired.add(source)\n        wired.update(unit_graph.branch_destinations(source, registered))\n    for source, _ in UNIT_REPAIR_BRANCHES:\n        if source not in known:\n            continue\n        wired.add(source)\n        wired.update(_unit_repair_branch_destinations(source, registered))\n    for node_id in registered:\n        if node_id in wired:\n            continue\n        owner = DEFERRED_TOPOLOGY.get(node_id)\n        if owner is None:\n            _reject(\n                \"N20-NODE-UNDECLARED\",\n                node_id,\n                \"is registered but neither wired by the skeleton nor declared deferred\",\n            )\n\n\n# ---------------------------------------------------------------- registration\n\n\ndef register_skeleton(\n    builder: StateGraph,\n    bindings: Mapping[str, Callable[..., Any]],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Register every available node and the fixed skeleton edges.\n\n    N30 and N32 extend the same builder by adding their own `add_node`-free\n    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n    rewritten by them, so the skeleton stays the one place START, the recovery\n    branch, and the single edge to END are decided.\n    \"\"\"\n\n    routing.assert_guard_table_total(NODE_CATALOGUE)\n    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n    _validate_topology(sorted(bindings))\n\n    for node_id in sorted(bindings):\n        model_node = node_id in MODEL_NODE_ADAPTERS\n        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n\n    for source, target in SKELETON_NORMAL_EDGES:\n        builder.add_edge(source, target)\n\n    for source, path in SKELETON_BRANCHES:\n        destinations = routing.guard_destinations(source)\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n\n    unit_graph.register_unit_path(builder, sorted(bindings))\n    register_unit_repair_path(builder, sorted(bindings))\n\n    return inventory\n\n\ndef register_unit_repair_path(builder: StateGraph, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n    \"\"\"Wire D16-D23's internal edges (spec section 8.2's repair/acceptance cycle).\n\n    Additive over the builder `register_skeleton` already added every node in\n    `available` to -- the same division of labor `unit_graph.register_unit_\n    path` uses for the normal unit path: this adds no node, only the\n    conditional edges among D16-D23 and back out to `D05`/`D98` spec section\n    8.2's own diagram describes (\"D16 PASS -> D22 -> D23 -> D05\", \"D16 FAIL ->\n    D17 -> D18 -> D19 -> D20 -> D21 -> earliest invalidated producer -> D16\",\n    \"D17/D18 repeat/attempt-bound exhaustion -> D98\").\n\n    A no-op when none of `UNIT_REPAIR_NODE_BODIES` is in `available` (N30's own\n    tests call `register_skeleton` with the narrower `binding_inventory()`,\n    which must keep behaving exactly as it did before this generation); once\n    `build_curriculum_factory_graph()` passes the widened\n    `repair_acceptance_bindings()` set, every branch here is real.\n    \"\"\"\n\n    known = set(available)\n    resolved: dict[str, tuple[str, ...]] = {}\n    for source, path in UNIT_REPAIR_BRANCHES:\n        if source not in known:\n            continue\n        destinations = _unit_repair_branch_destinations(source, available)\n        if not destinations:\n            _reject(\"N31-EDGE-EMPTY\", source, \"every declared destination is unavailable\")\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n        resolved[source] = destinations\n    return resolved\n\n\ndef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n\n    Not called by `build_curriculum_factory_graph`: this generation's single\n    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n    this function into whatever the production compile point becomes once the\n    workbook branch is in scope; until then it is exercised directly, over its\n    own builder, the way N32's own topology test already does.\n    `register_skeleton` itself must never see these bindings; this function\n    adds exactly the nodes `register_skeleton` did not, then wires them over\n    the *full* merged node set so `workbook.register_workbook_path` can\n    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n    \"\"\"\n\n    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n    for node_id in sorted(workbook_bindings):\n        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n\n\ndef _skeleton_required_nodes() -> tuple[str, ...]:\n    required = {source for source, _ in SKELETON_BRANCHES}\n    for source, target in SKELETON_NORMAL_EDGES:\n        required.update({source, target})\n    for source, _ in SKELETON_BRANCHES:\n        required.update(routing.guard_destinations(source))\n    return tuple(sorted(required - {START, END}))\n\n\ndef build_curriculum_factory_graph(\n    *, engine_root: Path, output_root: Path\n) -> CompiledStateGraph:\n    \"\"\"Build and compile the one production graph (spec section 4).\n\n    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n    returned graph is invoked with `context=build_runtime_context(...)`; no\n    services are captured at build time, so the compiled object carries no\n    run identity and no authorization.\n\n    Compiles against `repair_acceptance_bindings()` (the skeleton/unit path\n    plus D16-D23), not the narrower `binding_inventory()`: this is the one\n    production compile point N90's audit (finding F1) found D16-D23 missing\n    from, and `register_skeleton` wires their internal edges automatically\n    once their bodies are present in the bindings it receives (`register_\n    unit_repair_path`, called from inside `register_skeleton`). The workbook\n    branch (D24-D32) stays absent here -- N32's own compile-point wiring, not\n    this generation's.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    builder: StateGraph = StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n    register_skeleton(builder, repair_acceptance_bindings())\n    saver, _connection = open_checkpoint_saver(output_root)\n    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n\n\n# ---------------------------------------------------------------------