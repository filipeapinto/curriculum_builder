{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017nJAHAfiaXrFPZhhfqZshh","type":"tool_result","content":"1\t\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n2\t\n3\tOwns finding classification, one-partition-member repair planning, deterministic\n4\tvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\n5\tunit repair cycle here and reused by the workbook repair cycle N32 builds over\n6\t`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\n7\tmachinery is one engine, not a per-caller copy).\n8\t\n9\tNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\n10\tregistered as graph nodes yet (that registration is N32's write, once\n11\t`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\n12\tscoped `(state, runtime_context) -> update` callables in the same shape N23's\n13\t`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n14\t`nodes.deterministic_node()`. A future registration step binds them to their\n15\tcatalogue rows without changing this module.\n16\t\n17\tEvery finding this engine classifies is normalized to spec section 12's\n18\t`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\n19\tOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n20\t(code-owned), and a model review's own `category` field is deliberately never\n21\tread as an owner -- `owner_for_review_category()` is the one place a category\n22\tstring is mapped to the five-owner vocabulary, and an unmapped category is a\n23\tsystem fault, not a silent guess.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport json\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom typing import Any\n31\t\n32\tfrom .nodes import (\n33\t    SystemFailure,\n34\t    candidate_payload,\n35\t    canonical_digest,\n36\t    latest_model_candidate,\n37\t    require,\n38\t    staged_dispatch,\n39\t    stream_id,\n40\t    worker_packet,\n41\t)\n42\t\n43\t__all__ = [\n44\t    \"REPAIR_OWNERS\",\n45\t    \"CHANNEL_BY_OWNER\",\n46\t    \"MODEL_ONLY_OWNERS\",\n47\t    \"DETERMINISTIC_ONLY_OWNERS\",\n48\t    \"CONDITIONAL_OWNERS\",\n49\t    \"RETEST_FIRST_NODE\",\n50\t    \"RETEST_ORDER_BY_OWNER\",\n51\t    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n52\t    \"MAX_FINGERPRINT_REPEATS\",\n53\t    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n54\t    \"RepairEngineError\",\n55\t    \"owner_for_review_category\",\n56\t    \"normalize_findings\",\n57\t    \"finding_fingerprint\",\n58\t    \"route_owner\",\n59\t    \"json_pointer_diff\",\n60\t    \"within_boundary\",\n61\t    \"D17_CLASSIFY_UNIT_FINDINGS\",\n62\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n63\t    \"D19_ROUTE_UNIT_REPAIR\",\n64\t    \"D20_ADMIT_UNIT_REPAIR\",\n65\t    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n66\t]\n67\t\n68\t\n69\tclass RepairEngineError(SystemFailure):\n70\t    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n71\t\n72\t\n73\t# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n74\t# this set is a legal `owner`; a finding naming anything else fails closed.\n75\tREPAIR_OWNERS: tuple[str, ...] = (\n76\t    \"source interpretation\",\n77\t    \"curriculum domain\",\n78\t    \"unit content\",\n79\t    \"unit visual\",\n80\t    \"unit layout\",\n81\t)\n82\t\n83\t# The artifact-versions channel each owner's repair targets. Source\n84\t# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n85\t# is a pointer inside the same admitted domain body a curriculum-domain defect\n86\t# would touch, differing only in which pointers are named and in dispatch\n87\t# eligibility below.\n88\tCHANNEL_BY_OWNER: Mapping[str, str] = {\n89\t    \"curriculum domain\": \"domain\",\n90\t    \"source interpretation\": \"domain\",\n91\t    \"unit content\": \"content\",\n92\t    \"unit visual\": \"visuals\",\n93\t    \"unit layout\": \"layout\",\n94\t}\n95\t\n96\t# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n97\t# table. A curriculum-domain or unit-content defect is model-owned outright.\n98\t# Layout has a deterministic renderer/template repair path and no model path in\n99\t# this generation, so it is always deterministic. Source interpretation could\n100\t# legally refetch deterministically when a locator remains authorized; this\n101\t# generation always routes it to M06 rather than re-implementing a fetcher here\n102\t# (repair.py owns the routing table, not a second source-retrieval stack), and\n103\t# that choice is exactly the one spec section 12 leaves open (\"M06 repairs only\n104\t# the named interpretation ... admission is code-owned\"). Unit visual is the one\n105\t# genuinely conditional row: an authoritative/library visual is always\n106\t# rerun deterministically (a model may never assert authoritative circuit/pin\n107\t# detail per spec section 13), and a non-authoritative asset is model-eligible.\n108\tMODEL_ONLY_OWNERS: frozenset[str] = frozenset(\n109\t    {\"curriculum domain\", \"unit content\", \"source interpretation\"}\n110\t)\n111\tDETERMINISTIC_ONLY_OWNERS: frozenset[str] = frozenset({\"unit layout\"})\n112\tCONDITIONAL_OWNERS: frozenset[str] = frozenset({\"unit visual\"})\n113\t\n114\t# The first deterministic node of each owner's fixed retest chain (spec section\n115\t# 12's table). Every value here is a real `RESUME_REENTRY_DESTINATIONS` member\n116\t# of `unit_graph.py`; the remaining steps of a chain are not dispatched by D21 at\n117\t# all -- they are the already-wired unit-path edges the first node's own success\n118\t# guard reaches on its own (D07 -> D08 -> D09 -> D10 -> ... -> D16).\n119\tRETEST_FIRST_NODE: Mapping[str, str] = {\n120\t    \"source interpretation\": \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n121\t    \"curriculum domain\": \"D08_VALIDATE_DOMAIN\",\n122\t    \"unit content\": \"D09_VALIDATE_CONTENT\",\n123\t    \"unit visual\": \"D10_COMPILE_VISUAL_BRIEFS\",\n124\t    \"unit layout\": \"D13_RENDER_UNIT\",\n125\t}\n126\t\n127\tRETEST_ORDER_BY_OWNER: Mapping[str, tuple[str, ...]] = {\n128\t    \"source interpretation\": (\n129\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\", \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\",\n130\t        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n131\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n132\t    ),\n133\t    \"curriculum domain\": (\n134\t        \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\",\n135\t        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n136\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n137\t    ),\n138\t    \"unit content\": (\n139\t        \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\",\n140\t        \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n141\t        \"D16_REDUCE_UNIT_EVIDENCE\",\n142\t    ),\n143\t    \"unit visual\": (\n144\t        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n145\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n146\t    ),\n147\t    \"unit layout\": (\n148\t        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n149\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n150\t    ),\n151\t}\n152\t\n153\t# Frozen limits (spec section 12): three repair children per owner/finding\n154\t# chain, two occurrences of the same fingerprint. The earliest reached bound\n155\t# controls -- `D18_PLAN_TARGETED_UNIT_REPAIR` checks both and never dispatches\n156\t# a fourth child or a third repeat of the same defect.\n157\tMAX_REPAIR_CHILDREN_PER_CHAIN = 3\n158\tMAX_FINGERPRINT_REPEATS = 2\n159\t\n160\t# A model review's own `category` vocabulary is never trusted directly; this is\n161\t# the one code-owned mapping from a reviewer's free-text category to the fixed\n162\t# five-owner vocabulary. Substring match on a normalized (lowercased) category\n163\t# keeps the rubric free to phrase categories in prose while still refusing an\n164\t# unmapped one rather than guessing.\n165\t_REVIEW_CATEGORY_OWNER_KEYWORDS: tuple[tuple[str, str], ...] = (\n166\t    (\"source\", \"source interpretation\"),\n167\t    (\"citation\", \"source interpretation\"),\n168\t    (\"domain\", \"curriculum domain\"),\n169\t    (\"fact\", \"curriculum domain\"),\n170\t    (\"content\", \"unit content\"),\n171\t    (\"prose\", \"unit content\"),\n172\t    (\"pedagog\", \"unit content\"),\n173\t    (\"readab\", \"unit content\"),\n174\t    (\"safety\", \"unit content\"),\n175\t    (\"bloom\", \"unit content\"),\n176\t    (\"visual\", \"unit visual\"),\n177\t    (\"image\", \"unit visual\"),\n178\t    (\"diagram\", \"unit visual\"),\n179\t    (\"layout\", \"unit layout\"),\n180\t    (\"page\", \"unit layout\"),\n181\t    (\"render\", \"unit layout\"),\n182\t)\n183\t\n184\tDETERMINISTIC_REPAIR_CANDIDATE_KIND = \"deterministic_repair_candidate\"\n185\t\n186\t\n187\tdef owner_for_review_category(category: Any) -> str | None:\n188\t    \"\"\"Map one M05 review `category` string to a code-owned owner, or None.\n189\t\n190\t    Never returns the model's own words: the return value is always one member\n191\t    of `REPAIR_OWNERS`, decided by this frozen table, or None when no keyword\n192\t    matches -- which the caller treats as an unknown-owner system fault, not a\n193\t    best guess.\n194\t    \"\"\"\n195\t\n196\t    if not isinstance(category, str) or not category:\n197\t        return None\n198\t    lowered = category.lower()\n199\t    for keyword, owner in _REVIEW_CATEGORY_OWNER_KEYWORDS:\n200\t        if keyword in lowered:\n201\t            return owner\n202\t    return None\n203\t\n204\t\n205\tdef finding_fingerprint(owner: str, boundary: Sequence[str], message: Any) -> str:\n206\t    \"\"\"The stable identity of a defect across repeated repair attempts.\n207\t\n208\t    Keyed on owner, boundary pointers, and message -- not on `finding_id` (which\n209\t    a fresh classification pass may mint differently) and not on attempt number\n210\t    (which must never enter a fingerprint that exists to detect repeated\n211\t    failure across attempts).\n212\t    \"\"\"\n213\t\n214\t    return canonical_digest({\"owner\": owner, \"boundary\": sorted(boundary), \"message\": str(message)})\n215\t\n216\t\n217\tdef normalize_findings(\n218\t    raw_findings: Sequence[Mapping[str, Any]],\n219\t    *,\n220\t    unit_id: str,\n221\t    source_node: str,\n222\t    artifact_heads: Mapping[str, Any],\n223\t) -> list[dict[str, Any]]:\n224\t    \"\"\"Normalize a raw findings list to spec section 12's one shape.\n225\t\n226\t    Fails closed (`SystemFailure`) on any finding with no owner, an owner\n227\t    outside the fixed vocabulary, or a missing pointer -- `D17` never routes a\n228\t    zero- or unknown-owner finding into a partition; it raises before one is\n229\t    built. A caller with only one already-classified finding (the D91\n230\t    model-repair-failure case) still goes through this function, so the same\n231\t    checks apply uniformly.\n232\t    \"\"\"\n233\t\n234\t    normalized: list[dict[str, Any]] = []\n235\t    for raw in raw_findings:\n236\t        if not isinstance(raw, Mapping):\n237\t            raise SystemFailure(\n238\t                \"invalid_input\", \"a finding must be a JSON object\", {\"source_node\": source_node}\n239\t            )\n240\t        owner = raw.get(\"owner\")\n241\t        if owner not in REPAIR_OWNERS:\n242\t            raise SystemFailure(\n243\t                \"invalid_input\",\n244\t                f\"finding declares owner {owner!r}, which is not one of the five known owners\",\n245\t                {\"unit_id\": unit_id, \"source_node\": source_node, \"owner\": owner},\n246\t            )\n247\t        pointer = raw.get(\"pointer\")\n248\t        if not isinstance(pointer, str) or not pointer:\n249\t            raise SystemFailure(\n250\t                \"invalid_input\", \"finding declares no boundary pointer\",\n251\t                {\"unit_id\": unit_id, \"owner\": owner},\n252\t            )\n253\t        channel = CHANNEL_BY_OWNER[owner]\n254\t        parent_head = artifact_heads.get(stream_id(unit_id, channel))\n255\t        parent_hash = parent_head.get(\"hash\") if isinstance(parent_head, Mapping) else None\n256\t        message = raw.get(\"message\", \"\")\n257\t        finding_id = canonical_digest(\n258\t            {\"unit_id\": unit_id, \"owner\": owner, \"pointer\": pointer, \"message\": str(message)}\n259\t        )\n260\t        raw_facts = raw.get(\"allowed_facts\")\n261\t        allowed_facts = dict(raw_facts) if isinstance(raw_facts, Mapping) else {}\n262\t        normalized.append(\n263\t            {\n264\t                \"finding_id\": finding_id,\n265\t                \"evidence_key\": str(raw.get(\"check_id\", source_node)),\n266\t                \"owner\": owner,\n267\t                \"boundary\": pointer,\n268\t                \"parent_hash\": parent_hash,\n269\t                \"fingerprint\": finding_fingerprint(owner, [pointer], message),\n270\t                \"message\": str(message),\n271\t                \"unit_id\": unit_id,\n272\t                \"source_node\": source_node,\n273\t                \"allowed_facts\": allowed_facts,\n274\t            }\n275\t        )\n276\t    return normalized\n277\t\n278\t\n279\tdef route_owner(owner: str, *, state: Mapping[str, Any], findings: Sequence[Mapping[str, Any]]) -> str:\n280\t    \"\"\"Deterministic-vs-model dispatch for one owner's findings (spec section 12).\"\"\"\n281\t\n282\t    if owner in DETERMINISTIC_ONLY_OWNERS:\n283\t        return \"deterministic\"\n284\t    if owner in MODEL_ONLY_OWNERS:\n285\t        return \"model\"\n286\t    if owner not in CONDITIONAL_OWNERS:\n287\t        raise RepairEngineError(\"integrity\", f\"owner {owner!r} has no dispatch rule\", {\"owner\": owner})\n288\t    # unit visual: deterministic only if every named key is an authoritative or\n289\t    # library visual brief; a model may never touch one (spec section 13).\n290\t    briefs = {\n291\t        brief.get(\"key\"): brief\n292\t        for brief in state.get(\"visual_briefs\", [])\n293\t        if isinstance(brief, Mapping)\n294\t    }\n295\t    for finding in findings:\n296\t        key = str(finding.get(\"boundary\", \"\")).strip(\"/\").split(\"/\")[-1]\n297\t        brief = briefs.get(key)\n298\t        authoritative = bool(brief.get(\"authoritative\")) if isinstance(brief, Mapping) else False\n299\t        if not authoritative:\n300\t            return \"model\"\n301\t    return \"deterministic\"\n302\t\n303\t\n304\tdef _escape_token(token: str) -> str:\n305\t    return token.replace(\"~\", \"~0\").replace(\"/\", \"~1\")\n306\t\n307\t\n308\tdef json_pointer_diff(parent: Any, child: Any, path: str = \"\") -> set[str]:\n309\t    \"\"\"Every leaf JSON pointer at which ``parent`` and ``child`` differ.\"\"\"\n310\t\n311\t    if parent == child:\n312\t        return set()\n313\t    if isinstance(parent, Mapping) and isinstance(child, Mapping):\n314\t        diffs: set[str] = set()\n315\t        for key in sorted(set(parent) | set(child)):\n316\t            sub = f\"{path}/{_escape_token(str(key))}\"\n317\t            if key not in parent or key not in child:\n318\t                diffs.add(sub)\n319\t            else:\n320\t                diffs |= json_pointer_diff(parent[key], child[key], sub)\n321\t        return diffs\n322\t    if isinstance(parent, list) and isinstance(child, list):\n323\t        diffs = set()\n324\t        for index in range(max(len(parent), len(child))):\n325\t            sub = f\"{path}/{index}\"\n326\t            if index >= len(parent) or index >= len(child):\n327\t                diffs.add(sub)\n328\t            else:\n329\t                diffs |= json_pointer_diff(parent[index], child[index], sub)\n330\t        return diffs\n331\t    return {path or \"/\"}\n332\t\n333\t\n334\tdef within_boundary(pointer: str, allowed: Sequence[str]) -> bool:\n335\t    \"\"\"Whether ``pointer`` is exactly, or nested under, one declared boundary pointer.\"\"\"\n336\t\n337\t    return any(pointer == allow or pointer.startswith(f\"{allow}/\") for allow in allowed)\n338\t\n339\t\n340\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n341\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n342\t\n343\t\n344\tdef _attempt_key(unit_id: str, owner: str, fingerprint: str) -> str:\n345\t    return f\"repair|{unit_id}|{owner}|{fingerprint}\"\n346\t\n347\t\n348\tdef _repeat_key(unit_id: str, owner: str, fingerprint: str) -> str:\n349\t    return f\"repeat|{unit_id}|{owner}|{fingerprint}\"\n350\t\n351\t\n352\t# --------------------------------------------------------------------------\n353\t# D17_CLASSIFY_UNIT_FINDINGS\n354\t# --------------------------------------------------------------------------\n355\t\n356\t\n357\tdef D17_CLASSIFY_UNIT_FINDINGS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n358\t    \"\"\"Total one-owner partition of the current findings, or honest exhaustion.\n359\t\n360\t    Reads whichever repairable branch reached it: a `pending_guard` carrying a\n361\t    `findings` list from D08/D09/D12/D14/D16, or a `pending_failure` a D91\n362\t    model-repair classification left with no structured findings at all. Every\n363\t    blocking finding appears in exactly one owner's partition entry; an\n364\t    unowned or cross-owner-contaminated finding is a system fault, never a\n365\t    silently dropped one (spec section 6.2 D17 row).\n366\t    \"\"\"\n367\t\n368\t    unit_id = state.get(\"selected_unit_id\")\n369\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n370\t    require(\n371\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n372\t        \"integrity\",\n373\t        \"an accepted unit can never re-enter finding classification\",\n374\t        unit_id=unit_id,\n375\t    )\n376\t\n377\t    artifact_heads = state.get(\"artifact_heads\") or {}\n378\t    guard_record = state.get(\"pending_guard\")\n379\t    pending_failure = state.get(\"pending_failure\")\n380\t    update: dict[str, Any] = {}\n381\t\n382\t    if isinstance(pending_failure, Mapping) and pending_failure.get(\"classification\") == \"repair\":\n383\t        job_id = pending_failure.get(\"job_id\")\n384\t        owner = {\n385\t            \"M02_CREATE_UNIT_DOMAIN_DATA\": \"curriculum domain\",\n386\t            \"M03_WRITE_UNIT_CONTENT\": \"unit content\",\n387\t            \"M04_CREATE_UNIT_VISUALS\": \"unit visual\",\n388\t            \"M01_RESEARCH_UNIT_SOURCES\": \"source interpretation\",\n389\t            \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": None,\n390\t        }.get(job_id)\n391\t        require(\n392\t            owner in REPAIR_OWNERS,\n393\t            \"invalid_input\",\n394\t            f\"model failure for {job_id!r} maps to no known repair owner\",\n395\t            job_id=job_id,\n396\t        )\n397\t        raw_findings = [\n398\t            {\n399\t                \"owner\": owner,\n400\t                \"pointer\": f\"/{CHANNEL_BY_OWNER[owner]}\",\n401\t                \"check_id\": pending_failure.get(\"failure_class\"),\n402\t                \"message\": pending_failure.get(\"detail\") or pending_failure.get(\"message\") or \"\",\n403\t            }\n404\t        ]\n405\t        source_node = \"D91_CLASSIFY_MODEL_FAILURE\"\n406\t        update[\"pending_failure\"] = None\n407\t    else:\n408\t        require(isinstance(guard_record, Mapping), \"invalid_input\", \"D17 has no findings to classify\")\n409\t        detail = guard_record.get(\"detail\") if isinstance(guard_record.get(\"detail\"), Mapping) else {}\n410\t        raw_findings = detail.get(\"findings\")\n411\t        require(\n412\t            isinstance(raw_findings, list) and bool(raw_findings),\n413\t            \"invalid_input\",\n414\t            \"D17 was routed with an empty or missing findings list\",\n415\t        )\n416\t        source_node = str(guard_record.get(\"node\") or \"\")\n417\t\n418\t    normalized = normalize_findings(\n419\t        raw_findings, unit_id=unit_id, source_node=source_node, artifact_heads=artifact_heads\n420\t    )\n421\t\n422\t    by_owner: dict[str, list[dict[str, Any]]] = {}\n423\t    for finding in normalized:\n424\t        by_owner.setdefault(finding[\"owner\"], []).append(finding)\n425\t\n426\t    counters = dict(state.get(\"attempt_counters\") or {})\n427\t    exhausted: list[dict[str, Any]] = []\n428\t    partitions: list[dict[str, Any]] = []\n429\t    for owner in REPAIR_OWNERS:\n430\t        members = by_owner.get(owner)\n431\t        if not members:\n432\t            continue\n433\t        # D17 owns only the repeated-fingerprint bound; the numeric attempt\n434\t        # bound is D18's row of spec section 6.2 (\"D18 ... attempt bound =\n435\t        # exhaustion\"), checked once D18 has reserved the next attempt ordinal.\n436\t        fingerprint = canonical_digest(sorted(m[\"fingerprint\"] for m in members))\n437\t        repeat_key = _repeat_key(unit_id, owner, fingerprint)\n438\t        prior_repeats = int(counters.get(repeat_key, 0))\n439\t        if prior_repeats >= MAX_FINGERPRINT_REPEATS:\n440\t            exhausted.append({\"owner\": owner, \"fingerprint\": fingerprint, \"bound\": \"fingerprint_bound\", \"repeats\": prior_repeats})\n441\t            continue\n442\t        attempt_key = _attempt_key(unit_id, owner, fingerprint)\n443\t        prior_attempts = int(counters.get(attempt_key, 0))\n444\t        partitions.append(\n445\t            {\n446\t                \"key\": canonical_digest({\"unit_id\": unit_id, \"owner\": owner, \"fingerprint\": fingerprint, \"attempt\": prior_attempts + 1}),\n447\t                \"unit_id\": unit_id,\n448\t                \"owner\": owner,\n449\t                \"findings\": members,\n450\t                \"fingerprint\": fingerprint,\n451\t                \"prior_repeats\": prior_repeats,\n452\t                \"prior_attempts\": prior_attempts,\n453\t                \"source_node\": source_node,\n454\t            }\n455\t        )\n456\t\n457\t    if exhausted:\n458\t        update.update(\n459\t            {\n460\t                \"finding_partitions\": partitions,\n461\t                \"unit_status\": {unit_id: \"REPAIRING\"},\n462\t                \"pending_guard\": _guard(\n463\t                    \"D17_CLASSIFY_UNIT_FINDINGS\", \"convergence_exhausted\",\n464\t                    unit_id=unit_id, exhausted=exhausted,\n465\t                ),\n466\t                \"terminal_candidate\": {\n467\t                    \"kind\": \"CONVERGENCE_EXHAUSTED\",\n468\t                    \"bound\": exhausted[0][\"bound\"],\n469\t                    \"counters\": counters,\n470\t                    \"fingerprints\": [dict(item) for item in exhausted],\n471\t                    \"last_findings\": normalized,\n472\t                },\n473\t            }\n474\t        )\n475\t        return update\n476\t\n477\t    require(bool(partitions), \"invalid_input\", \"no owner produced a repair partition\")\n478\t\n479\t    update.update(\n480\t        {\n481\t            \"finding_partitions\": partitions,\n482\t            \"unit_status\": {unit_id: \"REPAIRING\"},\n483\t            \"pending_guard\": _guard(\n484\t                \"D17_CLASSIFY_UNIT_FINDINGS\", \"partition_complete\",\n485\t                unit_id=unit_id, owners=[entry[\"owner\"] for entry in partitions],\n486\t            ),\n487\t        }\n488\t    )\n489\t    return update\n490\t\n491\t\n492\t# --------------------------------------------------------------------------\n493\t# D18_PLAN_TARGETED_UNIT_REPAIR\n494\t# --------------------------------------------------------------------------\n495\t\n496\t\n497\tdef D18_PLAN_TARGETED_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n498\t    \"\"\"Select exactly one partition member, in fixed owner order, and plan its repair.\"\"\"\n499\t\n500\t    unit_id = state.get(\"selected_unit_id\")\n501\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n502\t\n503\t    partitions = [\n504\t        entry\n505\t        for entry in state.get(\"finding_partitions\") or []\n506\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n507\t    ]\n508\t    require(bool(partitions), \"invalid_input\", \"D18 requires at least one classified partition\")\n509\t\n510\t    resolved = {\n511\t        entry.get(\"request_key\")\n512\t        for entry in state.get(\"retest_results\") or []\n513\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id and entry.get(\"resolved\")\n514\t    }\n515\t    open_requests = {\n516\t        entry.get(\"partition_key\")\n517\t        for entry in state.get(\"repair_requests\") or []\n518\t        if isinstance(entry, Mapping)\n519\t        and entry.get(\"unit_id\") == unit_id\n520\t        and entry.get(\"key\") not in resolved\n521\t    }\n522\t\n523\t    latest_by_owner: dict[str, dict[str, Any]] = {}\n524\t    for entry in partitions:\n525\t        latest_by_owner[entry[\"owner\"]] = entry\n526\t\n527\t    selected = None\n528\t    for owner in REPAIR_OWNERS:\n529\t        entry = latest_by_owner.get(owner)\n530\t        if entry is None or entry[\"key\"] in open_requests:\n531\t            continue\n532\t        selected = entry\n533\t        break\n534\t    require(selected is not None, \"invalid_input\", \"every classified partition already has an open repair request\")\n535\t\n536\t    counters = dict(state.get(\"attempt_counters\") or {})\n537\t    attempt_key = _attempt_key(unit_id, selected[\"owner\"], selected[\"fingerprint\"])\n538\t    ordinal = int(counters.get(attempt_key, 0)) + 1\n539\t    if ordinal > MAX_REPAIR_CHILDREN_PER_CHAIN:\n540\t        return {\n541\t            \"pending_guard\": _guard(\n542\t                \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"convergence_exhausted\",\n543\t                unit_id=unit_id, owner=selected[\"owner\"], ordinal=ordinal,\n544\t            ),\n545\t            \"terminal_candidate\": {\n546\t                \"kind\": \"CONVERGENCE_EXHAUSTED\",\n547\t                \"bound\": \"attempt_bound\",\n548\t                \"counters\": counters,\n549\t                \"fingerprints\": [selected[\"fingerprint\"]],\n550\t                \"last_findings\": selected[\"findings\"],\n551\t            },\n552\t        }\n553\t\n554\t    channel = CHANNEL_BY_OWNER[selected[\"owner\"]]\n555\t    stream = stream_id(unit_id, channel)\n556\t    boundary_pointers = sorted({finding[\"boundary\"] for finding in selected[\"findings\"]})\n557\t    parent_hash = next(\n558\t        (finding[\"parent_hash\"] for finding in selected[\"findings\"] if finding.get(\"parent_hash\")),\n559\t        None,\n560\t    )\n561\t    allowed_facts: dict[str, Any] = {}\n562\t    for finding in selected[\"findings\"]:\n563\t        allowed_facts.update(finding.get(\"allowed_facts\") or {})\n564\t\n565\t    request = {\n566\t        \"key\": canonical_digest({\"partition_key\": selected[\"key\"], \"attempt\": ordinal}),\n567\t        \"partition_key\": selected[\"key\"],\n568\t        \"unit_id\": unit_id,\n569\t        \"owner\": selected[\"owner\"],\n570\t        \"channel\": channel,\n571\t        \"stream\": stream,\n572\t        \"finding_ids\": [finding[\"finding_id\"] for finding in selected[\"findings\"]],\n573\t        \"boundary\": {\"json_pointers\": boundary_pointers},\n574\t        \"parent_hash\": parent_hash,\n575\t        \"allowed_facts\": allowed_facts,\n576\t        \"next_child_version\": None,\n577\t        \"invalidated_descendants\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n578\t        \"retest_order\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n579\t        \"attempt_ordinal\": ordinal,\n580\t        \"fingerprint\": selected[\"fingerprint\"],\n581\t        \"prior_repeats\": selected[\"prior_repeats\"],\n582\t        \"max_children\": MAX_REPAIR_CHILDREN_PER_CHAIN,\n583\t        \"max_fingerprint_repeats\": MAX_FINGERPRINT_REPEATS,\n584\t    }\n585\t\n586\t    return {\n587\t        \"attempt_counters\": {attempt_key: ordinal},\n588\t        \"repair_requests\": [request],\n589\t        \"pending_guard\": _guard(\n590\t            \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"repair_planned\",\n591\t            unit_id=unit_id, request_key=request[\"key\"],\n592\t        ),\n593\t    }\n594\t\n595\t\n596\t# --------------------------------------------------------------------------\n597\t# D19_ROUTE_UNIT_REPAIR\n598\t# --------------------------------------------------------------------------\n599\t\n600\t\n601\tdef _apply_pointer(body: Any, pointer: str, value: Any) -> Any:\n602\t    \"\"\"Return a copy of ``body`` with ``pointer`` (RFC 6901) set to ``value``.\"\"\"\n603\t\n604\t    tokens = [tok.replace(\"~1\", \"/\").replace(\"~0\", \"~\") for tok in pointer.strip(\"/\").split(\"/\") if tok != \"\"]\n605\t    if not tokens:\n606\t        return json.loads(json.dumps(value))\n607\t    root = json.loads(json.dumps(body)) if isinstance(body, (dict, list)) else {}\n608\t    cursor = root\n609\t    for token in tokens[:-1]:\n610\t        if isinstance(cursor, list):\n611\t            index = int(token)\n612\t            cursor = cursor[index]\n613\t        else:\n614\t            cursor = cursor.setdefault(token, {})\n615\t    last = tokens[-1]\n616\t    if isinstance(cursor, list):\n617\t        index = int(last)\n618\t        while len(cursor) <= index:\n619\t            cursor.append(None)\n620\t        cursor[index] = value\n621\t    else:\n622\t        cursor[last] = value\n623\t    return root\n624\t\n625\t\n626\tdef _deterministic_repair_candidate(\n627\t    request: Mapping[str, Any], parent_body: Mapping[str, Any]\n628\t) -> dict[str, Any]:\n629\t    \"\"\"Apply a code-owned, boundary-scoped correction to the parent body.\n630\t\n631\t    Every value this writes is derived from the request's own `allowed_facts`\n632\t    (facts the run already admitted), never invented: a deterministic repair\n633\t    with nothing admitted to correct a pointer with raises rather than leaving\n634\t    the pointer untouched, because a no-op staged as a repair would be an\n635\t    in-place repair wearing a versioned child's clothes.\n636\t    \"\"\"\n637\t\n638\t    body = parent_body\n639\t    allowed_facts = request.get(\"allowed_facts\") or {}\n640\t    for pointer in request[\"boundary\"][\"json_pointers\"]:\n641\t        if pointer not in allowed_facts:\n642\t            raise SystemFailure(\n643\t                \"invalid_input\",\n644\t                f\"deterministic repair has no admitted fact for boundary pointer {pointer!r}\",\n645\t                {\"unit_id\": request[\"unit_id\"], \"owner\": request[\"owner\"]},\n646\t            )\n647\t        body = _apply_pointer(body, pointer, allowed_facts[pointer])\n648\t    return body\n649\t\n650\t\n651\tdef D19_ROUTE_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n652\t    \"\"\"Route the planned repair request to its deterministic producer or to M06.\"\"\"\n653\t\n654\t    unit_id = state.get(\"selected_unit_id\")\n655\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n656\t\n657\t    requests = [\n658\t        entry\n659\t        for entry in state.get(\"repair_requests\") or []\n660\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n661\t    ]\n662\t    require(bool(requests), \"invalid_input\", \"D19 requires a planned repair request\")\n663\t    request = requests[-1]\n664\t\n665\t    partitions = {\n666\t        entry[\"key\"]: entry\n667\t        for entry in state.get(\"finding_partitions\") or []\n668\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n669\t    }\n670\t    partition = partitions.get(request[\"partition_key\"])\n671\t    require(partition is not None, \"join\", \"the routed repair request names no known partition\")\n672\t    findings = partition[\"findings\"]\n673\t\n674\t    invalidation = {\n675\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"invalidation\"}),\n676\t        \"unit_id\": unit_id,\n677\t        \"request_key\": request[\"key\"],\n678\t        \"owner\": request[\"owner\"],\n679\t        \"invalidated_descendants\": request[\"invalidated_descendants\"],\n680\t        \"retest_order\": request[\"retest_order\"],\n681\t    }\n682\t\n683\t    route = route_owner(request[\"owner\"], state=state, findings=findings)\n684\t    stream = request[\"stream\"]\n685\t    heads = state.get(\"artifact_heads\") or {}\n686\t    parent_head = heads.get(stream)\n687\t\n688\t    if route == \"model\":\n689\t        artifact_versions = state.get(\"artifact_versions\") or []\n690\t        parent_body = None\n691\t        if isinstance(parent_head, Mapping):\n692\t            for record in artifact_versions:\n693\t                if (\n694\t                    isinstance(record, Mapping)\n695\t                    and record.get(\"stream\") == stream\n696\t                    and record.get(\"hash\") == parent_head.get(\"hash\")\n697\t                ):\n698\t                    parent_body = record.get(\"body\")\n699\t                    break\n700\t        require(isinstance(parent_body, Mapping), \"invalid_input\", \"no admitted parent body to repair\", stream=stream)\n701\t\n702\t        packet = worker_packet(\n703\t            run_id=state.get(\"run_id\"),\n704\t            episode_id=state.get(\"episode_id\"),\n705\t            correlation_key=f\"{request['key']}/M06\",\n706\t            projection={\n707\t                \"owner\": request[\"owner\"],\n708\t                \"findings\": [\n709\t                    {\n710\t                        \"finding_id\": finding[\"finding_id\"],\n711\t                        \"owner\": finding[\"owner\"],\n712\t                        \"pointer\": finding[\"boundary\"],\n713\t                        \"message\": finding[\"message\"],\n714\t                    }\n715\t                    for finding in findings\n716\t                ],\n717\t                \"parent\": {\n718\t                    \"artifact_name\": f\"{request['channel']}:{unit_id}\",\n719\t                    \"artifact_body\": json.dumps(parent_body, sort_keys=True),\n720\t                    \"channel\": request[\"channel\"],\n721\t                    \"unit_id\": unit_id,\n722\t                    \"parent_sha256\": parent_head.get(\"hash\"),\n723\t                },\n724\t                \"boundary\": request[\"boundary\"],\n725\t                \"allowed_facts\": request.get(\"allowed_facts\") or {},\n726\t                \"invalidated_descendants\": request[\"invalidated_descendants\"],\n727\t                \"retest_order\": request[\"retest_order\"],\n728\t            },\n729\t        )\n730\t        return {\n731\t            \"invalidations\": [invalidation],\n732\t            \"pending_packet\": staged_dispatch(\"M06_REPAIR_NAMED_UNIT_ARTIFACT\", [packet]),\n733\t            \"pending_guard\": _guard(\n734\t                \"D19_ROUTE_UNIT_REPAIR\", \"model_repair\", unit_id=unit_id, request_key=request[\"key\"]\n735\t            ),\n736\t        }\n737\t\n738\t    # Deterministic route: this node both selects and produces the candidate,\n739\t    # since D20 is the one and only admission authority and no intervening\n740\t    # dispatch node exists on the deterministic side (spec section 12: a\n741\t    # deterministic repair producer \"receives no prompt\").\n742\t    parent_body, current_hash, _current_version, _head_tracked = _current_parent(state, stream)\n743\t    new_body = _deterministic_repair_candidate(request, parent_body)\n744\t    candidate = {\n745\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n746\t        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n747\t        \"pre_admission\": True,\n748\t        \"stream\": stream,\n749\t        \"channel\": request[\"channel\"],\n750\t        \"unit_id\": unit_id,\n751\t        \"request_key\": request[\"key\"],\n752\t        \"owner\": request[\"owner\"],\n753\t        \"parent_sha256\": current_hash,\n754\t        \"addressed_finding_ids\": request[\"finding_ids\"],\n755\t        \"body\": new_body,\n756\t    }\n757\t    return {\n758\t        \"invalidations\": [invalidation],\n759\t        \"artifact_versions\": [candidate],\n760\t        \"pending_guard\": _guard(\n761\t            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n762\t        ),\n763\t    }\n764\t\n765\t\n766\t# --------------------------------------------------------------------------\n767\t# D20_ADMIT_UNIT_REPAIR\n768\t# --------------------------------------------------------------------------\n769\t\n770\t\n771\tdef _latest_deterministic_candidate(\n772\t    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n773\t) -> dict[str, Any] | None:\n774\t    matches = [\n775\t        dict(record)\n776\t        for record in artifact_versions\n777\t        if isinstance(record, Mapping)\n778\t        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n779\t        and record.get(\"stream\") == stream\n780\t        and record.get(\"request_key\") == request_key\n781\t    ]\n782\t    return matches[-1] if matches else None\n783\t\n784\t\n785\tdef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool]:\n786\t    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n787\t\n788\t    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n789\t    layout does not (it is admitted by D13 as a plain append-unique version,\n790\t    the same convention `review.py` already reads it under). Both shapes\n791\t    resolve to one parent here so D20 admits either uniformly, and the fourth\n792\t    element tells the caller whether `artifact_heads` may legally be written.\n793\t    \"\"\"\n794\t\n795\t    heads = state.get(\"artifact_heads\") or {}\n796\t    head = heads.get(stream)\n797\t    artifact_versions = state.get(\"artifact_versions\") or []\n798\t    if isinstance(head, Mapping):\n799\t        for record in artifact_versions:\n800\t            if (\n801\t                isinstance(record, Mapping)\n802\t                and record.get(\"stream\") == stream\n803\t                and record.get(\"hash\") == head.get(\"hash\")\n804\t            ):\n805\t                return record.get(\"body\") or {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n806\t        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n807\t\n808\t    candidates = [\n809\t        record\n810\t        for record in artifact_versions\n811\t        if isinstance(record, Mapping)\n812\t        and record.get(\"stream\") == stream\n813\t        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n814\t    ]\n815\t    if not candidates:\n816\t        return {}, None, 0, False\n817\t    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n818\t    return latest.get(\"body\") or {}, latest.get(\"hash\"), int(latest.get(\"version\", 0)), False\n819\t\n820\t\n821\tdef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n822\t    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n823\t\n824\t    Recomputes the parent/child diff itself rather than trusting a model's own\n825\t    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n826\t    child that does not descend from the current head, is `SystemFailure`\n827\t    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n828\t    routed repairable finding, because a boundary violation is a build/model\n829\t    defect, not a product outcome to retry.\n830\t    \"\"\"\n831\t\n832\t    unit_id = state.get(\"selected_unit_id\")\n833\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n834\t\n835\t    requests = [\n836\t        entry\n837\t        for entry in state.get(\"repair_requests\") or []\n838\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n839\t    ]\n840\t    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n841\t    request = requests[-1]\n842\t    stream = request[\"stream\"]\n843\t    boundary = request[\"boundary\"][\"json_pointers\"]\n844\t    heads = state.get(\"artifact_heads\") or {}\n845\t    parent_head = heads.get(stream)\n846\t    artifact_versions = state.get(\"artifact_versions\") or []\n847\t\n848\t    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n849\t\n850\t    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n851\t    deterministic_candidate = _latest_deterministic_candidate(\n852\t        artifact_versions, stream=stream, request_key=request[\"key\"]\n853\t    )\n854\t    require(\n855\t        (model_candidate is not None) != (deterministic_candidate is not None),\n856\t        \"join\",\n857\t        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n858\t        unit_id=unit_id,\n859\t    )\n860\t\n861\t    if model_candidate is not None:\n862\t        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n863\t        child = payload.get(\"candidate_child\") or {}\n864\t        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n865\t        try:\n866\t            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n867\t        except (TypeError, ValueError) as error:\n868\t            raise SystemFailure(\n869\t                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n870\t            ) from error\n871\t        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n872\t    else:\n873\t        new_body = deterministic_candidate[\"body\"]\n874\t        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n875\t\n876\t    require(\n877\t        declared_parent_sha == current_hash,\n878\t        \"integrity\",\n879\t        \"the repair candidate's declared parent is not the current head (stale repair)\",\n880\t        stream=stream, declared=declared_parent_sha, current=current_hash,\n881\t    )\n882\t\n883\t    diff = json_pointer_diff(parent_body, new_body)\n884\t    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n885\t    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n886\t    require(\n887\t        not out_of_bound,\n888\t        \"integrity\",\n889\t        \"a repair candidate changed bytes outside its declared boundary\",\n890\t        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n891\t    )\n892\t\n893\t    child_record = {\n894\t        \"stream\": stream,\n895\t        \"version\": current_version + 1,\n896\t        \"parent_hash\": current_hash,\n897\t        \"hash\": canonical_digest(new_body),\n898\t        \"body\": new_body,\n899\t        \"minted_by\": \"targeted_repair_admission\",\n900\t        \"unit_id\": unit_id,\n901\t        \"channel\": request[\"channel\"],\n902\t        \"request_key\": request[\"key\"],\n903\t        \"owner\": request[\"owner\"],\n904\t        \"attempt\": request[\"attempt_ordinal\"],\n905\t    }\n906\t    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n907\t\n908\t    update: dict[str, Any] = {\n909\t        \"artifact_versions\": [child_record],\n910\t        \"pending_guard\": _guard(\n911\t            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n912\t            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n913\t        ),\n914\t    }\n915\t    if head_tracked:\n916\t        update[\"artifact_heads\"] = {\n917\t            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n918\t        }\n919\t    return update\n920\t\n921\t\n922\t# --------------------------------------------------------------------------\n923\t# D21_RETEST_REQUIRED_DESCENDANTS\n924\t# --------------------------------------------------------------------------\n925\t\n926\t\n927\tdef D21_RETEST_REQUIRED_DESCENDANTS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n928\t    \"\"\"Dispatch the earliest node of the fixed retest DAG, or close the frontier.\n929\t\n930\t    Dispatches exactly once per repair admission: the first named node's own\n931\t    success guard already re-enters the rest of the normal unit path (D07\n932\t    through D16), so this never loops internally and never names a model node\n933\t    as the stored destination (spec section 6.2 D92/D21: a model destination in\n934\t    a stored frontier is a system fault).\n935\t    \"\"\"\n936\t\n937\t    unit_id = state.get(\"selected_unit_id\")\n938\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n939\t\n940\t    invalidations = [\n941\t        entry\n942\t        for entry in state.get(\"invalidations\") or []\n943\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n944\t    ]\n945\t    require(bool(invalidations), \"invalid_input\", \"D21 requires an admitted invalidation record\")\n946\t    invalidation = invalidations[-1]\n947\t\n948\t    dispatched = {\n949\t        entry.get(\"request_key\")\n950\t        for entry in state.get(\"retest_results\") or []\n951\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n952\t    }\n953\t\n954\t    retest_order = invalidation[\"retest_order\"]\n955\t    request_key = invalidation[\"request_key\"]\n956\t    if not retest_order:\n957\t        return {\n958\t            \"pending_guard\": _guard(\n959\t                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n960\t            )\n961\t        }\n962\t\n963\t    result = {\n964\t        \"key\": canonical_digest({\"request_key\": request_key, \"kind\": \"retest_dispatch\"}),\n965\t        \"unit_id\": unit_id,\n966\t        \"request_key\": request_key,\n967\t        \"owner\": invalidation[\"owner\"],\n968\t        \"retest_order\": list(retest_order),\n969\t        \"dispatched_to\": retest_order[0],\n970\t        \"resolved\": True,\n971\t    }\n972\t\n973\t    if request_key in dispatched:\n974\t        return {\n975\t            \"pending_guard\": _guard(\n976\t                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n977\t            )\n978\t        }\n979\t\n980\t    return {\n981\t        \"retest_results\": [result],\n982\t        \"pending_guard\": _guard(\n983\t            \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_incomplete\",\n984\t            unit_id=unit_id, destination=retest_order[0],\n985\t        ),\n986\t    }\n987\t"}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"a5e36bfb-852f-4ead-b65e-1e5ab4319491","timestamp":"2026-08-12T21:59:35.375Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/runtime/langgraph_factory/repair.py","content":"\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n\nOwns finding classification, one-partition-member repair planning, deterministic\nvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\nunit repair cycle here and reused by the workbook repair cycle N32 builds over\n`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\nmachinery is one engine, not a per-caller copy).\n\nNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\nregistered as graph nodes yet (that registration is N32's write, once\n`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\nscoped `(state, runtime_context) -> update` callables in the same shape N23's\n`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n`nodes.deterministic_node()`. A future registration step binds them to their\ncatalogue rows without changing this module.\n\nEvery finding this engine classifies is normalized to spec section 12's\n`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\nOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n(code-owned), and a model review's own `category` field is deliberately never\nread as an owner -- `owner_for_review_category()` is the one place a category\nstring is mapped to the five-owner vocabulary, and an unmapped category is a\nsystem fault, not a silent guess.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any\n\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    latest_model_candidate,\n    require,\n    staged_dispatch,\n    stream_id,\n    worker_packet,\n)\n\n__all__ = [\n    \"REPAIR_OWNERS\",\n    \"CHANNEL_BY_OWNER\",\n    \"MODEL_ONLY_OWNERS\",\n    \"DETERMINISTIC_ONLY_OWNERS\",\n    \"CONDITIONAL_OWNERS\",\n    \"RETEST_FIRST_NODE\",\n    \"RETEST_ORDER_BY_OWNER\",\n    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n    \"MAX_FINGERPRINT_REPEATS\",\n    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n    \"RepairEngineError\",\n    \"owner_for_review_category\",\n    \"normalize_findings\",\n    \"finding_fingerprint\",\n    \"route_owner\",\n    \"json_pointer_diff\",\n    \"within_boundary\",\n    \"D17_CLASSIFY_UNIT_FINDINGS\",\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n    \"D19_ROUTE_UNIT_REPAIR\",\n    \"D20_ADMIT_UNIT_REPAIR\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n]\n\n\nclass RepairEngineError(SystemFailure):\n    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n\n\n# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n# this set is a legal `owner`; a finding naming anything else fails closed.\nREPAIR_OWNERS: tuple[str, ...] = (\n    \"source interpretation\",\n    \"curriculum domain\",\n    \"unit content\",\n    \"unit visual\",\n    \"unit layout\",\n)\n\n# The artifact-versions channel each owner's repair targets. Source\n# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n# is a pointer inside the same admitted domain body a curriculum-domain defect\n# would touch, differing only in which pointers are named and in dispatch\n# eligibility below.\nCHANNEL_BY_OWNER: Mapping[str, str] = {\n    \"curriculum domain\": \"domain\",\n    \"source interpretation\": \"domain\",\n    \"unit content\": \"content\",\n    \"unit visual\": \"visuals\",\n    \"unit layout\": \"layout\",\n}\n\n# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n# table. A curriculum-domain or unit-content defect is model-owned outright.\n# Layout has a deterministic renderer/template repair path and no model path in\n# this generation, so it is always deterministic. Source interpretation could\n# legally refetch deterministically when a locator remains authorized; this\n# generation always routes it to M06 rather than re-implementing a fetcher here\n# (repair.py owns the routing table, not a second source-retrieval stack), and\n# that choice is exactly the one spec section 12 leaves open (\"M06 repairs only\n# the named interpretation ... admission is code-owned\"). Unit visual is the one\n# genuinely conditional row: an authoritative/library visual is always\n# rerun deterministically (a model may never assert authoritative circuit/pin\n# detail per spec section 13), and a non-authoritative asset is model-eligible.\nMODEL_ONLY_OWNERS: frozenset[str] = frozenset(\n    {\"curriculum domain\", \"unit content\", \"source interpretation\"}\n)\nDETERMINISTIC_ONLY_OWNERS: frozenset[str] = frozenset({\"unit layout\"})\nCONDITIONAL_OWNERS: frozenset[str] = frozenset({\"unit visual\"})\n\n# The first deterministic node of each owner's fixed retest chain (spec section\n# 12's table). Every value here is a real `RESUME_REENTRY_DESTINATIONS` member\n# of `unit_graph.py`; the remaining steps of a chain are not dispatched by D21 at\n# all -- they are the already-wired unit-path edges the first node's own success\n# guard reaches on its own (D07 -> D08 -> D09 -> D10 -> ... -> D16).\nRETEST_FIRST_NODE: Mapping[str, str] = {\n    \"source interpretation\": \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    \"curriculum domain\": \"D08_VALIDATE_DOMAIN\",\n    \"unit content\": \"D09_VALIDATE_CONTENT\",\n    \"unit visual\": \"D10_COMPILE_VISUAL_BRIEFS\",\n    \"unit layout\": \"D13_RENDER_UNIT\",\n}\n\nRETEST_ORDER_BY_OWNER: Mapping[str, tuple[str, ...]] = {\n    \"source interpretation\": (\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\", \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\",\n        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"curriculum domain\": (\n        \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\",\n        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit content\": (\n        \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\",\n        \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n        \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit visual\": (\n        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit layout\": (\n        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n}\n\n# Frozen limits (spec section 12): three repair children per owner/finding\n# chain, two occurrences of the same fingerprint. The earliest reached bound\n# controls -- `D18_PLAN_TARGETED_UNIT_REPAIR` checks both and never dispatches\n# a fourth child or a third repeat of the same defect.\nMAX_REPAIR_CHILDREN_PER_CHAIN = 3\nMAX_FINGERPRINT_REPEATS = 2\n\n# A model review's own `category` vocabulary is never trusted directly; this is\n# the one code-owned mapping from a reviewer's free-text category to the fixed\n# five-owner vocabulary. Substring match on a normalized (lowercased) category\n# keeps the rubric free to phrase categories in prose while still refusing an\n# unmapped one rather than guessing.\n_REVIEW_CATEGORY_OWNER_KEYWORDS: tuple[tuple[str, str], ...] = (\n    (\"source\", \"source interpretation\"),\n    (\"citation\", \"source interpretation\"),\n    (\"domain\", \"curriculum domain\"),\n    (\"fact\", \"curriculum domain\"),\n    (\"content\", \"unit content\"),\n    (\"prose\", \"unit content\"),\n    (\"pedagog\", \"unit content\"),\n    (\"readab\", \"unit content\"),\n    (\"safety\", \"unit content\"),\n    (\"bloom\", \"unit content\"),\n    (\"visual\", \"unit visual\"),\n    (\"image\", \"unit visual\"),\n    (\"diagram\", \"unit visual\"),\n    (\"layout\", \"unit layout\"),\n    (\"page\", \"unit layout\"),\n    (\"render\", \"unit layout\"),\n)\n\nDETERMINISTIC_REPAIR_CANDIDATE_KIND = \"deterministic_repair_candidate\"\n\n\ndef owner_for_review_category(category: Any) -> str | None:\n    \"\"\"Map one M05 review `category` string to a code-owned owner, or None.\n\n    Never returns the model's own words: the return value is always one member\n    of `REPAIR_OWNERS`, decided by this frozen table, or None when no keyword\n    matches -- which the caller treats as an unknown-owner system fault, not a\n    best guess.\n    \"\"\"\n\n    if not isinstance(category, str) or not category:\n        return None\n    lowered = category.lower()\n    for keyword, owner in _REVIEW_CATEGORY_OWNER_KEYWORDS:\n        if keyword in lowered:\n            return owner\n    return None\n\n\ndef finding_fingerprint(owner: str, boundary: Sequence[str], message: Any) -> str:\n    \"\"\"The stable identity of a defect across repeated repair attempts.\n\n    Keyed on owner, boundary pointers, and message -- not on `finding_id` (which\n    a fresh classification pass may mint differently) and not on attempt number\n    (which must never enter a fingerprint that exists to detect repeated\n    failure across attempts).\n    \"\"\"\n\n    return canonical_digest({\"owner\": owner, \"boundary\": sorted(boundary), \"message\": str(message)})\n\n\ndef normalize_findings(\n    raw_findings: Sequence[Mapping[str, Any]],\n    *,\n    unit_id: str,\n    source_node: str,\n    artifact_heads: Mapping[str, Any],\n) -> list[dict[str, Any]]:\n    \"\"\"Normalize a raw findings list to spec section 12's one shape.\n\n    Fails closed (`SystemFailure`) on any finding with no owner, an owner\n    outside the fixed vocabulary, or a missing pointer -- `D17` never routes a\n    zero- or unknown-owner finding into a partition; it raises before one is\n    built. A caller with only one already-classified finding (the D91\n    model-repair-failure case) still goes through this function, so the same\n    checks apply uniformly.\n    \"\"\"\n\n    normalized: list[dict[str, Any]] = []\n    for raw in raw_findings:\n        if not isinstance(raw, Mapping):\n            raise SystemFailure(\n                \"invalid_input\", \"a finding must be a JSON object\", {\"source_node\": source_node}\n            )\n        owner = raw.get(\"owner\")\n        if owner not in REPAIR_OWNERS:\n            raise SystemFailure(\n                \"invalid_input\",\n                f\"finding declares owner {owner!r}, which is not one of the five known owners\",\n                {\"unit_id\": unit_id, \"source_node\": source_node, \"owner\": owner},\n            )\n        pointer = raw.get(\"pointer\")\n        if not isinstance(pointer, str) or not pointer:\n            raise SystemFailure(\n                \"invalid_input\", \"finding declares no boundary pointer\",\n                {\"unit_id\": unit_id, \"owner\": owner},\n            )\n        channel = CHANNEL_BY_OWNER[owner]\n        parent_head = artifact_heads.get(stream_id(unit_id, channel))\n        parent_hash = parent_head.get(\"hash\") if isinstance(parent_head, Mapping) else None\n        message = raw.get(\"message\", \"\")\n        finding_id = canonical_digest(\n            {\"unit_id\": unit_id, \"owner\": owner, \"pointer\": pointer, \"message\": str(message)}\n        )\n        raw_facts = raw.get(\"allowed_facts\")\n        allowed_facts = dict(raw_facts) if isinstance(raw_facts, Mapping) else {}\n        normalized.append(\n            {\n                \"finding_id\": finding_id,\n                \"evidence_key\": str(raw.get(\"check_id\", source_node)),\n                \"owner\": owner,\n                \"boundary\": pointer,\n                \"parent_hash\": parent_hash,\n                \"fingerprint\": finding_fingerprint(owner, [pointer], message),\n                \"message\": str(message),\n                \"unit_id\": unit_id,\n                \"source_node\": source_node,\n                \"allowed_facts\": allowed_facts,\n            }\n        )\n    return normalized\n\n\ndef route_owner(owner: str, *, state: Mapping[str, Any], findings: Sequence[Mapping[str, Any]]) -> str:\n    \"\"\"Deterministic-vs-model dispatch for one owner's findings (spec section 12).\"\"\"\n\n    if owner in DETERMINISTIC_ONLY_OWNERS:\n        return \"deterministic\"\n    if owner in MODEL_ONLY_OWNERS:\n        return \"model\"\n    if owner not in CONDITIONAL_OWNERS:\n        raise RepairEngineError(\"integrity\", f\"owner {owner!r} has no dispatch rule\", {\"owner\": owner})\n    # unit visual: deterministic only if every named key is an authoritative or\n    # library visual brief; a model may never touch one (spec section 13).\n    briefs = {\n        brief.get(\"key\"): brief\n        for brief in state.get(\"visual_briefs\", [])\n        if isinstance(brief, Mapping)\n    }\n    for finding in findings:\n        key = str(finding.get(\"boundary\", \"\")).strip(\"/\").split(\"/\")[-1]\n        brief = briefs.get(key)\n        authoritative = bool(brief.get(\"authoritative\")) if isinstance(brief, Mapping) else False\n        if not authoritative:\n            return \"model\"\n    return \"deterministic\"\n\n\ndef _escape_token(token: str) -> str:\n    return token.replace(\"~\", \"~0\").replace(\"/\", \"~1\")\n\n\ndef json_pointer_diff(parent: Any, child: Any, path: str = \"\") -> set[str]:\n    \"\"\"Every leaf JSON pointer at which ``parent`` and ``child`` differ.\"\"\"\n\n    if parent == child:\n        return set()\n    if isinstance(parent, Mapping) and isinstance(child, Mapping):\n        diffs: set[str] = set()\n        for key in sorted(set(parent) | set(child)):\n            sub = f\"{path}/{_escape_token(str(key))}\"\n            if key not in parent or key not in child:\n                diffs.add(sub)\n            else:\n                diffs |= json_pointer_diff(parent[key], child[key], sub)\n        return diffs\n    if isinstance(parent, list) and isinstance(child, list):\n        diffs = set()\n        for index in range(max(len(parent), len(child))):\n            sub = f\"{path}/{index}\"\n            if index >= len(parent) or index >= len(child):\n                diffs.add(sub)\n            else:\n                diffs |= json_pointer_diff(parent[index], child[index], sub)\n        return diffs\n    return {path or \"/\"}\n\n\ndef within_boundary(pointer: str, allowed: Sequence[str]) -> bool:\n    \"\"\"Whether ``pointer`` is exactly, or nested under, one declared boundary pointer.\"\"\"\n\n    return any(pointer == allow or pointer.startswith(f\"{allow}/\") for allow in allowed)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef _attempt_key(unit_id: str, owner: str, fingerprint: str) -> str:\n    return f\"repair|{unit_id}|{owner}|{fingerprint}\"\n\n\ndef _repeat_key(unit_id: str, owner: str, fingerprint: str) -> str:\n    return f\"repeat|{unit_id}|{owner}|{fingerprint}\"\n\n\n# --------------------------------------------------------------------------\n# D17_CLASSIFY_UNIT_FINDINGS\n# --------------------------------------------------------------------------\n\n\ndef D17_CLASSIFY_UNIT_FINDINGS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Total one-owner partition of the current findings, or honest exhaustion.\n\n    Reads whichever repairable branch reached it: a `pending_guard` carrying a\n    `findings` list from D08/D09/D12/D14/D16, or a `pending_failure` a D91\n    model-repair classification left with no structured findings at all. Every\n    blocking finding appears in exactly one owner's partition entry; an\n    unowned or cross-owner-contaminated finding is a system fault, never a\n    silently dropped one (spec section 6.2 D17 row).\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter finding classification\",\n        unit_id=unit_id,\n    )\n\n    artifact_heads = state.get(\"artifact_heads\") or {}\n    guard_record = state.get(\"pending_guard\")\n    pending_failure = state.get(\"pending_failure\")\n    update: dict[str, Any] = {}\n\n    if isinstance(pending_failure, Mapping) and pending_failure.get(\"classification\") == \"repair\":\n        job_id = pending_failure.get(\"job_id\")\n        owner = {\n            \"M02_CREATE_UNIT_DOMAIN_DATA\": \"curriculum domain\",\n            \"M03_WRITE_UNIT_CONTENT\": \"unit content\",\n            \"M04_CREATE_UNIT_VISUALS\": \"unit visual\",\n            \"M01_RESEARCH_UNIT_SOURCES\": \"source interpretation\",\n            \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": None,\n        }.get(job_id)\n        require(\n            owner in REPAIR_OWNERS,\n            \"invalid_input\",\n            f\"model failure for {job_id!r} maps to no known repair owner\",\n            job_id=job_id,\n        )\n        raw_findings = [\n            {\n                \"owner\": owner,\n                \"pointer\": f\"/{CHANNEL_BY_OWNER[owner]}\",\n                \"check_id\": pending_failure.get(\"failure_class\"),\n                \"message\": pending_failure.get(\"detail\") or pending_failure.get(\"message\") or \"\",\n            }\n        ]\n        source_node = \"D91_CLASSIFY_MODEL_FAILURE\"\n        update[\"pending_failure\"] = None\n    else:\n        require(isinstance(guard_record, Mapping), \"invalid_input\", \"D17 has no findings to classify\")\n        detail = guard_record.get(\"detail\") if isinstance(guard_record.get(\"detail\"), Mapping) else {}\n        raw_findings = detail.get(\"findings\")\n        require(\n            isinstance(raw_findings, list) and bool(raw_findings),\n            \"invalid_input\",\n            \"D17 was routed with an empty or missing findings list\",\n        )\n        source_node = str(guard_record.get(\"node\") or \"\")\n\n    normalized = normalize_findings(\n        raw_findings, unit_id=unit_id, source_node=source_node, artifact_heads=artifact_heads\n    )\n\n    by_owner: dict[str, list[dict[str, Any]]] = {}\n    for finding in normalized:\n        by_owner.setdefault(finding[\"owner\"], []).append(finding)\n\n    counters = dict(state.get(\"attempt_counters\") or {})\n    exhausted: list[dict[str, Any]] = []\n    partitions: list[dict[str, Any]] = []\n    for owner in REPAIR_OWNERS:\n        members = by_owner.get(owner)\n        if not members:\n            continue\n        # D17 owns only the repeated-fingerprint bound; the numeric attempt\n        # bound is D18's row of spec section 6.2 (\"D18 ... attempt bound =\n        # exhaustion\"), checked once D18 has reserved the next attempt ordinal.\n        fingerprint = canonical_digest(sorted(m[\"fingerprint\"] for m in members))\n        repeat_key = _repeat_key(unit_id, owner, fingerprint)\n        prior_repeats = int(counters.get(repeat_key, 0))\n        if prior_repeats >= MAX_FINGERPRINT_REPEATS:\n            exhausted.append({\"owner\": owner, \"fingerprint\": fingerprint, \"bound\": \"fingerprint_bound\", \"repeats\": prior_repeats})\n            continue\n        attempt_key = _attempt_key(unit_id, owner, fingerprint)\n        prior_attempts = int(counters.get(attempt_key, 0))\n        partitions.append(\n            {\n                \"key\": canonical_digest({\"unit_id\": unit_id, \"owner\": owner, \"fingerprint\": fingerprint, \"attempt\": prior_attempts + 1}),\n                \"unit_id\": unit_id,\n                \"owner\": owner,\n                \"findings\": members,\n                \"fingerprint\": fingerprint,\n                \"prior_repeats\": prior_repeats,\n                \"prior_attempts\": prior_attempts,\n                \"source_node\": source_node,\n            }\n        )\n\n    if exhausted:\n        update.update(\n            {\n                \"finding_partitions\": partitions,\n                \"unit_status\": {unit_id: \"REPAIRING\"},\n                \"pending_guard\": _guard(\n                    \"D17_CLASSIFY_UNIT_FINDINGS\", \"convergence_exhausted\",\n                    unit_id=unit_id, exhausted=exhausted,\n                ),\n                \"terminal_candidate\": {\n                    \"kind\": \"CONVERGENCE_EXHAUSTED\",\n                    \"bound\": exhausted[0][\"bound\"],\n                    \"counters\": counters,\n                    \"fingerprints\": [dict(item) for item in exhausted],\n                    \"last_findings\": normalized,\n                },\n            }\n        )\n        return update\n\n    require(bool(partitions), \"invalid_input\", \"no owner produced a repair partition\")\n\n    update.update(\n        {\n            \"finding_partitions\": partitions,\n            \"unit_status\": {unit_id: \"REPAIRING\"},\n            \"pending_guard\": _guard(\n                \"D17_CLASSIFY_UNIT_FINDINGS\", \"partition_complete\",\n                unit_id=unit_id, owners=[entry[\"owner\"] for entry in partitions],\n            ),\n        }\n    )\n    return update\n\n\n# --------------------------------------------------------------------------\n# D18_PLAN_TARGETED_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef D18_PLAN_TARGETED_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Select exactly one partition member, in fixed owner order, and plan its repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    partitions = [\n        entry\n        for entry in state.get(\"finding_partitions\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(partitions), \"invalid_input\", \"D18 requires at least one classified partition\")\n\n    resolved = {\n        entry.get(\"request_key\")\n        for entry in state.get(\"retest_results\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id and entry.get(\"resolved\")\n    }\n    open_requests = {\n        entry.get(\"partition_key\")\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping)\n        and entry.get(\"unit_id\") == unit_id\n        and entry.get(\"key\") not in resolved\n    }\n\n    latest_by_owner: dict[str, dict[str, Any]] = {}\n    for entry in partitions:\n        latest_by_owner[entry[\"owner\"]] = entry\n\n    selected = None\n    for owner in REPAIR_OWNERS:\n        entry = latest_by_owner.get(owner)\n        if entry is None or entry[\"key\"] in open_requests:\n            continue\n        selected = entry\n        break\n    require(selected is not None, \"invalid_input\", \"every classified partition already has an open repair request\")\n\n    counters = dict(state.get(\"attempt_counters\") or {})\n    attempt_key = _attempt_key(unit_id, selected[\"owner\"], selected[\"fingerprint\"])\n    ordinal = int(counters.get(attempt_key, 0)) + 1\n    if ordinal > MAX_REPAIR_CHILDREN_PER_CHAIN:\n        return {\n            \"pending_guard\": _guard(\n                \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"convergence_exhausted\",\n                unit_id=unit_id, owner=selected[\"owner\"], ordinal=ordinal,\n            ),\n            \"terminal_candidate\": {\n                \"kind\": \"CONVERGENCE_EXHAUSTED\",\n                \"bound\": \"attempt_bound\",\n                \"counters\": counters,\n                \"fingerprints\": [selected[\"fingerprint\"]],\n                \"last_findings\": selected[\"findings\"],\n            },\n        }\n\n    channel = CHANNEL_BY_OWNER[selected[\"owner\"]]\n    stream = stream_id(unit_id, channel)\n    boundary_pointers = sorted({finding[\"boundary\"] for finding in selected[\"findings\"]})\n    parent_hash = next(\n        (finding[\"parent_hash\"] for finding in selected[\"findings\"] if finding.get(\"parent_hash\")),\n        None,\n    )\n    allowed_facts: dict[str, Any] = {}\n    for finding in selected[\"findings\"]:\n        allowed_facts.update(finding.get(\"allowed_facts\") or {})\n\n    request = {\n        \"key\": canonical_digest({\"partition_key\": selected[\"key\"], \"attempt\": ordinal}),\n        \"partition_key\": selected[\"key\"],\n        \"unit_id\": unit_id,\n        \"owner\": selected[\"owner\"],\n        \"channel\": channel,\n        \"stream\": stream,\n        \"finding_ids\": [finding[\"finding_id\"] for finding in selected[\"findings\"]],\n        \"boundary\": {\"json_pointers\": boundary_pointers},\n        \"parent_hash\": parent_hash,\n        \"allowed_facts\": allowed_facts,\n        \"next_child_version\": None,\n        \"invalidated_descendants\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n        \"retest_order\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n        \"attempt_ordinal\": ordinal,\n        \"fingerprint\": selected[\"fingerprint\"],\n        \"prior_repeats\": selected[\"prior_repeats\"],\n        \"max_children\": MAX_REPAIR_CHILDREN_PER_CHAIN,\n        \"max_fingerprint_repeats\": MAX_FINGERPRINT_REPEATS,\n    }\n\n    return {\n        \"attempt_counters\": {attempt_key: ordinal},\n        \"repair_requests\": [request],\n        \"pending_guard\": _guard(\n            \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"repair_planned\",\n            unit_id=unit_id, request_key=request[\"key\"],\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D19_ROUTE_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef _apply_pointer(body: Any, pointer: str, value: Any) -> Any:\n    \"\"\"Return a copy of ``body`` with ``pointer`` (RFC 6901) set to ``value``.\"\"\"\n\n    tokens = [tok.replace(\"~1\", \"/\").replace(\"~0\", \"~\") for tok in pointer.strip(\"/\").split(\"/\") if tok != \"\"]\n    if not tokens:\n        return json.loads(json.dumps(value))\n    root = json.loads(json.dumps(body)) if isinstance(body, (dict, list)) else {}\n    cursor = root\n    for token in tokens[:-1]:\n        if isinstance(cursor, list):\n            index = int(token)\n            cursor = cursor[index]\n        else:\n            cursor = cursor.setdefault(token, {})\n    last = tokens[-1]\n    if isinstance(cursor, list):\n        index = int(last)\n        while len(cursor) <= index:\n            cursor.append(None)\n        cursor[index] = value\n    else:\n        cursor[last] = value\n    return root\n\n\ndef _deterministic_repair_candidate(\n    request: Mapping[str, Any], parent_body: Mapping[str, Any]\n) -> dict[str, Any]:\n    \"\"\"Apply a code-owned, boundary-scoped correction to the parent body.\n\n    Every value this writes is derived from the request's own `allowed_facts`\n    (facts the run already admitted), never invented: a deterministic repair\n    with nothing admitted to correct a pointer with raises rather than leaving\n    the pointer untouched, because a no-op staged as a repair would be an\n    in-place repair wearing a versioned child's clothes.\n    \"\"\"\n\n    body = parent_body\n    allowed_facts = request.get(\"allowed_facts\") or {}\n    for pointer in request[\"boundary\"][\"json_pointers\"]:\n        if pointer not in allowed_facts:\n            raise SystemFailure(\n                \"invalid_input\",\n                f\"deterministic repair has no admitted fact for boundary pointer {pointer!r}\",\n                {\"unit_id\": request[\"unit_id\"], \"owner\": request[\"owner\"]},\n            )\n        body = _apply_pointer(body, pointer, allowed_facts[pointer])\n    return body\n\n\ndef D19_ROUTE_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Route the planned repair request to its deterministic producer or to M06.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    requests = [\n        entry\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(requests), \"invalid_input\", \"D19 requires a planned repair request\")\n    request = requests[-1]\n\n    partitions = {\n        entry[\"key\"]: entry\n        for entry in state.get(\"finding_partitions\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    }\n    partition = partitions.get(request[\"partition_key\"])\n    require(partition is not None, \"join\", \"the routed repair request names no known partition\")\n    findings = partition[\"findings\"]\n\n    invalidation = {\n        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"invalidation\"}),\n        \"unit_id\": unit_id,\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"invalidated_descendants\": request[\"invalidated_descendants\"],\n        \"retest_order\": request[\"retest_order\"],\n    }\n\n    route = route_owner(request[\"owner\"], state=state, findings=findings)\n    stream = request[\"stream\"]\n    heads = state.get(\"artifact_heads\") or {}\n    parent_head = heads.get(stream)\n\n    if route == \"model\":\n        artifact_versions = state.get(\"artifact_versions\") or []\n        parent_body = None\n        if isinstance(parent_head, Mapping):\n            for record in artifact_versions:\n                if (\n                    isinstance(record, Mapping)\n                    and record.get(\"stream\") == stream\n                    and record.get(\"hash\") == parent_head.get(\"hash\")\n                ):\n                    parent_body = record.get(\"body\")\n                    break\n        require(isinstance(parent_body, Mapping), \"invalid_input\", \"no admitted parent body to repair\", stream=stream)\n\n        packet = worker_packet(\n            run_id=state.get(\"run_id\"),\n            episode_id=state.get(\"episode_id\"),\n            correlation_key=f\"{request['key']}/M06\",\n            projection={\n                \"owner\": request[\"owner\"],\n                \"findings\": [\n                    {\n                        \"finding_id\": finding[\"finding_id\"],\n                        \"owner\": finding[\"owner\"],\n                        \"pointer\": finding[\"boundary\"],\n                        \"message\": finding[\"message\"],\n                    }\n                    for finding in findings\n                ],\n                \"parent\": {\n                    \"artifact_name\": f\"{request['channel']}:{unit_id}\",\n                    \"artifact_body\": json.dumps(parent_body, sort_keys=True),\n                    \"channel\": request[\"channel\"],\n                    \"unit_id\": unit_id,\n                    \"parent_sha256\": parent_head.get(\"hash\"),\n                },\n                \"boundary\": request[\"boundary\"],\n                \"allowed_facts\": request.get(\"allowed_facts\") or {},\n                \"invalidated_descendants\": request[\"invalidated_descendants\"],\n                \"retest_order\": request[\"retest_order\"],\n            },\n        )\n        return {\n            \"invalidations\": [invalidation],\n            \"pending_packet\": staged_dispatch(\"M06_REPAIR_NAMED_UNIT_ARTIFACT\", [packet]),\n            \"pending_guard\": _guard(\n                \"D19_ROUTE_UNIT_REPAIR\", \"model_repair\", unit_id=unit_id, request_key=request[\"key\"]\n            ),\n        }\n\n    # Deterministic route: this node both selects and produces the candidate,\n    # since D20 is the one and only admission authority and no intervening\n    # dispatch node exists on the deterministic side (spec section 12: a\n    # deterministic repair producer \"receives no prompt\").\n    parent_body, current_hash, _current_version, _head_tracked = _current_parent(state, stream)\n    new_body = _deterministic_repair_candidate(request, parent_body)\n    candidate = {\n        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n        \"pre_admission\": True,\n        \"stream\": stream,\n        \"channel\": request[\"channel\"],\n        \"unit_id\": unit_id,\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"parent_sha256\": current_hash,\n        \"addressed_finding_ids\": request[\"finding_ids\"],\n        \"body\": new_body,\n    }\n    return {\n        \"invalidations\": [invalidation],\n        \"artifact_versions\": [candidate],\n        \"pending_guard\": _guard(\n            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D20_ADMIT_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef _latest_deterministic_candidate(\n    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n) -> dict[str, Any] | None:\n    matches = [\n        dict(record)\n        for record in artifact_versions\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n        and record.get(\"stream\") == stream\n        and record.get(\"request_key\") == request_key\n    ]\n    return matches[-1] if matches else None\n\n\ndef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool]:\n    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n\n    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n    layout does not (it is admitted by D13 as a plain append-unique version,\n    the same convention `review.py` already reads it under). Both shapes\n    resolve to one parent here so D20 admits either uniformly, and the fourth\n    element tells the caller whether `artifact_heads` may legally be written.\n    \"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    head = heads.get(stream)\n    artifact_versions = state.get(\"artifact_versions\") or []\n    if isinstance(head, Mapping):\n        for record in artifact_versions:\n            if (\n                isinstance(record, Mapping)\n                and record.get(\"stream\") == stream\n                and record.get(\"hash\") == head.get(\"hash\")\n            ):\n                return record.get(\"body\") or {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n\n    candidates = [\n        record\n        for record in artifact_versions\n        if isinstance(record, Mapping)\n        and record.get(\"stream\") == stream\n        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n    ]\n    if not candidates:\n        return {}, None, 0, False\n    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n    return latest.get(\"body\") or {}, latest.get(\"hash\"), int(latest.get(\"version\", 0)), False\n\n\ndef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n\n    Recomputes the parent/child diff itself rather than trusting a model's own\n    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n    child that does not descend from the current head, is `SystemFailure`\n    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n    routed repairable finding, because a boundary violation is a build/model\n    defect, not a product outcome to retry.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    requests = [\n        entry\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n    request = requests[-1]\n    stream = request[\"stream\"]\n    boundary = request[\"boundary\"][\"json_pointers\"]\n    heads = state.get(\"artifact_heads\") or {}\n    parent_head = heads.get(stream)\n    artifact_versions = state.get(\"artifact_versions\") or []\n\n    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n\n    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n    deterministic_candidate = _latest_deterministic_candidate(\n        artifact_versions, stream=stream, request_key=request[\"key\"]\n    )\n    require(\n        (model_candidate is not None) != (deterministic_candidate is not None),\n        \"join\",\n        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n        unit_id=unit_id,\n    )\n\n    if model_candidate is not None:\n        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n        child = payload.get(\"candidate_child\") or {}\n        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n        try:\n            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n        except (TypeError, ValueError) as error:\n            raise SystemFailure(\n                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n            ) from error\n        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n    else:\n        new_body = deterministic_candidate[\"body\"]\n        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n\n    require(\n        declared_parent_sha == current_hash,\n        \"integrity\",\n        \"the repair candidate's declared parent is not the current head (stale repair)\",\n        stream=stream, declared=declared_parent_sha, current=current_hash,\n    )\n\n    diff = json_pointer_diff(parent_body, new_body)\n    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n    require(\n        not out_of_bound,\n        \"integrity\",\n        \"a repair candidate changed bytes outside its declared boundary\",\n        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n    )\n\n    child_record = {\n        \"stream\": stream,\n        \"version\": current_version + 1,\n        \"parent_hash\": current_hash,\n        \"hash\": canonical_digest(new_body),\n        \"body\": new_body,\n        \"minted_by\": \"targeted_repair_admission\",\n        \"unit_id\": unit_id,\n        \"channel\": request[\"channel\"],\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"attempt\": request[\"attempt_ordinal\"],\n    }\n    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n\n    update: dict[str, Any] = {\n        \"artifact_versions\": [child_record],\n        \"pending_guard\": _guard(\n            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n        ),\n    }\n    if head_tracked:\n        update[\"artifact_heads\"] = {\n            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n        }\n    return update\n\n\n# --------------------------------------------------------------------------\n# D21_RETEST_REQUIRED_DESCENDANTS\n# --------------------------------------------------------------------------\n\n\ndef D21_RETEST_REQUIRED_DESCENDANTS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Dispatch the earliest node of the fixed retest DAG, or close the frontier.\n\n    Dispatches exactly once per repair admission: the first named node's own\n    success guard already re-enters the rest of the normal unit path (D07\n    through D16), so this never loops internally and never names a model node\n    as the stored destination (spec section 6.2 D92/D21: a model destination in\n    a stored frontier is a system fault).\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    invalidations = [\n        entry\n        for entry in state.get(\"invalidations\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(invalidations), \"invalid_input\", \"D21 requires an admitted invalidation record\")\n    invalidation = invalidations[-1]\n\n    dispatched = {\n        entry.get(\"request_key\")\n        for entry in state.get(\"retest_results\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    }\n\n    retest_order = invalidation[\"retest_order\"]\n    request_key = invalidation[\"request_key\"]\n    if not retest_order:\n        return {\n            \"pending_guard\": _guard(\n                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n            )\n        }\n\n    result = {\n        \"key\": canonical_digest({\"request_key\": request_key, \"kind\": \"retest_dispatch\"}),\n        \"unit_id\": unit_id,\n        \"request_key\": request_key,\n        \"owner\": invalidation[\"owner\"],\n        \"retest_order\": list(retest_order),\n        \"dispatched_to\": retest_order[0],\n        \"resolved\": True,\n    }\n\n    if request_key in dispatched:\n        return {\n            \"pending_guard\": _guard(\n                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n            )\n        }\n\n    return {\n        \"retest_results\": [result],\n        \"pending_guard\": _guard(\n            \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_incomplete\",\n            unit_id=unit_id, destination=retest_order[0],\n        ),\n    }\n","numLines":987,"startLine":1,"totalLines":987}}}
