{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012aDPddD78WbKA3LW3hELzy","type":"tool_result","content":"1235\t\n1236\t\n1237\t# ---------------------------------------------------------------------------\n1238\t# Real execution of the real compiled graph (prompt TEST 1, and the reachable\n1239\t# part of TEST 9). Every assertion below runs one real `.stream()`.\n1240\t# ---------------------------------------------------------------------------\n1241\t\n1242\t\n1243\t# The bootstrap prefix, which is a contiguous run of single-successor nodes and\n1244\t# so can be asserted as a literal prefix of the trace.\n1245\tBOOTSTRAP_SPINE = (\n1246\t    \"D00_BOOTSTRAP_EPISODE\",\n1247\t    \"D01_VALIDATE_AND_FREEZE_INPUTS\",\n1248\t    \"D02_COMPILE_EFFECTIVE_RUN\",\n1249\t    \"D03_PROVE_CAPABILITIES\",\n1250\t    \"D04_INITIALIZE_OR_RESUME\",\n1251\t    \"D05_SELECT_NEXT_UNIT\",\n1252\t    \"D06_COMPILE_SOURCE_REQUESTS\",\n1253\t)\n1254\t\n1255\t# Every node, map and barrier boundary a real episode currently reaches, in the\n1256\t# order it is first entered. Past D06 the path is no longer a simple spine: D90\n1257\t# reserves before each dispatch, M01 runs as a two-member `Send` map twice, and\n1258\t# D07/D08 are join barriers. Prompt TEST 9 is parametrized over this whole set,\n1259\t# so the crash matrix covers map and barrier boundaries and not just plain nodes.\n1260\tREACHABLE_BOUNDARIES = BOOTSTRAP_SPINE + (\n1261\t    \"D90_RESERVE_MODEL_ATTEMPT\",\n1262\t    \"M01_RESEARCH_UNIT_SOURCES\",\n1263\t    \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n1264\t    \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n1265\t    \"M02_CREATE_UNIT_DOMAIN_DATA\",\n1266\t    \"D08_VALIDATE_DOMAIN\",\n1267\t    \"M03_WRITE_UNIT_CONTENT\",\n1268\t    \"D09_VALIDATE_CONTENT\",\n1269\t    \"D10_COMPILE_VISUAL_BRIEFS\",\n1270\t    \"D11_CREATE_DETERMINISTIC_VISUALS\",\n1271\t    \"D12_VISUAL_BARRIER_AND_JOIN\",\n1272\t    \"M04_CREATE_UNIT_VISUALS\",\n1273\t    \"D13_RENDER_UNIT\",\n1274\t    \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n1275\t    \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n1276\t)\n1277\t\n1278\t# M05 runs — its receipt, its candidate record and its page findings are all in\n1279\t# the committed state — but its update never reaches a stream consumer, because\n1280\t# the branch that would emit it resolves to `D16_REDUCE_UNIT_EVIDENCE`, this\n1281\t# node's declared handoff to N31, and aborts the superstep first. It is therefore\n1282\t# not an observable interrupt boundary and is excluded from the matrix above\n1283\t# rather than asserted vacuously. The same was true of D09 until B-10 was fixed\n1284\t# and the frontier moved past it.\n1285\tUNOBSERVABLE_BOUNDARY = \"M05_REVIEW_ACTUAL_UNIT\"\n1286\t\n1287\t\n1288\tdef test_a_fresh_episode_executes_the_bootstrap_spine_once_through_langgraph(\n1289\t    tmp_path: Path, monkeypatch"}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"c67ac323-dd19-418d-85df-5e7d69fc1e37","timestamp":"2026-08-12T22:05:14.734Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/tests/runtime/test_plan26_unit_graph.py","content":"\n\n# ---------------------------------------------------------------------------\n# Real execution of the real compiled graph (prompt TEST 1, and the reachable\n# part of TEST 9). Every assertion below runs one real `.stream()`.\n# ---------------------------------------------------------------------------\n\n\n# The bootstrap prefix, which is a contiguous run of single-successor nodes and\n# so can be asserted as a literal prefix of the trace.\nBOOTSTRAP_SPINE = (\n    \"D00_BOOTSTRAP_EPISODE\",\n    \"D01_VALIDATE_AND_FREEZE_INPUTS\",\n    \"D02_COMPILE_EFFECTIVE_RUN\",\n    \"D03_PROVE_CAPABILITIES\",\n    \"D04_INITIALIZE_OR_RESUME\",\n    \"D05_SELECT_NEXT_UNIT\",\n    \"D06_COMPILE_SOURCE_REQUESTS\",\n)\n\n# Every node, map and barrier boundary a real episode currently reaches, in the\n# order it is first entered. Past D06 the path is no longer a simple spine: D90\n# reserves before each dispatch, M01 runs as a two-member `Send` map twice, and\n# D07/D08 are join barriers. Prompt TEST 9 is parametrized over this whole set,\n# so the crash matrix covers map and barrier boundaries and not just plain nodes.\nREACHABLE_BOUNDARIES = BOOTSTRAP_SPINE + (\n    \"D90_RESERVE_MODEL_ATTEMPT\",\n    \"M01_RESEARCH_UNIT_SOURCES\",\n    \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n    \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    \"M02_CREATE_UNIT_DOMAIN_DATA\",\n    \"D08_VALIDATE_DOMAIN\",\n    \"M03_WRITE_UNIT_CONTENT\",\n    \"D09_VALIDATE_CONTENT\",\n    \"D10_COMPILE_VISUAL_BRIEFS\",\n    \"D11_CREATE_DETERMINISTIC_VISUALS\",\n    \"D12_VISUAL_BARRIER_AND_JOIN\",\n    \"M04_CREATE_UNIT_VISUALS\",\n    \"D13_RENDER_UNIT\",\n    \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n    \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n)\n\n# M05 runs — its receipt, its candidate record and its page findings are all in\n# the committed state — but its update never reaches a stream consumer, because\n# the branch that would emit it resolves to `D16_REDUCE_UNIT_EVIDENCE`, this\n# node's declared handoff to N31, and aborts the superstep first. It is therefore\n# not an observable interrupt boundary and is excluded from the matrix above\n# rather than asserted vacuously. The same was true of D09 until B-10 was fixed\n# and the frontier moved past it.\nUNOBSERVABLE_BOUNDARY = \"M05_REVIEW_ACTUAL_UNIT\"\n\n\ndef test_a_fresh_episode_executes_the_bootstrap_spine_once_through_langgraph(\n    tmp_path: Path, monkeypatch","numLines":55,"startLine":1235,"totalLines":2693}}}
