deterministic_candidate is not None),\n917-        \"join\",\n918-        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n919-        unit_id=unit_id,\n920-    )\n921-\n922-    if model_candidate is not None:\n923-        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n924-        child = payload.get(\"candidate_child\") or {}\n925-        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n926-        try:\n927-            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n928-        except (TypeError, ValueError) as error:\n929-            raise SystemFailure(\n930-                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n931-            ) from error\n932-        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n933-    else:\n934-        new_body = deterministic_candidate[\"body\"]\n935-        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n936-\n937-    require(\n938-        declared_parent_sha == current_hash,\n939-        \"integrity\",\n940-        \"the repair candidate's declared parent is not the current head (stale repair)\",\n941-        stream=stream, declared=declared_parent_sha, current=current_hash,\n942-    )\n943-\n944-    diff = json_pointer_diff(parent_body, new_body)\n945-    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n946-    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n947-    require(\n948-        not out_of_bound,\n949-        \"integrity\",\n950-        \"a repair candidate changed bytes outside its declared boundary\",\n951-        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n952-    )\n953-\n954-    child_record = {\n955-        \"stream\": stream,\n956-        \"version\": current_version + 1,\n957-        \"parent_hash\": current_hash,\n958-        \"hash\": canonical_digest(new_body),\n959-        \"body\": new_body,\n960-        \"minted_by\": \"targeted_repair_admission\",\n961-        \"unit_id\": unit_id,\n962-        \"channel\": request[\"channel\"],\n963-        \"request_key\": request[\"key\"],\n964-        \"owner\": request[\"owner\"],\n965-        \"attempt\": request[\"attempt_ordinal\"],\n966-    }\n967-    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n968-\n969-    update: dict[str, Any] = {\n970-        \"artifact_versions\": [child_record],\n971-        \"pending_guard\": _guard(\n972-            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n973-            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n974-        ),\n975-    }\n976-    if head_tracked:\n977-        update[\"artifact_heads\"] = {\n978-            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n979-        }\n980-    return update\n981-\n982-","is_error":false}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"47d14fff-b54f-4d0e-b1ce-9cc8e390bfe2","timestamp":"2026-08-12T22:23:21.631Z","tool_use_result":{"stdout":"882:def D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n883-    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n884-\n885-    Recomputes the parent/child diff itself rather than trusting a model's own\n886-    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n887-    child that does not descend from the current head, is `SystemFailure`\n888-    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n889-    routed repairable finding, because a boundary violation is a build/model\n890-    defect, not a product outcome to retry.\n891-    \"\"\"\n892-\n893-    unit_id = state.get(\"selected_unit_id\")\n894-    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n895-\n896-    requests = [\n897-        entry\n898-        for entry in state.get(\"repair_requests\") or []\n899-        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n900-    ]\n901-    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n902-    request = requests[-1]\n903-    stream = request[\"stream\"]\n904-    boundary = request[\"boundary\"][\"json_pointers\"]\n905-    heads = state.get(\"artifact_heads\") or {}\n906-    parent_head = heads.get(stream)\n907-    artifact_versions = state.get(\"artifact_versions\") or []\n908-\n909-    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n910-\n911-    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n912-    deterministic_candidate = _latest_deterministic_candidate(\n913-        artifact_versions, stream=stream, request_key=request[\"key\"]\n914-    )\n915-    require(\n916-        (model_candidate is not None) != (deterministic_candidate is not None),\n917-        \"join\",\n918-        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n919-        unit_id=unit_id,\n920-    )\n921-\n922-    if model_candidate is not None:\n923-        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n924-        child = payload.get(\"candidate_child\") or {}\n925-        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n926-        try:\n927-            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n928-        except (TypeError, ValueError) as error:\n929-            raise SystemFailure(\n930-                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n931-            ) from error\n932-       