{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BBeeTySFZhLjg6KtBcb3vV","type":"tool_result","content":"790\t        \"pending_guard\": {\n791\t            \"node\": \"D05_SELECT_NEXT_UNIT\",\n792\t            \"value\": \"manifest_exhausted\",\n793\t            \"detail\": {},\n794\t        }\n795\t    }\n796\t    assert R.route_unit_selection(state) == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n797\t\n798\t\n799\t# ================================================ TEST 7: digest stability and drift\n800\t\n801\t\n802\tdef test_identical_real_bindings_yield_an_identical_digest(output_root):\n803\t    first = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n804\t    second = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n805\t    assert first is not second\n806\t    assert G.graph_digest(first) == G.graph_digest(second)\n807\t    assert len(G.graph_digest(first)) == 64\n808\t\n809\t\n810\tdef test_a_changed_callable_changes_the_digest(compiled, monkeypatch):\n811\t    baseline = G.graph_digest(compiled)\n812\t    drifted = G.binding_inventory()\n813\t    drifted[\"D05_SELECT_NEXT_UNIT\"] = drifted[\"D13_RENDER_UNIT\"]\n814\t    monkeypatch.setattr(G, \"binding_inventory\", lambda: drifted)\n815\t    assert G.graph_digest(compiled) != baseline\n816\t\n817\t\n818\tdef test_a_changed_state_schema_changes_the_digest(compiled, monkeypatch):\n819\t    baseline = G.graph_digest(compiled)\n820\t    reducers = dict(G.FIELD_REDUCER_CLASSES)\n821\t    reducers[\"cursor\"] = \"append_unique\"\n822\t    monkeypatch.setattr(G, \"FIELD_REDUCER_CLASSES\", reducers)\n823\t    assert G.graph_digest(compiled) != baseline\n824\t\n825\t\n826\tdef test_a_changed_prompt_or_schema_file_changes_the_digest(compiled, monkeypatch, tmp_path):\n827\t    baseline = G.graph_digest(compiled)\n828\t    real = tp.resolve_prompt_path(tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\"))\n829\t    drifted = tmp_path / real.name\n830\t    drifted.write_bytes(real.read_bytes() + b\"\\n# drift\\n\")\n831\t    assert hashlib.sha256(drifted.read_bytes()).hexdigest() != (\n832\t        hashlib.sha256(real.read_bytes()).hexdigest()\n833\t    )\n834\t\n835\t    original = tp.resolve_prompt_path\n836\t\n837\t    def patched(route):\n838\t        path = original(route)\n839\t        return drifted if path.name == real.name else path\n840\t\n841\t    monkeypatch.setattr(G.tp, \"resolve_prompt_path\", patched)\n842\t    assert G.graph_digest(compiled) != baseline\n843\t\n844\t"}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"aeae610a-4fc0-4fba-8654-c9c6e2d3f739","timestamp":"2026-08-12T22:07:54.027Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/tests/runtime/test_plan26_topology.py","content":"        \"pending_guard\": {\n            \"node\": \"D05_SELECT_NEXT_UNIT\",\n            \"value\": \"manifest_exhausted\",\n            \"detail\": {},\n        }\n    }\n    assert R.route_unit_selection(state) == \"D24_PROVE_EXACT_MANIFEST_COVERAGE\"\n\n\n# ================================================ TEST 7: digest stability and drift\n\n\ndef test_identical_real_bindings_yield_an_identical_digest(output_root):\n    first = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    second = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    assert first is not second\n    assert G.graph_digest(first) == G.graph_digest(second)\n    assert len(G.graph_digest(first)) == 64\n\n\ndef test_a_changed_callable_changes_the_digest(compiled, monkeypatch):\n    baseline = G.graph_digest(compiled)\n    drifted = G.binding_inventory()\n    drifted[\"D05_SELECT_NEXT_UNIT\"] = drifted[\"D13_RENDER_UNIT\"]\n    monkeypatch.setattr(G, \"binding_inventory\", lambda: drifted)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_a_changed_state_schema_changes_the_digest(compiled, monkeypatch):\n    baseline = G.graph_digest(compiled)\n    reducers = dict(G.FIELD_REDUCER_CLASSES)\n    reducers[\"cursor\"] = \"append_unique\"\n    monkeypatch.setattr(G, \"FIELD_REDUCER_CLASSES\", reducers)\n    assert G.graph_digest(compiled) != baseline\n\n\ndef test_a_changed_prompt_or_schema_file_changes_the_digest(compiled, monkeypatch, tmp_path):\n    baseline = G.graph_digest(compiled)\n    real = tp.resolve_prompt_path(tp.resolve_route(\"M03_WRITE_UNIT_CONTENT\"))\n    drifted = tmp_path / real.name\n    drifted.write_bytes(real.read_bytes() + b\"\\n# drift\\n\")\n    assert hashlib.sha256(drifted.read_bytes()).hexdigest() != (\n        hashlib.sha256(real.read_bytes()).hexdigest()\n    )\n\n    original = tp.resolve_prompt_path\n\n    def patched(route):\n        path = original(route)\n        return drifted if path.name == real.name else path\n\n    monkeypatch.setattr(G.tp, \"resolve_prompt_path\", patched)\n    assert G.graph_digest(compiled) != baseline\n\n","numLines":55,"startLine":790,"totalLines":1008}}}
