{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cdyc4j9qLdxiCsdg2GoYu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019eeziVombxf395SEnzudr1","name":"Read","input":{"file_path":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/runtime/langgraph_factory/acceptance.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18803,"cache_read_input_tokens":60666,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18803},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"75c2f522-67f4-460a-b4f5-74ee79737456","timestamp":"2026-08-12T21:59:38.681Z","request_id":"req_011Cdyc4i66AzXtFt8y4r6oG"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019eeziVombxf395SEnzudr1","type":"tool_result","content":"1\t\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n2\t\n3\t`compute_unit_denominator()` is the one reduction engine spec section 13.1\n4\tdescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\n5\tbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\n6\treceipt, off whatever the *current* heads are at that moment. A retest that\n7\tchanged a head between the two calls changes what this function sees; nothing\n8\there caches or trusts its own earlier answer.\n9\t\n10\tLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\n11\tyet -- registration into the compiled graph is N32's write, once `workbook.py`\n12\texists to dispatch the workbook branch alongside them.\n13\t\n14\tKnown scope of this generation's denominator (documented rather than silently\n15\tassumed): it enforces source admission, the domain and content check sets, the\n16\tvisual join, the page inventory/inspection set, one independent unit review\n17\twith all findings mapped through a code-owned owner table, and open-repair\n18\tclosure. It treats the append-only evidence/log layer and the LangGraph\n19\tcheckpoint layer as structurally present rather than independently\n20\tre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n21\t`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\n22\treducers themselves (`reducers.py`), and this generation does not yet call an\n23\texternal hash-chain audit from inside D22. A denominator category is never\n24\tremoved to make a fixture pass; a future generation only ever tightens this.\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom dataclasses import dataclass, field\n31\tfrom typing import Any\n32\t\n33\tfrom . import repair, routing\n34\tfrom .nodes import (\n35\t    SystemFailure,\n36\t    candidate_payload,\n37\t    canonical_digest,\n38\t    check_record,\n39\t    require,\n40\t    stream_id,\n41\t)\n42\tfrom .nodes.content import CONTENT_CHECK_IDS\n43\tfrom .nodes.domain import DOMAIN_CHECK_IDS\n44\t\n45\t__all__ = [\n46\t    \"DenominatorResult\",\n47\t    \"compute_unit_denominator\",\n48\t    \"prove_exact_manifest_coverage\",\n49\t    \"D16_REDUCE_UNIT_EVIDENCE\",\n50\t    \"D22_ACCEPT_UNIT\",\n51\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n52\t    \"UNIT_REPAIR_TOPOLOGY_SOURCES\",\n53\t    \"UNIT_REPAIR_NODE_BODIES\",\n54\t    \"unit_repair_destinations\",\n55\t    \"register_unit_repair_path\",\n56\t]\n57\t\n58\t\n59\t@dataclass(frozen=True)\n60\tclass DenominatorResult:\n61\t    passed: bool\n62\t    check: dict[str, Any]\n63\t    findings: list[dict[str, Any]] = field(default_factory=list)\n64\t    denominator: dict[str, Any] = field(default_factory=dict)\n65\t\n66\t\n67\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n68\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n69\t\n70\t\n71\tdef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n72\t    if not pdf_sha256:\n73\t        return None\n74\t    matches = [\n75\t        dict(record)\n76\t        for record in unit_reviews or []\n77\t        if isinstance(record, Mapping)\n78\t        and record.get(\"record_kind\") == \"model_candidate\"\n79\t        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n80\t        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n81\t    ]\n82\t    return matches[-1] if matches else None\n83\t\n84\t\n85\tdef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n86\t    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n87\t\n88\t    heads = state.get(\"artifact_heads\") or {}\n89\t    checks = [\n90\t        record\n91\t        for record in state.get(\"deterministic_checks\") or []\n92\t        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n93\t    ]\n94\t    findings: list[dict[str, Any]] = []\n95\t    categories: dict[str, Any] = {}\n96\t\n97\t    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n98\t        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n99\t\n100\t    # 1-2. source admission and correlation.\n101\t    admissions = [\n102\t        record\n103\t        for record in state.get(\"source_admissions\") or []\n104\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n105\t    ]\n106\t    admissions_ok = bool(admissions) and all(\n107\t        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n108\t    )\n109\t    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n110\t    if not admissions_ok:\n111\t        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n112\t\n113\t    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n114\t    domain_stream = stream_id(unit_id, \"domain\")\n115\t    domain_head = heads.get(domain_stream)\n116\t    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n117\t    domain_checks = {\n118\t        record[\"check_id\"]: record\n119\t        for record in checks\n120\t        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n121\t    }\n122\t    domain_ok = domain_hash is not None and all(\n123\t        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n124\t    )\n125\t    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n126\t    if not domain_ok:\n127\t        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n128\t\n129\t    # 4, 6. unit schema and every sourced claim resolved.\n130\t    content_stream = stream_id(unit_id, \"content\")\n131\t    content_head = heads.get(content_stream)\n132\t    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n133\t    content_checks = {\n134\t        record[\"check_id\"]: record\n135\t        for record in checks\n136\t        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n137\t    }\n138\t    content_ok = content_hash is not None and all(\n139\t        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n140\t    )\n141\t    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n142\t    if not content_ok:\n143\t        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n144\t\n145\t    # 8. every required actual visual, provenance, and asset resolution.\n146\t    visual_join = [\n147\t        record\n148\t        for record in state.get(\"visual_join_evidence\") or []\n149\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n150\t    ]\n151\t    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n152\t    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n153\t    if not visuals_ok:\n154\t        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n155\t\n156\t    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n157\t    inventories = [\n158\t        record\n159\t        for record in state.get(\"unit_page_inventories\") or []\n160\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n161\t    ]\n162\t    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n163\t    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n164\t    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n165\t    inspections = [\n166\t        record\n167\t        for record in state.get(\"unit_page_inspections\") or []\n168\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n169\t    ]\n170\t    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n171\t    inspections_ok = (\n172\t        inventory_ok\n173\t        and len(inspections) == expected_pages\n174\t        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n175\t    )\n176\t    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n177\t    if not inspections_ok:\n178\t        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n179\t\n180\t    # 11. one independent review of the frozen actual unit, every page included.\n181\t    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n182\t    review_ok = review is not None\n183\t    if review is not None:\n184\t        payload = candidate_payload(review, \"unit review\")\n185\t        blocking = [\n186\t            entry\n187\t            for entry in payload.get(\"overall_findings\", [])\n188\t            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n189\t        ]\n190\t        for page_entry in payload.get(\"page_findings\", []):\n191\t            if isinstance(page_entry, Mapping):\n192\t                blocking.extend(\n193\t                    entry for entry in page_entry.get(\"findings\", [])\n194\t                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n195\t                )\n196\t        for entry in blocking:\n197\t            owner = repair.owner_for_review_category(entry.get(\"category\"))\n198\t            require(\n199\t                owner is not None,\n200\t                \"invalid_input\",\n201\t                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n202\t                unit_id=unit_id,\n203\t            )\n204\t            findings.append(\n205\t                {\n206\t                    \"check_id\": \"unit_review_finding\",\n207\t                    \"owner\": owner,\n208\t                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n209\t                    \"message\": entry.get(\"description\", \"\"),\n210\t                }\n211\t            )\n212\t        review_ok = not blocking\n213\t    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n214\t    if review is None:\n215\t        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n216\t\n217\t    # 12. complete repair partition, immutable history, and required current retests.\n218\t    unit_repair_requests = [\n219\t        record\n220\t        for record in state.get(\"repair_requests\") or []\n221\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n222\t    ]\n223\t    resolved_keys = {\n224\t        record.get(\"request_key\")\n225\t        for record in state.get(\"retest_results\") or []\n226\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n227\t    }\n228\t    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n229\t    repair_ok = not open_requests\n230\t    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n231\t    if not repair_ok:\n232\t        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n233\t\n234\t    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n235\t    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n236\t    check = check_record(\n237\t        scope=\"unit\",\n238\t        owner=unit_id,\n239\t        head_hash=summary_hash,\n240\t        check_id=\"unit_denominator\",\n241\t        attempt=1,\n242\t        result=\"PASS\" if passed else \"FAIL\",\n243\t        detail={\"categories\": categories},\n244\t    )\n245\t    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n246\t\n247\t\n248\tdef prove_exact_manifest_coverage(\n249\t    ordered_unit_ids: Any,\n250\t    accepted_unit_receipts: Mapping[str, Any],\n251\t    declared_coverage: Any,\n252\t) -> tuple[bool, list[str]]:\n253\t    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n254\t\n255\t    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n256\t    this function is the exact predicate it needs and is exercised directly\n257\t    here so the coverage rule itself -- exact order, exact membership, exact\n258\t    current hash -- is proven against this module's own receipt shape before\n259\t    N32 ever calls it.\n260\t    \"\"\"\n261\t\n262\t    ordered = list(ordered_unit_ids)\n263\t    declared = [dict(entry) for entry in declared_coverage]\n264\t    rejections: list[str] = []\n265\t\n266\t    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n267\t    if declared_ids != ordered:\n268\t        rejections.append(\n269\t            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n270\t        )\n271\t\n272\t    for entry in declared:\n273\t        unit_id = entry.get(\"unit_id\")\n274\t        receipt = accepted_unit_receipts.get(unit_id)\n275\t        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n276\t        if current_hash is None:\n277\t            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n278\t        elif entry.get(\"receipt_hash\") != current_hash:\n279\t            rejections.append(\n280\t                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n281\t                f\"receipt hash {current_hash!r}\"\n282\t            )\n283\t\n284\t    return (not rejections, rejections)\n285\t\n286\t\n287\t# --------------------------------------------------------------------------\n288\t# D16_REDUCE_UNIT_EVIDENCE\n289\t# --------------------------------------------------------------------------\n290\t\n291\t\n292\tdef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n293\t    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n294\t\n295\t    unit_id = state.get(\"selected_unit_id\")\n296\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n297\t    require(\n298\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n299\t        \"integrity\",\n300\t        \"an accepted unit can never re-enter denominator reduction\",\n301\t        unit_id=unit_id,\n302\t    )\n303\t\n304\t    result = compute_unit_denominator(state, unit_id)\n305\t    if result.passed:\n306\t        return {\n307\t            \"deterministic_checks\": [result.check],\n308\t            \"unit_status\": {unit_id: \"REVIEWING\"},\n309\t            \"pending_guard\": _guard(\n310\t                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n311\t            ),\n312\t        }\n313\t    return {\n314\t        \"deterministic_checks\": [result.check],\n315\t        \"unit_status\": {unit_id: \"REVIEWING\"},\n316\t        \"pending_guard\": _guard(\n317\t            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n318\t            unit_id=unit_id, findings=result.findings,\n319\t        ),\n320\t    }\n321\t\n322\t\n323\t# --------------------------------------------------------------------------\n324\t# D22_ACCEPT_UNIT\n325\t# --------------------------------------------------------------------------\n326\t\n327\t\n328\tdef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n329\t    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n330\t\n331\t    Never trusts D16's earlier pass: a retest that changed a head between the\n332\t    two calls, or evidence that went stale, makes this recomputation fail even\n333\t    though D16 once passed. Any absent, stale, or failing member blocks\n334\t    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n335\t    warned acceptance path.\n336\t    \"\"\"\n337\t\n338\t    unit_id = state.get(\"selected_unit_id\")\n339\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n340\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n341\t    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n342\t\n343\t    result = compute_unit_denominator(state, unit_id)\n344\t    require(\n345\t        result.passed,\n346\t        \"integrity\",\n347\t        \"D22 recomputation does not currently pass; acceptance is refused\",\n348\t        unit_id=unit_id, categories=result.denominator,\n349\t    )\n350\t\n351\t    heads = state.get(\"artifact_heads\") or {}\n352\t    unit_stream_hashes = {\n353\t        stream: head.get(\"hash\")\n354\t        for stream, head in heads.items()\n355\t        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n356\t    }\n357\t    receipt_body = {\n358\t        \"unit_id\": unit_id,\n359\t        \"denominator\": result.denominator,\n360\t        \"artifact_head_hashes\": unit_stream_hashes,\n361\t        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n362\t    }\n363\t    receipt = dict(receipt_body)\n364\t    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n365\t\n366\t    return {\n367\t        \"accepted_unit_receipts\": {unit_id: receipt},\n368\t        \"deterministic_checks\": [result.check],\n369\t        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n370\t    }\n371\t\n372\t\n373\t# --------------------------------------------------------------------------\n374\t# D23_CHECKPOINT_ACCEPTED_UNIT\n375\t# --------------------------------------------------------------------------\n376\t\n377\t\n378\tdef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n379\t    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n380\t\n381\t    The cursor's `accepted_ordinal` is written in the same update as the\n382\t    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n383\t    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n384\t    would otherwise be satisfiable by a cursor that outran its correlation\n385\t    evidence, which is exactly the ordering spec section 6.2's D23 row and\n386\t    this node's own TEST 7 forbid.\n387\t    \"\"\"\n388\t\n389\t    unit_id = state.get(\"selected_unit_id\")\n390\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n391\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n392\t    receipt = accepted.get(unit_id)\n393\t    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n394\t\n395\t    evidence_entries = state.get(\"evidence_index_entries\") or []\n396\t    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n397\t    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n398\t\n399\t    checkpoint_record = {\n400\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n401\t        \"unit_id\": unit_id,\n402\t        \"checkpoint_id\": checkpoint_id,\n403\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n404\t        \"run_id\": state.get(\"run_id\"),\n405\t        \"episode_id\": state.get(\"episode_id\"),\n406\t        \"evidence_ordinal\": len(evidence_entries),\n407\t        \"prior_checkpoint_count\": len(existing_checkpoints),\n408\t    }\n409\t\n410\t    correlation_record = {\n411\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n412\t        \"unit_id\": unit_id,\n413\t        \"checkpoint_id\": checkpoint_id,\n414\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n415\t    }\n416\t\n417\t    effective_run = state.get(\"effective_run\") or {}\n418\t    closure = effective_run.get(\"target_closure\") or []\n419\t    cursor = dict(state.get(\"cursor\") or {})\n420\t    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n421\t    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n422\t    if unit_id not in closure:\n423\t        # Defensive: D05 always selects from the closure, so this is unreachable\n424\t        # in the real pipeline; kept explicit rather than silently trusting\n425\t        # an out-of-closure cursor advance.\n426\t        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n427\t\n428\t    return {\n429\t        \"checkpoint_metadata\": [checkpoint_record],\n430\t        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n431\t        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n432\t        \"pending_guard\": _guard(\n433\t            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n434\t            unit_id=unit_id, checkpoint_id=checkpoint_id,\n435\t        ),\n436\t    }\n437\t"}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"2aca6951-f05d-41b3-a067-a56f35e5dd92","timestamp":"2026-08-12T21:59:38.687Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/runtime/langgraph_factory/acceptance.py","content":"\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n\n`compute_unit_denominator()` is the one reduction engine spec section 13.1\ndescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\nbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\nreceipt, off whatever the *current* heads are at that moment. A retest that\nchanged a head between the two calls changes what this function sees; nothing\nhere caches or trusts its own earlier answer.\n\nLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\nyet -- registration into the compiled graph is N32's write, once `workbook.py`\nexists to dispatch the workbook branch alongside them.\n\nKnown scope of this generation's denominator (documented rather than silently\nassumed): it enforces source admission, the domain and content check sets, the\nvisual join, the page inventory/inspection set, one independent unit review\nwith all findings mapped through a code-owned owner table, and open-repair\nclosure. It treats the append-only evidence/log layer and the LangGraph\ncheckpoint layer as structurally present rather than independently\nre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\nreducers themselves (`reducers.py`), and this generation does not yet call an\nexternal hash-chain audit from inside D22. A denominator category is never\nremoved to make a fixture pass; a future generation only ever tightens this.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping, Sequence\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom . import repair, routing\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    check_record,\n    require,\n    stream_id,\n)\nfrom .nodes.content import CONTENT_CHECK_IDS\nfrom .nodes.domain import DOMAIN_CHECK_IDS\n\n__all__ = [\n    \"DenominatorResult\",\n    \"compute_unit_denominator\",\n    \"prove_exact_manifest_coverage\",\n    \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    \"UNIT_REPAIR_TOPOLOGY_SOURCES\",\n    \"UNIT_REPAIR_NODE_BODIES\",\n    \"unit_repair_destinations\",\n    \"register_unit_repair_path\",\n]\n\n\n@dataclass(frozen=True)\nclass DenominatorResult:\n    passed: bool\n    check: dict[str, Any]\n    findings: list[dict[str, Any]] = field(default_factory=list)\n    denominator: dict[str, Any] = field(default_factory=dict)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n    if not pdf_sha256:\n        return None\n    matches = [\n        dict(record)\n        for record in unit_reviews or []\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == \"model_candidate\"\n        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n    ]\n    return matches[-1] if matches else None\n\n\ndef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    checks = [\n        record\n        for record in state.get(\"deterministic_checks\") or []\n        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n    ]\n    findings: list[dict[str, Any]] = []\n    categories: dict[str, Any] = {}\n\n    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n\n    # 1-2. source admission and correlation.\n    admissions = [\n        record\n        for record in state.get(\"source_admissions\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    admissions_ok = bool(admissions) and all(\n        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n    )\n    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n    if not admissions_ok:\n        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n\n    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n    domain_stream = stream_id(unit_id, \"domain\")\n    domain_head = heads.get(domain_stream)\n    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n    domain_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n    }\n    domain_ok = domain_hash is not None and all(\n        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n    )\n    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n    if not domain_ok:\n        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n\n    # 4, 6. unit schema and every sourced claim resolved.\n    content_stream = stream_id(unit_id, \"content\")\n    content_head = heads.get(content_stream)\n    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n    content_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n    }\n    content_ok = content_hash is not None and all(\n        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n    )\n    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n    if not content_ok:\n        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n\n    # 8. every required actual visual, provenance, and asset resolution.\n    visual_join = [\n        record\n        for record in state.get(\"visual_join_evidence\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n    ]\n    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n    if not visuals_ok:\n        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n\n    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n    inventories = [\n        record\n        for record in state.get(\"unit_page_inventories\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n    inspections = [\n        record\n        for record in state.get(\"unit_page_inspections\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n    ]\n    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n    inspections_ok = (\n        inventory_ok\n        and len(inspections) == expected_pages\n        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n    )\n    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n    if not inspections_ok:\n        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n\n    # 11. one independent review of the frozen actual unit, every page included.\n    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n    review_ok = review is not None\n    if review is not None:\n        payload = candidate_payload(review, \"unit review\")\n        blocking = [\n            entry\n            for entry in payload.get(\"overall_findings\", [])\n            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n        ]\n        for page_entry in payload.get(\"page_findings\", []):\n            if isinstance(page_entry, Mapping):\n                blocking.extend(\n                    entry for entry in page_entry.get(\"findings\", [])\n                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n                )\n        for entry in blocking:\n            owner = repair.owner_for_review_category(entry.get(\"category\"))\n            require(\n                owner is not None,\n                \"invalid_input\",\n                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n                unit_id=unit_id,\n            )\n            findings.append(\n                {\n                    \"check_id\": \"unit_review_finding\",\n                    \"owner\": owner,\n                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n                    \"message\": entry.get(\"description\", \"\"),\n                }\n            )\n        review_ok = not blocking\n    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n    if review is None:\n        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n\n    # 12. complete repair partition, immutable history, and required current retests.\n    unit_repair_requests = [\n        record\n        for record in state.get(\"repair_requests\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    resolved_keys = {\n        record.get(\"request_key\")\n        for record in state.get(\"retest_results\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n    }\n    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n    repair_ok = not open_requests\n    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n    if not repair_ok:\n        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n\n    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n    check = check_record(\n        scope=\"unit\",\n        owner=unit_id,\n        head_hash=summary_hash,\n        check_id=\"unit_denominator\",\n        attempt=1,\n        result=\"PASS\" if passed else \"FAIL\",\n        detail={\"categories\": categories},\n    )\n    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n\n\ndef prove_exact_manifest_coverage(\n    ordered_unit_ids: Any,\n    accepted_unit_receipts: Mapping[str, Any],\n    declared_coverage: Any,\n) -> tuple[bool, list[str]]:\n    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n\n    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n    this function is the exact predicate it needs and is exercised directly\n    here so the coverage rule itself -- exact order, exact membership, exact\n    current hash -- is proven against this module's own receipt shape before\n    N32 ever calls it.\n    \"\"\"\n\n    ordered = list(ordered_unit_ids)\n    declared = [dict(entry) for entry in declared_coverage]\n    rejections: list[str] = []\n\n    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n    if declared_ids != ordered:\n        rejections.append(\n            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n        )\n\n    for entry in declared:\n        unit_id = entry.get(\"unit_id\")\n        receipt = accepted_unit_receipts.get(unit_id)\n        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n        if current_hash is None:\n            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n        elif entry.get(\"receipt_hash\") != current_hash:\n            rejections.append(\n                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n                f\"receipt hash {current_hash!r}\"\n            )\n\n    return (not rejections, rejections)\n\n\n# --------------------------------------------------------------------------\n# D16_REDUCE_UNIT_EVIDENCE\n# --------------------------------------------------------------------------\n\n\ndef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter denominator reduction\",\n        unit_id=unit_id,\n    )\n\n    result = compute_unit_denominator(state, unit_id)\n    if result.passed:\n        return {\n            \"deterministic_checks\": [result.check],\n            \"unit_status\": {unit_id: \"REVIEWING\"},\n            \"pending_guard\": _guard(\n                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n            ),\n        }\n    return {\n        \"deterministic_checks\": [result.check],\n        \"unit_status\": {unit_id: \"REVIEWING\"},\n        \"pending_guard\": _guard(\n            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n            unit_id=unit_id, findings=result.findings,\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D22_ACCEPT_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n\n    Never trusts D16's earlier pass: a retest that changed a head between the\n    two calls, or evidence that went stale, makes this recomputation fail even\n    though D16 once passed. Any absent, stale, or failing member blocks\n    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n    warned acceptance path.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n\n    result = compute_unit_denominator(state, unit_id)\n    require(\n        result.passed,\n        \"integrity\",\n        \"D22 recomputation does not currently pass; acceptance is refused\",\n        unit_id=unit_id, categories=result.denominator,\n    )\n\n    heads = state.get(\"artifact_heads\") or {}\n    unit_stream_hashes = {\n        stream: head.get(\"hash\")\n        for stream, head in heads.items()\n        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n    }\n    receipt_body = {\n        \"unit_id\": unit_id,\n        \"denominator\": result.denominator,\n        \"artifact_head_hashes\": unit_stream_hashes,\n        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n    }\n    receipt = dict(receipt_body)\n    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n\n    return {\n        \"accepted_unit_receipts\": {unit_id: receipt},\n        \"deterministic_checks\": [result.check],\n        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n    }\n\n\n# --------------------------------------------------------------------------\n# D23_CHECKPOINT_ACCEPTED_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n\n    The cursor's `accepted_ordinal` is written in the same update as the\n    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n    would otherwise be satisfiable by a cursor that outran its correlation\n    evidence, which is exactly the ordering spec section 6.2's D23 row and\n    this node's own TEST 7 forbid.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    receipt = accepted.get(unit_id)\n    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n\n    evidence_entries = state.get(\"evidence_index_entries\") or []\n    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n\n    checkpoint_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n        \"run_id\": state.get(\"run_id\"),\n        \"episode_id\": state.get(\"episode_id\"),\n        \"evidence_ordinal\": len(evidence_entries),\n        \"prior_checkpoint_count\": len(existing_checkpoints),\n    }\n\n    correlation_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n    }\n\n    effective_run = state.get(\"effective_run\") or {}\n    closure = effective_run.get(\"target_closure\") or []\n    cursor = dict(state.get(\"cursor\") or {})\n    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n    if unit_id not in closure:\n        # Defensive: D05 always selects from the closure, so this is unreachable\n        # in the real pipeline; kept explicit rather than silently trusting\n        # an out-of-closure cursor advance.\n        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n\n    return {\n        \"checkpoint_metadata\": [checkpoint_record],\n        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n        \"pending_guard\": _guard(\n            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n            unit_id=unit_id, checkpoint_id=checkpoint_id,\n        ),\n    }\n","numLines":437,"startLine":1,"totalLines":437}}}
