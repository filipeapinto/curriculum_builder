{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011g5PYjnfvozPERyT6yete3","type":"tool_result","content":"142\t@deterministic_node(\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\")\n143\tdef D14_INVENTORY_AND_INSPECT_UNIT_PAGES(\n144\t    projection: dict[str, Any], runtime_context: Any\n145\t) -> dict[str, Any]:\n146\t    \"\"\"Prove a positive contiguous page inventory and inspect every page.\n147\t\n148\t    \"Every page\" is literal: a per-page result set that skips a page cannot\n149\t    support a review denominator that claims to have seen the whole unit.\n150\t    \"\"\"\n151\t\n152\t    unit_id = projection[\"selected_unit_id\"]\n153\t    require(isinstance(unit_id, str) and unit_id, \"invalid_input\", \"no unit is selected\")\n154\t\n155\t    layout_stream = stream_id(unit_id, \"layout\")\n156\t    version = latest_candidate(projection[\"artifact_versions\"], layout_stream)\n157\t    require(version is not None, \"invalid_input\", f\"no rendered layout version on {layout_stream}\")\n158\t\n159\t    pdf_sha256 = version.get(\"pdf_sha256\")\n160\t    require(isinstance(pdf_sha256, str) and pdf_sha256, \"integrity\", \"the layout version has no PDF hash\")\n161\t\n162\t    pdf_path = Path(str(version.get(\"pdf_path\")))\n163\t    require(pdf_path.is_file(), \"integrity\", \"the rendered unit PDF is missing\", path=str(pdf_path))\n164\t    actual = _sha256_file(pdf_path)\n165\t    require(\n166\t        actual == pdf_sha256,\n167\t        \"integrity\",\n168\t        \"the unit PDF's bytes changed after rendering\",\n169\t        declared=pdf_sha256,\n170\t        actual=actual,\n171\t    )\n172\t\n173\t    registry = getattr(runtime_context, \"transport_registry\", None)\n174\t    inspector = getattr(registry, \"inspect_pages\", None) if registry else None\n175\t    require(callable(inspector), \"capability\", \"runtime context exposes no page inspector\")\n176\t\n177\t    try:\n178\t        inspected = inspector(str(pdf_path), pdf_sha256)\n179\t    except Exception as error:  # noqa: BLE001 - a rasterizer or tool fault is a system failure\n180\t        raise SystemFailure(\n181\t            \"tool\",\n182\t            f\"page inspection failed for {unit_id}: {error}\",\n183\t            {\"unit_id\": unit_id, \"pdf_sha256\": pdf_sha256},\n184\t        ) from error\n185\t\n186\t    report = _record(inspected, f\"page inspection for {unit_id}\")\n187\t    pages = report.get(\"pages\")\n188\t    require(isinstance(pages, list), \"schema_contract\", \"page inspection returned a non-list page set\")\n189\t\n190\t    attempt = int(version.get(\"attempt\", 1))\n191\t    numbers = [page.get(\"number\") for page in pages if isinstance(page, dict)]\n192\t    contiguous = numbers == list(range(1, len(pages) + 1))\n193\t    positive = len(pages) > 0\n194\t\n195\t    inventory = {\n196\t        \"key\": f\"{unit_id}/{pdf_sha256}\",\n197\t        \"unit_id\": unit_id,\n198\t        \"pdf_sha256\": pdf_sha256,\n199\t        \"page_count\": len(pages),\n200\t        \"contiguous\": contiguous,\n201\t        \"result\": \"PASS\" if positive and contiguous else \"FAIL\",\n202\t    }\n203\t\n204\t    inspections: list[dict[str, Any]] = []\n205\t    findings: list[dict[str, Any]] = []\n206\t    if not (positive and contiguous):\n207\t        findings.append(\n208\t            {\n209\t                \"check_id\": \"unit_page_inventory\",\n210\t                \"owner\": \"unit layout\",\n211\t                \"pointer\": \"/pages\",\n212\t                \"message\": (\n213\t                    \"page inventory is empty\" if not positive else f\"page numbering is not 1..N: {numbers}\"\n214\t                ),\n215\t            }\n216\t        )\n217\t\n218\t    for page in pages:\n219\t        page_record = _record(page, \"page inspection entry\")\n220\t        number = page_record.get(\"number\")\n221\t        problems = sorted(str(item) for item in page_record.get(\"problems\", []) or [])\n222\t        unreadable = bool(page_record.get(\"unreadable\"))\n223\t        if unreadable:\n224\t            problems = sorted({*problems, \"unreadable\"})\n225\t        # The review denominator is per page and by hash, so a page this node\n226\t        # cannot identify by its own bytes is a page D15 could not freeze.\n227\t        page_sha256 = page_record.get(\"page_sha256\")\n228\t        require(\n229\t            isinstance(page_sha256, str) and len(page_sha256) == 64,\n230\t            \"integrity\",\n231\t            f\"page {number} was inspected without a page hash\",\n232\t            unit_id=unit_id,\n233\t        )\n234\t        image_path = page_record.get(\"image_path\")\n235\t        require(\n236\t            isinstance(image_path, str) and bool(image_path),\n237\t            \"integrity\",\n238\t            f\"page {number} was inspected without a rendered page image\",\n239\t            unit_id=unit_id,\n240\t        )\n241\t        inspections.append(\n242\t            {\n243\t                \"key\": f\"{unit_id}/{pdf_sha256}/{number}\",\n244\t                \"unit_id\": unit_id,\n245\t                \"pdf_sha256\": pdf_sha256,\n246\t                \"page\": number,\n247\t                \"page_sha256\": page_sha256,\n248\t                \"image_path\": image_path,\n249\t                \"problems\": problems,\n250\t                \"result\": \"PASS\" if not problems else \"FAIL\",\n251\t            }\n252\t        )\n253\t        if problems:\n254\t            findings.append(\n255\t                {\n256\t                    \"check_id\": \"unit_page_inspection\",\n257\t                    \"owner\": \"unit layout\",\n258\t                    \"pointer\": f\"/pages/{number}\",\n259\t                    \"message\": f\"page {number} failed inspection: {problems}\",\n260\t                }\n261\t            )\n262\t\n263\t    check = check_record(\n264\t        scope=\"unit\",\n265\t        owner=unit_id,\n266\t        head_hash=pdf_sha256,\n267\t        check_id=\"unit_pages_inspected\",\n268\t        attempt=attempt,\n269\t        result=\"PASS\" if not findings else \"FAIL\",\n270\t        detail={\"page_count\": len(pages), \"finding_count\": len(findings)},\n271\t    )\n272\t\n273\t    value = \"pages_inspected\" if not findings else \"layout_repairable\"\n274\t    return {\n275\t        \"unit_page_inventories\": [inventory],\n276\t        \"unit_page_inspections\": inspections,\n277\t        \"deterministic_checks\": [check],\n278\t        \"pending_guard\": guard(\n279\t            \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", value, unit_id=unit_id, findings=findings\n280\t        ),\n281\t    }"}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"6f9a095e-7e1e-48d9-b469-a056b3064507","timestamp":"2026-08-12T22:17:08.084Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/runtime/langgraph_factory/nodes/render.py","content":"@deterministic_node(\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\")\ndef D14_INVENTORY_AND_INSPECT_UNIT_PAGES(\n    projection: dict[str, Any], runtime_context: Any\n) -> dict[str, Any]:\n    \"\"\"Prove a positive contiguous page inventory and inspect every page.\n\n    \"Every page\" is literal: a per-page result set that skips a page cannot\n    support a review denominator that claims to have seen the whole unit.\n    \"\"\"\n\n    unit_id = projection[\"selected_unit_id\"]\n    require(isinstance(unit_id, str) and unit_id, \"invalid_input\", \"no unit is selected\")\n\n    layout_stream = stream_id(unit_id, \"layout\")\n    version = latest_candidate(projection[\"artifact_versions\"], layout_stream)\n    require(version is not None, \"invalid_input\", f\"no rendered layout version on {layout_stream}\")\n\n    pdf_sha256 = version.get(\"pdf_sha256\")\n    require(isinstance(pdf_sha256, str) and pdf_sha256, \"integrity\", \"the layout version has no PDF hash\")\n\n    pdf_path = Path(str(version.get(\"pdf_path\")))\n    require(pdf_path.is_file(), \"integrity\", \"the rendered unit PDF is missing\", path=str(pdf_path))\n    actual = _sha256_file(pdf_path)\n    require(\n        actual == pdf_sha256,\n        \"integrity\",\n        \"the unit PDF's bytes changed after rendering\",\n        declared=pdf_sha256,\n        actual=actual,\n    )\n\n    registry = getattr(runtime_context, \"transport_registry\", None)\n    inspector = getattr(registry, \"inspect_pages\", None) if registry else None\n    require(callable(inspector), \"capability\", \"runtime context exposes no page inspector\")\n\n    try:\n        inspected = inspector(str(pdf_path), pdf_sha256)\n    except Exception as error:  # noqa: BLE001 - a rasterizer or tool fault is a system failure\n        raise SystemFailure(\n            \"tool\",\n            f\"page inspection failed for {unit_id}: {error}\",\n            {\"unit_id\": unit_id, \"pdf_sha256\": pdf_sha256},\n        ) from error\n\n    report = _record(inspected, f\"page inspection for {unit_id}\")\n    pages = report.get(\"pages\")\n    require(isinstance(pages, list), \"schema_contract\", \"page inspection returned a non-list page set\")\n\n    attempt = int(version.get(\"attempt\", 1))\n    numbers = [page.get(\"number\") for page in pages if isinstance(page, dict)]\n    contiguous = numbers == list(range(1, len(pages) + 1))\n    positive = len(pages) > 0\n\n    inventory = {\n        \"key\": f\"{unit_id}/{pdf_sha256}\",\n        \"unit_id\": unit_id,\n        \"pdf_sha256\": pdf_sha256,\n        \"page_count\": len(pages),\n        \"contiguous\": contiguous,\n        \"result\": \"PASS\" if positive and contiguous else \"FAIL\",\n    }\n\n    inspections: list[dict[str, Any]] = []\n    findings: list[dict[str, Any]] = []\n    if not (positive and contiguous):\n        findings.append(\n            {\n                \"check_id\": \"unit_page_inventory\",\n                \"owner\": \"unit layout\",\n                \"pointer\": \"/pages\",\n                \"message\": (\n                    \"page inventory is empty\" if not positive else f\"page numbering is not 1..N: {numbers}\"\n                ),\n            }\n        )\n\n    for page in pages:\n        page_record = _record(page, \"page inspection entry\")\n        number = page_record.get(\"number\")\n        problems = sorted(str(item) for item in page_record.get(\"problems\", []) or [])\n        unreadable = bool(page_record.get(\"unreadable\"))\n        if unreadable:\n            problems = sorted({*problems, \"unreadable\"})\n        # The review denominator is per page and by hash, so a page this node\n        # cannot identify by its own bytes is a page D15 could not freeze.\n        page_sha256 = page_record.get(\"page_sha256\")\n        require(\n            isinstance(page_sha256, str) and len(page_sha256) == 64,\n            \"integrity\",\n            f\"page {number} was inspected without a page hash\",\n            unit_id=unit_id,\n        )\n        image_path = page_record.get(\"image_path\")\n        require(\n            isinstance(image_path, str) and bool(image_path),\n            \"integrity\",\n            f\"page {number} was inspected without a rendered page image\",\n            unit_id=unit_id,\n        )\n        inspections.append(\n            {\n                \"key\": f\"{unit_id}/{pdf_sha256}/{number}\",\n                \"unit_id\": unit_id,\n                \"pdf_sha256\": pdf_sha256,\n                \"page\": number,\n                \"page_sha256\": page_sha256,\n                \"image_path\": image_path,\n                \"problems\": problems,\n                \"result\": \"PASS\" if not problems else \"FAIL\",\n            }\n        )\n        if problems:\n            findings.append(\n                {\n                    \"check_id\": \"unit_page_inspection\",\n                    \"owner\": \"unit layout\",\n                    \"pointer\": f\"/pages/{number}\",\n                    \"message\": f\"page {number} failed inspection: {problems}\",\n                }\n            )\n\n    check = check_record(\n        scope=\"unit\",\n        owner=unit_id,\n        head_hash=pdf_sha256,\n        check_id=\"unit_pages_inspected\",\n        attempt=attempt,\n        result=\"PASS\" if not findings else \"FAIL\",\n        detail={\"page_count\": len(pages), \"finding_count\": len(findings)},\n    )\n\n    value = \"pages_inspected\" if not findings else \"layout_repairable\"\n    return {\n        \"unit_page_inventories\": [inventory],\n        \"unit_page_inspections\": inspections,\n        \"deterministic_checks\": [check],\n        \"pending_guard\": guard(\n            \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", value, unit_id=unit_id, findings=findings\n        ),\n    }","numLines":140,"startLine":142,"totalLines":282}}}
