{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PMRn5XVLTkGzjgLcYcdxyG","type":"tool_result","content":"1678\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1679\t    tmp_path: Path, monkeypatch\n1680\t) -> None:\n1681\t    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n1682\t\n1683\t    The whole unit path now executes and M05 returns a real independent review.\n1684\t    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n1685\t    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n1686\t    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n1687\t    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n1688\t    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n1689\t    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n1690\t    F1). This only checks the halt is *some* declared row, not pinned to\n1691\t    today's, so it keeps proving \"no fabricated destination\" rather than just\n1692\t    \"today's specific one.\"\n1693\t    \"\"\"\n1694\t\n1695\t    fixture = _build_episode_fixture(tmp_path)\n1696\t    result = _run_episode(monkeypatch, fixture)\n1697\t\n1698\t    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n1699\t\n1700\t    state = result[\"state\"]\n1701\t    assert state.get(\"pending_failure\") is None\n1702\t    assert state.get(\"terminal\") is None\n1703\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1704\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1705\t    # handoff rather than a repair loop that happens to stop here.\n1706\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1707\t    assert sorted(state[\"artifact_heads\"]) == [\n1708\t        \"units/U001/content\",\n1709\t        \"units/U001/domain\",\n1710\t        \"units/U001/visuals\",\n1711\t    ]\n1712\t\n1713\t\n1714\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1715\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n1716\t    tmp_path: Path, monkeypatch, boundary: str\n1717\t) -> None:\n1718\t    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n1719\t\n1720\t    The signal is raised after `boundary` returns. The next boundary observes it,\n1721\t    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n1722\t    resume frontier — never two terminals, and never a product success. The\n1723\t    interrupt takes precedence over the guard value at every boundary, which is\n1724\t    why a signal raised after D09 still reaches the gate rather than D09's own\n1725\t    deferred destination.\n1726\t    \"\"\"\n1727\t\n1728\t    fixture = _build_episode_fixture(tmp_path, units=1)\n1729\t    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n1730\t    trace = result[\"trace\"]\n1731\t    terminal = result[\"state\"].get(\"terminal\")\n1732\t\n1733\t    assert boundary in trace\n1734\t    assert result[\"deferred_frontier\"] is None, (\n1735\t        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n1736\t    )\n1737\t    assert terminal is not None\n1738\t    assert terminal[\"kind\"] == \"INTERRUPTED\"\n1739\t    assert terminal[\"resumable\"] is True\n1740\t    assert terminal[\"exit_code\"] == 10\n1741\t    assert terminal[\"evidence\"][\"resume_frontier\"]\n1742\t    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n1743\t\n1744\t    # Exactly one terminal, counted as terminals and not as D98 entries. An\n1745\t    # interrupt raised inside a `Send` map sends every in-flight branch to the\n1746\t    # gate, so D96 and D98 legitimately run once per branch; what must never\n1747\t    # happen is a second terminal. The extra entries refuse rather than write.\n1748\t    assert len(result[\"state\"][\"terminal_history\"]) == 1\n1749\t    written = [\n1750\t        update\n1751\t        for node_id, update in result[\"updates\"]\n1752\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n1753\t    ]\n1754\t    assert len(written) == 1\n1755\t    for node_id, update in result[\"updates\"]:\n1756\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n1757\t            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"\n1758\t            assert \"already holds a terminal record\" in update[\"pending_failure\"][\"message\"]\n1759\t\n1760\t    # Nothing chargeable ran after the interrupt. Stated as three separate\n1761\t    # properties, because \"nothing at all ran\" is not true at a `Send` map and\n1762\t    # asserting it would be asserting a race rather than an invariant: when the\n1763\t    # signal is observed between two in-flight map branches, one branch routes to\n1764\t    # the gate while the sibling's already-decided normal edge still fires, so a\n1765\t    # deterministic node can legitimately complete alongside the gate. It cannot\n1766\t    # dispatch, though — its own guard sees the signal — and that is what prompt\n1767\t    # TEST 9's \"without repeated valid calls\" actually requires.\n1768\t    gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1769\t    after = trace[gate:]\n1770\t    # 1. No model node runs after the gate: no valid model call is repeated.\n1771\t    assert not set(after) & MODEL_NODE_IDS\n1772\t    # 2. No attempt is even reserved after it, so nothing became chargeable.\n1773\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1774\t    for node_id, update in result[\"updates\"][gate:]:\n1775\t        assert \"attempt_counters\" not in (update or {}), node_id\n1776\t    # 3. Anything else that ran is a deterministic node that was already in\n1777\t    #    flight, and it is bounded: it may not be an admission node, so no\n1778\t    #    artifact head can advance behind the interrupt.\n1779\t    stragglers = set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"}\n1780\t    assert stragglers <= set(NODE_CATALOGUE), stragglers\n1781\t    for node_id, update in result[\"updates\"][gate:]:\n1782\t        assert \"artifact_heads\" not in (update or {}), node_id\n1783\t\n1784\t\n1785\tdef test_an_interrupt_inside_a_send_map_is_bounded_across_repeated_episodes(\n1786\t    tmp_path: Path, monkeypatch\n1787\t) -> None:\n1788\t    \"\"\"The one boundary whose post-gate trace is not deterministic, pinned.\n1789\t\n1790\t    An interrupt observed between two in-flight `Send` branches is a real race:\n1791\t    across repeated runs of the *same* input, the sibling branch sometimes routes\n1792\t    to the gate and sometimes completes its own normal edge first. The matrix row\n1793\t    for this boundary would otherwise be asserting whichever outcome happened to\n1794\t    occur. Twelve episodes are run and the bound is asserted over all of them:\n1795\t    whatever the interleaving, exactly one terminal is written, no model node and\n1796\t    no attempt reservation ever follows the gate, and the only deterministic node\n1797\t    that can straggle is the sibling's own join target.\n1798\t    \"\"\"\n1799\t\n1800\t    shapes: set[tuple[str, ...]] = set()\n1801\t    for index in range(12):\n1802\t        fixture = _build_episode_fixture(tmp_path / f\"map-interrupt-{index}\")\n1803\t        result = _run_episode(\n1804\t            monkeypatch, fixture, interrupt_after=\"M01_RESEARCH_UNIT_SOURCES\"\n1805\t        )\n1806\t        trace = result[\"trace\"]\n1807\t        gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1808\t        after = trace[gate:]\n1809\t        shapes.add(tuple(after))\n1810\t\n1811\t        assert len(result[\"state\"][\"terminal_history\"]) == 1\n1812\t        assert result[\"state\"][\"terminal\"][\"kind\"] == \"INTERRUPTED\"\n1813\t        assert not set(after) & MODEL_NODE_IDS\n1814\t        assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1815\t        assert set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"} <= {\n1816\t            \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n1817\t        }\n1818\t\n1819\t    # The race is real and is recorded as such rather than asserted away: if a\n1820\t    # future change made it deterministic this would still pass, but the bound\n1821\t    # above is what the matrix row is entitled to claim.\n1822\t    assert shapes\n1823\t\n1824\t\n1825\tdef test_the_unobservable_boundary_is_excluded_for_a_stated_reason(\n1826\t    tmp_path: Path, monkeypatch\n1827\t) -> None:\n1828\t    \"\"\"M05 is left out of the crash matrix because it cannot be observed, not\n1829\t    because it is inconvenient.\n1830\t\n1831\t    M05 really executes — the committed state holds its execution receipt, its\n1832\t    candidate record and its page findings — but the branch that would emit its\n1833\t    update resolves to the deferred `D16_REDUCE_UNIT_EVIDENCE` and aborts the\n1834\t    superstep, so no stream consumer ever sees it. Both halves are asserted, so\n1835\t    the exclusion stops being true (and this test fails) the moment the path\n1836\t    extends past M05, exactly as it did when the frontier was D09.\n1837\t\n1838\t    Deliberately still pinned to `D16_REDUCE_UNIT_EVIDENCE` rather than a\n1839\t    derived frontier (unlike its sibling tests fixed under P-N30-001, closing\n1840\t    N90 finding F1): this test's whole premise is that M05 specifically is\n1841\t    unobservable *because* today's M05->D16 edge is the one that is deferred.\n1842\t    Once N31 wires D16-D23 that premise inverts — M05's own update becomes\n1843\t    observable and belongs in `REACHABLE_BOUNDARIES` instead — so this test is\n1844\t    expected to start failing at that point, and rewriting it then is N31's\n1845\t    (or whichever generation wires D16) to do, not a fixture to route