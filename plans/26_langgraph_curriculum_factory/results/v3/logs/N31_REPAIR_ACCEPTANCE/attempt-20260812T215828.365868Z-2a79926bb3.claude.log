{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018BYkGWu7W3oqvTbcXUGbfC","type":"tool_result","content":"479\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n480\t    required = {source for source, _ in SKELETON_BRANCHES}\n481\t    for source, target in SKELETON_NORMAL_EDGES:\n482\t        required.update({source, target})\n483\t    for source, _ in SKELETON_BRANCHES:\n484\t        required.update(routing.guard_destinations(source))\n485\t    return tuple(sorted(required - {START, END}))\n486\t\n487\t\n488\tdef build_curriculum_factory_graph(\n489\t    *, engine_root: Path, output_root: Path\n490\t) -> CompiledStateGraph:\n491\t    \"\"\"Build and compile the one production graph (spec section 4).\n492\t\n493\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n494\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n495\t    services are captured at build time, so the compiled object carries no\n496\t    run identity and no authorization.\n497\t    \"\"\"\n498\t\n499\t    engine_root = Path(engine_root).resolve()\n500\t    output_root = Path(output_root).resolve()\n501\t    builder: StateGraph = StateGraph(\n502\t        FactoryState,\n503\t        context_schema=RuntimeContext,\n504\t        input_schema=FactoryInput,\n505\t        output_schema=FactoryOutput,\n506\t    )\n507\t    register_skeleton(builder, binding_inventory())\n508\t    saver, _connection = open_checkpoint_saver(output_root)\n509\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n510\t\n511\t\n512\t# ---------------------------------------------------------------------- digest\n513\t\n514\t\n515\tdef _canonical_digest(payload: Any) -> str:\n516\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n517\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n518\t\n519\t\n520\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n521\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n522\t\n523\t    drawn = compiled.get_graph()\n524\t    return {\n525\t        \"name\": compiled.name,\n526\t        \"nodes\": sorted(drawn.nodes),\n527\t        \"edges\": sorted(\n528\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n529\t        ),\n530\t    }\n531\t\n532\t\n533\tdef contract_digests() -> dict[str, str]:\n534\t    \"\"\"File digests of every frozen model prompt and output schema.\n535\t\n536\t    Folded into the graph digest so prompt or schema drift is visible as graph\n537\t    drift: the same topology over a changed prompt is not the same graph.\n538\t    \"\"\"\n539\t\n540\t    digests: dict[str, str] = {}\n541\t    registry = tp.load_job_registry()\n542\t    for job_id in sorted(registry):\n543\t        route = registry[job_id]\n544\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n545\t            path = Path(path)\n546\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n547\t    return digests\n548\t\n549\t\n550\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n551\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n552\t\n553\t    Identical real bindings give an identical digest; a changed node body,\n554\t    reducer declaration, prompt, or schema changes it. Python object identity is\n555\t    deliberately not an input, so two builds in one process and two builds in two\n556\t    processes agree.\n557\t    \"\"\"\n558\t\n559\t    payload = {\n560\t        \"topology\": compiled_topology(compiled),\n561\t        \"bindings\": [\n562\t            _binding_record(node_id, body)\n563\t            for node_id, body in sorted(binding_inventory().items())\n564\t        ],\n565\t        \"state\": {\n566\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n567\t            \"input\": list(FACTORY_INPUT_FIELDS),\n568\t            \"output\": list(FACTORY_OUTPUT_FIELDS),\n569\t        },\n570\t        \"contracts\": contract_digests(),\n571\t    }\n572\t    return _canonical_digest(payload)"}]},"parent_tool_use_id":null,"session_id":"cb881043-b1ff-48a2-bb73-ddd6ca8a4c1a","uuid":"e6c6b912-4ab4-4ea2-b891-bad3ea0bf032","timestamp":"2026-08-12T22:01:38.995Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215828.365868Z-2a79926bb3/repo/runtime/langgraph_factory/graph.py","content":"def _skeleton_required_nodes() -> tuple[str, ...]:\n    required = {source for source, _ in SKELETON_BRANCHES}\n    for source, target in SKELETON_NORMAL_EDGES:\n        required.update({source, target})\n    for source, _ in SKELETON_BRANCHES:\n        required.update(routing.guard_destinations(source))\n    return tuple(sorted(required - {START, END}))\n\n\ndef build_curriculum_factory_graph(\n    *, engine_root: Path, output_root: Path\n) -> CompiledStateGraph:\n    \"\"\"Build and compile the one production graph (spec section 4).\n\n    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n    returned graph is invoked with `context=build_runtime_context(...)`; no\n    services are captured at build time, so the compiled object carries no\n    run identity and no authorization.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    builder: StateGraph = StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n    register_skeleton(builder, binding_inventory())\n    saver, _connection = open_checkpoint_saver(output_root)\n    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n\n\n# ---------------------------------------------------------------------- digest\n\n\ndef _canonical_digest(payload: Any) -> str:\n    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n\n\ndef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n\n    drawn = compiled.get_graph()\n    return {\n        \"name\": compiled.name,\n        \"nodes\": sorted(drawn.nodes),\n        \"edges\": sorted(\n            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n        ),\n    }\n\n\ndef contract_digests() -> dict[str, str]:\n    \"\"\"File digests of every frozen model prompt and output schema.\n\n    Folded into the graph digest so prompt or schema drift is visible as graph\n    drift: the same topology over a changed prompt is not the same graph.\n    \"\"\"\n\n    digests: dict[str, str] = {}\n    registry = tp.load_job_registry()\n    for job_id in sorted(registry):\n        route = registry[job_id]\n        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n            path = Path(path)\n            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return digests\n\n\ndef graph_digest(compiled: CompiledStateGraph) -> str:\n    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n\n    Identical real bindings give an identical digest; a changed node body,\n    reducer declaration, prompt, or schema changes it. Python object identity is\n    deliberately not an input, so two builds in one process and two builds in two\n    processes agree.\n    \"\"\"\n\n    payload = {\n        \"topology\": compiled_topology(compiled),\n        \"bindings\": [\n            _binding_record(node_id, body)\n            for node_id, body in sorted(binding_inventory().items())\n        ],\n        \"state\": {\n            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n            \"input\": list(FACTORY_INPUT_FIELDS),\n            \"output\": list(FACTORY_OUTPUT_FIELDS),\n        },\n        \"contracts\": contract_digests(),\n    }\n    return _canonical_digest(payload)","numLines":94,"startLine":479,"totalLines":573}}}
