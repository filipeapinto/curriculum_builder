{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QDcwJ79bXuHb59o2HktXpf","type":"tool_result","content":"1\t\"\"\"Plan 26 per-unit path gate (spec sections 8.1, 8.2, 10, 11.3-11.4): N30's wiring.\n2\t\n3\tEvery topology assertion runs against the one real `CompiledStateGraph` that\n4\t`graph.build_curriculum_factory_graph` produces from the real N22/N23 callables,\n5\tand every denominator assertion runs the real node body and the real guard. A\n6\tmock would prove that a stand-in joins correctly, which is the one thing this\n7\tfile exists to rule out.\n8\t\n9\tThe episode now really executes: `_run_episode` streams the one compiled\n10\tproduction graph from D00 to a written terminal, against `RuntimeContext` test\n11\tdoubles and a test-only model transport. Three kinds of test live here:\n12\t\n13\t- assertions about the unit topology that is genuinely registered now,\n14\t- assertions that run one real episode of the real compiled graph, and\n15\t- explicitly named `test_blocked_*` guards that assert the *current, broken*\n16\t  behaviour of a dependency outside this node's write set.\n17\t\n18\tEach blocked guard names its owner and the exact rework that inverts it, and\n19\t`test_every_blocking_gap_is_declared_with_an_owner_and_rework_edge` keeps that\n20\tlist total, so a gap cannot be quietly forgotten once it is fixed: the guard\n21\tfails the moment the rework lands, which is what forces this file to be\n22\trevisited. The guards that closed B-1, B-2 and B-3 were inverted this way and\n23\tnow assert the fixed behaviour instead.\n24\t\n25\tSkips only where the hash-locked environment is absent; the node's evidence was\n26\tproduced by running this file inside it.\n27\t\"\"\"\n28\t\n29\timport ast\n30\timport hashlib\n31\timport inspect\n32\timport json\n33\timport random\n34\timport re\n35\timport sys\n36\timport tempfile\n37\timport unittest\n38\tfrom pathlib import Path\n39\tfrom typing import Any\n40\t\n41\ttry:  # pragma: no cover - environment probe, not behavior\n42\t    import langgraph  # noqa: F401\n43\t    import langgraph.checkpoint.sqlite  # noqa: F401\n44\texcept ModuleNotFoundError as exc:  # pragma: no cover\n45\t    raise unittest.SkipTest(\n46\t        \"plan26 hash-locked environment not installed \"\n47\t        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n48\t        f\"{exc}\"\n49\t    ) from exc\n50\t\n51\timport pytest\n52\timport yaml\n53\tfrom langgraph.channels.binop import BinaryOperatorAggregate\n54\tfrom langgraph.graph import END, START, StateGraph\n55\tfrom langgraph.types import Send\n56\tfrom typing_extensions import Annotated, TypedDict\n57\t\n58\tfrom runtime.langgraph_factory import graph as G\n59\tfrom runtime.langgraph_factory import model_nodes as mn\n60\tfrom runtime.langgraph_factory import persistence as P\n61\tfrom runtime.langgraph_factory import routing as R\n62\tfrom runtime.langgraph_factory import unit_graph as U\n63\tfrom runtime.langgraph_factory.nodes import (\n64\t    NODE_CATALOGUE,\n65\t    domain,\n66\t    inputs,\n67\t    render,\n68\t    review,\n69\t    sources,\n70\t    visuals,\n71\t)\n72\tfrom runtime.langgraph_factory.reducers import WriteOnceConflict, write_once\n73\tfrom runtime.langgraph_factory.state import (\n74\t    FACTORY_STATE_FIELDS,\n75\t    FIELD_REDUCER_CLASSES,\n76\t    FactoryState,\n77\t)\n78\t\n79\tREPO_ROOT = Path(__file__).resolve().parents[2]\n80\tUNIT_GRAPH_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"unit_graph.py\"\n81\t\n82\tMODEL_NODE_IDS = frozenset(mn.MODEL_NODE_ADAPTERS)\n83\t\n84\t\n85\t# ---------------------------------------------------------------------------\n86\t# fixtures — one real compiled graph, shared\n87\t# ---------------------------------------------------------------------------\n88\t\n89\t\n90\t@pytest.fixture(scope=\"module\")\n91\tdef compiled() -> Any:\n92\t    output_root = Path(tempfile.mkdtemp(prefix=\"plan26-n30-\"))\n93\t    return G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n94\t\n95\t\n96\t@pytest.fixture(scope=\"module\")\n97\tdef topology(compiled: Any) -> dict[str, Any]:\n98\t    return G.compiled_topology(compiled)\n99\t\n100\t\n101\t@pytest.fixture(scope=\"module\")\n102\tdef available() -> tuple[str, ...]:\n103\t    return tuple(sorted(G.binding_inventory()))\n104\t\n105\t\n106\tclass _Token:\n107\t    def is_set(self) -> bool:\n108\t        return False\n109\t\n110\t"}]},"parent_tool_use_id":null,"session_id":"b1f1ac47-68e2-44fb-bfa5-0ab46fd6f0a8","uuid":"a6523d3e-583a-43bc-8ace-98a8ed42875a","timestamp":"2026-08-12T21:20:12.413Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T211427.316028Z-623ff2d9fa/repo/tests/runtime/test_plan26_unit_graph.py","content":"\"\"\"Plan 26 per-unit path gate (spec sections 8.1, 8.2, 10, 11.3-11.4): N30's wiring.\n\nEvery topology assertion runs against the one real `CompiledStateGraph` that\n`graph.build_curriculum_factory_graph` produces from the real N22/N23 callables,\nand every denominator assertion runs the real node body and the real guard. A\nmock would prove that a stand-in joins correctly, which is the one thing this\nfile exists to rule out.\n\nThe episode now really executes: `_run_episode` streams the one compiled\nproduction graph from D00 to a written terminal, against `RuntimeContext` test\ndoubles and a test-only model transport. Three kinds of test live here:\n\n- assertions about the unit topology that is genuinely registered now,\n- assertions that run one real episode of the real compiled graph, and\n- explicitly named `test_blocked_*` guards that assert the *current, broken*\n  behaviour of a dependency outside this node's write set.\n\nEach blocked guard names its owner and the exact rework that inverts it, and\n`test_every_blocking_gap_is_declared_with_an_owner_and_rework_edge` keeps that\nlist total, so a gap cannot be quietly forgotten once it is fixed: the guard\nfails the moment the rework lands, which is what forces this file to be\nrevisited. The guards that closed B-1, B-2 and B-3 were inverted this way and\nnow assert the fixed behaviour instead.\n\nSkips only where the hash-locked environment is absent; the node's evidence was\nproduced by running this file inside it.\n\"\"\"\n\nimport ast\nimport hashlib\nimport inspect\nimport json\nimport random\nimport re\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom typing import Any\n\ntry:  # pragma: no cover - environment probe, not behavior\n    import langgraph  # noqa: F401\n    import langgraph.checkpoint.sqlite  # noqa: F401\nexcept ModuleNotFoundError as exc:  # pragma: no cover\n    raise unittest.SkipTest(\n        \"plan26 hash-locked environment not installed \"\n        \"(python3 -m pip install --require-hashes -r requirements/plan26.lock): \"\n        f\"{exc}\"\n    ) from exc\n\nimport pytest\nimport yaml\nfrom langgraph.channels.binop import BinaryOperatorAggregate\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.types import Send\nfrom typing_extensions import Annotated, TypedDict\n\nfrom runtime.langgraph_factory import graph as G\nfrom runtime.langgraph_factory import model_nodes as mn\nfrom runtime.langgraph_factory import persistence as P\nfrom runtime.langgraph_factory import routing as R\nfrom runtime.langgraph_factory import unit_graph as U\nfrom runtime.langgraph_factory.nodes import (\n    NODE_CATALOGUE,\n    domain,\n    inputs,\n    render,\n    review,\n    sources,\n    visuals,\n)\nfrom runtime.langgraph_factory.reducers import WriteOnceConflict, write_once\nfrom runtime.langgraph_factory.state import (\n    FACTORY_STATE_FIELDS,\n    FIELD_REDUCER_CLASSES,\n    FactoryState,\n)\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nUNIT_GRAPH_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"unit_graph.py\"\n\nMODEL_NODE_IDS = frozenset(mn.MODEL_NODE_ADAPTERS)\n\n\n# ---------------------------------------------------------------------------\n# fixtures — one real compiled graph, shared\n# ---------------------------------------------------------------------------\n\n\n@pytest.fixture(scope=\"module\")\ndef compiled() -> Any:\n    output_root = Path(tempfile.mkdtemp(prefix=\"plan26-n30-\"))\n    return G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n\n\n@pytest.fixture(scope=\"module\")\ndef topology(compiled: Any) -> dict[str, Any]:\n    return G.compiled_topology(compiled)\n\n\n@pytest.fixture(scope=\"module\")\ndef available() -> tuple[str, ...]:\n    return tuple(sorted(G.binding_inventory()))\n\n\nclass _Token:\n    def is_set(self) -> bool:\n        return False\n\n","numLines":110,"startLine":1,"totalLines":2693}}}
