{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CdyYiRTZVvK6ukra8RAXK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015HWWsBQE7b6qWUbPeuGf1j","name":"Read","input":{"file_path":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T211427.316028Z-623ff2d9fa/repo/runtime/langgraph_factory/graph.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1028,"cache_read_input_tokens":51364,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1028},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b1f1ac47-68e2-44fb-bfa5-0ab46fd6f0a8","uuid":"574151a9-2f4b-4119-914e-9904645a24a7","timestamp":"2026-08-12T21:15:43.824Z","request_id":"req_011CdyYiQZEcaL4QqzVb9ryR"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015HWWsBQE7b6qWUbPeuGf1j","type":"tool_result","content":"1\t\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n2\t\n3\tThis module owns registration, not node bodies. Every callable it registers is\n4\tresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\n5\tthat is missing, placeholder, test-only, duplicated, or dangling fails the build\n6\tby stable ID rather than compiling into a graph that would look complete.\n7\t\n8\tIt also owns the two things no node body can own:\n9\t\n10\t- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n11\t  records a graceful interrupt observed at the node's atomic boundary, and turns\n12\t  an unexpected exception into a classified `pending_failure` instead of letting\n13\t  an unproven state continue;\n14\t- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n15\t  guard, evidence writer, transport registry, source retriever, signal token and\n16\t  clock, and holds no model client and no routing authority.\n17\t\n18\tScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\n19\tpath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n20\t`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\n21\tmap/reduce, and the workbook branch are registered by N30 and N32 into this same\n22\tbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\n23\tbut not yet wired, so an undeclared unwired node still fails compilation.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport inspect\n30\timport json\n31\timport re\n32\tfrom collections.abc import Callable, Mapping, Sequence\n33\tfrom datetime import datetime, timezone\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom langgraph.errors import GraphBubbleUp\n38\tfrom langgraph.graph import END, START, StateGraph\n39\tfrom langgraph.graph.state import CompiledStateGraph\n40\tfrom langgraph.runtime import Runtime\n41\t\n42\tfrom . import routing, transport as tp, unit_graph, workbook\n43\tfrom .artifacts import ArtifactStore\n44\tfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\n45\tfrom .evidence import EvidenceStore\n46\tfrom .model_nodes import (\n47\t    MODEL_BOOKKEEPING_NODES,\n48\t    MODEL_NODE_ADAPTERS,\n49\t    build_model_node_context,\n50\t)\n51\tfrom .nodes import NODE_CATALOGUE, node_registry\n52\tfrom .persistence import InterruptToken, open_checkpoint_saver\n53\tfrom .state import (\n54\t    FACTORY_INPUT_FIELDS,\n55\t    FACTORY_OUTPUT_FIELDS,\n56\t    FACTORY_STATE_FIELDS,\n57\t    FIELD_REDUCER_CLASSES,\n58\t    FactoryInput,\n59\t    FactoryOutput,\n60\t    FactoryState,\n61\t    RuntimeContext,\n62\t)\n63\t\n64\t__all__ = [\n65\t    \"GRAPH_NAME\",\n66\t    \"GraphBindingError\",\n67\t    \"DEFERRED_TOPOLOGY\",\n68\t    \"SKELETON_NORMAL_EDGES\",\n69\t    \"SKELETON_BRANCHES\",\n70\t    \"build_runtime_context\",\n71\t    \"binding_inventory\",\n72\t    \"validate_bindings\",\n73\t    \"register_skeleton\",\n74\t    \"build_curriculum_factory_graph\",\n75\t    \"compiled_topology\",\n76\t    \"graph_digest\",\n77\t    \"contract_digests\",\n78\t]\n79\t\n80\tGRAPH_NAME = \"plan26_curriculum_factory\"\n81\t\n82\t\n83\tclass GraphBindingError(RuntimeError):\n84\t    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n85\t\n86\t\n87\t# Only these modules may supply a production node body. A callable from anywhere\n88\t# else — a test module, a notebook, a locally defined lambda — is rejected by\n89\t# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n90\t# a stand-in\".\n91\tPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n92\t    \"runtime.langgraph_factory.nodes\",\n93\t    \"runtime.langgraph_factory.model_nodes\",\n94\t    \"runtime.langgraph_factory.workbook\",\n95\t)\n96\t\n97\tPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n98\t    \"stub\",\n99\t    \"placeholder\",\n100\t    \"fake\",\n101\t    \"dummy\",\n102\t    \"mock\",\n103\t    \"sample\",\n104\t    \"example\",\n105\t    \"todo\",\n106\t    \"noop\",\n107\t    \"test\",\n108\t)\n109\t\n110\tPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n111\t    \"raise NotImplementedError\",\n112\t    \"TODO: implement\",\n113\t    \"placeholder implementation\",\n114\t)\n115\t\n116\t# Registered here, wired by a later graph node. A node that is neither wired by\n117\t# the skeleton nor declared here fails the build: silence about an unwired node\n118\t# is how a topology gap becomes a silent halt at runtime.\n119\tDEFERRED_TOPOLOGY: Mapping[str, str] = {\n120\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n121\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n122\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n123\t}\n124\t\n125\tSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n126\t    (START, \"D00_BOOTSTRAP_EPISODE\"),\n127\t    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n128\t    (\"D98_WRITE_TERMINAL\", END),\n129\t)\n130\t\n131\tSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n132\t    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n133\t    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n134\t    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n135\t    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n136\t    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n137\t    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n138\t)\n139\t\n140\t\n141\t# --------------------------------------------------------------- runtime context\n142\t\n143\t\n144\tdef _utc_clock() -> str:\n145\t    return datetime.now(timezone.utc).isoformat()\n146\t\n147\t\n148\tdef build_runtime_context(\n149\t    *,\n150\t    engine_root: Path | str,\n151\t    output_root: Path | str,\n152\t    run_id: str,\n153\t    curriculum_digest: str,\n154\t    authorization: Any = None,\n155\t    capability_proof: Mapping[str, Any] | None = None,\n156\t    retrieval_hosts: Sequence[str] = (),\n157\t    clock: Callable[[], Any] = _utc_clock,\n158\t    env_passthrough: Sequence[str] = (),\n159\t) -> RuntimeContext:\n160\t    \"\"\"Open the services one invocation may reach (spec section 5.2).\n161\t\n162\t    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n163\t    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n164\t    inside the builder, because the transport and the authorization it enforces\n165\t    are bound to a run identity that does not exist at build time.\n166\t    \"\"\"\n167\t\n168\t    engine_root = Path(engine_root).resolve()\n169\t    output_root = Path(output_root).resolve()\n170\t    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n171\t    egress_guard = EgressGuard(receipts)\n172\t    return RuntimeContext(\n173\t        engine_root=engine_root,\n174\t        output_root=output_root,\n175\t        path_guard=ArtifactStore(output_root),\n176\t        evidence_service=EvidenceStore(output_root),\n177\t        transport_registry=tp.CliTransport(\n178\t            output_root=output_root,\n179\t            run_id=run_id,\n180\t            curriculum_digest=curriculum_digest,\n181\t            authorization=authorization,\n182\t            receipts=receipts,\n183\t            guard=egress_guard,\n184\t            ledger=tp.AttemptLedger(),\n185\t            capability_proof=capability_proof,\n186\t            env_passthrough=env_passthrough,\n187\t        ),\n188\t        source_retriever=SourceRetriever(\n189\t            guard=egress_guard,\n190\t            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n191\t        ),\n192\t        signal_token=InterruptToken(output_root),\n193\t        clock=clock,\n194\t    )\n195\t\n196\t\n197\t# ----------------------------------------------------------------- node boundary\n198\t\n199\t\n200\tdef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n201\t    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n202\t\n203\t    marked = dict(update)\n204\t    guard = marked.get(\"pending_guard\")\n205\t    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n206\t    guard[\"interrupt_requested\"] = True\n207\t    marked[\"pending_guard\"] = guard\n208\t    return marked\n209\t\n210\t\n211\tdef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n212\t    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n213\t\n214\t    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n215\t    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n216\t    callables take it as an explicit argument precisely so they cannot fetch it\n217\t    themselves.\n218\t    \"\"\"\n219\t\n220\t    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n221\t        context = getattr(runtime, \"context\", None)\n222\t        try:\n223\t            if model_node:\n224\t                update = body(state, build_model_node_context(context))\n225\t            else:\n226\t                update = body(state, context)\n227\t        except GraphBubbleUp:\n228\t            # LangGraph's own control flow (interrupt/resume propagation) is not a\n229\t            # product failure and must reach the engine untouched.\n230\t            raise\n231\t        except Exception as error:  # the classified-failure contract of spec 6.1\n232\t            return {\n233\t                \"pending_failure\": {\n234\t                    \"node\": node_id,\n235\t                    \"class\": \"system\",\n236\t                    \"cause\": \"unhandled\",\n237\t                    \"message\": f\"{type(error).__name__}: {error}\",\n238\t                    \"evidence\": {\"boundary\": \"node\"},\n239\t                },\n240\t                \"pending_guard\": None,\n241\t            }\n242\t        token = getattr(context, \"signal_token\", None)\n243\t        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n244\t            return _mark_interrupt(update, node_id)\n245\t        return dict(update)\n246\t\n247\t    node.__name__ = node_id\n248\t    node.__qualname__ = node_id\n249\t    node.__doc__ = getattr(body, \"__doc__\", None)\n250\t    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n251\t    return node\n252\t\n253\t\n254\tdef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n255\t    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n256\t\n257\t    return getattr(body, \"node_body\", body)\n258\t\n259\t\n260\tdef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n261\t    target = _underlying(body)\n262\t    try:\n263\t        source = inspect.getsource(target)\n264\t    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n265\t        source = \"\"\n266\t    return {\n267\t        \"node_id\": node_id,\n268\t        \"module\": getattr(target, \"__module__\", \"\"),\n269\t        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n270\t        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n271\t        \"source_lines\": len(source.splitlines()),\n272\t    }\n273\t\n274\t\n275\t# ------------------------------------------------------------ binding validation\n276\t\n277\t\n278\tdef binding_inventory() -> dict[str, Callable[..., Any]]:\n279\t    \"\"\"Every node callable the *skeleton and unit path* resolve against.\n280\t\n281\t    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n282\t    are absent here: they are exercised at the function level by N31's own\n283\t    tests, and this generation does not wire their topology (spec section\n284\t    8.1's D08/D09/D12/D14/D91 -> D17 and M05 -> D16 edges stay the declared\n285\t    `unit_graph.DEFERRED_EDGES` rows they already are).\n286\t\n287\t    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n288\t    likewise absent from *this* function deliberately, not by oversight: D24\n289\t    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n290\t    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n291\t    already-verified tables) declare that edge deferred to N32 by name. If D24\n292\t    entered this function, `unit_graph.register_unit_path`'s *own*\n293\t    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n294\t    silently widen to include it -- correct for a production run, but it\n295\t    would falsify N30's own already-passing topology tests, which independently\n296\t    recompute their expectation from this exact function's return value.\n297\t    `register_workbook_topology` registers the workbook engine as an additive\n298\t    step over its own separate builder (N32 exercises it directly, not through\n299\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n300\t    byte-identical to what they were before N32 and the workbook branch is\n301\t    still fully real -- just not reachable from `D05` in this generation,\n302\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n303\t    \"\"\"\n304\t\n305\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n306\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n307\t        bindings[job_id] = adapter\n308\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n309\t    return bindings\n310\t\n311\t\n312\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n313\t    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n314\t\n315\t    The complete node set the compiled graph actually registers. Kept\n316\t    separate from `binding_inventory()` itself for the reason documented\n317\t    there: several of N30's own tests recompute their expectation directly\n318\t    from `binding_inventory()`'s return value, so that function's contract\n319\t    (the skeleton/unit-path view) must stay exactly what it was before N32.\n320\t    \"\"\"\n321\t\n322\t    bindings = dict(binding_inventory())\n323\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n324\t    return bindings\n325\t\n326\t\n327\tdef _reject(code: str, node_id: str, detail: str) -> None:\n328\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n329\t\n330\t\n331\tdef validate_bindings(\n332\t    bindings: Mapping[str, Callable[..., Any]],\n333\t    *,\n334\t    required: Sequence[str],\n335\t) -> dict[str, dict[str, Any]]:\n336\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n337\t\n338\t    for node_id in required:\n339\t        if node_id not in bindings:\n340\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n341\t\n342\t    seen: dict[tuple[str, str], str] = {}\n343\t    inventory: dict[str, dict[str, Any]] = {}\n344\t    for node_id in sorted(bindings):\n345\t        body = bindings[node_id]\n346\t        if not callable(body):\n347\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n348\t        record = _binding_record(node_id, body)\n349\t        module = record[\"module\"]\n350\t        if not any(\n351\t            module == allowed or module.startswith(f\"{allowed}.\")\n352\t            for allowed in PRODUCTION_BINDING_MODULES\n353\t        ):\n354\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n355\t        lowered = f\"{module}.{record['qualname']}\".lower()\n356\t        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n357\t        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n358\t        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n359\t        # positive on the spec's own vocabulary, not a caught stand-in.\n360\t        marker = next(\n361\t            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n362\t            None,\n363\t        )\n364\t        if marker is not None:\n365\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n366\t        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n367\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n368\t        source = inspect.getsource(_underlying(body))\n369\t        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n370\t        if marker is not None:\n371\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n372\t        identity = (module, record[\"qualname\"])\n373\t        if identity in seen:\n374\t            _reject(\n375\t                \"N20-BIND-DUPLICATE\",\n376\t                node_id,\n377\t                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n378\t            )\n379\t        seen[identity] = node_id\n380\t        inventory[node_id] = record\n381\t    return inventory\n382\t\n383\t\n384\tdef _validate_topology(registered: Sequence[str]) -> None:\n385\t    known = set(registered) | {START, END}\n386\t    wired: set[str] = set()\n387\t    for source, target in SKELETON_NORMAL_EDGES:\n388\t        for endpoint in (source, target):\n389\t            if endpoint not in known:\n390\t                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n391\t        wired.update({source, target})\n392\t    for source, path in SKELETON_BRANCHES:\n393\t        if source not in known:\n394\t            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n395\t        wired.add(source)\n396\t        for target in routing.guard_destinations(source):\n397\t            if target not in known:\n398\t                _reject(\n399\t                    \"N20-EDGE-DANGLING\",\n400\t                    target,\n401\t                    f\"{source} branch {path.__name__} names an unregistered destination\",\n402\t                )\n403\t            wired.add(target)\n404\t    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n405\t        wired.update({source, target})\n406\t    for source, _ in unit_graph.UNIT_BRANCHES:\n407\t        wired.add(source)\n408\t        wired.update(unit_graph.branch_destinations(source, registered))\n409\t    for node_id in registered:\n410\t        if node_id in wired:\n411\t            continue\n412\t        owner = DEFERRED_TOPOLOGY.get(node_id)\n413\t        if owner is None:\n414\t            _reject(\n415\t                \"N20-NODE-UNDECLARED\",\n416\t                node_id,\n417\t                \"is registered but neither wired by the skeleton nor declared deferred\",\n418\t            )\n419\t\n420\t\n421\t# ---------------------------------------------------------------- registration\n422\t\n423\t\n424\tdef register_skeleton(\n425\t    builder: StateGraph,\n426\t    bindings: Mapping[str, Callable[..., Any]],\n427\t) -> dict[str, dict[str, Any]]:\n428\t    \"\"\"Register every available node and the fixed skeleton edges.\n429\t\n430\t    N30 and N32 extend the same builder by adding their own `add_node`-free\n431\t    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n432\t    rewritten by them, so the skeleton stays the one place START, the recovery\n433\t    branch, and the single edge to END are decided.\n434\t    \"\"\"\n435\t\n436\t    routing.assert_guard_table_total(NODE_CATALOGUE)\n437\t    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n438\t    _validate_topology(sorted(bindings))\n439\t\n440\t    for node_id in sorted(bindings):\n441\t        model_node = node_id in MODEL_NODE_ADAPTERS\n442\t        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n443\t\n444\t    for source, target in SKELETON_NORMAL_EDGES:\n445\t        builder.add_edge(source, target)\n446\t\n447\t    for source, path in SKELETON_BRANCHES:\n448\t        destinations = routing.guard_destinations(source)\n449\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n450\t\n451\t    unit_graph.register_unit_path(builder, sorted(bindings))\n452\t\n453\t    return inventory\n454\t\n455\t\n456\tdef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n457\t    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n458\t\n459\t    Not called by `build_curriculum_factory_graph`: this generation's single\n460\t    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n461\t    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n462\t    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n463\t    this function into whatever the production compile point becomes once the\n464\t    workbook branch is in scope; until then it is exercised directly, over its\n465\t    own builder, the way N32's own topology test already does.\n466\t    `register_skeleton` itself must never see these bindings; this function\n467\t    adds exactly the nodes `register_skeleton` did not, then wires them over\n468\t    the *full* merged node set so `workbook.register_workbook_path` can\n469\t    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n470\t    \"\"\"\n471\t\n472\t    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n473\t    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n474\t    for node_id in sorted(workbook_bindings):\n475\t        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n476\t    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n477\t\n478\t\n479\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n480\t    required = {source for source, _ in SKELETON_BRANCHES}\n481\t    for source, target in SKELETON_NORMAL_EDGES:\n482\t        required.update({source, target})\n483\t    for source, _ in SKELETON_BRANCHES:\n484\t        required.update(routing.guard_destinations(source))\n485\t    return tuple(sorted(required - {START, END}))\n486\t\n487\t\n488\tdef build_curriculum_factory_graph(\n489\t    *, engine_root: Path, output_root: Path\n490\t) -> CompiledStateGraph:\n491\t    \"\"\"Build and compile the one production graph (spec section 4).\n492\t\n493\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n494\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n495\t    services are captured at build time, so the compiled object carries no\n496\t    run identity and no authorization.\n497\t    \"\"\"\n498\t\n499\t    engine_root = Path(engine_root).resolve()\n500\t    output_root = Path(output_root).resolve()\n501\t    builder: StateGraph = StateGraph(\n502\t        FactoryState,\n503\t        context_schema=RuntimeContext,\n504\t        input_schema=FactoryInput,\n505\t        output_schema=FactoryOutput,\n506\t    )\n507\t    register_skeleton(builder, binding_inventory())\n508\t    saver, _connection = open_checkpoint_saver(output_root)\n509\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n510\t\n511\t\n512\t# ---------------------------------------------------------------------- digest\n513\t\n514\t\n515\tdef _canonical_digest(payload: Any) -> str:\n516\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n517\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n518\t\n519\t\n520\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n521\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n522\t\n523\t    drawn = compiled.get_graph()\n524\t    return {\n525\t        \"name\": compiled.name,\n526\t        \"nodes\": sorted(drawn.nodes),\n527\t        \"edges\": sorted(\n528\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n529\t        ),\n530\t    }\n531\t\n532\t\n533\tdef contract_digests() -> dict[str, str]:\n534\t    \"\"\"File digests of every frozen model prompt and output schema.\n535\t\n536\t    Folded into the graph digest so prompt or schema drift is visible as graph\n537\t    drift: the same topology over a changed prompt is not the same graph.\n538\t    \"\"\"\n539\t\n540\t    digests: dict[str, str] = {}\n541\t    registry = tp.load_job_registry()\n542\t    for job_id in sorted(registry):\n543\t        route = registry[job_id]\n544\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n545\t            path = Path(path)\n546\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n547\t    return digests\n548\t\n549\t\n550\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n551\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n552\t\n553\t    Identical real bindings give an identical digest; a changed node body,\n554\t    reducer declaration, prompt, or schema changes it. Python object identity is\n555\t    deliberately not an input, so two builds in one process and two builds in two\n556\t    processes agree.\n557\t    \"\"\"\n558\t\n559\t    payload = {\n560\t        \"topology\": compiled_topology(compiled),\n561\t        \"bindings\": [\n562\t            _binding_record(node_id, body)\n563\t            for node_id, body in sorted(binding_inventory().items())\n564\t        ],\n565\t        \"state\": {\n566\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n567\t            \"input\": list(FACTORY_INPUT_FIELDS),\n568\t            \"output\": list(FACTORY_OUTPUT_FIELDS),\n569\t        },\n570\t        \"contracts\": contract_digests(),\n571\t    }\n572\t    return _canonical_digest(payload)\n573\t"}]},"parent_tool_use_id":null,"session_id":"b1f1ac47-68e2-44fb-bfa5-0ab46fd6f0a8","uuid":"24c24013-956f-4a1b-b378-a9b2234fd1d4","timestamp":"2026-08-12T21:15:43.831Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T211427.316028Z-623ff2d9fa/repo/runtime/langgraph_factory/graph.py","content":"\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n\nThis module owns registration, not node bodies. Every callable it registers is\nresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\nthat is missing, placeholder, test-only, duplicated, or dangling fails the build\nby stable ID rather than compiling into a graph that would look complete.\n\nIt also owns the two things no node body can own:\n\n- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n  records a graceful interrupt observed at the node's atomic boundary, and turns\n  an unexpected exception into a classified `pending_failure` instead of letting\n  an unproven state continue;\n- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n  guard, evidence writer, transport registry, source retriever, signal token and\n  clock, and holds no model client and no routing authority.\n\nScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\npath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\nmap/reduce, and the workbook branch are registered by N30 and N32 into this same\nbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\nbut not yet wired, so an undeclared unwired node still fails compilation.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport inspect\nimport json\nimport re\nfrom collections.abc import Callable, Mapping, Sequence\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom langgraph.errors import GraphBubbleUp\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.graph.state import CompiledStateGraph\nfrom langgraph.runtime import Runtime\n\nfrom . import routing, transport as tp, unit_graph, workbook\nfrom .artifacts import ArtifactStore\nfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\nfrom .evidence import EvidenceStore\nfrom .model_nodes import (\n    MODEL_BOOKKEEPING_NODES,\n    MODEL_NODE_ADAPTERS,\n    build_model_node_context,\n)\nfrom .nodes import NODE_CATALOGUE, node_registry\nfrom .persistence import InterruptToken, open_checkpoint_saver\nfrom .state import (\n    FACTORY_INPUT_FIELDS,\n    FACTORY_OUTPUT_FIELDS,\n    FACTORY_STATE_FIELDS,\n    FIELD_REDUCER_CLASSES,\n    FactoryInput,\n    FactoryOutput,\n    FactoryState,\n    RuntimeContext,\n)\n\n__all__ = [\n    \"GRAPH_NAME\",\n    \"GraphBindingError\",\n    \"DEFERRED_TOPOLOGY\",\n    \"SKELETON_NORMAL_EDGES\",\n    \"SKELETON_BRANCHES\",\n    \"build_runtime_context\",\n    \"binding_inventory\",\n    \"validate_bindings\",\n    \"register_skeleton\",\n    \"build_curriculum_factory_graph\",\n    \"compiled_topology\",\n    \"graph_digest\",\n    \"contract_digests\",\n]\n\nGRAPH_NAME = \"plan26_curriculum_factory\"\n\n\nclass GraphBindingError(RuntimeError):\n    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n\n\n# Only these modules may supply a production node body. A callable from anywhere\n# else — a test module, a notebook, a locally defined lambda — is rejected by\n# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n# a stand-in\".\nPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n    \"runtime.langgraph_factory.nodes\",\n    \"runtime.langgraph_factory.model_nodes\",\n    \"runtime.langgraph_factory.workbook\",\n)\n\nPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n    \"stub\",\n    \"placeholder\",\n    \"fake\",\n    \"dummy\",\n    \"mock\",\n    \"sample\",\n    \"example\",\n    \"todo\",\n    \"noop\",\n    \"test\",\n)\n\nPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n    \"raise NotImplementedError\",\n    \"TODO: implement\",\n    \"placeholder implementation\",\n)\n\n# Registered here, wired by a later graph node. A node that is neither wired by\n# the skeleton nor declared here fails the build: silence about an unwired node\n# is how a topology gap becomes a silent halt at runtime.\nDEFERRED_TOPOLOGY: Mapping[str, str] = {\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n}\n\nSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n    (START, \"D00_BOOTSTRAP_EPISODE\"),\n    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n    (\"D98_WRITE_TERMINAL\", END),\n)\n\nSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n)\n\n\n# --------------------------------------------------------------- runtime context\n\n\ndef _utc_clock() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef build_runtime_context(\n    *,\n    engine_root: Path | str,\n    output_root: Path | str,\n    run_id: str,\n    curriculum_digest: str,\n    authorization: Any = None,\n    capability_proof: Mapping[str, Any] | None = None,\n    retrieval_hosts: Sequence[str] = (),\n    clock: Callable[[], Any] = _utc_clock,\n    env_passthrough: Sequence[str] = (),\n) -> RuntimeContext:\n    \"\"\"Open the services one invocation may reach (spec section 5.2).\n\n    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n    inside the builder, because the transport and the authorization it enforces\n    are bound to a run identity that does not exist at build time.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n    egress_guard = EgressGuard(receipts)\n    return RuntimeContext(\n        engine_root=engine_root,\n        output_root=output_root,\n        path_guard=ArtifactStore(output_root),\n        evidence_service=EvidenceStore(output_root),\n        transport_registry=tp.CliTransport(\n            output_root=output_root,\n            run_id=run_id,\n            curriculum_digest=curriculum_digest,\n            authorization=authorization,\n            receipts=receipts,\n            guard=egress_guard,\n            ledger=tp.AttemptLedger(),\n            capability_proof=capability_proof,\n            env_passthrough=env_passthrough,\n        ),\n        source_retriever=SourceRetriever(\n            guard=egress_guard,\n            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n        ),\n        signal_token=InterruptToken(output_root),\n        clock=clock,\n    )\n\n\n# ----------------------------------------------------------------- node boundary\n\n\ndef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n\n    marked = dict(update)\n    guard = marked.get(\"pending_guard\")\n    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n    guard[\"interrupt_requested\"] = True\n    marked[\"pending_guard\"] = guard\n    return marked\n\n\ndef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n\n    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n    callables take it as an explicit argument precisely so they cannot fetch it\n    themselves.\n    \"\"\"\n\n    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n        context = getattr(runtime, \"context\", None)\n        try:\n            if model_node:\n                update = body(state, build_model_node_context(context))\n            else:\n                update = body(state, context)\n        except GraphBubbleUp:\n            # LangGraph's own control flow (interrupt/resume propagation) is not a\n            # product failure and must reach the engine untouched.\n            raise\n        except Exception as error:  # the classified-failure contract of spec 6.1\n            return {\n                \"pending_failure\": {\n                    \"node\": node_id,\n                    \"class\": \"system\",\n                    \"cause\": \"unhandled\",\n                    \"message\": f\"{type(error).__name__}: {error}\",\n                    \"evidence\": {\"boundary\": \"node\"},\n                },\n                \"pending_guard\": None,\n            }\n        token = getattr(context, \"signal_token\", None)\n        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n            return _mark_interrupt(update, node_id)\n        return dict(update)\n\n    node.__name__ = node_id\n    node.__qualname__ = node_id\n    node.__doc__ = getattr(body, \"__doc__\", None)\n    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n    return node\n\n\ndef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n\n    return getattr(body, \"node_body\", body)\n\n\ndef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n    target = _underlying(body)\n    try:\n        source = inspect.getsource(target)\n    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n        source = \"\"\n    return {\n        \"node_id\": node_id,\n        \"module\": getattr(target, \"__module__\", \"\"),\n        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n        \"source_lines\": len(source.splitlines()),\n    }\n\n\n# ------------------------------------------------------------ binding validation\n\n\ndef binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"Every node callable the *skeleton and unit path* resolve against.\n\n    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n    are absent here: they are exercised at the function level by N31's own\n    tests, and this generation does not wire their topology (spec section\n    8.1's D08/D09/D12/D14/D91 -> D17 and M05 -> D16 edges stay the declared\n    `unit_graph.DEFERRED_EDGES` rows they already are).\n\n    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n    likewise absent from *this* function deliberately, not by oversight: D24\n    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n    already-verified tables) declare that edge deferred to N32 by name. If D24\n    entered this function, `unit_graph.register_unit_path`'s *own*\n    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n    silently widen to include it -- correct for a production run, but it\n    would falsify N30's own already-passing topology tests, which independently\n    recompute their expectation from this exact function's return value.\n    `register_workbook_topology` registers the workbook engine as an additive\n    step over its own separate builder (N32 exercises it directly, not through\n    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n    byte-identical to what they were before N32 and the workbook branch is\n    still fully real -- just not reachable from `D05` in this generation,\n    exactly as `unit_graph.DEFERRED_EDGES` documents.\n    \"\"\"\n\n    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n        bindings[job_id] = adapter\n    bindings.update(MODEL_BOOKKEEPING_NODES)\n    return bindings\n\n\ndef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n\n    The complete node set the compiled graph actually registers. Kept\n    separate from `binding_inventory()` itself for the reason documented\n    there: several of N30's own tests recompute their expectation directly\n    from `binding_inventory()`'s return value, so that function's contract\n    (the skeleton/unit-path view) must stay exactly what it was before N32.\n    \"\"\"\n\n    bindings = dict(binding_inventory())\n    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n    return bindings\n\n\ndef _reject(code: str, node_id: str, detail: str) -> None:\n    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n\n\ndef validate_bindings(\n    bindings: Mapping[str, Callable[..., Any]],\n    *,\n    required: Sequence[str],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n\n    for node_id in required:\n        if node_id not in bindings:\n            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n\n    seen: dict[tuple[str, str], str] = {}\n    inventory: dict[str, dict[str, Any]] = {}\n    for node_id in sorted(bindings):\n        body = bindings[node_id]\n        if not callable(body):\n            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n        record = _binding_record(node_id, body)\n        module = record[\"module\"]\n        if not any(\n            module == allowed or module.startswith(f\"{allowed}.\")\n            for allowed in PRODUCTION_BINDING_MODULES\n        ):\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n        lowered = f\"{module}.{record['qualname']}\".lower()\n        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n        # positive on the spec's own vocabulary, not a caught stand-in.\n        marker = next(\n            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n            None,\n        )\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n        source = inspect.getsource(_underlying(body))\n        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n        identity = (module, record[\"qualname\"])\n        if identity in seen:\n            _reject(\n                \"N20-BIND-DUPLICATE\",\n                node_id,\n                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n            )\n        seen[identity] = node_id\n        inventory[node_id] = record\n    return inventory\n\n\ndef _validate_topology(registered: Sequence[str]) -> None:\n    known = set(registered) | {START, END}\n    wired: set[str] = set()\n    for source, target in SKELETON_NORMAL_EDGES:\n        for endpoint in (source, target):\n            if endpoint not in known:\n                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n        wired.update({source, target})\n    for source, path in SKELETON_BRANCHES:\n        if source not in known:\n            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n        wired.add(source)\n        for target in routing.guard_destinations(source):\n            if target not in known:\n                _reject(\n                    \"N20-EDGE-DANGLING\",\n                    target,\n                    f\"{source} branch {path.__name__} names an unregistered destination\",\n                )\n            wired.add(target)\n    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n        wired.update({source, target})\n    for source, _ in unit_graph.UNIT_BRANCHES:\n        wired.add(source)\n        wired.update(unit_graph.branch_destinations(source, registered))\n    for node_id in registered:\n        if node_id in wired:\n            continue\n        owner = DEFERRED_TOPOLOGY.get(node_id)\n        if owner is None:\n            _reject(\n                \"N20-NODE-UNDECLARED\",\n                node_id,\n                \"is registered but neither wired by the skeleton nor declared deferred\",\n            )\n\n\n# ---------------------------------------------------------------- registration\n\n\ndef register_skeleton(\n    builder: StateGraph,\n    bindings: Mapping[str, Callable[..., Any]],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Register every available node and the fixed skeleton edges.\n\n    N30 and N32 extend the same builder by adding their own `add_node`-free\n    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n    rewritten by them, so the skeleton stays the one place START, the recovery\n    branch, and the single edge to END are decided.\n    \"\"\"\n\n    routing.assert_guard_table_total(NODE_CATALOGUE)\n    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n    _validate_topology(sorted(bindings))\n\n    for node_id in sorted(bindings):\n        model_node = node_id in MODEL_NODE_ADAPTERS\n        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n\n    for source, target in SKELETON_NORMAL_EDGES:\n        builder.add_edge(source, target)\n\n    for source, path in SKELETON_BRANCHES:\n        destinations = routing.guard_destinations(source)\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n\n    unit_graph.register_unit_path(builder, sorted(bindings))\n\n    return inventory\n\n\ndef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n\n    Not called by `build_curriculum_factory_graph`: this generation's single\n    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n    this function into whatever the production compile point becomes once the\n    workbook branch is in scope; until then it is exercised directly, over its\n    own builder, the way N32's own topology test already does.\n    `register_skeleton` itself must never see these bindings; this function\n    adds exactly the nodes `register_skeleton` did not, then wires them over\n    the *full* merged node set so `workbook.register_workbook_path` can\n    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n    \"\"\"\n\n    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n    for node_id in sorted(workbook_bindings):\n        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n\n\ndef _skeleton_required_nodes() -> tuple[str, ...]:\n    required = {source for source, _ in SKELETON_BRANCHES}\n    for source, target in SKELETON_NORMAL_EDGES:\n        required.update({source, target})\n    for source, _ in SKELETON_BRANCHES:\n        required.update(routing.guard_destinations(source))\n    return tuple(sorted(required - {START, END}))\n\n\ndef build_curriculum_factory_graph(\n    *, engine_root: Path, output_root: Path\n) -> CompiledStateGraph:\n    \"\"\"Build and compile the one production graph (spec section 4).\n\n    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n    returned graph is invoked with `context=build_runtime_context(...)`; no\n    services are captured at build time, so the compiled object carries no\n    run identity and no authorization.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    builder: StateGraph = StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n    register_skeleton(builder, binding_inventory())\n    saver, _connection = open_checkpoint_saver(output_root)\n    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n\n\n# ---------------------------------------------------------------------- digest\n\n\ndef _canonical_digest(payload: Any) -> str:\n    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n\n\ndef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n\n    drawn = compiled.get_graph()\n    return {\n        \"name\": compiled.name,\n        \"nodes\": sorted(drawn.nodes),\n        \"edges\": sorted(\n            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n        ),\n    }\n\n\ndef contract_digests() -> dict[str, str]:\n    \"\"\"File digests of every frozen model prompt and output schema.\n\n    Folded into the graph digest so prompt or schema drift is visible as graph\n    drift: the same topology over a changed prompt is not the same graph.\n    \"\"\"\n\n    digests: dict[str, str] = {}\n    registry = tp.load_job_registry()\n    for job_id in sorted(registry):\n        route = registry[job_id]\n        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n            path = Path(path)\n            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return digests\n\n\ndef graph_digest(compiled: CompiledStateGraph) -> str:\n    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n\n    Identical real bindings give an identical digest; a changed node body,\n    reducer declaration, prompt, or schema changes it. Python object identity is\n    deliberately not an input, so two builds in one process and two builds in two\n    processes agree.\n    \"\"\"\n\n    payload = {\n        \"topology\": compiled_topology(compiled),\n        \"bindings\": [\n            _binding_record(node_id, body)\n            for node_id, body in sorted(binding_inventory().items())\n        ],\n        \"state\": {\n            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n            \"input\": list(FACTORY_INPUT_FIELDS),\n            \"output\": list(FACTORY_OUTPUT_FIELDS),\n        },\n        \"contracts\": contract_digests(),\n    }\n    return _canonical_digest(payload)\n","numLines":573,"startLine":1,"totalLines":573}}}
