{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U1abUQ7Ypvn4Un6FHqbERP","type":"tool_result","content":"1\t\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n2\t\n3\t`compute_unit_denominator()` is the one reduction engine spec section 13.1\n4\tdescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\n5\tbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\n6\treceipt, off whatever the *current* heads are at that moment. A retest that\n7\tchanged a head between the two calls changes what this function sees; nothing\n8\there caches or trusts its own earlier answer.\n9\t\n10\tLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\n11\tyet -- registration into the compiled graph is N32's write, once `workbook.py`\n12\texists to dispatch the workbook branch alongside them.\n13\t\n14\tKnown scope of this generation's denominator (documented rather than silently\n15\tassumed): it enforces source admission, the domain and content check sets, the\n16\tvisual join, the page inventory/inspection set, one independent unit review\n17\twith all findings mapped through a code-owned owner table, and open-repair\n18\tclosure. It treats the append-only evidence/log layer and the LangGraph\n19\tcheckpoint layer as structurally present rather than independently\n20\tre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n21\t`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\n22\treducers themselves (`reducers.py`), and this generation does not yet call an\n23\texternal hash-chain audit from inside D22. A denominator category is never\n24\tremoved to make a fixture pass; a future generation only ever tightens this.\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\tfrom collections.abc import Mapping\n30\tfrom dataclasses import dataclass, field\n31\tfrom typing import Any\n32\t\n33\tfrom . import repair\n34\tfrom .nodes import (\n35\t    SystemFailure,\n36\t    candidate_payload,\n37\t    canonical_digest,\n38\t    check_record,\n39\t    require,\n40\t    stream_id,\n41\t)\n42\tfrom .nodes.content import CONTENT_CHECK_IDS\n43\tfrom .nodes.domain import DOMAIN_CHECK_IDS\n44\t\n45\t__all__ = [\n46\t    \"DenominatorResult\",\n47\t    \"compute_unit_denominator\",\n48\t    \"prove_exact_manifest_coverage\",\n49\t    \"D16_REDUCE_UNIT_EVIDENCE\",\n50\t    \"D22_ACCEPT_UNIT\",\n51\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n52\t]\n53\t\n54\t\n55\t@dataclass(frozen=True)\n56\tclass DenominatorResult:\n57\t    passed: bool\n58\t    check: dict[str, Any]\n59\t    findings: list[dict[str, Any]] = field(default_factory=list)\n60\t    denominator: dict[str, Any] = field(default_factory=dict)\n61\t\n62\t\n63\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n64\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n65\t\n66\t\n67\tdef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n68\t    if not pdf_sha256:\n69\t        return None\n70\t    matches = [\n71\t        dict(record)\n72\t        for record in unit_reviews or []\n73\t        if isinstance(record, Mapping)\n74\t        and record.get(\"record_kind\") == \"model_candidate\"\n75\t        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n76\t        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n77\t    ]\n78\t    return matches[-1] if matches else None\n79\t\n80\t\n81\tdef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n82\t    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n83\t\n84\t    heads = state.get(\"artifact_heads\") or {}\n85\t    checks = [\n86\t        record\n87\t        for record in state.get(\"deterministic_checks\") or []\n88\t        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n89\t    ]\n90\t    findings: list[dict[str, Any]] = []\n91\t    categories: dict[str, Any] = {}\n92\t\n93\t    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n94\t        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n95\t\n96\t    # 1-2. source admission and correlation.\n97\t    admissions = [\n98\t        record\n99\t        for record in state.get(\"source_admissions\") or []\n100\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n101\t    ]\n102\t    admissions_ok = bool(admissions) and all(\n103\t        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n104\t    )\n105\t    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n106\t    if not admissions_ok:\n107\t        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n108\t\n109\t    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n110\t    domain_stream = stream_id(unit_id, \"domain\")\n111\t    domain_head = heads.get(domain_stream)\n112\t    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n113\t    domain_checks = {\n114\t        record[\"check_id\"]: record\n115\t        for record in checks\n116\t        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n117\t    }\n118\t    domain_ok = domain_hash is not None and all(\n119\t        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n120\t    )\n121\t    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n122\t    if not domain_ok:\n123\t        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n124\t\n125\t    # 4, 6. unit schema and every sourced claim resolved.\n126\t    content_stream = stream_id(unit_id, \"content\")\n127\t    content_head = heads.get(content_stream)\n128\t    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n129\t    content_checks = {\n130\t        record[\"check_id\"]: record\n131\t        for record in checks\n132\t        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n133\t    }\n134\t    content_ok = content_hash is not None and all(\n135\t        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n136\t    )\n137\t    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n138\t    if not content_ok:\n139\t        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n140\t\n141\t    # 8. every required actual visual, provenance, and asset resolution.\n142\t    visual_join = [\n143\t        record\n144\t        for record in state.get(\"visual_join_evidence\") or []\n145\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n146\t    ]\n147\t    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n148\t    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n149\t    if not visuals_ok:\n150\t        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n151\t\n152\t    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n153\t    inventories = [\n154\t        record\n155\t        for record in state.get(\"unit_page_inventories\") or []\n156\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n157\t    ]\n158\t    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n159\t    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n160\t    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n161\t    inspections = [\n162\t        record\n163\t        for record in state.get(\"unit_page_inspections\") or []\n164\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n165\t    ]\n166\t    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n167\t    inspections_ok = (\n168\t        inventory_ok\n169\t        and len(inspections) == expected_pages\n170\t        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n171\t    )\n172\t    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n173\t    if not inspections_ok:\n174\t        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n175\t\n176\t    # 11. one independent review of the frozen actual unit, every page included.\n177\t    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n178\t    review_ok = review is not None\n179\t    if review is not None:\n180\t        payload = candidate_payload(review, \"unit review\")\n181\t        blocking = [\n182\t            entry\n183\t            for entry in payload.get(\"overall_findings\", [])\n184\t            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n185\t        ]\n186\t        for page_entry in payload.get(\"page_findings\", []):\n187\t            if isinstance(page_entry, Mapping):\n188\t                blocking.extend(\n189\t                    entry for entry in page_entry.get(\"findings\", [])\n190\t                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n191\t                )\n192\t        for entry in blocking:\n193\t            owner = repair.owner_for_review_category(entry.get(\"category\"))\n194\t            require(\n195\t                owner is not None,\n196\t                \"invalid_input\",\n197\t                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n198\t                unit_id=unit_id,\n199\t            )\n200\t            findings.append(\n201\t                {\n202\t                    \"check_id\": \"unit_review_finding\",\n203\t                    \"owner\": owner,\n204\t                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n205\t                    \"message\": entry.get(\"description\", \"\"),\n206\t                }\n207\t            )\n208\t        review_ok = not blocking\n209\t    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n210\t    if review is None:\n211\t        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n212\t\n213\t    # 12. complete repair partition, immutable history, and required current retests.\n214\t    unit_repair_requests = [\n215\t        record\n216\t        for record in state.get(\"repair_requests\") or []\n217\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n218\t    ]\n219\t    resolved_keys = {\n220\t        record.get(\"request_key\")\n221\t        for record in state.get(\"retest_results\") or []\n222\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n223\t    }\n224\t    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n225\t    repair_ok = not open_requests\n226\t    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n227\t    if not repair_ok:\n228\t        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n229\t\n230\t    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n231\t    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n232\t    check = check_record(\n233\t        scope=\"unit\",\n234\t        owner=unit_id,\n235\t        head_hash=summary_hash,\n236\t        check_id=\"unit_denominator\",\n237\t        attempt=1,\n238\t        result=\"PASS\" if passed else \"FAIL\",\n239\t        detail={\"categories\": categories},\n240\t    )\n241\t    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n242\t\n243\t\n244\tdef prove_exact_manifest_coverage(\n245\t    ordered_unit_ids: Any,\n246\t    accepted_unit_receipts: Mapping[str, Any],\n247\t    declared_coverage: Any,\n248\t) -> tuple[bool, list[str]]:\n249\t    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n250\t\n251\t    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n252\t    this function is the exact predicate it needs and is exercised directly\n253\t    here so the coverage rule itself -- exact order, exact membership, exact\n254\t    current hash -- is proven against this module's own receipt shape before\n255\t    N32 ever calls it.\n256\t    \"\"\"\n257\t\n258\t    ordered = list(ordered_unit_ids)\n259\t    declared = [dict(entry) for entry in declared_coverage]\n260\t    rejections: list[str] = []\n261\t\n262\t    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n263\t    if declared_ids != ordered:\n264\t        rejections.append(\n265\t            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n266\t        )\n267\t\n268\t    for entry in declared:\n269\t        unit_id = entry.get(\"unit_id\")\n270\t        receipt = accepted_unit_receipts.get(unit_id)\n271\t        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n272\t        if current_hash is None:\n273\t            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n274\t        elif entry.get(\"receipt_hash\") != current_hash:\n275\t            rejections.append(\n276\t                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n277\t                f\"receipt hash {current_hash!r}\"\n278\t            )\n279\t\n280\t    return (not rejections, rejections)\n281\t\n282\t\n283\t# --------------------------------------------------------------------------\n284\t# D16_REDUCE_UNIT_EVIDENCE\n285\t# --------------------------------------------------------------------------\n286\t\n287\t\n288\tdef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n289\t    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n290\t\n291\t    unit_id = state.get(\"selected_unit_id\")\n292\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n293\t    require(\n294\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n295\t        \"integrity\",\n296\t        \"an accepted unit can never re-enter denominator reduction\",\n297\t        unit_id=unit_id,\n298\t    )\n299\t\n300\t    result = compute_unit_denominator(state, unit_id)\n301\t    if result.passed:\n302\t        return {\n303\t            \"deterministic_checks\": [result.check],\n304\t            \"unit_status\": {unit_id: \"REVIEWING\"},\n305\t            \"pending_guard\": _guard(\n306\t                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n307\t            ),\n308\t        }\n309\t    return {\n310\t        \"deterministic_checks\": [result.check],\n311\t        \"unit_status\": {unit_id: \"REVIEWING\"},\n312\t        \"pending_guard\": _guard(\n313\t            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n314\t            unit_id=unit_id, findings=result.findings,\n315\t        ),\n316\t    }\n317\t\n318\t\n319\t# --------------------------------------------------------------------------\n320\t# D22_ACCEPT_UNIT\n321\t# --------------------------------------------------------------------------\n322\t\n323\t\n324\tdef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n325\t    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n326\t\n327\t    Never trusts D16's earlier pass: a retest that changed a head between the\n328\t    two calls, or evidence that went stale, makes this recomputation fail even\n329\t    though D16 once passed. Any absent, stale, or failing member blocks\n330\t    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n331\t    warned acceptance path.\n332\t    \"\"\"\n333\t\n334\t    unit_id = state.get(\"selected_unit_id\")\n335\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n336\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n337\t    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n338\t\n339\t    result = compute_unit_denominator(state, unit_id)\n340\t    require(\n341\t        result.passed,\n342\t        \"integrity\",\n343\t        \"D22 recomputation does not currently pass; acceptance is refused\",\n344\t        unit_id=unit_id, categories=result.denominator,\n345\t    )\n346\t\n347\t    heads = state.get(\"artifact_heads\") or {}\n348\t    unit_stream_hashes = {\n349\t        stream: head.get(\"hash\")\n350\t        for stream, head in heads.items()\n351\t        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n352\t    }\n353\t    receipt_body = {\n354\t        \"unit_id\": unit_id,\n355\t        \"denominator\": result.denominator,\n356\t        \"artifact_head_hashes\": unit_stream_hashes,\n357\t        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n358\t    }\n359\t    receipt = dict(receipt_body)\n360\t    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n361\t\n362\t    return {\n363\t        \"accepted_unit_receipts\": {unit_id: receipt},\n364\t        \"deterministic_checks\": [result.check],\n365\t        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n366\t    }\n367\t\n368\t\n369\t# --------------------------------------------------------------------------\n370\t# D23_CHECKPOINT_ACCEPTED_UNIT\n371\t# --------------------------------------------------------------------------\n372\t\n373\t\n374\tdef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n375\t    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n376\t\n377\t    The cursor's `accepted_ordinal` is written in the same update as the\n378\t    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n379\t    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n380\t    would otherwise be satisfiable by a cursor that outran its correlation\n381\t    evidence, which is exactly the ordering spec section 6.2's D23 row and\n382\t    this node's own TEST 7 forbid.\n383\t    \"\"\"\n384\t\n385\t    unit_id = state.get(\"selected_unit_id\")\n386\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n387\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n388\t    receipt = accepted.get(unit_id)\n389\t    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n390\t\n391\t    evidence_entries = state.get(\"evidence_index_entries\") or []\n392\t    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n393\t    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n394\t\n395\t    checkpoint_record = {\n396\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n397\t        \"unit_id\": unit_id,\n398\t        \"checkpoint_id\": checkpoint_id,\n399\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n400\t        \"run_id\": state.get(\"run_id\"),\n401\t        \"episode_id\": state.get(\"episode_id\"),\n402\t        \"evidence_ordinal\": len(evidence_entries),\n403\t        \"prior_checkpoint_count\": len(existing_checkpoints),\n404\t    }\n405\t\n406\t    correlation_record = {\n407\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n408\t        \"unit_id\": unit_id,\n409\t        \"checkpoint_id\": checkpoint_id,\n410\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n411\t    }\n412\t\n413\t    effective_run = state.get(\"effective_run\") or {}\n414\t    closure = effective_run.get(\"target_closure\") or []\n415\t    cursor = dict(state.get(\"cursor\") or {})\n416\t    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n417\t    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n418\t    if unit_id not in closure:\n419\t        # Defensive: D05 always selects from the closure, so this is unreachable\n420\t        # in the real pipeline; kept explicit rather than silently trusting\n421\t        # an out-of-closure cursor advance.\n422\t        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n423\t\n424\t    return {\n425\t        \"checkpoint_metadata\": [checkpoint_record],\n426\t        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n427\t        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n428\t        \"pending_guard\": _guard(\n429\t            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n430\t            unit_id=unit_id, checkpoint_id=checkpoint_id,\n431\t        ),\n432\t    }\n433\t"}]},"parent_tool_use_id":null,"session_id":"b1f1ac47-68e2-44fb-bfa5-0ab46fd6f0a8","uuid":"6330c8ab-3cb5-4216-a436-9bfd77644dfb","timestamp":"2026-08-12T21:16:02.089Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T211427.316028Z-623ff2d9fa/repo/runtime/langgraph_factory/acceptance.py","content":"\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n\n`compute_unit_denominator()` is the one reduction engine spec section 13.1\ndescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\nbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\nreceipt, off whatever the *current* heads are at that moment. A retest that\nchanged a head between the two calls changes what this function sees; nothing\nhere caches or trusts its own earlier answer.\n\nLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\nyet -- registration into the compiled graph is N32's write, once `workbook.py`\nexists to dispatch the workbook branch alongside them.\n\nKnown scope of this generation's denominator (documented rather than silently\nassumed): it enforces source admission, the domain and content check sets, the\nvisual join, the page inventory/inspection set, one independent unit review\nwith all findings mapped through a code-owned owner table, and open-repair\nclosure. It treats the append-only evidence/log layer and the LangGraph\ncheckpoint layer as structurally present rather than independently\nre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\nreducers themselves (`reducers.py`), and this generation does not yet call an\nexternal hash-chain audit from inside D22. A denominator category is never\nremoved to make a fixture pass; a future generation only ever tightens this.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom . import repair\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    check_record,\n    require,\n    stream_id,\n)\nfrom .nodes.content import CONTENT_CHECK_IDS\nfrom .nodes.domain import DOMAIN_CHECK_IDS\n\n__all__ = [\n    \"DenominatorResult\",\n    \"compute_unit_denominator\",\n    \"prove_exact_manifest_coverage\",\n    \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n]\n\n\n@dataclass(frozen=True)\nclass DenominatorResult:\n    passed: bool\n    check: dict[str, Any]\n    findings: list[dict[str, Any]] = field(default_factory=list)\n    denominator: dict[str, Any] = field(default_factory=dict)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n    if not pdf_sha256:\n        return None\n    matches = [\n        dict(record)\n        for record in unit_reviews or []\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == \"model_candidate\"\n        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n    ]\n    return matches[-1] if matches else None\n\n\ndef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    checks = [\n        record\n        for record in state.get(\"deterministic_checks\") or []\n        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n    ]\n    findings: list[dict[str, Any]] = []\n    categories: dict[str, Any] = {}\n\n    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n\n    # 1-2. source admission and correlation.\n    admissions = [\n        record\n        for record in state.get(\"source_admissions\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    admissions_ok = bool(admissions) and all(\n        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n    )\n    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n    if not admissions_ok:\n        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n\n    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n    domain_stream = stream_id(unit_id, \"domain\")\n    domain_head = heads.get(domain_stream)\n    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n    domain_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n    }\n    domain_ok = domain_hash is not None and all(\n        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n    )\n    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n    if not domain_ok:\n        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n\n    # 4, 6. unit schema and every sourced claim resolved.\n    content_stream = stream_id(unit_id, \"content\")\n    content_head = heads.get(content_stream)\n    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n    content_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n    }\n    content_ok = content_hash is not None and all(\n        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n    )\n    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n    if not content_ok:\n        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n\n    # 8. every required actual visual, provenance, and asset resolution.\n    visual_join = [\n        record\n        for record in state.get(\"visual_join_evidence\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n    ]\n    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n    if not visuals_ok:\n        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n\n    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n    inventories = [\n        record\n        for record in state.get(\"unit_page_inventories\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n    inspections = [\n        record\n        for record in state.get(\"unit_page_inspections\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n    ]\n    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n    inspections_ok = (\n        inventory_ok\n        and len(inspections) == expected_pages\n        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n    )\n    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n    if not inspections_ok:\n        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n\n    # 11. one independent review of the frozen actual unit, every page included.\n    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n    review_ok = review is not None\n    if review is not None:\n        payload = candidate_payload(review, \"unit review\")\n        blocking = [\n            entry\n            for entry in payload.get(\"overall_findings\", [])\n            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n        ]\n        for page_entry in payload.get(\"page_findings\", []):\n            if isinstance(page_entry, Mapping):\n                blocking.extend(\n                    entry for entry in page_entry.get(\"findings\", [])\n                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n                )\n        for entry in blocking:\n            owner = repair.owner_for_review_category(entry.get(\"category\"))\n            require(\n                owner is not None,\n                \"invalid_input\",\n                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n                unit_id=unit_id,\n            )\n            findings.append(\n                {\n                    \"check_id\": \"unit_review_finding\",\n                    \"owner\": owner,\n                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n                    \"message\": entry.get(\"description\", \"\"),\n                }\n            )\n        review_ok = not blocking\n    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n    if review is None:\n        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n\n    # 12. complete repair partition, immutable history, and required current retests.\n    unit_repair_requests = [\n        record\n        for record in state.get(\"repair_requests\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    resolved_keys = {\n        record.get(\"request_key\")\n        for record in state.get(\"retest_results\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n    }\n    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n    repair_ok = not open_requests\n    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n    if not repair_ok:\n        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n\n    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n    check = check_record(\n        scope=\"unit\",\n        owner=unit_id,\n        head_hash=summary_hash,\n        check_id=\"unit_denominator\",\n        attempt=1,\n        result=\"PASS\" if passed else \"FAIL\",\n        detail={\"categories\": categories},\n    )\n    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n\n\ndef prove_exact_manifest_coverage(\n    ordered_unit_ids: Any,\n    accepted_unit_receipts: Mapping[str, Any],\n    declared_coverage: Any,\n) -> tuple[bool, list[str]]:\n    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n\n    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n    this function is the exact predicate it needs and is exercised directly\n    here so the coverage rule itself -- exact order, exact membership, exact\n    current hash -- is proven against this module's own receipt shape before\n    N32 ever calls it.\n    \"\"\"\n\n    ordered = list(ordered_unit_ids)\n    declared = [dict(entry) for entry in declared_coverage]\n    rejections: list[str] = []\n\n    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n    if declared_ids != ordered:\n        rejections.append(\n            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n        )\n\n    for entry in declared:\n        unit_id = entry.get(\"unit_id\")\n        receipt = accepted_unit_receipts.get(unit_id)\n        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n        if current_hash is None:\n            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n        elif entry.get(\"receipt_hash\") != current_hash:\n            rejections.append(\n                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n                f\"receipt hash {current_hash!r}\"\n            )\n\n    return (not rejections, rejections)\n\n\n# --------------------------------------------------------------------------\n# D16_REDUCE_UNIT_EVIDENCE\n# --------------------------------------------------------------------------\n\n\ndef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter denominator reduction\",\n        unit_id=unit_id,\n    )\n\n    result = compute_unit_denominator(state, unit_id)\n    if result.passed:\n        return {\n            \"deterministic_checks\": [result.check],\n            \"unit_status\": {unit_id: \"REVIEWING\"},\n            \"pending_guard\": _guard(\n                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n            ),\n        }\n    return {\n        \"deterministic_checks\": [result.check],\n        \"unit_status\": {unit_id: \"REVIEWING\"},\n        \"pending_guard\": _guard(\n            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n            unit_id=unit_id, findings=result.findings,\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D22_ACCEPT_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n\n    Never trusts D16's earlier pass: a retest that changed a head between the\n    two calls, or evidence that went stale, makes this recomputation fail even\n    though D16 once passed. Any absent, stale, or failing member blocks\n    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n    warned acceptance path.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n\n    result = compute_unit_denominator(state, unit_id)\n    require(\n        result.passed,\n        \"integrity\",\n        \"D22 recomputation does not currently pass; acceptance is refused\",\n        unit_id=unit_id, categories=result.denominator,\n    )\n\n    heads = state.get(\"artifact_heads\") or {}\n    unit_stream_hashes = {\n        stream: head.get(\"hash\")\n        for stream, head in heads.items()\n        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n    }\n    receipt_body = {\n        \"unit_id\": unit_id,\n        \"denominator\": result.denominator,\n        \"artifact_head_hashes\": unit_stream_hashes,\n        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n    }\n    receipt = dict(receipt_body)\n    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n\n    return {\n        \"accepted_unit_receipts\": {unit_id: receipt},\n        \"deterministic_checks\": [result.check],\n        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n    }\n\n\n# --------------------------------------------------------------------------\n# D23_CHECKPOINT_ACCEPTED_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n\n    The cursor's `accepted_ordinal` is written in the same update as the\n    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n    would otherwise be satisfiable by a cursor that outran its correlation\n    evidence, which is exactly the ordering spec section 6.2's D23 row and\n    this node's own TEST 7 forbid.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    receipt = accepted.get(unit_id)\n    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n\n    evidence_entries = state.get(\"evidence_index_entries\") or []\n    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n\n    checkpoint_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n        \"run_id\": state.get(\"run_id\"),\n        \"episode_id\": state.get(\"episode_id\"),\n        \"evidence_ordinal\": len(evidence_entries),\n        \"prior_checkpoint_count\": len(existing_checkpoints),\n    }\n\n    correlation_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n    }\n\n    effective_run = state.get(\"effective_run\") or {}\n    closure = effective_run.get(\"target_closure\") or []\n    cursor = dict(state.get(\"cursor\") or {})\n    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n    if unit_id not in closure:\n        # Defensive: D05 always selects from the closure, so this is unreachable\n        # in the real pipeline; kept explicit rather than silently trusting\n        # an out-of-closure cursor advance.\n        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n\n    return {\n        \"checkpoint_metadata\": [checkpoint_record],\n        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n        \"pending_guard\": _guard(\n            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n            unit_id=unit_id, checkpoint_id=checkpoint_id,\n        ),\n    }\n","numLines":433,"startLine":1,"totalLines":433}}}
