{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rbr3jCw54dzCVJ7sqtUjLK","type":"tool_result","content":"1\t\"\"\"N31 acceptance tests: targeted repair (D17-D21) and unit acceptance (D16, D22, D23).\n2\t\n3\tTen TEST items from `prompts/N31_repair_acceptance.prompt.v2.md`. Every function\n4\tunder test is called directly and unmodified from `runtime.langgraph_factory.repair`\n5\t/ `acceptance`; TEST 9 additionally calls the real, unmodified\n6\t`runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's D98) rather than a\n7\tstand-in, and no test in this file writes to `nodes/terminal.py`.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport json\n13\tfrom typing import Any\n14\t\n15\timport pytest\n16\t\n17\tfrom runtime.langgraph_factory import acceptance, repair\n18\tfrom runtime.langgraph_factory.nodes import terminal\n19\tfrom runtime.langgraph_factory.nodes.domain import DOMAIN_CHECK_IDS\n20\tfrom runtime.langgraph_factory.nodes.content import CONTENT_CHECK_IDS\n21\tfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id\n22\tfrom runtime.langgraph_factory.state import FIELD_REDUCERS\n23\tfrom runtime.langgraph_factory import reducers as red\n24\t\n25\tRUN = \"run-n31\"\n26\tEPISODE = \"ep-n31\"\n27\tUNIT = \"U001\"\n28\t\n29\t\n30\tdef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n31\t    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n32\t\n33\t    merged = dict(state)\n34\t    for field, value in update.items():\n35\t        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n36\t    return merged\n37\t\n38\t\n39\tdef _domain_body() -> dict[str, Any]:\n40\t    return {\n41\t        \"unit_id\": UNIT,\n42\t        \"facts\": [{\"fact_id\": \"f1\", \"statement\": \"a fact\"}],\n43\t        \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n44\t    }\n45\t\n46\t\n47\tdef _content_body() -> dict[str, Any]:\n48\t    return {\n49\t        \"unit_id\": UNIT,\n50\t        \"sections\": [{\"section_id\": \"s1\", \"heading\": \"h\", \"body\": \"b\"}],\n51\t        \"claims\": [],\n52\t        \"derivations\": [],\n53\t    }\n54\t\n55\t\n56\tdef _visuals_body() -> dict[str, Any]:\n57\t    return {\"unit_id\": UNIT}\n58\t\n59\t\n60\tdef _head(version: int, parent_hash: str | None, hash_: str) -> dict[str, Any]:\n61\t    return {\"version\": version, \"parent_hash\": parent_hash, \"hash\": hash_}\n62\t\n63\t\n64\tdef _passing_state() -> dict[str, Any]:\n65\t    \"\"\"A unit whose full denominator currently passes (spec section 13.1).\"\"\"\n66\t\n67\t    domain_body = _domain_body()\n68\t    content_body = _content_body()\n69\t    visuals_body = _visuals_body()\n70\t    domain_hash = canonical_digest(domain_body)\n71\t    content_hash = canonical_digest(content_body)\n72\t    visuals_hash = canonical_digest(visuals_body)\n73\t    pdf_sha256 = \"f\" * 64\n74\t    page_sha = \"a\" * 64\n75\t\n76\t    domain_stream = stream_id(UNIT, \"domain\")\n77\t    content_stream = stream_id(UNIT, \"content\")\n78\t    visuals_stream = stream_id(UNIT, \"visuals\")\n79\t\n80\t    deterministic_checks = [\n81\t        {\n82\t            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash,\n83\t            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n84\t        }\n85\t        for check_id in DOMAIN_CHECK_IDS\n86\t    ] + [\n87\t        {\n88\t            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash,\n89\t            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n90\t        }\n91\t        for check_id in CONTENT_CHECK_IDS\n92\t    ]\n93\t\n94\t    review_candidate = {\n95\t        \"key\": \"candidate:review-1\",\n96\t        \"record_kind\": \"model_candidate\",\n97\t        \"pre_admission\": True,\n98\t        \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\",\n99\t        \"unit_pdf_sha256\": pdf_sha256,\n100\t        \"payload\": {\n101\t            \"overall_findings\": [],\n102\t            \"page_findings\": [{\"page_number\": 1, \"page_sha256\": page_sha, \"findings\": []}],\n103\t        },\n104\t    }\n105\t\n106\t    return {\n107\t        \"run_id\": RUN,\n108\t        \"episode_id\": EPISODE,\n109\t        \"selected_unit_id\": UNIT,\n110\t        \"effective_run\": {\"target_closure\": [UNIT]},\n111\t        \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0},\n112\t        \"unit_status\": {UNIT: \"REVIEWING\"},\n113\t        \"artifact_heads\": {\n114\t            domain_stream: _head(1, None, domain_hash),\n115\t            content_stream: _head(1, None, content_hash),\n116\t        },\n117\t        \"artifact_versions\": [\n118\t            {\"key\": f\"{domain_stream}@1\", \"stream\": domain_stream, \"version\": 1, \"parent_hash\": None, \"hash\": domain_hash, \"body\": domain_body},\n119\t            {\"key\": f\"{content_stream}@1\", \"stream\": content_stream, \"version\": 1, \"parent_hash\": None, \"hash\": content_hash, \"body\": content_body},\n120\t            {\"key\": f\"{visuals_stream}@1\", \"stream\": visuals_stream, \"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash, \"body\": visuals_body},\n121\t        ],\n122\t        \"deterministic_checks\": deterministic_checks,\n123\t        \"source_admissions\": [{\"key\": \"s1\", \"unit_id\": UNIT, \"sha256\": \"b\" * 64}],\n124\t        \"visual_join_evidence\": [{\"key\": \"vje1\", \"unit_id\": UNIT, \"phase\": \"join\", \"result\": \"PASS\"}],\n125\t        \"unit_page_inventories\": [\n126\t            {\"key\": \"inv1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page_count\": 1, \"contiguous\": True, \"result\": \"PASS\"}\n127\t        ],\n128\t        \"unit_page_inspections\": [\n129\t            {\"key\": \"insp1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page\": 1, \"page_sha256\": page_sha, \"problems\": [], \"result\": \"PASS\"}\n130\t        ],\n131\t        \"unit_reviews\": [review_candidate],\n132\t        \"repair_requests\": [],\n133\t        \"retest_results\": [],\n134\t        \"accepted_unit_receipts\": {},\n135\t        \"evidence_index_entries\": [],\n136\t        \"checkpoint_metadata\": [],\n137\t        \"attempt_counters\": {},\n138\t    }\n139\t\n140\t\n141\t# ---------------------------------------------------------------------------\n142\t# TEST 1: zero/multiple/unknown/model-selected finding owners fail\n143\t# ---------------------------------------------------------------------------\n144\t\n145\t\n146\tdef test_d17_rejects_a_finding_with_no_owner() -> None:\n147\t    state = _passing_state()\n148\t    state[\"pending_guard\"] = {\n149\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n150\t        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n151\t    }\n152\t    with pytest.raises(SystemFailure):\n153\t        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n154\t\n155\t\n156\tdef test_d17_rejects_a_finding_with_an_unknown_owner() -> None:\n157\t    state = _passing_state()\n158\t    state[\"pending_guard\"] = {\n159\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n160\t        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"owner\": \"mystery owner\", \"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n161\t    }\n162\t    with pytest.raises(SystemFailure):\n163\t        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n164\t\n165\t\n166\tdef test_d17_partitions_a_multi_owner_findings_list_into_separate_owner_entries() -> None:\n167\t    \"\"\"A single D08 call can raise findings against two owners; D17 splits them.\"\"\"\n168\t\n169\t    state = _passing_state()\n170\t    state[\"pending_guard\"] = {\n171\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n172\t        \"detail\": {\n173\t            \"unit_id\": UNIT,\n174\t            \"findings\": [\n175\t                {\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad schema\"},\n176\t                {\"owner\": \"source interpretation\", \"check_id\": \"domain_facts_sourced\", \"pointer\": \"/facts/1\", \"message\": \"unsourced\"},\n177\t            ],\n178\t        },\n179\t    }\n180\t    update = repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n181\t    owners = {entry[\"owner\"] for entry in update[\"finding_partitions\"]}\n182\t    assert owners == {\"curriculum domain\", \"source interpretation\"}\n183\t    assert update[\"pending_guard\"][\"value\"] == \"partition_complete\"\n184\t\n185\t\n186\tdef test_review_finding_category_is_never_trusted_as_an_owner() -> None:\n187\t    \"\"\"A model-selected `category` is mapped through a fixed table; unmapped fails closed.\"\"\"\n188\t\n189\t    assert repair.owner_for_review_category(\"visual clarity\") == \"unit visual\"\n190\t    assert repair.owner_for_review_category(\"totally unrelated nonsense\") is None\n191\t\n192\t    state = _passing_state()\n193\t    state[\"unit_reviews\"][0][\"payload\"][\"overall_findings\"] = [\n194\t        {\"finding_id\": \"f1\", \"severity\": \"blocking\", \"category\": \"totally unrelated nonsense\",\n195\t         \"description\": \"d\", \"evidence_reference\": \"/whatever\"}\n196\t    ]\n197\t    with pytest.raises(SystemFailure):\n198\t        acceptance.compute_unit_denominator(state, UNIT)\n199\t\n200\t\n201\t# ---------------------------------------------------------------------------\n202\t# TEST 2: local repair changes only named paths/descendants\n203\t# ---------------------------------------------------------------------------\n204\t\n205\t\n206\tdef _repair_cycle_state(*, boundary_pointer: str = \"/facts/0/statement\") -> dict[str, Any]:\n207\t    state = _passing_state()\n208\t    state[\"pending_guard\"] = {\n209\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n210\t        \"detail\": {\n211\t            \"unit_id\": UNIT,\n212\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": boundary_pointer, \"message\": \"bad\"}],\n213\t        },\n214\t    }\n215\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n216\t    state = _apply(state, repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None))\n217\t    return state\n218\t\n219\t\n220\tdef test_a_correctly_scoped_model_repair_admits() -> None:\n221\t    state = _repair_cycle_state()\n222\t    request = state[\"repair_requests\"][-1]\n223\t    domain_stream = stream_id(UNIT, \"domain\")\n224\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n225\t    new_body = dict(_domain_body())\n226\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n227\t    candidate = {\n228\t        \"key\": \"candidate:m06-1\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n229\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n230\t        \"parent_sha256\": parent_hash,\n231\t        \"payload\": {\n232\t            \"candidate_child\": {\n233\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n234\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n235\t            },\n236\t            \"changed_path_manifest\": [\n237\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n238\t            ],\n239\t        },\n240\t    }\n241\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n242\t    update = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n243\t    assert update[\"pending_guard\"][\"value\"] == \"repair_admitted\"\n244\t    assert update[\"artifact_heads\"][domain_stream][\"version\"] == 2\n245\t\n246\t\n247\tdef test_a_broad_repair_outside_its_boundary_is_refused() -> None:\n248\t    state = _repair_cycle_state()\n249\t    request = state[\"repair_requests\"][-1]\n250\t    domain_stream = stream_id(UNIT, \"domain\")\n251\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n252\t    new_body = dict(_domain_body())\n253\t    # Touches an undeclared pointer (verifier_result) in addition to the named one.\n254\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n255\t    new_body[\"verifier_result\"] = {\"result\": \"not_run\"}\n256\t    candidate = {\n257\t        \"key\": \"candidate:m06-broad\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n258\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n259\t        \"parent_sha256\": parent_hash,\n260\t        \"payload\": {\n261\t            \"candidate_child\": {\n262\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n263\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n264\t            },\n265\t            \"changed_path_manifest\": [\n266\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]},\n267\t                {\"json_pointer\": \"/verifier_result\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]},\n268\t            ],\n269\t        },\n270\t    }\n271\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n272\t    with pytest.raises(SystemFailure):\n273\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n274\t\n275\t\n276\tdef test_an_in_place_no_op_repair_is_refused() -> None:\n277\t    state = _repair_cycle_state()\n278\t    request = state[\"repair_requests\"][-1]\n279\t    domain_stream = stream_id(UNIT, \"domain\")\n280\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n281\t    unchanged_body = _domain_body()  # identical to parent\n282\t    candidate = {\n283\t        \"key\": \"candidate:m06-noop\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n284\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n285\t        \"parent_sha256\": parent_hash,\n286\t        \"payload\": {\n287\t            \"candidate_child\": {\n288\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(unchanged_body, sort_keys=True),\n289\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n290\t            },\n291\t            \"changed_path_manifest\": [\n292\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n293\t            ],\n294\t        },\n295\t    }\n296\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n297\t    with pytest.raises(SystemFailure):\n298\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n299\t\n300\t\n301\tdef test_a_stale_parent_repair_is_refused() -> None:\n302\t    state = _repair_cycle_state()\n303\t    request = state[\"repair_requests\"][-1]\n304\t    new_body = dict(_domain_body())\n305\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n306\t    candidate = {\n307\t        \"key\": \"candidate:m06-stale\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n308\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n309\t        \"parent_sha256\": \"0\" * 64,  # not the current head\n310\t        \"payload\": {\n311\t            \"candidate_child\": {\n312\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n313\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n314\t            },\n315\t            \"changed_path_manifest\": [\n316\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n317\t            ],\n318\t        },\n319\t    }\n320\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n321\t    with pytest.raises(SystemFailure):\n322\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n323\t\n324\t\n325\tdef test_a_deterministic_layout_repair_changes_only_its_allowed_pointer() -> None:\n326\t    state = _passing_state()\n327\t    layout_stream = stream_id(UNIT, \"layout\")\n328\t    layout_body = {\"unit_id\": UNIT, \"template\": \"v1\", \"page_count\": 1}\n329\t    layout_hash = canonical_digest(layout_body)\n330\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [\n331\t        {\"key\": f\"{layout_stream}@1\", \"stream\": layout_stream, \"version\": 1, \"parent_hash\": None, \"hash\": layout_hash, \"body\": layout_body}\n332\t    ]\n333\t    state[\"pending_guard\"] = {\n334\t        \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"layout_repairable\",\n335\t        \"detail\": {\n336\t            \"unit_id\": UNIT,\n337\t            \"findings\": [{\n338\t                \"owner\": \"unit layout\", \"check_id\": \"unit_page_inventory\", \"pointer\": \"/template\",\n339\t                \"message\": \"wrong template\", \"allowed_facts\": {\"/template\": \"v2\"},\n340\t            }],\n341\t        },\n342\t    }\n343\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n344\t    state = _apply(state, repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None))\n345\t    assert state[\"pending_guard\"][\"value\"] == \"repair_planned\"\n346\t    update = repair.D19_ROUTE_UNIT_REPAIR(state, None)\n347\t    assert update[\"pending_guard\"][\"value\"] == \"deterministic_repair\"\n348\t    candidate = update[\"artifact_versions\"][0]\n349\t    assert candidate[\"body\"][\"template\"] == \"v2\"\n350\t    assert candidate[\"body\"][\"page_count\"] == 1  # only the named pointer changed\n351\t    state = _apply(state, update)\n352\t    admitted = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n353\t    # layout is append-only versioned, not `artifact_heads`-tracked (matching\n354\t    # `review.py`'s own `latest_candidate` convention for this channel).\n355\t    assert \"artifact_heads\" not in admitted\n356\t    admitted_versions = [v for v in admitted[\"artifact_versions\"] if v[\"stream\"] == layout_stream]\n357\t    assert admitted_versions[0][\"version\"] == 2\n358\t    assert admitted_versions[0][\"body\"][\"template\"] == \"v2\"\n359\t\n360\t\n361\t# ---------------------------------------------------------------------------\n362\t# TEST 3: attempt/repeat bounds stop before an over-bound M06 call\n363\t# ---------------------------------------------------------------------------\n364\t\n365\t\n366\tdef test_attempt_bound_exhausts_before_a_fourth_repair_child() -> None:\n367\t    state = _passing_state()\n368\t    state[\"attempt_counters\"] = {\n369\t        f\"repair|{UNIT}|curriculum domain|{canonical_digest([repair.finding_fingerprint('curriculum domain', ['/facts/0/statement'], 'bad')])}\": repair.MAX_REPAIR_CHILDREN_PER_CHAIN\n370\t    }\n371\t    state[\"pending_guard\"] = {\n372\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n373\t        \"detail\": {\n374\t            \"unit_id\": UNIT,\n375\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n376\t        },\n377\t    }\n378\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n379\t    update = repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None)\n380\t    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n381\t    assert update[\"terminal_candidate\"][\"kind\"] == \"CONVERGENCE_EXHAUSTED\"\n382\t    assert update[\"terminal_candidate\"][\"bound\"] == \"attempt_bound\"\n383\t\n384\t\n385\tdef test_fingerprint_repeat_bound_exhausts_at_d17() -> None:\n386\t    state = _passing_state()\n387\t    fingerprint = canonical_digest(\n388\t        [repair.finding_fingerprint(\"curriculum domain\", [\"/facts/0/statement\"], \"bad\")]\n389\t    )\n390\t    state[\"attempt_counters\"] = {\n391\t        f\"repeat|{UNIT}|curriculum domain|{fingerprint}\": repair.MAX_FINGERPRINT_REPEATS\n392\t    }\n393\t    state[\"pending_guard\"] = {\n394\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n395\t        \"detail\": {\n396\t            \"unit_id\": UNIT,\n397\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n398\t        },\n399\t    }\n400\t    update = repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n401\t    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n402\t    assert update[\"terminal_candidate\"][\"bound\"] == \"fingerprint_bound\"\n403\t\n404\t\n405\t# ---------------------------------------------------------------------------\n406\t# TEST 4: all invalidated descendants retest; stale evidence cannot pass\n407\t# ---------------------------------------------------------------------------\n408\t\n409\t\n410\tdef test_d21_dispatches_the_first_retest_node_of_the_owners_fixed_chain() -> None:\n411\t    state = _repair_cycle_state()\n412\t    state = _apply(state, repair.D19_ROUTE_UNIT_REPAIR(state, None))\n413\t    update = repair.D21_RETEST_REQUIRED_DESCENDANTS(state, None)\n414\t    assert update[\"pending_guard\"][\"value\"] == \"retest_frontier_incomplete\"\n415\t    assert update[\"pending_guard\"][\"detail\"][\"destination\"] == repair.RETEST_FIRST_NODE[\"curriculum domain\"]\n416\t    assert update[\"retest_results\"][0][\"dispatched_to\"] == \"D08_VALIDATE_DOMAIN\"\n417\t\n418\t\n419\tdef test_stale_evidence_at_an_old_head_cannot_pass_the_denominator() -> None:\n420\t    \"\"\"A check recorded against a superseded head is invisible to the reduction.\"\"\"\n421\t\n422\t    state = _passing_state()\n423\t    domain_stream = stream_id(UNIT, \"domain\")\n424\t    # Advance the domain head without refreshing its checks: the old checks\n425\t    # were recorded against the old (now-stale) head_hash.\n426\t    new_hash = canonical_digest({\"unit_id\": UNIT, \"facts\": []})\n427\t    state[\"artifact_heads\"][domain_stream] = _head(2, state[\"artifact_heads\"][domain_stream][\"hash\"], new_hash)\n428\t    result = acceptance.compute_unit_denominator(state, UNIT)\n429\t    assert not result.passed\n430\t    assert any(f[\"owner\"] == \"curriculum domain\" for f in result.findings)\n431\t\n432\t\n433\t# ---------------------------------------------------------------------------\n434\t# TEST 5: removing/failing/staling each acceptance member makes D22 reject\n435\t# ---------------------------------------------------------------------------\n436\t\n437\t\n438\tdef test_d22_accepts_a_fully_passing_denominator() -> None:\n439\t    state = _passing_state()\n440\t    update = acceptance.D22_ACCEPT_UNIT(state, None)\n441\t    assert update[\"pending_guard\"][\"value\"] == \"unit_accepted\"\n442\t    assert UNIT in update[\"accepted_unit_receipts\"]\n443\t\n444\t\n445\t@pytest.mark.parametrize(\n446\t    \"mutate\",\n447\t    [\n448\t        lambda s: s.__setitem__(\"source_admissions\", []),\n449\t        lambda s: s[\"deterministic_checks\"].__setitem__(0, {**s[\"deterministic_checks\"][0], \"result\": \"FAIL\"}),\n450\t        lambda s: s.__setitem__(\"visual_join_evidence\", []),\n451\t        lambda s: s.__setitem__(\"unit_page_inspections\", []),\n452\t        lambda s: s.__setitem__(\"unit_reviews\", []),\n453\t    ],\n454\t    ids=[\"source\", \"domain_check\", \"visuals\", \"pages\", \"review\"],\n455\t)\n456\tdef test_removing_or_failing_any_single_member_makes_d22_reject(mutate) -> None:\n457\t    state = _passing_state()\n458\t    mutate(state)\n459\t    with pytest.raises(SystemFailure):\n460\t        acceptance.D22_ACCEPT_UNIT(state, None)\n461\t\n462\t\n463\tdef test_staling_the_content_head_makes_d22_reject() -> None:\n464\t    state = _passing_state()\n465\t    content_stream = stream_id(UNIT, \"content\")\n466\t    new_hash = canonical_digest({\"unit_id\": UNIT, \"sections\": []})\n467\t    state[\"artifact_heads\"][content_stream] = _head(2, state[\"artifact_heads\"][content_stream][\"hash\"], new_hash)\n468\t    with pytest.raises(SystemFailure):\n469\t        acceptance.D22_ACCEPT_UNIT(state, None)\n470\t\n471\t\n472\t# ---------------------------------------------------------------------------\n473\t# TEST 6: accepted bytes remain immutable across resume, later units, and repair\n474\t# ---------------------------------------------------------------------------\n475\t\n476\t\n477\tdef test_accept_once_refuses_a_differing_second_write_for_the_same_unit() -> None:\n478\t    state = _passing_state()\n479\t    # Two independent computations against the same pre-acceptance state (as a\n480\t    # crash-before-durable-write replay would see) agree byte-for-byte.\n481\t    first = acceptance.D22_ACCEPT_UNIT(state, None)\n482\t    second = acceptance.D22_ACCEPT_UNIT(state, None)\n483\t    assert first[\"accepted_unit_receipts\"] == second[\"accepted_unit_receipts\"]\n484\t\n485\t    merged = _apply(state, first)\n486\t    replayed = red.accept_once(merged[\"accepted_unit_receipts\"], second[\"accepted_unit_receipts\"])\n487\t    assert replayed == merged[\"accepted_unit_receipts\"]\n488\t\n489\t    tampered = {UNIT: {**merged[\"accepted_unit_receipts\"][UNIT], \"receipt_hash\": \"deadbeef\"}}\n490\t    with pytest.raises(red.AcceptOnceConflict):\n491\t        red.accept_once(merged[\"accepted_unit_receipts\"], tampered)\n492\t\n493\t    # D22 itself refuses to reconsider a unit its own state already accepted.\n494\t    with pytest.raises(SystemFailure):\n495\t        acceptance.D22_ACCEPT_UNIT(merged, None)\n496\t\n497\t\n498\tdef test_an_already_accepted_unit_can_never_re_enter_classification_or_planning() -> None:\n499\t    state = _passing_state()\n500\t    state[\"accepted_unit_receipts\"] = {UNIT: {\"receipt_hash\": \"x\" * 64}}\n501\t    state[\"pending_guard\"] = {\n502\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n503\t        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n504\t    }\n505\t    with pytest.raises(SystemFailure):\n506\t        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n507\t\n508\t\n509\t# ---------------------------------------------------------------------------\n510\t# TEST 7: cursor advances only after checkpoint/evidence/log correlation flush\n511\t# ---------------------------------------------------------------------------\n512\t\n513\t\n514\tdef test_d23_writes_checkpoint_metadata_and_cursor_in_the_same_update() -> None:\n515\t    state = _passing_state()\n516\t    accept_update = acceptance.D22_ACCEPT_UNIT(state, None)\n517\t    state = _apply(state, accept_update)\n518\t    update = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n519\t    assert \"checkpoint_metadata\" in update and \"cursor\" in update\n520\t    assert update[\"cursor\"][\"accepted_ordinal\"] == 1\n521\t    assert update[\"checkpoint_metadata\"][0][\"checkpoint_id\"]\n522\t    assert update[\"accepted_unit_checkpoint_receipts\"][0][\"checkpoint_id\"] == update[\"checkpoint_metadata\"][0][\"checkpoint_id\"]\n523\t\n524\t\n525\tdef test_d23_refuses_to_advance_the_cursor_with_no_accepted_receipt() -> None:\n526\t    state = _passing_state()\n527\t    with pytest.raises(SystemFailure):\n528\t        acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n529\t\n530\t\n531\t# ---------------------------------------------------------------------------\n532\t# TEST 8: D24-shaped coverage rejects missing/extra/reordered/wrong-hash\n533\t# ---------------------------------------------------------------------------\n534\t\n535\t\n536\tdef test_coverage_proof_rejects_missing_extra_reordered_and_wrong_hash() -> None:\n537\t    receipts = {\n538\t        \"U001\": {\"receipt_hash\": \"1\" * 64},\n539\t        \"U002\": {\"receipt_hash\": \"2\" * 64},\n540\t    }\n541\t    ordered = [\"U001\", \"U002\"]\n542\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n543\t        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}]\n544\t    )\n545\t    assert passed and not rejections\n546\t\n547\t    # missing\n548\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n549\t        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}]\n550\t    )\n551\t    assert not passed\n552\t\n553\t    # extra\n554\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n555\t        ordered, receipts,\n556\t        [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}, {\"unit_id\": \"U003\", \"receipt_hash\": \"3\" * 64}],\n557\t    )\n558\t    assert not passed\n559\t\n560\t    # reordered\n561\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n562\t        ordered, receipts, [{\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}, {\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}]\n563\t    )\n564\t    assert not passed\n565\t\n566\t    # wrong hash\n567\t    passed, rejections = acceptance.prove_exact_manifest_coverage(\n568\t        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"0\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}]\n569\t    )\n570\t    assert not passed\n571\t\n572\t\n573\t# ---------------------------------------------------------------------------\n574\t# TEST 9: real D98 traverses one-mode success and unit-failure candidates\n575\t# ---------------------------------------------------------------------------\n576\t\n577\t\n578\tdef _d98_projection(state: dict[str, Any]) -> dict[str, Any]:\n579\t    from runtime.langgraph_factory.nodes import project\n580\t\n581\t    full = {\n582\t        **state,\n583\t        \"terminal\": None,\n584\t        \"terminal_history\": [],\n585\t        \"mode\": \"one\",\n586\t        \"requested_unit_id\": UNIT,\n587\t        \"final_release_audits\": [],\n588\t        \"workbook_head\": {},\n589\t        \"failure_fingerprints\": [],\n590\t        \"resume_frontier\": None,\n591\t        \"pending_failure\": None,\n592\t        \"output_root\": \"/tmp/out\",\n593\t    }\n594\t    return project(\"D98_WRITE_TERMINAL\", full)\n595\t\n596\t\n597\tdef test_a_unit_accepted_candidate_traverses_the_real_d98_and_is_accepted() -> None:\n598\t    assert terminal.write_terminal.__module__ == \"runtime.langgraph_factory.nodes.terminal\"\n599\t\n600\t    state = _passing_state()\n601\t    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n602\t    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n603\t\n604\t    receipt = state[\"accepted_unit_receipts\"][UNIT]\n605\t    checkpoint = state[\"checkpoint_metadata\"][-1]\n606\t    state[\"terminal_candidate\"] = {\n607\t        \"kind\": \"UNIT_ACCEPTED\",\n608\t        \"unit_id\": UNIT,\n609\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n610\t        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]},\n611\t        \"denominator\": receipt[\"denominator\"],\n612\t        \"log_high_water_mark\": 0,\n613\t        \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n614\t    }\n615\t    projection = _d98_projection(state)\n616\t    record = terminal.write_terminal(projection, None)\n617\t    assert record[\"terminal\"][\"kind\"] == \"UNIT_ACCEPTED\"\n618\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n619\t\n620\t\n621\tdef test_a_tampered_unit_accepted_candidate_is_rejected_by_the_real_d98() -> None:\n622\t    state = _passing_state()\n623\t    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n624\t    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n625\t    receipt = state[\"accepted_unit_receipts\"][UNIT]\n626\t    checkpoint = state[\"checkpoint_metadata\"][-1]\n627\t    state[\"terminal_candidate\"] = {\n628\t        \"kind\": \"UNIT_ACCEPTED\",\n629\t        \"unit_id\": UNIT,\n630\t        \"receipt_hash\": \"not-the-real-hash\",\n631\t        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]},\n632\t        \"denominator\": receipt[\"denominator\"],\n633\t        \"log_high_water_mark\": 0,\n634\t        \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n635\t    }\n636\t    projection = _d98_projection(state)\n637\t    record = terminal.write_terminal(projection, None)\n638\t    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n639\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False\n640\t\n641\t\n642\tdef test_a_convergence_exhausted_candidate_from_d17_traverses_the_real_d98() -> None:\n643\t    state = _passing_state()\n644\t    state[\"attempt_counters\"] = {\n645\t        f\"repair|{UNIT}|curriculum domain|{canonical_digest([repair.finding_fingerprint('curriculum domain', ['/facts/0/statement'], 'bad')])}\": repair.MAX_REPAIR_CHILDREN_PER_CHAIN\n646\t    }\n647\t    state[\"pending_guard\"] = {\n648\t        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n649\t        \"detail\": {\n650\t            \"unit_id\": UNIT,\n651\t            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n652\t        },\n653\t    }\n654\t    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n655\t    exhaustion = repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None)\n656\t    candidate = dict(exhaustion[\"terminal_candidate\"])\n657\t    state[\"terminal_candidate\"] = candidate\n658\t    projection = _d98_projection(state)\n659\t    record = terminal.write_terminal(projection, None)\n660\t    assert record[\"terminal\"][\"kind\"] == \"CONVERGENCE_EXHAUSTED\"\n661\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n662\t\n663\t\n664\t# ---------------------------------------------------------------------------\n665\t# TEST 10: crash at every repair/accept/checkpoint/D98 boundary is recoverable\n666\t# ---------------------------------------------------------------------------\n667\t\n668\t\n669\tdef test_repeating_d22_after_a_crash_replays_idempotently() -> None:\n670\t    \"\"\"A crash right after D22 returns, before the write is durable, is safe to redo.\"\"\"\n671\t\n672\t    state = _passing_state()\n673\t    first = acceptance.D22_ACCEPT_UNIT(state, None)\n674\t    again = acceptance.D22_ACCEPT_UNIT(state, None)\n675\t    assert first[\"accepted_unit_receipts\"] == again[\"accepted_unit_receipts\"]\n676\t    merged_once = _apply(state, first)\n677\t    merged_twice = _apply(merged_once, again)\n678\t    assert merged_once[\"accepted_unit_receipts\"] == merged_twice[\"accepted_unit_receipts\"]\n679\t\n680\t\n681\tdef test_repeating_d23_after_a_crash_replays_idempotently() -> None:\n682\t    state = _passing_state()\n683\t    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n684\t    first = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n685\t    again = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n686\t    assert first[\"checkpoint_metadata\"] == again[\"checkpoint_metadata\"]\n687\t    merged_once = _apply(state, first)\n688\t    merged_twice = _apply(merged_once, again)\n689\t    assert merged_once[\"cursor\"] == merged_twice[\"cursor\"]\n690\t\n691\t\n692\tdef test_re_admitting_the_same_repair_after_the_head_already_advanced_fails_closed() -> None:\n693\t    \"\"\"A crash between D20's write and the next checkpoint never corrupts the head:\n694\t    replaying D20 against the now-advanced head fails closed rather than silently\n695\t    re-applying a second, unaccounted-for repair.\"\"\"\n696\t\n697\t    state = _repair_cycle_state()\n698\t    request = state[\"repair_requests\"][-1]\n699\t    domain_stream = stream_id(UNIT, \"domain\")\n700\t    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n701\t    new_body = dict(_domain_body())\n702\t    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n703\t    candidate = {\n704\t        \"key\": \"candidate:m06-crash\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n705\t        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n706\t        \"parent_sha256\": parent_hash,\n707\t        \"payload\": {\n708\t            \"candidate_child\": {\n709\t                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n710\t                \"addressed_finding_ids\": request[\"finding_ids\"],\n711\t            },\n712\t            \"changed_path_manifest\": [\n713\t                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n714\t            ],\n715\t        },\n716\t    }\n717\t    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n718\t    update = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n719\t    state = _apply(state, update)  # the durable, post-crash state\n720\t    with pytest.raises(SystemFailure):\n721\t        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n722\t\n723\t\n724\tdef test_a_crash_before_the_terminal_write_still_lets_d98_be_invoked_cleanly() -> None:\n725\t    state = _passing_state()\n726\t    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n727\t    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n728\t    receipt = state[\"accepted_unit_receipts\"][UNIT]\n729\t    checkpoint = state[\"checkpoint_metadata\"][-1]\n730\t    state[\"terminal_candidate\"] = {\n731\t        \"kind\": \"UNIT_ACCEPTED\", \"unit_id\": UNIT, \"receipt_hash\": receipt[\"receipt_hash\"],\n732\t        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]}, \"denominator\": receipt[\"denominator\"],\n733\t        \"log_high_water_mark\": 0, \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n734\t    }\n735\t    projection = _d98_projection(state)\n736\t    record_a = terminal.write_terminal(projection, None)\n737\t    # A crash right after D98 returns but before its write lands: re-deriving the\n738\t    # same projection and revalidating produces the byte-identical record.\n739\t    record_b = terminal.write_terminal(projection, None)\n740\t    assert record_a[\"terminal\"] == record_b[\"terminal\"]\n741\t"}]},"parent_tool_use_id":null,"session_id":"b1f1ac47-68e2-44fb-bfa5-0ab46fd6f0a8","uuid":"c94c03f6-74a5-47b8-8529-bb47e93ebfa0","timestamp":"2026-08-12T21:21:01.988Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T211427.316028Z-623ff2d9fa/repo/tests/runtime/test_plan26_repair_acceptance.py","content":"\"\"\"N31 acceptance tests: targeted repair (D17-D21) and unit acceptance (D16, D22, D23).\n\nTen TEST items from `prompts/N31_repair_acceptance.prompt.v2.md`. Every function\nunder test is called directly and unmodified from `runtime.langgraph_factory.repair`\n/ `acceptance`; TEST 9 additionally calls the real, unmodified\n`runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's D98) rather than a\nstand-in, and no test in this file writes to `nodes/terminal.py`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom typing import Any\n\nimport pytest\n\nfrom runtime.langgraph_factory import acceptance, repair\nfrom runtime.langgraph_factory.nodes import terminal\nfrom runtime.langgraph_factory.nodes.domain import DOMAIN_CHECK_IDS\nfrom runtime.langgraph_factory.nodes.content import CONTENT_CHECK_IDS\nfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id\nfrom runtime.langgraph_factory.state import FIELD_REDUCERS\nfrom runtime.langgraph_factory import reducers as red\n\nRUN = \"run-n31\"\nEPISODE = \"ep-n31\"\nUNIT = \"U001\"\n\n\ndef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n\n    merged = dict(state)\n    for field, value in update.items():\n        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n    return merged\n\n\ndef _domain_body() -> dict[str, Any]:\n    return {\n        \"unit_id\": UNIT,\n        \"facts\": [{\"fact_id\": \"f1\", \"statement\": \"a fact\"}],\n        \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n    }\n\n\ndef _content_body() -> dict[str, Any]:\n    return {\n        \"unit_id\": UNIT,\n        \"sections\": [{\"section_id\": \"s1\", \"heading\": \"h\", \"body\": \"b\"}],\n        \"claims\": [],\n        \"derivations\": [],\n    }\n\n\ndef _visuals_body() -> dict[str, Any]:\n    return {\"unit_id\": UNIT}\n\n\ndef _head(version: int, parent_hash: str | None, hash_: str) -> dict[str, Any]:\n    return {\"version\": version, \"parent_hash\": parent_hash, \"hash\": hash_}\n\n\ndef _passing_state() -> dict[str, Any]:\n    \"\"\"A unit whose full denominator currently passes (spec section 13.1).\"\"\"\n\n    domain_body = _domain_body()\n    content_body = _content_body()\n    visuals_body = _visuals_body()\n    domain_hash = canonical_digest(domain_body)\n    content_hash = canonical_digest(content_body)\n    visuals_hash = canonical_digest(visuals_body)\n    pdf_sha256 = \"f\" * 64\n    page_sha = \"a\" * 64\n\n    domain_stream = stream_id(UNIT, \"domain\")\n    content_stream = stream_id(UNIT, \"content\")\n    visuals_stream = stream_id(UNIT, \"visuals\")\n\n    deterministic_checks = [\n        {\n            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash,\n            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n        }\n        for check_id in DOMAIN_CHECK_IDS\n    ] + [\n        {\n            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash,\n            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n        }\n        for check_id in CONTENT_CHECK_IDS\n    ]\n\n    review_candidate = {\n        \"key\": \"candidate:review-1\",\n        \"record_kind\": \"model_candidate\",\n        \"pre_admission\": True,\n        \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\",\n        \"unit_pdf_sha256\": pdf_sha256,\n        \"payload\": {\n            \"overall_findings\": [],\n            \"page_findings\": [{\"page_number\": 1, \"page_sha256\": page_sha, \"findings\": []}],\n        },\n    }\n\n    return {\n        \"run_id\": RUN,\n        \"episode_id\": EPISODE,\n        \"selected_unit_id\": UNIT,\n        \"effective_run\": {\"target_closure\": [UNIT]},\n        \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0},\n        \"unit_status\": {UNIT: \"REVIEWING\"},\n        \"artifact_heads\": {\n            domain_stream: _head(1, None, domain_hash),\n            content_stream: _head(1, None, content_hash),\n        },\n        \"artifact_versions\": [\n            {\"key\": f\"{domain_stream}@1\", \"stream\": domain_stream, \"version\": 1, \"parent_hash\": None, \"hash\": domain_hash, \"body\": domain_body},\n            {\"key\": f\"{content_stream}@1\", \"stream\": content_stream, \"version\": 1, \"parent_hash\": None, \"hash\": content_hash, \"body\": content_body},\n            {\"key\": f\"{visuals_stream}@1\", \"stream\": visuals_stream, \"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash, \"body\": visuals_body},\n        ],\n        \"deterministic_checks\": deterministic_checks,\n        \"source_admissions\": [{\"key\": \"s1\", \"unit_id\": UNIT, \"sha256\": \"b\" * 64}],\n        \"visual_join_evidence\": [{\"key\": \"vje1\", \"unit_id\": UNIT, \"phase\": \"join\", \"result\": \"PASS\"}],\n        \"unit_page_inventories\": [\n            {\"key\": \"inv1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page_count\": 1, \"contiguous\": True, \"result\": \"PASS\"}\n        ],\n        \"unit_page_inspections\": [\n            {\"key\": \"insp1\", \"unit_id\": UNIT, \"pdf_sha256\": pdf_sha256, \"page\": 1, \"page_sha256\": page_sha, \"problems\": [], \"result\": \"PASS\"}\n        ],\n        \"unit_reviews\": [review_candidate],\n        \"repair_requests\": [],\n        \"retest_results\": [],\n        \"accepted_unit_receipts\": {},\n        \"evidence_index_entries\": [],\n        \"checkpoint_metadata\": [],\n        \"attempt_counters\": {},\n    }\n\n\n# ---------------------------------------------------------------------------\n# TEST 1: zero/multiple/unknown/model-selected finding owners fail\n# ---------------------------------------------------------------------------\n\n\ndef test_d17_rejects_a_finding_with_no_owner() -> None:\n    state = _passing_state()\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n    }\n    with pytest.raises(SystemFailure):\n        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n\n\ndef test_d17_rejects_a_finding_with_an_unknown_owner() -> None:\n    state = _passing_state()\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"owner\": \"mystery owner\", \"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n    }\n    with pytest.raises(SystemFailure):\n        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n\n\ndef test_d17_partitions_a_multi_owner_findings_list_into_separate_owner_entries() -> None:\n    \"\"\"A single D08 call can raise findings against two owners; D17 splits them.\"\"\"\n\n    state = _passing_state()\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [\n                {\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad schema\"},\n                {\"owner\": \"source interpretation\", \"check_id\": \"domain_facts_sourced\", \"pointer\": \"/facts/1\", \"message\": \"unsourced\"},\n            ],\n        },\n    }\n    update = repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n    owners = {entry[\"owner\"] for entry in update[\"finding_partitions\"]}\n    assert owners == {\"curriculum domain\", \"source interpretation\"}\n    assert update[\"pending_guard\"][\"value\"] == \"partition_complete\"\n\n\ndef test_review_finding_category_is_never_trusted_as_an_owner() -> None:\n    \"\"\"A model-selected `category` is mapped through a fixed table; unmapped fails closed.\"\"\"\n\n    assert repair.owner_for_review_category(\"visual clarity\") == \"unit visual\"\n    assert repair.owner_for_review_category(\"totally unrelated nonsense\") is None\n\n    state = _passing_state()\n    state[\"unit_reviews\"][0][\"payload\"][\"overall_findings\"] = [\n        {\"finding_id\": \"f1\", \"severity\": \"blocking\", \"category\": \"totally unrelated nonsense\",\n         \"description\": \"d\", \"evidence_reference\": \"/whatever\"}\n    ]\n    with pytest.raises(SystemFailure):\n        acceptance.compute_unit_denominator(state, UNIT)\n\n\n# ---------------------------------------------------------------------------\n# TEST 2: local repair changes only named paths/descendants\n# ---------------------------------------------------------------------------\n\n\ndef _repair_cycle_state(*, boundary_pointer: str = \"/facts/0/statement\") -> dict[str, Any]:\n    state = _passing_state()\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": boundary_pointer, \"message\": \"bad\"}],\n        },\n    }\n    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n    state = _apply(state, repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None))\n    return state\n\n\ndef test_a_correctly_scoped_model_repair_admits() -> None:\n    state = _repair_cycle_state()\n    request = state[\"repair_requests\"][-1]\n    domain_stream = stream_id(UNIT, \"domain\")\n    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n    new_body = dict(_domain_body())\n    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n    candidate = {\n        \"key\": \"candidate:m06-1\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n        \"parent_sha256\": parent_hash,\n        \"payload\": {\n            \"candidate_child\": {\n                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n                \"addressed_finding_ids\": request[\"finding_ids\"],\n            },\n            \"changed_path_manifest\": [\n                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n            ],\n        },\n    }\n    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n    update = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"repair_admitted\"\n    assert update[\"artifact_heads\"][domain_stream][\"version\"] == 2\n\n\ndef test_a_broad_repair_outside_its_boundary_is_refused() -> None:\n    state = _repair_cycle_state()\n    request = state[\"repair_requests\"][-1]\n    domain_stream = stream_id(UNIT, \"domain\")\n    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n    new_body = dict(_domain_body())\n    # Touches an undeclared pointer (verifier_result) in addition to the named one.\n    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n    new_body[\"verifier_result\"] = {\"result\": \"not_run\"}\n    candidate = {\n        \"key\": \"candidate:m06-broad\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n        \"parent_sha256\": parent_hash,\n        \"payload\": {\n            \"candidate_child\": {\n                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n                \"addressed_finding_ids\": request[\"finding_ids\"],\n            },\n            \"changed_path_manifest\": [\n                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]},\n                {\"json_pointer\": \"/verifier_result\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]},\n            ],\n        },\n    }\n    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n    with pytest.raises(SystemFailure):\n        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n\n\ndef test_an_in_place_no_op_repair_is_refused() -> None:\n    state = _repair_cycle_state()\n    request = state[\"repair_requests\"][-1]\n    domain_stream = stream_id(UNIT, \"domain\")\n    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n    unchanged_body = _domain_body()  # identical to parent\n    candidate = {\n        \"key\": \"candidate:m06-noop\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n        \"parent_sha256\": parent_hash,\n        \"payload\": {\n            \"candidate_child\": {\n                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(unchanged_body, sort_keys=True),\n                \"addressed_finding_ids\": request[\"finding_ids\"],\n            },\n            \"changed_path_manifest\": [\n                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n            ],\n        },\n    }\n    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n    with pytest.raises(SystemFailure):\n        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n\n\ndef test_a_stale_parent_repair_is_refused() -> None:\n    state = _repair_cycle_state()\n    request = state[\"repair_requests\"][-1]\n    new_body = dict(_domain_body())\n    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n    candidate = {\n        \"key\": \"candidate:m06-stale\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n        \"parent_sha256\": \"0\" * 64,  # not the current head\n        \"payload\": {\n            \"candidate_child\": {\n                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n                \"addressed_finding_ids\": request[\"finding_ids\"],\n            },\n            \"changed_path_manifest\": [\n                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n            ],\n        },\n    }\n    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n    with pytest.raises(SystemFailure):\n        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n\n\ndef test_a_deterministic_layout_repair_changes_only_its_allowed_pointer() -> None:\n    state = _passing_state()\n    layout_stream = stream_id(UNIT, \"layout\")\n    layout_body = {\"unit_id\": UNIT, \"template\": \"v1\", \"page_count\": 1}\n    layout_hash = canonical_digest(layout_body)\n    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [\n        {\"key\": f\"{layout_stream}@1\", \"stream\": layout_stream, \"version\": 1, \"parent_hash\": None, \"hash\": layout_hash, \"body\": layout_body}\n    ]\n    state[\"pending_guard\"] = {\n        \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"value\": \"layout_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [{\n                \"owner\": \"unit layout\", \"check_id\": \"unit_page_inventory\", \"pointer\": \"/template\",\n                \"message\": \"wrong template\", \"allowed_facts\": {\"/template\": \"v2\"},\n            }],\n        },\n    }\n    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n    state = _apply(state, repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None))\n    assert state[\"pending_guard\"][\"value\"] == \"repair_planned\"\n    update = repair.D19_ROUTE_UNIT_REPAIR(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"deterministic_repair\"\n    candidate = update[\"artifact_versions\"][0]\n    assert candidate[\"body\"][\"template\"] == \"v2\"\n    assert candidate[\"body\"][\"page_count\"] == 1  # only the named pointer changed\n    state = _apply(state, update)\n    admitted = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n    # layout is append-only versioned, not `artifact_heads`-tracked (matching\n    # `review.py`'s own `latest_candidate` convention for this channel).\n    assert \"artifact_heads\" not in admitted\n    admitted_versions = [v for v in admitted[\"artifact_versions\"] if v[\"stream\"] == layout_stream]\n    assert admitted_versions[0][\"version\"] == 2\n    assert admitted_versions[0][\"body\"][\"template\"] == \"v2\"\n\n\n# ---------------------------------------------------------------------------\n# TEST 3: attempt/repeat bounds stop before an over-bound M06 call\n# ---------------------------------------------------------------------------\n\n\ndef test_attempt_bound_exhausts_before_a_fourth_repair_child() -> None:\n    state = _passing_state()\n    state[\"attempt_counters\"] = {\n        f\"repair|{UNIT}|curriculum domain|{canonical_digest([repair.finding_fingerprint('curriculum domain', ['/facts/0/statement'], 'bad')])}\": repair.MAX_REPAIR_CHILDREN_PER_CHAIN\n    }\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n        },\n    }\n    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n    update = repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n    assert update[\"terminal_candidate\"][\"kind\"] == \"CONVERGENCE_EXHAUSTED\"\n    assert update[\"terminal_candidate\"][\"bound\"] == \"attempt_bound\"\n\n\ndef test_fingerprint_repeat_bound_exhausts_at_d17() -> None:\n    state = _passing_state()\n    fingerprint = canonical_digest(\n        [repair.finding_fingerprint(\"curriculum domain\", [\"/facts/0/statement\"], \"bad\")]\n    )\n    state[\"attempt_counters\"] = {\n        f\"repeat|{UNIT}|curriculum domain|{fingerprint}\": repair.MAX_FINGERPRINT_REPEATS\n    }\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n        },\n    }\n    update = repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n    assert update[\"terminal_candidate\"][\"bound\"] == \"fingerprint_bound\"\n\n\n# ---------------------------------------------------------------------------\n# TEST 4: all invalidated descendants retest; stale evidence cannot pass\n# ---------------------------------------------------------------------------\n\n\ndef test_d21_dispatches_the_first_retest_node_of_the_owners_fixed_chain() -> None:\n    state = _repair_cycle_state()\n    state = _apply(state, repair.D19_ROUTE_UNIT_REPAIR(state, None))\n    update = repair.D21_RETEST_REQUIRED_DESCENDANTS(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"retest_frontier_incomplete\"\n    assert update[\"pending_guard\"][\"detail\"][\"destination\"] == repair.RETEST_FIRST_NODE[\"curriculum domain\"]\n    assert update[\"retest_results\"][0][\"dispatched_to\"] == \"D08_VALIDATE_DOMAIN\"\n\n\ndef test_stale_evidence_at_an_old_head_cannot_pass_the_denominator() -> None:\n    \"\"\"A check recorded against a superseded head is invisible to the reduction.\"\"\"\n\n    state = _passing_state()\n    domain_stream = stream_id(UNIT, \"domain\")\n    # Advance the domain head without refreshing its checks: the old checks\n    # were recorded against the old (now-stale) head_hash.\n    new_hash = canonical_digest({\"unit_id\": UNIT, \"facts\": []})\n    state[\"artifact_heads\"][domain_stream] = _head(2, state[\"artifact_heads\"][domain_stream][\"hash\"], new_hash)\n    result = acceptance.compute_unit_denominator(state, UNIT)\n    assert not result.passed\n    assert any(f[\"owner\"] == \"curriculum domain\" for f in result.findings)\n\n\n# ---------------------------------------------------------------------------\n# TEST 5: removing/failing/staling each acceptance member makes D22 reject\n# ---------------------------------------------------------------------------\n\n\ndef test_d22_accepts_a_fully_passing_denominator() -> None:\n    state = _passing_state()\n    update = acceptance.D22_ACCEPT_UNIT(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"unit_accepted\"\n    assert UNIT in update[\"accepted_unit_receipts\"]\n\n\n@pytest.mark.parametrize(\n    \"mutate\",\n    [\n        lambda s: s.__setitem__(\"source_admissions\", []),\n        lambda s: s[\"deterministic_checks\"].__setitem__(0, {**s[\"deterministic_checks\"][0], \"result\": \"FAIL\"}),\n        lambda s: s.__setitem__(\"visual_join_evidence\", []),\n        lambda s: s.__setitem__(\"unit_page_inspections\", []),\n        lambda s: s.__setitem__(\"unit_reviews\", []),\n    ],\n    ids=[\"source\", \"domain_check\", \"visuals\", \"pages\", \"review\"],\n)\ndef test_removing_or_failing_any_single_member_makes_d22_reject(mutate) -> None:\n    state = _passing_state()\n    mutate(state)\n    with pytest.raises(SystemFailure):\n        acceptance.D22_ACCEPT_UNIT(state, None)\n\n\ndef test_staling_the_content_head_makes_d22_reject() -> None:\n    state = _passing_state()\n    content_stream = stream_id(UNIT, \"content\")\n    new_hash = canonical_digest({\"unit_id\": UNIT, \"sections\": []})\n    state[\"artifact_heads\"][content_stream] = _head(2, state[\"artifact_heads\"][content_stream][\"hash\"], new_hash)\n    with pytest.raises(SystemFailure):\n        acceptance.D22_ACCEPT_UNIT(state, None)\n\n\n# ---------------------------------------------------------------------------\n# TEST 6: accepted bytes remain immutable across resume, later units, and repair\n# ---------------------------------------------------------------------------\n\n\ndef test_accept_once_refuses_a_differing_second_write_for_the_same_unit() -> None:\n    state = _passing_state()\n    # Two independent computations against the same pre-acceptance state (as a\n    # crash-before-durable-write replay would see) agree byte-for-byte.\n    first = acceptance.D22_ACCEPT_UNIT(state, None)\n    second = acceptance.D22_ACCEPT_UNIT(state, None)\n    assert first[\"accepted_unit_receipts\"] == second[\"accepted_unit_receipts\"]\n\n    merged = _apply(state, first)\n    replayed = red.accept_once(merged[\"accepted_unit_receipts\"], second[\"accepted_unit_receipts\"])\n    assert replayed == merged[\"accepted_unit_receipts\"]\n\n    tampered = {UNIT: {**merged[\"accepted_unit_receipts\"][UNIT], \"receipt_hash\": \"deadbeef\"}}\n    with pytest.raises(red.AcceptOnceConflict):\n        red.accept_once(merged[\"accepted_unit_receipts\"], tampered)\n\n    # D22 itself refuses to reconsider a unit its own state already accepted.\n    with pytest.raises(SystemFailure):\n        acceptance.D22_ACCEPT_UNIT(merged, None)\n\n\ndef test_an_already_accepted_unit_can_never_re_enter_classification_or_planning() -> None:\n    state = _passing_state()\n    state[\"accepted_unit_receipts\"] = {UNIT: {\"receipt_hash\": \"x\" * 64}}\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\"unit_id\": UNIT, \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"x\", \"pointer\": \"/facts/0\", \"message\": \"m\"}]},\n    }\n    with pytest.raises(SystemFailure):\n        repair.D17_CLASSIFY_UNIT_FINDINGS(state, None)\n\n\n# ---------------------------------------------------------------------------\n# TEST 7: cursor advances only after checkpoint/evidence/log correlation flush\n# ---------------------------------------------------------------------------\n\n\ndef test_d23_writes_checkpoint_metadata_and_cursor_in_the_same_update() -> None:\n    state = _passing_state()\n    accept_update = acceptance.D22_ACCEPT_UNIT(state, None)\n    state = _apply(state, accept_update)\n    update = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n    assert \"checkpoint_metadata\" in update and \"cursor\" in update\n    assert update[\"cursor\"][\"accepted_ordinal\"] == 1\n    assert update[\"checkpoint_metadata\"][0][\"checkpoint_id\"]\n    assert update[\"accepted_unit_checkpoint_receipts\"][0][\"checkpoint_id\"] == update[\"checkpoint_metadata\"][0][\"checkpoint_id\"]\n\n\ndef test_d23_refuses_to_advance_the_cursor_with_no_accepted_receipt() -> None:\n    state = _passing_state()\n    with pytest.raises(SystemFailure):\n        acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n\n\n# ---------------------------------------------------------------------------\n# TEST 8: D24-shaped coverage rejects missing/extra/reordered/wrong-hash\n# ---------------------------------------------------------------------------\n\n\ndef test_coverage_proof_rejects_missing_extra_reordered_and_wrong_hash() -> None:\n    receipts = {\n        \"U001\": {\"receipt_hash\": \"1\" * 64},\n        \"U002\": {\"receipt_hash\": \"2\" * 64},\n    }\n    ordered = [\"U001\", \"U002\"]\n    passed, rejections = acceptance.prove_exact_manifest_coverage(\n        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}]\n    )\n    assert passed and not rejections\n\n    # missing\n    passed, rejections = acceptance.prove_exact_manifest_coverage(\n        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}]\n    )\n    assert not passed\n\n    # extra\n    passed, rejections = acceptance.prove_exact_manifest_coverage(\n        ordered, receipts,\n        [{\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}, {\"unit_id\": \"U003\", \"receipt_hash\": \"3\" * 64}],\n    )\n    assert not passed\n\n    # reordered\n    passed, rejections = acceptance.prove_exact_manifest_coverage(\n        ordered, receipts, [{\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}, {\"unit_id\": \"U001\", \"receipt_hash\": \"1\" * 64}]\n    )\n    assert not passed\n\n    # wrong hash\n    passed, rejections = acceptance.prove_exact_manifest_coverage(\n        ordered, receipts, [{\"unit_id\": \"U001\", \"receipt_hash\": \"0\" * 64}, {\"unit_id\": \"U002\", \"receipt_hash\": \"2\" * 64}]\n    )\n    assert not passed\n\n\n# ---------------------------------------------------------------------------\n# TEST 9: real D98 traverses one-mode success and unit-failure candidates\n# ---------------------------------------------------------------------------\n\n\ndef _d98_projection(state: dict[str, Any]) -> dict[str, Any]:\n    from runtime.langgraph_factory.nodes import project\n\n    full = {\n        **state,\n        \"terminal\": None,\n        \"terminal_history\": [],\n        \"mode\": \"one\",\n        \"requested_unit_id\": UNIT,\n        \"final_release_audits\": [],\n        \"workbook_head\": {},\n        \"failure_fingerprints\": [],\n        \"resume_frontier\": None,\n        \"pending_failure\": None,\n        \"output_root\": \"/tmp/out\",\n    }\n    return project(\"D98_WRITE_TERMINAL\", full)\n\n\ndef test_a_unit_accepted_candidate_traverses_the_real_d98_and_is_accepted() -> None:\n    assert terminal.write_terminal.__module__ == \"runtime.langgraph_factory.nodes.terminal\"\n\n    state = _passing_state()\n    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n\n    receipt = state[\"accepted_unit_receipts\"][UNIT]\n    checkpoint = state[\"checkpoint_metadata\"][-1]\n    state[\"terminal_candidate\"] = {\n        \"kind\": \"UNIT_ACCEPTED\",\n        \"unit_id\": UNIT,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]},\n        \"denominator\": receipt[\"denominator\"],\n        \"log_high_water_mark\": 0,\n        \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n    }\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"UNIT_ACCEPTED\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n\n\ndef test_a_tampered_unit_accepted_candidate_is_rejected_by_the_real_d98() -> None:\n    state = _passing_state()\n    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n    receipt = state[\"accepted_unit_receipts\"][UNIT]\n    checkpoint = state[\"checkpoint_metadata\"][-1]\n    state[\"terminal_candidate\"] = {\n        \"kind\": \"UNIT_ACCEPTED\",\n        \"unit_id\": UNIT,\n        \"receipt_hash\": \"not-the-real-hash\",\n        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]},\n        \"denominator\": receipt[\"denominator\"],\n        \"log_high_water_mark\": 0,\n        \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n    }\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False\n\n\ndef test_a_convergence_exhausted_candidate_from_d17_traverses_the_real_d98() -> None:\n    state = _passing_state()\n    state[\"attempt_counters\"] = {\n        f\"repair|{UNIT}|curriculum domain|{canonical_digest([repair.finding_fingerprint('curriculum domain', ['/facts/0/statement'], 'bad')])}\": repair.MAX_REPAIR_CHILDREN_PER_CHAIN\n    }\n    state[\"pending_guard\"] = {\n        \"node\": \"D08_VALIDATE_DOMAIN\", \"value\": \"domain_repairable\",\n        \"detail\": {\n            \"unit_id\": UNIT,\n            \"findings\": [{\"owner\": \"curriculum domain\", \"check_id\": \"domain_schema_valid\", \"pointer\": \"/facts/0/statement\", \"message\": \"bad\"}],\n        },\n    }\n    state = _apply(state, repair.D17_CLASSIFY_UNIT_FINDINGS(state, None))\n    exhaustion = repair.D18_PLAN_TARGETED_UNIT_REPAIR(state, None)\n    candidate = dict(exhaustion[\"terminal_candidate\"])\n    state[\"terminal_candidate\"] = candidate\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"CONVERGENCE_EXHAUSTED\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n\n\n# ---------------------------------------------------------------------------\n# TEST 10: crash at every repair/accept/checkpoint/D98 boundary is recoverable\n# ---------------------------------------------------------------------------\n\n\ndef test_repeating_d22_after_a_crash_replays_idempotently() -> None:\n    \"\"\"A crash right after D22 returns, before the write is durable, is safe to redo.\"\"\"\n\n    state = _passing_state()\n    first = acceptance.D22_ACCEPT_UNIT(state, None)\n    again = acceptance.D22_ACCEPT_UNIT(state, None)\n    assert first[\"accepted_unit_receipts\"] == again[\"accepted_unit_receipts\"]\n    merged_once = _apply(state, first)\n    merged_twice = _apply(merged_once, again)\n    assert merged_once[\"accepted_unit_receipts\"] == merged_twice[\"accepted_unit_receipts\"]\n\n\ndef test_repeating_d23_after_a_crash_replays_idempotently() -> None:\n    state = _passing_state()\n    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n    first = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n    again = acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None)\n    assert first[\"checkpoint_metadata\"] == again[\"checkpoint_metadata\"]\n    merged_once = _apply(state, first)\n    merged_twice = _apply(merged_once, again)\n    assert merged_once[\"cursor\"] == merged_twice[\"cursor\"]\n\n\ndef test_re_admitting_the_same_repair_after_the_head_already_advanced_fails_closed() -> None:\n    \"\"\"A crash between D20's write and the next checkpoint never corrupts the head:\n    replaying D20 against the now-advanced head fails closed rather than silently\n    re-applying a second, unaccounted-for repair.\"\"\"\n\n    state = _repair_cycle_state()\n    request = state[\"repair_requests\"][-1]\n    domain_stream = stream_id(UNIT, \"domain\")\n    parent_hash = state[\"artifact_heads\"][domain_stream][\"hash\"]\n    new_body = dict(_domain_body())\n    new_body[\"facts\"] = [{\"fact_id\": \"f1\", \"statement\": \"corrected statement\"}]\n    candidate = {\n        \"key\": \"candidate:m06-crash\", \"record_kind\": \"model_candidate\", \"pre_admission\": True,\n        \"job_id\": \"M06_REPAIR_NAMED_UNIT_ARTIFACT\", \"channel\": \"domain\", \"unit_id\": UNIT,\n        \"parent_sha256\": parent_hash,\n        \"payload\": {\n            \"candidate_child\": {\n                \"artifact_name\": f\"domain:{UNIT}\", \"artifact_body\": json.dumps(new_body, sort_keys=True),\n                \"addressed_finding_ids\": request[\"finding_ids\"],\n            },\n            \"changed_path_manifest\": [\n                {\"json_pointer\": \"/facts/0/statement\", \"change_kind\": \"replace\", \"finding_id\": request[\"finding_ids\"][0]}\n            ],\n        },\n    }\n    state[\"artifact_versions\"] = state[\"artifact_versions\"] + [candidate]\n    update = repair.D20_ADMIT_UNIT_REPAIR(state, None)\n    state = _apply(state, update)  # the durable, post-crash state\n    with pytest.raises(SystemFailure):\n        repair.D20_ADMIT_UNIT_REPAIR(state, None)\n\n\ndef test_a_crash_before_the_terminal_write_still_lets_d98_be_invoked_cleanly() -> None:\n    state = _passing_state()\n    state = _apply(state, acceptance.D22_ACCEPT_UNIT(state, None))\n    state = _apply(state, acceptance.D23_CHECKPOINT_ACCEPTED_UNIT(state, None))\n    receipt = state[\"accepted_unit_receipts\"][UNIT]\n    checkpoint = state[\"checkpoint_metadata\"][-1]\n    state[\"terminal_candidate\"] = {\n        \"kind\": \"UNIT_ACCEPTED\", \"unit_id\": UNIT, \"receipt_hash\": receipt[\"receipt_hash\"],\n        \"closure_receipt_hashes\": {UNIT: receipt[\"receipt_hash\"]}, \"denominator\": receipt[\"denominator\"],\n        \"log_high_water_mark\": 0, \"checkpoint_id\": checkpoint[\"checkpoint_id\"],\n    }\n    projection = _d98_projection(state)\n    record_a = terminal.write_terminal(projection, None)\n    # A crash right after D98 returns but before its write lands: re-deriving the\n    # same projection and revalidating produces the byte-identical record.\n    record_b = terminal.write_terminal(projection, None)\n    assert record_a[\"terminal\"] == record_b[\"terminal\"]\n","numLines":741,"startLine":1,"totalLines":741}}}
