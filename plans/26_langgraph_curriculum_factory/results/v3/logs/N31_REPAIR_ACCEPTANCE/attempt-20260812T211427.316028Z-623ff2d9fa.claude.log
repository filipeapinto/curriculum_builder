{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QYBYeWN5rktm4FcQehDy83","type":"tool_result","content":"1600\t    assert rendered[\"pending_guard\"][\"value\"] == \"unit_rendered\"\n1601\t    if defect == \"empty_inventory\":\n1602\t        registry.inspect_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n1603\t    else:\n1604\t        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n1605\t            report = _StubRegistry.inspect_pages(registry, pdf_path, pdf_sha256)\n1606\t            report[\"pages\"][1][\"number\"] = 3\n1607\t            return report\n1608\t\n1609\t        registry.inspect_pages = _skewed  # type: ignore[method-assign]\n1610\t\n1611\t    inspected = render.D14_INVENTORY_AND_INSPECT_UNIT_PAGES(\n1612\t        {**state, \"artifact_versions\": rendered[\"artifact_versions\"]}, context\n1613\t    )\n1614\t    inventory = inspected[\"unit_page_inventories\"][0]\n1615\t    assert inventory[\"result\"] == \"FAIL\"\n1616\t    assert inspected[\"pending_guard\"][\"value\"] == \"layout_repairable\"\n1617\t    assert R.route_page_inspection({**state, **inspected}) == \"D17_CLASSIFY_UNIT_FINDINGS\"\n1618\t\n1619\t\n1620\tdef test_the_review_packet_names_the_exact_pdf_and_every_page_once(\n1621\t    tmp_path: Path, monkeypatch\n1622\t) -> None:\n1623\t    \"\"\"Prompt TEST 7, on a real episode: the packet is the denominator M05 answers.\n1624\t\n1625\t    D15 freezes the PDF D14 measured and every inspected page exactly once, and\n1626\t    the review M05 really returned answers that page set by number *and* by hash,\n1627\t    with nothing invented and nothing dropped. This is the evidence D16 reduces,\n1628\t    so it is the last thing this node is responsible for handing N31.\n1629\t    \"\"\"\n1630\t\n1631\t    fixture = _build_episode_fixture(tmp_path)\n1632\t    result = _run_episode(monkeypatch, fixture)\n1633\t    state = result[\"state\"]\n1634\t\n1635\t    packet = state[\"review_packets\"][0]\n1636\t    inventory = state[\"unit_page_inventories\"][0]\n1637\t    inspections = state[\"unit_page_inspections\"]\n1638\t\n1639\t    assert packet[\"pdf_sha256\"] == inventory[\"pdf_sha256\"]\n1640\t    assert packet[\"page_count\"] == inventory[\"page_count\"] == len(inspections)\n1641\t    assert packet[\"page_keys\"] == [record[\"key\"] for record in inspections]\n1642\t    assert len(set(packet[\"page_keys\"])) == len(packet[\"page_keys\"])\n1643\t    assert packet[\"denominator\"] == {\n1644\t        \"pages\": len(inspections),\n1645\t        \"artifacts\": len(packet[\"artifact_hashes\"]),\n1646\t        \"checks\": len(packet[\"deterministic_check_keys\"]),\n1647\t        \"sources\": len(packet[\"admitted_source_keys\"]),\n1648\t    }\n1649\t    for channel in (\"domain\", \"content\", \"visuals\"):\n1650\t        assert packet[\"artifact_hashes\"][channel] == state[\"artifact_heads\"][f\"units/U001/{channel}\"][\"hash\"]\n1651\t\n1652\t    # M05's dispatch carried that exact packet, and its answer matches it by hash.\n1653\t    dispatched = next(\n1654\t        update for node_id, update in result[\"updates\"]\n1655\t        if node_id == \"D15_FREEZE_UNIT_REVIEW_PACKET\"\n1656\t    )[\"pending_packet\"][\"packets\"]\n1657\t    assert len(dispatched) == 1\n1658\t    projected_pages = dispatched[0][\"pages\"]\n1659\t    assert [page[\"page_number\"] for page in projected_pages] == [1, 2]\n1660\t    assert [page[\"page_sha256\"] for page in projected_pages] == [\n1661\t        record[\"page_sha256\"] for record in inspections\n1662\t    ]\n1663\t\n1664\t    review_record = state[\"unit_reviews\"][0]\n1665\t    assert review_record[\"unit_pdf_sha256\"] == packet[\"pdf_sha256\"]\n1666\t    assert review_record[\"page_count\"] == packet[\"page_count\"]\n1667\t    findings = review_record[\"payload\"][\"page_findings\"]\n1668\t    assert [entry[\"page_number\"] for entry in findings] == [1, 2]\n1669\t    assert [entry[\"page_sha256\"] for entry in findings] == [\n1670\t        record[\"page_sha256\"] for record in inspections\n1671\t    ]\n1672\t\n1673\t    # And the review is a candidate, not an admission: no head moved for it.\n1674\t    assert review_record[\"pre_admission\"] is True\n1675\t    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n1676\t\n1677\t\n1678\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1679\t    tmp_path: Path, monkeypatch\n1680\t) -> None:\n1681\t    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n1682\t\n1683\t    The whole unit path now executes and M05 returns a real independent review.\n1684\t    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n1685\t    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n1686\t    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n1687\t    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n1688\t    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n1689\t    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n1690\t    F1). This only checks the halt is *some* declared row, not pinned to\n1691\t    today's, so it keeps proving \"no fabricated destination\" rather than just\n1692\t    \"today's specific one.\"\n1693\t    \"\"\"\n1694\t\n1695\t    fixture = _build_episode_fixture(tmp_path)\n1696\t    result = _run_episode(monkeypatch, fixture)\n1697\t\n1698\t    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n1699\t\n1700\t    state = result[\"state\"]\n1701\t    assert state.get(\"pending_failure\") is None\n1702\t    assert state.get(\"terminal\") is None\n1703\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1704\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1705\t    # handoff rather than a repair loop that happens to stop here.\n1706\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1707\t    assert sorted(state[\"artifact_heads\"]) == [\n1708\t        \"units/U001/content\",\n1709\t        \"units/U001/domain\",\n1710\t        \"units/U001/visuals\",\n1711\t    ]\n1712\t\n1713\t\n1714\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1715\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n1716\t    tmp_path: Path, monkeypatch, boundary: str\n1717\t) -> None:\n1718\t    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n1719\t\n1720\t    The signal is raised after `boundary` returns. The next boundary observes it,\n1721\t    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n1722\t    resume frontier — never two terminals, and never a product success. The\n1723\t    interrupt takes precedence over the guard value at every boundary, which is\n1724\t    why a signal raised after D09 still reaches the gate rather than D09's own\n1725\t    deferred destination.\n1726\t    \"\"\"\n1727\t\n1728\t    fixture = _build_episode_fixture(tmp_path, units=1)\n1729\t    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n1730\t    trace = result[\"trace\"]\n1731\t    terminal = result[\"state\"].get(\"terminal\")\n1732\t\n1733\t    assert boundary in trace\n1734\t    assert result[\"deferred_frontier\"] is None, (\n1735\t        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n1736\t    )\n1737\t    assert terminal is not None\n1738\t    assert terminal[\"kind\"] == \"INTERRUPTED\"\n1739\t    assert terminal[\"resumable\"] is True\n1740\t    assert terminal[\"exit_code\"] == 10\n1741\t    assert terminal[\"evidence\"][\"resume_frontier\"]\n1742\t    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n1743\t\n1744\t    # Exactly one terminal, counted as terminals and not as D98 entries. An\n1745\t    # interrupt raised inside a `Send` map sends every in-flight branch to the\n1746\t    # gate, so D96 and D98 legitimately run once per branch; what must never\n1747\t    # happen is a second terminal. The extra entries refuse rather than write.\n1748\t    assert len(result[\"state\"][\"terminal_history\"]) == 1\n1749\t    written = [\n1750\t        update\n1751\t        for node_id, update in result[\"updates\"]\n1752\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n1753\t    ]\n1754\t    assert len(written) == 1\n1755\t    for node_id, update in result[\"updates\"]:\n1756\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n1757\t            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"\n1758\t            assert \"already holds a terminal record\" in update[\"pending_failure\"][\"message\"]\n1759\t\n1760\t    # Nothing chargeable ran after the interrupt. Stated as three separate\n1761\t    # properties, because \"nothing at all ran\" is not true at a `Send` map and\n1762\t    # asserting it would be asserting a race rather than an invariant: when the\n1763\t    # signal is observed between two in-flight map branches, one branch routes to\n1764\t    # the gate while the sibling's already-decided normal edge still fires, so a\n1765\t    # deterministic node can legitimately complete alongside the gate. It cannot\n1766\t    # dispatch, though — its own guard sees the signal — and that is what prompt\n1767\t    # TEST 9's \"without repeated valid calls\" actually requires.\n1768\t    gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1769\t    after = trace[gate:]\n1770\t    # 1. No model node runs after the gate: no valid model call is repeated.\n1771\t    assert not set(after) & MODEL_NODE_IDS\n1772\t    # 2. No attempt is even reserved after it, so nothing became chargeable.\n1773\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1774\t    for node_id, update in result[\"updates\"][gate:]:\n1775\t        assert \"attempt_counters\" not in (update or {}), node_id\n1776\t    # 3. Anything else that ran is a deterministic node that was already in\n1777\t    #    flight, and it is bounded: it may not be an admission node, so no\n1778\t    #    artifact head can advance behind the interrupt.\n1779\t    stragglers = set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"}\n1780\t    assert stragglers <= set(NODE_CATALOGUE), stragglers\n1781\t    for node_id, update in result[\"updates\"][gate:]:\n1782\t        assert \"artifact_heads\" not in (update or {}), node_id\n1783\t\n1784\t\n1785\tdef test_an_interrupt_inside_a_send_map_is_bounded_across_repeated_episodes(\n1786\t    tmp_path: Path, monkeypatch\n1787\t) -> None:\n1788\t    \"\"\"The one boundary whose post-gate trace is not deterministic, pinned.\n1789\t\n1790\t    An interrupt observed between two in-flight `Send` branches is a real race:\n1791\t    across repeated runs of the *same* input, the sibling branch sometimes routes\n1792\t    to the gate and sometimes completes its own normal edge first. The matrix row\n1793\t    for this boundary would otherwise be asserting whichever outcome happened to\n1794\t    occur. Twelve episodes are run and the bound is asserted over all of them:\n1795\t    whatever the interleaving, exactly one terminal is written, no model node and\n1796\t    no attempt reservation ever follows the gate, and the only deterministic node\n1797\t    that can straggle is the sibling's own join target.\n1798\t    \"\"\"\n1799\t\n1800\t    shapes: set[tuple[str, ...]] = set()\n1801\t    for index in range(12):\n1802\t        fixture = _build_episode_fixture(tmp_path / f\"map-interrupt-{index}\")\n1803\t        result = _run_episode(\n1804\t            monkeypatch, fixture, interrupt_after=\"M01_RESEARCH_UNIT_SOURCES\"\n1805\t        )\n1806\t        trace = result[\"trace\"]\n1807\t        gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n1808\t        after = trace[gate:]\n1809\t        shapes.add(tuple(after))\n1810\t\n1811\t        assert len(result[\"state\"][\"terminal_history\"]) == 1\n1812\t        assert result[\"state\"][\"terminal\"][\"kind\"] == \"INTERRUPTED\"\n1813\t        assert not set(after) & MODEL_NODE_IDS\n1814\t        assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n1815\t        assert set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"} <= {\n1816\t            \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n1817\t        }\n1818\t\n1819\t    # The race is real and is recorded as such rather than asserted away: if a"}]},"parent_tool_use_id":null,"session_id":"b1f1ac47-68e2-44fb-bfa5-0ab46fd6f0a8","uuid":"37d81cf7-76a6-4c35-9200-afeff34a38f8","timestamp":"2026-08-12T21:20:41.795Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T211427.316028Z-623ff2d9fa/repo/tests/runtime/test_plan26_unit_graph.py","content":"    assert rendered[\"pending_guard\"][\"value\"] == \"unit_rendered\"\n    if defect == \"empty_inventory\":\n        registry.inspect_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n    else:\n        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n            report = _StubRegistry.inspect_pages(registry, pdf_path, pdf_sha256)\n            report[\"pages\"][1][\"number\"] = 3\n            return report\n\n        registry.inspect_pages = _skewed  # type: ignore[method-assign]\n\n    inspected = render.D14_INVENTORY_AND_INSPECT_UNIT_PAGES(\n        {**state, \"artifact_versions\": rendered[\"artifact_versions\"]}, context\n    )\n    inventory = inspected[\"unit_page_inventories\"][0]\n    assert inventory[\"result\"] == \"FAIL\"\n    assert inspected[\"pending_guard\"][\"value\"] == \"layout_repairable\"\n    assert R.route_page_inspection({**state, **inspected}) == \"D17_CLASSIFY_UNIT_FINDINGS\"\n\n\ndef test_the_review_packet_names_the_exact_pdf_and_every_page_once(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 7, on a real episode: the packet is the denominator M05 answers.\n\n    D15 freezes the PDF D14 measured and every inspected page exactly once, and\n    the review M05 really returned answers that page set by number *and* by hash,\n    with nothing invented and nothing dropped. This is the evidence D16 reduces,\n    so it is the last thing this node is responsible for handing N31.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    state = result[\"state\"]\n\n    packet = state[\"review_packets\"][0]\n    inventory = state[\"unit_page_inventories\"][0]\n    inspections = state[\"unit_page_inspections\"]\n\n    assert packet[\"pdf_sha256\"] == inventory[\"pdf_sha256\"]\n    assert packet[\"page_count\"] == inventory[\"page_count\"] == len(inspections)\n    assert packet[\"page_keys\"] == [record[\"key\"] for record in inspections]\n    assert len(set(packet[\"page_keys\"])) == len(packet[\"page_keys\"])\n    assert packet[\"denominator\"] == {\n        \"pages\": len(inspections),\n        \"artifacts\": len(packet[\"artifact_hashes\"]),\n        \"checks\": len(packet[\"deterministic_check_keys\"]),\n        \"sources\": len(packet[\"admitted_source_keys\"]),\n    }\n    for channel in (\"domain\", \"content\", \"visuals\"):\n        assert packet[\"artifact_hashes\"][channel] == state[\"artifact_heads\"][f\"units/U001/{channel}\"][\"hash\"]\n\n    # M05's dispatch carried that exact packet, and its answer matches it by hash.\n    dispatched = next(\n        update for node_id, update in result[\"updates\"]\n        if node_id == \"D15_FREEZE_UNIT_REVIEW_PACKET\"\n    )[\"pending_packet\"][\"packets\"]\n    assert len(dispatched) == 1\n    projected_pages = dispatched[0][\"pages\"]\n    assert [page[\"page_number\"] for page in projected_pages] == [1, 2]\n    assert [page[\"page_sha256\"] for page in projected_pages] == [\n        record[\"page_sha256\"] for record in inspections\n    ]\n\n    review_record = state[\"unit_reviews\"][0]\n    assert review_record[\"unit_pdf_sha256\"] == packet[\"pdf_sha256\"]\n    assert review_record[\"page_count\"] == packet[\"page_count\"]\n    findings = review_record[\"payload\"][\"page_findings\"]\n    assert [entry[\"page_number\"] for entry in findings] == [1, 2]\n    assert [entry[\"page_sha256\"] for entry in findings] == [\n        record[\"page_sha256\"] for record in inspections\n    ]\n\n    # And the review is a candidate, not an admission: no head moved for it.\n    assert review_record[\"pre_admission\"] is True\n    assert \"units/U001/review\" not in state[\"artifact_heads\"]\n\n\ndef test_the_committed_path_stops_at_a_declared_deferred_edge(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n\n    The whole unit path now executes and M05 returns a real independent review.\n    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n    F1). This only checks the halt is *some* declared row, not pinned to\n    today's, so it keeps proving \"no fabricated destination\" rather than just\n    \"today's specific one.\"\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n\n    state = result[\"state\"]\n    assert state.get(\"pending_failure\") is None\n    assert state.get(\"terminal\") is None\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n    # Every deterministic check the path ran passed, so the frontier is a clean\n    # handoff rather than a repair loop that happens to stop here.\n    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n    assert sorted(state[\"artifact_heads\"]) == [\n        \"units/U001/content\",\n        \"units/U001/domain\",\n        \"units/U001/visuals\",\n    ]\n\n\n@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\ndef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n    tmp_path: Path, monkeypatch, boundary: str\n) -> None:\n    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n\n    The signal is raised after `boundary` returns. The next boundary observes it,\n    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n    resume frontier — never two terminals, and never a product success. The\n    interrupt takes precedence over the guard value at every boundary, which is\n    why a signal raised after D09 still reaches the gate rather than D09's own\n    deferred destination.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path, units=1)\n    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n    trace = result[\"trace\"]\n    terminal = result[\"state\"].get(\"terminal\")\n\n    assert boundary in trace\n    assert result[\"deferred_frontier\"] is None, (\n        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n    )\n    assert terminal is not None\n    assert terminal[\"kind\"] == \"INTERRUPTED\"\n    assert terminal[\"resumable\"] is True\n    assert terminal[\"exit_code\"] == 10\n    assert terminal[\"evidence\"][\"resume_frontier\"]\n    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n\n    # Exactly one terminal, counted as terminals and not as D98 entries. An\n    # interrupt raised inside a `Send` map sends every in-flight branch to the\n    # gate, so D96 and D98 legitimately run once per branch; what must never\n    # happen is a second terminal. The extra entries refuse rather than write.\n    assert len(result[\"state\"][\"terminal_history\"]) == 1\n    written = [\n        update\n        for node_id, update in result[\"updates\"]\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n    ]\n    assert len(written) == 1\n    for node_id, update in result[\"updates\"]:\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"\n            assert \"already holds a terminal record\" in update[\"pending_failure\"][\"message\"]\n\n    # Nothing chargeable ran after the interrupt. Stated as three separate\n    # properties, because \"nothing at all ran\" is not true at a `Send` map and\n    # asserting it would be asserting a race rather than an invariant: when the\n    # signal is observed between two in-flight map branches, one branch routes to\n    # the gate while the sibling's already-decided normal edge still fires, so a\n    # deterministic node can legitimately complete alongside the gate. It cannot\n    # dispatch, though — its own guard sees the signal — and that is what prompt\n    # TEST 9's \"without repeated valid calls\" actually requires.\n    gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n    after = trace[gate:]\n    # 1. No model node runs after the gate: no valid model call is repeated.\n    assert not set(after) & MODEL_NODE_IDS\n    # 2. No attempt is even reserved after it, so nothing became chargeable.\n    assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n    for node_id, update in result[\"updates\"][gate:]:\n        assert \"attempt_counters\" not in (update or {}), node_id\n    # 3. Anything else that ran is a deterministic node that was already in\n    #    flight, and it is bounded: it may not be an admission node, so no\n    #    artifact head can advance behind the interrupt.\n    stragglers = set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"}\n    assert stragglers <= set(NODE_CATALOGUE), stragglers\n    for node_id, update in result[\"updates\"][gate:]:\n        assert \"artifact_heads\" not in (update or {}), node_id\n\n\ndef test_an_interrupt_inside_a_send_map_is_bounded_across_repeated_episodes(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The one boundary whose post-gate trace is not deterministic, pinned.\n\n    An interrupt observed between two in-flight `Send` branches is a real race:\n    across repeated runs of the *same* input, the sibling branch sometimes routes\n    to the gate and sometimes completes its own normal edge first. The matrix row\n    for this boundary would otherwise be asserting whichever outcome happened to\n    occur. Twelve episodes are run and the bound is asserted over all of them:\n    whatever the interleaving, exactly one terminal is written, no model node and\n    no attempt reservation ever follows the gate, and the only deterministic node\n    that can straggle is the sibling's own join target.\n    \"\"\"\n\n    shapes: set[tuple[str, ...]] = set()\n    for index in range(12):\n        fixture = _build_episode_fixture(tmp_path / f\"map-interrupt-{index}\")\n        result = _run_episode(\n            monkeypatch, fixture, interrupt_after=\"M01_RESEARCH_UNIT_SOURCES\"\n        )\n        trace = result[\"trace\"]\n        gate = trace.index(\"D96_GRACEFUL_INTERRUPT_GATE\")\n        after = trace[gate:]\n        shapes.add(tuple(after))\n\n        assert len(result[\"state\"][\"terminal_history\"]) == 1\n        assert result[\"state\"][\"terminal\"][\"kind\"] == \"INTERRUPTED\"\n        assert not set(after) & MODEL_NODE_IDS\n        assert \"D90_RESERVE_MODEL_ATTEMPT\" not in after\n        assert set(after) - {\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"} <= {\n            \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n        }\n\n    # The race is real and is recorded as such rather than asserted away: if a","numLines":220,"startLine":1600,"totalLines":2693}}}
