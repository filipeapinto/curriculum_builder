{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UwdmSh7eyEmSNKMNiACizs","type":"tool_result","content":"280\t    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n281\t\n282\t    return getattr(body, \"node_body\", body)\n283\t\n284\t\n285\tdef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n286\t    target = _underlying(body)\n287\t    try:\n288\t        source = inspect.getsource(target)\n289\t    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n290\t        source = \"\"\n291\t    return {\n292\t        \"node_id\": node_id,\n293\t        \"module\": getattr(target, \"__module__\", \"\"),\n294\t        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n295\t        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n296\t        \"source_lines\": len(source.splitlines()),\n297\t    }\n298\t\n299\t\n300\t# ------------------------------------------------------------ binding validation\n301\t\n302\t\n303\tdef binding_inventory() -> dict[str, Callable[..., Any]]:\n304\t    \"\"\"Every node callable N20's own skeleton/unit-path tables resolve against.\n305\t\n306\t    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n307\t    are deliberately absent from *this* function's return value even though\n308\t    they are real, wired members of the compiled production graph: several of\n309\t    N30's own tests in `test_plan26_unit_graph.py` independently recompute\n310\t    their expectation directly from this function's return value, so it stays\n311\t    exactly what it was before N31 (per N90 finding F1's own resolution --\n312\t    `full_binding_inventory()`/`unit_repair_binding_inventory()` below are the\n313\t    functions that widen it; this one never does). Use `unit_repair_binding_\n314\t    inventory()` for the actual widened set `build_curriculum_factory_graph`\n315\t    compiles against.\n316\t\n317\t    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n318\t    likewise absent from *this* function deliberately, not by oversight: D24\n319\t    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n320\t    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n321\t    already-verified tables) declare that edge deferred to N32 by name. If D24\n322\t    entered this function, `unit_graph.register_unit_path`'s *own*\n323\t    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n324\t    silently widen to include it -- correct for a production run, but it\n325\t    would falsify N30's own already-passing topology tests, which independently\n326\t    recompute their expectation from this exact function's return value.\n327\t    `register_workbook_topology` registers the workbook engine as an additive\n328\t    step over its own separate builder (N32 exercises it directly, not through\n329\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n330\t    byte-identical to what they were before N32 and the workbook branch is\n331\t    still fully real -- just not reachable from `D05` in this generation,\n332\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n333\t    \"\"\"\n334\t\n335\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n336\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n337\t        bindings[job_id] = adapter\n338\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n339\t    return bindings\n340\t\n341\t\n342\tdef unit_repair_binding_inventory() -> dict[str, Callable[..., Any]]:\n343\t    \"\"\"`binding_inventory()` plus this node's own D16-D23 unit-repair-cycle bodies.\n344\t\n345\t    The set `build_curriculum_factory_graph` actually compiles the one\n346\t    production graph against (N90 finding F1): D16-D23 become real, reachable\n347\t    members of that graph, while D24-D32 (N32's still-deferred workbook\n348\t    engine) stay absent, exactly as `binding_inventory()`'s own docstring\n349\t    documents for that pair. Kept separate from `binding_inventory()` itself\n350\t    so N30's tests, which recompute their expectation directly from that\n351\t    function's return value, stay unaffected by this widening.\n352\t    \"\"\"\n353\t\n354\t    bindings = dict(binding_inventory())\n355\t    bindings.update(acceptance.UNIT_REPAIR_NODE_BODIES)\n356\t    return bindings\n357\t\n358\t\n359\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n360\t    \"\"\"`unit_repair_binding_inventory()` plus N32's workbook engine (D24-D32).\n361\t\n362\t    The complete node set this generation's node bodies span. Kept separate\n363\t    from `binding_inventory()` itself for the reason documented there.\n364\t    \"\"\"\n365\t\n366\t    bindings = dict(unit_repair_binding_inventory())\n367\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n368\t    return bindings\n369\t\n370\t\n371\tdef _reject(code: str, node_id: str, detail: str) -> None:\n372\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n373\t\n374\t\n375\tdef validate_bindings(\n376\t    bindings: Mapping[str, Callable[..., Any]],\n377\t    *,\n378\t    required: Sequence[str],\n379\t) -> dict[str, dict[str, Any]]:\n380\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n381\t\n382\t    for node_id in required:\n383\t        if node_id not in bindings:\n384\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n385\t\n386\t    seen: dict[tuple[str, str], str] = {}\n387\t    inventory: dict[str, dict[str, Any]] = {}\n388\t    for node_id in sorted(bindings):\n389\t        body = bindings[node_id]\n390\t        if not callable(body):\n391\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n392\t        record = _binding_record(node_id, body)\n393\t        module = record[\"module\"]\n39