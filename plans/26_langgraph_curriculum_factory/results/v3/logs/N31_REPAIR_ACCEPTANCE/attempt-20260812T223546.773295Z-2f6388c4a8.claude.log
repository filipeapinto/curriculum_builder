{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017U2FcZ5MsJv9kJZdd5aP98","type":"tool_result","content":"1\t\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n2\t\n3\tThis module owns registration, not node bodies. Every callable it registers is\n4\tresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\n5\tthat is missing, placeholder, test-only, duplicated, or dangling fails the build\n6\tby stable ID rather than compiling into a graph that would look complete.\n7\t\n8\tIt also owns the two things no node body can own:\n9\t\n10\t- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n11\t  records a graceful interrupt observed at the node's atomic boundary, and turns\n12\t  an unexpected exception into a classified `pending_failure` instead of letting\n13\t  an unproven state continue;\n14\t- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n15\t  guard, evidence writer, transport registry, source retriever, signal token and\n16\t  clock, and holds no model client and no routing authority.\n17\t\n18\tScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\n19\tpath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n20\t`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\n21\tmap/reduce, and the workbook branch are registered by N30 and N32 into this same\n22\tbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\n23\tbut not yet wired, so an undeclared unwired node still fails compilation.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport inspect\n30\timport json\n31\timport re\n32\tfrom collections.abc import Callable, Mapping, Sequence\n33\tfrom datetime import datetime, timezone\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom langgraph.errors import GraphBubbleUp\n38\tfrom langgraph.graph import END, START, StateGraph\n39\tfrom langgraph.graph.state import CompiledStateGraph\n40\tfrom langgraph.runtime import Runtime\n41\t\n42\tfrom . import acceptance, routing, transport as tp, unit_graph, workbook\n43\tfrom .artifacts import ArtifactStore\n44\tfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\n45\tfrom .evidence import EvidenceStore\n46\tfrom .model_nodes import (\n47\t    MODEL_BOOKKEEPING_NODES,\n48\t    MODEL_NODE_ADAPTERS,\n49\t    build_model_node_context,\n50\t)\n51\tfrom .nodes import NODE_CATALOGUE, node_registry\n52\tfrom .persistence import InterruptToken, open_checkpoint_saver\n53\tfrom .state import (\n54\t    FACTORY_INPUT_FIELDS,\n55\t    FACTORY_OUTPUT_FIELDS,\n56\t    FACTORY_STATE_FIELDS,\n57\t    FIELD_REDUCER_CLASSES,\n58\t    FactoryInput,\n59\t    FactoryOutput,\n60\t    FactoryState,\n61\t    RuntimeContext,\n62\t)\n63\t\n64\t__all__ = [\n65\t    \"GRAPH_NAME\",\n66\t    \"GraphBindingError\",\n67\t    \"DEFERRED_TOPOLOGY\",\n68\t    \"SKELETON_NORMAL_EDGES\",\n69\t    \"SKELETON_BRANCHES\",\n70\t    \"build_runtime_context\",\n71\t    \"binding_inventory\",\n72\t    \"unit_repair_binding_inventory\",\n73\t    \"full_binding_inventory\",\n74\t    \"validate_bindings\",\n75\t    \"register_skeleton\",\n76\t    \"register_unit_repair_topology\",\n77\t    \"register_workbook_topology\",\n78\t    \"build_curriculum_factory_graph\",\n79\t    \"compiled_topology\",\n80\t    \"graph_digest\",\n81\t    \"contract_digests\",\n82\t]\n83\t\n84\tGRAPH_NAME = \"plan26_curriculum_factory\"\n85\t\n86\t\n87\tclass GraphBindingError(RuntimeError):\n88\t    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n89\t\n90\t\n91\t# Only these modules may supply a production node body. A callable from anywhere\n92\t# else — a test module, a notebook, a locally defined lambda — is rejected by\n93\t# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n94\t# a stand-in\".\n95\tPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n96\t    \"runtime.langgraph_factory.nodes\",\n97\t    \"runtime.langgraph_factory.model_nodes\",\n98\t    \"runtime.langgraph_factory.workbook\",\n99\t    \"runtime.langgraph_factory.repair\",\n100\t    \"runtime.langgraph_factory.acceptance\",\n101\t)\n102\t\n103\tPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n104\t    \"stub\",\n105\t    \"placeholder\",\n106\t    \"fake\",\n107\t    \"dummy\",\n108\t    \"mock\",\n109\t    \"sample\",\n110\t    \"example\",\n111\t    \"todo\",\n112\t    \"noop\",\n113\t    \"test\",\n114\t)\n115\t\n116\tPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n117\t    \"raise NotImplementedError\",\n118\t    \"TODO: implement\",\n119\t    \"placeholder implementation\",\n120\t)\n121\t\n122\t# Registered here, wired by a later graph node. A node that is neither wired by\n123\t# the skeleton/unit-path tables `_validate_topology` inspects nor declared here\n124\t# fails the build: silence about an unwired node is how a topology gap becomes\n125\t# a silent halt at runtime.\n126\t#\n127\t# D16 and D17 need no row: once their bodies are members of `available`, they\n128\t# are reached as real *destinations* of already-wired `unit_graph.UNIT_BRANCHES`\n129\t# sources (D08/D09/D12/D14/D91 -> D17, M05 -> D16 -- the six rows `unit_graph\n130\t# .DEFERRED_EDGES` names), so `_validate_topology`'s own `wired` set already\n131\t# contains them. D18-D23 are reached only from *inside* the unit repair cycle\n132\t# itself (D17 -> D18 -> ... -> D21 -> D16, D22 -> D23 -> D05), which is wired by\n133\t# `acceptance.register_unit_repair_path` (via `register_unit_repair_topology`,\n134\t# called after `register_skeleton` returns) rather than by any table\n135\t# `_validate_topology` reads -- so they are declared deferred here for the same\n136\t# reason M06/M07/M08 are: really wired, by a registration step this function\n137\t# does not itself see.\n138\tDEFERRED_TOPOLOGY: Mapping[str, str] = {\n139\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n140\t    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n141\t    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n142\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n143\t    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n144\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n145\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n146\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n147\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n148\t}\n149\t\n150\tSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = ("}]},"parent_tool_use_id":null,"session_id":"26dfa18f-1429-469e-a387-81d08233be39","uuid":"06b7575b-62ce-45c1-9f9e-6bd47ac9a76d","timestamp":"2026-08-12T22:39:30.227Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/graph.py","content":"\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n\nThis module owns registration, not node bodies. Every callable it registers is\nresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\nthat is missing, placeholder, test-only, duplicated, or dangling fails the build\nby stable ID rather than compiling into a graph that would look complete.\n\nIt also owns the two things no node body can own:\n\n- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n  records a graceful interrupt observed at the node's atomic boundary, and turns\n  an unexpected exception into a classified `pending_failure` instead of letting\n  an unproven state continue;\n- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n  guard, evidence writer, transport registry, source retriever, signal token and\n  clock, and holds no model client and no routing authority.\n\nScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\npath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\nmap/reduce, and the workbook branch are registered by N30 and N32 into this same\nbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\nbut not yet wired, so an undeclared unwired node still fails compilation.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport inspect\nimport json\nimport re\nfrom collections.abc import Callable, Mapping, Sequence\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom langgraph.errors import GraphBubbleUp\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.graph.state import CompiledStateGraph\nfrom langgraph.runtime import Runtime\n\nfrom . import acceptance, routing, transport as tp, unit_graph, workbook\nfrom .artifacts import ArtifactStore\nfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\nfrom .evidence import EvidenceStore\nfrom .model_nodes import (\n    MODEL_BOOKKEEPING_NODES,\n    MODEL_NODE_ADAPTERS,\n    build_model_node_context,\n)\nfrom .nodes import NODE_CATALOGUE, node_registry\nfrom .persistence import InterruptToken, open_checkpoint_saver\nfrom .state import (\n    FACTORY_INPUT_FIELDS,\n    FACTORY_OUTPUT_FIELDS,\n    FACTORY_STATE_FIELDS,\n    FIELD_REDUCER_CLASSES,\n    FactoryInput,\n    FactoryOutput,\n    FactoryState,\n    RuntimeContext,\n)\n\n__all__ = [\n    \"GRAPH_NAME\",\n    \"GraphBindingError\",\n    \"DEFERRED_TOPOLOGY\",\n    \"SKELETON_NORMAL_EDGES\",\n    \"SKELETON_BRANCHES\",\n    \"build_runtime_context\",\n    \"binding_inventory\",\n    \"unit_repair_binding_inventory\",\n    \"full_binding_inventory\",\n    \"validate_bindings\",\n    \"register_skeleton\",\n    \"register_unit_repair_topology\",\n    \"register_workbook_topology\",\n    \"build_curriculum_factory_graph\",\n    \"compiled_topology\",\n    \"graph_digest\",\n    \"contract_digests\",\n]\n\nGRAPH_NAME = \"plan26_curriculum_factory\"\n\n\nclass GraphBindingError(RuntimeError):\n    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n\n\n# Only these modules may supply a production node body. A callable from anywhere\n# else — a test module, a notebook, a locally defined lambda — is rejected by\n# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n# a stand-in\".\nPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n    \"runtime.langgraph_factory.nodes\",\n    \"runtime.langgraph_factory.model_nodes\",\n    \"runtime.langgraph_factory.workbook\",\n    \"runtime.langgraph_factory.repair\",\n    \"runtime.langgraph_factory.acceptance\",\n)\n\nPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n    \"stub\",\n    \"placeholder\",\n    \"fake\",\n    \"dummy\",\n    \"mock\",\n    \"sample\",\n    \"example\",\n    \"todo\",\n    \"noop\",\n    \"test\",\n)\n\nPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n    \"raise NotImplementedError\",\n    \"TODO: implement\",\n    \"placeholder implementation\",\n)\n\n# Registered here, wired by a later graph node. A node that is neither wired by\n# the skeleton/unit-path tables `_validate_topology` inspects nor declared here\n# fails the build: silence about an unwired node is how a topology gap becomes\n# a silent halt at runtime.\n#\n# D16 and D17 need no row: once their bodies are members of `available`, they\n# are reached as real *destinations* of already-wired `unit_graph.UNIT_BRANCHES`\n# sources (D08/D09/D12/D14/D91 -> D17, M05 -> D16 -- the six rows `unit_graph\n# .DEFERRED_EDGES` names), so `_validate_topology`'s own `wired` set already\n# contains them. D18-D23 are reached only from *inside* the unit repair cycle\n# itself (D17 -> D18 -> ... -> D21 -> D16, D22 -> D23 -> D05), which is wired by\n# `acceptance.register_unit_repair_path` (via `register_unit_repair_topology`,\n# called after `register_skeleton` returns) rather than by any table\n# `_validate_topology` reads -- so they are declared deferred here for the same\n# reason M06/M07/M08 are: really wired, by a registration step this function\n# does not itself see.\nDEFERRED_TOPOLOGY: Mapping[str, str] = {\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n}\n\nSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (","numLines":150,"startLine":1,"totalLines":643}}}
