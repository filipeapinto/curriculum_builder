{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K232zzQd1GbY9LuGZmfCaw","type":"tool_result","content":"1841\tdef test_the_unobservable_boundary_is_excluded_for_a_stated_reason(\n1842\t    tmp_path: Path, monkeypatch\n1843\t) -> None:\n1844\t    \"\"\"M05's own update is observable now that N31 has wired D16-D23.\n1845\t\n1846\t    Before N31 wired D16-D23 (P-N31-001), M05 really executed: the committed\n1847\t    state held its execution receipt, its candidate record and its page\n1848\t    findings, but the branch that would emit its update resolved to the\n1849\t    deferred `D16_REDUCE_UNIT_EVIDENCE` and aborted the superstep, so no\n1850\t    stream consumer ever saw it. `D16_REDUCE_UNIT_EVIDENCE` is now a real,\n1851\t    wired node body, so that premise has inverted exactly as this test's own\n1852\t    docstring anticipated it would (see `results/N30_UNIT_GRAPH.result.v1\n1853\t    .md`): M05's update reaches the stream like every other boundary's does,\n1854\t    and this test now proves that inversion directly instead of asserting\n1855\t    the retired exclusion.\n1856\t\n1857\t    `REACHABLE_BOUNDARIES`/`UNOBSERVABLE_BOUNDARY` are left untouched here:\n1858\t    other tests (`test_a_graceful_interrupt_at_every_reachable_boundary_\n1859\t    writes_one_terminal` included) still rely on their current values, and\n1860\t    P-N31-003 scopes this fix to this one test function, so this test's own\n1861\t    matrix-membership assertions are dropped rather than widened onto those\n1862\t    shared constants.\n1863\t    \"\"\"\n1864\t\n1865\t    fixture = _build_episode_fixture(tmp_path)\n1866\t    result = _run_episode(monkeypatch, fixture)\n1867\t    state = result[\"state\"]\n1868\t\n1869\t    assert UNOBSERVABLE_BOUNDARY in result[\"trace\"]\n1870\t    m05_update = next(\n1871\t        update for node_id, update in result[\"updates\"] if node_id == UNOBSERVABLE_BOUNDARY\n1872\t    )\n1873\t    assert m05_update, \"M05's own update must be a real, non-empty stream chunk now\"\n1874\t\n1875\t    # It ran, and its receipt, candidate and review are all committed, exactly\n1876\t    # as before this inversion.\n1877\t    assert [\n1878\t        receipt[\"job_id\"] for receipt in state[\"model_execution_receipts\"]\n1879\t    ].count(UNOBSERVABLE_BOUNDARY) == 1\n1880\t    review_record = state[\"unit_reviews\"][0]\n1881\t    assert review_record[\"job_id\"] == UNOBSERVABLE_BOUNDARY\n1882\t    assert review_record[\"pre_admission\"] is True\n1883\t\n1884\t\n1885\tdef test_a_hard_crash_is_recovered_as_an_orphan_without_continuing_its_thread(\n1886\t    tmp_path: Path, monkeypatch\n1887\t) -> None:\n1888\t    \"\"\"Prompt TEST 9's SIGKILL half: the orphan thread is read, never resumed.\"\"\"\n1889\t\n1890\t    fixture = _build_episode_fixture(tmp_path)\n1891\t    lock, invocation, envelope = _prepare_episode(fixture)\n1892\t    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n1893\t    monkeypatch.setattr(\n1894\t        G,\n1895\t        \"build_model_node_context\",\n1896\t        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n1897\t    )\n1898\t    compiled = G.build_curriculum_factory_graph(\n1899\t        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n1900\t    )\n1901\t\n1902\t    # Simulate the power loss: stop consuming the stream mid-episode and never\n1903\t    # let D98 run, leaving the episode lease open.\n1904\t    executed: list[str] = []\n1905\t    stream = compiled.stream(\n1906\t        {\"invocation\": envelope},\n1907\t        config=invocation.config,\n1908\t        stream_mode=\"updates\",\n1909\t        context=context,\n1910\t    )"}]},"parent_tool_use_id":null,"session_id":"26dfa18f-1429-469e-a387-81d08233be39","uuid":"687df330-ba38-49a1-93c5-93f38d522ec6","timestamp":"2026-08-12T22:36:40.087Z","tool_use_result":{"type":"text","file":{"filePath":"tests/runtime/test_plan26_unit_graph.py","content":"def test_the_unobservable_boundary_is_excluded_for_a_stated_reason(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"M05's own update is observable now that N31 has wired D16-D23.\n\n    Before N31 wired D16-D23 (P-N31-001), M05 really executed: the committed\n    state held its execution receipt, its candidate record and its page\n    findings, but the branch that would emit its update resolved to the\n    deferred `D16_REDUCE_UNIT_EVIDENCE` and aborted the superstep, so no\n    stream consumer ever saw it. `D16_REDUCE_UNIT_EVIDENCE` is now a real,\n    wired node body, so that premise has inverted exactly as this test's own\n    docstring anticipated it would (see `results/N30_UNIT_GRAPH.result.v1\n    .md`): M05's update reaches the stream like every other boundary's does,\n    and this test now proves that inversion directly instead of asserting\n    the retired exclusion.\n\n    `REACHABLE_BOUNDARIES`/`UNOBSERVABLE_BOUNDARY` are left untouched here:\n    other tests (`test_a_graceful_interrupt_at_every_reachable_boundary_\n    writes_one_terminal` included) still rely on their current values, and\n    P-N31-003 scopes this fix to this one test function, so this test's own\n    matrix-membership assertions are dropped rather than widened onto those\n    shared constants.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    state = result[\"state\"]\n\n    assert UNOBSERVABLE_BOUNDARY in result[\"trace\"]\n    m05_update = next(\n        update for node_id, update in result[\"updates\"] if node_id == UNOBSERVABLE_BOUNDARY\n    )\n    assert m05_update, \"M05's own update must be a real, non-empty stream chunk now\"\n\n    # It ran, and its receipt, candidate and review are all committed, exactly\n    # as before this inversion.\n    assert [\n        receipt[\"job_id\"] for receipt in state[\"model_execution_receipts\"]\n    ].count(UNOBSERVABLE_BOUNDARY) == 1\n    review_record = state[\"unit_reviews\"][0]\n    assert review_record[\"job_id\"] == UNOBSERVABLE_BOUNDARY\n    assert review_record[\"pre_admission\"] is True\n\n\ndef test_a_hard_crash_is_recovered_as_an_orphan_without_continuing_its_thread(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 9's SIGKILL half: the orphan thread is read, never resumed.\"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    lock, invocation, envelope = _prepare_episode(fixture)\n    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    monkeypatch.setattr(\n        G,\n        \"build_model_node_context\",\n        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n    )\n    compiled = G.build_curriculum_factory_graph(\n        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n    )\n\n    # Simulate the power loss: stop consuming the stream mid-episode and never\n    # let D98 run, leaving the episode lease open.\n    executed: list[str] = []\n    stream = compiled.stream(\n        {\"invocation\": envelope},\n        config=invocation.config,\n        stream_mode=\"updates\",\n        context=context,\n    )","numLines":70,"startLine":1841,"totalLines":2705}}}
