{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EpMDortejrGZiAEtoWNjqX","type":"tool_result","content":"1288\tdef test_a_fresh_episode_executes_the_bootstrap_spine_once_through_langgraph(\n1289\t    tmp_path: Path, monkeypatch\n1290\t) -> None:\n1291\t    \"\"\"Prompt TEST 1: the fresh path really runs, and D01 runs exactly once.\n1292\t\n1293\t    `selected_unit_id` is asserted off `D05_SELECT_NEXT_UNIT`'s own first\n1294\t    update, not the run's final merged state: once N31 wires D16-D23 this\n1295\t    clean single-unit episode legitimately loops back to a second `D05`\n1296\t    call, whose `manifest_exhausted` guard correctly overwrites the\n1297\t    `replace_current`-reduced `selected_unit_id` to `None` in final state —\n1298\t    a real second call, not a repeat of the first one, so it is asserted for\n1299\t    rather than assumed away (P-N30-001, closing N90 finding F1).\n1300\t\n1301\t    With D16-D23 now wired (P-N31-001), this clean one-unit episode really\n1302\t    reaches acceptance: the second `D05_SELECT_NEXT_UNIT` call finds the\n1303\t    manifest exhausted and routes to the still-deferred `D24_PROVE_EXACT_\n1304\t    MANIFEST_COVERAGE`, whose `KeyError` is raised in the same tick as that\n1305\t    second `D05` call's own routing decision -- a real, reproducible LangGraph\n1306\t    `stream(stream_mode=\"updates\")` artifact: the chunk for a step whose\n1307\t    *next* step's routing raises in the same tick is never yielded, so\n1308\t    `result[\"trace\"]`'s own `D05_SELECT_NEXT_UNIT` count undercounts by\n1309\t    exactly one in this exhausted-after-one-unit case (P-N31-003, closing the\n1310\t    residual N90 finding F1 diagnosis). The real, checkpointed final state is\n1311\t    unaffected by that streaming artifact, so it is asserted directly instead\n1312\t    of inferring the outcome from a trace count this specific interaction\n1313\t    cannot reliably produce.\n1314\t    \"\"\"\n1315\t\n1316\t    fixture = _build_episode_fixture(tmp_path)\n1317\t    result = _run_episode(monkeypatch, fixture)\n1318\t\n1319\t    assert result[\"trace\"][: len(BOOTSTRAP_SPINE)] == list(BOOTSTRAP_SPINE)\n1320\t    assert result[\"trace\"].count(\"D01_VALIDATE_AND_FREEZE_INPUTS\") == 1\n1321\t    assert \"D00R_REVALIDATE_RESUME_IDENTITY\" not in result[\"trace\"]\n1322\t    assert \"D92_REENTER_VALIDATED_FRONTIER\" not in result[\"trace\"]\n1323\t\n1324\t    state = result[\"state\"]\n1325\t    assert state[\"bootstrap_kind\"] == \"fresh\"\n1326\t    assert state[\"run_id\"]\n1327\t    assert state[\"mode\"] == \"one\"\n1328\t    assert state[\"effective_run\"][\"target_closure\"] == [\"U001\"]\n1329\t\n1330\t    first_selection = next(\n1331\t        update for node_id, update in result[\"updates\"] if node_id == \"D05_SELECT_NEXT_UNIT\"\n1332\t    )\n1333\t    assert first_selection[\"selected_unit_id\"] == \"U001\"\n1334\t    d05_calls = result[\"trace\"].count(\"D05_SELECT_NEXT_UNIT\")\n1335\t    assert d05_calls in (1, 2)\n1336\t    # The real, checkpointed outcome of a clean single-unit episode: the one\n1337\t    # unit is accepted and the cursor advances, whether or not the second D05\n1338\t    # call's own chunk made it into the stream.\n1339\t    assert state[\"selected_unit_id\"] is None\n1340\t    assert state[\"cursor\"][\"accepted_ordinal\"] == 1\n1341\t    assert \"U001\" in (state.get(\"accepted_unit_receipts\") or {})\n1342\t    # No product success, and no second terminal, however the episode ends.\n1343\t    assert result[\"trace\"].count(\"D98_WRITE_TERMINAL\") <= 1\n1344\t    if state.get(\"terminal\") is not None:\n1345\t        assert state[\"terminal\"][\"kind\"] not in (\"UNIT_ACCEPTED\", \"COMPLETE\")\n1346\t\n1347\t\n1348\tdef test_the_source_map_reduce_supersteps_execute_as_real_send_fanouts(\n1349\t    tmp_path: Path, monkeypatch\n1350\t) -> None:\n1351\t    \"\"\"Both M01 supersteps run as `Send` maps, join at their barriers, and admit.\n1352\t\n1353\t    With B-6 and B-7 closed this is a real reduction, not a trace of a refusal:\n1354\t    each map reserves through D90 first, runs two real M01 workers in one\n1355\t    superstep, and D07's exact join admits both sources.\n1356\t    \"\"\"\n1357\t\n1358\t    fixture = _build_episode_fixture(tmp_path)\n1359\t    result = _run_episode(monkeypatch, fixture)\n1360\t    trace = result[\"trace\"]\n1361\t\n1362\t    # Two `Send` maps of two members each: four M01 activations, no more.\n1363\t    assert trace.count(\"M01_RESEARCH_UNIT_SOURCES\") == 4\n1364\t    # Each map is preceded by its reservation, and each superstep is contiguous.\n1365\t    first = trace.index(\"M01_RESEARCH_UNIT_SOURCES\")\n1366\t    assert trace[first - 1] == \"D90_RESERVE_MODEL_ATTEMPT\"\n1367\t    assert trace[first : first + 2] == [\"M01_RESEARCH_UNIT_SOURCES\"] * 2"}]},"parent_tool_use_id":null,"session_id":"26dfa18f-1429-469e-a387-81d08233be39","uuid":"1567a096-aeaa-498e-b4b7-8f94b01db6c3","timestamp":"2026-08-12T22:36:37.044Z","tool_use_result":{"type":"text","file":{"filePath":"tests/runtime/test_plan26_unit_graph.py","content":"def test_a_fresh_episode_executes_the_bootstrap_spine_once_through_langgraph(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 1: the fresh path really runs, and D01 runs exactly once.\n\n    `selected_unit_id` is asserted off `D05_SELECT_NEXT_UNIT`'s own first\n    update, not the run's final merged state: once N31 wires D16-D23 this\n    clean single-unit episode legitimately loops back to a second `D05`\n    call, whose `manifest_exhausted` guard correctly overwrites the\n    `replace_current`-reduced `selected_unit_id` to `None` in final state —\n    a real second call, not a repeat of the first one, so it is asserted for\n    rather than assumed away (P-N30-001, closing N90 finding F1).\n\n    With D16-D23 now wired (P-N31-001), this clean one-unit episode really\n    reaches acceptance: the second `D05_SELECT_NEXT_UNIT` call finds the\n    manifest exhausted and routes to the still-deferred `D24_PROVE_EXACT_\n    MANIFEST_COVERAGE`, whose `KeyError` is raised in the same tick as that\n    second `D05` call's own routing decision -- a real, reproducible LangGraph\n    `stream(stream_mode=\"updates\")` artifact: the chunk for a step whose\n    *next* step's routing raises in the same tick is never yielded, so\n    `result[\"trace\"]`'s own `D05_SELECT_NEXT_UNIT` count undercounts by\n    exactly one in this exhausted-after-one-unit case (P-N31-003, closing the\n    residual N90 finding F1 diagnosis). The real, checkpointed final state is\n    unaffected by that streaming artifact, so it is asserted directly instead\n    of inferring the outcome from a trace count this specific interaction\n    cannot reliably produce.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    assert result[\"trace\"][: len(BOOTSTRAP_SPINE)] == list(BOOTSTRAP_SPINE)\n    assert result[\"trace\"].count(\"D01_VALIDATE_AND_FREEZE_INPUTS\") == 1\n    assert \"D00R_REVALIDATE_RESUME_IDENTITY\" not in result[\"trace\"]\n    assert \"D92_REENTER_VALIDATED_FRONTIER\" not in result[\"trace\"]\n\n    state = result[\"state\"]\n    assert state[\"bootstrap_kind\"] == \"fresh\"\n    assert state[\"run_id\"]\n    assert state[\"mode\"] == \"one\"\n    assert state[\"effective_run\"][\"target_closure\"] == [\"U001\"]\n\n    first_selection = next(\n        update for node_id, update in result[\"updates\"] if node_id == \"D05_SELECT_NEXT_UNIT\"\n    )\n    assert first_selection[\"selected_unit_id\"] == \"U001\"\n    d05_calls = result[\"trace\"].count(\"D05_SELECT_NEXT_UNIT\")\n    assert d05_calls in (1, 2)\n    # The real, checkpointed outcome of a clean single-unit episode: the one\n    # unit is accepted and the cursor advances, whether or not the second D05\n    # call's own chunk made it into the stream.\n    assert state[\"selected_unit_id\"] is None\n    assert state[\"cursor\"][\"accepted_ordinal\"] == 1\n    assert \"U001\" in (state.get(\"accepted_unit_receipts\") or {})\n    # No product success, and no second terminal, however the episode ends.\n    assert result[\"trace\"].count(\"D98_WRITE_TERMINAL\") <= 1\n    if state.get(\"terminal\") is not None:\n        assert state[\"terminal\"][\"kind\"] not in (\"UNIT_ACCEPTED\", \"COMPLETE\")\n\n\ndef test_the_source_map_reduce_supersteps_execute_as_real_send_fanouts(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Both M01 supersteps run as `Send` maps, join at their barriers, and admit.\n\n    With B-6 and B-7 closed this is a real reduction, not a trace of a refusal:\n    each map reserves through D90 first, runs two real M01 workers in one\n    superstep, and D07's exact join admits both sources.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    trace = result[\"trace\"]\n\n    # Two `Send` maps of two members each: four M01 activations, no more.\n    assert trace.count(\"M01_RESEARCH_UNIT_SOURCES\") == 4\n    # Each map is preceded by its reservation, and each superstep is contiguous.\n    first = trace.index(\"M01_RESEARCH_UNIT_SOURCES\")\n    assert trace[first - 1] == \"D90_RESERVE_MODEL_ATTEMPT\"\n    assert trace[first : first + 2] == [\"M01_RESEARCH_UNIT_SOURCES\"] * 2","numLines":80,"startLine":1288,"totalLines":2705}}}
