{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LM7m1R32ZQLkbXvzNJuZLY","type":"tool_result","content":"760\t    # A crash right after D98 returns but before its write lands: re-deriving the\n761\t    # same projection and revalidating produces the byte-identical record.\n762\t    record_b = terminal.write_terminal(projection, None)\n763\t    assert record_a[\"terminal\"] == record_b[\"terminal\"]\n764\t\n765\t\n766\t# ==========================================================================\n767\t# P-N31-001 required proof: D16-D23 are real, wired members of the one\n768\t# production compiled graph (`graph.build_curriculum_factory_graph`), not\n769\t# merely function-level tested. Every assertion below runs the real compiled\n770\t# graph (`compiled.get_graph()`, `compiled.stream()`/`invoke()`), never a\n771\t# declared table alone -- N90's own audit (finding F1) checked exactly this\n772\t# way and found D16-D23 unwired; this is what makes that finding closed.\n773\t# ==========================================================================\n774\t\n775\t\n776\tdef test_d16_through_d23_and_m06_are_members_of_the_compiled_production_graph(compiled) -> None:\n777\t    nodes = set(compiled.get_graph().nodes)\n778\t    for node_id in acceptance.UNIT_REPAIR_TOPOLOGY_SOURCES:\n779\t        assert node_id in nodes, node_id\n780\t\n781\t\n782\tdef test_binding_inventory_return_value_is_unchanged_by_this_nodes_wiring() -> None:\n783\t    \"\"\"N30's own tests recompute their expectation directly from `binding_\n784\t    inventory()`'s return value; P-N31-001 requires that value stay provably\n785\t    unchanged even though `build_curriculum_factory_graph` now compiles\n786\t    against the wider `unit_repair_binding_inventory()`.\"\"\"\n787\t\n788\t    narrow = set(G.binding_inventory())\n789\t    assert narrow.isdisjoint(acceptance.UNIT_REPAIR_NODE_BODIES)\n790\t    widened = set(G.unit_repair_binding_inventory())\n791\t    assert widened == narrow | set(acceptance.UNIT_REPAIR_NODE_BODIES)\n792\t\n793\t\n794\tdef test_the_six_n31_owned_deferred_edges_are_now_real_wired_edges(compiled) -> None:\n795\t    \"\"\"Every `unit_graph.DEFERRED_EDGES` row N31 owns is a real compiled edge.\n796\t\n797\t    Not merely absent from a \"still deferred\" set (the way N30's own frozen\n798\t    tests check the *other* rows stay deferred): each row here must appear as\n799\t    an actual conditional edge of the real compiled graph.\n800\t    \"\"\"\n801\t\n802\t    owned = [row for row in U.DEFERRED_EDGES if row[3] == \"N31_REPAIR_ACCEPTANCE\"]\n803\t    assert len(owned) == 6\n804\t\n805\t    edges = {(source, target) for source, target, _conditional in G.compiled_topology(compiled)[\"edges\"]}\n806\t    for source, _value, destination, _owner in owned:\n807\t        assert (source, destination) in edges, (source, destination)\n808\t\n809\t\n810\tdef test_widening_the_bindings_raises_no_topology_or_binding_error(tmp_path) -> None:\n811\t    \"\"\"`validate_bindings`'s placeholder/duplicate/uncallable checks and\n812\t    `register_unit_path`'s N30-EDGE-* checks all pass for D16-D23 exactly as\n813\t    they already do for the pre-existing skeleton -- proven by actually\n814\t    compiling, not by re-reading source.\"\"\"\n815\t\n816\t    output_root = tmp_path / \"widen-check\"\n817\t    output_root.mkdir()\n818\t    compiled = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n819\t    assert \"D16_REDUCE_UNIT_EVIDENCE\" in set(compiled.get_graph().nodes)\n820\t\n821\t\n822\tdef test_a_clean_one_unit_episode_reaches_d22_accept_unit_via_the_d16_pass_fast_path(\n823\t    tmp_path, monkeypatch\n824\t) -> None:\n825\t    \"\"\"A real run of the real compiled graph: D16 passes on its first call (no\n826\t    repair), and D22/D23 really mint and checkpoint the accepted receipt.\"\"\"\n827\t\n828\t    fixture = UG._build_episode_fixture(tmp_path)\n829\t    result = UG._run_episode(monkeypatch, fixture)\n830\t\n831\t    assert \"D16_REDUCE_UNIT_EVIDENCE\" in result[\"trace\"]\n832\t    assert \"D17_CLASSIFY_UNIT_FINDINGS\" not in result[\"trace\"]\n833\t    assert \"D22_ACCEPT_UNIT\" in result[\"trace\"]\n834\t    assert \"D23_CHECKPOINT_ACCEPTED_UNIT\" in result[\"trace\"]\n835\t\n836\t    state = result[\"state\"]\n837\t    receipt = (state.get(\"accepted_unit_receipts\") or {}).get(\"U001\")\n838\t    assert receipt is not None and receipt[\"receipt_hash\"]\n839\t    assert state[\"cursor\"][\"accepted_ordinal\"] == 1\n840\t\n841\t\n842\tdef test_a_full_d17_through_d21_repair_and_retest_loop_reaches_d22_accept_unit(\n843\t    tmp_path, monkeypatch\n844\t) -> None:\n845\t    \"\"\"A real run of the real compiled graph exercising the other half of D16:\n846\t    a deterministic-repair-owned (`unit layout`) finding really traverses\n847\t    D17 -> D18 -> D19 -> D20 -> D21 -> the real retest chain back to D16,\n848\t    which then passes and really reaches D22/D23.\n849\t\n850\t    The unit's real D14 page inspection finds nothing to repair on its own\n851\t    (the test double renders/inspects deterministically and cleanly), so this\n852\t    seeds a `layout_repairable` finding onto the checkpoint right after D14's\n853\t    own real, clean pass -- the standard \"stop the stream, `update_state`,\n854\t    resume\" technique this file's sibling `test_plan26_unit_graph.py` already\n855\t    uses for crash recovery (`test_a_hard_crash_is_recovered_as_an_orphan_\n856\t    without_continuing_its_thread`). Everything downstream of that seed is\n857\t    then real, unmodified D17-D21/D13-D16/D22/D23 execution over the one real\n858\t    compiled graph: the finding is classified for real, D19 dispatches the\n859\t    real deterministic route (`unit layout` is `repair.DETERMINISTIC_ONLY_\n860\t    OWNERS`), D20 really admits a boundary-checked child, D21 really\n861\t    dispatches `D13_RENDER_UNIT` (the retest chain's first node), and the\n862\t    real (deterministic, idempotent) test-double renderer/inspector really\n863\t    re-runs and passes again, closing the loop back to a real, passing D16.\n864\t    \"\"\"\n865\t\n866\t    fixture = UG._build_episode_fixture(tmp_path)\n867\t    lock, invocation, envelope = UG._prepare_episode(fixture)\n868\t    context = UG._HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n869\t    monkeypatch.setattr(\n870\t        G,\n871\t        \"build_model_node_context\",\n872\t        lambda _context, **_kwargs: UG._scripted_model_context(fixture[\"sandbox\"]),\n873\t    )\n874\t    compiled = G.build_curriculum_factory_graph(\n875\t        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n876\t    )\n877\t\n878\t    trace: list[str] = []\n879\t    stream = compiled.stream(\n880\t        {\"invocation\": envelope}, config=invocation.config, stream_mode=\"updates\", context=context\n881\t    )\n882\t    for chunk in stream:\n883\t        trace.extend(chunk)\n884\t        if \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\" in chunk:\n885\t            break\n886\t    stream.close()\n887\t\n888\t    before = compiled.get_state(invocation.config).values\n889\t    assert before[\"pending_guard\"][\"node\"] == \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\"\n890\t    assert before[\"pending_guard\"][\"value\"] == \"pages_inspected\", (\n891\t        \"the real page inspection must have really passed cleanly, so the \"\n892\t        \"repair loop below is proven to start from a seeded finding, not a \"\n893\t        \"real product defect this fixture happens to have\"\n894\t    )\n895\t\n896\t    seeded_finding = {\n897\t        \"owner\": \"unit layout\",\n898\t        \"pointer\": \"/repair_probe\",\n899\t        \"check_id\": \"unit_page_inventory\",\n900\t        \"message\": \"N31 required-proof seed: synthetic layout defect\",\n901\t        \"allowed_facts\": {\"/repair_probe\": \"synthetic-repair-note\"},\n902\t    }\n903\t    compiled.update_state(\n904\t        invocation.config,\n905\t        {\n906\t            \"pending_guard\": {\n907\t                \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n908\t                \"value\": \"layout_repairable\",\n909\t                \"detail\": {\"unit_id\": \"U001\", \"findings\": [seeded_finding]},\n910\t            }\n911\t        },\n912\t    )\n913\t\n914\t    resumed_trace: list[str] = []\n915\t    resumed = compiled.stream(None, config=invocation.config, stream_mode=\"updates\", context=context)\n916\t    try:\n917\t        for chunk in resumed:\n918\t            resumed_trace.extend(chunk)\n919\t    except KeyError as error:\n920\t        missing = error.args[0] if error.args else None\n921\t        declared = {row[2] for row in U.DEFERRED_EDGES}\n922\t        if missing not in declared:\n923\t            raise\n924\t    lock.release()\n925\t\n926\t    # The real repair/retest loop this generation owns, traversed in order.\n927\t    loop = (\n928\t        \"D17_CLASSIFY_UNIT_FINDINGS\",\n929\t        \"D18_PLAN_TARGETED_UNIT_REPAIR\","}]},"parent_tool_use_id":null,"session_id":"26dfa18f-1429-469e-a387-81d08233be39","uuid":"ae7bfd87-8f97-4d35-b8cf-162f6319421b","timestamp":"2026-08-12T22:41:14.654Z","tool_use_result":{"type":"text","file":{"filePath":"tests/runtime/test_plan26_repair_acceptance.py","content":"    # A crash right after D98 returns but before its write lands: re-deriving the\n    # same projection and revalidating produces the byte-identical record.\n    record_b = terminal.write_terminal(projection, None)\n    assert record_a[\"terminal\"] == record_b[\"terminal\"]\n\n\n# ==========================================================================\n# P-N31-001 required proof: D16-D23 are real, wired members of the one\n# production compiled graph (`graph.build_curriculum_factory_graph`), not\n# merely function-level tested. Every assertion below runs the real compiled\n# graph (`compiled.get_graph()`, `compiled.stream()`/`invoke()`), never a\n# declared table alone -- N90's own audit (finding F1) checked exactly this\n# way and found D16-D23 unwired; this is what makes that finding closed.\n# ==========================================================================\n\n\ndef test_d16_through_d23_and_m06_are_members_of_the_compiled_production_graph(compiled) -> None:\n    nodes = set(compiled.get_graph().nodes)\n    for node_id in acceptance.UNIT_REPAIR_TOPOLOGY_SOURCES:\n        assert node_id in nodes, node_id\n\n\ndef test_binding_inventory_return_value_is_unchanged_by_this_nodes_wiring() -> None:\n    \"\"\"N30's own tests recompute their expectation directly from `binding_\n    inventory()`'s return value; P-N31-001 requires that value stay provably\n    unchanged even though `build_curriculum_factory_graph` now compiles\n    against the wider `unit_repair_binding_inventory()`.\"\"\"\n\n    narrow = set(G.binding_inventory())\n    assert narrow.isdisjoint(acceptance.UNIT_REPAIR_NODE_BODIES)\n    widened = set(G.unit_repair_binding_inventory())\n    assert widened == narrow | set(acceptance.UNIT_REPAIR_NODE_BODIES)\n\n\ndef test_the_six_n31_owned_deferred_edges_are_now_real_wired_edges(compiled) -> None:\n    \"\"\"Every `unit_graph.DEFERRED_EDGES` row N31 owns is a real compiled edge.\n\n    Not merely absent from a \"still deferred\" set (the way N30's own frozen\n    tests check the *other* rows stay deferred): each row here must appear as\n    an actual conditional edge of the real compiled graph.\n    \"\"\"\n\n    owned = [row for row in U.DEFERRED_EDGES if row[3] == \"N31_REPAIR_ACCEPTANCE\"]\n    assert len(owned) == 6\n\n    edges = {(source, target) for source, target, _conditional in G.compiled_topology(compiled)[\"edges\"]}\n    for source, _value, destination, _owner in owned:\n        assert (source, destination) in edges, (source, destination)\n\n\ndef test_widening_the_bindings_raises_no_topology_or_binding_error(tmp_path) -> None:\n    \"\"\"`validate_bindings`'s placeholder/duplicate/uncallable checks and\n    `register_unit_path`'s N30-EDGE-* checks all pass for D16-D23 exactly as\n    they already do for the pre-existing skeleton -- proven by actually\n    compiling, not by re-reading source.\"\"\"\n\n    output_root = tmp_path / \"widen-check\"\n    output_root.mkdir()\n    compiled = G.build_curriculum_factory_graph(engine_root=REPO_ROOT, output_root=output_root)\n    assert \"D16_REDUCE_UNIT_EVIDENCE\" in set(compiled.get_graph().nodes)\n\n\ndef test_a_clean_one_unit_episode_reaches_d22_accept_unit_via_the_d16_pass_fast_path(\n    tmp_path, monkeypatch\n) -> None:\n    \"\"\"A real run of the real compiled graph: D16 passes on its first call (no\n    repair), and D22/D23 really mint and checkpoint the accepted receipt.\"\"\"\n\n    fixture = UG._build_episode_fixture(tmp_path)\n    result = UG._run_episode(monkeypatch, fixture)\n\n    assert \"D16_REDUCE_UNIT_EVIDENCE\" in result[\"trace\"]\n    assert \"D17_CLASSIFY_UNIT_FINDINGS\" not in result[\"trace\"]\n    assert \"D22_ACCEPT_UNIT\" in result[\"trace\"]\n    assert \"D23_CHECKPOINT_ACCEPTED_UNIT\" in result[\"trace\"]\n\n    state = result[\"state\"]\n    receipt = (state.get(\"accepted_unit_receipts\") or {}).get(\"U001\")\n    assert receipt is not None and receipt[\"receipt_hash\"]\n    assert state[\"cursor\"][\"accepted_ordinal\"] == 1\n\n\ndef test_a_full_d17_through_d21_repair_and_retest_loop_reaches_d22_accept_unit(\n    tmp_path, monkeypatch\n) -> None:\n    \"\"\"A real run of the real compiled graph exercising the other half of D16:\n    a deterministic-repair-owned (`unit layout`) finding really traverses\n    D17 -> D18 -> D19 -> D20 -> D21 -> the real retest chain back to D16,\n    which then passes and really reaches D22/D23.\n\n    The unit's real D14 page inspection finds nothing to repair on its own\n    (the test double renders/inspects deterministically and cleanly), so this\n    seeds a `layout_repairable` finding onto the checkpoint right after D14's\n    own real, clean pass -- the standard \"stop the stream, `update_state`,\n    resume\" technique this file's sibling `test_plan26_unit_graph.py` already\n    uses for crash recovery (`test_a_hard_crash_is_recovered_as_an_orphan_\n    without_continuing_its_thread`). Everything downstream of that seed is\n    then real, unmodified D17-D21/D13-D16/D22/D23 execution over the one real\n    compiled graph: the finding is classified for real, D19 dispatches the\n    real deterministic route (`unit layout` is `repair.DETERMINISTIC_ONLY_\n    OWNERS`), D20 really admits a boundary-checked child, D21 really\n    dispatches `D13_RENDER_UNIT` (the retest chain's first node), and the\n    real (deterministic, idempotent) test-double renderer/inspector really\n    re-runs and passes again, closing the loop back to a real, passing D16.\n    \"\"\"\n\n    fixture = UG._build_episode_fixture(tmp_path)\n    lock, invocation, envelope = UG._prepare_episode(fixture)\n    context = UG._HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    monkeypatch.setattr(\n        G,\n        \"build_model_node_context\",\n        lambda _context, **_kwargs: UG._scripted_model_context(fixture[\"sandbox\"]),\n    )\n    compiled = G.build_curriculum_factory_graph(\n        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n    )\n\n    trace: list[str] = []\n    stream = compiled.stream(\n        {\"invocation\": envelope}, config=invocation.config, stream_mode=\"updates\", context=context\n    )\n    for chunk in stream:\n        trace.extend(chunk)\n        if \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\" in chunk:\n            break\n    stream.close()\n\n    before = compiled.get_state(invocation.config).values\n    assert before[\"pending_guard\"][\"node\"] == \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\"\n    assert before[\"pending_guard\"][\"value\"] == \"pages_inspected\", (\n        \"the real page inspection must have really passed cleanly, so the \"\n        \"repair loop below is proven to start from a seeded finding, not a \"\n        \"real product defect this fixture happens to have\"\n    )\n\n    seeded_finding = {\n        \"owner\": \"unit layout\",\n        \"pointer\": \"/repair_probe\",\n        \"check_id\": \"unit_page_inventory\",\n        \"message\": \"N31 required-proof seed: synthetic layout defect\",\n        \"allowed_facts\": {\"/repair_probe\": \"synthetic-repair-note\"},\n    }\n    compiled.update_state(\n        invocation.config,\n        {\n            \"pending_guard\": {\n                \"node\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n                \"value\": \"layout_repairable\",\n                \"detail\": {\"unit_id\": \"U001\", \"findings\": [seeded_finding]},\n            }\n        },\n    )\n\n    resumed_trace: list[str] = []\n    resumed = compiled.stream(None, config=invocation.config, stream_mode=\"updates\", context=context)\n    try:\n        for chunk in resumed:\n            resumed_trace.extend(chunk)\n    except KeyError as error:\n        missing = error.args[0] if error.args else None\n        declared = {row[2] for row in U.DEFERRED_EDGES}\n        if missing not in declared:\n            raise\n    lock.release()\n\n    # The real repair/retest loop this generation owns, traversed in order.\n    loop = (\n        \"D17_CLASSIFY_UNIT_FINDINGS\",\n        \"D18_PLAN_TARGETED_UNIT_REPAIR\",","numLines":170,"startLine":760,"totalLines":954}}}
