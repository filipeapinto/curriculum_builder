{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CdySve9gmueeSzNS5WJGA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01386By7wefVdnk5hQrxiEVL","name":"Edit","input":{"replace_all":false,"file_path":"runtime/langgraph_factory/acceptance.py","old_string":"    return {\n        \"checkpoint_metadata\": [checkpoint_record],\n        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n        \"pending_guard\": _guard(\n            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n            unit_id=unit_id, checkpoint_id=checkpoint_id,\n        ),\n    }","new_string":"    return {\n        \"checkpoint_metadata\": [checkpoint_record],\n        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n        \"pending_guard\": _guard(\n            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n            unit_id=unit_id, checkpoint_id=checkpoint_id,\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# Topology registration (spec sections 8.2/12's D16-D23 sub-cycle, plus M06)\n# --------------------------------------------------------------------------\n#\n# Additive registration over the one builder N20/N30 already populated, in the\n# same convention `workbook.register_workbook_path` uses for D24-D32/M07/M08:\n# no `add_node`, no `StateGraph()`, no `compile()`. Called once from `graph.py`'s\n# one production compile point (`build_curriculum_factory_graph`), after\n# `register_skeleton` (and therefore `unit_graph.register_unit_path`) has\n# already run over the same builder with D16-D23 included in `available` --\n# which is what resolves the six `unit_graph.DEFERRED_EDGES` rows this node\n# owns (D08/D09/D12/D14/D91 -> D17, M05 -> D16) automatically, the same way\n# widening `available` already resolves any other guard destination whose\n# node body newly exists.\n\n\nUNIT_REPAIR_NODE_BODIES: Mapping[str, Any] = {\n    \"D16_REDUCE_UNIT_EVIDENCE\": D16_REDUCE_UNIT_EVIDENCE,\n    \"D17_CLASSIFY_UNIT_FINDINGS\": repair.D17_CLASSIFY_UNIT_FINDINGS,\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\": repair.D18_PLAN_TARGETED_UNIT_REPAIR,\n    \"D19_ROUTE_UNIT_REPAIR\": repair.D19_ROUTE_UNIT_REPAIR,\n    \"D20_ADMIT_UNIT_REPAIR\": repair.D20_ADMIT_UNIT_REPAIR,\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": repair.D21_RETEST_REQUIRED_DESCENDANTS,\n    \"D22_ACCEPT_UNIT\": D22_ACCEPT_UNIT,\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\": D23_CHECKPOINT_ACCEPTED_UNIT,\n}\n\n# M06 is included here, not in `unit_graph.UNIT_BRANCHES` (frozen, N30-owned):\n# like M07/M08 in `workbook.py`, M06's own outgoing edge (its accepted result\n# to D20) has nowhere else to be registered once M06 is a real graph node, so\n# this module -- the one that owns D20, the destination that edge names --\n# registers it, exactly the pattern `workbook.WORKBOOK_TOPOLOGY_SOURCES`\n# already established for M07/M08.\nUNIT_REPAIR_TOPOLOGY_SOURCES: tuple[str, ...] = (\n    \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"D17_CLASSIFY_UNIT_FINDINGS\",\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n    \"D19_ROUTE_UNIT_REPAIR\",\n    \"D20_ADMIT_UNIT_REPAIR\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n)\n\n\ndef register_unit_repair_path(builder: Any, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n    \"\"\"Add the D16-D23/M06 sub-cycle's own outgoing edges to the shared builder.\n\n    Called by `graph.py` after `unit_graph.register_unit_path`, over the same\n    `StateGraph` -- every node this names as a source must already be\n    `add_node`-registered by the caller. Returns the resolved per-source\n    destination map so a caller can assert the registered topology, the way\n    `unit_graph.register_unit_path`/`workbook.register_workbook_path` already\n    do.\n\n    Two destination sets `routing.guard_destinations` cannot derive alone are\n    widened in here explicitly:\n\n    - D21's own guard may name any fixed retest-chain entry point\n      (`repair.RETEST_FIRST_NODE`) as a dynamic stored destination; the frozen\n      `routing.GUARD_DESTINATIONS` table only carries the frontier-complete\n      row. This is the same widening `unit_graph.py` already does for D92's\n      own declared set with `RESUME_REENTRY_DESTINATIONS`.\n    - M06's accepted result routes through `routing.MODEL_RESULT_DESTINATIONS`,\n      a table `guard_destinations` does not consult (the same reason\n      `workbook.register_workbook_path` widens M07/M08 explicitly).\n    \"\"\"\n\n    available_set = set(available)\n    for node_id in UNIT_REPAIR_TOPOLOGY_SOURCES:\n        if node_id not in available_set:\n            raise routing.RoutingViolation(\n                f\"N31-EDGE-DANGLING:{node_id}: the unit repair/acceptance path \"\n                f\"names a node with no registered body\"\n            )\n\n    guards: dict[str, Any] = {\n        \"D16_REDUCE_UNIT_EVIDENCE\": routing.route_unit_reduction,\n        \"D17_CLASSIFY_UNIT_FINDINGS\": routing.route_finding_classification,\n        \"D18_PLAN_TARGETED_UNIT_REPAIR\": routing.route_repair_plan,\n        \"D19_ROUTE_UNIT_REPAIR\": routing.route_repair_dispatch,\n        \"D20_ADMIT_UNIT_REPAIR\": routing.route_repair_admission,\n        \"D21_RETEST_REQUIRED_DESCENDANTS\": routing.route_retest_frontier,\n        \"D22_ACCEPT_UNIT\": routing.route_unit_acceptance,\n        \"D23_CHECKPOINT_ACCEPTED_UNIT\": routing.route_accepted_checkpoint,\n        \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": routing.route_m06_unit_repair,\n    }\n\n    extra_destinations: Mapping[str, tuple[str, ...]] = {\n        \"D21_RETEST_REQUIRED_DESCENDANTS\": tuple(sorted(set(repair.RETEST_FIRST_NODE.values()))),\n        \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": (\n            routing.MODEL_RESULT_DESTINATIONS[\"M06_REPAIR_NAMED_UNIT_ARTIFACT\"],\n        ),\n    }\n\n    resolved: dict[str, tuple[str, ...]] = {}\n    for source in UNIT_REPAIR_TOPOLOGY_SOURCES:\n        path = guards[source]\n        declared = set(routing.guard_destinations(source)) | set(extra_destinations.get(source, ()))\n        destinations = tuple(sorted(declared & available_set))\n        if not destinations:\n            raise routing.RoutingViolation(\n                f\"N31-EDGE-EMPTY:{source}: every declared destination is deferred\"\n            )\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n        resolved[source] = destinations\n    return resolved"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":959,"cache_read_input_tokens":191221,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":959},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"4a47297c-0c77-46f0-949a-36168da8433f","timestamp":"2026-08-12T20:00:08.378Z","request_id":"req_011CdySvaqWBr66qtsK4QVsx"}
