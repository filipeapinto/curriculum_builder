_checks = [\n    {\"scope\":\"unit\",\"owner\":UNIT,\"head_hash\":domain_hash,\"check_id\":cid,\"attempt\":1,\"result\":\"PASS\",\"detail\":{}}\n    for cid in DOMAIN_CHECK_IDS\n] + [\n    {\"scope\":\"unit\",\"owner\":UNIT,\"head_hash\":content_hash,\"check_id\":cid,\"attempt\":1,\"result\":\"PASS\",\"detail\":{}}\n    for cid in CONTENT_CHECK_IDS\n]\nreview_candidate = {\n    \"key\":\"candidate:review-1\",\"record_kind\":\"model_candidate\",\"pre_admission\":True,\n    \"job_id\":\"M05_REVIEW_ACTUAL_UNIT\",\"unit_pdf_sha256\":pdf_sha,\n    \"payload\": {\"overall_findings\": [], \"page_findings\":[{\"page_number\":1,\"page_sha256\":page_sha,\"findings\":[]}]},\n}\n\ncompiled.update_state(config, {\"unit_status\": {UNIT: \"SELECTED\"}, \"selected_unit_id\": UNIT,\n                                \"run_id\": RUN, \"episode_id\": EPISODE,\n                                \"effective_run\": {\"target_closure\": [UNIT]},\n                                \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0}},\n                       as_node=\"D05_SELECT_NEXT_UNIT\")\nprint(\"after D05 seed\", compiled.get_state(config).values.get(\"unit_status\"))\n\ncompiled.update_state(config, {\"unit_status\": {UNIT: \"SOURCING\"}}, as_node=\"D07_CORRELATE_AND_ADMIT_SOURCES\")\ncompiled.update_state(config, {\"unit_status\": {UNIT: \"BUILDING\"}}, as_node=\"D13_RENDER_UNIT\")\nprint(\"after hops\", compiled.get_state(config).values.get(\"unit_status\"))\n\nm05_values = {\n    \"artifact_heads\": {\n        domain_stream: {\"version\":1,\"parent_hash\":None,\"hash\":domain_hash},\n        content_stream: {\"version\":1,\"parent_hash\":None,\"hash\":content_hash},\n    },\n    \"artifact_versions\": [\n        {\"key\": f\"{domain_stream}@1\",\"stream\":domain_stream,\"version\":1,\"parent_hash\":None,\"hash\":domain_hash,\"body\":domain_body_v},\n        {\"key\": f\"{content_stream}@1\",\"stream\":content_stream,\"version\":1,\"parent_hash\":None,\"hash\":content_hash,\"body\":content_body_v},\n        {\"key\": f\"{visuals_stream}@1\",\"stream\":visuals_stream,\"version\":1,\"parent_hash\":None,\"hash\":visuals_hash,\"body\":visuals_body_v},\n    ],\n    \"deterministic_checks\": deterministic_checks,\n    \"source_admissions\": [{\"key\":\"s1\",\"unit_id\":UNIT,\"sha256\":\"b\"*64}],\n    \"visual_join_evidence\": [{\"key\":\"vje1\",\"unit_id\":UNIT,\"phase\":\"join\",\"result\":\"PASS\"}],\n    \"unit_page_inventories\": [{\"key\":\"inv1\",\"unit_id\":UNIT,\"pdf_sha256\":pdf_sha,\"page_count\":1,\"contiguous\":True,\"result\":\"PASS\"}],\n    \"unit_page_inspections\": [{\"key\":\"insp1\",\"unit_id\":UNIT,\"pdf_sha256\":pdf_sha,\"page\":1,\"page_sha256\":page_sha,\"problems\":[],\"result\":\"PASS\"}],\n    \"unit_reviews\": [review_candidate],\n}\ncompiled.update_state(config, m05_values, as_node=\"M05_REVIEW_ACTUAL_UNIT\")\nprint(\"state before invoke\", list(compiled.get_state(config).next))\n\ntry:\n    result = compiled.invoke(None, config=config, context=_NullContext())\n    print(\"invoke result keys\", list(result.keys()) if result else result)\nexcept Exception as e:\n    print(\"EXC\", type(e), e)\n\nfinal = compiled.get_state(config).values\nprint(\"accepted_unit_receipts\", final.get(\"accepted_unit_receipts\"))\nprint(\"checkpoint_metadata\", final.get(\"checkpoint_metadata\"))\nprint(\"cursor\", final.get(\"cursor\"))\nEOF\n/tmp/plan26_n30_verify/bin/python /tmp/probe1.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":521,"cache_read_input_tokens":275734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":521},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"5b875934-e6ad-4b17-8544-71b9c62557cc","timestamp":"2026-08-12T20:13:30.297Z","requ