{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CdySV9ejvM4bB3jo2VEMC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018isvjxAdycbmtnMt4pkhKg","name":"Read","input":{"file_path":"runtime/langgraph_factory/routing.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":40711,"cache_read_input_tokens":64845,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":40711},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"f99789e9-91eb-42bc-81e0-79a1ff20de2c","timestamp":"2026-08-12T19:54:01.968Z","request_id":"req_011CdySV8neN7tyXZ6E38zHe"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018isvjxAdycbmtnMt4pkhKg","type":"tool_result","content":"1\t\"\"\"Pure routing guards for every conditional edge in spec section 8.2.\n2\t\n3\tA guard is a total function of persisted state to one stable destination ID. It\n4\treads no service, no clock, no filesystem, and no model result body: routing\n5\tauthority is code-owned, so a guard that could consult a model or a service\n6\twould be a routing authority a model could reach.\n7\t\n8\tTwo rules from the section 8.2 header apply before any node-specific rule, in\n9\tthis order:\n10\t\n11\t1. a classified `pending_failure` routes to the terminal writer (to D91 for a\n12\t   model node, whose failures are the one class a classifier may retry);\n13\t2. a graceful interrupt observed at the node's atomic boundary routes to the\n14\t   interrupt gate.\n15\t\n16\tFailure precedence over interruption is deliberate: an episode that broke and\n17\twas also asked to stop is not merely `INTERRUPTED`, and recording it as such\n18\twould hide the fault from the terminal ledger.\n19\t\n20\tAn undeclared guard value raises `RoutingViolation` rather than resolving to a\n21\tterminal. A value outside the frozen table means the guard table and the node\n22\tbody disagree — a code defect, not a run outcome — and laundering it into\n23\t`SYSTEM_FAILURE` would report the *run* as broken when it is the *build* that\n24\tis. `assert_guard_table_total()` is called by the builder so that defect fails\n25\tcompilation instead of waiting for the edge to be taken.\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\tfrom collections.abc import Mapping, Sequence\n31\tfrom typing import Any\n32\t\n33\t__all__ = [\n34\t    \"RoutingViolation\",\n35\t    \"TERMINAL\",\n36\t    \"INTERRUPT_GATE\",\n37\t    \"MODEL_FAILURE_CLASSIFIER\",\n38\t    \"ATTEMPT_RESERVATION\",\n39\t    \"GUARD_DESTINATIONS\",\n40\t    \"NORMAL_EDGE_GUARDS\",\n41\t    \"DYNAMIC_GUARDS\",\n42\t    \"FANOUT_GUARDS\",\n43\t    \"MODEL_RESULT_DESTINATIONS\",\n44\t    \"decide\",\n45\t    \"guard_destinations\",\n46\t    \"assert_guard_table_total\",\n47\t    \"interrupt_requested\",\n48\t    \"route_bootstrap\",\n49\t    \"route_resume_identity\",\n50\t    \"route_frozen_inputs\",\n51\t    \"route_effective_run\",\n52\t    \"route_capabilities\",\n53\t    \"route_initialize_or_resume\",\n54\t    \"route_frontier_reentry\",\n55\t    \"route_unit_selection\",\n56\t    \"route_source_discovery_fanout\",\n57\t    \"route_source_interpretation_fanout\",\n58\t    \"route_source_admission\",\n59\t    \"route_domain_validation\",\n60\t    \"route_content_validation\",\n61\t    \"route_visual_briefs\",\n62\t    \"route_visual_barrier\",\n63\t    \"route_unit_render\",\n64\t    \"route_page_inspection\",\n65\t    \"route_review_packet\",\n66\t    \"route_unit_reduction\",\n67\t    \"route_finding_classification\",\n68\t    \"route_repair_plan\",\n69\t    \"route_repair_dispatch\",\n70\t    \"route_repair_admission\",\n71\t    \"route_retest_frontier\",\n72\t    \"route_unit_acceptance\",\n73\t    \"route_accepted_checkpoint\",\n74\t    \"route_manifest_coverage\",\n75\t    \"route_workbook_assembly\",\n76\t    \"route_workbook_inspection\",\n77\t    \"route_workbook_packet\",\n78\t    \"route_workbook_reduction\",\n79\t    \"route_workbook_repair_plan\",\n80\t    \"route_workbook_repair_admission\",\n81\t    \"route_final_release\",\n82\t    \"route_prerequisite\",\n83\t    \"route_attempt_reservation\",\n84\t    \"route_model_failure\",\n85\t    \"route_interrupt_gate\",\n86\t    \"route_m01_research\",\n87\t    \"route_m02_domain\",\n88\t    \"route_m03_content\",\n89\t    \"route_m04_visual\",\n90\t    \"route_m05_unit_review\",\n91\t    \"route_m06_unit_repair\",\n92\t    \"route_m07_workbook_review\",\n93\t    \"route_m08_workbook_repair\",\n94\t]\n95\t\n96\t\n97\tclass RoutingViolation(RuntimeError):\n98\t    \"\"\"A guard was asked to route a state it does not declare a destination for.\"\"\"\n99\t\n100\t\n101\t# Stable IDs used by more than one guard row.\n102\tTERMINAL = \"D98_WRITE_TERMINAL\"\n103\tINTERRUPT_GATE = \"D96_GRACEFUL_INTERRUPT_GATE\"\n104\tMODEL_FAILURE_CLASSIFIER = \"D91_CLASSIFY_MODEL_FAILURE\"\n105\tATTEMPT_RESERVATION = \"D90_RESERVE_MODEL_ATTEMPT\"\n106\t\n107\t# The complete spec section 8.2 table: (emitting node, declared guard value) ->\n108\t# one stable destination. Guard values are exactly the vocabulary each node\n109\t# declares (`NodeSpec.guards` for the nodes N22 owns); rows for nodes N31/N32\n110\t# still owe are declared here first so those nodes implement against a frozen\n111\t# destination rather than inventing one.\n112\t#\n113\t# No row here names a model node. Spec 6.2's D90 row requires the attempt counter\n114\t# to be committed before dispatch, so every model dispatch is routed to D90 and\n115\t# reaches its worker only from D90's own guard, carrying the reservation D90 minted.\n116\tGUARD_DESTINATIONS: Mapping[str, Mapping[str, str]] = {\n117\t    \"D00_BOOTSTRAP_EPISODE\": {\n118\t        \"fresh\": \"D01_VALIDATE_AND_FREEZE_INPUTS\",\n119\t        \"resume\": \"D00R_REVALIDATE_RESUME_IDENTITY\",\n120\t        \"recover_orphan\": INTERRUPT_GATE,\n121\t    },\n122\t    \"D00R_REVALIDATE_RESUME_IDENTITY\": {\n123\t        \"resume_identity_proven\": \"D03_PROVE_CAPABILITIES\",\n124\t    },\n125\t    \"D01_VALIDATE_AND_FREEZE_INPUTS\": {\n126\t        \"inputs_frozen\": \"D02_COMPILE_EFFECTIVE_RUN\",\n127\t    },\n128\t    \"D02_COMPILE_EFFECTIVE_RUN\": {\n129\t        \"effective_run_compiled\": \"D03_PROVE_CAPABILITIES\",\n130\t    },\n131\t    \"D03_PROVE_CAPABILITIES\": {\n132\t        \"capabilities_proven\": \"D04_INITIALIZE_OR_RESUME\",\n133\t        \"prerequisite_unavailable\": TERMINAL,\n134\t    },\n135\t    \"D04_INITIALIZE_OR_RESUME\": {\n136\t        \"fresh_initialized\": \"D05_SELECT_NEXT_UNIT\",\n137\t        \"resume_imported\": \"D92_REENTER_VALIDATED_FRONTIER\",\n138\t    },\n139\t    \"D92_REENTER_VALIDATED_FRONTIER\": {\n140\t        \"incomplete_model_activation\": MODEL_FAILURE_CLASSIFIER,\n141\t    },\n142\t    \"D05_SELECT_NEXT_UNIT\": {\n143\t        \"unit_selected\": \"D06_COMPILE_SOURCE_REQUESTS\",\n144\t        \"manifest_exhausted\": \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n145\t    },\n146\t    \"D07_CORRELATE_AND_ADMIT_SOURCES\": {\n147\t        \"sources_admitted\": ATTEMPT_RESERVATION,\n148\t        \"prerequisite_unresolved\": \"D30_CLASSIFY_PREREQUISITE\",\n149\t    },\n150\t    \"D08_VALIDATE_DOMAIN\": {\n151\t        \"domain_admitted\": ATTEMPT_RESERVATION,\n152\t        \"domain_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n153\t    },\n154\t    \"D09_VALIDATE_CONTENT\": {\n155\t        \"content_admitted\": \"D10_COMPILE_VISUAL_BRIEFS\",\n156\t        \"content_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n157\t    },\n158\t    \"D10_COMPILE_VISUAL_BRIEFS\": {\n159\t        \"no_deterministic_visuals\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n160\t    },\n161\t    \"D11_CREATE_DETERMINISTIC_VISUALS\": {\n162\t        \"visual_produced\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n163\t    },\n164\t    \"D12_VISUAL_BARRIER_AND_JOIN\": {\n165\t        \"visuals_admitted\": \"D13_RENDER_UNIT\",\n166\t        \"visuals_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n167\t    },\n168\t    \"D13_RENDER_UNIT\": {\n169\t        \"unit_rendered\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n170\t    },\n171\t    \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\": {\n172\t        \"pages_inspected\": \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n173\t        \"layout_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n174\t    },\n175\t    \"D15_FREEZE_UNIT_REVIEW_PACKET\": {\n176\t        \"review_packet_frozen\": ATTEMPT_RESERVATION,\n177\t    },\n178\t    \"D16_REDUCE_UNIT_EVIDENCE\": {\n179\t        \"unit_denominator_passed\": \"D22_ACCEPT_UNIT\",\n180\t        \"unit_findings_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n181\t    },\n182\t    \"D17_CLASSIFY_UNIT_FINDINGS\": {\n183\t        \"partition_complete\": \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n184\t        \"convergence_exhausted\": TERMINAL,\n185\t    },\n186\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\": {\n187\t        \"repair_planned\": \"D19_ROUTE_UNIT_REPAIR\",\n188\t        \"convergence_exhausted\": TERMINAL,\n189\t    },\n190\t    \"D19_ROUTE_UNIT_REPAIR\": {\n191\t        \"model_repair\": ATTEMPT_RESERVATION,\n192\t        \"deterministic_repair\": \"D20_ADMIT_UNIT_REPAIR\",\n193\t    },\n194\t    \"D20_ADMIT_UNIT_REPAIR\": {\n195\t        \"repair_admitted\": \"D21_RETEST_REQUIRED_DESCENDANTS\",\n196\t    },\n197\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": {\n198\t        \"retest_frontier_complete\": \"D16_REDUCE_UNIT_EVIDENCE\",\n199\t    },\n200\t    \"D22_ACCEPT_UNIT\": {\n201\t        \"unit_accepted\": \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n202\t    },\n203\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\": {\n204\t        \"checkpoint_correlated\": \"D05_SELECT_NEXT_UNIT\",\n205\t    },\n206\t    \"D24_PROVE_EXACT_MANIFEST_COVERAGE\": {\n207\t        \"unit_target_accepted\": TERMINAL,\n208\t        \"manifest_coverage_proven\": \"D25_ASSEMBLE_WORKBOOK\",\n209\t    },\n210\t    \"D25_ASSEMBLE_WORKBOOK\": {\n211\t        \"workbook_assembled\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n212\t    },\n213\t    \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\": {\n214\t        \"workbook_pages_inspected\": \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\",\n215\t        \"workbook_layout_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n216\t    },\n217\t    \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\": {\n218\t        \"workbook_packet_frozen\": ATTEMPT_RESERVATION,\n219\t    },\n220\t    \"D28_REDUCE_WORKBOOK_EVIDENCE\": {\n221\t        \"workbook_denominator_passed\": \"D32_RECOMPUTE_FINAL_RELEASE\",\n222\t        \"workbook_findings_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n223\t    },\n224\t    \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\": {\n225\t        \"model_repair\": ATTEMPT_RESERVATION,\n226\t        \"deterministic_repair\": \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\",\n227\t        \"convergence_exhausted\": TERMINAL,\n228\t    },\n229\t    \"D30_CLASSIFY_PREREQUISITE\": {\n230\t        \"prerequisite_pause\": TERMINAL,\n231\t    },\n232\t    \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\": {\n233\t        \"workbook_repair_admitted\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n234\t    },\n235\t    \"D32_RECOMPUTE_FINAL_RELEASE\": {\n236\t        \"release_proven\": TERMINAL,\n237\t        \"workbook_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n238\t    },\n239\t    \"D90_RESERVE_MODEL_ATTEMPT\": {\n240\t        \"exhausted\": TERMINAL,\n241\t    },\n242\t    \"D91_CLASSIFY_MODEL_FAILURE\": {\n243\t        \"retry\": ATTEMPT_RESERVATION,\n244\t        \"system\": TERMINAL,\n245\t        \"exhausted\": TERMINAL,\n246\t    },\n247\t    \"D96_GRACEFUL_INTERRUPT_GATE\": {\n248\t        \"interrupted\": TERMINAL,\n249\t    },\n250\t}\n251\t\n252\t# Guard values satisfied by a normal edge rather than a conditional one. D98 is\n253\t# the only terminal writer and its one outgoing edge is `END`: routing it\n254\t# conditionally would create a second way to leave the graph.\n255\tNORMAL_EDGE_GUARDS: frozenset[tuple[str, str]] = frozenset(\n256\t    {(\"D98_WRITE_TERMINAL\", \"terminated\")}\n257\t)\n258\t\n259\t# Guard values whose destination is carried in the emitting node's own guard\n260\t# record because only that node can compute it. The value is still frozen; only\n261\t# the destination is state-derived, and it is checked against the permitted set\n262\t# below so a stored frontier can never name a model node or an unknown node.\n263\tDYNAMIC_GUARDS: Mapping[str, Mapping[str, str]] = {\n264\t    \"D92_REENTER_VALIDATED_FRONTIER\": {\"deterministic_reentry\": \"destination\"},\n265\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": {\"retest_frontier_incomplete\": \"destination\"},\n266\t    # `route_attempt_reservation` resolves `authorized` from the restaged packet\n267\t    # instead, so a map reserves and dispatches N members; the `job_id` the guard\n268\t    # record carries is the same single job every one of those members names.\n269\t    \"D90_RESERVE_MODEL_ATTEMPT\": {\"authorized\": \"job_id\"},\n270\t    \"D91_CLASSIFY_MODEL_FAILURE\": {\"repair\": \"destination\"},\n271\t}\n272\t\n273\t# Guard values that dispatch a fan-out. The destination is where the *dispatch*\n274\t# goes, not where the workers run: a model map goes to D90, which reserves one\n275\t# attempt per member and then fans the restaged packet out itself. D11 is\n276\t# deterministic, needs no reservation, and is therefore sent to directly.\n277\tFANOUT_GUARDS: Mapping[str, Mapping[str, str]] = {\n278\t    \"D06_COMPILE_SOURCE_REQUESTS\": {\"discovery_fanout\": ATTEMPT_RESERVATION},\n279\t    \"D06B_RETRIEVE_SOURCE_CANDIDATES\": {\"interpretation_fanout\": ATTEMPT_RESERVATION},\n280\t    \"D10_COMPILE_VISUAL_BRIEFS\": {\n281\t        \"deterministic_visual_fanout\": \"D11_CREATE_DETERMINISTIC_VISUALS\"\n282\t    },\n283\t    \"D12_VISUAL_BARRIER_AND_JOIN\": {\"model_visual_fanout\": ATTEMPT_RESERVATION},\n284\t}\n285\t\n286\t# Where a model node's accepted result goes. A model never names its own next\n287\t# node; this table is the only place the destination exists, and none of these\n288\t# destinations is an acceptance, reduction, resume, or terminal authority.\n289\tMODEL_RESULT_DESTINATIONS: Mapping[str, str] = {\n290\t    \"M02_CREATE_UNIT_DOMAIN_DATA\": \"D08_VALIDATE_DOMAIN\",\n291\t    \"M03_WRITE_UNIT_CONTENT\": \"D09_VALIDATE_CONTENT\",\n292\t    \"M04_CREATE_UNIT_VISUALS\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n293\t    \"M05_REVIEW_ACTUAL_UNIT\": \"D16_REDUCE_UNIT_EVIDENCE\",\n294\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"D20_ADMIT_UNIT_REPAIR\",\n295\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"D28_REDUCE_WORKBOOK_EVIDENCE\",\n296\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\",\n297\t}\n298\t\n299\t# A stored resume frontier or retest destination may only name a deterministic\n300\t# node. Spec 6.2 D92: \"a model node as stored destination ... = system\".\n301\t_MODEL_ID_PREFIXES = (\"M01\", \"M02\", \"M03\", \"M04\", \"M05\", \"M06\", \"M07\", \"M08\")\n302\t\n303\t\n304\tdef _record(state: Mapping[str, Any], field: str) -> Mapping[str, Any] | None:\n305\t    value = state.get(field)\n306\t    return value if isinstance(value, Mapping) else None\n307\t\n308\t\n309\tdef interrupt_requested(state: Mapping[str, Any]) -> bool:\n310\t    \"\"\"Whether the node boundary observed a graceful signal at its atomic boundary.\n311\t\n312\t    The boundary (owned by `graph.py`) reads the signal token and records the\n313\t    observation on the guard record, so this stays a pure function of state.\n314\t    \"\"\"\n315\t\n316\t    guard = _record(state, \"pending_guard\")\n317\t    return bool(guard and guard.get(\"interrupt_requested\"))\n318\t\n319\t\n320\tdef _failure_destination(state: Mapping[str, Any], *, model_node: bool) -> str | None:\n321\t    failure = _record(state, \"pending_failure\")\n322\t    if not failure:\n323\t        return None\n324\t    return MODEL_FAILURE_CLASSIFIER if model_node else TERMINAL\n325\t\n326\t\n327\tdef _guard_value(state: Mapping[str, Any], node_id: str) -> tuple[Mapping[str, Any], str]:\n328\t    guard = _record(state, \"pending_guard\")\n329\t    if guard is None:\n330\t        raise RoutingViolation(f\"{node_id}: no guard record was produced for routing\")\n331\t    if guard.get(\"node\") not in (None, node_id):\n332\t        raise RoutingViolation(\n333\t            f\"{node_id}: guard record was emitted by {guard.get('node')!r}\"\n334\t        )\n335\t    value = guard.get(\"value\")\n336\t    if not isinstance(value, str):\n337\t        raise RoutingViolation(f\"{node_id}: guard value {value!r} is not a declared value\")\n338\t    return guard, value\n339\t\n340\t\n341\tdef _dynamic_destination(node_id: str, guard: Mapping[str, Any], detail_key: str) -> str:\n342\t    detail = guard.get(\"detail\")\n343\t    destination = detail.get(detail_key) if isinstance(detail, Mapping) else None\n344\t    if not isinstance(destination, str) or not destination:\n345\t        raise RoutingViolation(\n346\t            f\"{node_id}: guard carries no {detail_key!r} destination\"\n347\t        )\n348\t    return destination\n349\t\n350\t\n351\tdef decide(node_id: str, state: Mapping[str, Any], *, model_node: bool = False) -> str:\n352\t    \"\"\"Resolve the one destination `node_id` authorizes for `state`.\"\"\"\n353\t\n354\t    failure = _failure_destination(state, model_node=model_node)\n355\t    if failure is not None:\n356\t        return failure\n357\t    if interrupt_requested(state):\n358\t        return INTERRUPT_GATE\n359\t    guard, value = _guard_value(state, node_id)\n360\t    dynamic = DYNAMIC_GUARDS.get(node_id, {})\n361\t    if value in dynamic:\n362\t        destination = _dynamic_destination(node_id, guard, dynamic[value])\n363\t        if node_id in (\"D92_REENTER_VALIDATED_FRONTIER\", \"D21_RETEST_REQUIRED_DESCENDANTS\"):\n364\t            if destination.startswith(_MODEL_ID_PREFIXES):\n365\t                raise RoutingViolation(\n366\t                    f\"{node_id}: {destination!r} is a model node and may not be a \"\n367\t                    f\"stored deterministic destination\"\n368\t                )\n369\t        return destination\n370\t    destinations = GUARD_DESTINATIONS.get(node_id, {})\n371\t    if value in destinations:\n372\t        return destinations[value]\n373\t    if value in FANOUT_GUARDS.get(node_id, {}):\n374\t        raise RoutingViolation(\n375\t            f\"{node_id}: guard value {value!r} dispatches a Send fan-out and must be \"\n376\t            f\"routed by its fan-out guard, not by a single-destination edge\"\n377\t        )\n378\t    raise RoutingViolation(f\"{node_id}: undeclared guard value {value!r}\")\n379\t\n380\t\n381\tdef guard_destinations(node_id: str) -> tuple[str, ...]:\n382\t    \"\"\"Every destination `node_id`'s conditional edge may return, for its path map.\"\"\"\n383\t\n384\t    declared = set(GUARD_DESTINATIONS.get(node_id, {}).values())\n385\t    declared.update(FANOUT_GUARDS.get(node_id, {}).values())\n386\t    declared.add(TERMINAL)\n387\t    declared.add(INTERRUPT_GATE)\n388\t    if node_id.startswith(_MODEL_ID_PREFIXES):\n389\t        declared.add(MODEL_FAILURE_CLASSIFIER)\n390\t    return tuple(sorted(declared))\n391\t\n392\t\n393\tdef assert_guard_table_total(catalogue: Mapping[str, Any]) -> None:\n394\t    \"\"\"Fail closed when a node declares a guard value this table cannot route.\n395\t\n396\t    Called by the builder so a table/body disagreement fails compilation by\n397\t    stable ID instead of surfacing as a `RoutingViolation` on a rare edge.\n398\t    \"\"\"\n399\t\n400\t    for node_id, spec in catalogue.items():\n401\t        declared = {\n402\t            value\n403\t            for value in getattr(spec, \"guards\", ())\n404\t            if (node_id, value) not in NORMAL_EDGE_GUARDS\n405\t        }\n406\t        routed = (\n407\t            set(GUARD_DESTINATIONS.get(node_id, {}))\n408\t            | set(DYNAMIC_GUARDS.get(node_id, {}))\n409\t            | set(FANOUT_GUARDS.get(node_id, {}))\n410\t        )\n411\t        missing = sorted(declared - routed)\n412\t        if missing:\n413\t            raise RoutingViolation(\n414\t                f\"N20-GUARD-UNROUTED:{node_id}: declared guard values {missing} have no \"\n415\t                f\"destination in the section 8.2 table\"\n416\t            )\n417\t\n418\t\n419\t# --------------------------------------------------------------------- fan-out guards\n420\t\n421\t\n422\tdef _staged_fanout(state: Mapping[str, Any], node_id: str) -> list[Any]:\n423\t    \"\"\"One `Send` per member of the staged fan-out packet, worker->barrier only.\n424\t\n425\t    The dispatching node stages the exact worker projections in `pending_packet`\n426\t    before the fan-out is taken (spec section 10: the denominator is immutable\n427\t    and persisted before dispatch). This guard translates that staged material\n428\t    one-for-one; it never materializes a projection itself, because a projection\n429\t    invented at routing time would be one no denominator committed to.\n430\t    \"\"\"\n431\t\n432\t    from langgraph.types import Send  # lazy: only the fan-out path needs it\n433\t\n434\t    packet = _record(state, \"pending_packet\")\n435\t    if packet is None:\n436\t        raise RoutingViolation(\n437\t            f\"{node_id}: a fan-out guard was taken with no staged `pending_packet`\"\n438\t        )\n439\t    destination = packet.get(\"dispatch\")\n440\t    if not isinstance(destination, str) or not destination:\n441\t        raise RoutingViolation(f\"{node_id}: staged packet names no dispatch destination\")\n442\t    members = packet.get(\"packets\")\n443\t    if members is None:\n444\t        members = packet.get(\"briefs\")\n445\t    if not isinstance(members, Sequence) or isinstance(members, (str, bytes)) or not members:\n446\t        raise RoutingViolation(\n447\t            f\"{node_id}: staged packet carries no non-empty worker projection list\"\n448\t        )\n449\t    return [Send(destination, member) for member in members]\n450\t\n451\t\n452\tdef _fanout_or_single(state: Mapping[str, Any], node_id: str) -> Any:\n453\t    failure = _failure_destination(state, model_node=False)\n454\t    if failure is not None:\n455\t        return failure\n456\t    if interrupt_requested(state):\n457\t        return INTERRUPT_GATE\n458\t    _, value = _guard_value(state, node_id)\n459\t    dispatch = FANOUT_GUARDS.get(node_id, {}).get(value)\n460\t    if dispatch == ATTEMPT_RESERVATION:\n461\t        return dispatch\n462\t    if dispatch is not None:\n463\t        return _staged_fanout(state, node_id)\n464\t    return decide(node_id, state)\n465\t\n466\t\n467\t# ------------------------------------------------------------------ skeleton guards\n468\t\n469\t\n470\tdef route_bootstrap(state: Mapping[str, Any]) -> str:\n471\t    \"\"\"D00: fresh, legal resume, or orphan recovery (recovery reaches no product node).\"\"\"\n472\t\n473\t    return decide(\"D00_BOOTSTRAP_EPISODE\", state)\n474\t\n475\t\n476\tdef route_resume_identity(state: Mapping[str, Any]) -> str:\n477\t    \"\"\"D00R: every supplied and frozen identity digest matches.\"\"\"\n478\t\n479\t    return decide(\"D00R_REVALIDATE_RESUME_IDENTITY\", state)\n480\t\n481\t\n482\tdef route_frozen_inputs(state: Mapping[str, Any]) -> str:\n483\t    \"\"\"D01: inputs are frozen, or the episode terminates.\"\"\"\n484\t\n485\t    return decide(\"D01_VALIDATE_AND_FREEZE_INPUTS\", state)\n486\t\n487\t\n488\tdef route_effective_run(state: Mapping[str, Any]) -> str:\n489\t    \"\"\"D02: the effective run compiled from the frozen manifest.\"\"\"\n490\t\n491\t    return decide(\"D02_COMPILE_EFFECTIVE_RUN\", state)\n492\t\n493\t\n494\tdef route_capabilities(state: Mapping[str, Any]) -> str:\n495\t    \"\"\"D03: every capability/authorization receipt passes, or a named fact pauses.\"\"\"\n496\t\n497\t    return decide(\"D03_PROVE_CAPABILITIES\", state)\n498\t\n499\t\n500\tdef route_initialize_or_resume(state: Mapping[str, Any]) -> str:\n501\t    \"\"\"D04: fresh initialization to D05, validated resume import to D92.\"\"\"\n502\t\n503\t    return decide(\"D04_INITIALIZE_OR_RESUME\", state)\n504\t\n505\t\n506\tdef route_interrupt_gate(state: Mapping[str, Any]) -> str:\n507\t    \"\"\"D96: the interrupt gate only ever reaches the terminal writer.\"\"\"\n508\t\n509\t    return decide(\"D96_GRACEFUL_INTERRUPT_GATE\", state)\n510\t\n511\t\n512\t# ------------------------------------------------------------- unit-loop guards (N30)\n513\t\n514\t\n515\tdef route_frontier_reentry(state: Mapping[str, Any]) -> str:\n516\t    \"\"\"D92: the stored deterministic frontier node, or D91 for an incomplete attempt.\"\"\"\n517\t\n518\t    return decide(\"D92_REENTER_VALIDATED_FRONTIER\", state)\n519\t\n520\t\n521\tdef route_unit_selection(state: Mapping[str, Any]) -> str:\n522\t    \"\"\"D05: the next required unaccepted unit, or exact-coverage proof.\"\"\"\n523\t\n524\t    return decide(\"D05_SELECT_NEXT_UNIT\", state)\n525\t\n526\t\n527\tdef route_source_discovery_fanout(state: Mapping[str, Any]) -> Any:\n528\t    \"\"\"D06: one `Send` to M01 discovery per compiled request key.\"\"\"\n529\t\n530\t    return _fanout_or_single(state, \"D06_COMPILE_SOURCE_REQUESTS\")\n531\t\n532\t\n533\tdef route_source_interpretation_fanout(state: Mapping[str, Any]) -> Any:\n534\t    \"\"\"D06B: one `Send` to M01 interpretation per retrieval group.\"\"\"\n535\t\n536\t    return _fanout_or_single(state, \"D06B_RETRIEVE_SOURCE_CANDIDATES\")\n537\t\n538\t\n539\tdef route_source_admission(state: Mapping[str, Any]) -> str:\n540\t    \"\"\"D07: exact join and admission pass, or a named prerequisite is unresolved.\"\"\"\n541\t\n542\t    return decide(\"D07_CORRELATE_AND_ADMIT_SOURCES\", state)\n543\t\n544\t\n545\tdef route_domain_validation(state: Mapping[str, Any]) -> str:\n546\t    \"\"\"D08: admitted domain head, or a repairable product finding.\"\"\"\n547\t\n548\t    return decide(\"D08_VALIDATE_DOMAIN\", state)\n549\t\n550\t\n551\tdef route_content_validation(state: Mapping[str, Any]) -> str:\n552\t    \"\"\"D09: admitted content head, or a repairable product finding.\"\"\"\n553\t\n554\t    return decide(\"D09_VALIDATE_CONTENT\", state)\n555\t\n556\t\n557\tdef route_visual_briefs(state: Mapping[str, Any]) -> Any:\n558\t    \"\"\"D10: `Send` per deterministic brief, or straight to the barrier when empty.\"\"\"\n559\t\n560\t    return _fanout_or_single(state, \"D10_COMPILE_VISUAL_BRIEFS\")\n561\t\n562\t\n563\tdef route_visual_barrier(state: Mapping[str, Any]) -> Any:\n564\t    \"\"\"D12: `Send` per eligible model brief, then admit the complete denominator.\"\"\"\n565\t\n566\t    return _fanout_or_single(state, \"D12_VISUAL_BARRIER_AND_JOIN\")\n567\t\n568\t\n569\tdef route_unit_render(state: Mapping[str, Any]) -> str:\n570\t    \"\"\"D13: the rendered unit reaches page inventory and inspection.\"\"\"\n571\t\n572\t    return decide(\"D13_RENDER_UNIT\", state)\n573\t\n574\t\n575\tdef route_page_inspection(state: Mapping[str, Any]) -> str:\n576\t    \"\"\"D14: every page inspected, or a repairable layout finding.\"\"\"\n577\t\n578\t    return decide(\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", state)\n579\t\n580\t\n581\tdef route_review_packet(state: Mapping[str, Any]) -> str:\n582\t    \"\"\"D15: the frozen review packet is handed to the review family.\"\"\"\n583\t\n584\t    return decide(\"D15_FREEZE_UNIT_REVIEW_PACKET\", state)\n585\t\n586\t\n587\t# --------------------------------------------------------- repair/acceptance (N31)\n588\t\n589\t\n590\tdef route_unit_reduction(state: Mapping[str, Any]) -> str:\n591\t    \"\"\"D16: the code-computed unit denominator accepts or opens repair.\"\"\"\n592\t\n593\t    return decide(\"D16_REDUCE_UNIT_EVIDENCE\", state)\n594\t\n595\t\n596\tdef route_finding_classification(state: Mapping[str, Any]) -> str:\n597\t    \"\"\"D17: a total one-owner partition plans repair, or the bound is exhausted.\"\"\"\n598\t\n599\t    return decide(\"D17_CLASSIFY_UNIT_FINDINGS\", state)\n600\t\n601\t\n602\tdef route_repair_plan(state: Mapping[str, Any]) -> str:\n603\t    \"\"\"D18: one planned repair request, or an exhausted attempt bound.\"\"\"\n604\t\n605\t    return decide(\"D18_PLAN_TARGETED_UNIT_REPAIR\", state)\n606\t\n607\t\n608\tdef route_repair_dispatch(state: Mapping[str, Any]) -> str:\n609\t    \"\"\"D19: a model repair reserves an attempt first; deterministic repair does not.\"\"\"\n610\t\n611\t    return decide(\"D19_ROUTE_UNIT_REPAIR\", state)\n612\t\n613\t\n614\tdef route_repair_admission(state: Mapping[str, Any]) -> str:\n615\t    \"\"\"D20: an admitted child head must retest its invalidated descendants.\"\"\"\n616\t\n617\t    return decide(\"D20_ADMIT_UNIT_REPAIR\", state)\n618\t\n619\t\n620\tdef route_retest_frontier(state: Mapping[str, Any]) -> str:\n621\t    \"\"\"D21: the earliest remaining node in the fixed retest DAG, or reduction.\"\"\"\n622\t\n623\t    return decide(\"D21_RETEST_REQUIRED_DESCENDANTS\", state)\n624\t\n625\t\n626\tdef route_unit_acceptance(state: Mapping[str, Any]) -> str:\n627\t    \"\"\"D22: an accepted unit is correlated to a checkpoint before the cursor moves.\"\"\"\n628\t\n629\t    return decide(\"D22_ACCEPT_UNIT\", state)\n630\t\n631\t\n632\tdef route_accepted_checkpoint(state: Mapping[str, Any]) -> str:\n633\t    \"\"\"D23: the accepted unit returns to selection — the one product loop.\"\"\"\n634\t\n635\t    return decide(\"D23_CHECKPOINT_ACCEPTED_UNIT\", state)\n636\t\n637\t\n638\t# ------------------------------------------------------------ workbook/terminal (N32)\n639\t\n640\t\n641\tdef route_manifest_coverage(state: Mapping[str, Any]) -> str:\n642\t    \"\"\"D24: one-mode unit terminal, or all-mode workbook assembly.\"\"\"\n643\t\n644\t    return decide(\"D24_PROVE_EXACT_MANIFEST_COVERAGE\", state)\n645\t\n646\t\n647\tdef route_workbook_assembly(state: Mapping[str, Any]) -> str:\n648\t    \"\"\"D25: the assembled workbook is rendered and inspected.\"\"\"\n649\t\n650\t    return decide(\"D25_ASSEMBLE_WORKBOOK\", state)\n651\t\n652\t\n653\tdef route_workbook_inspection(state: Mapping[str, Any]) -> str:\n654\t    \"\"\"D26: every workbook page inspected, or a workbook-owned repair.\"\"\"\n655\t\n656\t    return decide(\"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\", state)\n657\t\n658\t\n659\tdef route_workbook_packet(state: Mapping[str, Any]) -> str:\n660\t    \"\"\"D27: the frozen workbook packet is handed to the review family.\"\"\"\n661\t\n662\t    return decide(\"D27_FREEZE_WORKBOOK_REVIEW_PACKET\", state)\n663\t\n664\t\n665\tdef route_workbook_reduction(state: Mapping[str, Any]) -> str:\n666\t    \"\"\"D28: the workbook denominator releases or opens workbook repair.\"\"\"\n667\t\n668\t    return decide(\"D28_REDUCE_WORKBOOK_EVIDENCE\", state)\n669\t\n670\t\n671\tdef route_workbook_repair_plan(state: Mapping[str, Any]) -> str:\n672\t    \"\"\"D29: model or deterministic workbook repair, or an exhausted bound.\"\"\"\n673\t\n674\t    return decide(\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\", state)\n675\t\n676\t\n677\tdef route_workbook_repair_admission(state: Mapping[str, Any]) -> str:\n678\t    \"\"\"D31: an admitted workbook child re-enters render/inspect.\"\"\"\n679\t\n680\t    return decide(\"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\", state)\n681\t\n682\t\n683\tdef route_final_release(state: Mapping[str, Any]) -> str:\n684\t    \"\"\"D32: the release recomputation completes, or a repairable defect remains.\"\"\"\n685\t\n686\t    return decide(\"D32_RECOMPUTE_FINAL_RELEASE\", state)\n687\t\n688\t\n689\tdef route_prerequisite(state: Mapping[str, Any]) -> str:\n690\t    \"\"\"D30: a named unavailable external fact is the only pause cause.\"\"\"\n691\t\n692\t    return decide(\"D30_CLASSIFY_PREREQUISITE\", state)\n693\t\n694\t\n695\t# ------------------------------------------------------------- model attempt guards\n696\t\n697\t\n698\tdef route_attempt_reservation(state: Mapping[str, Any]) -> Any:\n699\t    \"\"\"D90: one `Send` per member D90 actually reserved an attempt for, or exhausts.\n700\t\n701\t    D90 restages the dispatching node's packet with each member's reservation\n702\t    attached, so translating that restaged packet is what makes a dispatch carry\n703\t    a committed counter. A single-member dispatch becomes a one-element `Send`\n704\t    list, which is why D07/D08/D15 route here too rather than to their worker.\n705\t    \"\"\"\n706\t\n707\t    node_id = \"D90_RESERVE_MODEL_ATTEMPT\"\n708\t    failure = _failure_destination(state, model_node=False)\n709\t    if failure is not None:\n710\t        return failure\n711\t    if interrupt_requested(state):\n712\t        return INTERRUPT_GATE\n713\t    _, value = _guard_value(state, node_id)\n714\t    if value == \"authorized\":\n715\t        return _staged_fanout(state, node_id)\n716\t    return decide(node_id, state)\n717\t\n718\t\n719\tdef route_model_failure(state: Mapping[str, Any]) -> str:\n720\t    \"\"\"D91: one transport retry through D90, a repair owner, or a terminal.\"\"\"\n721\t\n722\t    guard = _record(state, \"pending_guard\")\n723\t    if guard is None or guard.get(\"kind\") != \"model_failure\":\n724\t        raise RoutingViolation(\n725\t            \"D91_CLASSIFY_MODEL_FAILURE: no model-failure classification is present\"\n726\t        )\n727\t    value = guard.get(\"decision\")\n728\t    if not isinstance(value, str):\n729\t        raise RoutingViolation(f\"D91_CLASSIFY_MODEL_FAILURE: undeclared decision {value!r}\")\n730\t    dynamic = DYNAMIC_GUARDS[\"D91_CLASSIFY_MODEL_FAILURE\"]\n731\t    if value in dynamic:\n732\t        return _dynamic_destination(\"D91_CLASSIFY_MODEL_FAILURE\", guard, dynamic[value])\n733\t    destinations = GUARD_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]\n734\t    if value in destinations:\n735\t        return destinations[value]\n736\t    raise RoutingViolation(f\"D91_CLASSIFY_MODEL_FAILURE: undeclared decision {value!r}\")\n737\t\n738\t\n739\t# ----------------------------------------------------------------- model result guards\n740\t\n741\t\n742\tdef _route_model_result(state: Mapping[str, Any], job_id: str) -> str:\n743\t    failure = _failure_destination(state, model_node=True)\n744\t    if failure is not None:\n745\t        return failure\n746\t    if interrupt_requested(state):\n747\t        return INTERRUPT_GATE\n748\t    return MODEL_RESULT_DESTINATIONS[job_id]\n749\t\n750\t\n751\tdef route_m01_research(state: Mapping[str, Any]) -> str:\n752\t    \"\"\"M01: the discovery superstep reaches retrieval; interpretation reaches the join.\n753\t\n754\t    The phase is read from the accumulated result maps, not from the model's\n755\t    output body: a model that could name its own next node would hold routing\n756\t    authority.\n757\t    \"\"\"\n758\t\n759\t    failure = _failure_destination(state, model_node=True)\n760\t    if failure is not None:\n761\t        return failure\n762\t    if interrupt_requested(state):\n763\t        return INTERRUPT_GATE\n764\t    interpretations = state.get(\"source_interpretations\")\n765\t    if isinstance(interpretations, Mapping) and interpretations:\n766\t        return \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n767\t    discoveries = state.get(\"source_discoveries\")\n768\t    if isinstance(discoveries, Mapping) and discoveries:\n769\t        return \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n770\t    raise RoutingViolation(\"M01_RESEARCH_UNIT_SOURCES: no result set exists to route on\")\n771\t\n772\t\n773\tdef route_m02_domain(state: Mapping[str, Any]) -> str:\n774\t    \"\"\"M02: a domain candidate is only ever validated, never admitted by its author.\"\"\"\n775\t\n776\t    return _route_model_result(state, \"M02_CREATE_UNIT_DOMAIN_DATA\")\n777\t\n778\t\n779\tdef route_m03_content(state: Mapping[str, Any]) -> str:\n780\t    \"\"\"M03: a content candidate reaches content validation.\"\"\"\n781\t\n782\t    return _route_model_result(state, \"M03_WRITE_UNIT_CONTENT\")\n783\t\n784\t\n785\tdef route_m04_visual(state: Mapping[str, Any]) -> str:\n786\t    \"\"\"M04: every model visual returns to the barrier that owns the denominator.\"\"\"\n787\t\n788\t    return _route_model_result(state, \"M04_CREATE_UNIT_VISUALS\")\n789\t\n790\t\n791\tdef route_m05_unit_review(state: Mapping[str, Any]) -> str:\n792\t    \"\"\"M05: a review is evidence for the code-computed reduction, not a verdict.\"\"\"\n793\t\n794\t    return _route_model_result(state, \"M05_REVIEW_ACTUAL_UNIT\")\n795\t\n796\t\n797\tdef route_m06_unit_repair(state: Mapping[str, Any]) -> str:\n798\t    \"\"\"M06: a repair candidate must pass boundary admission.\"\"\"\n799\t\n800\t    return _route_model_result(state, \"M06_REPAIR_NAMED_UNIT_ARTIFACT\")\n801\t\n802\t\n803\tdef route_m07_workbook_review(state: Mapping[str, Any]) -> str:\n804\t    \"\"\"M07: a workbook review is evidence for the workbook reduction.\"\"\"\n805\t\n806\t    return _route_model_result(state, \"M07_REVIEW_ACTUAL_WORKBOOK\")\n807\t\n808\t\n809\tdef route_m08_workbook_repair(state: Mapping[str, Any]) -> str:\n810\t    \"\"\"M08: a workbook repair candidate must pass workbook boundary admission.\"\"\"\n811\t\n812\t    return _route_model_result(state, \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\")\n813\t"}]},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"cb067db1-f0d4-4b5d-a461-f67744f411b3","timestamp":"2026-08-12T19:54:02.117Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/routing.py","content":"\"\"\"Pure routing guards for every conditional edge in spec section 8.2.\n\nA guard is a total function of persisted state to one stable destination ID. It\nreads no service, no clock, no filesystem, and no model result body: routing\nauthority is code-owned, so a guard that could consult a model or a service\nwould be a routing authority a model could reach.\n\nTwo rules from the section 8.2 header apply before any node-specific rule, in\nthis order:\n\n1. a classified `pending_failure` routes to the terminal writer (to D91 for a\n   model node, whose failures are the one class a classifier may retry);\n2. a graceful interrupt observed at the node's atomic boundary routes to the\n   interrupt gate.\n\nFailure precedence over interruption is deliberate: an episode that broke and\nwas also asked to stop is not merely `INTERRUPTED`, and recording it as such\nwould hide the fault from the terminal ledger.\n\nAn undeclared guard value raises `RoutingViolation` rather than resolving to a\nterminal. A value outside the frozen table means the guard table and the node\nbody disagree — a code defect, not a run outcome — and laundering it into\n`SYSTEM_FAILURE` would report the *run* as broken when it is the *build* that\nis. `assert_guard_table_total()` is called by the builder so that defect fails\ncompilation instead of waiting for the edge to be taken.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any\n\n__all__ = [\n    \"RoutingViolation\",\n    \"TERMINAL\",\n    \"INTERRUPT_GATE\",\n    \"MODEL_FAILURE_CLASSIFIER\",\n    \"ATTEMPT_RESERVATION\",\n    \"GUARD_DESTINATIONS\",\n    \"NORMAL_EDGE_GUARDS\",\n    \"DYNAMIC_GUARDS\",\n    \"FANOUT_GUARDS\",\n    \"MODEL_RESULT_DESTINATIONS\",\n    \"decide\",\n    \"guard_destinations\",\n    \"assert_guard_table_total\",\n    \"interrupt_requested\",\n    \"route_bootstrap\",\n    \"route_resume_identity\",\n    \"route_frozen_inputs\",\n    \"route_effective_run\",\n    \"route_capabilities\",\n    \"route_initialize_or_resume\",\n    \"route_frontier_reentry\",\n    \"route_unit_selection\",\n    \"route_source_discovery_fanout\",\n    \"route_source_interpretation_fanout\",\n    \"route_source_admission\",\n    \"route_domain_validation\",\n    \"route_content_validation\",\n    \"route_visual_briefs\",\n    \"route_visual_barrier\",\n    \"route_unit_render\",\n    \"route_page_inspection\",\n    \"route_review_packet\",\n    \"route_unit_reduction\",\n    \"route_finding_classification\",\n    \"route_repair_plan\",\n    \"route_repair_dispatch\",\n    \"route_repair_admission\",\n    \"route_retest_frontier\",\n    \"route_unit_acceptance\",\n    \"route_accepted_checkpoint\",\n    \"route_manifest_coverage\",\n    \"route_workbook_assembly\",\n    \"route_workbook_inspection\",\n    \"route_workbook_packet\",\n    \"route_workbook_reduction\",\n    \"route_workbook_repair_plan\",\n    \"route_workbook_repair_admission\",\n    \"route_final_release\",\n    \"route_prerequisite\",\n    \"route_attempt_reservation\",\n    \"route_model_failure\",\n    \"route_interrupt_gate\",\n    \"route_m01_research\",\n    \"route_m02_domain\",\n    \"route_m03_content\",\n    \"route_m04_visual\",\n    \"route_m05_unit_review\",\n    \"route_m06_unit_repair\",\n    \"route_m07_workbook_review\",\n    \"route_m08_workbook_repair\",\n]\n\n\nclass RoutingViolation(RuntimeError):\n    \"\"\"A guard was asked to route a state it does not declare a destination for.\"\"\"\n\n\n# Stable IDs used by more than one guard row.\nTERMINAL = \"D98_WRITE_TERMINAL\"\nINTERRUPT_GATE = \"D96_GRACEFUL_INTERRUPT_GATE\"\nMODEL_FAILURE_CLASSIFIER = \"D91_CLASSIFY_MODEL_FAILURE\"\nATTEMPT_RESERVATION = \"D90_RESERVE_MODEL_ATTEMPT\"\n\n# The complete spec section 8.2 table: (emitting node, declared guard value) ->\n# one stable destination. Guard values are exactly the vocabulary each node\n# declares (`NodeSpec.guards` for the nodes N22 owns); rows for nodes N31/N32\n# still owe are declared here first so those nodes implement against a frozen\n# destination rather than inventing one.\n#\n# No row here names a model node. Spec 6.2's D90 row requires the attempt counter\n# to be committed before dispatch, so every model dispatch is routed to D90 and\n# reaches its worker only from D90's own guard, carrying the reservation D90 minted.\nGUARD_DESTINATIONS: Mapping[str, Mapping[str, str]] = {\n    \"D00_BOOTSTRAP_EPISODE\": {\n        \"fresh\": \"D01_VALIDATE_AND_FREEZE_INPUTS\",\n        \"resume\": \"D00R_REVALIDATE_RESUME_IDENTITY\",\n        \"recover_orphan\": INTERRUPT_GATE,\n    },\n    \"D00R_REVALIDATE_RESUME_IDENTITY\": {\n        \"resume_identity_proven\": \"D03_PROVE_CAPABILITIES\",\n    },\n    \"D01_VALIDATE_AND_FREEZE_INPUTS\": {\n        \"inputs_frozen\": \"D02_COMPILE_EFFECTIVE_RUN\",\n    },\n    \"D02_COMPILE_EFFECTIVE_RUN\": {\n        \"effective_run_compiled\": \"D03_PROVE_CAPABILITIES\",\n    },\n    \"D03_PROVE_CAPABILITIES\": {\n        \"capabilities_proven\": \"D04_INITIALIZE_OR_RESUME\",\n        \"prerequisite_unavailable\": TERMINAL,\n    },\n    \"D04_INITIALIZE_OR_RESUME\": {\n        \"fresh_initialized\": \"D05_SELECT_NEXT_UNIT\",\n        \"resume_imported\": \"D92_REENTER_VALIDATED_FRONTIER\",\n    },\n    \"D92_REENTER_VALIDATED_FRONTIER\": {\n        \"incomplete_model_activation\": MODEL_FAILURE_CLASSIFIER,\n    },\n    \"D05_SELECT_NEXT_UNIT\": {\n        \"unit_selected\": \"D06_COMPILE_SOURCE_REQUESTS\",\n        \"manifest_exhausted\": \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n    },\n    \"D07_CORRELATE_AND_ADMIT_SOURCES\": {\n        \"sources_admitted\": ATTEMPT_RESERVATION,\n        \"prerequisite_unresolved\": \"D30_CLASSIFY_PREREQUISITE\",\n    },\n    \"D08_VALIDATE_DOMAIN\": {\n        \"domain_admitted\": ATTEMPT_RESERVATION,\n        \"domain_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    },\n    \"D09_VALIDATE_CONTENT\": {\n        \"content_admitted\": \"D10_COMPILE_VISUAL_BRIEFS\",\n        \"content_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    },\n    \"D10_COMPILE_VISUAL_BRIEFS\": {\n        \"no_deterministic_visuals\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n    },\n    \"D11_CREATE_DETERMINISTIC_VISUALS\": {\n        \"visual_produced\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n    },\n    \"D12_VISUAL_BARRIER_AND_JOIN\": {\n        \"visuals_admitted\": \"D13_RENDER_UNIT\",\n        \"visuals_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    },\n    \"D13_RENDER_UNIT\": {\n        \"unit_rendered\": \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n    },\n    \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\": {\n        \"pages_inspected\": \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n        \"layout_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    },\n    \"D15_FREEZE_UNIT_REVIEW_PACKET\": {\n        \"review_packet_frozen\": ATTEMPT_RESERVATION,\n    },\n    \"D16_REDUCE_UNIT_EVIDENCE\": {\n        \"unit_denominator_passed\": \"D22_ACCEPT_UNIT\",\n        \"unit_findings_repairable\": \"D17_CLASSIFY_UNIT_FINDINGS\",\n    },\n    \"D17_CLASSIFY_UNIT_FINDINGS\": {\n        \"partition_complete\": \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n        \"convergence_exhausted\": TERMINAL,\n    },\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\": {\n        \"repair_planned\": \"D19_ROUTE_UNIT_REPAIR\",\n        \"convergence_exhausted\": TERMINAL,\n    },\n    \"D19_ROUTE_UNIT_REPAIR\": {\n        \"model_repair\": ATTEMPT_RESERVATION,\n        \"deterministic_repair\": \"D20_ADMIT_UNIT_REPAIR\",\n    },\n    \"D20_ADMIT_UNIT_REPAIR\": {\n        \"repair_admitted\": \"D21_RETEST_REQUIRED_DESCENDANTS\",\n    },\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": {\n        \"retest_frontier_complete\": \"D16_REDUCE_UNIT_EVIDENCE\",\n    },\n    \"D22_ACCEPT_UNIT\": {\n        \"unit_accepted\": \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n    },\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\": {\n        \"checkpoint_correlated\": \"D05_SELECT_NEXT_UNIT\",\n    },\n    \"D24_PROVE_EXACT_MANIFEST_COVERAGE\": {\n        \"unit_target_accepted\": TERMINAL,\n        \"manifest_coverage_proven\": \"D25_ASSEMBLE_WORKBOOK\",\n    },\n    \"D25_ASSEMBLE_WORKBOOK\": {\n        \"workbook_assembled\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n    },\n    \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\": {\n        \"workbook_pages_inspected\": \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\",\n        \"workbook_layout_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n    },\n    \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\": {\n        \"workbook_packet_frozen\": ATTEMPT_RESERVATION,\n    },\n    \"D28_REDUCE_WORKBOOK_EVIDENCE\": {\n        \"workbook_denominator_passed\": \"D32_RECOMPUTE_FINAL_RELEASE\",\n        \"workbook_findings_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n    },\n    \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\": {\n        \"model_repair\": ATTEMPT_RESERVATION,\n        \"deterministic_repair\": \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\",\n        \"convergence_exhausted\": TERMINAL,\n    },\n    \"D30_CLASSIFY_PREREQUISITE\": {\n        \"prerequisite_pause\": TERMINAL,\n    },\n    \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\": {\n        \"workbook_repair_admitted\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n    },\n    \"D32_RECOMPUTE_FINAL_RELEASE\": {\n        \"release_proven\": TERMINAL,\n        \"workbook_repairable\": \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\",\n    },\n    \"D90_RESERVE_MODEL_ATTEMPT\": {\n        \"exhausted\": TERMINAL,\n    },\n    \"D91_CLASSIFY_MODEL_FAILURE\": {\n        \"retry\": ATTEMPT_RESERVATION,\n        \"system\": TERMINAL,\n        \"exhausted\": TERMINAL,\n    },\n    \"D96_GRACEFUL_INTERRUPT_GATE\": {\n        \"interrupted\": TERMINAL,\n    },\n}\n\n# Guard values satisfied by a normal edge rather than a conditional one. D98 is\n# the only terminal writer and its one outgoing edge is `END`: routing it\n# conditionally would create a second way to leave the graph.\nNORMAL_EDGE_GUARDS: frozenset[tuple[str, str]] = frozenset(\n    {(\"D98_WRITE_TERMINAL\", \"terminated\")}\n)\n\n# Guard values whose destination is carried in the emitting node's own guard\n# record because only that node can compute it. The value is still frozen; only\n# the destination is state-derived, and it is checked against the permitted set\n# below so a stored frontier can never name a model node or an unknown node.\nDYNAMIC_GUARDS: Mapping[str, Mapping[str, str]] = {\n    \"D92_REENTER_VALIDATED_FRONTIER\": {\"deterministic_reentry\": \"destination\"},\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": {\"retest_frontier_incomplete\": \"destination\"},\n    # `route_attempt_reservation` resolves `authorized` from the restaged packet\n    # instead, so a map reserves and dispatches N members; the `job_id` the guard\n    # record carries is the same single job every one of those members names.\n    \"D90_RESERVE_MODEL_ATTEMPT\": {\"authorized\": \"job_id\"},\n    \"D91_CLASSIFY_MODEL_FAILURE\": {\"repair\": \"destination\"},\n}\n\n# Guard values that dispatch a fan-out. The destination is where the *dispatch*\n# goes, not where the workers run: a model map goes to D90, which reserves one\n# attempt per member and then fans the restaged packet out itself. D11 is\n# deterministic, needs no reservation, and is therefore sent to directly.\nFANOUT_GUARDS: Mapping[str, Mapping[str, str]] = {\n    \"D06_COMPILE_SOURCE_REQUESTS\": {\"discovery_fanout\": ATTEMPT_RESERVATION},\n    \"D06B_RETRIEVE_SOURCE_CANDIDATES\": {\"interpretation_fanout\": ATTEMPT_RESERVATION},\n    \"D10_COMPILE_VISUAL_BRIEFS\": {\n        \"deterministic_visual_fanout\": \"D11_CREATE_DETERMINISTIC_VISUALS\"\n    },\n    \"D12_VISUAL_BARRIER_AND_JOIN\": {\"model_visual_fanout\": ATTEMPT_RESERVATION},\n}\n\n# Where a model node's accepted result goes. A model never names its own next\n# node; this table is the only place the destination exists, and none of these\n# destinations is an acceptance, reduction, resume, or terminal authority.\nMODEL_RESULT_DESTINATIONS: Mapping[str, str] = {\n    \"M02_CREATE_UNIT_DOMAIN_DATA\": \"D08_VALIDATE_DOMAIN\",\n    \"M03_WRITE_UNIT_CONTENT\": \"D09_VALIDATE_CONTENT\",\n    \"M04_CREATE_UNIT_VISUALS\": \"D12_VISUAL_BARRIER_AND_JOIN\",\n    \"M05_REVIEW_ACTUAL_UNIT\": \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"D20_ADMIT_UNIT_REPAIR\",\n    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"D28_REDUCE_WORKBOOK_EVIDENCE\",\n    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\",\n}\n\n# A stored resume frontier or retest destination may only name a deterministic\n# node. Spec 6.2 D92: \"a model node as stored destination ... = system\".\n_MODEL_ID_PREFIXES = (\"M01\", \"M02\", \"M03\", \"M04\", \"M05\", \"M06\", \"M07\", \"M08\")\n\n\ndef _record(state: Mapping[str, Any], field: str) -> Mapping[str, Any] | None:\n    value = state.get(field)\n    return value if isinstance(value, Mapping) else None\n\n\ndef interrupt_requested(state: Mapping[str, Any]) -> bool:\n    \"\"\"Whether the node boundary observed a graceful signal at its atomic boundary.\n\n    The boundary (owned by `graph.py`) reads the signal token and records the\n    observation on the guard record, so this stays a pure function of state.\n    \"\"\"\n\n    guard = _record(state, \"pending_guard\")\n    return bool(guard and guard.get(\"interrupt_requested\"))\n\n\ndef _failure_destination(state: Mapping[str, Any], *, model_node: bool) -> str | None:\n    failure = _record(state, \"pending_failure\")\n    if not failure:\n        return None\n    return MODEL_FAILURE_CLASSIFIER if model_node else TERMINAL\n\n\ndef _guard_value(state: Mapping[str, Any], node_id: str) -> tuple[Mapping[str, Any], str]:\n    guard = _record(state, \"pending_guard\")\n    if guard is None:\n        raise RoutingViolation(f\"{node_id}: no guard record was produced for routing\")\n    if guard.get(\"node\") not in (None, node_id):\n        raise RoutingViolation(\n            f\"{node_id}: guard record was emitted by {guard.get('node')!r}\"\n        )\n    value = guard.get(\"value\")\n    if not isinstance(value, str):\n        raise RoutingViolation(f\"{node_id}: guard value {value!r} is not a declared value\")\n    return guard, value\n\n\ndef _dynamic_destination(node_id: str, guard: Mapping[str, Any], detail_key: str) -> str:\n    detail = guard.get(\"detail\")\n    destination = detail.get(detail_key) if isinstance(detail, Mapping) else None\n    if not isinstance(destination, str) or not destination:\n        raise RoutingViolation(\n            f\"{node_id}: guard carries no {detail_key!r} destination\"\n        )\n    return destination\n\n\ndef decide(node_id: str, state: Mapping[str, Any], *, model_node: bool = False) -> str:\n    \"\"\"Resolve the one destination `node_id` authorizes for `state`.\"\"\"\n\n    failure = _failure_destination(state, model_node=model_node)\n    if failure is not None:\n        return failure\n    if interrupt_requested(state):\n        return INTERRUPT_GATE\n    guard, value = _guard_value(state, node_id)\n    dynamic = DYNAMIC_GUARDS.get(node_id, {})\n    if value in dynamic:\n        destination = _dynamic_destination(node_id, guard, dynamic[value])\n        if node_id in (\"D92_REENTER_VALIDATED_FRONTIER\", \"D21_RETEST_REQUIRED_DESCENDANTS\"):\n            if destination.startswith(_MODEL_ID_PREFIXES):\n                raise RoutingViolation(\n                    f\"{node_id}: {destination!r} is a model node and may not be a \"\n                    f\"stored deterministic destination\"\n                )\n        return destination\n    destinations = GUARD_DESTINATIONS.get(node_id, {})\n    if value in destinations:\n        return destinations[value]\n    if value in FANOUT_GUARDS.get(node_id, {}):\n        raise RoutingViolation(\n            f\"{node_id}: guard value {value!r} dispatches a Send fan-out and must be \"\n            f\"routed by its fan-out guard, not by a single-destination edge\"\n        )\n    raise RoutingViolation(f\"{node_id}: undeclared guard value {value!r}\")\n\n\ndef guard_destinations(node_id: str) -> tuple[str, ...]:\n    \"\"\"Every destination `node_id`'s conditional edge may return, for its path map.\"\"\"\n\n    declared = set(GUARD_DESTINATIONS.get(node_id, {}).values())\n    declared.update(FANOUT_GUARDS.get(node_id, {}).values())\n    declared.add(TERMINAL)\n    declared.add(INTERRUPT_GATE)\n    if node_id.startswith(_MODEL_ID_PREFIXES):\n        declared.add(MODEL_FAILURE_CLASSIFIER)\n    return tuple(sorted(declared))\n\n\ndef assert_guard_table_total(catalogue: Mapping[str, Any]) -> None:\n    \"\"\"Fail closed when a node declares a guard value this table cannot route.\n\n    Called by the builder so a table/body disagreement fails compilation by\n    stable ID instead of surfacing as a `RoutingViolation` on a rare edge.\n    \"\"\"\n\n    for node_id, spec in catalogue.items():\n        declared = {\n            value\n            for value in getattr(spec, \"guards\", ())\n            if (node_id, value) not in NORMAL_EDGE_GUARDS\n        }\n        routed = (\n            set(GUARD_DESTINATIONS.get(node_id, {}))\n            | set(DYNAMIC_GUARDS.get(node_id, {}))\n            | set(FANOUT_GUARDS.get(node_id, {}))\n        )\n        missing = sorted(declared - routed)\n        if missing:\n            raise RoutingViolation(\n                f\"N20-GUARD-UNROUTED:{node_id}: declared guard values {missing} have no \"\n                f\"destination in the section 8.2 table\"\n            )\n\n\n# --------------------------------------------------------------------- fan-out guards\n\n\ndef _staged_fanout(state: Mapping[str, Any], node_id: str) -> list[Any]:\n    \"\"\"One `Send` per member of the staged fan-out packet, worker->barrier only.\n\n    The dispatching node stages the exact worker projections in `pending_packet`\n    before the fan-out is taken (spec section 10: the denominator is immutable\n    and persisted before dispatch). This guard translates that staged material\n    one-for-one; it never materializes a projection itself, because a projection\n    invented at routing time would be one no denominator committed to.\n    \"\"\"\n\n    from langgraph.types import Send  # lazy: only the fan-out path needs it\n\n    packet = _record(state, \"pending_packet\")\n    if packet is None:\n        raise RoutingViolation(\n            f\"{node_id}: a fan-out guard was taken with no staged `pending_packet`\"\n        )\n    destination = packet.get(\"dispatch\")\n    if not isinstance(destination, str) or not destination:\n        raise RoutingViolation(f\"{node_id}: staged packet names no dispatch destination\")\n    members = packet.get(\"packets\")\n    if members is None:\n        members = packet.get(\"briefs\")\n    if not isinstance(members, Sequence) or isinstance(members, (str, bytes)) or not members:\n        raise RoutingViolation(\n            f\"{node_id}: staged packet carries no non-empty worker projection list\"\n        )\n    return [Send(destination, member) for member in members]\n\n\ndef _fanout_or_single(state: Mapping[str, Any], node_id: str) -> Any:\n    failure = _failure_destination(state, model_node=False)\n    if failure is not None:\n        return failure\n    if interrupt_requested(state):\n        return INTERRUPT_GATE\n    _, value = _guard_value(state, node_id)\n    dispatch = FANOUT_GUARDS.get(node_id, {}).get(value)\n    if dispatch == ATTEMPT_RESERVATION:\n        return dispatch\n    if dispatch is not None:\n        return _staged_fanout(state, node_id)\n    return decide(node_id, state)\n\n\n# ------------------------------------------------------------------ skeleton guards\n\n\ndef route_bootstrap(state: Mapping[str, Any]) -> str:\n    \"\"\"D00: fresh, legal resume, or orphan recovery (recovery reaches no product node).\"\"\"\n\n    return decide(\"D00_BOOTSTRAP_EPISODE\", state)\n\n\ndef route_resume_identity(state: Mapping[str, Any]) -> str:\n    \"\"\"D00R: every supplied and frozen identity digest matches.\"\"\"\n\n    return decide(\"D00R_REVALIDATE_RESUME_IDENTITY\", state)\n\n\ndef route_frozen_inputs(state: Mapping[str, Any]) -> str:\n    \"\"\"D01: inputs are frozen, or the episode terminates.\"\"\"\n\n    return decide(\"D01_VALIDATE_AND_FREEZE_INPUTS\", state)\n\n\ndef route_effective_run(state: Mapping[str, Any]) -> str:\n    \"\"\"D02: the effective run compiled from the frozen manifest.\"\"\"\n\n    return decide(\"D02_COMPILE_EFFECTIVE_RUN\", state)\n\n\ndef route_capabilities(state: Mapping[str, Any]) -> str:\n    \"\"\"D03: every capability/authorization receipt passes, or a named fact pauses.\"\"\"\n\n    return decide(\"D03_PROVE_CAPABILITIES\", state)\n\n\ndef route_initialize_or_resume(state: Mapping[str, Any]) -> str:\n    \"\"\"D04: fresh initialization to D05, validated resume import to D92.\"\"\"\n\n    return decide(\"D04_INITIALIZE_OR_RESUME\", state)\n\n\ndef route_interrupt_gate(state: Mapping[str, Any]) -> str:\n    \"\"\"D96: the interrupt gate only ever reaches the terminal writer.\"\"\"\n\n    return decide(\"D96_GRACEFUL_INTERRUPT_GATE\", state)\n\n\n# ------------------------------------------------------------- unit-loop guards (N30)\n\n\ndef route_frontier_reentry(state: Mapping[str, Any]) -> str:\n    \"\"\"D92: the stored deterministic frontier node, or D91 for an incomplete attempt.\"\"\"\n\n    return decide(\"D92_REENTER_VALIDATED_FRONTIER\", state)\n\n\ndef route_unit_selection(state: Mapping[str, Any]) -> str:\n    \"\"\"D05: the next required unaccepted unit, or exact-coverage proof.\"\"\"\n\n    return decide(\"D05_SELECT_NEXT_UNIT\", state)\n\n\ndef route_source_discovery_fanout(state: Mapping[str, Any]) -> Any:\n    \"\"\"D06: one `Send` to M01 discovery per compiled request key.\"\"\"\n\n    return _fanout_or_single(state, \"D06_COMPILE_SOURCE_REQUESTS\")\n\n\ndef route_source_interpretation_fanout(state: Mapping[str, Any]) -> Any:\n    \"\"\"D06B: one `Send` to M01 interpretation per retrieval group.\"\"\"\n\n    return _fanout_or_single(state, \"D06B_RETRIEVE_SOURCE_CANDIDATES\")\n\n\ndef route_source_admission(state: Mapping[str, Any]) -> str:\n    \"\"\"D07: exact join and admission pass, or a named prerequisite is unresolved.\"\"\"\n\n    return decide(\"D07_CORRELATE_AND_ADMIT_SOURCES\", state)\n\n\ndef route_domain_validation(state: Mapping[str, Any]) -> str:\n    \"\"\"D08: admitted domain head, or a repairable product finding.\"\"\"\n\n    return decide(\"D08_VALIDATE_DOMAIN\", state)\n\n\ndef route_content_validation(state: Mapping[str, Any]) -> str:\n    \"\"\"D09: admitted content head, or a repairable product finding.\"\"\"\n\n    return decide(\"D09_VALIDATE_CONTENT\", state)\n\n\ndef route_visual_briefs(state: Mapping[str, Any]) -> Any:\n    \"\"\"D10: `Send` per deterministic brief, or straight to the barrier when empty.\"\"\"\n\n    return _fanout_or_single(state, \"D10_COMPILE_VISUAL_BRIEFS\")\n\n\ndef route_visual_barrier(state: Mapping[str, Any]) -> Any:\n    \"\"\"D12: `Send` per eligible model brief, then admit the complete denominator.\"\"\"\n\n    return _fanout_or_single(state, \"D12_VISUAL_BARRIER_AND_JOIN\")\n\n\ndef route_unit_render(state: Mapping[str, Any]) -> str:\n    \"\"\"D13: the rendered unit reaches page inventory and inspection.\"\"\"\n\n    return decide(\"D13_RENDER_UNIT\", state)\n\n\ndef route_page_inspection(state: Mapping[str, Any]) -> str:\n    \"\"\"D14: every page inspected, or a repairable layout finding.\"\"\"\n\n    return decide(\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", state)\n\n\ndef route_review_packet(state: Mapping[str, Any]) -> str:\n    \"\"\"D15: the frozen review packet is handed to the review family.\"\"\"\n\n    return decide(\"D15_FREEZE_UNIT_REVIEW_PACKET\", state)\n\n\n# --------------------------------------------------------- repair/acceptance (N31)\n\n\ndef route_unit_reduction(state: Mapping[str, Any]) -> str:\n    \"\"\"D16: the code-computed unit denominator accepts or opens repair.\"\"\"\n\n    return decide(\"D16_REDUCE_UNIT_EVIDENCE\", state)\n\n\ndef route_finding_classification(state: Mapping[str, Any]) -> str:\n    \"\"\"D17: a total one-owner partition plans repair, or the bound is exhausted.\"\"\"\n\n    return decide(\"D17_CLASSIFY_UNIT_FINDINGS\", state)\n\n\ndef route_repair_plan(state: Mapping[str, Any]) -> str:\n    \"\"\"D18: one planned repair request, or an exhausted attempt bound.\"\"\"\n\n    return decide(\"D18_PLAN_TARGETED_UNIT_REPAIR\", state)\n\n\ndef route_repair_dispatch(state: Mapping[str, Any]) -> str:\n    \"\"\"D19: a model repair reserves an attempt first; deterministic repair does not.\"\"\"\n\n    return decide(\"D19_ROUTE_UNIT_REPAIR\", state)\n\n\ndef route_repair_admission(state: Mapping[str, Any]) -> str:\n    \"\"\"D20: an admitted child head must retest its invalidated descendants.\"\"\"\n\n    return decide(\"D20_ADMIT_UNIT_REPAIR\", state)\n\n\ndef route_retest_frontier(state: Mapping[str, Any]) -> str:\n    \"\"\"D21: the earliest remaining node in the fixed retest DAG, or reduction.\"\"\"\n\n    return decide(\"D21_RETEST_REQUIRED_DESCENDANTS\", state)\n\n\ndef route_unit_acceptance(state: Mapping[str, Any]) -> str:\n    \"\"\"D22: an accepted unit is correlated to a checkpoint before the cursor moves.\"\"\"\n\n    return decide(\"D22_ACCEPT_UNIT\", state)\n\n\ndef route_accepted_checkpoint(state: Mapping[str, Any]) -> str:\n    \"\"\"D23: the accepted unit returns to selection — the one product loop.\"\"\"\n\n    return decide(\"D23_CHECKPOINT_ACCEPTED_UNIT\", state)\n\n\n# ------------------------------------------------------------ workbook/terminal (N32)\n\n\ndef route_manifest_coverage(state: Mapping[str, Any]) -> str:\n    \"\"\"D24: one-mode unit terminal, or all-mode workbook assembly.\"\"\"\n\n    return decide(\"D24_PROVE_EXACT_MANIFEST_COVERAGE\", state)\n\n\ndef route_workbook_assembly(state: Mapping[str, Any]) -> str:\n    \"\"\"D25: the assembled workbook is rendered and inspected.\"\"\"\n\n    return decide(\"D25_ASSEMBLE_WORKBOOK\", state)\n\n\ndef route_workbook_inspection(state: Mapping[str, Any]) -> str:\n    \"\"\"D26: every workbook page inspected, or a workbook-owned repair.\"\"\"\n\n    return decide(\"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\", state)\n\n\ndef route_workbook_packet(state: Mapping[str, Any]) -> str:\n    \"\"\"D27: the frozen workbook packet is handed to the review family.\"\"\"\n\n    return decide(\"D27_FREEZE_WORKBOOK_REVIEW_PACKET\", state)\n\n\ndef route_workbook_reduction(state: Mapping[str, Any]) -> str:\n    \"\"\"D28: the workbook denominator releases or opens workbook repair.\"\"\"\n\n    return decide(\"D28_REDUCE_WORKBOOK_EVIDENCE\", state)\n\n\ndef route_workbook_repair_plan(state: Mapping[str, Any]) -> str:\n    \"\"\"D29: model or deterministic workbook repair, or an exhausted bound.\"\"\"\n\n    return decide(\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\", state)\n\n\ndef route_workbook_repair_admission(state: Mapping[str, Any]) -> str:\n    \"\"\"D31: an admitted workbook child re-enters render/inspect.\"\"\"\n\n    return decide(\"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\", state)\n\n\ndef route_final_release(state: Mapping[str, Any]) -> str:\n    \"\"\"D32: the release recomputation completes, or a repairable defect remains.\"\"\"\n\n    return decide(\"D32_RECOMPUTE_FINAL_RELEASE\", state)\n\n\ndef route_prerequisite(state: Mapping[str, Any]) -> str:\n    \"\"\"D30: a named unavailable external fact is the only pause cause.\"\"\"\n\n    return decide(\"D30_CLASSIFY_PREREQUISITE\", state)\n\n\n# ------------------------------------------------------------- model attempt guards\n\n\ndef route_attempt_reservation(state: Mapping[str, Any]) -> Any:\n    \"\"\"D90: one `Send` per member D90 actually reserved an attempt for, or exhausts.\n\n    D90 restages the dispatching node's packet with each member's reservation\n    attached, so translating that restaged packet is what makes a dispatch carry\n    a committed counter. A single-member dispatch becomes a one-element `Send`\n    list, which is why D07/D08/D15 route here too rather than to their worker.\n    \"\"\"\n\n    node_id = \"D90_RESERVE_MODEL_ATTEMPT\"\n    failure = _failure_destination(state, model_node=False)\n    if failure is not None:\n        return failure\n    if interrupt_requested(state):\n        return INTERRUPT_GATE\n    _, value = _guard_value(state, node_id)\n    if value == \"authorized\":\n        return _staged_fanout(state, node_id)\n    return decide(node_id, state)\n\n\ndef route_model_failure(state: Mapping[str, Any]) -> str:\n    \"\"\"D91: one transport retry through D90, a repair owner, or a terminal.\"\"\"\n\n    guard = _record(state, \"pending_guard\")\n    if guard is None or guard.get(\"kind\") != \"model_failure\":\n        raise RoutingViolation(\n            \"D91_CLASSIFY_MODEL_FAILURE: no model-failure classification is present\"\n        )\n    value = guard.get(\"decision\")\n    if not isinstance(value, str):\n        raise RoutingViolation(f\"D91_CLASSIFY_MODEL_FAILURE: undeclared decision {value!r}\")\n    dynamic = DYNAMIC_GUARDS[\"D91_CLASSIFY_MODEL_FAILURE\"]\n    if value in dynamic:\n        return _dynamic_destination(\"D91_CLASSIFY_MODEL_FAILURE\", guard, dynamic[value])\n    destinations = GUARD_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]\n    if value in destinations:\n        return destinations[value]\n    raise RoutingViolation(f\"D91_CLASSIFY_MODEL_FAILURE: undeclared decision {value!r}\")\n\n\n# ----------------------------------------------------------------- model result guards\n\n\ndef _route_model_result(state: Mapping[str, Any], job_id: str) -> str:\n    failure = _failure_destination(state, model_node=True)\n    if failure is not None:\n        return failure\n    if interrupt_requested(state):\n        return INTERRUPT_GATE\n    return MODEL_RESULT_DESTINATIONS[job_id]\n\n\ndef route_m01_research(state: Mapping[str, Any]) -> str:\n    \"\"\"M01: the discovery superstep reaches retrieval; interpretation reaches the join.\n\n    The phase is read from the accumulated result maps, not from the model's\n    output body: a model that could name its own next node would hold routing\n    authority.\n    \"\"\"\n\n    failure = _failure_destination(state, model_node=True)\n    if failure is not None:\n        return failure\n    if interrupt_requested(state):\n        return INTERRUPT_GATE\n    interpretations = state.get(\"source_interpretations\")\n    if isinstance(interpretations, Mapping) and interpretations:\n        return \"D07_CORRELATE_AND_ADMIT_SOURCES\"\n    discoveries = state.get(\"source_discoveries\")\n    if isinstance(discoveries, Mapping) and discoveries:\n        return \"D06B_RETRIEVE_SOURCE_CANDIDATES\"\n    raise RoutingViolation(\"M01_RESEARCH_UNIT_SOURCES: no result set exists to route on\")\n\n\ndef route_m02_domain(state: Mapping[str, Any]) -> str:\n    \"\"\"M02: a domain candidate is only ever validated, never admitted by its author.\"\"\"\n\n    return _route_model_result(state, \"M02_CREATE_UNIT_DOMAIN_DATA\")\n\n\ndef route_m03_content(state: Mapping[str, Any]) -> str:\n    \"\"\"M03: a content candidate reaches content validation.\"\"\"\n\n    return _route_model_result(state, \"M03_WRITE_UNIT_CONTENT\")\n\n\ndef route_m04_visual(state: Mapping[str, Any]) -> str:\n    \"\"\"M04: every model visual returns to the barrier that owns the denominator.\"\"\"\n\n    return _route_model_result(state, \"M04_CREATE_UNIT_VISUALS\")\n\n\ndef route_m05_unit_review(state: Mapping[str, Any]) -> str:\n    \"\"\"M05: a review is evidence for the code-computed reduction, not a verdict.\"\"\"\n\n    return _route_model_result(state, \"M05_REVIEW_ACTUAL_UNIT\")\n\n\ndef route_m06_unit_repair(state: Mapping[str, Any]) -> str:\n    \"\"\"M06: a repair candidate must pass boundary admission.\"\"\"\n\n    return _route_model_result(state, \"M06_REPAIR_NAMED_UNIT_ARTIFACT\")\n\n\ndef route_m07_workbook_review(state: Mapping[str, Any]) -> str:\n    \"\"\"M07: a workbook review is evidence for the workbook reduction.\"\"\"\n\n    return _route_model_result(state, \"M07_REVIEW_ACTUAL_WORKBOOK\")\n\n\ndef route_m08_workbook_repair(state: Mapping[str, Any]) -> str:\n    \"\"\"M08: a workbook repair candidate must pass workbook boundary admission.\"\"\"\n\n    return _route_model_result(state, \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\")\n","numLines":813,"startLine":1,"totalLines":813}}}
