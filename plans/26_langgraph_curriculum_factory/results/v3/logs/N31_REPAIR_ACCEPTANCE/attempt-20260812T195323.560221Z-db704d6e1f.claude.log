{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LZefHQJJwph9m8KZFiUnFs","type":"tool_result","content":"150\t\n151\t\n152\t# ======================================================= state/channel precondition\n153\t\n154\t\n155\tdef test_the_state_schema_declares_no_langgraph_reserved_channel_name():\n156\t    \"\"\"A reserved channel name makes the production state schema uncompilable.\n157\t\n158\t    LangGraph 1.2.9 rejects `checkpoint_ns` (and `checkpoint_id`, `configurable`,\n159\t    ...) as channel names in `validate_graph`, so any such field in\n160\t    `FactoryState` fails compilation of the one production graph.\n161\t    \"\"\"\n162\t\n163\t    clashes = sorted(set(FACTORY_STATE_FIELDS) & set(RESERVED))\n164\t    assert clashes == [], (\n165\t        f\"FactoryState declares LangGraph-reserved channel name(s) {clashes}; \"\n166\t        f\"owner N11_STATE_REDUCERS (rework edge `state_or_reducer`)\"\n167\t    )\n168\t\n169\t\n170\t# ====================================================== TEST 1: the catalogue compiles\n171\t\n172\t\n173\tdef test_the_available_catalogue_compiles_against_real_node_callables(compiled):\n174\t    bindings = G.binding_inventory()\n175\t    registry = node_registry()\n176\t\n177\t    assert compiled.name == G.GRAPH_NAME == \"plan26_curriculum_factory\"\n178\t    assert isinstance(compiled, CompiledStateGraph)\n179\t\n180\t    # 22 deterministic bodies (N22) + 8 model adapters + D90/D91 (N23), all real\n181\t    # callables.\n182\t    assert set(registry) == set(NODE_CATALOGUE)\n183\t    assert len(registry) == 22\n184\t    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n185\t    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n186\t    assert set(mn.MODEL_BOOKKEEPING_NODES) == {R.ATTEMPT_RESERVATION, R.MODEL_FAILURE_CLASSIFIER}\n187\t    assert set(bindings) == (\n188\t        set(registry) | set(mn.MODEL_NODE_ADAPTERS) | set(mn.MODEL_BOOKKEEPING_NODES)\n189\t    )\n190\t    assert len(bindings) == 32\n191\t\n192\t    drawn = compiled.get_graph()\n193\t    assert set(drawn.nodes) - {START, END} == set(bindings)\n194\t\n195\t    for node_id, body in bindings.items():\n196\t        module = G._binding_record(node_id, body)[\"module\"]\n197\t        assert module.startswith(\"runtime.langgraph_factory.\"), (node_id, module)\n198\t\n199\t\n200\tdef test_start_has_exactly_one_edge_and_d98_is_the_only_registered_end_edge(compiled):\n201\t    drawn = compiled.get_graph()\n202\t    starts = [edge for edge in drawn.edges if edge.source == START]\n203\t    assert [edge.target for edge in starts] == [\"D00_BOOTSTRAP_EPISODE\"]\n204\t\n205\t    registered_end_sources = sorted(\n206\t        source for source, target in G.SKELETON_NORMAL_EDGES if target == END\n207\t    )\n208\t    assert registered_end_sources == [\"D98_WRITE_TERMINAL\"]\n209\t\n210\t    # D98's body is the real N22-owned terminal writer, not a local shim.\n211\t    d98 = node_registry()[\"D98_WRITE_TERMINAL\"]\n212\t    assert G._binding_record(\"D98_WRITE_TERMINAL\", d98)[\"module\"] == (\n213\t        \"runtime.langgraph_factory.nodes.terminal\"\n214\t    )\n215\t\n216\t    # LangGraph draws a dead-end node as reaching END. In this skeleton the only\n217\t    # such nodes are the frontier N30 still owes; nothing else leaks to END.\n218\t    drawn_end = {edge.source for edge in drawn.edges if edge.target == END}\n219\t    assert drawn_end - {\"D98_WRITE_TERMINAL\"} <= set(G.DEFERRED_TOPOLOGY)\n220\t    for node_id in drawn_end - {\"D98_WRITE_TERMINAL\"}:\n221\t        assert G.DEFERRED_TOPOLOGY[node_id] == \"N30_UNIT_GRAPH\"\n222\t\n223\t\n224\tdef test_the_skeleton_wires_exactly_the_declared_edges(compiled):\n225\t    topology = G.compiled_topology(compiled)\n226\t    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n227\t\n228\t    for source, target in (\n229\t        (START, \"D00_BOOTSTRAP_EPISODE\"),\n230\t        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n231\t        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n232\t        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n233\t        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n234\t        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n235\t        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n236\t        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n237\t        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n238\t        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n239\t        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n240\t        (\"D98_WRITE_TERMINAL\", END),\n241\t    ):\n242\t        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n243\t\n244\t    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n245\t    # single successor are the whole of it.\n246\t    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n247\t        \"D98_WRITE_TERMINAL\"\n248\t    }\n249\t\n250\t\n251\t# ============================================ TEST 2: bad bindings fail by stable ID\n252\t\n253\t\n254\tdef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n255\t    return {}\n256\t\n257\t\n258\tdef test_a_missing_callable_fails_the_build_by_stable_id():\n259\t    bindings = G.binding_inventory()\n260\t    bindings.pop(\"D98_WRITE_TERMINAL\")\n261\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n262\t        G.register_skeleton(fresh_builder(), bindings)\n263\t\n264\t\n265\tdef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n266\t    bindings = G.binding_inventory()\n267\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n268\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n269\t        G.register_skeleton(fresh_builder(), bindings)\n270\t\n271\t\n272\tdef test_a_duplicate_callable_fails_the_build_by_stable_id():\n273\t    bindings = G.binding_inventory()\n274\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n275\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n276\t        G.register_skeleton(fresh_builder(), bindings)\n277\t\n278\t\n279\tdef test_an_uncallable_binding_fails_the_build_by_stable_id():\n280\t    bindings = G.binding_inventory()\n281\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n282\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n283\t        G.register_skeleton(fresh_builder(), bindings)\n284\t\n285\t\n286\tdef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n287\t    # Pin the required set to the real skeleton so the dangling-endpoint check is\n288\t    # what rejects the edge, not the missing-binding check that shadows it.\n289\t    required = G._skeleton_required_nodes()\n290\t    monkeypatch.setattr(G, \"_skeleton_required_nodes\", lambda: required)\n291\t    monkeypatch.setattr(\n292\t        G,\n293\t        \"SKELETON_NORMAL_EDGES\",\n294\t        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n295\t    )\n296\t    with pytest.raises(G.GraphBindingError, match=r\"N20-EDGE-DANGLING:D99_NOT_A_NODE\"):\n297\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n298\t\n299\t\n300\tdef test_a_wired_node_with_no_callable_fails_the_build_by_stable_id(monkeypatch):\n301\t    monkeypatch.setattr(\n302\t        G,\n303\t        \"SKELETON_NORMAL_EDGES\",\n304\t        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n305\t    )\n306\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D99_NOT_A_NODE\"):\n307\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n308\t\n309\t\n310\tdef test_an_unwired_undeclared_node_fails_the_build_by_stable_id(monkeypatch):\n311\t    # The example node is read from the live table rather than pinned: a node\n312\t    # deferred today is wired tomorrow by the graph node that owns it, and this\n313\t    # negative case is about the rejection, not about any particular node.\n314\t    assert G.DEFERRED_TOPOLOGY, (\n315\t        \"every registered node is now wired, so this case needs a different \"\n316\t        \"fixture: a registered node that is neither wired nor declared deferred\"\n317\t    )\n318\t    node_id = sorted(G.DEFERRED_TOPOLOGY)[0]\n319\t    deferred = dict(G.DEFERRED_TOPOLOGY)\n320\t    deferred.pop(node_id)\n321\t    monkeypatch.setattr(G, \"DEFERRED_TOPOLOGY\", deferred)\n322\t    with pytest.raises(\n323\t        G.GraphBindingError, match=rf\"N20-NODE-UNDECLARED:{re.escape(node_id)}\"\n324\t    ):\n325\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n326\t\n327\t\n328\tdef test_an_unrouted_declared_guard_value_fails_the_build_by_stable_id(monkeypatch):\n329\t    destinations = {k: dict(v) for k, v in R.GUARD_DESTINATIONS.items()}\n330\t    destinations[\"D05_SELECT_NEXT_UNIT\"].pop(\"manifest_exhausted\")\n331\t    monkeypatch.setattr(R, \"GUARD_DESTINATIONS\", destinations)\n332\t    with pytest.raises(R.RoutingViolation, match=r\"N20-GUARD-UNROUTED:D05_SELECT_NEXT_UNIT\"):\n333\t        G.register_skeleton(fresh_builder(), G.binding_inventory())\n334\t\n335\t\n336\t# ================================================= TEST 3: cycles cross a real guard\n337\t\n338\t\n339\tdef _simple_cycles(edges) -> set[frozenset[str]]:"}]},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"3b4158c5-4ded-4896-9733-50d623715219","timestamp":"2026-08-12T19:57:20.840Z","tool_use_result":{"type":"text","file":{"filePath":"tests/runtime/test_plan26_topology.py","content":"\n\n# ======================================================= state/channel precondition\n\n\ndef test_the_state_schema_declares_no_langgraph_reserved_channel_name():\n    \"\"\"A reserved channel name makes the production state schema uncompilable.\n\n    LangGraph 1.2.9 rejects `checkpoint_ns` (and `checkpoint_id`, `configurable`,\n    ...) as channel names in `validate_graph`, so any such field in\n    `FactoryState` fails compilation of the one production graph.\n    \"\"\"\n\n    clashes = sorted(set(FACTORY_STATE_FIELDS) & set(RESERVED))\n    assert clashes == [], (\n        f\"FactoryState declares LangGraph-reserved channel name(s) {clashes}; \"\n        f\"owner N11_STATE_REDUCERS (rework edge `state_or_reducer`)\"\n    )\n\n\n# ====================================================== TEST 1: the catalogue compiles\n\n\ndef test_the_available_catalogue_compiles_against_real_node_callables(compiled):\n    bindings = G.binding_inventory()\n    registry = node_registry()\n\n    assert compiled.name == G.GRAPH_NAME == \"plan26_curriculum_factory\"\n    assert isinstance(compiled, CompiledStateGraph)\n\n    # 22 deterministic bodies (N22) + 8 model adapters + D90/D91 (N23), all real\n    # callables.\n    assert set(registry) == set(NODE_CATALOGUE)\n    assert len(registry) == 22\n    assert set(mn.MODEL_NODE_ADAPTERS) == set(mn.MODEL_NODE_IDS)\n    assert len(mn.MODEL_NODE_ADAPTERS) == 8\n    assert set(mn.MODEL_BOOKKEEPING_NODES) == {R.ATTEMPT_RESERVATION, R.MODEL_FAILURE_CLASSIFIER}\n    assert set(bindings) == (\n        set(registry) | set(mn.MODEL_NODE_ADAPTERS) | set(mn.MODEL_BOOKKEEPING_NODES)\n    )\n    assert len(bindings) == 32\n\n    drawn = compiled.get_graph()\n    assert set(drawn.nodes) - {START, END} == set(bindings)\n\n    for node_id, body in bindings.items():\n        module = G._binding_record(node_id, body)[\"module\"]\n        assert module.startswith(\"runtime.langgraph_factory.\"), (node_id, module)\n\n\ndef test_start_has_exactly_one_edge_and_d98_is_the_only_registered_end_edge(compiled):\n    drawn = compiled.get_graph()\n    starts = [edge for edge in drawn.edges if edge.source == START]\n    assert [edge.target for edge in starts] == [\"D00_BOOTSTRAP_EPISODE\"]\n\n    registered_end_sources = sorted(\n        source for source, target in G.SKELETON_NORMAL_EDGES if target == END\n    )\n    assert registered_end_sources == [\"D98_WRITE_TERMINAL\"]\n\n    # D98's body is the real N22-owned terminal writer, not a local shim.\n    d98 = node_registry()[\"D98_WRITE_TERMINAL\"]\n    assert G._binding_record(\"D98_WRITE_TERMINAL\", d98)[\"module\"] == (\n        \"runtime.langgraph_factory.nodes.terminal\"\n    )\n\n    # LangGraph draws a dead-end node as reaching END. In this skeleton the only\n    # such nodes are the frontier N30 still owes; nothing else leaks to END.\n    drawn_end = {edge.source for edge in drawn.edges if edge.target == END}\n    assert drawn_end - {\"D98_WRITE_TERMINAL\"} <= set(G.DEFERRED_TOPOLOGY)\n    for node_id in drawn_end - {\"D98_WRITE_TERMINAL\"}:\n        assert G.DEFERRED_TOPOLOGY[node_id] == \"N30_UNIT_GRAPH\"\n\n\ndef test_the_skeleton_wires_exactly_the_declared_edges(compiled):\n    topology = G.compiled_topology(compiled)\n    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n\n    for source, target in (\n        (START, \"D00_BOOTSTRAP_EPISODE\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n        (\"D98_WRITE_TERMINAL\", END),\n    ):\n        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n\n    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n    # single successor are the whole of it.\n    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n        \"D98_WRITE_TERMINAL\"\n    }\n\n\n# ============================================ TEST 2: bad bindings fail by stable ID\n\n\ndef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n    return {}\n\n\ndef test_a_missing_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings.pop(\"D98_WRITE_TERMINAL\")\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_duplicate_callable_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_an_uncallable_binding_fails_the_build_by_stable_id():\n    bindings = G.binding_inventory()\n    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), bindings)\n\n\ndef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n    # Pin the required set to the real skeleton so the dangling-endpoint check is\n    # what rejects the edge, not the missing-binding check that shadows it.\n    required = G._skeleton_required_nodes()\n    monkeypatch.setattr(G, \"_skeleton_required_nodes\", lambda: required)\n    monkeypatch.setattr(\n        G,\n        \"SKELETON_NORMAL_EDGES\",\n        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n    )\n    with pytest.raises(G.GraphBindingError, match=r\"N20-EDGE-DANGLING:D99_NOT_A_NODE\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_a_wired_node_with_no_callable_fails_the_build_by_stable_id(monkeypatch):\n    monkeypatch.setattr(\n        G,\n        \"SKELETON_NORMAL_EDGES\",\n        G.SKELETON_NORMAL_EDGES + ((\"D98_WRITE_TERMINAL\", \"D99_NOT_A_NODE\"),),\n    )\n    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D99_NOT_A_NODE\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_an_unwired_undeclared_node_fails_the_build_by_stable_id(monkeypatch):\n    # The example node is read from the live table rather than pinned: a node\n    # deferred today is wired tomorrow by the graph node that owns it, and this\n    # negative case is about the rejection, not about any particular node.\n    assert G.DEFERRED_TOPOLOGY, (\n        \"every registered node is now wired, so this case needs a different \"\n        \"fixture: a registered node that is neither wired nor declared deferred\"\n    )\n    node_id = sorted(G.DEFERRED_TOPOLOGY)[0]\n    deferred = dict(G.DEFERRED_TOPOLOGY)\n    deferred.pop(node_id)\n    monkeypatch.setattr(G, \"DEFERRED_TOPOLOGY\", deferred)\n    with pytest.raises(\n        G.GraphBindingError, match=rf\"N20-NODE-UNDECLARED:{re.escape(node_id)}\"\n    ):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\ndef test_an_unrouted_declared_guard_value_fails_the_build_by_stable_id(monkeypatch):\n    destinations = {k: dict(v) for k, v in R.GUARD_DESTINATIONS.items()}\n    destinations[\"D05_SELECT_NEXT_UNIT\"].pop(\"manifest_exhausted\")\n    monkeypatch.setattr(R, \"GUARD_DESTINATIONS\", destinations)\n    with pytest.raises(R.RoutingViolation, match=r\"N20-GUARD-UNROUTED:D05_SELECT_NEXT_UNIT\"):\n        G.register_skeleton(fresh_builder(), G.binding_inventory())\n\n\n# ================================================= TEST 3: cycles cross a real guard\n\n\ndef _simple_cycles(edges) -> set[frozenset[str]]:","numLines":190,"startLine":150,"totalLines":983}}}
