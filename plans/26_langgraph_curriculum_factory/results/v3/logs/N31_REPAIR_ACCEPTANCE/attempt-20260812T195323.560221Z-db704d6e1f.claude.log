{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CUzZFqBHBhkehEsevrACEC","type":"tool_result","content":"315\t# D16_REDUCE_UNIT_EVIDENCE\n316\t# --------------------------------------------------------------------------\n317\t\n318\t\n319\tdef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n320\t    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n321\t\n322\t    unit_id = state.get(\"selected_unit_id\")\n323\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n324\t    require(\n325\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n326\t        \"integrity\",\n327\t        \"an accepted unit can never re-enter denominator reduction\",\n328\t        unit_id=unit_id,\n329\t    )\n330\t\n331\t    result = compute_unit_denominator(state, unit_id)\n332\t    status_update = legal_status_advance(state.get(\"unit_status\"), unit_id, \"REVIEWING\")\n333\t    if result.passed:\n334\t        update: dict[str, Any] = {\n335\t            \"deterministic_checks\": [result.check],\n336\t            \"pending_guard\": _guard(\n337\t                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n338\t            ),\n339\t        }"}]},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"507a8e5a-d8eb-4dd0-bbff-272f7e07918a","timestamp":"2026-08-12T20:09:04.043Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/acceptance.py","content":"# D16_REDUCE_UNIT_EVIDENCE\n# --------------------------------------------------------------------------\n\n\ndef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter denominator reduction\",\n        unit_id=unit_id,\n    )\n\n    result = compute_unit_denominator(state, unit_id)\n    status_update = legal_status_advance(state.get(\"unit_status\"), unit_id, \"REVIEWING\")\n    if result.passed:\n        update: dict[str, Any] = {\n            \"deterministic_checks\": [result.check],\n            \"pending_guard\": _guard(\n                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n            ),\n        }","numLines":25,"startLine":315,"totalLines":576}}}
