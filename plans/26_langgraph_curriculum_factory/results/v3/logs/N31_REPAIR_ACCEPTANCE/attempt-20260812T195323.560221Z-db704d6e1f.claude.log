{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LYgHgWfQw6dx6wWgWM3JZd","type":"tool_result","content":"124\tdef D05_SELECT_NEXT_UNIT(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n125\t    \"\"\"Select the next required unaccepted unit in frozen manifest order.\"\"\"\n126\t\n127\t    effective_run = projection[\"effective_run\"]\n128\t    require(bool(effective_run), \"invalid_input\", \"unit selection requires a frozen effective run\")\n129\t\n130\t    closure = effective_run.get(\"target_closure\")\n131\t    require(\n132\t        isinstance(closure, list) and bool(closure),\n133\t        \"invalid_input\",\n134\t        \"the frozen effective run declares an empty target closure\",\n135\t    )\n136\t\n137\t    accepted = projection[\"accepted_unit_receipts\"]\n138\t    cursor = dict(projection[\"cursor\"])\n139\t    manifest_ordinal = cursor.get(\"manifest_ordinal\", 0)\n140\t    accepted_ordinal = cursor.get(\"accepted_ordinal\", 0)\n141\t\n142\t    require(\n143\t        0 <= manifest_ordinal <= len(closure),\n144\t        \"integrity\",\n145\t        \"the manifest cursor is outside the frozen closure\",\n146\t        manifest_ordinal=manifest_ordinal,\n147\t        closure_size=len(closure),\n148\t    )\n149\t    require(\n150\t        accepted_ordinal == len([unit_id for unit_id in closure if unit_id in accepted]),\n151\t        \"integrity\",\n152\t        \"the accepted cursor disagrees with the accepted receipt set\",\n153\t        accepted_ordinal=accepted_ordinal,\n154\t        accepted_receipts=len([unit_id for unit_id in closure if unit_id in accepted]),\n155\t    )\n156\t\n157\t    remaining = [unit_id for unit_id in closure if unit_id not in accepted]\n158\t    if not remaining:\n159\t        return {\n160\t            \"cursor\": {\"manifest_ordinal\": len(closure), \"accepted_ordinal\": accepted_ordinal},\n161\t            \"selected_unit_id\": None,\n162\t            \"pending_guard\": guard(\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\"),\n163\t        }\n164\t\n165\t    selected = remaining[0]\n166\t    return {\n167\t        \"selected_unit_id\": selected,\n168\t        \"unit_status\": {selected: \"SELECTED\"},\n169\t        \"cursor\": {\n170\t            \"manifest_ordinal\": closure.index(selected) + 1,\n171\t            \"accepted_ordinal\": accepted_ordinal,\n172\t        },\n173\t        \"pending_guard\": guard(\"D05_SELECT_NEXT_UNIT\", \"unit_selected\", unit_id=selected),\n174\t    }\n175\t\n176\t\n177\t# --------------------------------------------------------------------------\n178\t# D06\n179\t# --------------------------------------------------------------------------\n180\t\n181\t\n182\tdef compile_unit_source_requests(unit: dict[str, Any], source_epoch: int) -> list[dict[str, Any]]:\n183\t    \"\"\"Derive one bounded, named request per fact the unit must be grounded in.\n184\t\n185\t    Manifest-neutral: fact identifiers are derived from the unit's own declared\n186\t    keys and values, so a unit with more or fewer declared facts produces\n187\t    correspondingly more or fewer requests.\n188\t    \"\"\"\n189\t\n190\t    unit_id = unit[\"id\"]\n191\t    requests: list[dict[str, Any]] = []\n192\t    for key in _FACT_BEARING_KEYS:\n193\t        value = unit.get(key)"}]},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"cfb79c8d-9795-4559-9256-563fd874cacd","timestamp":"2026-08-12T20:07:17.991Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/nodes/sources.py","content":"def D05_SELECT_NEXT_UNIT(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Select the next required unaccepted unit in frozen manifest order.\"\"\"\n\n    effective_run = projection[\"effective_run\"]\n    require(bool(effective_run), \"invalid_input\", \"unit selection requires a frozen effective run\")\n\n    closure = effective_run.get(\"target_closure\")\n    require(\n        isinstance(closure, list) and bool(closure),\n        \"invalid_input\",\n        \"the frozen effective run declares an empty target closure\",\n    )\n\n    accepted = projection[\"accepted_unit_receipts\"]\n    cursor = dict(projection[\"cursor\"])\n    manifest_ordinal = cursor.get(\"manifest_ordinal\", 0)\n    accepted_ordinal = cursor.get(\"accepted_ordinal\", 0)\n\n    require(\n        0 <= manifest_ordinal <= len(closure),\n        \"integrity\",\n        \"the manifest cursor is outside the frozen closure\",\n        manifest_ordinal=manifest_ordinal,\n        closure_size=len(closure),\n    )\n    require(\n        accepted_ordinal == len([unit_id for unit_id in closure if unit_id in accepted]),\n        \"integrity\",\n        \"the accepted cursor disagrees with the accepted receipt set\",\n        accepted_ordinal=accepted_ordinal,\n        accepted_receipts=len([unit_id for unit_id in closure if unit_id in accepted]),\n    )\n\n    remaining = [unit_id for unit_id in closure if unit_id not in accepted]\n    if not remaining:\n        return {\n            \"cursor\": {\"manifest_ordinal\": len(closure), \"accepted_ordinal\": accepted_ordinal},\n            \"selected_unit_id\": None,\n            \"pending_guard\": guard(\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\"),\n        }\n\n    selected = remaining[0]\n    return {\n        \"selected_unit_id\": selected,\n        \"unit_status\": {selected: \"SELECTED\"},\n        \"cursor\": {\n            \"manifest_ordinal\": closure.index(selected) + 1,\n            \"accepted_ordinal\": accepted_ordinal,\n        },\n        \"pending_guard\": guard(\"D05_SELECT_NEXT_UNIT\", \"unit_selected\", unit_id=selected),\n    }\n\n\n# --------------------------------------------------------------------------\n# D06\n# --------------------------------------------------------------------------\n\n\ndef compile_unit_source_requests(unit: dict[str, Any], source_epoch: int) -> list[dict[str, Any]]:\n    \"\"\"Derive one bounded, named request per fact the unit must be grounded in.\n\n    Manifest-neutral: fact identifiers are derived from the unit's own declared\n    keys and values, so a unit with more or fewer declared facts produces\n    correspondingly more or fewer requests.\n    \"\"\"\n\n    unit_id = unit[\"id\"]\n    requests: list[dict[str, Any]] = []\n    for key in _FACT_BEARING_KEYS:\n        value = unit.get(key)","numLines":70,"startLine":124,"totalLines":740}}}
