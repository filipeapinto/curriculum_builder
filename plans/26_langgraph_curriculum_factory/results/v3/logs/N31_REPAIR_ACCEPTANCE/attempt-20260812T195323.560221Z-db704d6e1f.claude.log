{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GwoYgESgEVrrV53ekpBpwS","type":"tool_result","content":"1\t\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n2\t\n3\t`compute_unit_denominator()` is the one reduction engine spec section 13.1\n4\tdescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\n5\tbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\n6\treceipt, off whatever the *current* heads are at that moment. A retest that\n7\tchanged a head between the two calls changes what this function sees; nothing\n8\there caches or trusts its own earlier answer.\n9\t\n10\tLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\n11\tyet -- registration into the compiled graph is N32's write, once `workbook.py`\n12\texists to dispatch the workbook branch alongside them.\n13\t\n14\tKnown scope of this generation's denominator (documented rather than silently\n15\tassumed): it enforces source admission, the domain and content check sets, the\n16\tvisual join, the page inventory/inspection set, one independent unit review\n17\twith all findings mapped through a code-owned owner table, and open-repair\n18\tclosure. It treats the append-only evidence/log layer and the LangGraph\n19\tcheckpoint layer as structurally present rather than independently\n20\tre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n21\t`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\n22\treducers themselves (`reducers.py`), and this generation does not yet call an\n23\texternal hash-chain audit from inside D22. A denominator category is never\n24\tremoved to make a fixture pass; a future generation only ever tightens this.\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\tfrom collections.abc import Mapping\n30\tfrom dataclasses import dataclass, field\n31\tfrom typing import Any\n32\t\n33\tfrom . import repair\n34\tfrom .nodes import (\n35\t    SystemFailure,\n36\t    candidate_payload,\n37\t    canonical_digest,\n38\t    check_record,\n39\t    require,\n40\t    stream_id,\n41\t)\n42\tfrom .nodes.content import CONTENT_CHECK_IDS\n43\tfrom .nodes.domain import DOMAIN_CHECK_IDS\n44\t\n45\t__all__ = [\n46\t    \"DenominatorResult\",\n47\t    \"compute_unit_denominator\",\n48\t    \"prove_exact_manifest_coverage\",\n49\t    \"D16_REDUCE_UNIT_EVIDENCE\",\n50\t    \"D22_ACCEPT_UNIT\",\n51\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n52\t]\n53\t\n54\t\n55\t@dataclass(frozen=True)\n56\tclass DenominatorResult:\n57\t    passed: bool\n58\t    check: dict[str, Any]\n59\t    findings: list[dict[str, Any]] = field(default_factory=list)\n60\t    denominator: dict[str, Any] = field(default_factory=dict)\n61\t\n62\t\n63\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n64\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n65\t\n66\t\n67\tdef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n68\t    if not pdf_sha256:\n69\t        return None\n70\t    matches = [\n71\t        dict(record)\n72\t        for record in unit_reviews or []\n73\t        if isinstance(record, Mapping)\n74\t        and record.get(\"record_kind\") == \"model_candidate\"\n75\t        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n76\t        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n77\t    ]\n78\t    return matches[-1] if matches else None\n79\t\n80\t\n81\tdef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n82\t    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n83\t\n84\t    heads = state.get(\"artifact_heads\") or {}\n85\t    checks = [\n86\t        record\n87\t        for record in state.get(\"deterministic_checks\") or []\n88\t        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n89\t    ]\n90\t    findings: list[dict[str, Any]] = []\n91\t    categories: dict[str, Any] = {}\n92\t\n93\t    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n94\t        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n95\t\n96\t    # 1-2. source admission and correlation.\n97\t    admissions = [\n98\t        record\n99\t        for record in state.get(\"source_admissions\") or []\n100\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n101\t    ]\n102\t    admissions_ok = bool(admissions) and all(\n103\t        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n104\t    )\n105\t    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n106\t    if not admissions_ok:\n107\t        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n108\t\n109\t    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n110\t    domain_stream = stream_id(unit_id, \"domain\")\n111\t    domain_head = heads.get(domain_stream)\n112\t    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n113\t    domain_checks = {\n114\t        record[\"check_id\"]: record\n115\t        for record in checks\n116\t        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n117\t    }\n118\t    domain_ok = domain_hash is not None and all(\n119\t        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n120\t    )\n121\t    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n122\t    if not domain_ok:\n123\t        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n124\t\n125\t    # 4, 6. unit schema and every sourced claim resolved.\n126\t    content_stream = stream_id(unit_id, \"content\")\n127\t    content_head = heads.get(content_stream)\n128\t    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n129\t    content_checks = {\n130\t        record[\"check_id\"]: record\n131\t        for record in checks\n132\t        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n133\t    }\n134\t    content_ok = content_hash is not None and all(\n135\t        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n136\t    )\n137\t    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n138\t    if not content_ok:\n139\t        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n140\t\n141\t    # 8. every required actual visual, provenance, and asset resolution.\n142\t    visual_join = [\n143\t        record\n144\t        for record in state.get(\"visual_join_evidence\") or []\n145\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n146\t    ]\n147\t    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n148\t    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n149\t    if not visuals_ok:\n150\t        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n151\t\n152\t    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n153\t    inventories = [\n154\t        record\n155\t        for record in state.get(\"unit_page_inventories\") or []\n156\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n157\t    ]\n158\t    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n159\t    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n160\t    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n161\t    inspections = [\n162\t        record\n163\t        for record in state.get(\"unit_page_inspections\") or []\n164\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n165\t    ]\n166\t    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n167\t    inspections_ok = (\n168\t        inventory_ok\n169\t        and len(inspections) == expected_pages\n170\t        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n171\t    )\n172\t    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n173\t    if not inspections_ok:\n174\t        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n175\t\n176\t    # 11. one independent review of the frozen actual unit, every page included.\n177\t    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n178\t    review_ok = review is not None\n179\t    if review is not None:\n180\t        payload = candidate_payload(review, \"unit review\")\n181\t        blocking = [\n182\t            entry\n183\t            for entry in payload.get(\"overall_findings\", [])\n184\t            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n185\t        ]\n186\t        for page_entry in payload.get(\"page_findings\", []):\n187\t            if isinstance(page_entry, Mapping):\n188\t                blocking.extend(\n189\t                    entry for entry in page_entry.get(\"findings\", [])\n190\t                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n191\t                )\n192\t        for entry in blocking:\n193\t            owner = repair.owner_for_review_category(entry.get(\"category\"))\n194\t            require(\n195\t                owner is not None,\n196\t                \"invalid_input\",\n197\t                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n198\t                unit_id=unit_id,\n199\t            )\n200\t            findings.append(\n201\t                {\n202\t                    \"check_id\": \"unit_review_finding\",\n203\t                    \"owner\": owner,\n204\t                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n205\t                    \"message\": entry.get(\"description\", \"\"),\n206\t                }\n207\t            )\n208\t        review_ok = not blocking\n209\t    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n210\t    if review is None:\n211\t        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n212\t\n213\t    # 12. complete repair partition, immutable history, and required current retests.\n214\t    unit_repair_requests = [\n215\t        record\n216\t        for record in state.get(\"repair_requests\") or []\n217\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n218\t    ]\n219\t    resolved_keys = {\n220\t        record.get(\"request_key\")\n221\t        for record in state.get(\"retest_results\") or []\n222\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n223\t    }\n224\t    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n225\t    repair_ok = not open_requests\n226\t    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n227\t    if not repair_ok:\n228\t        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n229\t\n230\t    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n231\t    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n232\t    check = check_record(\n233\t        scope=\"unit\",\n234\t        owner=unit_id,\n235\t        head_hash=summary_hash,\n236\t        check_id=\"unit_denominator\",\n237\t        attempt=1,\n238\t        result=\"PASS\" if passed else \"FAIL\",\n239\t        detail={\"categories\": categories},\n240\t    )\n241\t    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n242\t\n243\t\n244\tdef prove_exact_manifest_coverage(\n245\t    ordered_unit_ids: Any,\n246\t    accepted_unit_receipts: Mapping[str, Any],\n247\t    declared_coverage: Any,\n248\t) -> tuple[bool, list[str]]:\n249\t    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n250\t\n251\t    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n252\t    this function is the exact predicate it needs and is exercised directly\n253\t    here so the coverage rule itself -- exact order, exact membership, exact\n254\t    current hash -- is proven against this module's own receipt shape before\n255\t    N32 ever calls it.\n256\t    \"\"\"\n257\t\n258\t    ordered = list(ordered_unit_ids)\n259\t    declared = [dict(entry) for entry in declared_coverage]\n260\t    rejections: list[str] = []\n261\t\n262\t    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n263\t    if declared_ids != ordered:\n264\t        rejections.append(\n265\t            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n266\t        )\n267\t\n268\t    for entry in declared:\n269\t        unit_id = entry.get(\"unit_id\")\n270\t        receipt = accepted_unit_receipts.get(unit_id)\n271\t        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n272\t        if current_hash is None:\n273\t            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n274\t        elif entry.get(\"receipt_hash\") != current_hash:\n275\t            rejections.append(\n276\t                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n277\t                f\"receipt hash {current_hash!r}\"\n278\t            )\n279\t\n280\t    return (not rejections, rejections)\n281\t\n282\t\n283\t# --------------------------------------------------------------------------\n284\t# D16_REDUCE_UNIT_EVIDENCE\n285\t# --------------------------------------------------------------------------\n286\t\n287\t\n288\tdef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n289\t    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n290\t\n291\t    unit_id = state.get(\"selected_unit_id\")\n292\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n293\t    require(\n294\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n295\t        \"integrity\",\n296\t        \"an accepted unit can never re-enter denominator reduction\",\n297\t        unit_id=unit_id,\n298\t    )\n299\t\n300\t    result = compute_unit_denominator(state, unit_id)\n301\t    if result.passed:\n302\t        return {\n303\t            \"deterministic_checks\": [result.check],\n304\t            \"unit_status\": {unit_id: \"REVIEWING\"},\n305\t            \"pending_guard\": _guard(\n306\t                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n307\t            ),\n308\t        }\n309\t    return {\n310\t        \"deterministic_checks\": [result.check],\n311\t        \"unit_status\": {unit_id: \"REVIEWING\"},\n312\t        \"pending_guard\": _guard(\n313\t            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n314\t            unit_id=unit_id, findings=result.findings,\n315\t        ),\n316\t    }\n317\t\n318\t\n319\t# --------------------------------------------------------------------------\n320\t# D22_ACCEPT_UNIT\n321\t# --------------------------------------------------------------------------\n322\t\n323\t\n324\tdef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n325\t    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n326\t\n327\t    Never trusts D16's earlier pass: a retest that changed a head between the\n328\t    two calls, or evidence that went stale, makes this recomputation fail even\n329\t    though D16 once passed. Any absent, stale, or failing member blocks\n330\t    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n331\t    warned acceptance path.\n332\t    \"\"\"\n333\t\n334\t    unit_id = state.get(\"selected_unit_id\")\n335\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n336\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n337\t    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n338\t\n339\t    result = compute_unit_denominator(state, unit_id)\n340\t    require(\n341\t        result.passed,\n342\t        \"integrity\",\n343\t        \"D22 recomputation does not currently pass; acceptance is refused\",\n344\t        unit_id=unit_id, categories=result.denominator,\n345\t    )\n346\t\n347\t    heads = state.get(\"artifact_heads\") or {}\n348\t    unit_stream_hashes = {\n349\t        stream: head.get(\"hash\")\n350\t        for stream, head in heads.items()\n351\t        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n352\t    }\n353\t    receipt_body = {\n354\t        \"unit_id\": unit_id,\n355\t        \"denominator\": result.denominator,\n356\t        \"artifact_head_hashes\": unit_stream_hashes,\n357\t        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n358\t    }\n359\t    receipt = dict(receipt_body)\n360\t    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n361\t\n362\t    return {\n363\t        \"accepted_unit_receipts\": {unit_id: receipt},\n364\t        \"deterministic_checks\": [result.check],\n365\t        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n366\t    }\n367\t\n368\t\n369\t# --------------------------------------------------------------------------\n370\t# D23_CHECKPOINT_ACCEPTED_UNIT\n371\t# --------------------------------------------------------------------------\n372\t\n373\t\n374\tdef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n375\t    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n376\t\n377\t    The cursor's `accepted_ordinal` is written in the same update as the\n378\t    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n379\t    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n380\t    would otherwise be satisfiable by a cursor that outran its correlation\n381\t    evidence, which is exactly the ordering spec section 6.2's D23 row and\n382\t    this node's own TEST 7 forbid.\n383\t    \"\"\"\n384\t\n385\t    unit_id = state.get(\"selected_unit_id\")\n386\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n387\t    accepted = state.get(\"accepted_unit_receipts\") or {}\n388\t    receipt = accepted.get(unit_id)\n389\t    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n390\t\n391\t    evidence_entries = state.get(\"evidence_index_entries\") or []\n392\t    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n393\t    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n394\t\n395\t    checkpoint_record = {\n396\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n397\t        \"unit_id\": unit_id,\n398\t        \"checkpoint_id\": checkpoint_id,\n399\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n400\t        \"run_id\": state.get(\"run_id\"),\n401\t        \"episode_id\": state.get(\"episode_id\"),\n402\t        \"evidence_ordinal\": len(evidence_entries),\n403\t        \"prior_checkpoint_count\": len(existing_checkpoints),\n404\t    }\n405\t\n406\t    correlation_record = {\n407\t        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n408\t        \"unit_id\": unit_id,\n409\t        \"checkpoint_id\": checkpoint_id,\n410\t        \"receipt_hash\": receipt[\"receipt_hash\"],\n411\t    }\n412\t\n413\t    effective_run = state.get(\"effective_run\") or {}\n414\t    closure = effective_run.get(\"target_closure\") or []\n415\t    cursor = dict(state.get(\"cursor\") or {})\n416\t    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n417\t    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n418\t    if unit_id not in closure:\n419\t        # Defensive: D05 always selects from the closure, so this is unreachable\n420\t        # in the real pipeline; kept explicit rather than silently trusting\n421\t        # an out-of-closure cursor advance.\n422\t        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n423\t\n424\t    return {\n425\t        \"checkpoint_metadata\": [checkpoint_record],\n426\t        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n427\t        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n428\t        \"pending_guard\": _guard(\n429\t            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n430\t            unit_id=unit_id, checkpoint_id=checkpoint_id,\n431\t        ),\n432\t    }\n433\t"}]},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"546f7b77-ec99-4047-874f-c63f9a7ea117","timestamp":"2026-08-12T19:53:54.188Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/acceptance.py","content":"\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n\n`compute_unit_denominator()` is the one reduction engine spec section 13.1\ndescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\nbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\nreceipt, off whatever the *current* heads are at that moment. A retest that\nchanged a head between the two calls changes what this function sees; nothing\nhere caches or trusts its own earlier answer.\n\nLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\nyet -- registration into the compiled graph is N32's write, once `workbook.py`\nexists to dispatch the workbook branch alongside them.\n\nKnown scope of this generation's denominator (documented rather than silently\nassumed): it enforces source admission, the domain and content check sets, the\nvisual join, the page inventory/inspection set, one independent unit review\nwith all findings mapped through a code-owned owner table, and open-repair\nclosure. It treats the append-only evidence/log layer and the LangGraph\ncheckpoint layer as structurally present rather than independently\nre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\nreducers themselves (`reducers.py`), and this generation does not yet call an\nexternal hash-chain audit from inside D22. A denominator category is never\nremoved to make a fixture pass; a future generation only ever tightens this.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom . import repair\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    check_record,\n    require,\n    stream_id,\n)\nfrom .nodes.content import CONTENT_CHECK_IDS\nfrom .nodes.domain import DOMAIN_CHECK_IDS\n\n__all__ = [\n    \"DenominatorResult\",\n    \"compute_unit_denominator\",\n    \"prove_exact_manifest_coverage\",\n    \"D16_REDUCE_UNIT_EVIDENCE\",\n    \"D22_ACCEPT_UNIT\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n]\n\n\n@dataclass(frozen=True)\nclass DenominatorResult:\n    passed: bool\n    check: dict[str, Any]\n    findings: list[dict[str, Any]] = field(default_factory=list)\n    denominator: dict[str, Any] = field(default_factory=dict)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n    if not pdf_sha256:\n        return None\n    matches = [\n        dict(record)\n        for record in unit_reviews or []\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == \"model_candidate\"\n        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n    ]\n    return matches[-1] if matches else None\n\n\ndef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    checks = [\n        record\n        for record in state.get(\"deterministic_checks\") or []\n        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n    ]\n    findings: list[dict[str, Any]] = []\n    categories: dict[str, Any] = {}\n\n    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n\n    # 1-2. source admission and correlation.\n    admissions = [\n        record\n        for record in state.get(\"source_admissions\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    admissions_ok = bool(admissions) and all(\n        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n    )\n    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n    if not admissions_ok:\n        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n\n    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n    domain_stream = stream_id(unit_id, \"domain\")\n    domain_head = heads.get(domain_stream)\n    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n    domain_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n    }\n    domain_ok = domain_hash is not None and all(\n        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n    )\n    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n    if not domain_ok:\n        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n\n    # 4, 6. unit schema and every sourced claim resolved.\n    content_stream = stream_id(unit_id, \"content\")\n    content_head = heads.get(content_stream)\n    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n    content_checks = {\n        record[\"check_id\"]: record\n        for record in checks\n        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n    }\n    content_ok = content_hash is not None and all(\n        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n    )\n    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n    if not content_ok:\n        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n\n    # 8. every required actual visual, provenance, and asset resolution.\n    visual_join = [\n        record\n        for record in state.get(\"visual_join_evidence\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n    ]\n    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n    if not visuals_ok:\n        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n\n    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n    inventories = [\n        record\n        for record in state.get(\"unit_page_inventories\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n    inspections = [\n        record\n        for record in state.get(\"unit_page_inspections\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n    ]\n    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n    inspections_ok = (\n        inventory_ok\n        and len(inspections) == expected_pages\n        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n    )\n    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n    if not inspections_ok:\n        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n\n    # 11. one independent review of the frozen actual unit, every page included.\n    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n    review_ok = review is not None\n    if review is not None:\n        payload = candidate_payload(review, \"unit review\")\n        blocking = [\n            entry\n            for entry in payload.get(\"overall_findings\", [])\n            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n        ]\n        for page_entry in payload.get(\"page_findings\", []):\n            if isinstance(page_entry, Mapping):\n                blocking.extend(\n                    entry for entry in page_entry.get(\"findings\", [])\n                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n                )\n        for entry in blocking:\n            owner = repair.owner_for_review_category(entry.get(\"category\"))\n            require(\n                owner is not None,\n                \"invalid_input\",\n                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n                unit_id=unit_id,\n            )\n            findings.append(\n                {\n                    \"check_id\": \"unit_review_finding\",\n                    \"owner\": owner,\n                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n                    \"message\": entry.get(\"description\", \"\"),\n                }\n            )\n        review_ok = not blocking\n    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n    if review is None:\n        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n\n    # 12. complete repair partition, immutable history, and required current retests.\n    unit_repair_requests = [\n        record\n        for record in state.get(\"repair_requests\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n    ]\n    resolved_keys = {\n        record.get(\"request_key\")\n        for record in state.get(\"retest_results\") or []\n        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n    }\n    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n    repair_ok = not open_requests\n    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n    if not repair_ok:\n        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n\n    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n    check = check_record(\n        scope=\"unit\",\n        owner=unit_id,\n        head_hash=summary_hash,\n        check_id=\"unit_denominator\",\n        attempt=1,\n        result=\"PASS\" if passed else \"FAIL\",\n        detail={\"categories\": categories},\n    )\n    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n\n\ndef prove_exact_manifest_coverage(\n    ordered_unit_ids: Any,\n    accepted_unit_receipts: Mapping[str, Any],\n    declared_coverage: Any,\n) -> tuple[bool, list[str]]:\n    \"\"\"The D24 coverage predicate (spec section 13.2 item 1), as a reusable primitive.\n\n    N32 owns `D24_PROVE_EXACT_MANIFEST_COVERAGE`'s node body and graph wiring;\n    this function is the exact predicate it needs and is exercised directly\n    here so the coverage rule itself -- exact order, exact membership, exact\n    current hash -- is proven against this module's own receipt shape before\n    N32 ever calls it.\n    \"\"\"\n\n    ordered = list(ordered_unit_ids)\n    declared = [dict(entry) for entry in declared_coverage]\n    rejections: list[str] = []\n\n    declared_ids = [entry.get(\"unit_id\") for entry in declared]\n    if declared_ids != ordered:\n        rejections.append(\n            f\"coverage declares {declared_ids}, which is not exactly the frozen manifest order {ordered}\"\n        )\n\n    for entry in declared:\n        unit_id = entry.get(\"unit_id\")\n        receipt = accepted_unit_receipts.get(unit_id)\n        current_hash = receipt.get(\"receipt_hash\") if isinstance(receipt, Mapping) else None\n        if current_hash is None:\n            rejections.append(f\"unit {unit_id!r} has no accepted receipt\")\n        elif entry.get(\"receipt_hash\") != current_hash:\n            rejections.append(\n                f\"unit {unit_id!r} coverage hash {entry.get('receipt_hash')!r} is not the current \"\n                f\"receipt hash {current_hash!r}\"\n            )\n\n    return (not rejections, rejections)\n\n\n# --------------------------------------------------------------------------\n# D16_REDUCE_UNIT_EVIDENCE\n# --------------------------------------------------------------------------\n\n\ndef D16_REDUCE_UNIT_EVIDENCE(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Build the complete current unit denominator; accept it, or open repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter denominator reduction\",\n        unit_id=unit_id,\n    )\n\n    result = compute_unit_denominator(state, unit_id)\n    if result.passed:\n        return {\n            \"deterministic_checks\": [result.check],\n            \"unit_status\": {unit_id: \"REVIEWING\"},\n            \"pending_guard\": _guard(\n                \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_denominator_passed\", unit_id=unit_id\n            ),\n        }\n    return {\n        \"deterministic_checks\": [result.check],\n        \"unit_status\": {unit_id: \"REVIEWING\"},\n        \"pending_guard\": _guard(\n            \"D16_REDUCE_UNIT_EVIDENCE\", \"unit_findings_repairable\",\n            unit_id=unit_id, findings=result.findings,\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D22_ACCEPT_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D22_ACCEPT_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Recompute the full denominator immediately before minting an accepted receipt.\n\n    Never trusts D16's earlier pass: a retest that changed a head between the\n    two calls, or evidence that went stale, makes this recomputation fail even\n    though D16 once passed. Any absent, stale, or failing member blocks\n    acceptance outright (spec section 6.2 D22 row) -- there is no partial or\n    warned acceptance path.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    require(unit_id not in accepted, \"integrity\", \"unit is already accepted\", unit_id=unit_id)\n\n    result = compute_unit_denominator(state, unit_id)\n    require(\n        result.passed,\n        \"integrity\",\n        \"D22 recomputation does not currently pass; acceptance is refused\",\n        unit_id=unit_id, categories=result.denominator,\n    )\n\n    heads = state.get(\"artifact_heads\") or {}\n    unit_stream_hashes = {\n        stream: head.get(\"hash\")\n        for stream, head in heads.items()\n        if isinstance(head, Mapping) and stream.startswith(f\"units/{unit_id}/\")\n    }\n    receipt_body = {\n        \"unit_id\": unit_id,\n        \"denominator\": result.denominator,\n        \"artifact_head_hashes\": unit_stream_hashes,\n        \"log_high_water_mark\": len(state.get(\"evidence_index_entries\") or []),\n    }\n    receipt = dict(receipt_body)\n    receipt[\"receipt_hash\"] = canonical_digest(receipt_body)\n\n    return {\n        \"accepted_unit_receipts\": {unit_id: receipt},\n        \"deterministic_checks\": [result.check],\n        \"pending_guard\": _guard(\"D22_ACCEPT_UNIT\", \"unit_accepted\", unit_id=unit_id, receipt_hash=receipt[\"receipt_hash\"]),\n    }\n\n\n# --------------------------------------------------------------------------\n# D23_CHECKPOINT_ACCEPTED_UNIT\n# --------------------------------------------------------------------------\n\n\ndef D23_CHECKPOINT_ACCEPTED_UNIT(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Correlate the accepted receipt to a checkpoint, then advance the cursor.\n\n    The cursor's `accepted_ordinal` is written in the same update as the\n    checkpoint-correlation record, never before it: `D05_SELECT_NEXT_UNIT`'s\n    own invariant (`accepted_ordinal == len(accepted receipts in closure)`)\n    would otherwise be satisfiable by a cursor that outran its correlation\n    evidence, which is exactly the ordering spec section 6.2's D23 row and\n    this node's own TEST 7 forbid.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    accepted = state.get(\"accepted_unit_receipts\") or {}\n    receipt = accepted.get(unit_id)\n    require(isinstance(receipt, Mapping), \"integrity\", \"D23 requires an accepted receipt\", unit_id=unit_id)\n\n    evidence_entries = state.get(\"evidence_index_entries\") or []\n    existing_checkpoints = state.get(\"checkpoint_metadata\") or []\n    checkpoint_id = f\"ckpt-{unit_id}-{receipt['receipt_hash'][:16]}\"\n\n    checkpoint_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n        \"run_id\": state.get(\"run_id\"),\n        \"episode_id\": state.get(\"episode_id\"),\n        \"evidence_ordinal\": len(evidence_entries),\n        \"prior_checkpoint_count\": len(existing_checkpoints),\n    }\n\n    correlation_record = {\n        \"key\": canonical_digest({\"unit_id\": unit_id, \"checkpoint_id\": checkpoint_id, \"kind\": \"accepted_unit_checkpoint\"}),\n        \"unit_id\": unit_id,\n        \"checkpoint_id\": checkpoint_id,\n        \"receipt_hash\": receipt[\"receipt_hash\"],\n    }\n\n    effective_run = state.get(\"effective_run\") or {}\n    closure = effective_run.get(\"target_closure\") or []\n    cursor = dict(state.get(\"cursor\") or {})\n    manifest_ordinal = cursor.get(\"manifest_ordinal\", closure.index(unit_id) + 1 if unit_id in closure else 0)\n    accepted_ordinal = len([member for member in closure if member in accepted]) if closure else cursor.get(\"accepted_ordinal\", 0) + 1\n    if unit_id not in closure:\n        # Defensive: D05 always selects from the closure, so this is unreachable\n        # in the real pipeline; kept explicit rather than silently trusting\n        # an out-of-closure cursor advance.\n        raise SystemFailure(\"integrity\", \"checkpointed unit is not in the frozen target closure\", {\"unit_id\": unit_id})\n\n    return {\n        \"checkpoint_metadata\": [checkpoint_record],\n        \"accepted_unit_checkpoint_receipts\": [correlation_record],\n        \"cursor\": {\"manifest_ordinal\": manifest_ordinal, \"accepted_ordinal\": accepted_ordinal},\n        \"pending_guard\": _guard(\n            \"D23_CHECKPOINT_ACCEPTED_UNIT\", \"checkpoint_correlated\",\n            unit_id=unit_id, checkpoint_id=checkpoint_id,\n        ),\n    }\n","numLines":433,"startLine":1,"totalLines":433}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HhCcehCpZ6g4r5V4L3v1Jw","type":"tool_result","content":"1\t\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n2\t\n3\tOwns finding classification, one-partition-member repair planning, deterministic\n4\tvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\n5\tunit repair cycle here and reused by the workbook repair cycle N32 builds over\n6\t`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\n7\tmachinery is one engine, not a per-caller copy).\n8\t\n9\tNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\n10\tregistered as graph nodes yet (that registration is N32's write, once\n11\t`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\n12\tscoped `(state, runtime_context) -> update` callables in the same shape N23's\n13\t`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n14\t`nodes.deterministic_node()`. A future registration step binds them to their\n15\tcatalogue rows without changing this module.\n16\t\n17\tEvery finding this engine classifies is normalized to spec section 12's\n18\t`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\n19\tOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n20\t(code-owned), and a model review's own `category` field is deliberately never\n21\tread as an owner -- `owner_for_review_category()` is the one place a category\n22\tstring is mapped to the five-owner vocabulary, and an unmapped category is a\n23\tsystem fault, not a silent guess.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport json\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom typing import Any\n31\t\n32\tfrom .nodes import (\n33\t    SystemFailure,\n34\t    candidate_payload,\n35\t    canonical_digest,\n36\t    latest_model_candidate,\n37\t    require,\n38\t    staged_dispatch,\n39\t    stream_id,\n40\t    worker_packet,\n41\t)\n42\t\n43\t__all__ = [\n44\t    \"REPAIR_OWNERS\",\n45\t    \"CHANNEL_BY_OWNER\",\n46\t    \"MODEL_ONLY_OWNERS\",\n47\t    \"DETERMINISTIC_ONLY_OWNERS\",\n48\t    \"CONDITIONAL_OWNERS\",\n49\t    \"RETEST_FIRST_NODE\",\n50\t    \"RETEST_ORDER_BY_OWNER\",\n51\t    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n52\t    \"MAX_FINGERPRINT_REPEATS\",\n53\t    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n54\t    \"RepairEngineError\",\n55\t    \"owner_for_review_category\",\n56\t    \"normalize_findings\",\n57\t    \"finding_fingerprint\",\n58\t    \"route_owner\",\n59\t    \"json_pointer_diff\",\n60\t    \"within_boundary\",\n61\t    \"D17_CLASSIFY_UNIT_FINDINGS\",\n62\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n63\t    \"D19_ROUTE_UNIT_REPAIR\",\n64\t    \"D20_ADMIT_UNIT_REPAIR\",\n65\t    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n66\t]\n67\t\n68\t\n69\tclass RepairEngineError(SystemFailure):\n70\t    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n71\t\n72\t\n73\t# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n74\t# this set is a legal `owner`; a finding naming anything else fails closed.\n75\tREPAIR_OWNERS: tuple[str, ...] = (\n76\t    \"source interpretation\",\n77\t    \"curriculum domain\",\n78\t    \"unit content\",\n79\t    \"unit visual\",\n80\t    \"unit layout\",\n81\t)\n82\t\n83\t# The artifact-versions channel each owner's repair targets. Source\n84\t# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n85\t# is a pointer inside the same admitted domain body a curriculum-domain defect\n86\t# would touch, differing only in which pointers are named and in dispatch\n87\t# eligibility below.\n88\tCHANNEL_BY_OWNER: Mapping[str, str] = {\n89\t    \"curriculum domain\": \"domain\",\n90\t    \"source interpretation\": \"domain\",\n91\t    \"unit content\": \"content\",\n92\t    \"unit visual\": \"visuals\",\n93\t    \"unit layout\": \"layout\",\n94\t}\n95\t\n96\t# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n97\t# table. A curriculum-domain or unit-content defect is model-owned outright.\n98\t# Layout has a deterministic renderer/template repair path and no model path in\n99\t# this generation, so it is always deterministic. Source interpretation could\n100\t# legally refetch deterministically when a locator remains authorized; this\n101\t# generation always routes it to M06 rather than re-implementing a fetcher here\n102\t# (repair.py owns the routing table, not a second source-retrieval stack), and\n103\t# that choice is exactly the one spec section 12 leaves open (\"M06 repairs only\n104\t# the named interpretation ... admission is code-owned\"). Unit visual is the one\n105\t# genuinely conditional row: an authoritative/library visual is always\n106\t# rerun deterministically (a model may never assert authoritative circuit/pin\n107\t# detail per spec section 13), and a non-authoritative asset is model-eligible.\n108\tMODEL_ONLY_OWNERS: frozenset[str] = frozenset(\n109\t    {\"curriculum domain\", \"unit content\", \"source interpretation\"}\n110\t)\n111\tDETERMINISTIC_ONLY_OWNERS: frozenset[str] = frozenset({\"unit layout\"})\n112\tCONDITIONAL_OWNERS: frozenset[str] = frozenset({\"unit visual\"})\n113\t\n114\t# The first deterministic node of each owner's fixed retest chain (spec section\n115\t# 12's table). Every value here is a real `RESUME_REENTRY_DESTINATIONS` member\n116\t# of `unit_graph.py`; the remaining steps of a chain are not dispatched by D21 at\n117\t# all -- they are the already-wired unit-path edges the first node's own success\n118\t# guard reaches on its own (D07 -> D08 -> D09 -> D10 -> ... -> D16).\n119\tRETEST_FIRST_NODE: Mapping[str, str] = {\n120\t    \"source interpretation\": \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n121\t    \"curriculum domain\": \"D08_VALIDATE_DOMAIN\",\n122\t    \"unit content\": \"D09_VALIDATE_CONTENT\",\n123\t    \"unit visual\": \"D10_COMPILE_VISUAL_BRIEFS\",\n124\t    \"unit layout\": \"D13_RENDER_UNIT\",\n125\t}\n126\t\n127\tRETEST_ORDER_BY_OWNER: Mapping[str, tuple[str, ...]] = {\n128\t    \"source interpretation\": (\n129\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\", \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\",\n130\t        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n131\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n132\t    ),\n133\t    \"curriculum domain\": (\n134\t        \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\",\n135\t        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n136\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n137\t    ),\n138\t    \"unit content\": (\n139\t        \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\",\n140\t        \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n141\t        \"D16_REDUCE_UNIT_EVIDENCE\",\n142\t    ),\n143\t    \"unit visual\": (\n144\t        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n145\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n146\t    ),\n147\t    \"unit layout\": (\n148\t        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n149\t        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n150\t    ),\n151\t}\n152\t\n153\t# Frozen limits (spec section 12): three repair children per owner/finding\n154\t# chain, two occurrences of the same fingerprint. The earliest reached bound\n155\t# controls -- `D18_PLAN_TARGETED_UNIT_REPAIR` checks both and never dispatches\n156\t# a fourth child or a third repeat of the same defect.\n157\tMAX_REPAIR_CHILDREN_PER_CHAIN = 3\n158\tMAX_FINGERPRINT_REPEATS = 2\n159\t\n160\t# A model review's own `category` vocabulary is never trusted directly; this is\n161\t# the one code-owned mapping from a reviewer's free-text category to the fixed\n162\t# five-owner vocabulary. Substring match on a normalized (lowercased) category\n163\t# keeps the rubric free to phrase categories in prose while still refusing an\n164\t# unmapped one rather than guessing.\n165\t_REVIEW_CATEGORY_OWNER_KEYWORDS: tuple[tuple[str, str], ...] = (\n166\t    (\"source\", \"source interpretation\"),\n167\t    (\"citation\", \"source interpretation\"),\n168\t    (\"domain\", \"curriculum domain\"),\n169\t    (\"fact\", \"curriculum domain\"),\n170\t    (\"content\", \"unit content\"),\n171\t    (\"prose\", \"unit content\"),\n172\t    (\"pedagog\", \"unit content\"),\n173\t    (\"readab\", \"unit content\"),\n174\t    (\"safety\", \"unit content\"),\n175\t    (\"bloom\", \"unit content\"),\n176\t    (\"visual\", \"unit visual\"),\n177\t    (\"image\", \"unit visual\"),\n178\t    (\"diagram\", \"unit visual\"),\n179\t    (\"layout\", \"unit layout\"),\n180\t    (\"page\", \"unit layout\"),\n181\t    (\"render\", \"unit layout\"),\n182\t)\n183\t\n184\tDETERMINISTIC_REPAIR_CANDIDATE_KIND = \"deterministic_repair_candidate\"\n185\t\n186\t\n187\tdef owner_for_review_category(category: Any) -> str | None:\n188\t    \"\"\"Map one M05 review `category` string to a code-owned owner, or None.\n189\t\n190\t    Never returns the model's own words: the return value is always one member\n191\t    of `REPAIR_OWNERS`, decided by this frozen table, or None when no keyword\n192\t    matches -- which the caller treats as an unknown-owner system fault, not a\n193\t    best guess.\n194\t    \"\"\"\n195\t\n196\t    if not isinstance(category, str) or not category:\n197\t        return None\n198\t    lowered = category.lower()\n199\t    for keyword, owner in _REVIEW_CATEGORY_OWNER_KEYWORDS:\n200\t        if keyword in lowered:\n201\t            return owner\n202\t    return None\n203\t\n204\t\n205\tdef finding_fingerprint(owner: str, boundary: Sequence[str], message: Any) -> str:\n206\t    \"\"\"The stable identity of a defect across repeated repair attempts.\n207\t\n208\t    Keyed on owner, boundary pointers, and message -- not on `finding_id` (which\n209\t    a fresh classification pass may mint differently) and not on attempt number\n210\t    (which must never enter a fingerprint that exists to detect repeated\n211\t    failure across attempts).\n212\t    \"\"\"\n213\t\n214\t    return canonical_digest({\"owner\": owner, \"boundary\": sorted(boundary), \"message\": str(message)})\n215\t\n216\t\n217\tdef normalize_findings(\n218\t    raw_findings: Sequence[Mapping[str, Any]],\n219\t    *,\n220\t    unit_id: str,\n221\t    source_node: str,\n222\t    artifact_heads: Mapping[str, Any],\n223\t) -> list[dict[str, Any]]:\n224\t    \"\"\"Normalize a raw findings list to spec section 12's one shape.\n225\t\n226\t    Fails closed (`SystemFailure`) on any finding with no owner, an owner\n227\t    outside the fixed vocabulary, or a missing pointer -- `D17` never routes a\n228\t    zero- or unknown-owner finding into a partition; it raises before one is\n229\t    built. A caller with only one already-classified finding (the D91\n230\t    model-repair-failure case) still goes through this function, so the same\n231\t    checks apply uniformly.\n232\t    \"\"\"\n233\t\n234\t    normalized: list[dict[str, Any]] = []\n235\t    for raw in raw_findings:\n236\t        if not isinstance(raw, Mapping):\n237\t            raise SystemFailure(\n238\t                \"invalid_input\", \"a finding must be a JSON object\", {\"source_node\": source_node}\n239\t            )\n240\t        owner = raw.get(\"owner\")\n241\t        if owner not in REPAIR_OWNERS:\n242\t            raise SystemFailure(\n243\t                \"invalid_input\",\n244\t                f\"finding declares owner {owner!r}, which is not one of the five known owners\",\n245\t                {\"unit_id\": unit_id, \"source_node\": source_node, \"owner\": owner},\n246\t            )\n247\t        pointer = raw.get(\"pointer\")\n248\t        if not isinstance(pointer, str) or not pointer:\n249\t            raise SystemFailure(\n250\t                \"invalid_input\", \"finding declares no boundary pointer\",\n251\t                {\"unit_id\": unit_id, \"owner\": owner},\n252\t            )\n253\t        channel = CHANNEL_BY_OWNER[owner]\n254\t        parent_head = artifact_heads.get(stream_id(unit_id, channel))\n255\t        parent_hash = parent_head.get(\"hash\") if isinstance(parent_head, Mapping) else None\n256\t        message = raw.get(\"message\", \"\")\n257\t        finding_id = canonical_digest(\n258\t            {\"unit_id\": unit_id, \"owner\": owner, \"pointer\": pointer, \"message\": str(message)}\n259\t        )\n260\t        raw_facts = raw.get(\"allowed_facts\")\n261\t        allowed_facts = dict(raw_facts) if isinstance(raw_facts, Mapping) else {}\n262\t        normalized.append(\n263\t            {\n264\t                \"finding_id\": finding_id,\n265\t                \"evidence_key\": str(raw.get(\"check_id\", source_node)),\n266\t                \"owner\": owner,\n267\t                \"boundary\": pointer,\n268\t                \"parent_hash\": parent_hash,\n269\t                \"fingerprint\": finding_fingerprint(owner, [pointer], message),\n270\t                \"message\": str(message),\n271\t                \"unit_id\": unit_id,\n272\t                \"source_node\": source_node,\n273\t                \"allowed_facts\": allowed_facts,\n274\t            }\n275\t        )\n276\t    return normalized\n277\t\n278\t\n279\tdef route_owner(owner: str, *, state: Mapping[str, Any], findings: Sequence[Mapping[str, Any]]) -> str:\n280\t    \"\"\"Deterministic-vs-model dispatch for one owner's findings (spec section 12).\"\"\"\n281\t\n282\t    if owner in DETERMINISTIC_ONLY_OWNERS:\n283\t        return \"deterministic\"\n284\t    if owner in MODEL_ONLY_OWNERS:\n285\t        return \"model\"\n286\t    if owner not in CONDITIONAL_OWNERS:\n287\t        raise RepairEngineError(\"integrity\", f\"owner {owner!r} has no dispatch rule\", {\"owner\": owner})\n288\t    # unit visual: deterministic only if every named key is an authoritative or\n289\t    # library visual brief; a model may never touch one (spec section 13).\n290\t    briefs = {\n291\t        brief.get(\"key\"): brief\n292\t        for brief in state.get(\"visual_briefs\", [])\n293\t        if isinstance(brief, Mapping)\n294\t    }\n295\t    for finding in findings:\n296\t        key = str(finding.get(\"boundary\", \"\")).strip(\"/\").split(\"/\")[-1]\n297\t        brief = briefs.get(key)\n298\t        authoritative = bool(brief.get(\"authoritative\")) if isinstance(brief, Mapping) else False\n299\t        if not authoritative:\n300\t            return \"model\"\n301\t    return \"deterministic\"\n302\t\n303\t\n304\tdef _escape_token(token: str) -> str:\n305\t    return token.replace(\"~\", \"~0\").replace(\"/\", \"~1\")\n306\t\n307\t\n308\tdef json_pointer_diff(parent: Any, child: Any, path: str = \"\") -> set[str]:\n309\t    \"\"\"Every leaf JSON pointer at which ``parent`` and ``child`` differ.\"\"\"\n310\t\n311\t    if parent == child:\n312\t        return set()\n313\t    if isinstance(parent, Mapping) and isinstance(child, Mapping):\n314\t        diffs: set[str] = set()\n315\t        for key in sorted(set(parent) | set(child)):\n316\t            sub = f\"{path}/{_escape_token(str(key))}\"\n317\t            if key not in parent or key not in child:\n318\t                diffs.add(sub)\n319\t            else:\n320\t                diffs |= json_pointer_diff(parent[key], child[key], sub)\n321\t        return diffs\n322\t    if isinstance(parent, list) and isinstance(child, list):\n323\t        diffs = set()\n324\t        for index in range(max(len(parent), len(child))):\n325\t            sub = f\"{path}/{index}\"\n326\t            if index >= len(parent) or index >= len(child):\n327\t                diffs.add(sub)\n328\t            else:\n329\t                diffs |= json_pointer_diff(parent[index], child[index], sub)\n330\t        return diffs\n331\t    return {path or \"/\"}\n332\t\n333\t\n334\tdef within_boundary(pointer: str, allowed: Sequence[str]) -> bool:\n335\t    \"\"\"Whether ``pointer`` is exactly, or nested under, one declared boundary pointer.\"\"\"\n336\t\n337\t    return any(pointer == allow or pointer.startswith(f\"{allow}/\") for allow in allowed)\n338\t\n339\t\n340\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n341\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n342\t\n343\t\n344\tdef _attempt_key(unit_id: str, owner: str, fingerprint: str) -> str:\n345\t    return f\"repair|{unit_id}|{owner}|{fingerprint}\"\n346\t\n347\t\n348\tdef _repeat_key(unit_id: str, owner: str, fingerprint: str) -> str:\n349\t    return f\"repeat|{unit_id}|{owner}|{fingerprint}\"\n350\t\n351\t\n352\t# --------------------------------------------------------------------------\n353\t# D17_CLASSIFY_UNIT_FINDINGS\n354\t# --------------------------------------------------------------------------\n355\t\n356\t\n357\tdef D17_CLASSIFY_UNIT_FINDINGS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n358\t    \"\"\"Total one-owner partition of the current findings, or honest exhaustion.\n359\t\n360\t    Reads whichever repairable branch reached it: a `pending_guard` carrying a\n361\t    `findings` list from D08/D09/D12/D14/D16, or a `pending_failure` a D91\n362\t    model-repair classification left with no structured findings at all. Every\n363\t    blocking finding appears in exactly one owner's partition entry; an\n364\t    unowned or cross-owner-contaminated finding is a system fault, never a\n365\t    silently dropped one (spec section 6.2 D17 row).\n366\t    \"\"\"\n367\t\n368\t    unit_id = state.get(\"selected_unit_id\")\n369\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n370\t    require(\n371\t        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n372\t        \"integrity\",\n373\t        \"an accepted unit can never re-enter finding classification\",\n374\t        unit_id=unit_id,\n375\t    )\n376\t\n377\t    artifact_heads = state.get(\"artifact_heads\") or {}\n378\t    guard_record = state.get(\"pending_guard\")\n379\t    pending_failure = state.get(\"pending_failure\")\n380\t    update: dict[str, Any] = {}\n381\t\n382\t    if isinstance(pending_failure, Mapping) and pending_failure.get(\"classification\") == \"repair\":\n383\t        job_id = pending_failure.get(\"job_id\")\n384\t        owner = {\n385\t            \"M02_CREATE_UNIT_DOMAIN_DATA\": \"curriculum domain\",\n386\t            \"M03_WRITE_UNIT_CONTENT\": \"unit content\",\n387\t            \"M04_CREATE_UNIT_VISUALS\": \"unit visual\",\n388\t            \"M01_RESEARCH_UNIT_SOURCES\": \"source interpretation\",\n389\t            \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": None,\n390\t        }.get(job_id)\n391\t        require(\n392\t            owner in REPAIR_OWNERS,\n393\t            \"invalid_input\",\n394\t            f\"model failure for {job_id!r} maps to no known repair owner\",\n395\t            job_id=job_id,\n396\t        )\n397\t        raw_findings = [\n398\t            {\n399\t                \"owner\": owner,\n400\t                \"pointer\": f\"/{CHANNEL_BY_OWNER[owner]}\",\n401\t                \"check_id\": pending_failure.get(\"failure_class\"),\n402\t                \"message\": pending_failure.get(\"detail\") or pending_failure.get(\"message\") or \"\",\n403\t            }\n404\t        ]\n405\t        source_node = \"D91_CLASSIFY_MODEL_FAILURE\"\n406\t        update[\"pending_failure\"] = None\n407\t    else:\n408\t        require(isinstance(guard_record, Mapping), \"invalid_input\", \"D17 has no findings to classify\")\n409\t        detail = guard_record.get(\"detail\") if isinstance(guard_record.get(\"detail\"), Mapping) else {}\n410\t        raw_findings = detail.get(\"findings\")\n411\t        require(\n412\t            isinstance(raw_findings, list) and bool(raw_findings),\n413\t            \"invalid_input\",\n414\t            \"D17 was routed with an empty or missing findings list\",\n415\t        )\n416\t        source_node = str(guard_record.get(\"node\") or \"\")\n417\t\n418\t    normalized = normalize_findings(\n419\t        raw_findings, unit_id=unit_id, source_node=source_node, artifact_heads=artifact_heads\n420\t    )\n421\t\n422\t    by_owner: dict[str, list[dict[str, Any]]] = {}\n423\t    for finding in normalized:\n424\t        by_owner.setdefault(finding[\"owner\"], []).append(finding)\n425\t\n426\t    counters = dict(state.get(\"attempt_counters\") or {})\n427\t    exhausted: list[dict[str, Any]] = []\n428\t    partitions: list[dict[str, Any]] = []\n429\t    for owner in REPAIR_OWNERS:\n430\t        members = by_owner.get(owner)\n431\t        if not members:\n432\t            continue\n433\t        # D17 owns only the repeated-fingerprint bound; the numeric attempt\n434\t        # bound is D18's row of spec section 6.2 (\"D18 ... attempt bound =\n435\t        # exhaustion\"), checked once D18 has reserved the next attempt ordinal.\n436\t        fingerprint = canonical_digest(sorted(m[\"fingerprint\"] for m in members))\n437\t        repeat_key = _repeat_key(unit_id, owner, fingerprint)\n438\t        prior_repeats = int(counters.get(repeat_key, 0))\n439\t        if prior_repeats >= MAX_FINGERPRINT_REPEATS:\n440\t            exhausted.append({\"owner\": owner, \"fingerprint\": fingerprint, \"bound\": \"fingerprint_bound\", \"repeats\": prior_repeats})\n441\t            continue\n442\t        attempt_key = _attempt_key(unit_id, owner, fingerprint)\n443\t        prior_attempts = int(counters.get(attempt_key, 0))\n444\t        partitions.append(\n445\t            {\n446\t                \"key\": canonical_digest({\"unit_id\": unit_id, \"owner\": owner, \"fingerprint\": fingerprint, \"attempt\": prior_attempts + 1}),\n447\t                \"unit_id\": unit_id,\n448\t                \"owner\": owner,\n449\t                \"findings\": members,\n450\t                \"fingerprint\": fingerprint,\n451\t                \"prior_repeats\": prior_repeats,\n452\t                \"prior_attempts\": prior_attempts,\n453\t                \"source_node\": source_node,\n454\t            }\n455\t        )\n456\t\n457\t    if exhausted:\n458\t        update.update(\n459\t            {\n460\t                \"finding_partitions\": partitions,\n461\t                \"unit_status\": {unit_id: \"REPAIRING\"},\n462\t                \"pending_guard\": _guard(\n463\t                    \"D17_CLASSIFY_UNIT_FINDINGS\", \"convergence_exhausted\",\n464\t                    unit_id=unit_id, exhausted=exhausted,\n465\t                ),\n466\t                \"terminal_candidate\": {\n467\t                    \"kind\": \"CONVERGENCE_EXHAUSTED\",\n468\t                    \"bound\": exhausted[0][\"bound\"],\n469\t                    \"counters\": counters,\n470\t                    \"fingerprints\": [dict(item) for item in exhausted],\n471\t                    \"last_findings\": normalized,\n472\t                },\n473\t            }\n474\t        )\n475\t        return update\n476\t\n477\t    require(bool(partitions), \"invalid_input\", \"no owner produced a repair partition\")\n478\t\n479\t    update.update(\n480\t        {\n481\t            \"finding_partitions\": partitions,\n482\t            \"unit_status\": {unit_id: \"REPAIRING\"},\n483\t            \"pending_guard\": _guard(\n484\t                \"D17_CLASSIFY_UNIT_FINDINGS\", \"partition_complete\",\n485\t                unit_id=unit_id, owners=[entry[\"owner\"] for entry in partitions],\n486\t            ),\n487\t        }\n488\t    )\n489\t    return update\n490\t\n491\t\n492\t# --------------------------------------------------------------------------\n493\t# D18_PLAN_TARGETED_UNIT_REPAIR\n494\t# --------------------------------------------------------------------------\n495\t\n496\t\n497\tdef D18_PLAN_TARGETED_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n498\t    \"\"\"Select exactly one partition member, in fixed owner order, and plan its repair.\"\"\"\n499\t\n500\t    unit_id = state.get(\"selected_unit_id\")\n501\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n502\t\n503\t    partitions = [\n504\t        entry\n505\t        for entry in state.get(\"finding_partitions\") or []\n506\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n507\t    ]\n508\t    require(bool(partitions), \"invalid_input\", \"D18 requires at least one classified partition\")\n509\t\n510\t    resolved = {\n511\t        entry.get(\"request_key\")\n512\t        for entry in state.get(\"retest_results\") or []\n513\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id and entry.get(\"resolved\")\n514\t    }\n515\t    open_requests = {\n516\t        entry.get(\"partition_key\")\n517\t        for entry in state.get(\"repair_requests\") or []\n518\t        if isinstance(entry, Mapping)\n519\t        and entry.get(\"unit_id\") == unit_id\n520\t        and entry.get(\"key\") not in resolved\n521\t    }\n522\t\n523\t    latest_by_owner: dict[str, dict[str, Any]] = {}\n524\t    for entry in partitions:\n525\t        latest_by_owner[entry[\"owner\"]] = entry\n526\t\n527\t    selected = None\n528\t    for owner in REPAIR_OWNERS:\n529\t        entry = latest_by_owner.get(owner)\n530\t        if entry is None or entry[\"key\"] in open_requests:\n531\t            continue\n532\t        selected = entry\n533\t        break\n534\t    require(selected is not None, \"invalid_input\", \"every classified partition already has an open repair request\")\n535\t\n536\t    counters = dict(state.get(\"attempt_counters\") or {})\n537\t    attempt_key = _attempt_key(unit_id, selected[\"owner\"], selected[\"fingerprint\"])\n538\t    ordinal = int(counters.get(attempt_key, 0)) + 1\n539\t    if ordinal > MAX_REPAIR_CHILDREN_PER_CHAIN:\n540\t        return {\n541\t            \"pending_guard\": _guard(\n542\t                \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"convergence_exhausted\",\n543\t                unit_id=unit_id, owner=selected[\"owner\"], ordinal=ordinal,\n544\t            ),\n545\t            \"terminal_candidate\": {\n546\t                \"kind\": \"CONVERGENCE_EXHAUSTED\",\n547\t                \"bound\": \"attempt_bound\",\n548\t                \"counters\": counters,\n549\t                \"fingerprints\": [selected[\"fingerprint\"]],\n550\t                \"last_findings\": selected[\"findings\"],\n551\t            },\n552\t        }\n553\t\n554\t    channel = CHANNEL_BY_OWNER[selected[\"owner\"]]\n555\t    stream = stream_id(unit_id, channel)\n556\t    boundary_pointers = sorted({finding[\"boundary\"] for finding in selected[\"findings\"]})\n557\t    parent_hash = next(\n558\t        (finding[\"parent_hash\"] for finding in selected[\"findings\"] if finding.get(\"parent_hash\")),\n559\t        None,\n560\t    )\n561\t    allowed_facts: dict[str, Any] = {}\n562\t    for finding in selected[\"findings\"]:\n563\t        allowed_facts.update(finding.get(\"allowed_facts\") or {})\n564\t\n565\t    request = {\n566\t        \"key\": canonical_digest({\"partition_key\": selected[\"key\"], \"attempt\": ordinal}),\n567\t        \"partition_key\": selected[\"key\"],\n568\t        \"unit_id\": unit_id,\n569\t        \"owner\": selected[\"owner\"],\n570\t        \"channel\": channel,\n571\t        \"stream\": stream,\n572\t        \"finding_ids\": [finding[\"finding_id\"] for finding in selected[\"findings\"]],\n573\t        \"boundary\": {\"json_pointers\": boundary_pointers},\n574\t        \"parent_hash\": parent_hash,\n575\t        \"allowed_facts\": allowed_facts,\n576\t        \"next_child_version\": None,\n577\t        \"invalidated_descendants\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n578\t        \"retest_order\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n579\t        \"attempt_ordinal\": ordinal,\n580\t        \"fingerprint\": selected[\"fingerprint\"],\n581\t        \"prior_repeats\": selected[\"prior_repeats\"],\n582\t        \"max_children\": MAX_REPAIR_CHILDREN_PER_CHAIN,\n583\t        \"max_fingerprint_repeats\": MAX_FINGERPRINT_REPEATS,\n584\t    }\n585\t\n586\t    return {\n587\t        \"attempt_counters\": {attempt_key: ordinal},\n588\t        \"repair_requests\": [request],\n589\t        \"pending_guard\": _guard(\n590\t            \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"repair_planned\",\n591\t            unit_id=unit_id, request_key=request[\"key\"],\n592\t        ),\n593\t    }\n594\t\n595\t\n596\t# --------------------------------------------------------------------------\n597\t# D19_ROUTE_UNIT_REPAIR\n598\t# --------------------------------------------------------------------------\n599\t\n600\t\n601\tdef _apply_pointer(body: Any, pointer: str, value: Any) -> Any:\n602\t    \"\"\"Return a copy of ``body`` with ``pointer`` (RFC 6901) set to ``value``.\"\"\"\n603\t\n604\t    tokens = [tok.replace(\"~1\", \"/\").replace(\"~0\", \"~\") for tok in pointer.strip(\"/\").split(\"/\") if tok != \"\"]\n605\t    if not tokens:\n606\t        return json.loads(json.dumps(value))\n607\t    root = json.loads(json.dumps(body)) if isinstance(body, (dict, list)) else {}\n608\t    cursor = root\n609\t    for token in tokens[:-1]:\n610\t        if isinstance(cursor, list):\n611\t            index = int(token)\n612\t            cursor = cursor[index]\n613\t        else:\n614\t            cursor = cursor.setdefault(token, {})\n615\t    last = tokens[-1]\n616\t    if isinstance(cursor, list):\n617\t        index = int(last)\n618\t        while len(cursor) <= index:\n619\t            cursor.append(None)\n620\t        cursor[index] = value\n621\t    else:\n622\t        cursor[last] = value\n623\t    return root\n624\t\n625\t\n626\tdef _deterministic_repair_candidate(\n627\t    request: Mapping[str, Any], parent_body: Mapping[str, Any]\n628\t) -> dict[str, Any]:\n629\t    \"\"\"Apply a code-owned, boundary-scoped correction to the parent body.\n630\t\n631\t    Every value this writes is derived from the request's own `allowed_facts`\n632\t    (facts the run already admitted), never invented: a deterministic repair\n633\t    with nothing admitted to correct a pointer with raises rather than leaving\n634\t    the pointer untouched, because a no-op staged as a repair would be an\n635\t    in-place repair wearing a versioned child's clothes.\n636\t    \"\"\"\n637\t\n638\t    body = parent_body\n639\t    allowed_facts = request.get(\"allowed_facts\") or {}\n640\t    for pointer in request[\"boundary\"][\"json_pointers\"]:\n641\t        if pointer not in allowed_facts:\n642\t            raise SystemFailure(\n643\t                \"invalid_input\",\n644\t                f\"deterministic repair has no admitted fact for boundary pointer {pointer!r}\",\n645\t                {\"unit_id\": request[\"unit_id\"], \"owner\": request[\"owner\"]},\n646\t            )\n647\t        body = _apply_pointer(body, pointer, allowed_facts[pointer])\n648\t    return body\n649\t\n650\t\n651\tdef D19_ROUTE_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n652\t    \"\"\"Route the planned repair request to its deterministic producer or to M06.\"\"\"\n653\t\n654\t    unit_id = state.get(\"selected_unit_id\")\n655\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n656\t\n657\t    requests = [\n658\t        entry\n659\t        for entry in state.get(\"repair_requests\") or []\n660\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n661\t    ]\n662\t    require(bool(requests), \"invalid_input\", \"D19 requires a planned repair request\")\n663\t    request = requests[-1]\n664\t\n665\t    partitions = {\n666\t        entry[\"key\"]: entry\n667\t        for entry in state.get(\"finding_partitions\") or []\n668\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n669\t    }\n670\t    partition = partitions.get(request[\"partition_key\"])\n671\t    require(partition is not None, \"join\", \"the routed repair request names no known partition\")\n672\t    findings = partition[\"findings\"]\n673\t\n674\t    invalidation = {\n675\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"invalidation\"}),\n676\t        \"unit_id\": unit_id,\n677\t        \"request_key\": request[\"key\"],\n678\t        \"owner\": request[\"owner\"],\n679\t        \"invalidated_descendants\": request[\"invalidated_descendants\"],\n680\t        \"retest_order\": request[\"retest_order\"],\n681\t    }\n682\t\n683\t    route = route_owner(request[\"owner\"], state=state, findings=findings)\n684\t    stream = request[\"stream\"]\n685\t    heads = state.get(\"artifact_heads\") or {}\n686\t    parent_head = heads.get(stream)\n687\t\n688\t    if route == \"model\":\n689\t        artifact_versions = state.get(\"artifact_versions\") or []\n690\t        parent_body = None\n691\t        if isinstance(parent_head, Mapping):\n692\t            for record in artifact_versions:\n693\t                if (\n694\t                    isinstance(record, Mapping)\n695\t                    and record.get(\"stream\") == stream\n696\t                    and record.get(\"hash\") == parent_head.get(\"hash\")\n697\t                ):\n698\t                    parent_body = record.get(\"body\")\n699\t                    break\n700\t        require(isinstance(parent_body, Mapping), \"invalid_input\", \"no admitted parent body to repair\", stream=stream)\n701\t\n702\t        packet = worker_packet(\n703\t            run_id=state.get(\"run_id\"),\n704\t            episode_id=state.get(\"episode_id\"),\n705\t            correlation_key=f\"{request['key']}/M06\",\n706\t            projection={\n707\t                \"owner\": request[\"owner\"],\n708\t                \"findings\": [\n709\t                    {\n710\t                        \"finding_id\": finding[\"finding_id\"],\n711\t                        \"owner\": finding[\"owner\"],\n712\t                        \"pointer\": finding[\"boundary\"],\n713\t                        \"message\": finding[\"message\"],\n714\t                    }\n715\t                    for finding in findings\n716\t                ],\n717\t                \"parent\": {\n718\t                    \"artifact_name\": f\"{request['channel']}:{unit_id}\",\n719\t                    \"artifact_body\": json.dumps(parent_body, sort_keys=True),\n720\t                    \"channel\": request[\"channel\"],\n721\t                    \"unit_id\": unit_id,\n722\t                    \"parent_sha256\": parent_head.get(\"hash\"),\n723\t                },\n724\t                \"boundary\": request[\"boundary\"],\n725\t                \"allowed_facts\": request.get(\"allowed_facts\") or {},\n726\t                \"invalidated_descendants\": request[\"invalidated_descendants\"],\n727\t                \"retest_order\": request[\"retest_order\"],\n728\t            },\n729\t        )\n730\t        return {\n731\t            \"invalidations\": [invalidation],\n732\t            \"pending_packet\": staged_dispatch(\"M06_REPAIR_NAMED_UNIT_ARTIFACT\", [packet]),\n733\t            \"pending_guard\": _guard(\n734\t                \"D19_ROUTE_UNIT_REPAIR\", \"model_repair\", unit_id=unit_id, request_key=request[\"key\"]\n735\t            ),\n736\t        }\n737\t\n738\t    # Deterministic route: this node both selects and produces the candidate,\n739\t    # since D20 is the one and only admission authority and no intervening\n740\t    # dispatch node exists on the deterministic side (spec section 12: a\n741\t    # deterministic repair producer \"receives no prompt\").\n742\t    parent_body, current_hash, _current_version, _head_tracked = _current_parent(state, stream)\n743\t    new_body = _deterministic_repair_candidate(request, parent_body)\n744\t    candidate = {\n745\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n746\t        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n747\t        \"pre_admission\": True,\n748\t        \"stream\": stream,\n749\t        \"channel\": request[\"channel\"],\n750\t        \"unit_id\": unit_id,\n751\t        \"request_key\": request[\"key\"],\n752\t        \"owner\": request[\"owner\"],\n753\t        \"parent_sha256\": current_hash,\n754\t        \"addressed_finding_ids\": request[\"finding_ids\"],\n755\t        \"body\": new_body,\n756\t    }\n757\t    return {\n758\t        \"invalidations\": [invalidation],\n759\t        \"artifact_versions\": [candidate],\n760\t        \"pending_guard\": _guard(\n761\t            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n762\t        ),\n763\t    }\n764\t\n765\t\n766\t# --------------------------------------------------------------------------\n767\t# D20_ADMIT_UNIT_REPAIR\n768\t# --------------------------------------------------------------------------\n769\t\n770\t\n771\tdef _latest_deterministic_candidate(\n772\t    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n773\t) -> dict[str, Any] | None:\n774\t    matches = [\n775\t        dict(record)\n776\t        for record in artifact_versions\n777\t        if isinstance(record, Mapping)\n778\t        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n779\t        and record.get(\"stream\") == stream\n780\t        and record.get(\"request_key\") == request_key\n781\t    ]\n782\t    return matches[-1] if matches else None\n783\t\n784\t\n785\tdef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool]:\n786\t    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n787\t\n788\t    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n789\t    layout does not (it is admitted by D13 as a plain append-unique version,\n790\t    the same convention `review.py` already reads it under). Both shapes\n791\t    resolve to one parent here so D20 admits either uniformly, and the fourth\n792\t    element tells the caller whether `artifact_heads` may legally be written.\n793\t    \"\"\"\n794\t\n795\t    heads = state.get(\"artifact_heads\") or {}\n796\t    head = heads.get(stream)\n797\t    artifact_versions = state.get(\"artifact_versions\") or []\n798\t    if isinstance(head, Mapping):\n799\t        for record in artifact_versions:\n800\t            if (\n801\t                isinstance(record, Mapping)\n802\t                and record.get(\"stream\") == stream\n803\t                and record.get(\"hash\") == head.get(\"hash\")\n804\t            ):\n805\t                return record.get(\"body\") or {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n806\t        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n807\t\n808\t    candidates = [\n809\t        record\n810\t        for record in artifact_versions\n811\t        if isinstance(record, Mapping)\n812\t        and record.get(\"stream\") == stream\n813\t        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n814\t    ]\n815\t    if not candidates:\n816\t        return {}, None, 0, False\n817\t    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n818\t    return latest.get(\"body\") or {}, latest.get(\"hash\"), int(latest.get(\"version\", 0)), False\n819\t\n820\t\n821\tdef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n822\t    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n823\t\n824\t    Recomputes the parent/child diff itself rather than trusting a model's own\n825\t    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n826\t    child that does not descend from the current head, is `SystemFailure`\n827\t    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n828\t    routed repairable finding, because a boundary violation is a build/model\n829\t    defect, not a product outcome to retry.\n830\t    \"\"\"\n831\t\n832\t    unit_id = state.get(\"selected_unit_id\")\n833\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n834\t\n835\t    requests = [\n836\t        entry\n837\t        for entry in state.get(\"repair_requests\") or []\n838\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n839\t    ]\n840\t    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n841\t    request = requests[-1]\n842\t    stream = request[\"stream\"]\n843\t    boundary = request[\"boundary\"][\"json_pointers\"]\n844\t    heads = state.get(\"artifact_heads\") or {}\n845\t    parent_head = heads.get(stream)\n846\t    artifact_versions = state.get(\"artifact_versions\") or []\n847\t\n848\t    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n849\t\n850\t    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n851\t    deterministic_candidate = _latest_deterministic_candidate(\n852\t        artifact_versions, stream=stream, request_key=request[\"key\"]\n853\t    )\n854\t    require(\n855\t        (model_candidate is not None) != (deterministic_candidate is not None),\n856\t        \"join\",\n857\t        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n858\t        unit_id=unit_id,\n859\t    )\n860\t\n861\t    if model_candidate is not None:\n862\t        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n863\t        child = payload.get(\"candidate_child\") or {}\n864\t        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n865\t        try:\n866\t            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n867\t        except (TypeError, ValueError) as error:\n868\t            raise SystemFailure(\n869\t                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n870\t            ) from error\n871\t        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n872\t    else:\n873\t        new_body = deterministic_candidate[\"body\"]\n874\t        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n875\t\n876\t    require(\n877\t        declared_parent_sha == current_hash,\n878\t        \"integrity\",\n879\t        \"the repair candidate's declared parent is not the current head (stale repair)\",\n880\t        stream=stream, declared=declared_parent_sha, current=current_hash,\n881\t    )\n882\t\n883\t    diff = json_pointer_diff(parent_body, new_body)\n884\t    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n885\t    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n886\t    require(\n887\t        not out_of_bound,\n888\t        \"integrity\",\n889\t        \"a repair candidate changed bytes outside its declared boundary\",\n890\t        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n891\t    )\n892\t\n893\t    child_record = {\n894\t        \"stream\": stream,\n895\t        \"version\": current_version + 1,\n896\t        \"parent_hash\": current_hash,\n897\t        \"hash\": canonical_digest(new_body),\n898\t        \"body\": new_body,\n899\t        \"minted_by\": \"targeted_repair_admission\",\n900\t        \"unit_id\": unit_id,\n901\t        \"channel\": request[\"channel\"],\n902\t        \"request_key\": request[\"key\"],\n903\t        \"owner\": request[\"owner\"],\n904\t        \"attempt\": request[\"attempt_ordinal\"],\n905\t    }\n906\t    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n907\t\n908\t    update: dict[str, Any] = {\n909\t        \"artifact_versions\": [child_record],\n910\t        \"pending_guard\": _guard(\n911\t            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n912\t            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n913\t        ),\n914\t    }\n915\t    if head_tracked:\n916\t        update[\"artifact_heads\"] = {\n917\t            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n918\t        }\n919\t    return update\n920\t\n921\t\n922\t# --------------------------------------------------------------------------\n923\t# D21_RETEST_REQUIRED_DESCENDANTS\n924\t# --------------------------------------------------------------------------\n925\t\n926\t\n927\tdef D21_RETEST_REQUIRED_DESCENDANTS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n928\t    \"\"\"Dispatch the earliest node of the fixed retest DAG, or close the frontier.\n929\t\n930\t    Dispatches exactly once per repair admission: the first named node's own\n931\t    success guard already re-enters the rest of the normal unit path (D07\n932\t    through D16), so this never loops internally and never names a model node\n933\t    as the stored destination (spec section 6.2 D92/D21: a model destination in\n934\t    a stored frontier is a system fault).\n935\t    \"\"\"\n936\t\n937\t    unit_id = state.get(\"selected_unit_id\")\n938\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n939\t\n940\t    invalidations = [\n941\t        entry\n942\t        for entry in state.get(\"invalidations\") or []\n943\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n944\t    ]\n945\t    require(bool(invalidations), \"invalid_input\", \"D21 requires an admitted invalidation record\")\n946\t    invalidation = invalidations[-1]\n947\t\n948\t    dispatched = {\n949\t        entry.get(\"request_key\")\n950\t        for entry in state.get(\"retest_results\") or []\n951\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n952\t    }\n953\t\n954\t    retest_order = invalidation[\"retest_order\"]\n955\t    request_key = invalidation[\"request_key\"]\n956\t    if not retest_order:\n957\t        return {\n958\t            \"pending_guard\": _guard(\n959\t                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n960\t            )\n961\t        }\n962\t\n963\t    result = {\n964\t        \"key\": canonical_digest({\"request_key\": request_key, \"kind\": \"retest_dispatch\"}),\n965\t        \"unit_id\": unit_id,\n966\t        \"request_key\": request_key,\n967\t        \"owner\": invalidation[\"owner\"],\n968\t        \"retest_order\": list(retest_order),\n969\t        \"dispatched_to\": retest_order[0],\n970\t        \"resolved\": True,\n971\t    }\n972\t\n973\t    if request_key in dispatched:\n974\t        return {\n975\t            \"pending_guard\": _guard(\n976\t                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n977\t            )\n978\t        }\n979\t\n980\t    return {\n981\t        \"retest_results\": [result],\n982\t        \"pending_guard\": _guard(\n983\t            \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_incomplete\",\n984\t            unit_id=unit_id, destination=retest_order[0],\n985\t        ),\n986\t    }\n987\t"}]},"parent_tool_use_id":null,"session_id":"e6e8e9a9-b2ab-43d8-92f4-9fc5395b5dac","uuid":"3a16f136-2975-464d-b50a-ebe9d4165be7","timestamp":"2026-08-12T19:53:54.258Z","tool_use_result":{"type":"text","file":{"filePath":"runtime/langgraph_factory/repair.py","content":"\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n\nOwns finding classification, one-partition-member repair planning, deterministic\nvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\nunit repair cycle here and reused by the workbook repair cycle N32 builds over\n`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\nmachinery is one engine, not a per-caller copy).\n\nNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\nregistered as graph nodes yet (that registration is N32's write, once\n`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\nscoped `(state, runtime_context) -> update` callables in the same shape N23's\n`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n`nodes.deterministic_node()`. A future registration step binds them to their\ncatalogue rows without changing this module.\n\nEvery finding this engine classifies is normalized to spec section 12's\n`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\nOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n(code-owned), and a model review's own `category` field is deliberately never\nread as an owner -- `owner_for_review_category()` is the one place a category\nstring is mapped to the five-owner vocabulary, and an unmapped category is a\nsystem fault, not a silent guess.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any\n\nfrom .nodes import (\n    SystemFailure,\n    candidate_payload,\n    canonical_digest,\n    latest_model_candidate,\n    require,\n    staged_dispatch,\n    stream_id,\n    worker_packet,\n)\n\n__all__ = [\n    \"REPAIR_OWNERS\",\n    \"CHANNEL_BY_OWNER\",\n    \"MODEL_ONLY_OWNERS\",\n    \"DETERMINISTIC_ONLY_OWNERS\",\n    \"CONDITIONAL_OWNERS\",\n    \"RETEST_FIRST_NODE\",\n    \"RETEST_ORDER_BY_OWNER\",\n    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n    \"MAX_FINGERPRINT_REPEATS\",\n    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n    \"RepairEngineError\",\n    \"owner_for_review_category\",\n    \"normalize_findings\",\n    \"finding_fingerprint\",\n    \"route_owner\",\n    \"json_pointer_diff\",\n    \"within_boundary\",\n    \"D17_CLASSIFY_UNIT_FINDINGS\",\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n    \"D19_ROUTE_UNIT_REPAIR\",\n    \"D20_ADMIT_UNIT_REPAIR\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n]\n\n\nclass RepairEngineError(SystemFailure):\n    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n\n\n# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n# this set is a legal `owner`; a finding naming anything else fails closed.\nREPAIR_OWNERS: tuple[str, ...] = (\n    \"source interpretation\",\n    \"curriculum domain\",\n    \"unit content\",\n    \"unit visual\",\n    \"unit layout\",\n)\n\n# The artifact-versions channel each owner's repair targets. Source\n# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n# is a pointer inside the same admitted domain body a curriculum-domain defect\n# would touch, differing only in which pointers are named and in dispatch\n# eligibility below.\nCHANNEL_BY_OWNER: Mapping[str, str] = {\n    \"curriculum domain\": \"domain\",\n    \"source interpretation\": \"domain\",\n    \"unit content\": \"content\",\n    \"unit visual\": \"visuals\",\n    \"unit layout\": \"layout\",\n}\n\n# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n# table. A curriculum-domain or unit-content defect is model-owned outright.\n# Layout has a deterministic renderer/template repair path and no model path in\n# this generation, so it is always deterministic. Source interpretation could\n# legally refetch deterministically when a locator remains authorized; this\n# generation always routes it to M06 rather than re-implementing a fetcher here\n# (repair.py owns the routing table, not a second source-retrieval stack), and\n# that choice is exactly the one spec section 12 leaves open (\"M06 repairs only\n# the named interpretation ... admission is code-owned\"). Unit visual is the one\n# genuinely conditional row: an authoritative/library visual is always\n# rerun deterministically (a model may never assert authoritative circuit/pin\n# detail per spec section 13), and a non-authoritative asset is model-eligible.\nMODEL_ONLY_OWNERS: frozenset[str] = frozenset(\n    {\"curriculum domain\", \"unit content\", \"source interpretation\"}\n)\nDETERMINISTIC_ONLY_OWNERS: frozenset[str] = frozenset({\"unit layout\"})\nCONDITIONAL_OWNERS: frozenset[str] = frozenset({\"unit visual\"})\n\n# The first deterministic node of each owner's fixed retest chain (spec section\n# 12's table). Every value here is a real `RESUME_REENTRY_DESTINATIONS` member\n# of `unit_graph.py`; the remaining steps of a chain are not dispatched by D21 at\n# all -- they are the already-wired unit-path edges the first node's own success\n# guard reaches on its own (D07 -> D08 -> D09 -> D10 -> ... -> D16).\nRETEST_FIRST_NODE: Mapping[str, str] = {\n    \"source interpretation\": \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    \"curriculum domain\": \"D08_VALIDATE_DOMAIN\",\n    \"unit content\": \"D09_VALIDATE_CONTENT\",\n    \"unit visual\": \"D10_COMPILE_VISUAL_BRIEFS\",\n    \"unit layout\": \"D13_RENDER_UNIT\",\n}\n\nRETEST_ORDER_BY_OWNER: Mapping[str, tuple[str, ...]] = {\n    \"source interpretation\": (\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\", \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\",\n        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"curriculum domain\": (\n        \"D08_VALIDATE_DOMAIN\", \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\",\n        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit content\": (\n        \"D09_VALIDATE_CONTENT\", \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\",\n        \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n        \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit visual\": (\n        \"D10_COMPILE_VISUAL_BRIEFS\", \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n    \"unit layout\": (\n        \"D13_RENDER_UNIT\", \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n        \"D15_FREEZE_UNIT_REVIEW_PACKET\", \"D16_REDUCE_UNIT_EVIDENCE\",\n    ),\n}\n\n# Frozen limits (spec section 12): three repair children per owner/finding\n# chain, two occurrences of the same fingerprint. The earliest reached bound\n# controls -- `D18_PLAN_TARGETED_UNIT_REPAIR` checks both and never dispatches\n# a fourth child or a third repeat of the same defect.\nMAX_REPAIR_CHILDREN_PER_CHAIN = 3\nMAX_FINGERPRINT_REPEATS = 2\n\n# A model review's own `category` vocabulary is never trusted directly; this is\n# the one code-owned mapping from a reviewer's free-text category to the fixed\n# five-owner vocabulary. Substring match on a normalized (lowercased) category\n# keeps the rubric free to phrase categories in prose while still refusing an\n# unmapped one rather than guessing.\n_REVIEW_CATEGORY_OWNER_KEYWORDS: tuple[tuple[str, str], ...] = (\n    (\"source\", \"source interpretation\"),\n    (\"citation\", \"source interpretation\"),\n    (\"domain\", \"curriculum domain\"),\n    (\"fact\", \"curriculum domain\"),\n    (\"content\", \"unit content\"),\n    (\"prose\", \"unit content\"),\n    (\"pedagog\", \"unit content\"),\n    (\"readab\", \"unit content\"),\n    (\"safety\", \"unit content\"),\n    (\"bloom\", \"unit content\"),\n    (\"visual\", \"unit visual\"),\n    (\"image\", \"unit visual\"),\n    (\"diagram\", \"unit visual\"),\n    (\"layout\", \"unit layout\"),\n    (\"page\", \"unit layout\"),\n    (\"render\", \"unit layout\"),\n)\n\nDETERMINISTIC_REPAIR_CANDIDATE_KIND = \"deterministic_repair_candidate\"\n\n\ndef owner_for_review_category(category: Any) -> str | None:\n    \"\"\"Map one M05 review `category` string to a code-owned owner, or None.\n\n    Never returns the model's own words: the return value is always one member\n    of `REPAIR_OWNERS`, decided by this frozen table, or None when no keyword\n    matches -- which the caller treats as an unknown-owner system fault, not a\n    best guess.\n    \"\"\"\n\n    if not isinstance(category, str) or not category:\n        return None\n    lowered = category.lower()\n    for keyword, owner in _REVIEW_CATEGORY_OWNER_KEYWORDS:\n        if keyword in lowered:\n            return owner\n    return None\n\n\ndef finding_fingerprint(owner: str, boundary: Sequence[str], message: Any) -> str:\n    \"\"\"The stable identity of a defect across repeated repair attempts.\n\n    Keyed on owner, boundary pointers, and message -- not on `finding_id` (which\n    a fresh classification pass may mint differently) and not on attempt number\n    (which must never enter a fingerprint that exists to detect repeated\n    failure across attempts).\n    \"\"\"\n\n    return canonical_digest({\"owner\": owner, \"boundary\": sorted(boundary), \"message\": str(message)})\n\n\ndef normalize_findings(\n    raw_findings: Sequence[Mapping[str, Any]],\n    *,\n    unit_id: str,\n    source_node: str,\n    artifact_heads: Mapping[str, Any],\n) -> list[dict[str, Any]]:\n    \"\"\"Normalize a raw findings list to spec section 12's one shape.\n\n    Fails closed (`SystemFailure`) on any finding with no owner, an owner\n    outside the fixed vocabulary, or a missing pointer -- `D17` never routes a\n    zero- or unknown-owner finding into a partition; it raises before one is\n    built. A caller with only one already-classified finding (the D91\n    model-repair-failure case) still goes through this function, so the same\n    checks apply uniformly.\n    \"\"\"\n\n    normalized: list[dict[str, Any]] = []\n    for raw in raw_findings:\n        if not isinstance(raw, Mapping):\n            raise SystemFailure(\n                \"invalid_input\", \"a finding must be a JSON object\", {\"source_node\": source_node}\n            )\n        owner = raw.get(\"owner\")\n        if owner not in REPAIR_OWNERS:\n            raise SystemFailure(\n                \"invalid_input\",\n                f\"finding declares owner {owner!r}, which is not one of the five known owners\",\n                {\"unit_id\": unit_id, \"source_node\": source_node, \"owner\": owner},\n            )\n        pointer = raw.get(\"pointer\")\n        if not isinstance(pointer, str) or not pointer:\n            raise SystemFailure(\n                \"invalid_input\", \"finding declares no boundary pointer\",\n                {\"unit_id\": unit_id, \"owner\": owner},\n            )\n        channel = CHANNEL_BY_OWNER[owner]\n        parent_head = artifact_heads.get(stream_id(unit_id, channel))\n        parent_hash = parent_head.get(\"hash\") if isinstance(parent_head, Mapping) else None\n        message = raw.get(\"message\", \"\")\n        finding_id = canonical_digest(\n            {\"unit_id\": unit_id, \"owner\": owner, \"pointer\": pointer, \"message\": str(message)}\n        )\n        raw_facts = raw.get(\"allowed_facts\")\n        allowed_facts = dict(raw_facts) if isinstance(raw_facts, Mapping) else {}\n        normalized.append(\n            {\n                \"finding_id\": finding_id,\n                \"evidence_key\": str(raw.get(\"check_id\", source_node)),\n                \"owner\": owner,\n                \"boundary\": pointer,\n                \"parent_hash\": parent_hash,\n                \"fingerprint\": finding_fingerprint(owner, [pointer], message),\n                \"message\": str(message),\n                \"unit_id\": unit_id,\n                \"source_node\": source_node,\n                \"allowed_facts\": allowed_facts,\n            }\n        )\n    return normalized\n\n\ndef route_owner(owner: str, *, state: Mapping[str, Any], findings: Sequence[Mapping[str, Any]]) -> str:\n    \"\"\"Deterministic-vs-model dispatch for one owner's findings (spec section 12).\"\"\"\n\n    if owner in DETERMINISTIC_ONLY_OWNERS:\n        return \"deterministic\"\n    if owner in MODEL_ONLY_OWNERS:\n        return \"model\"\n    if owner not in CONDITIONAL_OWNERS:\n        raise RepairEngineError(\"integrity\", f\"owner {owner!r} has no dispatch rule\", {\"owner\": owner})\n    # unit visual: deterministic only if every named key is an authoritative or\n    # library visual brief; a model may never touch one (spec section 13).\n    briefs = {\n        brief.get(\"key\"): brief\n        for brief in state.get(\"visual_briefs\", [])\n        if isinstance(brief, Mapping)\n    }\n    for finding in findings:\n        key = str(finding.get(\"boundary\", \"\")).strip(\"/\").split(\"/\")[-1]\n        brief = briefs.get(key)\n        authoritative = bool(brief.get(\"authoritative\")) if isinstance(brief, Mapping) else False\n        if not authoritative:\n            return \"model\"\n    return \"deterministic\"\n\n\ndef _escape_token(token: str) -> str:\n    return token.replace(\"~\", \"~0\").replace(\"/\", \"~1\")\n\n\ndef json_pointer_diff(parent: Any, child: Any, path: str = \"\") -> set[str]:\n    \"\"\"Every leaf JSON pointer at which ``parent`` and ``child`` differ.\"\"\"\n\n    if parent == child:\n        return set()\n    if isinstance(parent, Mapping) and isinstance(child, Mapping):\n        diffs: set[str] = set()\n        for key in sorted(set(parent) | set(child)):\n            sub = f\"{path}/{_escape_token(str(key))}\"\n            if key not in parent or key not in child:\n                diffs.add(sub)\n            else:\n                diffs |= json_pointer_diff(parent[key], child[key], sub)\n        return diffs\n    if isinstance(parent, list) and isinstance(child, list):\n        diffs = set()\n        for index in range(max(len(parent), len(child))):\n            sub = f\"{path}/{index}\"\n            if index >= len(parent) or index >= len(child):\n                diffs.add(sub)\n            else:\n                diffs |= json_pointer_diff(parent[index], child[index], sub)\n        return diffs\n    return {path or \"/\"}\n\n\ndef within_boundary(pointer: str, allowed: Sequence[str]) -> bool:\n    \"\"\"Whether ``pointer`` is exactly, or nested under, one declared boundary pointer.\"\"\"\n\n    return any(pointer == allow or pointer.startswith(f\"{allow}/\") for allow in allowed)\n\n\ndef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n\n\ndef _attempt_key(unit_id: str, owner: str, fingerprint: str) -> str:\n    return f\"repair|{unit_id}|{owner}|{fingerprint}\"\n\n\ndef _repeat_key(unit_id: str, owner: str, fingerprint: str) -> str:\n    return f\"repeat|{unit_id}|{owner}|{fingerprint}\"\n\n\n# --------------------------------------------------------------------------\n# D17_CLASSIFY_UNIT_FINDINGS\n# --------------------------------------------------------------------------\n\n\ndef D17_CLASSIFY_UNIT_FINDINGS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Total one-owner partition of the current findings, or honest exhaustion.\n\n    Reads whichever repairable branch reached it: a `pending_guard` carrying a\n    `findings` list from D08/D09/D12/D14/D16, or a `pending_failure` a D91\n    model-repair classification left with no structured findings at all. Every\n    blocking finding appears in exactly one owner's partition entry; an\n    unowned or cross-owner-contaminated finding is a system fault, never a\n    silently dropped one (spec section 6.2 D17 row).\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n    require(\n        unit_id not in (state.get(\"accepted_unit_receipts\") or {}),\n        \"integrity\",\n        \"an accepted unit can never re-enter finding classification\",\n        unit_id=unit_id,\n    )\n\n    artifact_heads = state.get(\"artifact_heads\") or {}\n    guard_record = state.get(\"pending_guard\")\n    pending_failure = state.get(\"pending_failure\")\n    update: dict[str, Any] = {}\n\n    if isinstance(pending_failure, Mapping) and pending_failure.get(\"classification\") == \"repair\":\n        job_id = pending_failure.get(\"job_id\")\n        owner = {\n            \"M02_CREATE_UNIT_DOMAIN_DATA\": \"curriculum domain\",\n            \"M03_WRITE_UNIT_CONTENT\": \"unit content\",\n            \"M04_CREATE_UNIT_VISUALS\": \"unit visual\",\n            \"M01_RESEARCH_UNIT_SOURCES\": \"source interpretation\",\n            \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": None,\n        }.get(job_id)\n        require(\n            owner in REPAIR_OWNERS,\n            \"invalid_input\",\n            f\"model failure for {job_id!r} maps to no known repair owner\",\n            job_id=job_id,\n        )\n        raw_findings = [\n            {\n                \"owner\": owner,\n                \"pointer\": f\"/{CHANNEL_BY_OWNER[owner]}\",\n                \"check_id\": pending_failure.get(\"failure_class\"),\n                \"message\": pending_failure.get(\"detail\") or pending_failure.get(\"message\") or \"\",\n            }\n        ]\n        source_node = \"D91_CLASSIFY_MODEL_FAILURE\"\n        update[\"pending_failure\"] = None\n    else:\n        require(isinstance(guard_record, Mapping), \"invalid_input\", \"D17 has no findings to classify\")\n        detail = guard_record.get(\"detail\") if isinstance(guard_record.get(\"detail\"), Mapping) else {}\n        raw_findings = detail.get(\"findings\")\n        require(\n            isinstance(raw_findings, list) and bool(raw_findings),\n            \"invalid_input\",\n            \"D17 was routed with an empty or missing findings list\",\n        )\n        source_node = str(guard_record.get(\"node\") or \"\")\n\n    normalized = normalize_findings(\n        raw_findings, unit_id=unit_id, source_node=source_node, artifact_heads=artifact_heads\n    )\n\n    by_owner: dict[str, list[dict[str, Any]]] = {}\n    for finding in normalized:\n        by_owner.setdefault(finding[\"owner\"], []).append(finding)\n\n    counters = dict(state.get(\"attempt_counters\") or {})\n    exhausted: list[dict[str, Any]] = []\n    partitions: list[dict[str, Any]] = []\n    for owner in REPAIR_OWNERS:\n        members = by_owner.get(owner)\n        if not members:\n            continue\n        # D17 owns only the repeated-fingerprint bound; the numeric attempt\n        # bound is D18's row of spec section 6.2 (\"D18 ... attempt bound =\n        # exhaustion\"), checked once D18 has reserved the next attempt ordinal.\n        fingerprint = canonical_digest(sorted(m[\"fingerprint\"] for m in members))\n        repeat_key = _repeat_key(unit_id, owner, fingerprint)\n        prior_repeats = int(counters.get(repeat_key, 0))\n        if prior_repeats >= MAX_FINGERPRINT_REPEATS:\n            exhausted.append({\"owner\": owner, \"fingerprint\": fingerprint, \"bound\": \"fingerprint_bound\", \"repeats\": prior_repeats})\n            continue\n        attempt_key = _attempt_key(unit_id, owner, fingerprint)\n        prior_attempts = int(counters.get(attempt_key, 0))\n        partitions.append(\n            {\n                \"key\": canonical_digest({\"unit_id\": unit_id, \"owner\": owner, \"fingerprint\": fingerprint, \"attempt\": prior_attempts + 1}),\n                \"unit_id\": unit_id,\n                \"owner\": owner,\n                \"findings\": members,\n                \"fingerprint\": fingerprint,\n                \"prior_repeats\": prior_repeats,\n                \"prior_attempts\": prior_attempts,\n                \"source_node\": source_node,\n            }\n        )\n\n    if exhausted:\n        update.update(\n            {\n                \"finding_partitions\": partitions,\n                \"unit_status\": {unit_id: \"REPAIRING\"},\n                \"pending_guard\": _guard(\n                    \"D17_CLASSIFY_UNIT_FINDINGS\", \"convergence_exhausted\",\n                    unit_id=unit_id, exhausted=exhausted,\n                ),\n                \"terminal_candidate\": {\n                    \"kind\": \"CONVERGENCE_EXHAUSTED\",\n                    \"bound\": exhausted[0][\"bound\"],\n                    \"counters\": counters,\n                    \"fingerprints\": [dict(item) for item in exhausted],\n                    \"last_findings\": normalized,\n                },\n            }\n        )\n        return update\n\n    require(bool(partitions), \"invalid_input\", \"no owner produced a repair partition\")\n\n    update.update(\n        {\n            \"finding_partitions\": partitions,\n            \"unit_status\": {unit_id: \"REPAIRING\"},\n            \"pending_guard\": _guard(\n                \"D17_CLASSIFY_UNIT_FINDINGS\", \"partition_complete\",\n                unit_id=unit_id, owners=[entry[\"owner\"] for entry in partitions],\n            ),\n        }\n    )\n    return update\n\n\n# --------------------------------------------------------------------------\n# D18_PLAN_TARGETED_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef D18_PLAN_TARGETED_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Select exactly one partition member, in fixed owner order, and plan its repair.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    partitions = [\n        entry\n        for entry in state.get(\"finding_partitions\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(partitions), \"invalid_input\", \"D18 requires at least one classified partition\")\n\n    resolved = {\n        entry.get(\"request_key\")\n        for entry in state.get(\"retest_results\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id and entry.get(\"resolved\")\n    }\n    open_requests = {\n        entry.get(\"partition_key\")\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping)\n        and entry.get(\"unit_id\") == unit_id\n        and entry.get(\"key\") not in resolved\n    }\n\n    latest_by_owner: dict[str, dict[str, Any]] = {}\n    for entry in partitions:\n        latest_by_owner[entry[\"owner\"]] = entry\n\n    selected = None\n    for owner in REPAIR_OWNERS:\n        entry = latest_by_owner.get(owner)\n        if entry is None or entry[\"key\"] in open_requests:\n            continue\n        selected = entry\n        break\n    require(selected is not None, \"invalid_input\", \"every classified partition already has an open repair request\")\n\n    counters = dict(state.get(\"attempt_counters\") or {})\n    attempt_key = _attempt_key(unit_id, selected[\"owner\"], selected[\"fingerprint\"])\n    ordinal = int(counters.get(attempt_key, 0)) + 1\n    if ordinal > MAX_REPAIR_CHILDREN_PER_CHAIN:\n        return {\n            \"pending_guard\": _guard(\n                \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"convergence_exhausted\",\n                unit_id=unit_id, owner=selected[\"owner\"], ordinal=ordinal,\n            ),\n            \"terminal_candidate\": {\n                \"kind\": \"CONVERGENCE_EXHAUSTED\",\n                \"bound\": \"attempt_bound\",\n                \"counters\": counters,\n                \"fingerprints\": [selected[\"fingerprint\"]],\n                \"last_findings\": selected[\"findings\"],\n            },\n        }\n\n    channel = CHANNEL_BY_OWNER[selected[\"owner\"]]\n    stream = stream_id(unit_id, channel)\n    boundary_pointers = sorted({finding[\"boundary\"] for finding in selected[\"findings\"]})\n    parent_hash = next(\n        (finding[\"parent_hash\"] for finding in selected[\"findings\"] if finding.get(\"parent_hash\")),\n        None,\n    )\n    allowed_facts: dict[str, Any] = {}\n    for finding in selected[\"findings\"]:\n        allowed_facts.update(finding.get(\"allowed_facts\") or {})\n\n    request = {\n        \"key\": canonical_digest({\"partition_key\": selected[\"key\"], \"attempt\": ordinal}),\n        \"partition_key\": selected[\"key\"],\n        \"unit_id\": unit_id,\n        \"owner\": selected[\"owner\"],\n        \"channel\": channel,\n        \"stream\": stream,\n        \"finding_ids\": [finding[\"finding_id\"] for finding in selected[\"findings\"]],\n        \"boundary\": {\"json_pointers\": boundary_pointers},\n        \"parent_hash\": parent_hash,\n        \"allowed_facts\": allowed_facts,\n        \"next_child_version\": None,\n        \"invalidated_descendants\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n        \"retest_order\": list(RETEST_ORDER_BY_OWNER[selected[\"owner\"]]),\n        \"attempt_ordinal\": ordinal,\n        \"fingerprint\": selected[\"fingerprint\"],\n        \"prior_repeats\": selected[\"prior_repeats\"],\n        \"max_children\": MAX_REPAIR_CHILDREN_PER_CHAIN,\n        \"max_fingerprint_repeats\": MAX_FINGERPRINT_REPEATS,\n    }\n\n    return {\n        \"attempt_counters\": {attempt_key: ordinal},\n        \"repair_requests\": [request],\n        \"pending_guard\": _guard(\n            \"D18_PLAN_TARGETED_UNIT_REPAIR\", \"repair_planned\",\n            unit_id=unit_id, request_key=request[\"key\"],\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D19_ROUTE_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef _apply_pointer(body: Any, pointer: str, value: Any) -> Any:\n    \"\"\"Return a copy of ``body`` with ``pointer`` (RFC 6901) set to ``value``.\"\"\"\n\n    tokens = [tok.replace(\"~1\", \"/\").replace(\"~0\", \"~\") for tok in pointer.strip(\"/\").split(\"/\") if tok != \"\"]\n    if not tokens:\n        return json.loads(json.dumps(value))\n    root = json.loads(json.dumps(body)) if isinstance(body, (dict, list)) else {}\n    cursor = root\n    for token in tokens[:-1]:\n        if isinstance(cursor, list):\n            index = int(token)\n            cursor = cursor[index]\n        else:\n            cursor = cursor.setdefault(token, {})\n    last = tokens[-1]\n    if isinstance(cursor, list):\n        index = int(last)\n        while len(cursor) <= index:\n            cursor.append(None)\n        cursor[index] = value\n    else:\n        cursor[last] = value\n    return root\n\n\ndef _deterministic_repair_candidate(\n    request: Mapping[str, Any], parent_body: Mapping[str, Any]\n) -> dict[str, Any]:\n    \"\"\"Apply a code-owned, boundary-scoped correction to the parent body.\n\n    Every value this writes is derived from the request's own `allowed_facts`\n    (facts the run already admitted), never invented: a deterministic repair\n    with nothing admitted to correct a pointer with raises rather than leaving\n    the pointer untouched, because a no-op staged as a repair would be an\n    in-place repair wearing a versioned child's clothes.\n    \"\"\"\n\n    body = parent_body\n    allowed_facts = request.get(\"allowed_facts\") or {}\n    for pointer in request[\"boundary\"][\"json_pointers\"]:\n        if pointer not in allowed_facts:\n            raise SystemFailure(\n                \"invalid_input\",\n                f\"deterministic repair has no admitted fact for boundary pointer {pointer!r}\",\n                {\"unit_id\": request[\"unit_id\"], \"owner\": request[\"owner\"]},\n            )\n        body = _apply_pointer(body, pointer, allowed_facts[pointer])\n    return body\n\n\ndef D19_ROUTE_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Route the planned repair request to its deterministic producer or to M06.\"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    requests = [\n        entry\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(requests), \"invalid_input\", \"D19 requires a planned repair request\")\n    request = requests[-1]\n\n    partitions = {\n        entry[\"key\"]: entry\n        for entry in state.get(\"finding_partitions\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    }\n    partition = partitions.get(request[\"partition_key\"])\n    require(partition is not None, \"join\", \"the routed repair request names no known partition\")\n    findings = partition[\"findings\"]\n\n    invalidation = {\n        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"invalidation\"}),\n        \"unit_id\": unit_id,\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"invalidated_descendants\": request[\"invalidated_descendants\"],\n        \"retest_order\": request[\"retest_order\"],\n    }\n\n    route = route_owner(request[\"owner\"], state=state, findings=findings)\n    stream = request[\"stream\"]\n    heads = state.get(\"artifact_heads\") or {}\n    parent_head = heads.get(stream)\n\n    if route == \"model\":\n        artifact_versions = state.get(\"artifact_versions\") or []\n        parent_body = None\n        if isinstance(parent_head, Mapping):\n            for record in artifact_versions:\n                if (\n                    isinstance(record, Mapping)\n                    and record.get(\"stream\") == stream\n                    and record.get(\"hash\") == parent_head.get(\"hash\")\n                ):\n                    parent_body = record.get(\"body\")\n                    break\n        require(isinstance(parent_body, Mapping), \"invalid_input\", \"no admitted parent body to repair\", stream=stream)\n\n        packet = worker_packet(\n            run_id=state.get(\"run_id\"),\n            episode_id=state.get(\"episode_id\"),\n            correlation_key=f\"{request['key']}/M06\",\n            projection={\n                \"owner\": request[\"owner\"],\n                \"findings\": [\n                    {\n                        \"finding_id\": finding[\"finding_id\"],\n                        \"owner\": finding[\"owner\"],\n                        \"pointer\": finding[\"boundary\"],\n                        \"message\": finding[\"message\"],\n                    }\n                    for finding in findings\n                ],\n                \"parent\": {\n                    \"artifact_name\": f\"{request['channel']}:{unit_id}\",\n                    \"artifact_body\": json.dumps(parent_body, sort_keys=True),\n                    \"channel\": request[\"channel\"],\n                    \"unit_id\": unit_id,\n                    \"parent_sha256\": parent_head.get(\"hash\"),\n                },\n                \"boundary\": request[\"boundary\"],\n                \"allowed_facts\": request.get(\"allowed_facts\") or {},\n                \"invalidated_descendants\": request[\"invalidated_descendants\"],\n                \"retest_order\": request[\"retest_order\"],\n            },\n        )\n        return {\n            \"invalidations\": [invalidation],\n            \"pending_packet\": staged_dispatch(\"M06_REPAIR_NAMED_UNIT_ARTIFACT\", [packet]),\n            \"pending_guard\": _guard(\n                \"D19_ROUTE_UNIT_REPAIR\", \"model_repair\", unit_id=unit_id, request_key=request[\"key\"]\n            ),\n        }\n\n    # Deterministic route: this node both selects and produces the candidate,\n    # since D20 is the one and only admission authority and no intervening\n    # dispatch node exists on the deterministic side (spec section 12: a\n    # deterministic repair producer \"receives no prompt\").\n    parent_body, current_hash, _current_version, _head_tracked = _current_parent(state, stream)\n    new_body = _deterministic_repair_candidate(request, parent_body)\n    candidate = {\n        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n        \"pre_admission\": True,\n        \"stream\": stream,\n        \"channel\": request[\"channel\"],\n        \"unit_id\": unit_id,\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"parent_sha256\": current_hash,\n        \"addressed_finding_ids\": request[\"finding_ids\"],\n        \"body\": new_body,\n    }\n    return {\n        \"invalidations\": [invalidation],\n        \"artifact_versions\": [candidate],\n        \"pending_guard\": _guard(\n            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n        ),\n    }\n\n\n# --------------------------------------------------------------------------\n# D20_ADMIT_UNIT_REPAIR\n# --------------------------------------------------------------------------\n\n\ndef _latest_deterministic_candidate(\n    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n) -> dict[str, Any] | None:\n    matches = [\n        dict(record)\n        for record in artifact_versions\n        if isinstance(record, Mapping)\n        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n        and record.get(\"stream\") == stream\n        and record.get(\"request_key\") == request_key\n    ]\n    return matches[-1] if matches else None\n\n\ndef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool]:\n    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n\n    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n    layout does not (it is admitted by D13 as a plain append-unique version,\n    the same convention `review.py` already reads it under). Both shapes\n    resolve to one parent here so D20 admits either uniformly, and the fourth\n    element tells the caller whether `artifact_heads` may legally be written.\n    \"\"\"\n\n    heads = state.get(\"artifact_heads\") or {}\n    head = heads.get(stream)\n    artifact_versions = state.get(\"artifact_versions\") or []\n    if isinstance(head, Mapping):\n        for record in artifact_versions:\n            if (\n                isinstance(record, Mapping)\n                and record.get(\"stream\") == stream\n                and record.get(\"hash\") == head.get(\"hash\")\n            ):\n                return record.get(\"body\") or {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True\n\n    candidates = [\n        record\n        for record in artifact_versions\n        if isinstance(record, Mapping)\n        and record.get(\"stream\") == stream\n        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n    ]\n    if not candidates:\n        return {}, None, 0, False\n    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n    return latest.get(\"body\") or {}, latest.get(\"hash\"), int(latest.get(\"version\", 0)), False\n\n\ndef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n\n    Recomputes the parent/child diff itself rather than trusting a model's own\n    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n    child that does not descend from the current head, is `SystemFailure`\n    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n    routed repairable finding, because a boundary violation is a build/model\n    defect, not a product outcome to retry.\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    requests = [\n        entry\n        for entry in state.get(\"repair_requests\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n    request = requests[-1]\n    stream = request[\"stream\"]\n    boundary = request[\"boundary\"][\"json_pointers\"]\n    heads = state.get(\"artifact_heads\") or {}\n    parent_head = heads.get(stream)\n    artifact_versions = state.get(\"artifact_versions\") or []\n\n    parent_body, current_hash, current_version, head_tracked = _current_parent(state, stream)\n\n    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n    deterministic_candidate = _latest_deterministic_candidate(\n        artifact_versions, stream=stream, request_key=request[\"key\"]\n    )\n    require(\n        (model_candidate is not None) != (deterministic_candidate is not None),\n        \"join\",\n        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n        unit_id=unit_id,\n    )\n\n    if model_candidate is not None:\n        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n        child = payload.get(\"candidate_child\") or {}\n        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n        try:\n            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n        except (TypeError, ValueError) as error:\n            raise SystemFailure(\n                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n            ) from error\n        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n    else:\n        new_body = deterministic_candidate[\"body\"]\n        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n\n    require(\n        declared_parent_sha == current_hash,\n        \"integrity\",\n        \"the repair candidate's declared parent is not the current head (stale repair)\",\n        stream=stream, declared=declared_parent_sha, current=current_hash,\n    )\n\n    diff = json_pointer_diff(parent_body, new_body)\n    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n    require(\n        not out_of_bound,\n        \"integrity\",\n        \"a repair candidate changed bytes outside its declared boundary\",\n        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n    )\n\n    child_record = {\n        \"stream\": stream,\n        \"version\": current_version + 1,\n        \"parent_hash\": current_hash,\n        \"hash\": canonical_digest(new_body),\n        \"body\": new_body,\n        \"minted_by\": \"targeted_repair_admission\",\n        \"unit_id\": unit_id,\n        \"channel\": request[\"channel\"],\n        \"request_key\": request[\"key\"],\n        \"owner\": request[\"owner\"],\n        \"attempt\": request[\"attempt_ordinal\"],\n    }\n    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n\n    update: dict[str, Any] = {\n        \"artifact_versions\": [child_record],\n        \"pending_guard\": _guard(\n            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n        ),\n    }\n    if head_tracked:\n        update[\"artifact_heads\"] = {\n            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n        }\n    return update\n\n\n# --------------------------------------------------------------------------\n# D21_RETEST_REQUIRED_DESCENDANTS\n# --------------------------------------------------------------------------\n\n\ndef D21_RETEST_REQUIRED_DESCENDANTS(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n    \"\"\"Dispatch the earliest node of the fixed retest DAG, or close the frontier.\n\n    Dispatches exactly once per repair admission: the first named node's own\n    success guard already re-enters the rest of the normal unit path (D07\n    through D16), so this never loops internally and never names a model node\n    as the stored destination (spec section 6.2 D92/D21: a model destination in\n    a stored frontier is a system fault).\n    \"\"\"\n\n    unit_id = state.get(\"selected_unit_id\")\n    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n\n    invalidations = [\n        entry\n        for entry in state.get(\"invalidations\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    ]\n    require(bool(invalidations), \"invalid_input\", \"D21 requires an admitted invalidation record\")\n    invalidation = invalidations[-1]\n\n    dispatched = {\n        entry.get(\"request_key\")\n        for entry in state.get(\"retest_results\") or []\n        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n    }\n\n    retest_order = invalidation[\"retest_order\"]\n    request_key = invalidation[\"request_key\"]\n    if not retest_order:\n        return {\n            \"pending_guard\": _guard(\n                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n            )\n        }\n\n    result = {\n        \"key\": canonical_digest({\"request_key\": request_key, \"kind\": \"retest_dispatch\"}),\n        \"unit_id\": unit_id,\n        \"request_key\": request_key,\n        \"owner\": invalidation[\"owner\"],\n        \"retest_order\": list(retest_order),\n        \"dispatched_to\": retest_order[0],\n        \"resolved\": True,\n    }\n\n    if request_key in dispatched:\n        return {\n            \"pending_guard\": _guard(\n                \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_complete\", unit_id=unit_id\n            )\n        }\n\n    return {\n        \"retest_results\": [result],\n        \"pending_guard\": _guard(\n            \"D21_RETEST_REQUIRED_DESCENDANTS\", \"retest_frontier_incomplete\",\n            unit_id=unit_id, destination=retest_order[0],\n        ),\n    }\n","numLines":987,"startLine":1,"totalLines":987}}}
