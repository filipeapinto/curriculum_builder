{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015bYRcNxtJkZXTrUHyZ8Vih","type":"tool_result","content":"260\tdef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n261\t    target = _underlying(body)\n262\t    try:\n263\t        source = inspect.getsource(target)\n264\t    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n265\t        source = \"\"\n266\t    return {\n267\t        \"node_id\": node_id,\n268\t        \"module\": getattr(target, \"__module__\", \"\"),\n269\t        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n270\t        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n271\t        \"source_lines\": len(source.splitlines()),\n272\t    }\n273\t\n274\t\n275\t# ------------------------------------------------------------ binding validation\n276\t\n277\t\n278\tdef binding_inventory() -> dict[str, Callable[..., Any]]:\n279\t    \"\"\"Every node callable the *skeleton and unit path* resolve against.\n280\t\n281\t    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n282\t    are absent here: they are exercised at the function level by N31's own\n283\t    tests, and this generation does not wire their topology (spec section\n284\t    8.1's D08/D09/D12/D14/D91 -> D17 and M05 -> D16 edges stay the declared\n285\t    `unit_graph.DEFERRED_EDGES` rows they already are).\n286\t\n287\t    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n288\t    likewise absent from *this* function deliberately, not by oversight: D24\n289\t    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n290\t    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n291\t    already-verified tables) declare that edge deferred to N32 by name. If D24\n292\t    entered this function, `unit_graph.register_unit_path`'s *own*\n293\t    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n294\t    silently widen to include it -- correct for a production run, but it\n295\t    would falsify N30's own already-passing topology tests, which independently\n296\t    recompute their expectation from this exact function's return value.\n297\t    `register_workbook_topology` registers the workbook engine as an additive\n298\t    step over its own separate builder (N32 exercises it directly, not through\n299\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n300\t    byte-identical to what they were before N32 and the workbook branch is\n301\t    still fully real -- just not reachable from `D05` in this generation,\n302\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n303\t    \"\"\"\n304\t\n305\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n306\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n307\t        bindings[job_id] = adapter\n308\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n309\t    return bindings\n310\t\n311\t\n312\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n313\t    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n314\t\n315\t    The complete node set the compiled graph actually registers. Kept\n316\t    separate from `binding_inventory()` itself for the reason documented\n317\t    there: several of N30's own tests recompute their expectation directly\n318\t    from `binding_inventory()`'s return value, so that function's contract\n319\t    (the skeleton/unit-path view) must stay exactly what it was before N32.\n320\t    \"\"\"\n321\t\n322\t    bindings = dict(binding_inventory())\n323\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n324\t    return bindings\n325\t\n326\t\n327\tdef _reject(code: str, node_id: str, detail: str) -> None:\n328\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n329\t\n330\t\n331\tdef validate_bindings(\n332\t    bindings: Mapping[str, Callable[..., Any]],\n333\t    *,\n334\t    required: Sequence[str],\n335\t) -> dict[str, dict[str, Any]]:\n336\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n337\t\n338\t    for node_id in required:\n339\t        if node_id not in bindings:\n340\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n341\t\n342\t    seen: dict[tuple[str, str], str] = {}\n343\t    inventory: dict[str, dict[str, Any]] = {}\n344\t    for node_id in sorted(bindings):\n345\t        body = bindings[node_id]\n346\t        if not callable(body):\n347\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n348\t        record = _binding_record(node_id, body)\n349\t        module = record[\"module\"]\n350\t        if not any(\n351\t            module == allowed or module.startswith(f\"{allowed}.\")\n352\t            for allowed in PRODUCTION_BINDING_MODULES\n353\t        ):\n354\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n355\t        lowered = f\"{module}.{record['qualname']}\".lower()\n356\t        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n357\t        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n358\t        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n359\t        # positive on the spec's own vocabulary, not a caught stand-in.\n360\t        marker = next(\n361\t            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n362\t            None,\n363\t        )\n364\t        if marker is not None:\n365\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n366\t        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n367\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n368\t        source = inspect.getsource(_underlying(body))\n369\t        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n370\t        if marker is not None:\n371\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n372\t        identity = (module, record[\"qualname\"])\n373\t        if identity in seen:\n374\t            _reject(\n375\t                \"N20-BIND-DUPLICATE\",\n376\t                node_id,\n377\t                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n378\t            )\n379\t        seen[identity] = node_id\n380\t        inventory[node_id] = record\n381\t    return inventory\n382\t\n383\t\n384\tdef _validate_topology(registered: Sequence[str]) -> None:\n385\t    known = set(registered) | {START, END}\n386\t    wired: set[str] = set()\n387\t    for source, target in SKELETON_NORMAL_EDGES:\n388\t        for endpoint in (source, target):\n389\t            if endpoint not in known:\n390\t                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n391\t        wired.update({source, target})\n392\t    for source, path in SKELETON_BRANCHES:\n393\t        if source not in known:\n394\t            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n395\t        wired.add(source)\n396\t        for target in routing.guard_destinations(source):\n397\t            if target not in known:\n398\t                _reject(\n399\t                    \"N20-EDGE-DANGLING\",\n400\t                    target,\n401\t                    f\"{source} branch {path.__name__} names an unregistered destination\",\n402\t                )\n403\t            wired.add(target)\n404\t    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n405\t        wired.update({source, target})\n406\t    for source, _ in unit_graph.UNIT_BRANCHES:\n407\t        wired.add(source)\n408\t        wired.update(unit_graph.branch_destinations(source, registered))\n409\t    for node_id in registered:\n410\t        if node_id in wired:\n411\t            continue\n412\t        owner = DEFERRED_TOPOLOGY.get(node_id)\n413\t        if owner is None:\n414\t            _reject(\n415\t                \"N20-NODE-UNDECLARED\",\n416\t                node_id,\n417\t                \"is registered but neither wired by the skeleton nor declared deferred\",\n418\t            )\n419\t\n420\t\n421\t# ---------------------------------------------------------------- registration\n422\t\n423\t\n424\tdef register_skeleton(\n425\t    builder: StateGraph,\n426\t    bindings: Mapping[str, Callable[..., Any]],\n427\t) -> dict[str, dict[str, Any]]:\n428\t    \"\"\"Register every available node and the fixed skeleton edges.\n429\t\n430\t    N30 and N32 extend the same builder by adding their own `add_node`-free\n431\t    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n432\t    rewritten by them, so the skeleton stays the one place START, the recovery\n433\t    branch, and the single edge to END are decided.\n434\t    \"\"\"\n435\t\n436\t    routing.assert_guard_table_total(NODE_CATALOGUE)\n437\t    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n438\t    _validate_topology(sorted(bindings))\n439\t\n440\t    for node_id in sorted(bindings):\n441\t        model_node = node_id in MODEL_NODE_ADAPTERS\n442\t        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n443\t\n444\t    for source, target in SKELETON_NORMAL_EDGES:\n445\t        builder.add_edge(source, target)\n446\t\n447\t    for source, path in SKELETON_BRANCHES:\n448\t        destinations = routing.guard_destinations(source)\n449\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n450\t\n451\t    unit_graph.register_unit_path(builder, sorted(bindings))\n452\t\n453\t    return inventory\n454\t\n455\t\n456\tdef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n457\t    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n458\t\n459\t    Not called by `build_curriculum_factory_graph`: this generation's single\n460\t    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n461\t    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n462\t    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n463\t    this function into whatever the production compile point becomes once the\n464\t    workbook branch is in scope; until then it is exercised directly, over its\n465\t    own builder, the way N32's own topology test already does.\n466\t    `register_skeleton` itself must never see these bindings; this function\n467\t    adds exactly the nodes `register_skeleton` did not, then wires them over\n468\t    the *full* merged node set so `workbook.register_workbook_path` can\n469\t    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n470\t    \"\"\"\n471\t\n472\t    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n473\t    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n474\t    for node_id in sorted(workbook_bindings):\n475\t        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n476\t    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n477\t\n478\t\n479\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n480\t    required = {source for source, _ in SKELETON_BRANCHES}\n481\t    for source, target in SKELETON_NORMAL_EDGES:\n482\t        required.update({source, target})\n483\t    for source, _ in SKELETON_BRANCHES:\n484\t        required.update(routing.guard_destinations(source))\n485\t    return tuple(sorted(required - {START, END}))\n486\t\n487\t\n488\tdef build_curriculum_factory_graph(\n489\t    *, engine_root: Path, output_root: Path\n490\t) -> CompiledStateGraph:\n491\t    \"\"\"Build and compile the one production graph (spec section 4).\n492\t\n493\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n494\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n495\t    services are captured at build time, so the compiled object carries no\n496\t    run identity and no authorization.\n497\t    \"\"\"\n498\t\n499\t    engine_root = Path(engine_root).resolve()\n500\t    output_root = Path(output_root).resolve()\n501\t    builder: StateGraph = StateGraph(\n502\t        FactoryState,\n503\t        context_schema=RuntimeContext,\n504\t        input_schema=FactoryInput,\n505\t        output_schema=FactoryOutput,\n506\t    )\n507\t    register_skeleton(builder, binding_inventory())\n508\t    saver, _connection = open_checkpoint_saver(output_root)\n509\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n510\t\n511\t\n512\t# ---------------------------------------------------------------------- digest\n513\t\n514\t\n515\tdef _canonical_digest(payload: Any) -> str:\n516\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n517\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n518\t\n519\t\n520\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n521\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n522\t\n523\t    drawn = compiled.get_graph()\n524\t    return {\n525\t        \"name\": compiled.name,\n526\t        \"nodes\": sorted(drawn.nodes),\n527\t        \"edges\": sorted(\n528\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n529\t        ),\n530\t    }\n531\t\n532\t\n533\tdef contract_digests() -> dict[str, str]:\n534\t    \"\"\"File digests of every frozen model prompt and output schema.\n535\t\n536\t    Folded into the graph digest so prompt or schema drift is visible as graph\n537\t    drift: the same topology over a changed prompt is not the same graph.\n538\t    \"\"\"\n539\t\n540\t    digests: dict[str, str] = {}\n541\t    registry = tp.load_job_registry()\n542\t    for job_id in sorted(registry):\n543\t        route = registry[job_id]\n544\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n545\t            path = Path(path)\n546\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n547\t    return digests\n548\t\n549\t\n550\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n551\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n552\t\n553\t    Identical real bindings give an identical digest; a changed node body,\n554\t    reducer declaration, prompt, or schema changes it. Python object identity is\n555\t    deliberately not an input, so two builds in one process and two builds in two\n556\t    processes agree.\n557\t    \"\"\"\n558\t\n559\t    payload = {\n560\t        \"topology\": compiled_topology(compiled),\n561\t        \"bindings\": [\n562\t            _binding_record(node_id, body)\n563\t            for node_id, body in sorted(binding_inventory().items())\n564\t        ],\n565\t        \"state\": {\n566\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n567\t            \"input\": list(FACTORY_INPUT_FIELDS),\n568\t            \"output\": list(FACTORY_OUTPUT_FIELDS),\n569\t        },\n570\t        \"contracts\": contract_digests(),\n571\t    }\n572\t    return _canonical_digest(payload)\n573\t"}]},"parent_tool_use_id":null,"session_id":"18d83993-700d-4340-bec9-cb55c092357d","uuid":"896c09c7-f18f-4b22-b63a-610995ebd34b","timestamp":"2026-08-12T21:51:00.335Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215023.910830Z-53d2cc5b32/repo/runtime/langgraph_factory/graph.py","content":"def _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n    target = _underlying(body)\n    try:\n        source = inspect.getsource(target)\n    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n        source = \"\"\n    return {\n        \"node_id\": node_id,\n        \"module\": getattr(target, \"__module__\", \"\"),\n        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n        \"source_lines\": len(source.splitlines()),\n    }\n\n\n# ------------------------------------------------------------ binding validation\n\n\ndef binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"Every node callable the *skeleton and unit path* resolve against.\n\n    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n    are absent here: they are exercised at the function level by N31's own\n    tests, and this generation does not wire their topology (spec section\n    8.1's D08/D09/D12/D14/D91 -> D17 and M05 -> D16 edges stay the declared\n    `unit_graph.DEFERRED_EDGES` rows they already are).\n\n    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n    likewise absent from *this* function deliberately, not by oversight: D24\n    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n    already-verified tables) declare that edge deferred to N32 by name. If D24\n    entered this function, `unit_graph.register_unit_path`'s *own*\n    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n    silently widen to include it -- correct for a production run, but it\n    would falsify N30's own already-passing topology tests, which independently\n    recompute their expectation from this exact function's return value.\n    `register_workbook_topology` registers the workbook engine as an additive\n    step over its own separate builder (N32 exercises it directly, not through\n    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n    byte-identical to what they were before N32 and the workbook branch is\n    still fully real -- just not reachable from `D05` in this generation,\n    exactly as `unit_graph.DEFERRED_EDGES` documents.\n    \"\"\"\n\n    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n        bindings[job_id] = adapter\n    bindings.update(MODEL_BOOKKEEPING_NODES)\n    return bindings\n\n\ndef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"`binding_inventory()` plus N32's workbook engine (D24-D32).\n\n    The complete node set the compiled graph actually registers. Kept\n    separate from `binding_inventory()` itself for the reason documented\n    there: several of N30's own tests recompute their expectation directly\n    from `binding_inventory()`'s return value, so that function's contract\n    (the skeleton/unit-path view) must stay exactly what it was before N32.\n    \"\"\"\n\n    bindings = dict(binding_inventory())\n    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n    return bindings\n\n\ndef _reject(code: str, node_id: str, detail: str) -> None:\n    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n\n\ndef validate_bindings(\n    bindings: Mapping[str, Callable[..., Any]],\n    *,\n    required: Sequence[str],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n\n    for node_id in required:\n        if node_id not in bindings:\n            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n\n    seen: dict[tuple[str, str], str] = {}\n    inventory: dict[str, dict[str, Any]] = {}\n    for node_id in sorted(bindings):\n        body = bindings[node_id]\n        if not callable(body):\n            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n        record = _binding_record(node_id, body)\n        module = record[\"module\"]\n        if not any(\n            module == allowed or module.startswith(f\"{allowed}.\")\n            for allowed in PRODUCTION_BINDING_MODULES\n        ):\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n        lowered = f\"{module}.{record['qualname']}\".lower()\n        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n        # positive on the spec's own vocabulary, not a caught stand-in.\n        marker = next(\n            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n            None,\n        )\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n        source = inspect.getsource(_underlying(body))\n        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n        identity = (module, record[\"qualname\"])\n        if identity in seen:\n            _reject(\n                \"N20-BIND-DUPLICATE\",\n                node_id,\n                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n            )\n        seen[identity] = node_id\n        inventory[node_id] = record\n    return inventory\n\n\ndef _validate_topology(registered: Sequence[str]) -> None:\n    known = set(registered) | {START, END}\n    wired: set[str] = set()\n    for source, target in SKELETON_NORMAL_EDGES:\n        for endpoint in (source, target):\n            if endpoint not in known:\n                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n        wired.update({source, target})\n    for source, path in SKELETON_BRANCHES:\n        if source not in known:\n            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n        wired.add(source)\n        for target in routing.guard_destinations(source):\n            if target not in known:\n                _reject(\n                    \"N20-EDGE-DANGLING\",\n                    target,\n                    f\"{source} branch {path.__name__} names an unregistered destination\",\n                )\n            wired.add(target)\n    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n        wired.update({source, target})\n    for source, _ in unit_graph.UNIT_BRANCHES:\n        wired.add(source)\n        wired.update(unit_graph.branch_destinations(source, registered))\n    for node_id in registered:\n        if node_id in wired:\n            continue\n        owner = DEFERRED_TOPOLOGY.get(node_id)\n        if owner is None:\n            _reject(\n                \"N20-NODE-UNDECLARED\",\n                node_id,\n                \"is registered but neither wired by the skeleton nor declared deferred\",\n            )\n\n\n# ---------------------------------------------------------------- registration\n\n\ndef register_skeleton(\n    builder: StateGraph,\n    bindings: Mapping[str, Callable[..., Any]],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Register every available node and the fixed skeleton edges.\n\n    N30 and N32 extend the same builder by adding their own `add_node`-free\n    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n    rewritten by them, so the skeleton stays the one place START, the recovery\n    branch, and the single edge to END are decided.\n    \"\"\"\n\n    routing.assert_guard_table_total(NODE_CATALOGUE)\n    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n    _validate_topology(sorted(bindings))\n\n    for node_id in sorted(bindings):\n        model_node = node_id in MODEL_NODE_ADAPTERS\n        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n\n    for source, target in SKELETON_NORMAL_EDGES:\n        builder.add_edge(source, target)\n\n    for source, path in SKELETON_BRANCHES:\n        destinations = routing.guard_destinations(source)\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n\n    unit_graph.register_unit_path(builder, sorted(bindings))\n\n    return inventory\n\n\ndef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n\n    Not called by `build_curriculum_factory_graph`: this generation's single\n    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n    this function into whatever the production compile point becomes once the\n    workbook branch is in scope; until then it is exercised directly, over its\n    own builder, the way N32's own topology test already does.\n    `register_skeleton` itself must never see these bindings; this function\n    adds exactly the nodes `register_skeleton` did not, then wires them over\n    the *full* merged node set so `workbook.register_workbook_path` can\n    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n    \"\"\"\n\n    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n    for node_id in sorted(workbook_bindings):\n        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n\n\ndef _skeleton_required_nodes() -> tuple[str, ...]:\n    required = {source for source, _ in SKELETON_BRANCHES}\n    for source, target in SKELETON_NORMAL_EDGES:\n        required.update({source, target})\n    for source, _ in SKELETON_BRANCHES:\n        required.update(routing.guard_destinations(source))\n    return tuple(sorted(required - {START, END}))\n\n\ndef build_curriculum_factory_graph(\n    *, engine_root: Path, output_root: Path\n) -> CompiledStateGraph:\n    \"\"\"Build and compile the one production graph (spec section 4).\n\n    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n    returned graph is invoked with `context=build_runtime_context(...)`; no\n    services are captured at build time, so the compiled object carries no\n    run identity and no authorization.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    builder: StateGraph = StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n    register_skeleton(builder, binding_inventory())\n    saver, _connection = open_checkpoint_saver(output_root)\n    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n\n\n# ---------------------------------------------------------------------- digest\n\n\ndef _canonical_digest(payload: Any) -> str:\n    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n\n\ndef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n\n    drawn = compiled.get_graph()\n    return {\n        \"name\": compiled.name,\n        \"nodes\": sorted(drawn.nodes),\n        \"edges\": sorted(\n            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n        ),\n    }\n\n\ndef contract_digests() -> dict[str, str]:\n    \"\"\"File digests of every frozen model prompt and output schema.\n\n    Folded into the graph digest so prompt or schema drift is visible as graph\n    drift: the same topology over a changed prompt is not the same graph.\n    \"\"\"\n\n    digests: dict[str, str] = {}\n    registry = tp.load_job_registry()\n    for job_id in sorted(registry):\n        route = registry[job_id]\n        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n            path = Path(path)\n            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return digests\n\n\ndef graph_digest(compiled: CompiledStateGraph) -> str:\n    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n\n    Identical real bindings give an identical digest; a changed node body,\n    reducer declaration, prompt, or schema changes it. Python object identity is\n    deliberately not an input, so two builds in one process and two builds in two\n    processes agree.\n    \"\"\"\n\n    payload = {\n        \"topology\": compiled_topology(compiled),\n        \"bindings\": [\n            _binding_record(node_id, body)\n            for node_id, body in sorted(binding_inventory().items())\n        ],\n        \"state\": {\n            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n            \"input\": list(FACTORY_INPUT_FIELDS),\n            \"output\": list(FACTORY_OUTPUT_FIELDS),\n        },\n        \"contracts\": contract_digests(),\n    }\n    return _canonical_digest(payload)\n","numLines":314,"startLine":260,"totalLines":573}}}
