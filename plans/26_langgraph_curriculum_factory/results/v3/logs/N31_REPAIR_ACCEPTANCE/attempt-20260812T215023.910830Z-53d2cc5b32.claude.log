{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0162kSQ6JfEv9pmtMaFQj8Jt","type":"tool_result","content":"1\t\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n2\t\n3\tThis module owns registration, not node bodies. Every callable it registers is\n4\tresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\n5\tthat is missing, placeholder, test-only, duplicated, or dangling fails the build\n6\tby stable ID rather than compiling into a graph that would look complete.\n7\t\n8\tIt also owns the two things no node body can own:\n9\t\n10\t- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n11\t  records a graceful interrupt observed at the node's atomic boundary, and turns\n12\t  an unexpected exception into a classified `pending_failure` instead of letting\n13\t  an unproven state continue;\n14\t- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n15\t  guard, evidence writer, transport registry, source retriever, signal token and\n16\t  clock, and holds no model client and no routing authority.\n17\t\n18\tScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\n19\tpath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n20\t`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\n21\tmap/reduce, and the workbook branch are registered by N30 and N32 into this same\n22\tbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\n23\tbut not yet wired, so an undeclared unwired node still fails compilation.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport inspect\n30\timport json\n31\timport re\n32\tfrom collections.abc import Callable, Mapping, Sequence\n33\tfrom datetime import datetime, timezone\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom langgraph.errors import GraphBubbleUp\n38\tfrom langgraph.graph import END, START, StateGraph\n39\tfrom langgraph.graph.state import CompiledStateGraph\n40\tfrom langgraph.runtime import Runtime\n41\t\n42\tfrom . import routing, transport as tp, unit_graph, workbook\n43\tfrom .artifacts import ArtifactStore\n44\tfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\n45\tfrom .evidence import EvidenceStore\n46\tfrom .model_nodes import (\n47\t    MODEL_BOOKKEEPING_NODES,\n48\t    MODEL_NODE_ADAPTERS,\n49\t    build_model_node_context,\n50\t)\n51\tfrom .nodes import NODE_CATALOGUE, node_registry\n52\tfrom .persistence import InterruptToken, open_checkpoint_saver\n53\tfrom .state import (\n54\t    FACTORY_INPUT_FIELDS,\n55\t    FACTORY_OUTPUT_FIELDS,\n56\t    FACTORY_STATE_FIELDS,\n57\t    FIELD_REDUCER_CLASSES,\n58\t    FactoryInput,\n59\t    FactoryOutput,\n60\t    FactoryState,\n61\t    RuntimeContext,\n62\t)\n63\t\n64\t__all__ = [\n65\t    \"GRAPH_NAME\",\n66\t    \"GraphBindingError\",\n67\t    \"DEFERRED_TOPOLOGY\",\n68\t    \"SKELETON_NORMAL_EDGES\",\n69\t    \"SKELETON_BRANCHES\",\n70\t    \"build_runtime_context\",\n71\t    \"binding_inventory\",\n72\t    \"validate_bindings\",\n73\t    \"register_skeleton\",\n74\t    \"build_curriculum_factory_graph\",\n75\t    \"compiled_topology\",\n76\t    \"graph_digest\",\n77\t    \"contract_digests\",\n78\t]\n79\t\n80\tGRAPH_NAME = \"plan26_curriculum_factory\"\n81\t\n82\t\n83\tclass GraphBindingError(RuntimeError):\n84\t    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n85\t\n86\t\n87\t# Only these modules may supply a production node body. A callable from anywhere\n88\t# else — a test module, a notebook, a locally defined lambda — is rejected by\n89\t# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n90\t# a stand-in\".\n91\tPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n92\t    \"runtime.langgraph_factory.nodes\",\n93\t    \"runtime.langgraph_factory.model_nodes\"