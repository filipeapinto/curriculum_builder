{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016KABsA3QjJ5QnsUDqGcQuN","type":"tool_result","content":"370\t        self.tripped = True\n371\t\n372\t    def is_set(self) -> bool:\n373\t        return self.tripped\n374\t\n375\t\n376\tclass _HarnessContext:\n377\t    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n378\t\n379\t    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n380\t        from runtime.langgraph_factory.artifacts import ArtifactStore\n381\t        from runtime.langgraph_factory.evidence import EvidenceStore\n382\t\n383\t        self.engine_root = engine_root\n384\t        self.output_root = output_root\n385\t        self.path_guard = ArtifactStore(output_root)\n386\t        self.evidence_service = EvidenceStore(output_root)\n387\t        self.transport_registry = _StubRegistry(sandbox)\n388\t        self.source_retriever = _StubRetriever()\n389\t        self.signal_token = _SwitchableToken()\n390\t        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n391\t\n392\t\n393\tclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n394\t    \"\"\"Composes each canned candidate from the projection it is handed.\n395\t\n396\t    Still a `FakeCliTransport`, so the real output-schema and no-authoritative-\n397\t    field validation still runs, and it is still refused by\n398\t    `build_model_node_context`.\n399\t    \"\"\"\n400\t\n401\t    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:\n402\t        super().__init__(sandbox_root=sandbox_root, responses={}, registry=registry)\n403\t        self.calls: list[tuple[str, str]] = []\n404\t\n405\t    def execute(self, *, job_id: str, activation_id: str, projection: Any = None, **kwargs: Any):\n406\t        projection = dict(projection or {})\n407\t        self.calls.append((job_id, activation_id))\n408\t        self.responses[job_id] = _scripted_candidate(job_id, projection)\n409\t        return super().execute(\n410\t            job_id=job_id, activation_id=activation_id, projection=projection, **kwargs\n411\t        )\n412\t\n413\t\n414\t# The visual denominator the scripted M03 declares. Two members, one per subset,\n415\t# so a real episode fans out to D11 *and* to M04 and D12 has two subsets to join.\n416\t# `_declared_visuals` returns the list in a chosen order, which is what prompt\n417\t# TEST 5's permutation-invariance claim varies.\n418\tDECLARED_VISUALS: list[dict[str, Any]] = [\n419\t    {\n420\t        \"role\": \"build_map\",\n421\t        \"kind\": \"schematic\",\n422\t        \"authoritative\": True,\n423\t        \"permitted_facts\": [\"fact-a\"],\n424\t    },\n425\t    {\n426\t        \"role\": \"overview\",\n427\t        \"kind\": \"diagram\",\n428\t        \"authoritative\": False,\n429\t        \"permitted_facts\": [\"fact-b\"],\n430\t    },\n431\t]\n432\t\n433\t\n434\tdef _scripted_candidate(job_id: str, projection: dict[str, Any]) -> dict[str, Any]:\n435\t    if job_id == \"M01_RESEARCH_UNIT_SOURCES\":\n436\t        request_id = projection[\"request\"].get(\"request_id\")\n437\t        group = projection.get(\"retrieval_group\")\n438\t        if group is None:\n439\t            return {\n440\t                \"locators\": [\n441\t                    {\n442\t                        \"request_id\": request_id,\n443\t                        \"url\": f\"https://example.invalid/{request_id}\",\n444\t                        \"title\": \"scripted source\",\n445\t                        \"publisher\": \"scripted publisher\",\n446\t                        \"locator_kind\": \"primary\",\n447\t                        \"rationale\": \"scripted rationale\",\n448\t                    }\n449\t                ]\n450\t            }\n451\t        return {\n452\t            \"interpretations\": [\n453\t                {\n454\t                    \"request_id\": request_id,\n455\t                    \"retrieval_id\": str(record.get(\"retrieval_id\")),\n456\t                    \"claims\": [\n457\t                        {\n458\t                            \"claim_text\": \"scripted claim\",\n459\t                            \"source_quote\": \"scripted quote\",\n460\t                            \"source_location\": \"p.1\",\n461\t                        }\n462\t                    ],\n463\t                    \"limitations\": [],\n464\t                }\n465\t                for record in group.get(\"retrieved_records\", [])\n466\t            ]\n467\t        }\n468\t    if job_id == \"M02_CREATE_UNIT_DOMAIN_DATA\":\n469\t        unit_id = projection[\"unit\"].get(\"unit_id\")\n470\t        admitted = projection.get(\"admitted_sources\") or []\n471\t        # Every declared fact resolves to an admitted source, which is D08's\n472\t        # `domain_facts_sourced` check: the body is derived from the join, not\n473\t        # invented alongside it.\n474\t        facts = [\n475\t            {\n476\t                \"fact_id\": str(source.get(\"fact_id\")),\n477\t                \"statement\": f\"scripted statement for {source.get('fact_id')}\",\n478\t            }\n479\t            for source in admitted\n480\t        ] or [{\"fact_id\": \"required_explanation:000\", \"statement\": \"scripted statement\"}]\n481\t        return {\n482\t            \"domain_version\": {\n483\t                \"unit_id\": unit_id,\n484\t                \"fields\": {\n485\t                    \"unit_id\": unit_id,\n486\t                    \"facts\": facts,\n487\t                    \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n488\t                },\n489\t                \"evidence_references\": [\n490\t                    {\n491\t                        \"source_id\": str(source.get(\"source_id\") or source.get(\"key\") or \"s1\"),\n492\t                        \"source_location\": \"p.1\",\n493\t                    }\n494\t                    for source in admitted\n495\t                ]\n496\t                or [{\"source_id\": \"s1\", \"source_location\": \"p.1\"}],\n497\t            }\n498\t        }\n499\t    if job_id == \"M03_WRITE_UNIT_CONTENT\":\n500\t        admitted_domain = projection.get(\"admitted_domain\") or {}\n501\t        unit_id = str(admitted_domain.get(\"unit_id\") or projection[\"unit\"].get(\"unit_id\"))\n502\t        # Only the source ids D08 declared admissible may be cited; M03's adapter\n503\t        # rejects any other as `candidate_undeclared_artifact`.\n504\t        admissible = projection.get(\"admitted_evidence_references\") or []\n505\t        return {\n506\t            \"unit_content\": {\n507\t                \"unit_id\": unit_id,\n508\t                \"sections\": [\n509\t                    {\n510\t                        \"section_id\": f\"s{index:03d}\",\n511\t                        \"heading\": f\"scripted heading {index}\",\n512\t                        \"body\": f\"scripted body for {reference.get('fact_id')}\",\n513\t                    }\n514\t                    for index, reference in enumerate(admissible, start=1)\n515\t                ],\n516\t                \"evidence_references\": [\n517\t                    {\n518\t                        \"section_id\": f\"s{index:03d}\",\n519\t                        \"source_id\": str(reference.get(\"source_id\")),\n520\t                        \"source_location\": \"p.1\",\n521\t                    }\n522\t                    for index, reference in enumerate(admissible, start=1)\n523\t                ],\n524\t                # One visual of each subset, so the episode exercises both halves\n525\t                # of D12's join: `schematic` is in `AUTHORITATIVE_VISUAL_KINDS`\n526\t                # and is produced deterministically from the domain, `diagram` is\n527\t                # not and is dispatched to M04.\n528\t                \"visuals\": DECLARED_VISUALS,\n529\t            }\n530\t        }\n531\t    if job_id == \"M04_CREATE_UNIT_VISUALS\":\n532\t        brief_id = str(projection[\"brief\"].get(\"brief_id\") or projection[\"brief\"].get(\"key\"))\n533\t        return {\n534\t            \"visual_candidate\": {\n535\t                \"brief_id\": brief_id,\n536\t                \"prompt_text\": f\"scripted prompt for {brief_id}\",\n537\t                \"dimensions\": {\"width_px\": 1024, \"height_px\": 768},\n538\t                \"image_format\": \"png\",\n539\t                \"accessibility_text\": f\"scripted alt text for {brief_id}\",\n540\t            },\n541\t            \"provenance_declaration\": {\n542\t                \"brief_id\": brief_id,\n543\t                \"permitted_facts_used\": [\n544\t                    str(fact) for fact in (projection.get(\"permitted_facts\") or [])\n545\t                ],\n546\t                \"asserts_authoritative_detail\": False,\n547\t            },\n548\t        }\n549\t    if job_id == \"M05_REVIEW_ACTUAL_UNIT\":\n550\t        # The review answers the exact page denominator D15 froze, by hash: a\n551\t        # review that invented or dropped a page is what D16's join exists to\n552\t        # reject, so the scripted reviewer must not do either.\n553\t        pages = projection.get(\"pages\") or []\n554\t        return {\n555\t            \"overall_findings\": [],\n556\t            \"page_findings\": [\n557\t                {\n558\t                    \"page_number\": int(page[\"page_number\"]),\n559\t                    \"page_sha256\": str(page[\"page_sha256\"]),\n560\t                    \"findings\": [],\n561\t                }\n562\t                for page in pages\n563\t            ],\n564\t        }\n565\t    raise AssertionError(f\"no scripted candidate for {job_id}\")\n566\t\n567\t\n568\tdef _scripted_model_context(sandbox: Path) -> Any:\n569\t    routes = mn.tp.load_job_registry()\n570\t    return mn.ModelNodeContext(\n571\t        transport=_ScriptedFakeTransport(sandbox_root=sandbox, registry=routes),\n572\t        registry=routes,\n573\t    )\n574\t\n575\t\n576\t# The engine contracts the unit path resolves out of its engine root. D07 hands\n577\t# the domain metaschema and calibration to M02, D08 loads the run's domain schema,\n578\t# and D09 holds unit content to `CURRICULUM_CONTRACTS[0]`. They are copied from the\n579\t# repo rather than stubbed, so the episode is held to the contracts a real run is.\n580\tENGINE_CONTRACTS: tuple[str, ...] = (\n581\t    \"schemas/manifest_domain.metaschema.v1.json\",\n582\t    \"policy/calibration.v1.yaml\",\n583\t    \"meta_prompt/assets/pedagogy.v1.md\",\n584\t    *domain.CURRICULUM_CONTRACTS,\n585\t)\n586\t\n587\t# The synthetic curriculum's own declared domain contract. A run that declares one\n588\t# is the path D02/D08 are built for; the engine metaschema constrains the shape of\n589\t# *this* file, not the domain instance a unit asserts.\n590\tSYNTHETIC_DOMAIN_SCHEMA_RELATIVE = \"schemas/synthetic_domain.v1.json\"\n591\tSYNTHETIC_DOMAIN_SCHEMA: dict[str, Any] = {\n592\t    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n593\t    \"$id\": \"plan26/test/synthetic_domain.v1.json\",\n594\t    \"type\": \"object\",\n595\t    \"additionalProperties\": False,\n596\t    \"required\": [\"unit_id\", \"facts\", \"verifier_result\"],\n597\t    \"properties\": {\n598\t        \"unit_id\": {\"type\": \"string\", \"minLength\": 1},\n599\t        \"facts\": {\n600\t            \"type\": \"array\",\n601\t            \"minItems\": 1,\n602\t            \"items\": {\n603\t                \"type\": \"object\",\n604\t                \"additionalProperties\": False,\n605\t                \"required\": [\"fact_id\", \"statement\"],\n606\t                \"properties\": {\n607\t                    \"fact_id\": {\"type\": \"string\", \"minLength\": 1},\n608\t                    \"statement\": {\"type\": \"string\", \"minLength\": 1},\n609\t                },\n610\t            },\n611\t        },\n612\t        \"verifier_result\": {\n613\t            \"type\": \"object\",\n614\t            \"additionalProperties\": True,\n615\t            \"required\": [\"result\"],\n616\t            \"properties\": {\"result\": {\"type\": \"string\"}},\n617\t        },\n618\t    },\n619\t}\n620\t\n621\t\n622\tdef _build_episode_fixture(tmp_path: Path, units: int = 1) -> dict[str, Any]:\n623\t    \"\"\"An engine root, a synthetic curriculum, an output root, and a sandbox.\"\"\"\n624\t\n625\t    engine = tmp_path / \"engine\"\n626\t    curriculum = engine / \"curricula\" / \"synthetic\"\n627\t    curriculum.mkdir(parents=True)\n628\t    for name in (\"schemas\", \"policy\", \"meta_prompt\"):\n629\t        (engine / name).mkdir()\n630\t    (engine / \"schemas\" / \"placeholder.json\").write_text(\"{}\", encoding=\"utf-8\")\n631\t    for relative in ENGINE_CONTRACTS:\n632\t        target = engine / relative\n633\t        target.parent.mkdir(parents=True, exist_ok=True)\n634\t        target.write_bytes((REPO_ROOT / relative).read_bytes())\n635\t    (engine / SYNTHETIC_DOMAIN_SCHEMA_RELATIVE).write_text(\n636\t        json.dumps(SYNTHETIC_DOMAIN_SCHEMA, indent=2), encoding=\"utf-8\"\n637\t    )\n638\t    labs = [\n639\t        {\n640\t            \"id\": f\"U{index:03d}\",\n641\t            \"title\": f\"synthetic unit {index}\",\n642\t            \"sequence\": {\n643\t                \"prerequisites\": [f\"U{index - 1:03d}\"] if index > 1 else [],\n644\t                \"prepares_for\": [],\n645\t            },\n646\t            \"required_explanation\": [f\"fact {index}\"],\n647\t            \"safety_focus\": [\"care\"],\n648\t        }\n649\t        for index in range(1, units + 1)\n650\t    ]\n651\t    manifest = curriculum / \"synthetic_curriculum.v1.yaml\"\n652\t    manifest.write_text(\n653\t        yaml.safe_dump(\n654\t            {\n655\t                \"domain\": {\"manifest_schema\": SYNTHETIC_DOMAIN_SCHEMA_RELATIVE},\n656\t                \"labs\": labs,\n657\t            },\n658\t            sort_keys=False,\n659\t        ),\n660\t        encoding=\"utf-8\",\n661\t    )\n662\t    output_root = tmp_path / \"out\"\n663\t    output_root.mkdir()\n664\t    # The fake transport refuses any root that is not under the system temp dir.\n665\t    sandbox = Path(tempfile.mkdtemp(prefix=\"plan26-n30-sandbox-\"))\n666\t    return {\n667\t        \"engine\": engine,\n668\t        \"curriculum\": curriculum,\n669\t        \"manifest\": manifest,\n670\t        \"output_root\": output_root,\n671\t        \"sandbox\": sandbox,\n672\t    }\n673\t\n674\t\n675\tdef _prepare_episode(fixture: dict[str, Any], *, mode: str = \"one\", requested: str | None = \"U001\"):\n676\t    \"\"\"`prepare_episode_invocation` plus the envelope D00 reads, as the CLI builds them.\"\"\"\n677\t\n678\t    lock = P.ExecutionLock(fixture[\"output_root\"])\n679\t    lock.acquire()\n680\t    seed = {\n681\t        \"engine_root\": str(fixture[\"engine\"]),\n682\t        \"curriculum_root\": str(fixture[\"curriculum\"]),\n683\t        \"active_manifest_path\": str(fixture[\"manifest\"]),\n684\t        \"output_root\": str(fixture[\"output_root\"]),\n685\t        \"created_at\": \"2026-01-01T00:00:00Z\",\n686\t        \"contract_version\": \"1\",\n687\t        \"mode\": mode,\n688\t        \"requested_unit_id\": requested,\n689\t    }\n690\t    invocation = P.prepare_episode_invocation(\n691\t        output_root=fixture[\"output_root\"], lock=lock, identity_seed=seed\n692\t    )\n693\t    envelope: dict[str, Any] = {\n694\t        \"kind\": \"fresh\",\n695\t        \"contract_version\": \"1\",\n696\t        \"engine_root\": str(fixture[\"engine\"]),\n697\t        \"curriculum_root\": str(fixture[\"curriculum\"]),\n698\t        \"output_root\": str(fixture[\"output_root\"]),\n699\t        \"mode\": mode,\n700\t        \"requested_unit_id\": requested,\n701\t        \"authorization\": {\"scope\": \"test\", \"executables\": []},\n702\t        \"episode_ordinal\": 1,\n703\t        \"prior_identity\": None,\n704\t        \"prior_terminal\": None,\n705\t        \"lease_open\": False,\n706\t    }\n707\t    # D03 requires the authorization to name this run's frozen digest, which the\n708\t    # CLI computes before invocation; D01 is the one function that derives it.\n709\t    probe = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n710\t    digest = inputs.D01_VALIDATE_AND_FREEZE_INPUTS({\"invocation\": envelope}, probe)[\"frozen_digest\"]\n711\t    envelope[\"authorization\"] = {\n712\t        \"scope\": \"test\",\n713\t        \"executables\": [],\n714\t        \"curriculum_digest\": digest,\n715\t    }\n716\t    return lock, invocation, envelope\n717\t\n718\t\n719\tdef _run_episode(\n720\t    monkeypatch: Any,\n721\t    fixture: dict[str, Any],\n722\t    *,\n723\t    interrupt_after: str | None = None,\n724\t) -> dict[str, Any]:\n725\t    \"\"\"Execute one real episode of the real compiled graph, end to end.\n726\t\n727\t    Returns the ordered node trace, the per-node updates, and the final state.\n728\t    \"\"\"\n729\t\n730\t    lock, invocation, envelope = _prepare_episode(fixture)\n731\t    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n732\t    monkeypatch.setattr(\n733\t        G,\n734\t        \"build_model_node_context\",\n735\t        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n736\t    )\n737\t    compiled = G.build_curriculum_factory_graph(\n738\t        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n739\t    )\n740\t\n741\t    trace: list[str] = []\n742\t    updates: list[tuple[str, dict[str, Any]]] = []\n743\t    deferred_frontier: str | None = None\n744\t    try:\n745\t        for chunk in compiled.stream(\n746\t            {\"invocation\": envelope},\n747\t            config=invocation.config,\n748\t            stream_mode=\"updates\",\n749\t            context=context,"}]},"parent_tool_use_id":null,"session_id":"18d83993-700d-4340-bec9-cb55c092357d","uuid":"968ba960-5fa0-49cf-99d0-255b581964c2","timestamp":"2026-08-12T21:53:49.201Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215023.910830Z-53d2cc5b32/repo/tests/runtime/test_plan26_unit_graph.py","content":"        self.tripped = True\n\n    def is_set(self) -> bool:\n        return self.tripped\n\n\nclass _HarnessContext:\n    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n\n    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n        from runtime.langgraph_factory.artifacts import ArtifactStore\n        from runtime.langgraph_factory.evidence import EvidenceStore\n\n        self.engine_root = engine_root\n        self.output_root = output_root\n        self.path_guard = ArtifactStore(output_root)\n        self.evidence_service = EvidenceStore(output_root)\n        self.transport_registry = _StubRegistry(sandbox)\n        self.source_retriever = _StubRetriever()\n        self.signal_token = _SwitchableToken()\n        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n\n\nclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n    \"\"\"Composes each canned candidate from the projection it is handed.\n\n    Still a `FakeCliTransport`, so the real output-schema and no-authoritative-\n    field validation still runs, and it is still refused by\n    `build_model_node_context`.\n    \"\"\"\n\n    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:\n        super().__init__(sandbox_root=sandbox_root, responses={}, registry=registry)\n        self.calls: list[tuple[str, str]] = []\n\n    def execute(self, *, job_id: str, activation_id: str, projection: Any = None, **kwargs: Any):\n        projection = dict(projection or {})\n        self.calls.append((job_id, activation_id))\n        self.responses[job_id] = _scripted_candidate(job_id, projection)\n        return super().execute(\n            job_id=job_id, activation_id=activation_id, projection=projection, **kwargs\n        )\n\n\n# The visual denominator the scripted M03 declares. Two members, one per subset,\n# so a real episode fans out to D11 *and* to M04 and D12 has two subsets to join.\n# `_declared_visuals` returns the list in a chosen order, which is what prompt\n# TEST 5's permutation-invariance claim varies.\nDECLARED_VISUALS: list[dict[str, Any]] = [\n    {\n        \"role\": \"build_map\",\n        \"kind\": \"schematic\",\n        \"authoritative\": True,\n        \"permitted_facts\": [\"fact-a\"],\n    },\n    {\n        \"role\": \"overview\",\n        \"kind\": \"diagram\",\n        \"authoritative\": False,\n        \"permitted_facts\": [\"fact-b\"],\n    },\n]\n\n\ndef _scripted_candidate(job_id: str, projection: dict[str, Any]) -> dict[str, Any]:\n    if job_id == \"M01_RESEARCH_UNIT_SOURCES\":\n        request_id = projection[\"request\"].get(\"request_id\")\n        group = projection.get(\"retrieval_group\")\n        if group is None:\n            return {\n                \"locators\": [\n                    {\n                        \"request_id\": request_id,\n                        \"url\": f\"https://example.invalid/{request_id}\",\n                        \"title\": \"scripted source\",\n                        \"publisher\": \"scripted publisher\",\n                        \"locator_kind\": \"primary\",\n                        \"rationale\": \"scripted rationale\",\n                    }\n                ]\n            }\n        return {\n            \"interpretations\": [\n                {\n                    \"request_id\": request_id,\n                    \"retrieval_id\": str(record.get(\"retrieval_id\")),\n                    \"claims\": [\n                        {\n                            \"claim_text\": \"scripted claim\",\n                            \"source_quote\": \"scripted quote\",\n                            \"source_location\": \"p.1\",\n                        }\n                    ],\n                    \"limitations\": [],\n                }\n                for record in group.get(\"retrieved_records\", [])\n            ]\n        }\n    if job_id == \"M02_CREATE_UNIT_DOMAIN_DATA\":\n        unit_id = projection[\"unit\"].get(\"unit_id\")\n        admitted = projection.get(\"admitted_sources\") or []\n        # Every declared fact resolves to an admitted source, which is D08's\n        # `domain_facts_sourced` check: the body is derived from the join, not\n        # invented alongside it.\n        facts = [\n            {\n                \"fact_id\": str(source.get(\"fact_id\")),\n                \"statement\": f\"scripted statement for {source.get('fact_id')}\",\n            }\n            for source in admitted\n        ] or [{\"fact_id\": \"required_explanation:000\", \"statement\": \"scripted statement\"}]\n        return {\n            \"domain_version\": {\n                \"unit_id\": unit_id,\n                \"fields\": {\n                    \"unit_id\": unit_id,\n                    \"facts\": facts,\n                    \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n                },\n                \"evidence_references\": [\n                    {\n                        \"source_id\": str(source.get(\"source_id\") or source.get(\"key\") or \"s1\"),\n                        \"source_location\": \"p.1\",\n                    }\n                    for source in admitted\n                ]\n                or [{\"source_id\": \"s1\", \"source_location\": \"p.1\"}],\n            }\n        }\n    if job_id == \"M03_WRITE_UNIT_CONTENT\":\n        admitted_domain = projection.get(\"admitted_domain\") or {}\n        unit_id = str(admitted_domain.get(\"unit_id\") or projection[\"unit\"].get(\"unit_id\"))\n        # Only the source ids D08 declared admissible may be cited; M03's adapter\n        # rejects any other as `candidate_undeclared_artifact`.\n        admissible = projection.get(\"admitted_evidence_references\") or []\n        return {\n            \"unit_content\": {\n                \"unit_id\": unit_id,\n                \"sections\": [\n                    {\n                        \"section_id\": f\"s{index:03d}\",\n                        \"heading\": f\"scripted heading {index}\",\n                        \"body\": f\"scripted body for {reference.get('fact_id')}\",\n                    }\n                    for index, reference in enumerate(admissible, start=1)\n                ],\n                \"evidence_references\": [\n                    {\n                        \"section_id\": f\"s{index:03d}\",\n                        \"source_id\": str(reference.get(\"source_id\")),\n                        \"source_location\": \"p.1\",\n                    }\n                    for index, reference in enumerate(admissible, start=1)\n                ],\n                # One visual of each subset, so the episode exercises both halves\n                # of D12's join: `schematic` is in `AUTHORITATIVE_VISUAL_KINDS`\n                # and is produced deterministically from the domain, `diagram` is\n                # not and is dispatched to M04.\n                \"visuals\": DECLARED_VISUALS,\n            }\n        }\n    if job_id == \"M04_CREATE_UNIT_VISUALS\":\n        brief_id = str(projection[\"brief\"].get(\"brief_id\") or projection[\"brief\"].get(\"key\"))\n        return {\n            \"visual_candidate\": {\n                \"brief_id\": brief_id,\n                \"prompt_text\": f\"scripted prompt for {brief_id}\",\n                \"dimensions\": {\"width_px\": 1024, \"height_px\": 768},\n                \"image_format\": \"png\",\n                \"accessibility_text\": f\"scripted alt text for {brief_id}\",\n            },\n            \"provenance_declaration\": {\n                \"brief_id\": brief_id,\n                \"permitted_facts_used\": [\n                    str(fact) for fact in (projection.get(\"permitted_facts\") or [])\n                ],\n                \"asserts_authoritative_detail\": False,\n            },\n        }\n    if job_id == \"M05_REVIEW_ACTUAL_UNIT\":\n        # The review answers the exact page denominator D15 froze, by hash: a\n        # review that invented or dropped a page is what D16's join exists to\n        # reject, so the scripted reviewer must not do either.\n        pages = projection.get(\"pages\") or []\n        return {\n            \"overall_findings\": [],\n            \"page_findings\": [\n                {\n                    \"page_number\": int(page[\"page_number\"]),\n                    \"page_sha256\": str(page[\"page_sha256\"]),\n                    \"findings\": [],\n                }\n                for page in pages\n            ],\n        }\n    raise AssertionError(f\"no scripted candidate for {job_id}\")\n\n\ndef _scripted_model_context(sandbox: Path) -> Any:\n    routes = mn.tp.load_job_registry()\n    return mn.ModelNodeContext(\n        transport=_ScriptedFakeTransport(sandbox_root=sandbox, registry=routes),\n        registry=routes,\n    )\n\n\n# The engine contracts the unit path resolves out of its engine root. D07 hands\n# the domain metaschema and calibration to M02, D08 loads the run's domain schema,\n# and D09 holds unit content to `CURRICULUM_CONTRACTS[0]`. They are copied from the\n# repo rather than stubbed, so the episode is held to the contracts a real run is.\nENGINE_CONTRACTS: tuple[str, ...] = (\n    \"schemas/manifest_domain.metaschema.v1.json\",\n    \"policy/calibration.v1.yaml\",\n    \"meta_prompt/assets/pedagogy.v1.md\",\n    *domain.CURRICULUM_CONTRACTS,\n)\n\n# The synthetic curriculum's own declared domain contract. A run that declares one\n# is the path D02/D08 are built for; the engine metaschema constrains the shape of\n# *this* file, not the domain instance a unit asserts.\nSYNTHETIC_DOMAIN_SCHEMA_RELATIVE = \"schemas/synthetic_domain.v1.json\"\nSYNTHETIC_DOMAIN_SCHEMA: dict[str, Any] = {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"$id\": \"plan26/test/synthetic_domain.v1.json\",\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"unit_id\", \"facts\", \"verifier_result\"],\n    \"properties\": {\n        \"unit_id\": {\"type\": \"string\", \"minLength\": 1},\n        \"facts\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\n                \"type\": \"object\",\n                \"additionalProperties\": False,\n                \"required\": [\"fact_id\", \"statement\"],\n                \"properties\": {\n                    \"fact_id\": {\"type\": \"string\", \"minLength\": 1},\n                    \"statement\": {\"type\": \"string\", \"minLength\": 1},\n                },\n            },\n        },\n        \"verifier_result\": {\n            \"type\": \"object\",\n            \"additionalProperties\": True,\n            \"required\": [\"result\"],\n            \"properties\": {\"result\": {\"type\": \"string\"}},\n        },\n    },\n}\n\n\ndef _build_episode_fixture(tmp_path: Path, units: int = 1) -> dict[str, Any]:\n    \"\"\"An engine root, a synthetic curriculum, an output root, and a sandbox.\"\"\"\n\n    engine = tmp_path / \"engine\"\n    curriculum = engine / \"curricula\" / \"synthetic\"\n    curriculum.mkdir(parents=True)\n    for name in (\"schemas\", \"policy\", \"meta_prompt\"):\n        (engine / name).mkdir()\n    (engine / \"schemas\" / \"placeholder.json\").write_text(\"{}\", encoding=\"utf-8\")\n    for relative in ENGINE_CONTRACTS:\n        target = engine / relative\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_bytes((REPO_ROOT / relative).read_bytes())\n    (engine / SYNTHETIC_DOMAIN_SCHEMA_RELATIVE).write_text(\n        json.dumps(SYNTHETIC_DOMAIN_SCHEMA, indent=2), encoding=\"utf-8\"\n    )\n    labs = [\n        {\n            \"id\": f\"U{index:03d}\",\n            \"title\": f\"synthetic unit {index}\",\n            \"sequence\": {\n                \"prerequisites\": [f\"U{index - 1:03d}\"] if index > 1 else [],\n                \"prepares_for\": [],\n            },\n            \"required_explanation\": [f\"fact {index}\"],\n            \"safety_focus\": [\"care\"],\n        }\n        for index in range(1, units + 1)\n    ]\n    manifest = curriculum / \"synthetic_curriculum.v1.yaml\"\n    manifest.write_text(\n        yaml.safe_dump(\n            {\n                \"domain\": {\"manifest_schema\": SYNTHETIC_DOMAIN_SCHEMA_RELATIVE},\n                \"labs\": labs,\n            },\n            sort_keys=False,\n        ),\n        encoding=\"utf-8\",\n    )\n    output_root = tmp_path / \"out\"\n    output_root.mkdir()\n    # The fake transport refuses any root that is not under the system temp dir.\n    sandbox = Path(tempfile.mkdtemp(prefix=\"plan26-n30-sandbox-\"))\n    return {\n        \"engine\": engine,\n        \"curriculum\": curriculum,\n        \"manifest\": manifest,\n        \"output_root\": output_root,\n        \"sandbox\": sandbox,\n    }\n\n\ndef _prepare_episode(fixture: dict[str, Any], *, mode: str = \"one\", requested: str | None = \"U001\"):\n    \"\"\"`prepare_episode_invocation` plus the envelope D00 reads, as the CLI builds them.\"\"\"\n\n    lock = P.ExecutionLock(fixture[\"output_root\"])\n    lock.acquire()\n    seed = {\n        \"engine_root\": str(fixture[\"engine\"]),\n        \"curriculum_root\": str(fixture[\"curriculum\"]),\n        \"active_manifest_path\": str(fixture[\"manifest\"]),\n        \"output_root\": str(fixture[\"output_root\"]),\n        \"created_at\": \"2026-01-01T00:00:00Z\",\n        \"contract_version\": \"1\",\n        \"mode\": mode,\n        \"requested_unit_id\": requested,\n    }\n    invocation = P.prepare_episode_invocation(\n        output_root=fixture[\"output_root\"], lock=lock, identity_seed=seed\n    )\n    envelope: dict[str, Any] = {\n        \"kind\": \"fresh\",\n        \"contract_version\": \"1\",\n        \"engine_root\": str(fixture[\"engine\"]),\n        \"curriculum_root\": str(fixture[\"curriculum\"]),\n        \"output_root\": str(fixture[\"output_root\"]),\n        \"mode\": mode,\n        \"requested_unit_id\": requested,\n        \"authorization\": {\"scope\": \"test\", \"executables\": []},\n        \"episode_ordinal\": 1,\n        \"prior_identity\": None,\n        \"prior_terminal\": None,\n        \"lease_open\": False,\n    }\n    # D03 requires the authorization to name this run's frozen digest, which the\n    # CLI computes before invocation; D01 is the one function that derives it.\n    probe = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    digest = inputs.D01_VALIDATE_AND_FREEZE_INPUTS({\"invocation\": envelope}, probe)[\"frozen_digest\"]\n    envelope[\"authorization\"] = {\n        \"scope\": \"test\",\n        \"executables\": [],\n        \"curriculum_digest\": digest,\n    }\n    return lock, invocation, envelope\n\n\ndef _run_episode(\n    monkeypatch: Any,\n    fixture: dict[str, Any],\n    *,\n    interrupt_after: str | None = None,\n) -> dict[str, Any]:\n    \"\"\"Execute one real episode of the real compiled graph, end to end.\n\n    Returns the ordered node trace, the per-node updates, and the final state.\n    \"\"\"\n\n    lock, invocation, envelope = _prepare_episode(fixture)\n    context = _HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    monkeypatch.setattr(\n        G,\n        \"build_model_node_context\",\n        lambda _context, **_kwargs: _scripted_model_context(fixture[\"sandbox\"]),\n    )\n    compiled = G.build_curriculum_factory_graph(\n        engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"]\n    )\n\n    trace: list[str] = []\n    updates: list[tuple[str, dict[str, Any]]] = []\n    deferred_frontier: str | None = None\n    try:\n        for chunk in compiled.stream(\n            {\"invocation\": envelope},\n            config=invocation.config,\n            stream_mode=\"updates\",\n            context=context,","numLines":380,"startLine":370,"totalLines":2693}}}
