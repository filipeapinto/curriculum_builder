keleton_wires_exactly_the_declared_edges(compiled):\n236\t    topology = G.compiled_topology(compiled)\n237\t    edges = {(source, target) for source, target, _ in topology[\"edges\"]}\n238\t\n239\t    for source, target in (\n240\t        (START, \"D00_BOOTSTRAP_EPISODE\"),\n241\t        (\"D00_BOOTSTRAP_EPISODE\", \"D01_VALIDATE_AND_FREEZE_INPUTS\"),\n242\t        (\"D00_BOOTSTRAP_EPISODE\", \"D00R_REVALIDATE_RESUME_IDENTITY\"),\n243\t        (\"D00_BOOTSTRAP_EPISODE\", \"D96_GRACEFUL_INTERRUPT_GATE\"),\n244\t        (\"D01_VALIDATE_AND_FREEZE_INPUTS\", \"D02_COMPILE_EFFECTIVE_RUN\"),\n245\t        (\"D02_COMPILE_EFFECTIVE_RUN\", \"D03_PROVE_CAPABILITIES\"),\n246\t        (\"D00R_REVALIDATE_RESUME_IDENTITY\", \"D03_PROVE_CAPABILITIES\"),\n247\t        (\"D03_PROVE_CAPABILITIES\", \"D04_INITIALIZE_OR_RESUME\"),\n248\t        (\"D04_INITIALIZE_OR_RESUME\", \"D05_SELECT_NEXT_UNIT\"),\n249\t        (\"D04_INITIALIZE_OR_RESUME\", \"D92_REENTER_VALIDATED_FRONTIER\"),\n250\t        (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n251\t        (\"D98_WRITE_TERMINAL\", END),\n252\t    ):\n253\t        assert (source, target) in edges, f\"missing skeleton edge {source} -> {target}\"\n254\t\n255\t    # Orphan recovery reaches no product node: D00's recovery branch and D96's\n256\t    # single successor are the whole of it.\n257\t    assert {t for s, t in edges if s == \"D96_GRACEFUL_INTERRUPT_GATE\"} == {\n258\t        \"D98_WRITE_TERMINAL\"\n259\t    }\n260\t\n261\t\n262\t# ============================================ TEST 2: bad bindings fail by stable ID\n263\t\n264\t\n265\tdef _placeholder_node(state, runtime):  # pragma: no cover - never registered\n266\t    return {}\n267\t\n268\t\n269\tdef test_a_missing_callable_fails_the_build_by_stable_id():\n270\t    bindings = G.binding_inventory()\n271\t    bindings.pop(\"D98_WRITE_TERMINAL\")\n272\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-MISSING:D98_WRITE_TERMINAL\"):\n273\t        G.register_skeleton(fresh_builder(), bindings)\n274\t\n275\t\n276\tdef test_a_test_only_or_placeholder_callable_fails_the_build_by_stable_id():\n277\t    bindings = G.binding_inventory()\n278\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = _placeholder_node\n279\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-PLACEHOLDER:D05_SELECT_NEXT_UNIT\"):\n280\t        G.register_skeleton(fresh_builder(), bindings)\n281\t\n282\t\n283\tdef test_a_duplicate_callable_fails_the_build_by_stable_id():\n284\t    bindings = G.binding_inventory()\n285\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = bindings[\"D13_RENDER_UNIT\"]\n286\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-DUPLICATE:\"):\n287\t        G.register_skeleton(fresh_builder(), bindings)\n288\t\n289\t\n290\tdef test_an_uncallable_binding_fails_the_build_by_stable_id():\n291\t    bindings = G.binding_inventory()\n292\t    bindings[\"D05_SELECT_NEXT_UNIT\"] = \"not a callable\"\n293\t    with pytest.raises(G.GraphBindingError, match=r\"N20-BIND-UNCALLABLE:D05_SELECT_NEXT_UNIT\"):\n294\t        G.register_skeleton(fresh_builder(), bindings)\n295\t\n296\t\n297\tdef test_a_dangling_skeleton_destination_fails_the_build_by_stable_id(monkeypatch):\n298\t    # Pin the required set to the real skeleton so the dangling-endpoint check is\n299\t    # what rejects the edge, not the missing-binding check that shadows it."}]},"parent_tool_use_id":null,"session_id":"18d83993-700d-4340-bec9-cb55c092357d","uuid":"31152084-5cc7-455b-b930-9eb1abba6c45","timestamp":"2026-08-12T21:55:26.982Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215023.910830Z-53d2cc5b32/repo/tests/runtime/test_plan26_topology.py","content":"    # missing or wrong skeleton node still fails this.\n    drawn = compiled.get_graph()\n    compiled_nodes = set(drawn.nodes) - {START, END}\n    skeleton_required = set(G._skeleton_required_nodes()) |