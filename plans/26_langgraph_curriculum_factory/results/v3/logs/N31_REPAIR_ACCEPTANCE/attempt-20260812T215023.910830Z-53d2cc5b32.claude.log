{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VL46tKGs3HpVEC5PNv6oMw","type":"tool_result","content":"1\t\"\"\"N31 acceptance tests: targeted repair (D17-D21) and unit acceptance (D16, D22, D23).\n2\t\n3\tTen TEST items from `prompts/N31_repair_acceptance.prompt.v2.md`. Every function\n4\tunder test is called directly and unmodified from `runtime.langgraph_factory.repair`\n5\t/ `acceptance`; TEST 9 additionally calls the real, unmodified\n6\t`runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's D98) rather than a\n7\tstand-in, and no test in this file writes to `nodes/terminal.py`.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport json\n13\tfrom typing import Any\n14\t\n15\timport pytest\n16\t\n17\tfrom runtime.langgraph_factory import acceptance, repair\n18\tfrom runtime.langgraph_factory.nodes import terminal\n19\tfrom runtime.langgraph_factory.nodes.domain import DOMAIN_CHECK_IDS\n20\tfrom runtime.langgraph_factory.nodes.content import CONTENT_CHECK_IDS\n21\tfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id\n22\tfrom runtime.langgraph_factory.state import FIELD_REDUCERS\n23\tfrom runtime.langgraph_factory import reducers as red\n24\t\n25\tRUN = \"run-n31\"\n26\tEPISODE = \"ep-n31\"\n27\tUNIT = \"U001\"\n28\t\n29\t\n30\tdef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n31\t    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n32\t\n33\t    merged = dict(state)\n34\t    for field, value in update.items():\n35\t        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n36\t    return merged\n37\t\n38\t\n39\tdef _domain_body() -> dict[str, Any]:\n40\t    return {\n41\t        \"unit_id\": UNIT,\n42\t        \"facts\": [{\"fact_id\": \"f1\", \"statement\": \"a fact\"}],\n43\t        \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n44\t    }\n45\t\n46\t\n47\tdef _content_body() -> dict[str, Any]:\n48\t    return {\n49\t        \"unit_id\": UNIT,\n50\t        \"sections\": [{\"section_id\": \"s1\", \"heading\": \"h\", \"body\": \"b\"}],\n51\t        \"claims\": [],\n52\t        \"derivations\": [],\n53\t    }\n54\t\n55\t\n56\tdef _visuals_body() -> dict[str, Any]:\n57\t    return {\"unit_id\": UNIT}\n58\t\n59\t\n60\tdef _head(version: int, parent_hash: str | None, hash_: str) -> dict[str, Any]:\n61\t    return {\"version\": version, \"parent_hash\": parent_hash, \"hash\": hash_}\n62\t\n63\t\n64\tdef _passing_state() -> dict[str, Any]:\n65\t    \"\"\"A unit whose full denominator currently passes (spec section 13.1).\"\"\"\n66\t\n67\t    domain_body = _domain_body()\n68\t    content_body = _content_body()\n69\t    visuals_body = _visuals_body()\n70\t    domain_hash = canonical_digest(domain_body)\n71\t    content_hash = canonical_digest(content_body)\n72\t    visuals_hash = canonical_digest(visuals_body)\n73\t    pdf_sha256 = \"f\" * 64\n74\t    page_sha = \"a\" * 64\n75\t\n76\t    domain_stream = stream_id(UNIT, \"domain\")\n77\t    content_stream = stream_id(UNIT, \"content\")\n78\t    visuals_stream = stream_id(UNIT, \"visuals\")\n79\t\n80\t    deterministic_checks = [\n81\t        {\n82\t            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash,\n83\t            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n84\t        }\n85\t        for check_id in DOMAIN_CHECK_IDS\n86\t    ] + [\n87\t        {\n88\t            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash,\n89\t            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n90\t        }\n91\t        for check_id in CONTENT_CHECK_IDS\n92\t    ]\n93\t\n94\t    review_candidate = {\n95\t        \"key\": \"candidate:review-1\",\n96\t        \"record_kind\": \"model_candidate\",\n97\t        \"pre_admission\": True,\n98\t        \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\",\n99\t        \"unit_pdf_sha256\": pdf_sha256,\n100\t        \"payload\": {\n101\t            \"overall_findings\": [],\n102\t            \"page_findings\": [{\"page_number\": 1, \"page_sha256\": page_sha, \"findings\": []}],\n103\t        },\n104\t    }\n105\t\n106\t    return {\n107\t        \"run_id\": RUN,\n108\t        \"episode_id\": EPISODE,\n109\t        \"selected_unit_id\": UNIT,\n110\t        \"effective_run\": {\"target_closure\": [UNIT]},\n111\t        \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0},\n112\t        \"unit_status\": {UNIT: \"REVIEWING\"},\n113\t        \"artifact_heads\": {\n114\t            domain_stream: _head(1, None, domain_hash),\n115\t            content_stream: _head(1, None, content_hash),\n116\t        },\n117\t        \"artifact_versions\": [\n118\t            {\"key\": f\"{domain_stream}@1\", \"stream\": domain_stream, \"version\": 1, \"parent_hash\": None, \"hash\": domain_hash, \"body\": domain_body},\n119\t            {\"key\": f\"{content_stream}@1\", \"stream\": content_stream, \"version\": 1, \"parent_hash\": None, \"hash\": content_hash, \"body\": content_body},\n120\t            {\"key\": f\"{visuals_stream}@1\", \"stream\": visuals_stream, \"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash, \"body\": visuals_body},"}]},"parent_tool_use_id":null,"session_id":"18d83993-700d-4340-bec9-cb55c092357d","uuid":"1f8718a8-d8d7-425a-be4f-c4b3eddeb3c3","timestamp":"2026-08-12T21:54:10.128Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215023.910830Z-53d2cc5b32/repo/tests/runtime/test_plan26_repair_acceptance.py","content":"\"\"\"N31 acceptance tests: targeted repair (D17-D21) and unit acceptance (D16, D22, D23).\n\nTen TEST items from `prompts/N31_repair_acceptance.prompt.v2.md`. Every function\nunder test is called directly and unmodified from `runtime.langgraph_factory.repair`\n/ `acceptance`; TEST 9 additionally calls the real, unmodified\n`runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's D98) rather than a\nstand-in, and no test in this file writes to `nodes/terminal.py`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom typing import Any\n\nimport pytest\n\nfrom runtime.langgraph_factory import acceptance, repair\nfrom runtime.langgraph_factory.nodes import terminal\nfrom runtime.langgraph_factory.nodes.domain import DOMAIN_CHECK_IDS\nfrom runtime.langgraph_factory.nodes.content import CONTENT_CHECK_IDS\nfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id\nfrom runtime.langgraph_factory.state import FIELD_REDUCERS\nfrom runtime.langgraph_factory import reducers as red\n\nRUN = \"run-n31\"\nEPISODE = \"ep-n31\"\nUNIT = \"U001\"\n\n\ndef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n\n    merged = dict(state)\n    for field, value in update.items():\n        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n    return merged\n\n\ndef _domain_body() -> dict[str, Any]:\n    return {\n        \"unit_id\": UNIT,\n        \"facts\": [{\"fact_id\": \"f1\", \"statement\": \"a fact\"}],\n        \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n    }\n\n\ndef _content_body() -> dict[str, Any]:\n    return {\n        \"unit_id\": UNIT,\n        \"sections\": [{\"section_id\": \"s1\", \"heading\": \"h\", \"body\": \"b\"}],\n        \"claims\": [],\n        \"derivations\": [],\n    }\n\n\ndef _visuals_body() -> dict[str, Any]:\n    return {\"unit_id\": UNIT}\n\n\ndef _head(version: int, parent_hash: str | None, hash_: str) -> dict[str, Any]:\n    return {\"version\": version, \"parent_hash\": parent_hash, \"hash\": hash_}\n\n\ndef _passing_state() -> dict[str, Any]:\n    \"\"\"A unit whose full denominator currently passes (spec section 13.1).\"\"\"\n\n    domain_body = _domain_body()\n    content_body = _content_body()\n    visuals_body = _visuals_body()\n    domain_hash = canonical_digest(domain_body)\n    content_hash = canonical_digest(content_body)\n    visuals_hash = canonical_digest(visuals_body)\n    pdf_sha256 = \"f\" * 64\n    page_sha = \"a\" * 64\n\n    domain_stream = stream_id(UNIT, \"domain\")\n    content_stream = stream_id(UNIT, \"content\")\n    visuals_stream = stream_id(UNIT, \"visuals\")\n\n    deterministic_checks = [\n        {\n            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": domain_hash,\n            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n        }\n        for check_id in DOMAIN_CHECK_IDS\n    ] + [\n        {\n            \"scope\": \"unit\", \"owner\": UNIT, \"head_hash\": content_hash,\n            \"check_id\": check_id, \"attempt\": 1, \"result\": \"PASS\", \"detail\": {},\n        }\n        for check_id in CONTENT_CHECK_IDS\n    ]\n\n    review_candidate = {\n        \"key\": \"candidate:review-1\",\n        \"record_kind\": \"model_candidate\",\n        \"pre_admission\": True,\n        \"job_id\": \"M05_REVIEW_ACTUAL_UNIT\",\n        \"unit_pdf_sha256\": pdf_sha256,\n        \"payload\": {\n            \"overall_findings\": [],\n            \"page_findings\": [{\"page_number\": 1, \"page_sha256\": page_sha, \"findings\": []}],\n        },\n    }\n\n    return {\n        \"run_id\": RUN,\n        \"episode_id\": EPISODE,\n        \"selected_unit_id\": UNIT,\n        \"effective_run\": {\"target_closure\": [UNIT]},\n        \"cursor\": {\"manifest_ordinal\": 1, \"accepted_ordinal\": 0},\n        \"unit_status\": {UNIT: \"REVIEWING\"},\n        \"artifact_heads\": {\n            domain_stream: _head(1, None, domain_hash),\n            content_stream: _head(1, None, content_hash),\n        },\n        \"artifact_versions\": [\n            {\"key\": f\"{domain_stream}@1\", \"stream\": domain_stream, \"version\": 1, \"parent_hash\": None, \"hash\": domain_hash, \"body\": domain_body},\n            {\"key\": f\"{content_stream}@1\", \"stream\": content_stream, \"version\": 1, \"parent_hash\": None, \"hash\": content_hash, \"body\": content_body},\n            {\"key\": f\"{visuals_stream}@1\", \"stream\": visuals_stream, \"version\": 1, \"parent_hash\": None, \"hash\": visuals_hash, \"body\": visuals_body},","numLines":120,"startLine":1,"totalLines":741}}}
