{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015GQQRrs7yEnthn3JJHW1fu","type":"tool_result","content":"1\t\"\"\"Per-unit topology: the D05-through-D15 loop, both `Send` map/reduces, resume re-entry.\n2\t\n3\tThis module is additive registration over the one `StateGraph` N20 builds in\n4\t`graph.py`. It creates no graph and calls no `compile()`: `register_unit_path`\n5\treceives the builder N20 already populated with `add_node` and adds only the\n6\tedges spec section 8.1's \"normal unit path\" declares.\n7\t\n8\tTwo things it deliberately does not do.\n9\t\n10\tIt registers no node body. N20's `validate_bindings` restricts a production\n11\tbinding to `runtime.langgraph_factory.nodes` and `runtime.langgraph_factory\n12\t.model_nodes`, so a callable authored here could not be a node even if this\n13\tmodule wanted one — which is the guarantee that keeps \"the graph compiled\"\n14\tmeaning \"the graph compiled against the owned node bodies\".\n15\t\n16\tIt invents no `Send` projection. Every fan-out edge translates the packet the\n17\tdispatching node staged (spec section 10: the denominator is immutable and\n18\tpersisted before dispatch). A projection materialized at routing time would be\n19\tone no denominator committed to, so where a node stages nothing, the fan-out\n20\tguard raises rather than improvising.\n21\t\n22\t`DEFERRED_EDGES` is the frozen record of every guard destination this path\n23\tdeclares whose node body does not exist yet, with the owning graph node. The\n24\tconditional edge is still registered over the destinations that do exist, so the\n25\tinterrupt and failure branches are real; a run that takes a deferred branch\n26\tfails loudly at the edge instead of silently halting.\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\tfrom collections.abc import Callable, Mapping, Sequence\n32\tfrom typing import Any\n33\t\n34\tfrom . import routing\n35\t\n36\t__all__ = [\n37\t    \"UNIT_NORMAL_EDGES\",\n38\t    \"UNIT_BRANCHES\",\n39\t    \"MODEL_BRANCH_DESTINATIONS\",\n40\t    \"RESUME_REENTRY_DESTINATIONS\",\n41\t    \"DEFERRED_EDGES\",\n42\t    \"BLOCKING_GAPS\",\n43\t    \"UnitTopologyError\",\n44\t    \"branch_destinations\",\n45\t    \"deferred_destinations\",\n46\t    \"unit_path_nodes\",\n47\t    \"register_unit_path\",\n48\t]\n49\t\n50\t\n51\tclass UnitTopologyError(RuntimeError):\n52\t    \"\"\"A per-unit edge names a node the builder cannot resolve.\"\"\"\n53\t\n54\t\n55\t# Spec 8.2's two documented map/reduce return edges. They are normal edges, not\n56\t# conditional ones: the worker returns through `union_disjoint` and the barrier —\n57\t# never the worker — decides what happens next.\n58\tUNIT_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n59\t    (\"D11_CREATE_DETERMINISTIC_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\"),\n60\t    (\"M04_CREATE_UNIT_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\"),\n61\t)\n62\t\n63\t# Every conditional edge of the normal unit path, in spec 8.1 order. The guard is\n64\t# N20's; this module owns only which node it is attached to.\n65\tUNIT_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], Any]], ...] = (\n66\t    (\"D92_REENTER_VALIDATED_FRONTIER\", routing.route_frontier_reentry),\n67\t    (\"D05_SELECT_NEXT_UNIT\", routing.route_unit_selection),\n68\t    (\"D06_COMPILE_SOURCE_REQUESTS\", routing.route_source_discovery_fanout),\n69\t    (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", routing.route_source_interpretation_fanout),\n70\t    (\"D07_CORRELATE_AND_ADMIT_SOURCES\", routing.route_source_admission),\n71\t    (\"D30_CLASSIFY_PREREQUISITE\", routing.route_prerequisite),\n72\t    (\"D08_VALIDATE_DOMAIN\", routing.route_domain_validation),\n73\t    (\"D09_VALIDATE_CONTENT\", routing.route_content_validation),\n74\t    (\"D10_COMPILE_VISUAL_BRIEFS\", routing.route_visual_briefs),\n75\t    (\"D12_VISUAL_BARRIER_AND_JOIN\", routing.route_visual_barrier),\n76\t    (\"D13_RENDER_UNIT\", routing.route_unit_render),\n77\t    (\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", routing.route_page_inspection),\n78\t    (\"D15_FREEZE_UNIT_REVIEW_PACKET\", routing.route_review_packet),\n79\t    (\"M01_RESEARCH_UNIT_SOURCES\", routing.route_m01_research),\n80\t    (\"M02_CREATE_UNIT_DOMAIN_DATA\", routing.route_m02_domain),\n81\t    (\"M03_WRITE_UNIT_CONTENT\", routing.route_m03_content),\n82\t    (\"M05_REVIEW_ACTUAL_UNIT\", routing.route_m05_unit_review),\n83\t    (\"D90_RESERVE_MODEL_ATTEMPT\", routing.route_attempt_reservation),\n84\t    (\"D91_CLASSIFY_MODEL_FAILURE\", routing.route_model_failure),\n85\t)\n86\t\n87\t# A model node's own guard has no `GUARD_DESTINATIONS` row: its accepted result\n88\t# goes where `MODEL_RESULT_DESTINATIONS` says, and its failure goes to the\n89\t# classifier. M01's two supersteps are resolved by result presence, so both of\n90\t# its destinations are declared here rather than chosen by the model.\n91\tMODEL_BRANCH_DESTINATIONS: Mapping[str, tuple[str, ...]] = {\n92\t    \"M01_RESEARCH_UNIT_SOURCES\": (\n93\t        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n94\t        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n95\t        routing.MODEL_FAILURE_CLASSIFIER,\n96\t        routing.INTERRUPT_GATE,\n97\t    ),\n98\t    \"M02_CREATE_UNIT_DOMAIN_DATA\": (\n99\t        \"D08_VALIDATE_DOMAIN\",\n100\t        routing.MODEL_FAILURE_CLASSIFIER,\n101\t        routing.INTERRUPT_GATE,\n102\t    ),\n103\t    \"M03_WRITE_UNIT_CONTENT\": (\n104\t        \"D09_VALIDATE_CONTENT\",\n105\t        routing.MODEL_FAILURE_CLASSIFIER,\n106\t        routing.INTERRUPT_GATE,\n107\t    ),\n108\t    \"M05_REVIEW_ACTUAL_UNIT\": (\n109\t        \"D16_REDUCE_UNIT_EVIDENCE\",\n110\t        routing.MODEL_FAILURE_CLASSIFIER,\n111\t        routing.INTERRUPT_GATE,\n112\t    ),\n113\t    # D90's authorized destination is the job its reservation names, which is a\n114\t    # dynamic guard value: the path map has to enumerate every model job this\n115\t    # path can reserve for, or the compiled edge cannot reach the one reserved.\n116\t    \"D90_RESERVE_MODEL_ATTEMPT\": (\n117\t        \"M01_RESEARCH_UNIT_SOURCES\",\n118\t        \"M02_CREATE_UNIT_DOMAIN_DATA\",\n119\t        \"M03_WRITE_UNIT_CONTENT\",\n120\t        \"M04_CREATE_UNIT_VISUALS\",\n121\t        \"M05_REVIEW_ACTUAL_UNIT\",\n122\t        routing.TERMINAL,\n123\t        routing.INTERRUPT_GATE,\n124\t    ),\n125\t    \"D91_CLASSIFY_MODEL_FAILURE\": (\n126\t        routing.ATTEMPT_RESERVATION,\n127\t        \"D17_CLASSIFY_UNIT_FINDINGS\",\n128\t        routing.TERMINAL,\n129\t        routing.INTERRUPT_GATE,\n130\t    ),\n131\t}\n132\t\n133\t# D92 may name only a deterministic node with current parents (spec 6.2). These\n134\t# are exactly the deterministic nodes of this path that a validated frontier can\n135\t# re-enter; D11 is absent deliberately — it is a `Send` worker whose incomplete\n136\t# members are re-dispatched by D10's guard, never re-entered directly.\n137\tRESUME_REENTRY_DESTINATIONS: tuple[str, ...] = (\n138\t    \"D05_SELECT_NEXT_UNIT\",\n139\t    \"D06_COMPILE_SOURCE_REQUESTS\",\n140\t    \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n141\t    \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n142\t    \"D08_VALIDATE_DOMAIN\",\n143\t    \"D09_VALIDATE_CONTENT\",\n144\t    \"D10_COMPILE_VISUAL_BRIEFS\",\n145\t    \"D12_VISUAL_BARRIER_AND_JOIN\",\n146\t    \"D13_RENDER_UNIT\",\n147\t    \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n148\t    \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n149\t    \"D30_CLASSIFY_PREREQUISITE\",\n150\t)\n151\t\n152\t# (source, guard value, destination, owning graph node). Every row is a real\n153\t# spec 8.2 edge whose destination node body is not implemented yet; the row is\n154\t# the contract the owner implements against.\n155\tDEFERRED_EDGES: tuple[tuple[str, str, str, str], ...] = (\n156\t    (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\",\n157\t     \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\"),\n158\t    (\"D08_VALIDATE_DOMAIN\", \"domain_repairable\",\n159\t     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n160\t    (\"D09_VALIDATE_CONTENT\", \"content_repairable\",\n161\t     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n162\t    (\"D12_VISUAL_BARRIER_AND_JOIN\", \"visuals_repairable\",\n163\t     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n164\t    (\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"layout_repairable\",\n165\t     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n166\t    (\"D91_CLASSIFY_MODEL_FAILURE\", \"repair\",\n167\t     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n168\t    (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\",\n169\t     \"D16_REDUCE_UNIT_EVIDENCE\", \"N31_REPAIR_ACCEPTANCE\"),\n170\t)\n171\t\n172\t# What this path cannot execute, and who owns each gap. These are structural,\n173\t# reproducible facts about the current tree, not judgements: each row names the\n174\t# exact call that fails and the rework edge from `implementation.graph.v2.yaml`.\n175\t#\n176\t# Empty as of generation 9. Every row this table has ever carried — B-1 through\n177\t# B-13 — was closed by its named owner and re-verified here by executing the real\n178\t# compiled graph, not by report: the unit path now runs from D00 to a real M05\n179\t# review and stops at `D16_REDUCE_UNIT_EVIDENCE`, which is a declared row of\n180\t# `DEFERRED_EDGES` and this node's handoff to N31, not a gap.\n181\t#\n182\t# The table stays declared rather than deleted because\n183\t# `test_every_blocking_gap_is_declared_with_an_owner_and_rework_edge` asserts its\n184\t# shape, so a future gap has one place to be recorded and cannot be noted in prose\n185\t# alone.\n186\tBLOCKING_GAPS: tuple[Mapping[str, str], ...] = ()\n187\t\n188\t\n189\tdef branch_destinations(source: str, available: Sequence[str]) -> tuple[str, ...]:\n190\t    \"\"\"Every destination `source` declares that a node body currently exists for.\"\"\"\n191\t\n192\t    declared = set(MODEL_BRANCH_DESTINATIONS.get(source, routing.guard_destinations(source)))\n193\t    if source == \"D92_REENTER_VALIDATED_FRONTIER\":\n194\t        declared.update(RESUME_REENTRY_DESTINATIONS)\n195\t    return tuple(sorted(declared & set(available)))\n196\t\n197\t\n198\tdef deferred_destinations(source: str, available: Sequence[str]) -> tuple[str, ...]:\n199\t    \"\"\"Every destination `source` declares that has no node body yet.\"\"\"\n200\t\n201\t    declared = set(MODEL_BRANCH_DESTINATIONS.get(source, routing.guard_destinations(source)))\n202\t    if source == \"D92_REENTER_VALIDATED_FRONTIER\":\n203\t        declared.update(RESUME_REENTRY_DESTINATIONS)\n204\t    return tuple(sorted(declared - set(available)))\n205\t\n206\t\n207\tdef unit_path_nodes() -> tuple[str, ...]:\n208\t    \"\"\"Every node this module wires as an edge source or a normal-edge endpoint.\"\"\"\n209\t\n210\t    nodes = {source for source, _ in UNIT_BRANCHES}\n211\t    for source, target in UNIT_NORMAL_EDGES:\n212\t        nodes.update({source, target})\n213\t    return tuple(sorted(nodes))\n214\t\n215\t\n216\tdef register_unit_path(builder: Any, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n217\t    \"\"\"Add the per-unit edges to the builder N20 already registered nodes on.\n218\t\n219\t    Returns the resolved path map per source, so the caller can assert the\n220\t    registered topology rather than trusting this function's own description of\n221\t    it. Adds no node and compiles nothing.\n222\t    \"\"\"\n223\t\n224\t    available = tuple(available)\n225\t    known = set(available)\n226\t    for node_id in unit_path_nodes():\n227\t        if node_id not in known:\n228\t            raise UnitTopologyError(\n229\t                f\"N30-EDGE-DANGLING:{node_id}: the unit path names a node with no \"\n230\t                f\"registered body\"\n231\t            )\n232\t\n233\t    declared_deferred = {(source, destination) for source, _, destination, _ in DEFERRED_EDGES}\n234\t    resolved: dict[str, tuple[str, ...]] = {}\n235\t    for source, _ in UNIT_BRANCHES:\n236\t        for destination in deferred_destinations(source, available):\n237\t            if (source, destination) not in declared_deferred:\n238\t                raise UnitTopologyError(\n239\t                    f\"N30-EDGE-UNDECLARED:{source}: destination {destination!r} has no \"\n240\t                    f\"node body and is not declared in DEFERRED_EDGES\"\n241\t                )\n242\t\n243\t    for source, target in UNIT_NORMAL_EDGES:\n244\t        builder.add_edge(source, target)\n245\t\n246\t    for source, path in UNIT_BRANCHES:\n247\t        destinations = branch_destinations(source, available)\n248\t        if not destinations:\n249\t            raise UnitTopologyError(\n250\t                f\"N30-EDGE-EMPTY:{source}: every declared destination is deferred\"\n251\t            )\n252\t        builder.add_conditional_edges(\n253\t            source, path, {target: target for target in destinations}\n254\t        )\n255\t        resolved[source] = destinations\n256\t    return resolved\n257\t"}]},"parent_tool_use_id":null,"session_id":"18d83993-700d-4340-bec9-cb55c092357d","uuid":"60662d68-94ab-4c18-b429-8e3009cc63b9","timestamp":"2026-08-12T21:51:05.341Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N31_REPAIR_ACCEPTANCE/attempt-20260812T215023.910830Z-53d2cc5b32/repo/runtime/langgraph_factory/unit_graph.py","content":"\"\"\"Per-unit topology: the D05-through-D15 loop, both `Send` map/reduces, resume re-entry.\n\nThis module is additive registration over the one `StateGraph` N20 builds in\n`graph.py`. It creates no graph and calls no `compile()`: `register_unit_path`\nreceives the builder N20 already populated with `add_node` and adds only the\nedges spec section 8.1's \"normal unit path\" declares.\n\nTwo things it deliberately does not do.\n\nIt registers no node body. N20's `validate_bindings` restricts a production\nbinding to `runtime.langgraph_factory.nodes` and `runtime.langgraph_factory\n.model_nodes`, so a callable authored here could not be a node even if this\nmodule wanted one — which is the guarantee that keeps \"the graph compiled\"\nmeaning \"the graph compiled against the owned node bodies\".\n\nIt invents no `Send` projection. Every fan-out edge translates the packet the\ndispatching node staged (spec section 10: the denominator is immutable and\npersisted before dispatch). A projection materialized at routing time would be\none no denominator committed to, so where a node stages nothing, the fan-out\nguard raises rather than improvising.\n\n`DEFERRED_EDGES` is the frozen record of every guard destination this path\ndeclares whose node body does not exist yet, with the owning graph node. The\nconditional edge is still registered over the destinations that do exist, so the\ninterrupt and failure branches are real; a run that takes a deferred branch\nfails loudly at the edge instead of silently halting.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable, Mapping, Sequence\nfrom typing import Any\n\nfrom . import routing\n\n__all__ = [\n    \"UNIT_NORMAL_EDGES\",\n    \"UNIT_BRANCHES\",\n    \"MODEL_BRANCH_DESTINATIONS\",\n    \"RESUME_REENTRY_DESTINATIONS\",\n    \"DEFERRED_EDGES\",\n    \"BLOCKING_GAPS\",\n    \"UnitTopologyError\",\n    \"branch_destinations\",\n    \"deferred_destinations\",\n    \"unit_path_nodes\",\n    \"register_unit_path\",\n]\n\n\nclass UnitTopologyError(RuntimeError):\n    \"\"\"A per-unit edge names a node the builder cannot resolve.\"\"\"\n\n\n# Spec 8.2's two documented map/reduce return edges. They are normal edges, not\n# conditional ones: the worker returns through `union_disjoint` and the barrier —\n# never the worker — decides what happens next.\nUNIT_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n    (\"D11_CREATE_DETERMINISTIC_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\"),\n    (\"M04_CREATE_UNIT_VISUALS\", \"D12_VISUAL_BARRIER_AND_JOIN\"),\n)\n\n# Every conditional edge of the normal unit path, in spec 8.1 order. The guard is\n# N20's; this module owns only which node it is attached to.\nUNIT_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], Any]], ...] = (\n    (\"D92_REENTER_VALIDATED_FRONTIER\", routing.route_frontier_reentry),\n    (\"D05_SELECT_NEXT_UNIT\", routing.route_unit_selection),\n    (\"D06_COMPILE_SOURCE_REQUESTS\", routing.route_source_discovery_fanout),\n    (\"D06B_RETRIEVE_SOURCE_CANDIDATES\", routing.route_source_interpretation_fanout),\n    (\"D07_CORRELATE_AND_ADMIT_SOURCES\", routing.route_source_admission),\n    (\"D30_CLASSIFY_PREREQUISITE\", routing.route_prerequisite),\n    (\"D08_VALIDATE_DOMAIN\", routing.route_domain_validation),\n    (\"D09_VALIDATE_CONTENT\", routing.route_content_validation),\n    (\"D10_COMPILE_VISUAL_BRIEFS\", routing.route_visual_briefs),\n    (\"D12_VISUAL_BARRIER_AND_JOIN\", routing.route_visual_barrier),\n    (\"D13_RENDER_UNIT\", routing.route_unit_render),\n    (\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", routing.route_page_inspection),\n    (\"D15_FREEZE_UNIT_REVIEW_PACKET\", routing.route_review_packet),\n    (\"M01_RESEARCH_UNIT_SOURCES\", routing.route_m01_research),\n    (\"M02_CREATE_UNIT_DOMAIN_DATA\", routing.route_m02_domain),\n    (\"M03_WRITE_UNIT_CONTENT\", routing.route_m03_content),\n    (\"M05_REVIEW_ACTUAL_UNIT\", routing.route_m05_unit_review),\n    (\"D90_RESERVE_MODEL_ATTEMPT\", routing.route_attempt_reservation),\n    (\"D91_CLASSIFY_MODEL_FAILURE\", routing.route_model_failure),\n)\n\n# A model node's own guard has no `GUARD_DESTINATIONS` row: its accepted result\n# goes where `MODEL_RESULT_DESTINATIONS` says, and its failure goes to the\n# classifier. M01's two supersteps are resolved by result presence, so both of\n# its destinations are declared here rather than chosen by the model.\nMODEL_BRANCH_DESTINATIONS: Mapping[str, tuple[str, ...]] = {\n    \"M01_RESEARCH_UNIT_SOURCES\": (\n        \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n        \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n        routing.MODEL_FAILURE_CLASSIFIER,\n        routing.INTERRUPT_GATE,\n    ),\n    \"M02_CREATE_UNIT_DOMAIN_DATA\": (\n        \"D08_VALIDATE_DOMAIN\",\n        routing.MODEL_FAILURE_CLASSIFIER,\n        routing.INTERRUPT_GATE,\n    ),\n    \"M03_WRITE_UNIT_CONTENT\": (\n        \"D09_VALIDATE_CONTENT\",\n        routing.MODEL_FAILURE_CLASSIFIER,\n        routing.INTERRUPT_GATE,\n    ),\n    \"M05_REVIEW_ACTUAL_UNIT\": (\n        \"D16_REDUCE_UNIT_EVIDENCE\",\n        routing.MODEL_FAILURE_CLASSIFIER,\n        routing.INTERRUPT_GATE,\n    ),\n    # D90's authorized destination is the job its reservation names, which is a\n    # dynamic guard value: the path map has to enumerate every model job this\n    # path can reserve for, or the compiled edge cannot reach the one reserved.\n    \"D90_RESERVE_MODEL_ATTEMPT\": (\n        \"M01_RESEARCH_UNIT_SOURCES\",\n        \"M02_CREATE_UNIT_DOMAIN_DATA\",\n        \"M03_WRITE_UNIT_CONTENT\",\n        \"M04_CREATE_UNIT_VISUALS\",\n        \"M05_REVIEW_ACTUAL_UNIT\",\n        routing.TERMINAL,\n        routing.INTERRUPT_GATE,\n    ),\n    \"D91_CLASSIFY_MODEL_FAILURE\": (\n        routing.ATTEMPT_RESERVATION,\n        \"D17_CLASSIFY_UNIT_FINDINGS\",\n        routing.TERMINAL,\n        routing.INTERRUPT_GATE,\n    ),\n}\n\n# D92 may name only a deterministic node with current parents (spec 6.2). These\n# are exactly the deterministic nodes of this path that a validated frontier can\n# re-enter; D11 is absent deliberately — it is a `Send` worker whose incomplete\n# members are re-dispatched by D10's guard, never re-entered directly.\nRESUME_REENTRY_DESTINATIONS: tuple[str, ...] = (\n    \"D05_SELECT_NEXT_UNIT\",\n    \"D06_COMPILE_SOURCE_REQUESTS\",\n    \"D06B_RETRIEVE_SOURCE_CANDIDATES\",\n    \"D07_CORRELATE_AND_ADMIT_SOURCES\",\n    \"D08_VALIDATE_DOMAIN\",\n    \"D09_VALIDATE_CONTENT\",\n    \"D10_COMPILE_VISUAL_BRIEFS\",\n    \"D12_VISUAL_BARRIER_AND_JOIN\",\n    \"D13_RENDER_UNIT\",\n    \"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\",\n    \"D15_FREEZE_UNIT_REVIEW_PACKET\",\n    \"D30_CLASSIFY_PREREQUISITE\",\n)\n\n# (source, guard value, destination, owning graph node). Every row is a real\n# spec 8.2 edge whose destination node body is not implemented yet; the row is\n# the contract the owner implements against.\nDEFERRED_EDGES: tuple[tuple[str, str, str, str], ...] = (\n    (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\",\n     \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\"),\n    (\"D08_VALIDATE_DOMAIN\", \"domain_repairable\",\n     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n    (\"D09_VALIDATE_CONTENT\", \"content_repairable\",\n     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n    (\"D12_VISUAL_BARRIER_AND_JOIN\", \"visuals_repairable\",\n     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n    (\"D14_INVENTORY_AND_INSPECT_UNIT_PAGES\", \"layout_repairable\",\n     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n    (\"D91_CLASSIFY_MODEL_FAILURE\", \"repair\",\n     \"D17_CLASSIFY_UNIT_FINDINGS\", \"N31_REPAIR_ACCEPTANCE\"),\n    (\"M05_REVIEW_ACTUAL_UNIT\", \"review_returned\",\n     \"D16_REDUCE_UNIT_EVIDENCE\", \"N31_REPAIR_ACCEPTANCE\"),\n)\n\n# What this path cannot execute, and who owns each gap. These are structural,\n# reproducible facts about the current tree, not judgements: each row names the\n# exact call that fails and the rework edge from `implementation.graph.v2.yaml`.\n#\n# Empty as of generation 9. Every row this table has ever carried — B-1 through\n# B-13 — was closed by its named owner and re-verified here by executing the real\n# compiled graph, not by report: the unit path now runs from D00 to a real M05\n# review and stops at `D16_REDUCE_UNIT_EVIDENCE`, which is a declared row of\n# `DEFERRED_EDGES` and this node's handoff to N31, not a gap.\n#\n# The table stays declared rather than deleted because\n# `test_every_blocking_gap_is_declared_with_an_owner_and_rework_edge` asserts its\n# shape, so a future gap has one place to be recorded and cannot be noted in prose\n# alone.\nBLOCKING_GAPS: tuple[Mapping[str, str], ...] = ()\n\n\ndef branch_destinations(source: str, available: Sequence[str]) -> tuple[str, ...]:\n    \"\"\"Every destination `source` declares that a node body currently exists for.\"\"\"\n\n    declared = set(MODEL_BRANCH_DESTINATIONS.get(source, routing.guard_destinations(source)))\n    if source == \"D92_REENTER_VALIDATED_FRONTIER\":\n        declared.update(RESUME_REENTRY_DESTINATIONS)\n    return tuple(sorted(declared & set(available)))\n\n\ndef deferred_destinations(source: str, available: Sequence[str]) -> tuple[str, ...]:\n    \"\"\"Every destination `source` declares that has no node body yet.\"\"\"\n\n    declared = set(MODEL_BRANCH_DESTINATIONS.get(source, routing.guard_destinations(source)))\n    if source == \"D92_REENTER_VALIDATED_FRONTIER\":\n        declared.update(RESUME_REENTRY_DESTINATIONS)\n    return tuple(sorted(declared - set(available)))\n\n\ndef unit_path_nodes() -> tuple[str, ...]:\n    \"\"\"Every node this module wires as an edge source or a normal-edge endpoint.\"\"\"\n\n    nodes = {source for source, _ in UNIT_BRANCHES}\n    for source, target in UNIT_NORMAL_EDGES:\n        nodes.update({source, target})\n    return tuple(sorted(nodes))\n\n\ndef register_unit_path(builder: Any, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n    \"\"\"Add the per-unit edges to the builder N20 already registered nodes on.\n\n    Returns the resolved path map per source, so the caller can assert the\n    registered topology rather than trusting this function's own description of\n    it. Adds no node and compiles nothing.\n    \"\"\"\n\n    available = tuple(available)\n    known = set(available)\n    for node_id in unit_path_nodes():\n        if node_id not in known:\n            raise UnitTopologyError(\n                f\"N30-EDGE-DANGLING:{node_id}: the unit path names a node with no \"\n                f\"registered body\"\n            )\n\n    declared_deferred = {(source, destination) for source, _, destination, _ in DEFERRED_EDGES}\n    resolved: dict[str, tuple[str, ...]] = {}\n    for source, _ in UNIT_BRANCHES:\n        for destination in deferred_destinations(source, available):\n            if (source, destination) not in declared_deferred:\n                raise UnitTopologyError(\n                    f\"N30-EDGE-UNDECLARED:{source}: destination {destination!r} has no \"\n                    f\"node body and is not declared in DEFERRED_EDGES\"\n                )\n\n    for source, target in UNIT_NORMAL_EDGES:\n        builder.add_edge(source, target)\n\n    for source, path in UNIT_BRANCHES:\n        destinations = branch_destinations(source, available)\n        if not destinations:\n            raise UnitTopologyError(\n                f\"N30-EDGE-EMPTY:{source}: every declared destination is deferred\"\n            )\n        builder.add_conditional_edges(\n            source, path, {target: target for target in destinations}\n        )\n        resolved[source] = destinations\n    return resolved\n","numLines":257,"startLine":1,"totalLines":257}}}
