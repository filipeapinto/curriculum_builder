{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019SQQEgJhFWKCXys1tXDekM","type":"tool_result","content":"1\t\"\"\"N40 CLI cutover proof: `runtime.run_curriculum` as the sole production entry.\n2\t\n3\tCovers the node's own TEST checklist:\n4\t\n5\t1. static + runtime call-graph proof of one production graph builder/path\n6\t2. CLI help exposes no legacy simulation/session-bridge/custom-controller path\n7\t3. mode mutual exclusion, arguments, canonical paths, collision/resume rules,\n8\t   stdout JSON, stderr diagnostics, and exit codes\n9\t4. preflight is read-only and cannot emit product success\n10\t5. CLI code contains no product nodes, guards, joins, acceptance, or frontier\n11\t   selection\n12\t6. missing authorization/capability fails before transmission and never\n13\t   simulates\n14\t7. existing Plan 25 roots are readable history but refused for Plan 26 resume\n15\t8. production import audit rejects LangChain wrappers/provider SDKs/direct\n16\t   model HTTP\n17\t\n18\tThe heavy graph/transport machinery (real LangGraph compilation, real model\n19\ttransport, real checkpoint durability) is proven elsewhere (N20/N21/N30/N32's\n20\town suites); this module proves the CLI *wires* those pieces correctly, using\n21\tthe real persistence layer wherever it is cheap and safe to do so (no model\n22\tsubprocess, no network) and narrow mocks only where a real call would need a\n23\tlive Codex/Gemini installation this environment does not have.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport ast\n29\timport io\n30\timport json\n31\timport re\n32\timport unittest\n33\tfrom contextlib import redirect_stderr, redirect_stdout\n34\tfrom pathlib import Path\n35\tfrom types import SimpleNamespace\n36\tfrom unittest import mock\n37\t\n38\tfrom runtime.langgraph_factory import persistence as P\n39\tfrom runtime.langgraph_factory import transport as tp\n40\t\n41\timport runtime.run_curriculum as R\n42\t\n43\tREPO_ROOT = Path(__file__).resolve().parents[2]\n44\tCLI_SOURCE_PATH = REPO_ROOT / \"runtime\" / \"run_curriculum.py\"\n45\tCLI_SOURCE = CLI_SOURCE_PATH.read_text(encoding=\"utf-8\")\n46\tCLI_AST = ast.parse(CLI_SOURCE, filename=str(CLI_SOURCE_PATH))\n47\t\n48\t\n49\tdef _run_main(argv: list[str]) -> tuple[int, dict, str]:\n50\t    out, err = io.StringIO(), io.StringIO()\n51\t    with redirect_stdout(out), redirect_stderr(err):\n52\t        code = R.main(argv)\n53\t    text = out.getvalue()\n54\t    assert text.count(\"\\n\") == 1, f\"expected exactly one JSON line on stdout, got: {text!r}\"\n55\t    return code, json.loads(text), err.getvalue()\n56\t\n57\t\n58\tdef _authorization_file(tmp_path: Path, **overrides) -> Path:\n59\t    payload = {\n60\t        \"approved_at_utc\": \"2026-01-01T00:00:00+00:00\",\n61\t        \"expires_at_utc\": \"2099-01-01T00:00:00+00:00\",\n62\t        \"providers\": {},\n63\t        \"executables\": [],\n64\t    }\n65\t    payload.update(overrides)\n66\t    path = tmp_path / \"authorization.json\"\n67\t    path.write_text(json.dumps(payload), encoding=\"utf-8\")\n68\t    return path\n69\t\n70\t\n71\t# ===========================================================================\n72\t# TEST 1 / 5 / 8 — static source and import-graph audit\n73\t# ===========================================================================\n74\t\n75\t\n76\tclass ImportGraphAuditTests(unittest.TestCase):\n77\t    \"\"\"No node reads this file; it is read once, at collection time.\"\"\"\n78\t\n79\t    def _imported_names(self) -> list[tuple[str, str]]:\n80\t        \"\"\"Every `(module, attribute)` this file imports, `attribute` \"\" for a bare import.\"\"\"\n81\t        found: list[tuple[str, str]] = []\n82\t        for node in ast.walk(CLI_AST):\n83\t            if isinstance(node, ast.ImportFrom):\n84\t                module = node.module or \"\"\n85\t                for alias in node.names:\n86\t                    found.append((module, alias.name))\n87\t            elif isinstance(node, ast.Import):\n88\t                for alias in node.names:\n89\t                    found.append((alias.name, \"\"))\n90\t        return found\n91\t\n92\t    def test_no_plan25_or_legacy_runtime_modules_are_imported(self):\n93\t        forbidden_modules = {\n94\t            \"runtime.controller\",\n95\t            \"runtime.curriculum_factory_graph\",\n96\t            \"runtime.model_worker\",\n97\t            \"runtime.session_bridge\",\n98\t            \"runtime.checks\",\n99\t            \"runtime.checkpoint\",\n100\t            \"runtime.capability_cycle\",\n101\t        }\n102\t        forbidden_names = {\"CurriculumFactoryGraph\", \"CodexWorker\", \"CurriculumRuntime\", \"GeminiReviewer\"}\n103\t        for module, name in self._imported_names():\n104\t            self.assertNotIn(module, forbidden_modules, f\"legacy module imported: {module}\")\n105\t            self.assertNotIn(name, forbidden_names, f\"legacy symbol imported: {name}\")\n106\t\n107\t    def test_only_two_narrow_pure_helpers_are_imported_from_nodes_inputs(self):\n108\t        \"\"\"The one declared exception: identity/freeze helpers, not node bodies.\"\"\"\n109\t        from_nodes = sorted(name for module, name in self._imported_names() if module.endswith(\"nodes.inputs\"))\n110\t        self.assertEqual(from_nodes, [\"REQUIRED_CAPABILITIES\", \"_frozen_input_records\", \"_resolve_active_manifest\"])\n111\t\n112\t    def test_no_import_from_any_other_nodes_or_routing_or_workbook_module(self):\n113\t        forbidden_module_suffixes = (\n114\t            \"nodes.domain\", \"nodes.content\", \"nodes.sources\", \"nodes.render\",\n115\t            \"nodes.review\", \"nodes.visuals\", \"nodes.terminal\", \"nodes\",\n116\t            \"routing\", \"workbook\", \"unit_graph\", \"model_nodes\", \"repair\",\n117\t        )\n118\t        for module, _name in self._imported_names():\n119\t            if module.endswith(\"nodes.inputs\") or module in (\"runtime.langgraph_factory.graph\",):\n120\t                continue\n121\t            for suffix in forbidden_module_suffixes:\n122\t                self.assertFalse(\n123\t                    module == f\"runtime.langgraph_factory.{suffix}\" or module.endswith(f\".{suffix}\"),\n124\t                    f\"unexpected node/topology import: {module}\",\n125\t                )\n126\t\n127\t    def test_no_langchain_provider_sdk_or_direct_http_imports(self):\n128\t        forbidden = (\"langchain\", \"openai\", \"anthropic\", \"google.generativeai\", \"requests\", \"httpx\", \"urllib3\")\n129\t        for module, name in self._imported_names():\n130\t            haystack = f\"{module}.{name}\".lower()\n131\t            for bad in forbidden:\n132\t                self.assertNotIn(bad, haystack, f\"forbidden provider/HTTP import: {module} / {name}\")\n133\t\n134\t    def test_no_product_node_or_guard_identifiers_appear_in_source(self):\n135\t        \"\"\"D00-D98 and M01-M08 are never named: the CLI cannot call, route, or\n136\t        guard against a node it never imports.\"\"\"\n137\t        node_id_pattern = re.compile(r\"\\b(?:D\\d{2}[A-Z0-9_]*|M0[1-8][A-Z0-9_]*)\\b\")\n138\t        hits = sorted(set(node_id_pattern.findall(CLI_SOURCE)))\n139\t        self.assertEqual(hits, [], f\"CLI source names product node IDs: {hits}\")\n140\t\n141\t    def test_build_curriculum_factory_graph_is_the_only_graph_builder_referenced(self):\n142\t        self.assertIn(\"build_curriculum_factory_graph\", CLI_SOURCE)\n143\t        self.assertNotIn(\"register_workbook_topology\", CLI_SOURCE)\n144\t        self.assertNotIn(\"register_skeleton\", CLI_SOURCE)\n145\t        self.assertNotIn(\".compile(\", CLI_SOURCE)\n146\t\n147\t    def test_graph_builder_is_called_at_most_once_per_execution_path(self):\n148\t        \"\"\"Each of the two live-mode branches (fresh, resume) calls it exactly\n149\t        once; the source has exactly two call sites, one per branch.\"\"\"\n150\t        calls = re.findall(r\"build_curriculum_factory_graph\\(\", CLI_SOURCE)\n151\t        self.assertEqual(len(calls), 2)\n152\t\n153\t\n154\t# ===========================================================================\n155\t# TEST 2 — help surface\n156\t# ===========================================================================\n157\t\n158\t\n159\tclass HelpSurfaceTests(unittest.TestCase):\n160\t    def setUp(self):\n161\t        self.help_text = R.build_parser().format_help()\n162\t\n163\t    def test_spec_section_16_flags_are_present(self):\n164\t        for flag in (\"--engine-root\", \"--curriculum\", \"--output-root\", \"--preflight\",\n165\t                     \"--unit\", \"--all\", \"--resume\", \"--authorization\"):\n166\t            self.assertIn(flag, self.help_text)\n167\t\n168\t    def test_no_legacy_simulation_or_session_bridge_or_custom_controller_flags(self):\n169\t        legacy_flags = (\n170\t            \"--lab-id\", \"--model\", \"--test-static\", \"--test-simulated-all\",\n171\t            \"--test-live-capabilities\", \"--test-golden-l01\", \"--interrupt-after\",\n172\t            \"--max-lab-seconds\", \"--phase-timeout-seconds\", \"--max-run-seconds\",\n173\t        )\n174\t        for flag in legacy_flags:\n175\t            self.assertNotIn(flag, self.help_text)\n176\t\n177\t\n178\t# ===========================================================================\n179\t# TEST 3 — argument shape, canonical paths, exit codes\n180\t# ===========================================================================\n181\t\n182\t\n183\tclass ArgumentValidationTests(unittest.TestCase):\n184\t    def test_mode_flags_are_mutually_exclusive(self):\n185\t        parser = R.build_parser()\n186\t        with self.assertRaises(SystemExit):\n187\t            parser.parse_args([\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\",\n188\t                                \"--unit\", \"L01\", \"--all\"])\n189\t\n190\t    def test_at_least_one_mode_flag_is_required(self):\n191\t        parser = R.build_parser()\n192\t        with self.assertRaises(SystemExit):\n193\t            parser.parse_args([\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\"])\n194\t\n195\t    def test_authorization_required_for_unit_all_resume(self):\n196\t        parser = R.build_parser()\n197\t        for mode_args in ([\"--unit\", \"L01\"], [\"--all\"], [\"--resume\"]):\n198\t            args = parser.parse_args(\n199\t                [\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\", *mode_args]\n200\t            )\n201\t            with self.assertRaises(R.CliArgumentError):\n202\t                R._validate_args(args)\n203\t\n204\t    def test_preflight_rejects_authorization(self):\n205\t        parser = R.build_parser()\n206\t        args = parser.parse_args(\n207\t            [\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\",\n208\t             \"--preflight\", \"--authorization\", \"auth.json\"]\n209\t        )\n210\t        with self.assertRaises(R.CliArgumentError):\n211\t            R._validate_args(args)\n212\t\n213\t    def test_curriculum_root_resolves_manifest_file_to_parent_directory(self, tmp_path=None):\n214\t        import tempfile\n215\t        with tempfile.TemporaryDirectory() as raw:\n216\t            root = Path(raw)\n217\t            manifest = root / \"curricula\" / \"arduino_kit\" / \"arduino_kit_curriculum.v5.yaml\"\n218\t            manifest.parent.mkdir(parents=True)\n219\t            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n220\t            self.assertEqual(R._resolve_curriculum_root(str(manifest)), manifest.parent.resolve())\n221\t            self.assertEqual(R._resolve_curriculum_root(str(manifest.parent)), manifest.parent.resolve())\n222\t\n223\t    def test_curriculum_root_missing_path_is_an_argument_error(self):\n224\t        with self.assertRaises(R.CliArgumentError):\n225\t            R._resolve_curriculum_root(\"/definitely/does/not/exist/for/plan26\")\n226\t\n227\t    def test_authorization_file_must_be_a_json_object_with_required_fields(self):\n228\t        import tempfile\n229\t        with tempfile.TemporaryDirectory() as raw:\n230\t            root = Path(raw)\n231\t            not_json = root / \"bad.json\"\n232\t            not_json.write_text(\"not json\", encoding=\"utf-8\")\n233\t            with self.assertRaises(R.CliArgumentError):\n234\t                R._read_authorization(str(not_json))\n235\t\n236\t            not_object = root / \"list.json\"\n237\t            not_object.write_text(\"[]\", encoding=\"utf-8\")\n238\t            with self.assertRaises(R.CliArgumentError):\n239\t                R._read_authorization(str(not_object))\n240\t\n241\t            incomplete = root / \"incomplete.json\"\n242\t            incomplete.write_text(json.dumps({\"providers\": {}}), encoding=\"utf-8\")\n243\t            with self.assertRaises(R.CliArgumentError):\n244\t                R._read_authorization(str(incomplete))\n245\t\n246\t            missing = root / \"missing.json\"\n247\t            with self.assertRaises(R.CliArgumentError):\n248\t                R._read_authorization(str(missing))\n249\t\n250\t    def test_collision_reason_for_fresh_output_root(self):\n251\t        import tempfile\n252\t        with tempfile.TemporaryDirectory() as raw:\n253\t            root = Path(raw)\n254\t            nonexistent = root / \"does-not-exist-yet\"\n255\t            self.assertIsNone(R._collision_reason(nonexistent))\n256\t\n257\t            empty = root / \"empty\"\n258\t            empty.mkdir()\n259\t            self.assertIsNone(R._collision_reason(empty))\n260\t\n261\t            dirty = root / \"dirty\"\n262\t            dirty.mkdir()\n263\t            (dirty / \"leftover.txt\").write_text(\"x\", encoding=\"utf-8\")\n264\t            self.assertIsNotNone(R._collision_reason(dirty))\n265\t\n266\t    def test_argparse_level_errors_exit_with_code_2(self):\n267\t        # argparse's own validation (no mode flag at all) raises SystemExit(2)\n268\t        # before main()'s try block is reached; that native argparse contract\n269\t        # is exit 2, matching spec section 14's \"CLI argument errors ... exit 2\".\n270\t        out, err = io.StringIO(), io.StringIO()\n271\t        with redirect_stdout(out), redirect_stderr(err):\n272\t            with self.assertRaises(SystemExit) as raised:\n273\t                R.main([\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT), \"--output-root\", \"/x\"])\n274\t        self.assertEqual(raised.exception.code, 2)\n275\t\n276\t    def test_missing_authorization_exits_2_with_diagnostics_and_no_terminal(self):\n277\t        import tempfile\n278\t        with tempfile.TemporaryDirectory() as raw:\n279\t            root = Path(raw)\n280\t            code, payload, err = _run_main(\n281\t                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n282\t                 \"--output-root\", str(root / \"out\"), \"--unit\", \"L01\"]\n283\t            )\n284\t        self.assertEqual(code, R.ARGUMENT_ERROR_EXIT)\n285\t        self.assertNotIn(\"terminal\", payload)\n286\t        self.assertIn(\"error_code\", payload)\n287\t        self.assertTrue(err.strip())\n288\t\n289\t\n290\t# ===========================================================================\n291\t# TEST 4 — preflight is read-only\n292\t# ===========================================================================\n293\t\n294\t\n295\tclass PreflightTests(unittest.TestCase):\n296\t    def test_preflight_never_creates_or_writes_the_output_root(self):\n297\t        import tempfile\n298\t        with tempfile.TemporaryDirectory() as raw:\n299\t            output_root = Path(raw) / \"preflight-target\"\n300\t            code, payload, _err = _run_main(\n301\t                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n302\t                 \"--output-root\", str(output_root), \"--preflight\"]\n303\t            )\n304\t            self.assertFalse(output_root.exists(), \"preflight must not populate its output path\")\n305\t            self.assertEqual(payload[\"kind\"], \"PREFLIGHT\")\n306\t            self.assertIn(code, (0, R.NOT_READY_EXIT))\n307\t            self.assertEqual(code == 0, payload[\"ready\"])\n308\t            self.assertNotIn(\"terminal\", payload)\n309\t            self.assertIsInstance(payload[\"missing_capabilities\"], list)\n310\t\n311\t    def test_preflight_cannot_emit_product_success(self):\n312\t        import tempfile\n313\t        with tempfile.TemporaryDirectory() as raw:\n314\t            output_root = Path(raw) / \"preflight-target\"\n315\t            _code, payload, _err = _run_main(\n316\t                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n317\t                 \"--output-root\", str(output_root), \"--preflight\"]\n318\t            )\n319\t        self.assertNotIn(payload.get(\"kind\"), (\"UNIT_ACCEPTED\", \"COMPLETE\"))\n320\t        self.assertNotIn(\"accepted_receipt\", payload)\n321\t        self.assertNotIn(\"release_receipt\", payload)\n322\t\n323\t    def test_preflight_reports_a_collision_without_touching_an_existing_root(self):\n324\t        import tempfile\n325\t        with tempfile.TemporaryDirectory() as raw:\n326\t            output_root = Path(raw) / \"dirty\"\n327\t            output_root.mkdir()\n328\t            (output_root / \"stray.txt\").write_text(\"keep-me\", encoding=\"utf-8\")\n329\t            code, payload, _err = _run_main(\n330\t                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n331\t                 \"--output-root\", str(output_root), \"--preflight\"]\n332\t            )\n333\t            self.assertEqual(code, R.NOT_READY_EXIT)\n334\t            self.assertFalse(payload[\"ready\"])\n335\t            self.assertIsNotNone(payload[\"collision\"])\n336\t            self.assertEqual((output_root / \"stray.txt\").read_text(encoding=\"utf-8\"), \"keep-me\")\n337\t            self.assertEqual(sorted(p.name for p in output_root.iterdir()), [\"stray.txt\"])\n338\t\n339\t\n340\t# ===========================================================================\n341\t# TEST 6 — capability/authorization failures never simulate\n342\t# ===========================================================================\n343\t\n344\t\n345\tclass CapabilityAndAuthorizationFailureTests(unittest.TestCase):\n346\t    def test_capability_proof_failure_happens_before_any_transmission_and_never_simulates(self):\n347\t        import tempfile\n348\t        invoke_calls = []\n349\t\n350\t        class _StubCompiled:\n351\t            def invoke(self, *args, **kwargs):\n352\t                invoke_calls.append((args, kwargs))\n353\t                raise AssertionError(\"compiled graph must not be invoked once capability proof fails\")\n354\t\n355\t        with tempfile.TemporaryDirectory() as raw:\n356\t            output_root = Path(raw) / \"out\"\n357\t            authorization = _authorization_file(Path(raw))\n358\t            with mock.patch.object(R, \"build_curriculum_factory_graph\", return_value=_StubCompiled()), \\\n359\t                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n360\t                                    side_effect=tp.CapabilityProofFailed(\"no codex on PATH\")):\n361\t                code, payload, err = _run_main(\n362\t                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n363\t                     \"--output-root\", str(output_root), \"--unit\", \"L01\",\n364\t                     \"--authorization\", str(authorization)]\n365\t                )\n366\t\n367\t        self.assertEqual(invoke_calls, [])\n368\t        self.assertEqual(code, R.SYSTEM_FAILURE_EXIT)\n369\t        self.assertEqual(payload[\"terminal\"][\"kind\"], \"SYSTEM_FAILURE\")\n370\t        self.assertNotIn(payload[\"terminal\"].get(\"kind\"), (\"UNIT_ACCEPTED\", \"COMPLETE\"))\n371\t        self.assertTrue(err.strip())\n372\t\n373\t    def test_missing_authorization_file_fails_before_any_lock_or_graph_build(self):\n374\t        import tempfile\n375\t        with tempfile.TemporaryDirectory() as raw:\n376\t            output_root = Path(raw) / \"out\"\n377\t            with mock.patch.object(R, \"build_curriculum_factory_graph\") as builder:\n378\t                code, payload, _err = _run_main(\n379\t                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n380\t                     \"--output-root\", str(output_root), \"--unit\", \"L01\",\n381\t                     \"--authorization\", str(Path(raw) / \"does-not-exist.json\")]\n382\t                )\n383\t            builder.assert_not_called()\n384\t        self.assertEqual(code, R.ARGUMENT_ERROR_EXIT)\n385\t        self.assertFalse(output_root.exists())\n386\t        self.assertNotIn(\"terminal\", payload)\n387\t\n388\t\n389\t# ===========================================================================\n390\t# TEST 7 — Plan 25 roots are readable history, refused for resume\n391\t# ===========================================================================\n392\t\n393\t\n394\tclass Plan25ResumeRefusalTests(unittest.TestCase):\n395\t    def test_a_plan25_shaped_root_is_refused_and_left_byte_identical(self):\n396\t        import tempfile\n397\t        with tempfile.TemporaryDirectory() as raw:\n398\t            output_root = Path(raw) / \"legacy\"\n399\t            output_root.mkdir()\n400\t            # Shaped like the legacy `controller.simulate()` output layout, not\n401\t            # the Plan 26 `.langgraph/` contract: no identity envelope at all.\n402\t            (output_root / \"checkpoints\").mkdir()\n403\t            legacy_checkpoint = output_root / \"checkpoints\" / \"0001.json\"\n404\t            legacy_checkpoint.write_text(json.dumps({\"terminal_state\": \"ACCEPTED\"}), encoding=\"utf-8\")\n405\t            before = {\n406\t                p.relative_to(output_root).as_posix(): p.read_bytes()\n407\t                for p in sorted(output_root.rglob(\"*\")) if p.is_file()\n408\t            }\n409\t\n410\t            with mock.patch.object(R, \"build_curriculum_factory_graph\") as builder:\n411\t                code, payload, err = _run_main(\n412\t                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n413\t                     \"--output-root\", str(output_root), \"--resume\",\n414\t                     \"--authorization\", str(_authorization_file(Path(raw)))]\n415\t                )\n416\t            builder.assert_not_called()\n417\t\n418\t            after = {\n419\t                p.relative_to(output_root).as_posix(): p.read_bytes()\n420\t                for p in sorted(output_root.rglob(\"*\")) if p.is_file()\n421\t            }\n422\t\n423\t        self.assertEqual(code, R.NOT_READY_EXIT)\n424\t        self.assertNotIn(\"terminal\", payload)\n425\t        self.assertTrue(err.strip())\n426\t        self.assertEqual(before, after, \"a refused resume must not mutate the Plan 25 root at all\")\n427\t        self.assertFalse((output_root / P.LANGGRAPH_DIRNAME).exists())\n428\t\n429\t\n430\t# ===========================================================================\n431\t# Output projection / exit-code mapping (pure functions)\n432\t# ===========================================================================\n433\t\n434\t\n435\tclass OutputProjectionTests(unittest.TestCase):\n436\t    def test_unit_accepted_projects_accepted_receipt(self):\n437\t        output = {\n438\t            \"contract_version\": \"1\", \"run_id\": \"r1\", \"episode_id\": \"e1\",\n439\t            \"mode\": \"one\", \"requested_unit_id\": \"U001\", \"output_root\": \"/out\",\n440\t            \"terminal\": {\"kind\": \"UNIT_ACCEPTED\"},\n441\t            \"accepted_unit_receipts\": {\"U001\": {\"receipt_hash\": \"abc\"}},\n442\t            \"checkpoint_metadata\": [{\"checkpoint_id\": \"c1\"}, {\"checkpoint_id\": \"c2\"}],\n443\t            \"evidence_index_entries\": [{\"a\": 1}],\n444\t        }\n445\t        payload = R._project_result(output)\n446\t        self.assertEqual(payload[\"accepted_receipt\"], {\"receipt_hash\": \"abc\"})\n447\t        self.assertNotIn(\"release_receipt\", payload)\n448\t        self.assertEqual(payload[\"checkpoint_id\"], \"c2\")\n449\t        self.assertEqual(R._exit_code_for(payload), 0)\n450\t\n451\t    def test_complete_projects_release_receipt(self):\n452\t        output = {\n453\t            \"terminal\": {\"kind\": \"COMPLETE\"}, \"mode\": \"all\",\n454\t            \"final_release_audits\": [{\"result\": \"PASS\", \"key\": \"k1\"}],\n455\t            \"checkpoint_metadata\": [], \"evidence_index_entries\": [],\n456\t        }\n457\t        payload = R._project_result(output)\n458\t        self.assertEqual(payload[\"release_receipt\"], {\"result\": \"PASS\", \"key\": \"k1\"})\n459\t        self.assertNotIn(\"accepted_receipt\", payload)\n460\t        self.assertEqual(R._exit_code_for(payload), 0)\n461\t\n462\t    def test_every_terminal_kind_maps_to_its_spec_exit_code(self):\n463\t        expected = {\n464\t            \"UNIT_ACCEPTED\": 0, \"COMPLETE\": 0, \"INTERRUPTED\": 10,\n465\t            \"PAUSED_PREREQUISITE\": 11, \"CONVERGENCE_EXHAUSTED\": 12, \"SYSTEM_FAILURE\": 20,\n466\t        }\n467\t        for kind, exit_code in expected.items():\n468\t            payload = R._project_result({\"terminal\": {\"kind\": kind}, \"checkpoint_metadata\": [], \"evidence_index_entries\": []})\n469\t            self.assertEqual(R._exit_code_for(payload), exit_code, kind)\n470\t\n471\t    def test_evidence_index_hash_is_a_digest_over_the_entries(self):\n472\t        from runtime.langgraph_factory.artifacts import canonical_digest\n473\t        entries = [{\"key\": \"a\"}, {\"key\": \"b\"}]\n474\t        output = {\"terminal\": {\"kind\": \"INTERRUPTED\"}, \"evidence_index_entries\": entries, \"checkpoint_metadata\": []}\n475\t        payload = R._project_result(output)\n476\t        self.assertEqual(payload[\"evidence_index_hash\"], canonical_digest(entries))\n477\t\n478\t\n479\t# ===========================================================================\n480\t# Fresh-run wiring (mocked graph + capability proof, real persistence layer)\n481\t# ===========================================================================\n482\t\n483\t\n484\tclass FreshRunWiringTests(unittest.TestCase):\n485\t    def test_fresh_unit_run_builds_the_graph_once_and_invokes_with_a_fresh_envelope(self):\n486\t        import tempfile\n487\t\n488\t        recorded: dict = {}\n489\t\n490\t        class _StubCompiled:\n491\t            def invoke(self, graph_input, *, config, context):\n492\t                recorded[\"graph_input\"] = graph_input\n493\t                recorded[\"config\"] = config\n494\t                recorded[\"context\"] = context\n495\t                return {\n496\t                    \"contract_version\": graph_input[\"invocation\"][\"contract_version\"],\n497\t                    \"run_id\": \"state-run-id\",\n498\t                    \"episode_id\": \"episode-1\",\n499\t                    \"mode\": graph_input[\"invocation\"][\"mode\"],\n500\t                    \"requested_unit_id\": graph_input[\"invocation\"][\"requested_unit_id\"],\n501\t                    \"output_root\": graph_input[\"invocation\"][\"output_root\"],\n502\t                    \"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"},\n503\t                    \"checkpoint_metadata\": [],\n504\t                    \"evidence_index_entries\": [],\n505\t                }\n506\t\n507\t        builder_calls = []\n508\t\n509\t        def _fake_builder(*, engine_root, output_root):\n510\t            builder_calls.append((engine_root, output_root))\n511\t            return _StubCompiled()\n512\t\n513\t        with tempfile.TemporaryDirectory() as raw:\n514\t            root = Path(raw)\n515\t            curriculum = root / \"curricula\" / \"arduino_kit\"\n516\t            manifest = curriculum / \"arduino_kit_curriculum.v5.yaml\"\n517\t            manifest.parent.mkdir(parents=True)\n518\t            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n519\t            output_root = root / \"out\"\n520\t            authorization = _authorization_file(root, providers={\"openai\": [\"manifest_unit_projection\"]})\n521\t\n522\t            with mock.patch.object(R, \"build_curriculum_factory_graph\", side_effect=_fake_builder), \\\n523\t                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n524\t                                    return_value={\"satisfied\": True, \"unsatisfied_required_facets\": []}):\n525\t                code, payload, _err = _run_main(\n526\t                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(manifest),\n527\t                     \"--output-root\", str(output_root), \"--unit\", \"L01\",\n528\t                     \"--authorization\", str(authorization)]\n529\t                )\n530\t\n531\t        self.assertEqual(len(builder_calls), 1, \"the graph must be built exactly once\")\n532\t        self.assertEqual(code, 10)\n533\t        self.assertEqual(payload[\"terminal\"][\"kind\"], \"INTERRUPTED\")\n534\t\n535\t        envelope = recorded[\"graph_input\"][\"invocation\"]\n536\t        self.assertEqual(envelope[\"kind\"], \"fresh\")\n537\t        self.assertEqual(envelope[\"mode\"], \"one\")\n538\t        self.assertEqual(envelope[\"requested_unit_id\"], \"L01\")\n539\t        self.assertEqual(envelope[\"engine_root\"], str(REPO_ROOT))\n540\t        self.assertEqual(envelope[\"curriculum_root\"], str(manifest.parent.resolve()))\n541\t        self.assertEqual(envelope[\"output_root\"], str(output_root.resolve()))\n542\t        self.assertIsNone(envelope[\"prior_identity\"])\n543\t        self.assertIsNone(envelope[\"prior_terminal\"])\n544\t        self.assertFalse(envelope[\"lease_open\"])\n545\t        self.assertEqual(len(envelope[\"authorization\"][\"curriculum_digest\"]), 64)\n546\t        self.assertEqual(envelope[\"authorization\"][\"output_root\"], str(output_root.resolve()))\n547\t\n548\t        context = recorded[\"context\"]\n549\t        self.assertEqual(context.transport_registry.authorization.providers.get(\"openai\"), (\"manifest_unit_projection\",))\n550\t        self.assertIsNotNone(context.transport_registry.capability_proof)\n551\t        self.assertFalse(context.transport_registry.guard.installed, \"the guard must be uninstalled again after invoke\")\n552\t\n553\t        # The lock is released: a second invocation against the same root\n554\t        # (still empty of a committed run, since the stub never wrote one) does\n555\t        # not hit ExecutionLockUnavailable.\n556\t        lock = P.ExecutionLock(output_root)\n557\t        lock.acquire()\n558\t        lock.release()\n559\t\n560\t    def test_all_mode_run_requests_no_unit_id(self):\n561\t        import tempfile\n562\t\n563\t        recorded = {}\n564\t\n565\t        class _StubCompiled:\n566\t            def invoke(self, graph_input, *, config, context):\n567\t                recorded[\"envelope\"] = graph_input[\"invocation\"]\n568\t                return {\n569\t                    \"terminal\": {\"kind\": \"CONVERGENCE_EXHAUSTED\"},\n570\t                    \"mode\": \"all\", \"checkpoint_metadata\": [], \"evidence_index_entries\": [],\n571\t                }\n572\t\n573\t        with tempfile.TemporaryDirectory() as raw:\n574\t            root = Path(raw)\n575\t            curriculum = root / \"curricula\" / \"arduino_kit\"\n576\t            manifest = curriculum / \"arduino_kit_curriculum.v5.yaml\"\n577\t            manifest.parent.mkdir(parents=True)\n578\t            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n579\t            output_root = root / \"out\"\n580\t            authorization = _authorization_file(root)\n581\t\n582\t            with mock.patch.object(R, \"build_curriculum_factory_graph\", return_value=_StubCompiled()), \\\n583\t                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n584\t                                    return_value={\"satisfied\": True, \"unsatisfied_required_facets\": []}):\n585\t                code, payload, _err = _run_main(\n586\t                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(manifest),\n587\t                     \"--output-root\", str(output_root), \"--all\",\n588\t                     \"--authorization\", str(authorization)]\n589\t                )\n590\t\n591\t        self.assertEqual(code, 12)\n592\t        self.assertIsNone(recorded[\"envelope\"][\"requested_unit_id\"])\n593\t        self.assertEqual(recorded[\"envelope\"][\"mode\"], \"all\")\n594\t\n595\t    def test_a_second_fresh_invocation_against_a_populated_root_is_refused(self):\n596\t        import tempfile\n597\t\n598\t        class _StubCompiled:\n599\t            def invoke(self, graph_input, *, config, context):\n600\t                return {\n601\t                    \"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"},\n602\t                    \"checkpoint_metadata\": [], \"evidence_index_entries\": [],\n603\t                }\n604\t\n605\t        with tempfile.TemporaryDirectory() as raw:\n606\t            root = Path(raw)\n607\t            curriculum = root / \"curricula\" / \"arduino_kit\"\n608\t            manifest = curriculum / \"arduino_kit_curriculum.v5.yaml\"\n609\t            manifest.parent.mkdir(parents=True)\n610\t            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n611\t            output_root = root / \"out\"\n612\t            authorization = _authorization_file(root)\n613\t            argv = [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(manifest),\n614\t                    \"--output-root\", str(output_root), \"--unit\", \"L01\",\n615\t                    \"--authorization\", str(authorization)]\n616\t\n617\t            with mock.patch.object(R, \"build_curriculum_factory_graph\", return_value=_StubCompiled()), \\\n618\t                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n619\t                                    return_value={\"satisfied\": True, \"unsatisfied_required_facets\": []}):\n620\t                first_code, _payload, _err = _run_main(argv)\n621\t                self.assertEqual(first_code, 10)\n622\t                second_code, second_payload, _err2 = _run_main(argv)\n623\t\n624\t        self.assertEqual(second_code, R.NOT_READY_EXIT)\n625\t        self.assertNotIn(\"terminal\", second_payload)\n626\t\n627\t\n628\t# ===========================================================================\n629\t# Resume envelope/seeding wiring (mocked persistence primitives)\n630\t# ===========================================================================\n631\t\n632\t\n633\tclass ResumeSeedingTests(unittest.TestCase):\n634\t    def test_resume_envelope_derives_mode_and_target_from_the_frozen_identity(self):\n635\t        identity = {\n636\t            \"contract_version\": \"1\", \"engine_root\": \"/engine\", \"curriculum_root\": \"/curriculum\",\n637\t            \"active_manifest_path\": \"/curriculum/manifest.yaml\", \"output_root\": \"/out\",\n638\t            \"mode\": \"one\", \"requested_unit_id\": \"L07\", \"run_id\": \"run-xyz\",\n639\t        }\n640\t        invocation = SimpleNamespace(\n641\t            bootstrap_kind=P.BOOTSTRAP_RESUME,\n642\t            run_id=\"run-xyz\",\n643\t            episode_id=\"run-xyz:episode:000002\",\n644\t            episode_ordinal=2,\n645\t            thread_id=\"run-xyz:episode:000002\",\n646\t            identity_envelope=identity,\n647\t            prior_thread_id=\"run-xyz:episode:000001\",\n648\t            resume_from={\"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"}},\n649\t        )\n650\t        prior_values = {\n651\t            \"frozen_digest\": \"deadbeef\" * 8,\n652\t            \"accepted_unit_receipts\": {},\n653\t            \"terminal\": {\"kind\": \"INTERRUPTED\"},\n654\t            \"bootstrap_kind\": \"fresh\",\n655\t            \"invocation\": {\"kind\": \"fresh\"},\n656\t            \"episode_id\": \"run-xyz:episode:000001\",\n657\t        }\n658\t\n659\t        with mock.patch.object(P, \"open_checkpoint_saver\", return_value=(object(), mock.Mock(close=lambda: None))), \\\n660\t             mock.patch.object(P, \"ReadOnlyCheckpointView\", return_value=object()), \\\n661\t             mock.patch.object(P, \"prepare_episode_invocation\", return_value=invocation), \\\n662\t             mock.patch.object(P, \"extract_prior_episode\", return_value=SimpleNamespace(values=prior_values)):\n663\t            got_invocation, envelope, frozen_digest, seed_values = R._prepare_resume(\n664\t                output_root=Path(\"/out\"), lock=mock.Mock(), compiled=object()\n665\t            )\n666\t\n667\t        self.assertIs(got_invocation, invocation)\n668\t        self.assertEqual(envelope[\"kind\"], \"resume\")\n669\t        self.assertEqual(envelope[\"mode\"], \"one\")\n670\t        self.assertEqual(envelope[\"requested_unit_id\"], \"L07\")\n671\t        self.assertEqual(envelope[\"engine_root\"], \"/engine\")\n672\t        self.assertEqual(envelope[\"prior_identity\"], identity)\n673\t        self.assertEqual(envelope[\"prior_terminal\"], {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"})\n674\t        self.assertFalse(envelope[\"lease_open\"])\n675\t        self.assertEqual(frozen_digest, \"deadbeef\" * 8)\n676\t\n677\t        # Episode-scoped fields are never carried forward from the prior episode.\n678\t        for excluded in (\"terminal\", \"bootstrap_kind\", \"invocation\", \"episode_id\"):\n679\t            self.assertNotIn(excluded, seed_values)\n680\t        self.assertEqual(seed_values[\"frozen_digest\"], \"deadbeef\" * 8)\n681\t        self.assertEqual(seed_values[\"accepted_unit_receipts\"], {})\n682\t\n683\t    def test_recover_orphan_envelope_carries_no_prior_terminal_and_marks_lease_open(self):\n684\t        identity = {\n685\t            \"contract_version\": \"1\", \"engine_root\": \"/engine\", \"curriculum_root\": \"/curriculum\",\n686\t            \"active_manifest_path\": \"/curriculum/manifest.yaml\", \"output_root\": \"/out\",\n687\t            \"mode\": \"all\", \"requested_unit_id\": None, \"run_id\": \"run-xyz\",\n688\t        }\n689\t        invocation = SimpleNamespace(\n690\t            bootstrap_kind=P.BOOTSTRAP_RECOVER_ORPHAN,\n691\t            run_id=\"run-xyz\",\n692\t            episode_id=\"run-xyz:recover:1\",\n693\t            episode_ordinal=2,\n694\t            thread_id=\"run-xyz:recover:1\",\n695\t            identity_envelope=identity,\n696\t            prior_thread_id=\"run-xyz:episode:000001\",\n697\t            resume_from=None,\n698\t        )\n699\t        with mock.patch.object(P, \"open_checkpoint_saver\", return_value=(object(), mock.Mock(close=lambda: None))), \\\n700\t             mock.patch.object(P, \"ReadOnlyCheckpointView\", return_value=object()), \\\n701\t             mock.patch.object(P, \"prepare_episode_invocation\", return_value=invocation), \\\n702\t             mock.patch.object(P, \"extract_prior_episode\", return_value=SimpleNamespace(values={})):\n703\t            _invocation, envelope, _frozen_digest, _seed = R._prepare_resume(\n704\t                output_root=Path(\"/out\"), lock=mock.Mock(), compiled=object()\n705\t            )\n706\t\n707\t        self.assertEqual(envelope[\"kind\"], \"recover_orphan\")\n708\t        self.assertIsNone(envelope[\"prior_terminal\"])\n709\t        self.assertTrue(envelope[\"lease_open\"])\n710\t\n711\t\n712\t# ===========================================================================\n713\t# Evidence artifacts (spec-facing proof, written under results/evidence/)\n714\t# ===========================================================================\n715\t\n716\tEVIDENCE_DIR = REPO_ROOT / \"plans\" / \"26_langgraph_curriculum_factory\" / \"results\" / \"evidence\" / \"N40_CLI_CUTOVER\"\n717\t\n718\t\n719\tclass EvidenceArtifactTests(unittest.TestCase):\n720\t    \"\"\"Regenerates the node's own result-doc evidence as a side effect of a real\n721\t    assertion, so the evidence can never drift from what actually passed.\"\"\"\n722\t\n723\t    def test_cli_help_evidence_matches_spec_section_16_surface(self):\n724\t        help_text = R.build_parser().format_help()\n725\t        for flag in (\"--engine-root\", \"--curriculum\", \"--output-root\", \"--preflight\",\n726\t                     \"--unit\", \"--all\", \"--resume\", \"--authorization\"):\n727\t            self.assertIn(flag, help_text)\n728\t        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n729\t        (EVIDENCE_DIR / \"cli_help.txt\").write_text(help_text, encoding=\"utf-8\")\n730\t\n731\t    def test_static_import_audit_evidence(self):\n732\t        imports = sorted(\n733\t            f\"{module or '<bare>'} :: {name or '<module>'}\"\n734\t            for module, name in ImportGraphAuditTests()._imported_names()\n735\t        )\n736\t        report = (\n737\t            \"Every import statement in runtime/run_curriculum.py (module :: name).\\n\"\n738\t            \"TEST 1/5/8 assert no Plan 25, node-body, routing, or provider-SDK\\n\"\n739\t            \"import appears in this list.\\n\\n\" + \"\\n\".join(imports) + \"\\n\"\n740\t        )\n741\t        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n742\t        (EVIDENCE_DIR / \"import_audit.txt\").write_text(report, encoding=\"utf-8\")\n743\t        self.assertTrue(imports)\n744\t\n745\t    def test_plan25_root_refusal_evidence(self):\n746\t        import tempfile\n747\t\n748\t        with tempfile.TemporaryDirectory() as raw:\n749\t            output_root = Path(raw) / \"legacy\"\n750\t            output_root.mkdir()\n751\t            (output_root / \"checkpoints\").mkdir()\n752\t            (output_root / \"checkpoints\" / \"0001.json\").write_text(\n753\t                json.dumps({\"terminal_state\": \"ACCEPTED\"}), encoding=\"utf-8\"\n754\t            )\n755\t            before = sorted(p.relative_to(output_root).as_posix() for p in output_root.rglob(\"*\"))\n756\t\n757\t            with mock.patch.object(R, \"build_curriculum_factory_graph\") as builder:\n758\t                code, payload, err = _run_main(\n759\t                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n760\t                     \"--output-root\", str(output_root), \"--resume\",\n761\t                     \"--authorization\", str(_authorization_file(Path(raw)))]\n762\t                )\n763\t            builder.assert_not_called()\n764\t            after = sorted(p.relative_to(output_root).as_posix() for p in output_root.rglob(\"*\"))\n765\t\n766\t        report = (\n767\t            \"TEST 7: a Plan 25-shaped output root (checkpoints/0001.json, no\\n\"\n768\t            \".langgraph/) passed to --resume.\\n\\n\"\n769\t            f\"exit_code: {code}\\n\"\n770\t            f\"stdout: {json.dumps(payload)}\\n\"\n771\t            f\"stderr: {err.strip()}\\n\"\n772\t            f\"files_before: {before}\\n\"\n773\t            f\"files_after:  {after}\\n\"\n774\t            f\"root_untouched: {before == after}\\n\"\n775\t        )\n776\t        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n777\t        (EVIDENCE_DIR / \"plan25_resume_refusal.txt\").write_text(report, encoding=\"utf-8\")\n778\t        self.assertEqual(before, after)\n779\t        self.assertEqual(code, R.NOT_READY_EXIT)\n780\t\n781\t    def test_preflight_read_only_evidence(self):\n782\t        import tempfile\n783\t\n784\t        with tempfile.TemporaryDirectory() as raw:\n785\t            output_root = Path(raw) / \"preflight-target\"\n786\t            code, payload, err = _run_main(\n787\t                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n788\t                 \"--output-root\", str(output_root), \"--preflight\"]\n789\t            )\n790\t            output_root_exists_after = output_root.exists()\n791\t\n792\t        report = (\n793\t            \"TEST 4: --preflight against an output root that does not yet exist.\\n\\n\"\n794\t            f\"exit_code: {code}\\n\"\n795\t            f\"stdout: {json.dumps(payload)}\\n\"\n796\t            f\"stderr: {err.strip()}\\n\"\n797\t            f\"output_root_created: {output_root_exists_after}\\n\"\n798\t        )\n799\t        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n800\t        (EVIDENCE_DIR / \"preflight_read_only.txt\").write_text(report, encoding=\"utf-8\")\n801\t        self.assertFalse(output_root_exists_after)\n802\t        self.assertNotIn(\"terminal\", payload)\n803\t\n804\t\n805\tif __name__ == \"__main__\":\n806\t    unittest.main()\n807\t"}]},"parent_tool_use_id":null,"session_id":"50bcfa3d-b3df-45db-ab55-346f882745b2","uuid":"ef4ed23b-5e53-4ebf-a21b-056a7205caaf","timestamp":"2026-08-12T18:05:36.370Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N40_CLI_CUTOVER/attempt-20260812T180522.724742Z-82022fe842/repo/tests/runtime/test_plan26_cli.py","content":"\"\"\"N40 CLI cutover proof: `runtime.run_curriculum` as the sole production entry.\n\nCovers the node's own TEST checklist:\n\n1. static + runtime call-graph proof of one production graph builder/path\n2. CLI help exposes no legacy simulation/session-bridge/custom-controller path\n3. mode mutual exclusion, arguments, canonical paths, collision/resume rules,\n   stdout JSON, stderr diagnostics, and exit codes\n4. preflight is read-only and cannot emit product success\n5. CLI code contains no product nodes, guards, joins, acceptance, or frontier\n   selection\n6. missing authorization/capability fails before transmission and never\n   simulates\n7. existing Plan 25 roots are readable history but refused for Plan 26 resume\n8. production import audit rejects LangChain wrappers/provider SDKs/direct\n   model HTTP\n\nThe heavy graph/transport machinery (real LangGraph compilation, real model\ntransport, real checkpoint durability) is proven elsewhere (N20/N21/N30/N32's\nown suites); this module proves the CLI *wires* those pieces correctly, using\nthe real persistence layer wherever it is cheap and safe to do so (no model\nsubprocess, no network) and narrow mocks only where a real call would need a\nlive Codex/Gemini installation this environment does not have.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport io\nimport json\nimport re\nimport unittest\nfrom contextlib import redirect_stderr, redirect_stdout\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom unittest import mock\n\nfrom runtime.langgraph_factory import persistence as P\nfrom runtime.langgraph_factory import transport as tp\n\nimport runtime.run_curriculum as R\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nCLI_SOURCE_PATH = REPO_ROOT / \"runtime\" / \"run_curriculum.py\"\nCLI_SOURCE = CLI_SOURCE_PATH.read_text(encoding=\"utf-8\")\nCLI_AST = ast.parse(CLI_SOURCE, filename=str(CLI_SOURCE_PATH))\n\n\ndef _run_main(argv: list[str]) -> tuple[int, dict, str]:\n    out, err = io.StringIO(), io.StringIO()\n    with redirect_stdout(out), redirect_stderr(err):\n        code = R.main(argv)\n    text = out.getvalue()\n    assert text.count(\"\\n\") == 1, f\"expected exactly one JSON line on stdout, got: {text!r}\"\n    return code, json.loads(text), err.getvalue()\n\n\ndef _authorization_file(tmp_path: Path, **overrides) -> Path:\n    payload = {\n        \"approved_at_utc\": \"2026-01-01T00:00:00+00:00\",\n        \"expires_at_utc\": \"2099-01-01T00:00:00+00:00\",\n        \"providers\": {},\n        \"executables\": [],\n    }\n    payload.update(overrides)\n    path = tmp_path / \"authorization.json\"\n    path.write_text(json.dumps(payload), encoding=\"utf-8\")\n    return path\n\n\n# ===========================================================================\n# TEST 1 / 5 / 8 — static source and import-graph audit\n# ===========================================================================\n\n\nclass ImportGraphAuditTests(unittest.TestCase):\n    \"\"\"No node reads this file; it is read once, at collection time.\"\"\"\n\n    def _imported_names(self) -> list[tuple[str, str]]:\n        \"\"\"Every `(module, attribute)` this file imports, `attribute` \"\" for a bare import.\"\"\"\n        found: list[tuple[str, str]] = []\n        for node in ast.walk(CLI_AST):\n            if isinstance(node, ast.ImportFrom):\n                module = node.module or \"\"\n                for alias in node.names:\n                    found.append((module, alias.name))\n            elif isinstance(node, ast.Import):\n                for alias in node.names:\n                    found.append((alias.name, \"\"))\n        return found\n\n    def test_no_plan25_or_legacy_runtime_modules_are_imported(self):\n        forbidden_modules = {\n            \"runtime.controller\",\n            \"runtime.curriculum_factory_graph\",\n            \"runtime.model_worker\",\n            \"runtime.session_bridge\",\n            \"runtime.checks\",\n            \"runtime.checkpoint\",\n            \"runtime.capability_cycle\",\n        }\n        forbidden_names = {\"CurriculumFactoryGraph\", \"CodexWorker\", \"CurriculumRuntime\", \"GeminiReviewer\"}\n        for module, name in self._imported_names():\n            self.assertNotIn(module, forbidden_modules, f\"legacy module imported: {module}\")\n            self.assertNotIn(name, forbidden_names, f\"legacy symbol imported: {name}\")\n\n    def test_only_two_narrow_pure_helpers_are_imported_from_nodes_inputs(self):\n        \"\"\"The one declared exception: identity/freeze helpers, not node bodies.\"\"\"\n        from_nodes = sorted(name for module, name in self._imported_names() if module.endswith(\"nodes.inputs\"))\n        self.assertEqual(from_nodes, [\"REQUIRED_CAPABILITIES\", \"_frozen_input_records\", \"_resolve_active_manifest\"])\n\n    def test_no_import_from_any_other_nodes_or_routing_or_workbook_module(self):\n        forbidden_module_suffixes = (\n            \"nodes.domain\", \"nodes.content\", \"nodes.sources\", \"nodes.render\",\n            \"nodes.review\", \"nodes.visuals\", \"nodes.terminal\", \"nodes\",\n            \"routing\", \"workbook\", \"unit_graph\", \"model_nodes\", \"repair\",\n        )\n        for module, _name in self._imported_names():\n            if module.endswith(\"nodes.inputs\") or module in (\"runtime.langgraph_factory.graph\",):\n                continue\n            for suffix in forbidden_module_suffixes:\n                self.assertFalse(\n                    module == f\"runtime.langgraph_factory.{suffix}\" or module.endswith(f\".{suffix}\"),\n                    f\"unexpected node/topology import: {module}\",\n                )\n\n    def test_no_langchain_provider_sdk_or_direct_http_imports(self):\n        forbidden = (\"langchain\", \"openai\", \"anthropic\", \"google.generativeai\", \"requests\", \"httpx\", \"urllib3\")\n        for module, name in self._imported_names():\n            haystack = f\"{module}.{name}\".lower()\n            for bad in forbidden:\n                self.assertNotIn(bad, haystack, f\"forbidden provider/HTTP import: {module} / {name}\")\n\n    def test_no_product_node_or_guard_identifiers_appear_in_source(self):\n        \"\"\"D00-D98 and M01-M08 are never named: the CLI cannot call, route, or\n        guard against a node it never imports.\"\"\"\n        node_id_pattern = re.compile(r\"\\b(?:D\\d{2}[A-Z0-9_]*|M0[1-8][A-Z0-9_]*)\\b\")\n        hits = sorted(set(node_id_pattern.findall(CLI_SOURCE)))\n        self.assertEqual(hits, [], f\"CLI source names product node IDs: {hits}\")\n\n    def test_build_curriculum_factory_graph_is_the_only_graph_builder_referenced(self):\n        self.assertIn(\"build_curriculum_factory_graph\", CLI_SOURCE)\n        self.assertNotIn(\"register_workbook_topology\", CLI_SOURCE)\n        self.assertNotIn(\"register_skeleton\", CLI_SOURCE)\n        self.assertNotIn(\".compile(\", CLI_SOURCE)\n\n    def test_graph_builder_is_called_at_most_once_per_execution_path(self):\n        \"\"\"Each of the two live-mode branches (fresh, resume) calls it exactly\n        once; the source has exactly two call sites, one per branch.\"\"\"\n        calls = re.findall(r\"build_curriculum_factory_graph\\(\", CLI_SOURCE)\n        self.assertEqual(len(calls), 2)\n\n\n# ===========================================================================\n# TEST 2 — help surface\n# ===========================================================================\n\n\nclass HelpSurfaceTests(unittest.TestCase):\n    def setUp(self):\n        self.help_text = R.build_parser().format_help()\n\n    def test_spec_section_16_flags_are_present(self):\n        for flag in (\"--engine-root\", \"--curriculum\", \"--output-root\", \"--preflight\",\n                     \"--unit\", \"--all\", \"--resume\", \"--authorization\"):\n            self.assertIn(flag, self.help_text)\n\n    def test_no_legacy_simulation_or_session_bridge_or_custom_controller_flags(self):\n        legacy_flags = (\n            \"--lab-id\", \"--model\", \"--test-static\", \"--test-simulated-all\",\n            \"--test-live-capabilities\", \"--test-golden-l01\", \"--interrupt-after\",\n            \"--max-lab-seconds\", \"--phase-timeout-seconds\", \"--max-run-seconds\",\n        )\n        for flag in legacy_flags:\n            self.assertNotIn(flag, self.help_text)\n\n\n# ===========================================================================\n# TEST 3 — argument shape, canonical paths, exit codes\n# ===========================================================================\n\n\nclass ArgumentValidationTests(unittest.TestCase):\n    def test_mode_flags_are_mutually_exclusive(self):\n        parser = R.build_parser()\n        with self.assertRaises(SystemExit):\n            parser.parse_args([\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\",\n                                \"--unit\", \"L01\", \"--all\"])\n\n    def test_at_least_one_mode_flag_is_required(self):\n        parser = R.build_parser()\n        with self.assertRaises(SystemExit):\n            parser.parse_args([\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\"])\n\n    def test_authorization_required_for_unit_all_resume(self):\n        parser = R.build_parser()\n        for mode_args in ([\"--unit\", \"L01\"], [\"--all\"], [\"--resume\"]):\n            args = parser.parse_args(\n                [\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\", *mode_args]\n            )\n            with self.assertRaises(R.CliArgumentError):\n                R._validate_args(args)\n\n    def test_preflight_rejects_authorization(self):\n        parser = R.build_parser()\n        args = parser.parse_args(\n            [\"--engine-root\", \".\", \"--curriculum\", \".\", \"--output-root\", \"/x\",\n             \"--preflight\", \"--authorization\", \"auth.json\"]\n        )\n        with self.assertRaises(R.CliArgumentError):\n            R._validate_args(args)\n\n    def test_curriculum_root_resolves_manifest_file_to_parent_directory(self, tmp_path=None):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            manifest = root / \"curricula\" / \"arduino_kit\" / \"arduino_kit_curriculum.v5.yaml\"\n            manifest.parent.mkdir(parents=True)\n            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n            self.assertEqual(R._resolve_curriculum_root(str(manifest)), manifest.parent.resolve())\n            self.assertEqual(R._resolve_curriculum_root(str(manifest.parent)), manifest.parent.resolve())\n\n    def test_curriculum_root_missing_path_is_an_argument_error(self):\n        with self.assertRaises(R.CliArgumentError):\n            R._resolve_curriculum_root(\"/definitely/does/not/exist/for/plan26\")\n\n    def test_authorization_file_must_be_a_json_object_with_required_fields(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            not_json = root / \"bad.json\"\n            not_json.write_text(\"not json\", encoding=\"utf-8\")\n            with self.assertRaises(R.CliArgumentError):\n                R._read_authorization(str(not_json))\n\n            not_object = root / \"list.json\"\n            not_object.write_text(\"[]\", encoding=\"utf-8\")\n            with self.assertRaises(R.CliArgumentError):\n                R._read_authorization(str(not_object))\n\n            incomplete = root / \"incomplete.json\"\n            incomplete.write_text(json.dumps({\"providers\": {}}), encoding=\"utf-8\")\n            with self.assertRaises(R.CliArgumentError):\n                R._read_authorization(str(incomplete))\n\n            missing = root / \"missing.json\"\n            with self.assertRaises(R.CliArgumentError):\n                R._read_authorization(str(missing))\n\n    def test_collision_reason_for_fresh_output_root(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            nonexistent = root / \"does-not-exist-yet\"\n            self.assertIsNone(R._collision_reason(nonexistent))\n\n            empty = root / \"empty\"\n            empty.mkdir()\n            self.assertIsNone(R._collision_reason(empty))\n\n            dirty = root / \"dirty\"\n            dirty.mkdir()\n            (dirty / \"leftover.txt\").write_text(\"x\", encoding=\"utf-8\")\n            self.assertIsNotNone(R._collision_reason(dirty))\n\n    def test_argparse_level_errors_exit_with_code_2(self):\n        # argparse's own validation (no mode flag at all) raises SystemExit(2)\n        # before main()'s try block is reached; that native argparse contract\n        # is exit 2, matching spec section 14's \"CLI argument errors ... exit 2\".\n        out, err = io.StringIO(), io.StringIO()\n        with redirect_stdout(out), redirect_stderr(err):\n            with self.assertRaises(SystemExit) as raised:\n                R.main([\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT), \"--output-root\", \"/x\"])\n        self.assertEqual(raised.exception.code, 2)\n\n    def test_missing_authorization_exits_2_with_diagnostics_and_no_terminal(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            code, payload, err = _run_main(\n                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                 \"--output-root\", str(root / \"out\"), \"--unit\", \"L01\"]\n            )\n        self.assertEqual(code, R.ARGUMENT_ERROR_EXIT)\n        self.assertNotIn(\"terminal\", payload)\n        self.assertIn(\"error_code\", payload)\n        self.assertTrue(err.strip())\n\n\n# ===========================================================================\n# TEST 4 — preflight is read-only\n# ===========================================================================\n\n\nclass PreflightTests(unittest.TestCase):\n    def test_preflight_never_creates_or_writes_the_output_root(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"preflight-target\"\n            code, payload, _err = _run_main(\n                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                 \"--output-root\", str(output_root), \"--preflight\"]\n            )\n            self.assertFalse(output_root.exists(), \"preflight must not populate its output path\")\n            self.assertEqual(payload[\"kind\"], \"PREFLIGHT\")\n            self.assertIn(code, (0, R.NOT_READY_EXIT))\n            self.assertEqual(code == 0, payload[\"ready\"])\n            self.assertNotIn(\"terminal\", payload)\n            self.assertIsInstance(payload[\"missing_capabilities\"], list)\n\n    def test_preflight_cannot_emit_product_success(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"preflight-target\"\n            _code, payload, _err = _run_main(\n                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                 \"--output-root\", str(output_root), \"--preflight\"]\n            )\n        self.assertNotIn(payload.get(\"kind\"), (\"UNIT_ACCEPTED\", \"COMPLETE\"))\n        self.assertNotIn(\"accepted_receipt\", payload)\n        self.assertNotIn(\"release_receipt\", payload)\n\n    def test_preflight_reports_a_collision_without_touching_an_existing_root(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"dirty\"\n            output_root.mkdir()\n            (output_root / \"stray.txt\").write_text(\"keep-me\", encoding=\"utf-8\")\n            code, payload, _err = _run_main(\n                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                 \"--output-root\", str(output_root), \"--preflight\"]\n            )\n            self.assertEqual(code, R.NOT_READY_EXIT)\n            self.assertFalse(payload[\"ready\"])\n            self.assertIsNotNone(payload[\"collision\"])\n            self.assertEqual((output_root / \"stray.txt\").read_text(encoding=\"utf-8\"), \"keep-me\")\n            self.assertEqual(sorted(p.name for p in output_root.iterdir()), [\"stray.txt\"])\n\n\n# ===========================================================================\n# TEST 6 — capability/authorization failures never simulate\n# ===========================================================================\n\n\nclass CapabilityAndAuthorizationFailureTests(unittest.TestCase):\n    def test_capability_proof_failure_happens_before_any_transmission_and_never_simulates(self):\n        import tempfile\n        invoke_calls = []\n\n        class _StubCompiled:\n            def invoke(self, *args, **kwargs):\n                invoke_calls.append((args, kwargs))\n                raise AssertionError(\"compiled graph must not be invoked once capability proof fails\")\n\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"out\"\n            authorization = _authorization_file(Path(raw))\n            with mock.patch.object(R, \"build_curriculum_factory_graph\", return_value=_StubCompiled()), \\\n                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n                                    side_effect=tp.CapabilityProofFailed(\"no codex on PATH\")):\n                code, payload, err = _run_main(\n                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                     \"--output-root\", str(output_root), \"--unit\", \"L01\",\n                     \"--authorization\", str(authorization)]\n                )\n\n        self.assertEqual(invoke_calls, [])\n        self.assertEqual(code, R.SYSTEM_FAILURE_EXIT)\n        self.assertEqual(payload[\"terminal\"][\"kind\"], \"SYSTEM_FAILURE\")\n        self.assertNotIn(payload[\"terminal\"].get(\"kind\"), (\"UNIT_ACCEPTED\", \"COMPLETE\"))\n        self.assertTrue(err.strip())\n\n    def test_missing_authorization_file_fails_before_any_lock_or_graph_build(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"out\"\n            with mock.patch.object(R, \"build_curriculum_factory_graph\") as builder:\n                code, payload, _err = _run_main(\n                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                     \"--output-root\", str(output_root), \"--unit\", \"L01\",\n                     \"--authorization\", str(Path(raw) / \"does-not-exist.json\")]\n                )\n            builder.assert_not_called()\n        self.assertEqual(code, R.ARGUMENT_ERROR_EXIT)\n        self.assertFalse(output_root.exists())\n        self.assertNotIn(\"terminal\", payload)\n\n\n# ===========================================================================\n# TEST 7 — Plan 25 roots are readable history, refused for resume\n# ===========================================================================\n\n\nclass Plan25ResumeRefusalTests(unittest.TestCase):\n    def test_a_plan25_shaped_root_is_refused_and_left_byte_identical(self):\n        import tempfile\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"legacy\"\n            output_root.mkdir()\n            # Shaped like the legacy `controller.simulate()` output layout, not\n            # the Plan 26 `.langgraph/` contract: no identity envelope at all.\n            (output_root / \"checkpoints\").mkdir()\n            legacy_checkpoint = output_root / \"checkpoints\" / \"0001.json\"\n            legacy_checkpoint.write_text(json.dumps({\"terminal_state\": \"ACCEPTED\"}), encoding=\"utf-8\")\n            before = {\n                p.relative_to(output_root).as_posix(): p.read_bytes()\n                for p in sorted(output_root.rglob(\"*\")) if p.is_file()\n            }\n\n            with mock.patch.object(R, \"build_curriculum_factory_graph\") as builder:\n                code, payload, err = _run_main(\n                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                     \"--output-root\", str(output_root), \"--resume\",\n                     \"--authorization\", str(_authorization_file(Path(raw)))]\n                )\n            builder.assert_not_called()\n\n            after = {\n                p.relative_to(output_root).as_posix(): p.read_bytes()\n                for p in sorted(output_root.rglob(\"*\")) if p.is_file()\n            }\n\n        self.assertEqual(code, R.NOT_READY_EXIT)\n        self.assertNotIn(\"terminal\", payload)\n        self.assertTrue(err.strip())\n        self.assertEqual(before, after, \"a refused resume must not mutate the Plan 25 root at all\")\n        self.assertFalse((output_root / P.LANGGRAPH_DIRNAME).exists())\n\n\n# ===========================================================================\n# Output projection / exit-code mapping (pure functions)\n# ===========================================================================\n\n\nclass OutputProjectionTests(unittest.TestCase):\n    def test_unit_accepted_projects_accepted_receipt(self):\n        output = {\n            \"contract_version\": \"1\", \"run_id\": \"r1\", \"episode_id\": \"e1\",\n            \"mode\": \"one\", \"requested_unit_id\": \"U001\", \"output_root\": \"/out\",\n            \"terminal\": {\"kind\": \"UNIT_ACCEPTED\"},\n            \"accepted_unit_receipts\": {\"U001\": {\"receipt_hash\": \"abc\"}},\n            \"checkpoint_metadata\": [{\"checkpoint_id\": \"c1\"}, {\"checkpoint_id\": \"c2\"}],\n            \"evidence_index_entries\": [{\"a\": 1}],\n        }\n        payload = R._project_result(output)\n        self.assertEqual(payload[\"accepted_receipt\"], {\"receipt_hash\": \"abc\"})\n        self.assertNotIn(\"release_receipt\", payload)\n        self.assertEqual(payload[\"checkpoint_id\"], \"c2\")\n        self.assertEqual(R._exit_code_for(payload), 0)\n\n    def test_complete_projects_release_receipt(self):\n        output = {\n            \"terminal\": {\"kind\": \"COMPLETE\"}, \"mode\": \"all\",\n            \"final_release_audits\": [{\"result\": \"PASS\", \"key\": \"k1\"}],\n            \"checkpoint_metadata\": [], \"evidence_index_entries\": [],\n        }\n        payload = R._project_result(output)\n        self.assertEqual(payload[\"release_receipt\"], {\"result\": \"PASS\", \"key\": \"k1\"})\n        self.assertNotIn(\"accepted_receipt\", payload)\n        self.assertEqual(R._exit_code_for(payload), 0)\n\n    def test_every_terminal_kind_maps_to_its_spec_exit_code(self):\n        expected = {\n            \"UNIT_ACCEPTED\": 0, \"COMPLETE\": 0, \"INTERRUPTED\": 10,\n            \"PAUSED_PREREQUISITE\": 11, \"CONVERGENCE_EXHAUSTED\": 12, \"SYSTEM_FAILURE\": 20,\n        }\n        for kind, exit_code in expected.items():\n            payload = R._project_result({\"terminal\": {\"kind\": kind}, \"checkpoint_metadata\": [], \"evidence_index_entries\": []})\n            self.assertEqual(R._exit_code_for(payload), exit_code, kind)\n\n    def test_evidence_index_hash_is_a_digest_over_the_entries(self):\n        from runtime.langgraph_factory.artifacts import canonical_digest\n        entries = [{\"key\": \"a\"}, {\"key\": \"b\"}]\n        output = {\"terminal\": {\"kind\": \"INTERRUPTED\"}, \"evidence_index_entries\": entries, \"checkpoint_metadata\": []}\n        payload = R._project_result(output)\n        self.assertEqual(payload[\"evidence_index_hash\"], canonical_digest(entries))\n\n\n# ===========================================================================\n# Fresh-run wiring (mocked graph + capability proof, real persistence layer)\n# ===========================================================================\n\n\nclass FreshRunWiringTests(unittest.TestCase):\n    def test_fresh_unit_run_builds_the_graph_once_and_invokes_with_a_fresh_envelope(self):\n        import tempfile\n\n        recorded: dict = {}\n\n        class _StubCompiled:\n            def invoke(self, graph_input, *, config, context):\n                recorded[\"graph_input\"] = graph_input\n                recorded[\"config\"] = config\n                recorded[\"context\"] = context\n                return {\n                    \"contract_version\": graph_input[\"invocation\"][\"contract_version\"],\n                    \"run_id\": \"state-run-id\",\n                    \"episode_id\": \"episode-1\",\n                    \"mode\": graph_input[\"invocation\"][\"mode\"],\n                    \"requested_unit_id\": graph_input[\"invocation\"][\"requested_unit_id\"],\n                    \"output_root\": graph_input[\"invocation\"][\"output_root\"],\n                    \"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"},\n                    \"checkpoint_metadata\": [],\n                    \"evidence_index_entries\": [],\n                }\n\n        builder_calls = []\n\n        def _fake_builder(*, engine_root, output_root):\n            builder_calls.append((engine_root, output_root))\n            return _StubCompiled()\n\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            curriculum = root / \"curricula\" / \"arduino_kit\"\n            manifest = curriculum / \"arduino_kit_curriculum.v5.yaml\"\n            manifest.parent.mkdir(parents=True)\n            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n            output_root = root / \"out\"\n            authorization = _authorization_file(root, providers={\"openai\": [\"manifest_unit_projection\"]})\n\n            with mock.patch.object(R, \"build_curriculum_factory_graph\", side_effect=_fake_builder), \\\n                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n                                    return_value={\"satisfied\": True, \"unsatisfied_required_facets\": []}):\n                code, payload, _err = _run_main(\n                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(manifest),\n                     \"--output-root\", str(output_root), \"--unit\", \"L01\",\n                     \"--authorization\", str(authorization)]\n                )\n\n        self.assertEqual(len(builder_calls), 1, \"the graph must be built exactly once\")\n        self.assertEqual(code, 10)\n        self.assertEqual(payload[\"terminal\"][\"kind\"], \"INTERRUPTED\")\n\n        envelope = recorded[\"graph_input\"][\"invocation\"]\n        self.assertEqual(envelope[\"kind\"], \"fresh\")\n        self.assertEqual(envelope[\"mode\"], \"one\")\n        self.assertEqual(envelope[\"requested_unit_id\"], \"L01\")\n        self.assertEqual(envelope[\"engine_root\"], str(REPO_ROOT))\n        self.assertEqual(envelope[\"curriculum_root\"], str(manifest.parent.resolve()))\n        self.assertEqual(envelope[\"output_root\"], str(output_root.resolve()))\n        self.assertIsNone(envelope[\"prior_identity\"])\n        self.assertIsNone(envelope[\"prior_terminal\"])\n        self.assertFalse(envelope[\"lease_open\"])\n        self.assertEqual(len(envelope[\"authorization\"][\"curriculum_digest\"]), 64)\n        self.assertEqual(envelope[\"authorization\"][\"output_root\"], str(output_root.resolve()))\n\n        context = recorded[\"context\"]\n        self.assertEqual(context.transport_registry.authorization.providers.get(\"openai\"), (\"manifest_unit_projection\",))\n        self.assertIsNotNone(context.transport_registry.capability_proof)\n        self.assertFalse(context.transport_registry.guard.installed, \"the guard must be uninstalled again after invoke\")\n\n        # The lock is released: a second invocation against the same root\n        # (still empty of a committed run, since the stub never wrote one) does\n        # not hit ExecutionLockUnavailable.\n        lock = P.ExecutionLock(output_root)\n        lock.acquire()\n        lock.release()\n\n    def test_all_mode_run_requests_no_unit_id(self):\n        import tempfile\n\n        recorded = {}\n\n        class _StubCompiled:\n            def invoke(self, graph_input, *, config, context):\n                recorded[\"envelope\"] = graph_input[\"invocation\"]\n                return {\n                    \"terminal\": {\"kind\": \"CONVERGENCE_EXHAUSTED\"},\n                    \"mode\": \"all\", \"checkpoint_metadata\": [], \"evidence_index_entries\": [],\n                }\n\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            curriculum = root / \"curricula\" / \"arduino_kit\"\n            manifest = curriculum / \"arduino_kit_curriculum.v5.yaml\"\n            manifest.parent.mkdir(parents=True)\n            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n            output_root = root / \"out\"\n            authorization = _authorization_file(root)\n\n            with mock.patch.object(R, \"build_curriculum_factory_graph\", return_value=_StubCompiled()), \\\n                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n                                    return_value={\"satisfied\": True, \"unsatisfied_required_facets\": []}):\n                code, payload, _err = _run_main(\n                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(manifest),\n                     \"--output-root\", str(output_root), \"--all\",\n                     \"--authorization\", str(authorization)]\n                )\n\n        self.assertEqual(code, 12)\n        self.assertIsNone(recorded[\"envelope\"][\"requested_unit_id\"])\n        self.assertEqual(recorded[\"envelope\"][\"mode\"], \"all\")\n\n    def test_a_second_fresh_invocation_against_a_populated_root_is_refused(self):\n        import tempfile\n\n        class _StubCompiled:\n            def invoke(self, graph_input, *, config, context):\n                return {\n                    \"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"},\n                    \"checkpoint_metadata\": [], \"evidence_index_entries\": [],\n                }\n\n        with tempfile.TemporaryDirectory() as raw:\n            root = Path(raw)\n            curriculum = root / \"curricula\" / \"arduino_kit\"\n            manifest = curriculum / \"arduino_kit_curriculum.v5.yaml\"\n            manifest.parent.mkdir(parents=True)\n            manifest.write_text(\"labs: []\\n\", encoding=\"utf-8\")\n            output_root = root / \"out\"\n            authorization = _authorization_file(root)\n            argv = [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(manifest),\n                    \"--output-root\", str(output_root), \"--unit\", \"L01\",\n                    \"--authorization\", str(authorization)]\n\n            with mock.patch.object(R, \"build_curriculum_factory_graph\", return_value=_StubCompiled()), \\\n                 mock.patch.object(R.tp, \"prove_transport_capabilities\",\n                                    return_value={\"satisfied\": True, \"unsatisfied_required_facets\": []}):\n                first_code, _payload, _err = _run_main(argv)\n                self.assertEqual(first_code, 10)\n                second_code, second_payload, _err2 = _run_main(argv)\n\n        self.assertEqual(second_code, R.NOT_READY_EXIT)\n        self.assertNotIn(\"terminal\", second_payload)\n\n\n# ===========================================================================\n# Resume envelope/seeding wiring (mocked persistence primitives)\n# ===========================================================================\n\n\nclass ResumeSeedingTests(unittest.TestCase):\n    def test_resume_envelope_derives_mode_and_target_from_the_frozen_identity(self):\n        identity = {\n            \"contract_version\": \"1\", \"engine_root\": \"/engine\", \"curriculum_root\": \"/curriculum\",\n            \"active_manifest_path\": \"/curriculum/manifest.yaml\", \"output_root\": \"/out\",\n            \"mode\": \"one\", \"requested_unit_id\": \"L07\", \"run_id\": \"run-xyz\",\n        }\n        invocation = SimpleNamespace(\n            bootstrap_kind=P.BOOTSTRAP_RESUME,\n            run_id=\"run-xyz\",\n            episode_id=\"run-xyz:episode:000002\",\n            episode_ordinal=2,\n            thread_id=\"run-xyz:episode:000002\",\n            identity_envelope=identity,\n            prior_thread_id=\"run-xyz:episode:000001\",\n            resume_from={\"terminal\": {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"}},\n        )\n        prior_values = {\n            \"frozen_digest\": \"deadbeef\" * 8,\n            \"accepted_unit_receipts\": {},\n            \"terminal\": {\"kind\": \"INTERRUPTED\"},\n            \"bootstrap_kind\": \"fresh\",\n            \"invocation\": {\"kind\": \"fresh\"},\n            \"episode_id\": \"run-xyz:episode:000001\",\n        }\n\n        with mock.patch.object(P, \"open_checkpoint_saver\", return_value=(object(), mock.Mock(close=lambda: None))), \\\n             mock.patch.object(P, \"ReadOnlyCheckpointView\", return_value=object()), \\\n             mock.patch.object(P, \"prepare_episode_invocation\", return_value=invocation), \\\n             mock.patch.object(P, \"extract_prior_episode\", return_value=SimpleNamespace(values=prior_values)):\n            got_invocation, envelope, frozen_digest, seed_values = R._prepare_resume(\n                output_root=Path(\"/out\"), lock=mock.Mock(), compiled=object()\n            )\n\n        self.assertIs(got_invocation, invocation)\n        self.assertEqual(envelope[\"kind\"], \"resume\")\n        self.assertEqual(envelope[\"mode\"], \"one\")\n        self.assertEqual(envelope[\"requested_unit_id\"], \"L07\")\n        self.assertEqual(envelope[\"engine_root\"], \"/engine\")\n        self.assertEqual(envelope[\"prior_identity\"], identity)\n        self.assertEqual(envelope[\"prior_terminal\"], {\"kind\": \"INTERRUPTED\", \"classification\": \"graceful_signal\"})\n        self.assertFalse(envelope[\"lease_open\"])\n        self.assertEqual(frozen_digest, \"deadbeef\" * 8)\n\n        # Episode-scoped fields are never carried forward from the prior episode.\n        for excluded in (\"terminal\", \"bootstrap_kind\", \"invocation\", \"episode_id\"):\n            self.assertNotIn(excluded, seed_values)\n        self.assertEqual(seed_values[\"frozen_digest\"], \"deadbeef\" * 8)\n        self.assertEqual(seed_values[\"accepted_unit_receipts\"], {})\n\n    def test_recover_orphan_envelope_carries_no_prior_terminal_and_marks_lease_open(self):\n        identity = {\n            \"contract_version\": \"1\", \"engine_root\": \"/engine\", \"curriculum_root\": \"/curriculum\",\n            \"active_manifest_path\": \"/curriculum/manifest.yaml\", \"output_root\": \"/out\",\n            \"mode\": \"all\", \"requested_unit_id\": None, \"run_id\": \"run-xyz\",\n        }\n        invocation = SimpleNamespace(\n            bootstrap_kind=P.BOOTSTRAP_RECOVER_ORPHAN,\n            run_id=\"run-xyz\",\n            episode_id=\"run-xyz:recover:1\",\n            episode_ordinal=2,\n            thread_id=\"run-xyz:recover:1\",\n            identity_envelope=identity,\n            prior_thread_id=\"run-xyz:episode:000001\",\n            resume_from=None,\n        )\n        with mock.patch.object(P, \"open_checkpoint_saver\", return_value=(object(), mock.Mock(close=lambda: None))), \\\n             mock.patch.object(P, \"ReadOnlyCheckpointView\", return_value=object()), \\\n             mock.patch.object(P, \"prepare_episode_invocation\", return_value=invocation), \\\n             mock.patch.object(P, \"extract_prior_episode\", return_value=SimpleNamespace(values={})):\n            _invocation, envelope, _frozen_digest, _seed = R._prepare_resume(\n                output_root=Path(\"/out\"), lock=mock.Mock(), compiled=object()\n            )\n\n        self.assertEqual(envelope[\"kind\"], \"recover_orphan\")\n        self.assertIsNone(envelope[\"prior_terminal\"])\n        self.assertTrue(envelope[\"lease_open\"])\n\n\n# ===========================================================================\n# Evidence artifacts (spec-facing proof, written under results/evidence/)\n# ===========================================================================\n\nEVIDENCE_DIR = REPO_ROOT / \"plans\" / \"26_langgraph_curriculum_factory\" / \"results\" / \"evidence\" / \"N40_CLI_CUTOVER\"\n\n\nclass EvidenceArtifactTests(unittest.TestCase):\n    \"\"\"Regenerates the node's own result-doc evidence as a side effect of a real\n    assertion, so the evidence can never drift from what actually passed.\"\"\"\n\n    def test_cli_help_evidence_matches_spec_section_16_surface(self):\n        help_text = R.build_parser().format_help()\n        for flag in (\"--engine-root\", \"--curriculum\", \"--output-root\", \"--preflight\",\n                     \"--unit\", \"--all\", \"--resume\", \"--authorization\"):\n            self.assertIn(flag, help_text)\n        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n        (EVIDENCE_DIR / \"cli_help.txt\").write_text(help_text, encoding=\"utf-8\")\n\n    def test_static_import_audit_evidence(self):\n        imports = sorted(\n            f\"{module or '<bare>'} :: {name or '<module>'}\"\n            for module, name in ImportGraphAuditTests()._imported_names()\n        )\n        report = (\n            \"Every import statement in runtime/run_curriculum.py (module :: name).\\n\"\n            \"TEST 1/5/8 assert no Plan 25, node-body, routing, or provider-SDK\\n\"\n            \"import appears in this list.\\n\\n\" + \"\\n\".join(imports) + \"\\n\"\n        )\n        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n        (EVIDENCE_DIR / \"import_audit.txt\").write_text(report, encoding=\"utf-8\")\n        self.assertTrue(imports)\n\n    def test_plan25_root_refusal_evidence(self):\n        import tempfile\n\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"legacy\"\n            output_root.mkdir()\n            (output_root / \"checkpoints\").mkdir()\n            (output_root / \"checkpoints\" / \"0001.json\").write_text(\n                json.dumps({\"terminal_state\": \"ACCEPTED\"}), encoding=\"utf-8\"\n            )\n            before = sorted(p.relative_to(output_root).as_posix() for p in output_root.rglob(\"*\"))\n\n            with mock.patch.object(R, \"build_curriculum_factory_graph\") as builder:\n                code, payload, err = _run_main(\n                    [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                     \"--output-root\", str(output_root), \"--resume\",\n                     \"--authorization\", str(_authorization_file(Path(raw)))]\n                )\n            builder.assert_not_called()\n            after = sorted(p.relative_to(output_root).as_posix() for p in output_root.rglob(\"*\"))\n\n        report = (\n            \"TEST 7: a Plan 25-shaped output root (checkpoints/0001.json, no\\n\"\n            \".langgraph/) passed to --resume.\\n\\n\"\n            f\"exit_code: {code}\\n\"\n            f\"stdout: {json.dumps(payload)}\\n\"\n            f\"stderr: {err.strip()}\\n\"\n            f\"files_before: {before}\\n\"\n            f\"files_after:  {after}\\n\"\n            f\"root_untouched: {before == after}\\n\"\n        )\n        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n        (EVIDENCE_DIR / \"plan25_resume_refusal.txt\").write_text(report, encoding=\"utf-8\")\n        self.assertEqual(before, after)\n        self.assertEqual(code, R.NOT_READY_EXIT)\n\n    def test_preflight_read_only_evidence(self):\n        import tempfile\n\n        with tempfile.TemporaryDirectory() as raw:\n            output_root = Path(raw) / \"preflight-target\"\n            code, payload, err = _run_main(\n                [\"--engine-root\", str(REPO_ROOT), \"--curriculum\", str(REPO_ROOT),\n                 \"--output-root\", str(output_root), \"--preflight\"]\n            )\n            output_root_exists_after = output_root.exists()\n\n        report = (\n            \"TEST 4: --preflight against an output root that does not yet exist.\\n\\n\"\n            f\"exit_code: {code}\\n\"\n            f\"stdout: {json.dumps(payload)}\\n\"\n            f\"stderr: {err.strip()}\\n\"\n            f\"output_root_created: {output_root_exists_after}\\n\"\n        )\n        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)\n        (EVIDENCE_DIR / \"preflight_read_only.txt\").write_text(report, encoding=\"utf-8\")\n        self.assertFalse(output_root_exists_after)\n        self.assertNotIn(\"terminal\", payload)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":807,"startLine":1,"totalLines":807}}}
