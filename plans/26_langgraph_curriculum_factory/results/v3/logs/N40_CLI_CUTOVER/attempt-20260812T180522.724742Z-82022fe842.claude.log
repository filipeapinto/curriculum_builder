{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PYofW4eEzRiwpsHy4JkN98","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"`python3 -m runtime.run_curriculum` — the sole production entry to the compiled\n3\tPlan 26 LangGraph curriculum factory (spec section 16).\n4\t\n5\tThis module parses and validates CLI syntax, canonicalizes paths, acquires the\n6\tper-output-root execution lock, prepares one episode invocation, builds the one\n7\tproduction graph (`runtime.langgraph_factory.graph.build_curriculum_factory_graph`),\n8\tinvokes it exactly once, projects its structured output into the one printed JSON\n9\tobject, and maps the result to an exit code. It runs no product step itself: it\n10\tholds no node body, no guard, no join, no acceptance rule, and no frontier\n11\tselection — every one of those lives inside the compiled graph, which is the only\n12\tthing here that ever decides what a run produced.\n13\t\n14\tTwo narrow, pure, side-effect-free helpers are imported from the graph package\n15\trather than re-implemented: `_resolve_active_manifest` and `_frozen_input_records`\n16\t(`runtime.langgraph_factory.nodes.inputs`) are the exact functions the graph's own\n17\tinput-freezing node uses to pick the active manifest and hash the frozen input\n18\tset. This module calls them once, before the graph exists, purely to fix the\n19\tidentity seed and the authorization/transport digest a `RuntimeContext` needs\n20\tbefore the first invocation; the graph's input-freezing node independently\n21\trecomputes the same values inside the episode and is the sole authority the graph\n22\titself trusts. Reusing the functions (rather than duplicating the hashing rule)\n23\tis what keeps the two computations from silently drifting apart; it is not a\n24\tsecond product path, because neither call site is reachable from the other and\n25\tneither one decides acceptance, routing, or a terminal.\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\timport argparse\n31\timport json\n32\timport sys\n33\timport tempfile\n34\tfrom datetime import datetime, timezone\n35\tfrom pathlib import Path\n36\tfrom typing import Any, Mapping\n37\t\n38\tfrom runtime.langgraph_factory import persistence as P\n39\tfrom runtime.langgraph_factory import transport as tp\n40\tfrom runtime.langgraph_factory.artifacts import canonical_digest\n41\tfrom runtime.langgraph_factory.egress import AuthorizationRecord, EgressGuard, ReceiptLog\n42\tfrom runtime.langgraph_factory.graph import build_curriculum_factory_graph, build_runtime_context\n43\tfrom runtime.langgraph_factory.nodes.inputs import (\n44\t    REQUIRED_CAPABILITIES,\n45\t    _frozen_input_records,\n46\t    _resolve_active_manifest,\n47\t)\n48\t\n49\t__all__ = [\"build_parser\", \"main\"]\n50\t\n51\tPROG = \"python3 -m runtime.run_curriculum\"\n52\tCONTRACT_VERSION = \"1\"\n53\t\n54\t# spec section 14's exit-code column, restated here rather than imported: this\n55\t# module must not import a node body, guard, or terminal-writing function, and\n56\t# the mapping itself is fixed, spec-owned data, not a decision this CLI makes.\n57\tTERMINAL_EXIT_CODES: dict[str, int] = {\n58\t    \"UNIT_ACCEPTED\": 0,\n59\t    \"COMPLETE\": 0,\n60\t    \"INTERRUPTED\": 10,\n61\t    \"PAUSED_PREREQUISITE\": 11,\n62\t    \"CONVERGENCE_EXHAUSTED\": 12,\n63\t    \"SYSTEM_FAILURE\": 20,\n64\t}\n65\tSYSTEM_FAILURE_EXIT = 20\n66\tARGUMENT_ERROR_EXIT = 2\n67\tNOT_READY_EXIT = 3\n68\t\n69\t# FactoryState channels that belong to *this* episode and must never be seeded\n70\t# from a prior episode's checkpointed values: the graph's own bootstrap and\n71\t# resume nodes write them fresh, and a stale write_once value here would\n72\t# collide with that fresh write instead of being silently ignored.\n73\t_EPISODE_SCOPED_STATE_FIELDS: frozenset[str] = frozenset(\n74\t    {\n75\t        \"invocation\",\n76\t        \"bootstrap_kind\",\n77\t        \"validated_recovery_envelope\",\n78\t        \"episode_id\",\n79\t        \"checkpoint_thread_id\",\n80\t        \"checkpoint_namespace\",\n81\t        \"resume_from\",\n82\t        \"pending_failure\",\n83\t        \"pending_packet\",\n84\t        \"pending_guard\",\n85\t        \"terminal_candidate\",\n86\t        \"terminal\",\n87\t    }\n88\t)\n89\t\n90\t\n91\tclass CliError(Exception):\n92\t    \"\"\"Base class for a pre-episode CLI refusal; carries its own exit code.\"\"\"\n93\t\n94\t    exit_code = ARGUMENT_ERROR_EXIT\n95\t\n96\t    def __init__(self, code: str, message: str, **detail: Any) -> None:\n97\t        super().__init__(message)\n98\t        self.code = code\n99\t        self.detail = detail\n100\t\n101\t\n102\tclass CliArgumentError(CliError):\n103\t    \"\"\"Malformed or contradictory CLI input. Exit 2, before any episode.\"\"\"\n104\t\n105\t    exit_code = ARGUMENT_ERROR_EXIT\n106\t\n107\t\n108\tclass CliNotReadyError(CliError):\n109\t    \"\"\"A syntactically valid invocation the run cannot safely start. Exit 3.\"\"\"\n110\t\n111\t    exit_code = NOT_READY_EXIT\n112\t\n113\t\n114\tdef _utc_now_iso() -> str:\n115\t    return datetime.now(timezone.utc).isoformat()\n116\t\n117\t\n118\t# --------------------------------------------------------------------------- args\n119\t\n120\t\n121\tdef build_parser() -> argparse.ArgumentParser:\n122\t    \"\"\"The exact preflight/one/all/resume argument surface of spec section 16.\"\"\"\n123\t\n124\t    parser = argparse.ArgumentParser(\n125\t        prog=PROG,\n126\t        description=\"Sole production CLI entry to the compiled Plan 26 curriculum factory.\",\n127\t    )\n128\t    parser.add_argument(\"--engine-root\", required=True, metavar=\"PATH\")\n129\t    parser.add_argument(\"--curriculum\", required=True, metavar=\"PATH\")\n130\t    parser.add_argument(\"--output-root\", required=True, metavar=\"PATH\")\n131\t\n132\t    mode = parser.add_mutually_exclusive_group(required=True)\n133\t    mode.add_argument(\"--preflight\", action=\"store_true\", help=\"read-only readiness check; creates no run\")\n134\t    mode.add_argument(\"--unit\", metavar=\"UNIT_ID\", help=\"run one requested unit plus its prerequisite closure\")\n135\t    mode.add_argument(\"--all\", action=\"store_true\", help=\"run the full exact manifest\")\n136\t    mode.add_argument(\"--resume\", action=\"store_true\", help=\"resume a legally resumable episode\")\n137\t\n138\t    parser.add_argument(\n139\t        \"--authorization\",\n140\t        metavar=\"PATH\",\n141\t        help=\"external-data authorization record; required for --unit, --all, and --resume\",\n142\t    )\n143\t    return parser\n144\t\n145\t\n146\tdef _validate_args(args: argparse.Namespace) -> None:\n147\t    if args.preflight and args.authorization:\n148\t        raise CliArgumentError(\n149\t            \"ARG-PREFLIGHT-NO-AUTHORIZATION\",\n150\t            \"--preflight is a read-only capability check and does not take --authorization\",\n151\t        )\n152\t    if not args.preflight and not args.authorization:\n153\t        raise CliArgumentError(\n154\t            \"ARG-AUTHORIZATION-REQUIRED\",\n155\t            \"--unit, --all, and --resume each require --authorization\",\n156\t        )\n157\t\n158\t\n159\t# ---------------------------------------------------------------- path resolution\n160\t\n161\t\n162\tdef _canonical_root(value: str, label: str) -> Path:\n163\t    path = Path(value).expanduser()\n164\t    if not path.is_absolute():\n165\t        path = Path.cwd() / path\n166\t    path = path.resolve()\n167\t    if not path.is_dir():\n168\t        raise CliArgumentError(\"ARG-NOT-A-DIRECTORY\", f\"{label} is not a directory: {path}\", path=str(path))\n169\t    return path\n170\t\n171\t\n172\tdef _canonical_output_root(value: str) -> Path:\n173\t    path = Path(value).expanduser()\n174\t    if not path.is_absolute():\n175\t        path = Path.cwd() / path\n176\t    return path.resolve()\n177\t\n178\t\n179\tdef _resolve_curriculum_root(value: str) -> Path:\n180\t    \"\"\"Accept either a manifest file or a curriculum directory (spec section 16).\"\"\"\n181\t\n182\t    path = Path(value).expanduser()\n183\t    if not path.is_absolute():\n184\t        path = Path.cwd() / path\n185\t    path = path.resolve()\n186\t    if path.is_file():\n187\t        return path.parent\n188\t    if path.is_dir():\n189\t        return path\n190\t    raise CliArgumentError(\"ARG-CURRICULUM-NOT-FOUND\", f\"--curriculum does not exist: {path}\", path=str(path))\n191\t\n192\t\n193\tdef _read_authorization(value: str) -> dict[str, Any]:\n194\t    path = Path(value).expanduser()\n195\t    if not path.is_absolute():\n196\t        path = Path.cwd() / path\n197\t    path = path.resolve()\n198\t    if not path.is_file():\n199\t        raise CliArgumentError(\n200\t            \"ARG-AUTHORIZATION-NOT-FOUND\", f\"--authorization file not found: {path}\", path=str(path)\n201\t        )\n202\t    try:\n203\t        raw = json.loads(path.read_text(encoding=\"utf-8\"))\n204\t    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:\n205\t        raise CliArgumentError(\n206\t            \"ARG-AUTHORIZATION-UNREADABLE\", f\"--authorization is not readable JSON: {error}\", path=str(path)\n207\t        ) from error\n208\t    if not isinstance(raw, dict):\n209\t        raise CliArgumentError(\"ARG-AUTHORIZATION-SHAPE\", \"--authorization must be a JSON object\", path=str(path))\n210\t    missing = [key for key in (\"approved_at_utc\", \"expires_at_utc\", \"providers\") if key not in raw]\n211\t    if missing:\n212\t        raise CliArgumentError(\n213\t            \"ARG-AUTHORIZATION-INCOMPLETE\",\n214\t            f\"--authorization is missing required field(s) {missing}\",\n215\t            path=str(path),\n216\t        )\n217\t    return raw\n218\t\n219\t\n220\tdef _collision_reason(output_root: Path) -> str | None:\n221\t    \"\"\"spec section 16: a fresh output root must not exist, or exist empty.\"\"\"\n222\t\n223\t    if not output_root.exists():\n224\t        return None\n225\t    if not output_root.is_dir():\n226\t        return f\"--output-root exists and is not a directory: {output_root}\"\n227\t    if any(output_root.iterdir()):\n228\t        return (\n229\t            f\"--output-root {output_root} is not empty and carries no resumable run; \"\n230\t            \"a fresh run requires a nonexistent or empty output root\"\n231\t        )\n232\t    return None\n233\t\n234\t\n235\t# --------------------------------------------------------------------------- authorization/capability\n236\t\n237\t\n238\tdef _authorization_envelope(raw: Mapping[str, Any], *, curriculum_digest: str, output_root: Path) -> dict[str, Any]:\n239\t    envelope = dict(raw)\n240\t    envelope[\"curriculum_digest\"] = curriculum_digest\n241\t    envelope[\"output_root\"] = str(output_root)\n242\t    return envelope\n243\t\n244\t\n245\tdef _authorization_record(\n246\t    raw: Mapping[str, Any], *, run_id: str, curriculum_digest: str, output_root: Path\n247\t) -> AuthorizationRecord:\n248\t    return AuthorizationRecord(\n249\t        run_id=run_id,\n250\t        curriculum_digest=curriculum_digest,\n251\t        output_root=str(output_root),\n252\t        approved_at_utc=str(raw[\"approved_at_utc\"]),\n253\t        expires_at_utc=str(raw[\"expires_at_utc\"]),\n254\t        providers=raw.get(\"providers\") or {},\n255\t    )\n256\t\n257\t\n258\tdef _capability_forbidden_paths(engine_root: Path) -> list[Path]:\n259\t    return [path for path in (engine_root / \"pyproject.toml\", engine_root / \"runtime\") if path.exists()]\n260\t\n261\t\n262\tdef _prove_live_capabilities(context: Any, engine_root: Path, output_root: Path) -> dict[str, Any]:\n263\t    \"\"\"Prove the transport isolation facets before the first model transmission.\n264\t\n265\t    Mutates the already-built `context.transport_registry` in place: the proof\n266\t    depends on `guard.installed`, and the guard the proof must observe is the\n267\t    exact one the transport will use to gate every real transmission, not a\n268\t    second guard built only to be thrown away.\n269\t    \"\"\"\n270\t\n271\t    transport = context.transport_registry\n272\t    guard = transport.guard\n273\t    probe_root = output_root / \".workspaces\" / \"_cli_capability_probe\"\n274\t    proof = tp.prove_transport_capabilities(\n275\t        guard=guard,\n276\t        probe_root=probe_root,\n277\t        forbidden_paths=_capability_forbidden_paths(engine_root),\n278\t    )\n279\t    transport.capability_proof = proof\n280\t    return proof\n281\t\n282\t\n283\tdef _preflight_capabilities() -> tuple[dict[str, dict[str, Any]], list[str]]:\n284\t    \"\"\"Bounded local capability probes only; never populates the real output root.\"\"\"\n285\t\n286\t    with tempfile.TemporaryDirectory(prefix=\"plan26-preflight-\") as raw_probe_root:\n287\t        probe_root = Path(raw_probe_root)\n288\t        receipts = ReceiptLog()\n289\t        guard = EgressGuard(receipts)\n290\t        transport = tp.CliTransport(\n291\t            output_root=probe_root,\n292\t            run_id=\"preflight\",\n293\t            curriculum_digest=\"0\" * 64,\n294\t            authorization=None,\n295\t            receipts=receipts,\n296\t            guard=guard,\n297\t            ledger=tp.AttemptLedger(),\n298\t            capability_proof=None,\n299\t            evidence_root=probe_root / \"evidence\",\n300\t        )\n301\t        guard.install()\n302\t        try:\n303\t            results: dict[str, dict[str, Any]] = {}\n304\t            missing: list[str] = []\n305\t            for capability in REQUIRED_CAPABILITIES:\n306\t                proof = transport.prove_capability(capability)\n307\t                results[capability] = proof\n308\t                if proof.get(\"result\") != \"PASS\":\n309\t                    missing.append(capability)\n310\t        finally:\n311\t            guard.uninstall()\n312\t    return results, missing\n313\t\n314\t\n315\t# --------------------------------------------------------------------------- preflight\n316\t\n317\t\n318\tdef _run_preflight(engine_root: Path, curriculum_root: Path, output_root: Path) -> tuple[dict[str, Any], int]:\n319\t    collision = _collision_reason(output_root)\n320\t    capabilities, missing = _preflight_capabilities()\n321\t    ready = collision is None and not missing\n322\t    payload: dict[str, Any] = {\n323\t        \"contract_version\": CONTRACT_VERSION,\n324\t        \"kind\": \"PREFLIGHT\",\n325\t        \"ready\": ready,\n326\t        \"engine_root\": str(engine_root),\n327\t        \"curriculum_root\": str(curriculum_root),\n328\t        \"output_root\": str(output_root),\n329\t        \"capabilities\": capabilities,\n330\t        \"missing_capabilities\": missing,\n331\t        \"collision\": collision,\n332\t    }\n333\t    return payload, (0 if ready else NOT_READY_EXIT)\n334\t\n335\t\n336\t# --------------------------------------------------------------------------- live invocation\n337\t\n338\t\n339\tdef _acquire_lock(output_root: Path) -> P.ExecutionLock:\n340\t    lock = P.ExecutionLock(output_root)\n341\t    try:\n342\t        lock.acquire()\n343\t    except P.ExecutionLockUnavailable as error:\n344\t        raise CliNotReadyError(\"LOCK-UNAVAILABLE\", str(error)) from error\n345\t    return lock\n346\t\n347\t\n348\tdef _prepare_fresh(\n349\t    *, engine_root: Path, curriculum_root: Path, output_root: Path, mode: str, requested_unit_id: str | None,\n350\t    lock: P.ExecutionLock,\n351\t) -> tuple[P.EpisodeInvocation, dict[str, Any], str]:\n352\t    active_manifest_path = _resolve_active_manifest(curriculum_root)\n353\t    identity_seed = {\n354\t        \"contract_version\": CONTRACT_VERSION,\n355\t        \"created_at\": _utc_now_iso(),\n356\t        \"engine_root\": str(engine_root),\n357\t        \"curriculum_root\": str(curriculum_root),\n358\t        \"active_manifest_path\": str(active_manifest_path),\n359\t        \"output_root\": str(output_root),\n360\t        \"mode\": mode,\n361\t        \"requested_unit_id\": requested_unit_id,\n362\t    }\n363\t    try:\n364\t        invocation = P.prepare_episode_invocation(\n365\t            output_root=output_root, lock=lock, identity_seed=identity_seed, resume=False\n366\t        )\n367\t    except P.PersistenceError as error:\n368\t        raise CliNotReadyError(\"BOOTSTRAP-REFUSED\", str(error)) from error\n369\t\n370\t    frozen_digest = canonical_digest(_frozen_input_records(engine_root, curriculum_root, active_manifest_path))\n371\t    envelope = {\n372\t        \"kind\": \"fresh\",\n373\t        \"contract_version\": CONTRACT_VERSION,\n374\t        \"engine_root\": str(engine_root),\n375\t        \"curriculum_root\": str(curriculum_root),\n376\t        \"output_root\": str(output_root),\n377\t        \"mode\": mode,\n378\t        \"requested_unit_id\": requested_unit_id,\n379\t        \"authorization\": None,  # filled by the caller once it has curriculum_digest\n380\t        \"episode_ordinal\": invocation.episode_ordinal,\n381\t        \"prior_identity\": None,\n382\t        \"prior_terminal\": None,\n383\t        \"lease_open\": False,\n384\t    }\n385\t    return invocation, envelope, frozen_digest\n386\t\n387\t\n388\tdef _prepare_resume(\n389\t    *, output_root: Path, lock: P.ExecutionLock, compiled: Any\n390\t) -> tuple[P.EpisodeInvocation, dict[str, Any], str, dict[str, Any]]:\n391\t    saver, connection = P.open_checkpoint_saver(output_root)\n392\t    try:\n393\t        view = P.ReadOnlyCheckpointView(compiled, saver)\n394\t        try:\n395\t            invocation = P.prepare_episode_invocation(\n396\t                output_root=output_root, lock=lock, resume=True, read_view=view\n397\t            )\n398\t        except P.PersistenceError as error:\n399\t            raise CliNotReadyError(\"RESUME-REFUSED\", str(error)) from error\n400\t\n401\t        seed_values: dict[str, Any] = {}\n402\t        if invocation.prior_thread_id is not None:\n403\t            prior = P.extract_prior_episode(view, invocation.prior_thread_id)\n404\t            seed_values = {\n405\t                key: value\n406\t                for key, value in prior.values.items()\n407\t                if key not in _EPISODE_SCOPED_STATE_FIELDS\n408\t            }\n409\t    finally:\n410\t        connection.close()\n411\t\n412\t    identity = invocation.identity_envelope\n413\t    prior_terminal = None\n414\t    if invocation.resume_from is not None:\n415\t        prior_terminal = invocation.resume_from.get(\"terminal\")\n416\t\n417\t    bootstrap_kind = {\n418\t        P.BOOTSTRAP_RESUME: \"resume\",\n419\t        P.BOOTSTRAP_RECOVER_ORPHAN: \"recover_orphan\",\n420\t    }.get(invocation.bootstrap_kind, invocation.bootstrap_kind)\n421\t\n422\t    envelope = {\n423\t        \"kind\": bootstrap_kind,\n424\t        \"contract_version\": identity.get(\"contract_version\"),\n425\t        \"engine_root\": identity.get(\"engine_root\"),\n426\t        \"curriculum_root\": identity.get(\"curriculum_root\"),\n427\t        \"output_root\": identity.get(\"output_root\"),\n428\t        \"mode\": identity.get(\"mode\"),\n429\t        \"requested_unit_id\": identity.get(\"requested_unit_id\"),\n430\t        \"authorization\": None,  # filled by the caller once it has curriculum_digest\n431\t        \"episode_ordinal\": invocation.episode_ordinal,\n432\t        \"prior_identity\": identity,\n433\t        \"prior_terminal\": None if bootstrap_kind == \"recover_orphan\" else prior_terminal,\n434\t        \"lease_open\": bootstrap_kind == \"recover_orphan\",\n435\t    }\n436\t    frozen_digest = str(seed_values.get(\"frozen_digest\") or \"\")\n437\t    return invocation, envelope, frozen_digest, seed_values\n438\t\n439\t\n440\tdef _invoke(\n441\t    *,\n442\t    engine_root: Path,\n443\t    output_root: Path,\n444\t    envelope: dict[str, Any],\n445\t    invocation: P.EpisodeInvocation,\n446\t    frozen_digest: str,\n447\t    authorization_raw: Mapping[str, Any],\n448\t    seed_values: Mapping[str, Any] | None,\n449\t    compiled: Any,\n450\t) -> dict[str, Any]:\n451\t    context = build_runtime_context(\n452\t        engine_root=engine_root,\n453\t        output_root=output_root,\n454\t        run_id=invocation.run_id,\n455\t        curriculum_digest=frozen_digest,\n456\t        authorization=_authorization_record(\n457\t            authorization_raw, run_id=invocation.run_id, curriculum_digest=frozen_digest, output_root=output_root\n458\t        ),\n459\t        capability_proof=None,\n460\t    )\n461\t    envelope[\"authorization\"] = _authorization_envelope(\n462\t        authorization_raw, curriculum_digest=frozen_digest, output_root=output_root\n463\t    )\n464\t\n465\t    guard = context.transport_registry.guard\n466\t    guard.install()\n467\t    try:\n468\t        _prove_live_capabilities(context, engine_root, output_root)\n469\t        graph_input: dict[str, Any] = {**(seed_values or {}), \"invocation\": envelope}\n470\t        return dict(compiled.invoke(graph_input, config=invocation.config, context=context))\n471\t    finally:\n472\t        guard.uninstall()\n473\t\n474\t\n475\t# --------------------------------------------------------------------------- output projection\n476\t\n477\t\n478\tdef _project_result(output: Mapping[str, Any]) -> dict[str, Any]:\n479\t    terminal = output.get(\"terminal\") or {}\n480\t    kind = terminal.get(\"kind\")\n481\t\n482\t    payload: dict[str, Any] = {\n483\t        \"contract_version\": output.get(\"contract_version\"),\n484\t        \"run_id\": output.get(\"run_id\"),\n485\t        \"episode_id\": output.get(\"episode_id\"),\n486\t        \"terminal\": terminal,\n487\t        \"mode\": output.get(\"mode\"),\n488\t        \"requested_unit_id\": output.get(\"requested_unit_id\"),\n489\t        \"checkpoint_id\": None,\n490\t        \"evidence_index_hash\": canonical_digest(list(output.get(\"evidence_index_entries\") or [])),\n491\t        \"output_root\": output.get(\"output_root\"),\n492\t    }\n493\t\n494\t    checkpoints = list(output.get(\"checkpoint_metadata\") or [])\n495\t    if checkpoints:\n496\t        payload[\"checkpoint_id\"] = checkpoints[-1].get(\"checkpoint_id\")\n497\t\n498\t    if kind == \"UNIT_ACCEPTED\":\n499\t        accepted = output.get(\"accepted_unit_receipts\") or {}\n500\t        payload[\"accepted_receipt\"] = accepted.get(output.get(\"requested_unit_id\"))\n501\t    elif kind == \"COMPLETE\":\n502\t        audits = list(output.get(\"final_release_audits\") or [])\n503\t        payload[\"release_receipt\"] = audits[-1] if audits else None\n504\t\n505\t    return payload\n506\t\n507\t\n508\tdef _exit_code_for(payload: Mapping[str, Any]) -> int:\n509\t    terminal = payload.get(\"terminal\") or {}\n510\t    kind = terminal.get(\"kind\")\n511\t    return TERMINAL_EXIT_CODES.get(kind, SYSTEM_FAILURE_EXIT)\n512\t\n513\t\n514\tdef _system_failure_payload(message: str, *, code: str) -> dict[str, Any]:\n515\t    return {\n516\t        \"contract_version\": CONTRACT_VERSION,\n517\t        \"terminal\": {\n518\t            \"kind\": \"SYSTEM_FAILURE\",\n519\t            \"failure\": {\"class\": \"system\", \"cause\": code, \"message\": message},\n520\t        },\n521\t    }\n522\t\n523\t\n524\t# --------------------------------------------------------------------------- main\n525\t\n526\t\n527\tdef _run_live(args: argparse.Namespace) -> tuple[dict[str, Any], int]:\n528\t    engine_root = _canonical_root(args.engine_root, \"--engine-root\")\n529\t    curriculum_root = _resolve_curriculum_root(args.curriculum)\n530\t    output_root = _canonical_output_root(args.output_root)\n531\t    authorization_raw = _read_authorization(args.authorization)\n532\t\n533\t    if not args.resume:\n534\t        collision = _collision_reason(output_root)\n535\t        if collision is not None:\n536\t            # Checked before the lock is acquired: acquiring the lock itself\n537\t            # would create `.langgraph/` inside `output_root`, which must not\n538\t            # happen for a collision this CLI is about to refuse anyway.\n539\t            raise CliNotReadyError(\"COLLISION\", collision)\n540\t\n541\t    if args.resume and P.read_identity_envelope(output_root) is None:\n542\t        # A read-only check, deliberately before the lock: an output root with no\n543\t        # Plan 26 identity envelope (a fresh path, or a Plan 25 root) is refused\n544\t        # without acquiring anything or writing a single byte into it — it stays\n545\t        # exactly the readable history it was.\n546\t        raise CliNotReadyError(\n547\t            \"RESUME-NO-IDENTITY\",\n548\t            f\"--output-root has no Plan 26 run identity to resume: {output_root}\",\n549\t        )\n550\t\n551\t    lock = _acquire_lock(output_root)\n552\t    try:\n553\t        if args.resume:\n554\t            compiled = build_curriculum_factory_graph(engine_root=engine_root, output_root=output_root)\n555\t            invocation, envelope, frozen_digest, seed_values = _prepare_resume(\n556\t                output_root=output_root, lock=lock, compiled=compiled\n557\t            )\n558\t        else:\n559\t            mode = \"all\" if args.all else \"one\"\n560\t            requested_unit_id = None if args.all else args.unit\n561\t            invocation, envelope, frozen_digest = _prepare_fresh(\n562\t                engine_root=engine_root,\n563\t                curriculum_root=curriculum_root,\n564\t                output_root=output_root,\n565\t                mode=mode,\n566\t                requested_unit_id=requested_unit_id,\n567\t                lock=lock,\n568\t            )\n569\t            seed_values = None\n570\t            compiled = build_curriculum_factory_graph(engine_root=engine_root, output_root=output_root)\n571\t\n572\t        output = _invoke(\n573\t            engine_root=engine_root,\n574\t            output_root=output_root,\n575\t            envelope=envelope,\n576\t            invocation=invocation,\n577\t            frozen_digest=frozen_digest,\n578\t            authorization_raw=authorization_raw,\n579\t            seed_values=seed_values,\n580\t            compiled=compiled,\n581\t        )\n582\t    finally:\n583\t        lock.release()\n584\t\n585\t    payload = _project_result(output)\n586\t    return payload, _exit_code_for(payload)\n587\t\n588\t\n589\tdef main(argv: list[str] | None = None) -> int:\n590\t    parser = build_parser()\n591\t    args = parser.parse_args(argv)\n592\t\n593\t    try:\n594\t        _validate_args(args)\n595\t        if args.preflight:\n596\t            engine_root = _canonical_root(args.engine_root, \"--engine-root\")\n597\t            curriculum_root = _resolve_curriculum_root(args.curriculum)\n598\t            output_root = _canonical_output_root(args.output_root)\n599\t            payload, code = _run_preflight(engine_root, curriculum_root, output_root)\n600\t        else:\n601\t            payload, code = _run_live(args)\n602\t    except CliError as error:\n603\t        print(f\"{error.code}: {error}\", file=sys.stderr)\n604\t        # A pre-episode refusal (bad arguments, collision, lock, resume identity)\n605\t        # writes no episode and no terminal record at all — exactly section 14's\n606\t        # \"neither is a product terminal\" — so the printed object carries no\n607\t        # `terminal` key rather than a fabricated or empty one.\n608\t        payload = {\"contract_version\": CONTRACT_VERSION, \"error_code\": error.code, \"message\": str(error)}\n609\t        print(json.dumps(payload))\n610\t        return error.exit_code\n611\t    except Exception as error:  # never let an unhandled fault look like anything but a failure\n612\t        print(f\"{type(error).__name__}: {error}\", file=sys.stderr)\n613\t        print(json.dumps(_system_failure_payload(str(error), code=type(error).__name__)))\n614\t        return SYSTEM_FAILURE_EXIT\n615\t\n616\t    print(json.dumps(payload))\n617\t    return code\n618\t\n619\t\n620\tif __name__ == \"__main__\":\n621\t    raise SystemExit(main())\n622\t"}]},"parent_tool_use_id":null,"session_id":"50bcfa3d-b3df-45db-ab55-346f882745b2","uuid":"c62c4e6c-3a19-4e4f-907c-a3a8ee761d7f","timestamp":"2026-08-12T18:05:32.787Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N40_CLI_CUTOVER/attempt-20260812T180522.724742Z-82022fe842/repo/runtime/run_curriculum.py","content":"#!/usr/bin/env python3\n\"\"\"`python3 -m runtime.run_curriculum` — the sole production entry to the compiled\nPlan 26 LangGraph curriculum factory (spec section 16).\n\nThis module parses and validates CLI syntax, canonicalizes paths, acquires the\nper-output-root execution lock, prepares one episode invocation, builds the one\nproduction graph (`runtime.langgraph_factory.graph.build_curriculum_factory_graph`),\ninvokes it exactly once, projects its structured output into the one printed JSON\nobject, and maps the result to an exit code. It runs no product step itself: it\nholds no node body, no guard, no join, no acceptance rule, and no frontier\nselection — every one of those lives inside the compiled graph, which is the only\nthing here that ever decides what a run produced.\n\nTwo narrow, pure, side-effect-free helpers are imported from the graph package\nrather than re-implemented: `_resolve_active_manifest` and `_frozen_input_records`\n(`runtime.langgraph_factory.nodes.inputs`) are the exact functions the graph's own\ninput-freezing node uses to pick the active manifest and hash the frozen input\nset. This module calls them once, before the graph exists, purely to fix the\nidentity seed and the authorization/transport digest a `RuntimeContext` needs\nbefore the first invocation; the graph's input-freezing node independently\nrecomputes the same values inside the episode and is the sole authority the graph\nitself trusts. Reusing the functions (rather than duplicating the hashing rule)\nis what keeps the two computations from silently drifting apart; it is not a\nsecond product path, because neither call site is reachable from the other and\nneither one decides acceptance, routing, or a terminal.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Mapping\n\nfrom runtime.langgraph_factory import persistence as P\nfrom runtime.langgraph_factory import transport as tp\nfrom runtime.langgraph_factory.artifacts import canonical_digest\nfrom runtime.langgraph_factory.egress import AuthorizationRecord, EgressGuard, ReceiptLog\nfrom runtime.langgraph_factory.graph import build_curriculum_factory_graph, build_runtime_context\nfrom runtime.langgraph_factory.nodes.inputs import (\n    REQUIRED_CAPABILITIES,\n    _frozen_input_records,\n    _resolve_active_manifest,\n)\n\n__all__ = [\"build_parser\", \"main\"]\n\nPROG = \"python3 -m runtime.run_curriculum\"\nCONTRACT_VERSION = \"1\"\n\n# spec section 14's exit-code column, restated here rather than imported: this\n# module must not import a node body, guard, or terminal-writing function, and\n# the mapping itself is fixed, spec-owned data, not a decision this CLI makes.\nTERMINAL_EXIT_CODES: dict[str, int] = {\n    \"UNIT_ACCEPTED\": 0,\n    \"COMPLETE\": 0,\n    \"INTERRUPTED\": 10,\n    \"PAUSED_PREREQUISITE\": 11,\n    \"CONVERGENCE_EXHAUSTED\": 12,\n    \"SYSTEM_FAILURE\": 20,\n}\nSYSTEM_FAILURE_EXIT = 20\nARGUMENT_ERROR_EXIT = 2\nNOT_READY_EXIT = 3\n\n# FactoryState channels that belong to *this* episode and must never be seeded\n# from a prior episode's checkpointed values: the graph's own bootstrap and\n# resume nodes write them fresh, and a stale write_once value here would\n# collide with that fresh write instead of being silently ignored.\n_EPISODE_SCOPED_STATE_FIELDS: frozenset[str] = frozenset(\n    {\n        \"invocation\",\n        \"bootstrap_kind\",\n        \"validated_recovery_envelope\",\n        \"episode_id\",\n        \"checkpoint_thread_id\",\n        \"checkpoint_namespace\",\n        \"resume_from\",\n        \"pending_failure\",\n        \"pending_packet\",\n        \"pending_guard\",\n        \"terminal_candidate\",\n        \"terminal\",\n    }\n)\n\n\nclass CliError(Exception):\n    \"\"\"Base class for a pre-episode CLI refusal; carries its own exit code.\"\"\"\n\n    exit_code = ARGUMENT_ERROR_EXIT\n\n    def __init__(self, code: str, message: str, **detail: Any) -> None:\n        super().__init__(message)\n        self.code = code\n        self.detail = detail\n\n\nclass CliArgumentError(CliError):\n    \"\"\"Malformed or contradictory CLI input. Exit 2, before any episode.\"\"\"\n\n    exit_code = ARGUMENT_ERROR_EXIT\n\n\nclass CliNotReadyError(CliError):\n    \"\"\"A syntactically valid invocation the run cannot safely start. Exit 3.\"\"\"\n\n    exit_code = NOT_READY_EXIT\n\n\ndef _utc_now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\n# --------------------------------------------------------------------------- args\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    \"\"\"The exact preflight/one/all/resume argument surface of spec section 16.\"\"\"\n\n    parser = argparse.ArgumentParser(\n        prog=PROG,\n        description=\"Sole production CLI entry to the compiled Plan 26 curriculum factory.\",\n    )\n    parser.add_argument(\"--engine-root\", required=True, metavar=\"PATH\")\n    parser.add_argument(\"--curriculum\", required=True, metavar=\"PATH\")\n    parser.add_argument(\"--output-root\", required=True, metavar=\"PATH\")\n\n    mode = parser.add_mutually_exclusive_group(required=True)\n    mode.add_argument(\"--preflight\", action=\"store_true\", help=\"read-only readiness check; creates no run\")\n    mode.add_argument(\"--unit\", metavar=\"UNIT_ID\", help=\"run one requested unit plus its prerequisite closure\")\n    mode.add_argument(\"--all\", action=\"store_true\", help=\"run the full exact manifest\")\n    mode.add_argument(\"--resume\", action=\"store_true\", help=\"resume a legally resumable episode\")\n\n    parser.add_argument(\n        \"--authorization\",\n        metavar=\"PATH\",\n        help=\"external-data authorization record; required for --unit, --all, and --resume\",\n    )\n    return parser\n\n\ndef _validate_args(args: argparse.Namespace) -> None:\n    if args.preflight and args.authorization:\n        raise CliArgumentError(\n            \"ARG-PREFLIGHT-NO-AUTHORIZATION\",\n            \"--preflight is a read-only capability check and does not take --authorization\",\n        )\n    if not args.preflight and not args.authorization:\n        raise CliArgumentError(\n            \"ARG-AUTHORIZATION-REQUIRED\",\n            \"--unit, --all, and --resume each require --authorization\",\n        )\n\n\n# ---------------------------------------------------------------- path resolution\n\n\ndef _canonical_root(value: str, label: str) -> Path:\n    path = Path(value).expanduser()\n    if not path.is_absolute():\n        path = Path.cwd() / path\n    path = path.resolve()\n    if not path.is_dir():\n        raise CliArgumentError(\"ARG-NOT-A-DIRECTORY\", f\"{label} is not a directory: {path}\", path=str(path))\n    return path\n\n\ndef _canonical_output_root(value: str) -> Path:\n    path = Path(value).expanduser()\n    if not path.is_absolute():\n        path = Path.cwd() / path\n    return path.resolve()\n\n\ndef _resolve_curriculum_root(value: str) -> Path:\n    \"\"\"Accept either a manifest file or a curriculum directory (spec section 16).\"\"\"\n\n    path = Path(value).expanduser()\n    if not path.is_absolute():\n        path = Path.cwd() / path\n    path = path.resolve()\n    if path.is_file():\n        return path.parent\n    if path.is_dir():\n        return path\n    raise CliArgumentError(\"ARG-CURRICULUM-NOT-FOUND\", f\"--curriculum does not exist: {path}\", path=str(path))\n\n\ndef _read_authorization(value: str) -> dict[str, Any]:\n    path = Path(value).expanduser()\n    if not path.is_absolute():\n        path = Path.cwd() / path\n    path = path.resolve()\n    if not path.is_file():\n        raise CliArgumentError(\n            \"ARG-AUTHORIZATION-NOT-FOUND\", f\"--authorization file not found: {path}\", path=str(path)\n        )\n    try:\n        raw = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise CliArgumentError(\n            \"ARG-AUTHORIZATION-UNREADABLE\", f\"--authorization is not readable JSON: {error}\", path=str(path)\n        ) from error\n    if not isinstance(raw, dict):\n        raise CliArgumentError(\"ARG-AUTHORIZATION-SHAPE\", \"--authorization must be a JSON object\", path=str(path))\n    missing = [key for key in (\"approved_at_utc\", \"expires_at_utc\", \"providers\") if key not in raw]\n    if missing:\n        raise CliArgumentError(\n            \"ARG-AUTHORIZATION-INCOMPLETE\",\n            f\"--authorization is missing required field(s) {missing}\",\n            path=str(path),\n        )\n    return raw\n\n\ndef _collision_reason(output_root: Path) -> str | None:\n    \"\"\"spec section 16: a fresh output root must not exist, or exist empty.\"\"\"\n\n    if not output_root.exists():\n        return None\n    if not output_root.is_dir():\n        return f\"--output-root exists and is not a directory: {output_root}\"\n    if any(output_root.iterdir()):\n        return (\n            f\"--output-root {output_root} is not empty and carries no resumable run; \"\n            \"a fresh run requires a nonexistent or empty output root\"\n        )\n    return None\n\n\n# --------------------------------------------------------------------------- authorization/capability\n\n\ndef _authorization_envelope(raw: Mapping[str, Any], *, curriculum_digest: str, output_root: Path) -> dict[str, Any]:\n    envelope = dict(raw)\n    envelope[\"curriculum_digest\"] = curriculum_digest\n    envelope[\"output_root\"] = str(output_root)\n    return envelope\n\n\ndef _authorization_record(\n    raw: Mapping[str, Any], *, run_id: str, curriculum_digest: str, output_root: Path\n) -> AuthorizationRecord:\n    return AuthorizationRecord(\n        run_id=run_id,\n        curriculum_digest=curriculum_digest,\n        output_root=str(output_root),\n        approved_at_utc=str(raw[\"approved_at_utc\"]),\n        expires_at_utc=str(raw[\"expires_at_utc\"]),\n        providers=raw.get(\"providers\") or {},\n    )\n\n\ndef _capability_forbidden_paths(engine_root: Path) -> list[Path]:\n    return [path for path in (engine_root / \"pyproject.toml\", engine_root / \"runtime\") if path.exists()]\n\n\ndef _prove_live_capabilities(context: Any, engine_root: Path, output_root: Path) -> dict[str, Any]:\n    \"\"\"Prove the transport isolation facets before the first model transmission.\n\n    Mutates the already-built `context.transport_registry` in place: the proof\n    depends on `guard.installed`, and the guard the proof must observe is the\n    exact one the transport will use to gate every real transmission, not a\n    second guard built only to be thrown away.\n    \"\"\"\n\n    transport = context.transport_registry\n    guard = transport.guard\n    probe_root = output_root / \".workspaces\" / \"_cli_capability_probe\"\n    proof = tp.prove_transport_capabilities(\n        guard=guard,\n        probe_root=probe_root,\n        forbidden_paths=_capability_forbidden_paths(engine_root),\n    )\n    transport.capability_proof = proof\n    return proof\n\n\ndef _preflight_capabilities() -> tuple[dict[str, dict[str, Any]], list[str]]:\n    \"\"\"Bounded local capability probes only; never populates the real output root.\"\"\"\n\n    with tempfile.TemporaryDirectory(prefix=\"plan26-preflight-\") as raw_probe_root:\n        probe_root = Path(raw_probe_root)\n        receipts = ReceiptLog()\n        guard = EgressGuard(receipts)\n        transport = tp.CliTransport(\n            output_root=probe_root,\n            run_id=\"preflight\",\n            curriculum_digest=\"0\" * 64,\n            authorization=None,\n            receipts=receipts,\n            guard=guard,\n            ledger=tp.AttemptLedger(),\n            capability_proof=None,\n            evidence_root=probe_root / \"evidence\",\n        )\n        guard.install()\n        try:\n            results: dict[str, dict[str, Any]] = {}\n            missing: list[str] = []\n            for capability in REQUIRED_CAPABILITIES:\n                proof = transport.prove_capability(capability)\n                results[capability] = proof\n                if proof.get(\"result\") != \"PASS\":\n                    missing.append(capability)\n        finally:\n            guard.uninstall()\n    return results, missing\n\n\n# --------------------------------------------------------------------------- preflight\n\n\ndef _run_preflight(engine_root: Path, curriculum_root: Path, output_root: Path) -> tuple[dict[str, Any], int]:\n    collision = _collision_reason(output_root)\n    capabilities, missing = _preflight_capabilities()\n    ready = collision is None and not missing\n    payload: dict[str, Any] = {\n        \"contract_version\": CONTRACT_VERSION,\n        \"kind\": \"PREFLIGHT\",\n        \"ready\": ready,\n        \"engine_root\": str(engine_root),\n        \"curriculum_root\": str(curriculum_root),\n        \"output_root\": str(output_root),\n        \"capabilities\": capabilities,\n        \"missing_capabilities\": missing,\n        \"collision\": collision,\n    }\n    return payload, (0 if ready else NOT_READY_EXIT)\n\n\n# --------------------------------------------------------------------------- live invocation\n\n\ndef _acquire_lock(output_root: Path) -> P.ExecutionLock:\n    lock = P.ExecutionLock(output_root)\n    try:\n        lock.acquire()\n    except P.ExecutionLockUnavailable as error:\n        raise CliNotReadyError(\"LOCK-UNAVAILABLE\", str(error)) from error\n    return lock\n\n\ndef _prepare_fresh(\n    *, engine_root: Path, curriculum_root: Path, output_root: Path, mode: str, requested_unit_id: str | None,\n    lock: P.ExecutionLock,\n) -> tuple[P.EpisodeInvocation, dict[str, Any], str]:\n    active_manifest_path = _resolve_active_manifest(curriculum_root)\n    identity_seed = {\n        \"contract_version\": CONTRACT_VERSION,\n        \"created_at\": _utc_now_iso(),\n        \"engine_root\": str(engine_root),\n        \"curriculum_root\": str(curriculum_root),\n        \"active_manifest_path\": str(active_manifest_path),\n        \"output_root\": str(output_root),\n        \"mode\": mode,\n        \"requested_unit_id\": requested_unit_id,\n    }\n    try:\n        invocation = P.prepare_episode_invocation(\n            output_root=output_root, lock=lock, identity_seed=identity_seed, resume=False\n        )\n    except P.PersistenceError as error:\n        raise CliNotReadyError(\"BOOTSTRAP-REFUSED\", str(error)) from error\n\n    frozen_digest = canonical_digest(_frozen_input_records(engine_root, curriculum_root, active_manifest_path))\n    envelope = {\n        \"kind\": \"fresh\",\n        \"contract_version\": CONTRACT_VERSION,\n        \"engine_root\": str(engine_root),\n        \"curriculum_root\": str(curriculum_root),\n        \"output_root\": str(output_root),\n        \"mode\": mode,\n        \"requested_unit_id\": requested_unit_id,\n        \"authorization\": None,  # filled by the caller once it has curriculum_digest\n        \"episode_ordinal\": invocation.episode_ordinal,\n        \"prior_identity\": None,\n        \"prior_terminal\": None,\n        \"lease_open\": False,\n    }\n    return invocation, envelope, frozen_digest\n\n\ndef _prepare_resume(\n    *, output_root: Path, lock: P.ExecutionLock, compiled: Any\n) -> tuple[P.EpisodeInvocation, dict[str, Any], str, dict[str, Any]]:\n    saver, connection = P.open_checkpoint_saver(output_root)\n    try:\n        view = P.ReadOnlyCheckpointView(compiled, saver)\n        try:\n            invocation = P.prepare_episode_invocation(\n                output_root=output_root, lock=lock, resume=True, read_view=view\n            )\n        except P.PersistenceError as error:\n            raise CliNotReadyError(\"RESUME-REFUSED\", str(error)) from error\n\n        seed_values: dict[str, Any] = {}\n        if invocation.prior_thread_id is not None:\n            prior = P.extract_prior_episode(view, invocation.prior_thread_id)\n            seed_values = {\n                key: value\n                for key, value in prior.values.items()\n                if key not in _EPISODE_SCOPED_STATE_FIELDS\n            }\n    finally:\n        connection.close()\n\n    identity = invocation.identity_envelope\n    prior_terminal = None\n    if invocation.resume_from is not None:\n        prior_terminal = invocation.resume_from.get(\"terminal\")\n\n    bootstrap_kind = {\n        P.BOOTSTRAP_RESUME: \"resume\",\n        P.BOOTSTRAP_RECOVER_ORPHAN: \"recover_orphan\",\n    }.get(invocation.bootstrap_kind, invocation.bootstrap_kind)\n\n    envelope = {\n        \"kind\": bootstrap_kind,\n        \"contract_version\": identity.get(\"contract_version\"),\n        \"engine_root\": identity.get(\"engine_root\"),\n        \"curriculum_root\": identity.get(\"curriculum_root\"),\n        \"output_root\": identity.get(\"output_root\"),\n        \"mode\": identity.get(\"mode\"),\n        \"requested_unit_id\": identity.get(\"requested_unit_id\"),\n        \"authorization\": None,  # filled by the caller once it has curriculum_digest\n        \"episode_ordinal\": invocation.episode_ordinal,\n        \"prior_identity\": identity,\n        \"prior_terminal\": None if bootstrap_kind == \"recover_orphan\" else prior_terminal,\n        \"lease_open\": bootstrap_kind == \"recover_orphan\",\n    }\n    frozen_digest = str(seed_values.get(\"frozen_digest\") or \"\")\n    return invocation, envelope, frozen_digest, seed_values\n\n\ndef _invoke(\n    *,\n    engine_root: Path,\n    output_root: Path,\n    envelope: dict[str, Any],\n    invocation: P.EpisodeInvocation,\n    frozen_digest: str,\n    authorization_raw: Mapping[str, Any],\n    seed_values: Mapping[str, Any] | None,\n    compiled: Any,\n) -> dict[str, Any]:\n    context = build_runtime_context(\n        engine_root=engine_root,\n        output_root=output_root,\n        run_id=invocation.run_id,\n        curriculum_digest=frozen_digest,\n        authorization=_authorization_record(\n            authorization_raw, run_id=invocation.run_id, curriculum_digest=frozen_digest, output_root=output_root\n        ),\n        capability_proof=None,\n    )\n    envelope[\"authorization\"] = _authorization_envelope(\n        authorization_raw, curriculum_digest=frozen_digest, output_root=output_root\n    )\n\n    guard = context.transport_registry.guard\n    guard.install()\n    try:\n        _prove_live_capabilities(context, engine_root, output_root)\n        graph_input: dict[str, Any] = {**(seed_values or {}), \"invocation\": envelope}\n        return dict(compiled.invoke(graph_input, config=invocation.config, context=context))\n    finally:\n        guard.uninstall()\n\n\n# --------------------------------------------------------------------------- output projection\n\n\ndef _project_result(output: Mapping[str, Any]) -> dict[str, Any]:\n    terminal = output.get(\"terminal\") or {}\n    kind = terminal.get(\"kind\")\n\n    payload: dict[str, Any] = {\n        \"contract_version\": output.get(\"contract_version\"),\n        \"run_id\": output.get(\"run_id\"),\n        \"episode_id\": output.get(\"episode_id\"),\n        \"terminal\": terminal,\n        \"mode\": output.get(\"mode\"),\n        \"requested_unit_id\": output.get(\"requested_unit_id\"),\n        \"checkpoint_id\": None,\n        \"evidence_index_hash\": canonical_digest(list(output.get(\"evidence_index_entries\") or [])),\n        \"output_root\": output.get(\"output_root\"),\n    }\n\n    checkpoints = list(output.get(\"checkpoint_metadata\") or [])\n    if checkpoints:\n        payload[\"checkpoint_id\"] = checkpoints[-1].get(\"checkpoint_id\")\n\n    if kind == \"UNIT_ACCEPTED\":\n        accepted = output.get(\"accepted_unit_receipts\") or {}\n        payload[\"accepted_receipt\"] = accepted.get(output.get(\"requested_unit_id\"))\n    elif kind == \"COMPLETE\":\n        audits = list(output.get(\"final_release_audits\") or [])\n        payload[\"release_receipt\"] = audits[-1] if audits else None\n\n    return payload\n\n\ndef _exit_code_for(payload: Mapping[str, Any]) -> int:\n    terminal = payload.get(\"terminal\") or {}\n    kind = terminal.get(\"kind\")\n    return TERMINAL_EXIT_CODES.get(kind, SYSTEM_FAILURE_EXIT)\n\n\ndef _system_failure_payload(message: str, *, code: str) -> dict[str, Any]:\n    return {\n        \"contract_version\": CONTRACT_VERSION,\n        \"terminal\": {\n            \"kind\": \"SYSTEM_FAILURE\",\n            \"failure\": {\"class\": \"system\", \"cause\": code, \"message\": message},\n        },\n    }\n\n\n# --------------------------------------------------------------------------- main\n\n\ndef _run_live(args: argparse.Namespace) -> tuple[dict[str, Any], int]:\n    engine_root = _canonical_root(args.engine_root, \"--engine-root\")\n    curriculum_root = _resolve_curriculum_root(args.curriculum)\n    output_root = _canonical_output_root(args.output_root)\n    authorization_raw = _read_authorization(args.authorization)\n\n    if not args.resume:\n        collision = _collision_reason(output_root)\n        if collision is not None:\n            # Checked before the lock is acquired: acquiring the lock itself\n            # would create `.langgraph/` inside `output_root`, which must not\n            # happen for a collision this CLI is about to refuse anyway.\n            raise CliNotReadyError(\"COLLISION\", collision)\n\n    if args.resume and P.read_identity_envelope(output_root) is None:\n        # A read-only check, deliberately before the lock: an output root with no\n        # Plan 26 identity envelope (a fresh path, or a Plan 25 root) is refused\n        # without acquiring anything or writing a single byte into it — it stays\n        # exactly the readable history it was.\n        raise CliNotReadyError(\n            \"RESUME-NO-IDENTITY\",\n            f\"--output-root has no Plan 26 run identity to resume: {output_root}\",\n        )\n\n    lock = _acquire_lock(output_root)\n    try:\n        if args.resume:\n            compiled = build_curriculum_factory_graph(engine_root=engine_root, output_root=output_root)\n            invocation, envelope, frozen_digest, seed_values = _prepare_resume(\n                output_root=output_root, lock=lock, compiled=compiled\n            )\n        else:\n            mode = \"all\" if args.all else \"one\"\n            requested_unit_id = None if args.all else args.unit\n            invocation, envelope, frozen_digest = _prepare_fresh(\n                engine_root=engine_root,\n                curriculum_root=curriculum_root,\n                output_root=output_root,\n                mode=mode,\n                requested_unit_id=requested_unit_id,\n                lock=lock,\n            )\n            seed_values = None\n            compiled = build_curriculum_factory_graph(engine_root=engine_root, output_root=output_root)\n\n        output = _invoke(\n            engine_root=engine_root,\n            output_root=output_root,\n            envelope=envelope,\n            invocation=invocation,\n            frozen_digest=frozen_digest,\n            authorization_raw=authorization_raw,\n            seed_values=seed_values,\n            compiled=compiled,\n        )\n    finally:\n        lock.release()\n\n    payload = _project_result(output)\n    return payload, _exit_code_for(payload)\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = build_parser()\n    args = parser.parse_args(argv)\n\n    try:\n        _validate_args(args)\n        if args.preflight:\n            engine_root = _canonical_root(args.engine_root, \"--engine-root\")\n            curriculum_root = _resolve_curriculum_root(args.curriculum)\n            output_root = _canonical_output_root(args.output_root)\n            payload, code = _run_preflight(engine_root, curriculum_root, output_root)\n        else:\n            payload, code = _run_live(args)\n    except CliError as error:\n        print(f\"{error.code}: {error}\", file=sys.stderr)\n        # A pre-episode refusal (bad arguments, collision, lock, resume identity)\n        # writes no episode and no terminal record at all — exactly section 14's\n        # \"neither is a product terminal\" — so the printed object carries no\n        # `terminal` key rather than a fabricated or empty one.\n        payload = {\"contract_version\": CONTRACT_VERSION, \"error_code\": error.code, \"message\": str(error)}\n        print(json.dumps(payload))\n        return error.exit_code\n    except Exception as error:  # never let an unhandled fault look like anything but a failure\n        print(f\"{type(error).__name__}: {error}\", file=sys.stderr)\n        print(json.dumps(_system_failure_payload(str(error), code=type(error).__name__)))\n        return SYSTEM_FAILURE_EXIT\n\n    print(json.dumps(payload))\n    return code\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":622,"startLine":1,"totalLines":622}}}
