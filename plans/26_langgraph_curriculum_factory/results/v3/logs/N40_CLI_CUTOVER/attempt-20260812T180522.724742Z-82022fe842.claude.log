{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TcHjYxY6FwpS6xuTN1kuD3","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport io\n5\tfrom pathlib import Path\n6\timport tempfile\n7\timport unittest\n8\tfrom unittest import mock\n9\tfrom contextlib import redirect_stdout\n10\t\n11\tfrom runtime.controller import CurriculumRuntime\n12\tfrom runtime.run_curriculum import main, parser_for\n13\t\n14\t\n15\tENGINE = Path(__file__).resolve().parents[2]\n16\tCURRICULUM = ENGINE / \"curricula/arduino_kit\"\n17\tREMOVED_FLAGS = (\n18\t    \"--max-lab-seconds\",\n19\t    \"--phase-timeout-seconds\",\n20\t    \"--max-run-seconds\",\n21\t)\n22\t\n23\t\n24\tclass RunCurriculumParserTests(unittest.TestCase):\n25\t    def setUp(self):\n26\t        self.runtime = CurriculumRuntime(ENGINE)\n27\t\n28\t    def test_parser_constructs_without_per_phase(self):\n29\t        self.runtime.limit_policy.pop(\"per_phase\", None)\n30\t        parser = parser_for(self.runtime)\n31\t        self.assertIsNotNone(parser.parse_args([\"--curriculum\", str(CURRICULUM)]))\n32\t\n33\t    def test_removed_time_flags_are_absent_and_rejected(self):\n34\t        parser = parser_for(self.runtime)\n35\t        help_text = parser.format_help()\n36\t        option_strings = {\n37\t            option\n38\t            for action in parser._actions\n39\t            for option in action.option_strings\n40\t        }\n41\t        for flag in REMOVED_FLAGS:\n42\t            with self.subTest(flag=flag):\n43\t                self.assertNotIn(flag, help_text)\n44\t                self.assertNotIn(flag, option_strings)\n45\t                with self.assertRaisesRegex(SystemExit, \"2\"):\n46\t                    parser.parse_args([\"--curriculum\", str(CURRICULUM), flag, \"1\"])\n47\t\n48\t    def test_representative_retained_policy_defaults(self):\n49\t        args = parser_for(self.runtime).parse_args([\"--curriculum\", str(CURRICULUM)])\n50\t        expected = {\n51\t            \"max_model_calls_per_lab\": self.runtime.limit_policy[\"per_lab\"][\"max_model_calls\"][\"value\"],\n52\t            \"max_concurrency\": self.runtime.limit_policy[\"per_run\"][\"max_concurrency\"][\"value\"],\n53\t            \"max_meta_revision_cycles\": self.runtime.limit_policy[\"convergence\"][\"max_meta_revision_cycles\"][\"value\"],\n54\t            \"retry_malformed_output\": self.runtime.limit_policy[\"retry\"][\"malformed_structured_output\"][\"value\"],\n55\t        }\n56\t        for destination, value in expected.items():\n57\t            with self.subTest(destination=destination):\n58\t                self.assertEqual(getattr(args, destination), value)\n59\t\n60\t    @mock.patch(\"runtime.run_curriculum.CurriculumFactoryGraph\")\n61\t    @mock.patch(\"runtime.run_curriculum.CodexWorker\")\n62\t    def test_live_cli_dispatches_exact_manifest_to_factory(self, worker, factory):\n63\t        factory.return_value.run.return_value = {\"terminal\": \"UNIT_ACCEPTED\", \"run_id\": \"r1\"}\n64\t        output = ENGINE / \"outputs/cli-dispatch-not-created\"\n65\t        stream = io.StringIO()\n66\t        with redirect_stdout(stream):\n67\t            code = main([\"--curriculum\", str(CURRICULUM / \"arduino_kit_curriculum.v5.yaml\"),\n68\t                         \"--lab-id\", \"L01\", \"--output-root\", str(output)])\n69\t        self.assertEqual(0, code)\n70\t        factory.return_value.run.assert_called_once()\n71\t        call = factory.return_value.run.call_args.kwargs\n72\t        self.assertEqual(str(CURRICULUM / \"arduino_kit_curriculum.v5.yaml\"), call[\"curriculum\"])\n73\t        self.assertEqual(\"L01\", call[\"lab_id\"])\n74\t        self.assertFalse(call[\"all_units\"])\n75\t\n76\t\n77\tclass RunCurriculumElapsedTimeTests(unittest.TestCase):\n78\t    def setUp(self):\n79\t        self.runtime = CurriculumRuntime(ENGINE)\n80\t        outputs_root = ENGINE / \"outputs\"\n81\t        outputs_root.mkdir(parents=True, exist_ok=True)\n82\t        self.temp = tempfile.TemporaryDirectory(dir=str(outputs_root))\n83\t        self.base = Path(self.temp.name)\n84\t\n85\t    def tearDown(self):\n86\t        self.temp.cleanup()\n87\t\n88\t    def test_simulation_accepts_after_all_removed_time_thresholds(self):\n89\t        monotonic_times = [0.0, 901.0, 5401.0, 36001.0]\n90\t        monotonic_times.extend(36002.0 + index for index in range(len(self.runtime.states) - 3))\n91\t        output = self.base / \"thresholds\"\n92\t        with mock.patch(\"runtime.controller.time.monotonic\", side_effect=monotonic_times):\n93\t            result = self.runtime.simulate(CURRICULUM, output, lab_id=\"L01\")\n94\t\n95\t        self.assertEqual(result[\"terminal_state\"], \"ACCEPTED\")\n96\t        self.assertEqual(result[\"coverage\"], \"simulated-controller-only\")\n97\t        checkpoints = [\n98\t            json.loads(path.read_text(encoding=\"utf-8\"))\n99\t            for path in sorted((output / \"checkpoints\").glob(\"*.json\"))\n100\t        ]\n101\t        elapsed = [record[\"elapsed_seconds\"] for record in checkpoints]\n102\t        self.assertTrue(all(isinstance(value, (int, float)) for value in elapsed))\n103\t        self.assertGreater(elapsed[0], 900)\n104\t        self.assertGreater(elapsed[1], 5400)\n105\t        self.assertGreater(elapsed[2], 36000)\n106\t\n107\t\n108\tif __name__ == \"__main__\":\n109\t    unittest.main()\n110\t"}]},"parent_tool_use_id":null,"session_id":"50bcfa3d-b3df-45db-ab55-346f882745b2","uuid":"8907e858-c8d9-45eb-ac66-db947d82d2e7","timestamp":"2026-08-12T18:05:32.192Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N40_CLI_CUTOVER/attempt-20260812T180522.724742Z-82022fe842/repo/tests/runtime/test_run_curriculum.py","content":"from __future__ import annotations\n\nimport json\nimport io\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest import mock\nfrom contextlib import redirect_stdout\n\nfrom runtime.controller import CurriculumRuntime\nfrom runtime.run_curriculum import main, parser_for\n\n\nENGINE = Path(__file__).resolve().parents[2]\nCURRICULUM = ENGINE / \"curricula/arduino_kit\"\nREMOVED_FLAGS = (\n    \"--max-lab-seconds\",\n    \"--phase-timeout-seconds\",\n    \"--max-run-seconds\",\n)\n\n\nclass RunCurriculumParserTests(unittest.TestCase):\n    def setUp(self):\n        self.runtime = CurriculumRuntime(ENGINE)\n\n    def test_parser_constructs_without_per_phase(self):\n        self.runtime.limit_policy.pop(\"per_phase\", None)\n        parser = parser_for(self.runtime)\n        self.assertIsNotNone(parser.parse_args([\"--curriculum\", str(CURRICULUM)]))\n\n    def test_removed_time_flags_are_absent_and_rejected(self):\n        parser = parser_for(self.runtime)\n        help_text = parser.format_help()\n        option_strings = {\n            option\n            for action in parser._actions\n            for option in action.option_strings\n        }\n        for flag in REMOVED_FLAGS:\n            with self.subTest(flag=flag):\n                self.assertNotIn(flag, help_text)\n                self.assertNotIn(flag, option_strings)\n                with self.assertRaisesRegex(SystemExit, \"2\"):\n                    parser.parse_args([\"--curriculum\", str(CURRICULUM), flag, \"1\"])\n\n    def test_representative_retained_policy_defaults(self):\n        args = parser_for(self.runtime).parse_args([\"--curriculum\", str(CURRICULUM)])\n        expected = {\n            \"max_model_calls_per_lab\": self.runtime.limit_policy[\"per_lab\"][\"max_model_calls\"][\"value\"],\n            \"max_concurrency\": self.runtime.limit_policy[\"per_run\"][\"max_concurrency\"][\"value\"],\n            \"max_meta_revision_cycles\": self.runtime.limit_policy[\"convergence\"][\"max_meta_revision_cycles\"][\"value\"],\n            \"retry_malformed_output\": self.runtime.limit_policy[\"retry\"][\"malformed_structured_output\"][\"value\"],\n        }\n        for destination, value in expected.items():\n            with self.subTest(destination=destination):\n                self.assertEqual(getattr(args, destination), value)\n\n    @mock.patch(\"runtime.run_curriculum.CurriculumFactoryGraph\")\n    @mock.patch(\"runtime.run_curriculum.CodexWorker\")\n    def test_live_cli_dispatches_exact_manifest_to_factory(self, worker, factory):\n        factory.return_value.run.return_value = {\"terminal\": \"UNIT_ACCEPTED\", \"run_id\": \"r1\"}\n        output = ENGINE / \"outputs/cli-dispatch-not-created\"\n        stream = io.StringIO()\n        with redirect_stdout(stream):\n            code = main([\"--curriculum\", str(CURRICULUM / \"arduino_kit_curriculum.v5.yaml\"),\n                         \"--lab-id\", \"L01\", \"--output-root\", str(output)])\n        self.assertEqual(0, code)\n        factory.return_value.run.assert_called_once()\n        call = factory.return_value.run.call_args.kwargs\n        self.assertEqual(str(CURRICULUM / \"arduino_kit_curriculum.v5.yaml\"), call[\"curriculum\"])\n        self.assertEqual(\"L01\", call[\"lab_id\"])\n        self.assertFalse(call[\"all_units\"])\n\n\nclass RunCurriculumElapsedTimeTests(unittest.TestCase):\n    def setUp(self):\n        self.runtime = CurriculumRuntime(ENGINE)\n        outputs_root = ENGINE / \"outputs\"\n        outputs_root.mkdir(parents=True, exist_ok=True)\n        self.temp = tempfile.TemporaryDirectory(dir=str(outputs_root))\n        self.base = Path(self.temp.name)\n\n    def tearDown(self):\n        self.temp.cleanup()\n\n    def test_simulation_accepts_after_all_removed_time_thresholds(self):\n        monotonic_times = [0.0, 901.0, 5401.0, 36001.0]\n        monotonic_times.extend(36002.0 + index for index in range(len(self.runtime.states) - 3))\n        output = self.base / \"thresholds\"\n        with mock.patch(\"runtime.controller.time.monotonic\", side_effect=monotonic_times):\n            result = self.runtime.simulate(CURRICULUM, output, lab_id=\"L01\")\n\n        self.assertEqual(result[\"terminal_state\"], \"ACCEPTED\")\n        self.assertEqual(result[\"coverage\"], \"simulated-controller-only\")\n        checkpoints = [\n            json.loads(path.read_text(encoding=\"utf-8\"))\n            for path in sorted((output / \"checkpoints\").glob(\"*.json\"))\n        ]\n        elapsed = [record[\"elapsed_seconds\"] for record in checkpoints]\n        self.assertTrue(all(isinstance(value, (int, float)) for value in elapsed))\n        self.assertGreater(elapsed[0], 900)\n        self.assertGreater(elapsed[1], 5400)\n        self.assertGreater(elapsed[2], 36000)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":110,"startLine":1,"totalLines":110}}}
