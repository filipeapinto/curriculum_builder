{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ee69QkxpnVLBNF3Zja1tLK","type":"tool_result","content":"1\t\"\"\"Unit evidence reduction and acceptance: D16, D22, D23 of spec section 6.2.\n2\t\n3\t`compute_unit_denominator()` is the one reduction engine spec section 13.1\n4\tdescribes -- built by `D16_REDUCE_UNIT_EVIDENCE` before repair, and recomputed\n5\tbyte-for-byte by `D22_ACCEPT_UNIT` immediately before minting an accepted\n6\treceipt, off whatever the *current* heads are at that moment. A retest that\n7\tchanged a head between the two calls changes what this function sees; nothing\n8\there caches or trusts its own earlier answer.\n9\t\n10\tLike `repair.py`, none of this module's functions carry a `NODE_CATALOGUE` row\n11\tyet -- registration into the compiled graph is N32's write, once `workbook.py`\n12\texists to dispatch the workbook branch alongside them.\n13\t\n14\tKnown scope of this generation's denominator (documented rather than silently\n15\tassumed): it enforces source admission, the domain and content check sets, the\n16\tvisual join, the page inventory/inspection set, one independent unit review\n17\twith all findings mapped through a code-owned owner table, and open-repair\n18\tclosure. It treats the append-only evidence/log layer and the LangGraph\n19\tcheckpoint layer as structurally present rather than independently\n20\tre-auditing them byte-for-byte here (spec section 13.1 items 13-14) --\n21\t`checkpoint_metadata`/`evidence_index_entries` shape is enforced by the state\n22\treducers themselves (`reducers.py`), and this generation does not yet call an\n23\texternal hash-chain audit from inside D22. A denominator category is never\n24\tremoved to make a fixture pass; a future generation only ever tightens this.\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom dataclasses import dataclass, field\n31\tfrom typing import Any\n32\t\n33\tfrom . import reducers, repair, routing\n34\tfrom .nodes import (\n35\t    SystemFailure,\n36\t    candidate_payload,\n37\t    canonical_digest,\n38\t    check_record,\n39\t    require,\n40\t    stream_id,\n41\t)\n42\tfrom .nodes.content import CONTENT_CHECK_IDS\n43\tfrom .nodes.domain import DOMAIN_CHECK_IDS\n44\t\n45\t__all__ = [\n46\t    \"DenominatorResult\",\n47\t    \"compute_unit_denominator\",\n48\t    \"prove_exact_manifest_coverage\",\n49\t    \"D16_REDUCE_UNIT_EVIDENCE\",\n50\t    \"D22_ACCEPT_UNIT\",\n51\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n52\t    \"UNIT_REPAIR_TOPOLOGY_SOURCES\",\n53\t    \"UNIT_REPAIR_NODE_BODIES\",\n54\t    \"unit_repair_destinations\",\n55\t    \"register_unit_repair_path\",\n56\t]\n57\t\n58\t\n59\t@dataclass(frozen=True)\n60\tclass DenominatorResult:\n61\t    passed: bool\n62\t    check: dict[str, Any]\n63\t    findings: list[dict[str, Any]] = field(default_factory=list)\n64\t    denominator: dict[str, Any] = field(default_factory=dict)\n65\t\n66\t\n67\tdef _guard(node_id: str, value: str, **detail: Any) -> dict[str, Any]:\n68\t    return {\"node\": node_id, \"value\": value, \"detail\": detail}\n69\t\n70\t\n71\tdef _status_update(state: Mapping[str, Any], unit_id: str, target: str) -> dict[str, str]:\n72\t    \"\"\"`{unit_id: target}` only when `reducers.UNIT_STATUS_TRANSITIONS` allows it.\n73\t\n74\t    `D05_SELECT_NEXT_UNIT` is the only node this generation that sets an\n75\t    initial `unit_status` (`SELECTED`); no deterministic node between it and\n76\t    D16 advances through `SOURCING`/`BUILDING` yet (a real, code-owned gap\n77\t    outside this module's write set), so a first-real-run D16 call legally\n78\t    has no declared transition to make. Recording nothing in that case is\n79\t    honest about what actually happened rather than raising a\n80\t    `StatusTransitionError` for a gap this module does not own, or\n81\t    fabricating an intermediate status no node ever produced. Once a unit\n82\t    reaches `REVIEWING`/`REPAIRING` the declared cycle between them is real\n83\t    and this always records it.\n84\t    \"\"\"\n85\t\n86\t    current = (state.get(\"unit_status\") or {}).get(unit_id)\n87\t    if current is None:\n88\t        return {unit_id: target} if target in reducers.INITIAL_UNIT_STATUSES else {}\n89\t    if target in reducers.UNIT_STATUS_TRANSITIONS.get(current, frozenset()):\n90\t        return {unit_id: target}\n91\t    return {}\n92\t\n93\t\n94\tdef _latest_unit_review(unit_reviews: Any, pdf_sha256: str | None) -> dict[str, Any] | None:\n95\t    if not pdf_sha256:\n96\t        return None\n97\t    matches = [\n98\t        dict(record)\n99\t        for record in unit_reviews or []\n100\t        if isinstance(record, Mapping)\n101\t        and record.get(\"record_kind\") == \"model_candidate\"\n102\t        and record.get(\"job_id\") == \"M05_REVIEW_ACTUAL_UNIT\"\n103\t        and record.get(\"unit_pdf_sha256\") == pdf_sha256\n104\t    ]\n105\t    return matches[-1] if matches else None\n106\t\n107\t\n108\tdef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n109\t    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n110\t\n111\t    heads = state.get(\"artifact_heads\") or {}\n112\t    checks = [\n113\t        record\n114\t        for record in state.get(\"deterministic_checks\") or []\n115\t        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n116\t    ]\n117\t    findings: list[dict[str, Any]] = []\n118\t    categories: dict[str, Any] = {}\n119\t\n120\t    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n121\t        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n122\t\n123\t    # 1-2. source admission and correlation.\n124\t    admissions = [\n125\t        record\n126\t        for record in state.get(\"source_admissions\") or []\n127\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n128\t    ]\n129\t    admissions_ok = bool(admissions) and all(\n130\t        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n131\t    )\n132\t    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n133\t    if not admissions_ok:\n134\t        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n135\t\n136\t    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n137\t    domain_stream = stream_id(unit_id, \"domain\")\n138\t    domain_head = heads.get(domain_stream)\n139\t    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n140\t    domain_checks = {\n141\t        record[\"check_id\"]: record\n142\t        for record in checks\n143\t        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n144\t    }\n145\t    domain_ok = domain_hash is not None and all(\n146\t        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n147\t    )\n148\t    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n149\t    if not domain_ok:\n150\t        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n151\t\n152\t    # 4, 6. unit schema and every sourced claim resolved.\n153\t    content_stream = stream_id(unit_id, \"content\")\n154\t    content_head = heads.get(content_stream)\n155\t    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n156\t    content_checks = {\n157\t        record[\"check_id\"]: record\n158\t        for record in checks\n159\t        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n160\t    }\n161\t    content_ok = content_hash is not None and all(\n162\t        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n163\t    )\n164\t    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n165\t    if not content_ok:\n166\t        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n167\t\n168\t    # 8. every required actual visual, provenance, and asset resolution.\n169\t    visual_join = [\n170\t        record\n171\t        for record in state.get(\"visual_join_evidence\") or []\n172\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n173\t    ]\n174\t    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n175\t    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n176\t    if not visuals_ok:\n177\t        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n178\t\n179\t    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n180\t    inventories = [\n181\t        record\n182\t        for record in state.get(\"unit_page_inventories\") or []\n183\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n184\t    ]\n185\t    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n186\t    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n187\t    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n188\t    inspections = [\n189\t        record\n190\t        for record in state.get(\"unit_page_inspections\") or []\n191\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n192\t    ]\n193\t    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n194\t    inspections_ok = (\n195\t        inventory_ok\n196\t        and len(inspections) == expected_pages\n197\t        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n198\t    )\n199\t    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n200\t    if not inspections_ok:\n201\t        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n202\t\n203\t    # 11. one independent review of the frozen actual unit, every page included.\n204\t    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n205\t    review_ok = review is not None\n206\t    if review is not None:\n207\t        payload = candidate_payload(review, \"unit review\")\n208\t        blocking = [\n209\t            entry\n210\t            for entry in payload.get(\"overall_findings\", [])\n211\t            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n212\t        ]\n213\t        for page_entry in payload.get(\"page_findings\", []):\n214\t            if isinstance(page_entry, Mapping):\n215\t                blocking.extend(\n216\t                    entry for entry in page_entry.get(\"findings\", [])\n217\t                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n218\t                )\n219\t        for entry in blocking:\n220\t            owner = repair.owner_for_review_category(entry.get(\"category\"))\n221\t            require(\n222\t                owner is not None,\n223\t                \"invalid_input\",\n224\t                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n225\t                unit_id=unit_id,\n226\t            )\n227\t            findings.append(\n228\t                {\n229\t                    \"check_id\": \"unit_review_finding\",\n230\t                    \"owner\": owner,\n231\t                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n232\t                    \"message\": entry.get(\"description\", \"\"),\n233\t                }\n234\t            )\n235\t        review_ok = not blocking\n236\t    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n237\t    if review is None:\n238\t        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n239\t\n240\t    # 12. complete repair partition, immutable history, and required current retests.\n241\t    unit_repair_requests = [\n242\t        record\n243\t        for record in state.get(\"repair_requests\") or []\n244\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n245\t    ]\n246\t    resolved_keys = {\n247\t        record.get(\"request_key\")\n248\t        for record in state.get(\"retest_results\") or []\n249\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n250\t    }\n251\t    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n252\t    repair_ok = not open_requests\n253\t    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n254\t    if not repair_ok:\n255\t        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n256\t\n257\t    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n258\t    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n259\t    check = check_record(\n260\t        scope=\"unit\",\n261\t        owner=unit_id,\n262\t        head_hash=summary_hash,\n263\