{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gm2ToEJd8rAhk3Pz28mYnT","type":"tool_result","content":"1\t\"\"\"Targeted repair engine: D17-D21 of spec section 6.2 and section 12.\n2\t\n3\tOwns finding classification, one-partition-member repair planning, deterministic\n4\tvs. model routing, boundary-checked admission, and retest dispatch. Shared by the\n5\tunit repair cycle here and reused by the workbook repair cycle N32 builds over\n6\t`repair_requests`-shaped state (spec section 12's boundary/diff/invalidation-DAG\n7\tmachinery is one engine, not a per-caller copy).\n8\t\n9\tNone of this module's functions carry a `NODE_CATALOGUE` row: D16-D23 are not\n10\tregistered as graph nodes yet (that registration is N32's write, once\n11\t`workbook.py` exists to dispatch alongside them), so these are plain, narrowly\n12\tscoped `(state, runtime_context) -> update` callables in the same shape N23's\n13\t`model_nodes.py` uses for D90/D91 -- state-projected by hand, not by\n14\t`nodes.deterministic_node()`. A future registration step binds them to their\n15\tcatalogue rows without changing this module.\n16\t\n17\tEvery finding this engine classifies is normalized to spec section 12's\n18\t`{finding_id, evidence_key, owner, boundary, parent_hash, fingerprint}` shape.\n19\tOwner is never trusted from a model: D08/D09/D12/D14 stamp `owner` themselves\n20\t(code-owned), and a model review's own `category` field is deliberately never\n21\tread as an owner -- `owner_for_review_category()` is the one place a category\n22\tstring is mapped to the five-owner vocabulary, and an unmapped category is a\n23\tsystem fault, not a silent guess.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport json\n29\tfrom collections.abc import Mapping, Sequence\n30\tfrom typing import Any\n31\t\n32\tfrom . import reducers\n33\tfrom .nodes import (\n34\t    SystemFailure,\n35\t    candidate_payload,\n36\t    canonical_digest,\n37\t    latest_model_candidate,\n38\t    require,\n39\t    staged_dispatch,\n40\t    stream_id,\n41\t    worker_packet,\n42\t)\n43\t\n44\t__all__ = [\n45\t    \"REPAIR_OWNERS\",\n46\t    \"CHANNEL_BY_OWNER\",\n47\t    \"MODEL_ONLY_OWNERS\",\n48\t    \"DETERMINISTIC_ONLY_OWNERS\",\n49\t    \"CONDITIONAL_OWNERS\",\n50\t    \"RETEST_FIRST_NODE\",\n51\t    \"RETEST_ORDER_BY_OWNER\",\n52\t    \"MAX_REPAIR_CHILDREN_PER_CHAIN\",\n53\t    \"MAX_FINGERPRINT_REPEATS\",\n54\t    \"DETERMINISTIC_REPAIR_CANDIDATE_KIND\",\n55\t    \"RepairEngineError\",\n56\t    \"owner_for_review_category\",\n57\t    \"normalize_findings\",\n58\t    \"finding_fingerprint\",\n59\t    \"route_owner\",\n60\t    \"json_pointer_diff\",\n61\t    \"within_boundary\",\n62\t    \"D17_CLASSIFY_UNIT_FINDINGS\",\n63\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\",\n64\t    \"D19_ROUTE_UNIT_REPAIR\",\n65\t    \"D20_ADMIT_UNIT_REPAIR\",\n66\t    \"D21_RETEST_REQUIRED_DESCENDANTS\",\n67\t]\n68\t\n69\t\n70\tclass RepairEngineError(SystemFailure):\n71\t    \"\"\"A repair-engine invariant broke. Always a system fault, never a product one.\"\"\"\n72\t\n73\t\n74\t# The exact five-owner vocabulary of spec section 12's table. Nothing outside\n75\t# this set is a legal `owner`; a finding naming anything else fails closed.\n76\tREPAIR_OWNERS: tuple[str, ...] = (\n77\t    \"source interpretation\",\n78\t    \"curriculum domain\",\n79\t    \"unit content\",\n80\t    \"unit visual\",\n81\t    \"unit layout\",\n82\t)\n83\t\n84\t# The artifact-versions channel each owner's repair targets. Source\n85\t# interpretation shares the domain channel: an unsourced or wrongly-cited fact\n86\t# is a pointer inside the same admitted domain body a curriculum-domain defect\n87\t# would touch, differing only in which pointers are named and in dispatch\n88\t# eligibility below.\n89\tCHANNEL_BY_OWNER: Mapping[str, str] = {\n90\t    \"curriculum domain\": \"domain\",\n91\t    \"source interpretation\": \"domain\",\n92\t    \"unit content\": \"content\",\n93\t    \"unit visual\": \"visuals\",\n94\t    \"unit layout\": \"layout\",\n95\t}\n96\t\n97\t# Spec section 12's per-owner repair-behavior column, collapsed to a decidable\n98\t# table. A curriculum-domain or unit-content defect is model-owned outright.\n99\t# Layout has a deterministic renderer/template repair path and no model path in\n100\t# this generation, so it is always deterministic. Source interpretation could"}]},"parent_tool_use_id":"toolu_01A83BcuDzoa7A4Ptyz7sPPU","session_id":"512d45f8-5e59-47de-883c-0e101cf89d49","uuid":"4c124657-6f19-44d4-ad3a-1f6b317ddbee","timestamp":"2026-08-13T00:56:43.297Z","subagent_type":"Explore","task_description":"Verify 8 Plan 26 runtime invariants from source"}
