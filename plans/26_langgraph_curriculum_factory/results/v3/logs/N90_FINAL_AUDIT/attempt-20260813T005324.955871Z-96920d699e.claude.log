{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Pmq6zLVyVJ23FRS7Jwq6t","type":"tool_result","content":"1\t\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n2\t\n3\tThis module owns registration, not node bodies. Every callable it registers is\n4\tresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\n5\tthat is missing, placeholder, test-only, duplicated, or dangling fails the build\n6\tby stable ID rather than compiling into a graph that would look complete.\n7\t\n8\tIt also owns the two things no node body can own:\n9\t\n10\t- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n11\t  records a graceful interrupt observed at the node's atomic boundary, and turns\n12\t  an unexpected exception into a classified `pending_failure` instead of letting\n13\t  an unproven state continue;\n14\t- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n15\t  guard, evidence writer, transport registry, source retriever, signal token and\n16\t  clock, and holds no model client and no routing authority.\n17\t\n18\tScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\n19\tpath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n20\t`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\n21\tmap/reduce, and the workbook branch are registered by N30 and N32 into this same\n22\tbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\n23\tbut not yet wired, so an undeclared unwired node still fails compilation.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport inspect\n30\timport json\n31\timport re\n32\tfrom collections.abc import Callable, Mapping, Sequence\n33\tfrom datetime import datetime, timezone\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom langgraph.errors import GraphBubbleUp\n38\tfrom langgraph.graph import END, START, StateGraph\n39\tfrom langgraph.graph.state import CompiledStateGraph\n40\tfrom langgraph.runtime import Runtime\n41\t\n42\tfrom . import acceptance, routing, transport as tp, unit_graph, workbook\n43\tfrom .artifacts import ArtifactStore\n44\tfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\n45\tfrom .evidence import EvidenceStore\n46\tfrom .model_nodes import (\n47\t    MODEL_BOOKKEEPING_NODES,\n48\t    MODEL_NODE_ADAPTERS,\n49\t    build_model_node_context,\n50\t)\n51\tfrom .nodes import NODE_CATALOGUE, node_registry\n52\tfrom .persistence import InterruptToken, open_checkpoint_saver\n53\tfrom .state import (\n54\t    FACTORY_INPUT_FIELDS,\n55\t    FACTORY_OUTPUT_FIELDS,\n56\t    FACTORY_STATE_FIELDS,\n57\t    FIELD_REDUCER_CLASSES,\n58\t    FactoryInput,\n59\t    FactoryOutput,\n60\t    FactoryState,\n61\t    RuntimeContext,\n62\t)\n63\t\n64\t__all__ = [\n65\t    \"GRAPH_NAME\",\n66\t    \"GraphBindingError\",\n67\t    \"DEFERRED_TOPOLOGY\",\n68\t    \"SKELETON_NORMAL_EDGES\",\n69\t    \"SKELETON_BRANCHES\",\n70\t    \"build_runtime_context\",\n71\t    \"binding_inventory\",\n72\t    \"unit_repair_binding_inventory\",\n73\t    \"full_binding_inventory\",\n74\t    \"validate_bindings\",\n75\t    \"register_skeleton\",\n76\t    \"register_unit_repair_topology\",\n77\t    \"register_workbook_topology\",\n78\t    \"build_curriculum_factory_graph\",\n79\t    \"compiled_topology\",\n80\t    \"graph_digest\",\n81\t    \"contract_digests\",\n82\t]\n83\t\n84\tGRAPH_NAME = \"plan26_curriculum_factory\"\n85\t\n86\t\n87\tclass GraphBindingError(RuntimeError):\n88\t    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n89\t\n90\t\n91\t# Only these modules may supply a production node body. A callable from anywhere\n92\t# else — a test module, a notebook, a locally defined lambda — is rejected by\n93\t# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n94\t# a stand-in\".\n95\tPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n96\t    \"runtime.langgraph_factory.nodes\",\n97\t    \"runtime.langgraph_factory.model_nodes\",\n98\t    \"runtime.langgraph_factory.workbook\",\n99\t    \"runtime.langgraph_factory.repair\",\n100\t    \"runtime.langgraph_factory.acceptance\",\n101\t)\n102\t\n103\tPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n104\t    \"stub\",\n105\t    \"placeholder\",\n106\t    \"fake\",\n107\t    \"dummy\",\n108\t    \"mock\",\n109\t    \"sample\",\n110\t    \"example\",\n111\t    \"todo\",\n112\t    \"noop\",\n113\t    \"test\",\n114\t)\n115\t\n116\tPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n117\t    \"raise NotImplementedError\",\n118\t    \"TODO: implement\",\n119\t    \"placeholder implementation\",\n120\t)\n121\t\n122\t# Registered here, wired by a later graph node. A node that is neither wired by\n123\t# the skeleton/unit-path tables `_validate_topology` inspects nor declared here\n124\t# fails the build: silence about an unwired node is how a topology gap becomes\n125\t# a silent halt at runtime.\n126\t#\n127\t# D16 and D17 need no row: once their bodies are members of `available`, they\n128\t# are reached as real *destinations* of already-wired `unit_graph.UNIT_BRANCHES`\n129\t# sources (D08/D09/D12/D14/D91 -> D17, M05 -> D16 -- the six rows `unit_graph\n130\t# .DEFERRED_EDGES` names), so `_validate_topology`'s own `wired` set already\n131\t# contains them. D18-D23 are reached only from *inside* the unit repair cycle\n132\t# itself (D17 -> D18 -> ... -> D21 -> D16, D22 -> D23 -> D05), which is wired by\n133\t# `acceptance.register_unit_repair_path` (via `register_unit_repair_topology`,\n134\t# called after `register_skeleton` returns) rather than by any table\n135\t# `_validate_topology` reads -- so they are declared deferred here for the same\n136\t# reason M06/M07/M08 are: really wired, by a registration step this function\n137\t# does not itself see.\n138\t#\n139\t# D24 needs no row either, for the same reason D16/D17 do not: it is\n140\t# `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, a row\n141\t# `unit_graph.DEFERRED_EDGES` already names, so once D24 is a member of\n142\t# `available` it is a real destination `unit_graph.branch_destinations`\n143\t# resolves and `_validate_topology`'s `wired` set already contains it. D30 is\n144\t# an N22-owned node already wired as a normal member of `unit_graph\n145\t# .UNIT_BRANCHES`, not part of this node's own D24-D32 engine at all. D25-D29,\n146\t# D31, D32 are reached only from *inside* the workbook branch itself, which is\n147\t# wired by `workbook.register_workbook_path` (via `register_workbook_topology`,\n148\t# called after `register_unit_repair_topology` returns) rather than by any\n149\t# table `_validate_topology` reads -- so they are declared deferred here for\n150\t# the same reason D18-D23 are.\n151\tDEFERRED_TOPOLOGY: Mapping[str, str] = {\n152\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n153\t    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n154\t    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n155\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n156\t    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n157\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n158\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n159\t    \"D25_ASSEMBLE_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n160\t    \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n161\t    \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\": \"N32_WORKBOOK_TERMINALS\",\n162\t    \"D28_REDUCE_WORKBOOK_EVIDENCE\": \"N32_WORKBOOK_TERMINALS\",\n163\t    \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\": \"N32_WORKBOOK_TERMINALS\",\n164\t    \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\": \"N32_WORKBOOK_TERMINALS\",\n165\t    \"D32_RECOMPUTE_FINAL_RELEASE\": \"N32_WORKBOOK_TERMINALS\",\n166\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n167\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n168\t}\n169\t\n170\tSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n171\t    (START, \"D00_BOOTSTRAP_EPISODE\"),\n172\t    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n173\t    (\"D98_WRITE_TERMINAL\", END),\n174\t)\n175\t\n176\tSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n177\t    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n178\t    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n179\t    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n180\t    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n181\t    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n182\t    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n183\t)\n184\t\n185\t\n186\t# --------------------------------------------------------------- runtime context\n187\t\n188\t\n189\tdef _utc_clock() -> str:\n190\t    return datetime.now(timezone.utc).isoformat()\n191\t\n192\t\n193\tdef build_runtime_context(\n194\t    *,\n195\t    engine_root: Path | str,\n196\t    output_root: Path | str,\n197\t    run_id: str,\n198\t    curriculum_digest: str,\n199\t    authorization: Any = None,\n200\t    capability_proof: Mapping[str, Any] | None = None,\n201\t    retrieval_hosts: Sequence[str] = (),\n202\t    clock: Callable[[], Any] = _utc_clock,\n203\t    env_passthrough: Sequence[str] = (),\n204\t) -> RuntimeContext:\n205\t    \"\"\"Open the services one invocation may reach (spec section 5.2).\n206\t\n207\t    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n208\t    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n209\t    inside the builder, because the transport and the authorization it enforces\n210\t    are bound to a run identity that does not exist at build time.\n211\t    \"\"\"\n212\t\n213\t    engine_root = Path(engine_root).resolve()\n214\t    output_root = Path(output_root).resolve()\n215\t    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n216\t    egress_guard = EgressGuard(receipts)\n217\t    return RuntimeContext(\n218\t        engine_root=engine_root,\n219\t        output_root=output_root,\n220\t        path_guard=ArtifactStore(output_root),\n221\t        evidence_service=EvidenceStore(output_root),\n222\t        transport_registry=tp.CliTransport(\n223\t            output_root=output_root,\n224\t            run_id=run_id,\n225\t            curriculum_digest=curriculum_digest,\n226\t            authorization=authorization,\n227\t            receipts=receipts,\n228\t            guard=egress_guard,\n229\t            ledger=tp.AttemptLedger(),\n230\t            capability_proof=capability_proof,\n231\t            env_passthrough=env_passthrough,\n232\t        ),\n233\t        source_retriever=SourceRetriever(\n234\t            guard=egress_guard,\n235\t            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n236\t        ),\n237\t        signal_token=InterruptToken(output_root),\n238\t        clock=clock,\n239\t    )\n240\t\n241\t\n242\t# ----------------------------------------------------------------- node boundary\n243\t\n244\t\n245\tdef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n246\t    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n247\t\n248\t    marked = dict(update)\n249\t    guard = marked.get(\"pending_guard\")\n250\t    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n251\t    guard[\"interrupt_requested\"] = True\n252\t    marked[\"pending_guard\"] = guard\n253\t    return marked\n254\t\n255\t\n256\tdef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n257\t    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n258\t\n259\t    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n260\t    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n261\t    callables take it as an explicit argument precisely so they cannot fetch it\n262\t    themselves.\n263\t    \"\"\"\n264\t\n265\t    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n266\t        context = getattr(runtime, \"context\", None)\n267\t        try:\n268\t            if model_node:\n269\t                update = body(state, build_model_node_context(context))\n270\t            else:\n271\t                update = body(state, context)\n272\t        except GraphBubbleUp:\n273\t            # LangGraph's own control flow (interrupt/resume propagation) is not a\n274\t            # product failure and must reach the engine untouched.\n275\t            raise\n276\t        except Exception as error:  # the classified-failure contract of spec 6.1\n277\t            return {\n278\t                \"pending_failure\": {\n279\t                    \"node\": node_id,\n280\t                    \"class\": \"system\",\n281\t                    \"cause\": \"unhandled\",\n282\t                    \"message\": f\"{type(error).__name__}: {error}\",\n283\t                    \"evidence\": {\"boundary\": \"node\"},\n284\t                },\n285\t                \"pending_guard\": None,\n286\t            }\n287\t        token = getattr(context, \"signal_token\", None)\n288\t        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n289\t            return _mark_interrupt(update, node_id)\n290\t        return dict(update)\n291\t\n292\t    node.__name__ = node_id\n293\t    node.__qualname__ = node_id\n294\t    node.__doc__ = getattr(body, \"__doc__\", None)\n295\t    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n296\t    return node\n297\t\n298\t\n299\tdef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n300\t    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n301\t\n302\t    return getattr(body, \"node_body\", body)\n303\t\n304\t\n305\tdef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n306\t    target = _underlying(body)\n307\t    try:\n308\t        source = inspect.getsource(target)\n309\t    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n310\t        source = \"\"\n311\t    return {\n312\t        \"node_id\": node_id,\n313\t        \"module\": getattr(target, \"__module__\", \"\"),\n314\t        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n315\t        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n316\t        \"source_lines\": len(source.splitlines()),\n317\t    }\n318\t\n319\t\n320\t# ------------------------------------------------------------ binding validation\n321\t\n322\t\n323\tdef binding_inventory() -> dict[str, Callable[..., Any]]:\n324\t    \"\"\"Every node callable N20's own skeleton/unit-path tables resolve against.\n325\t\n326\t    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n327\t    are deliberately absent from *this* function's return value even though\n328\t    they are real, wired members of the compiled production graph: several of\n329\t    N30's own tests in `test_plan26_unit_graph.py` independently recompute\n330\t    their expectation directly from this function's return value, so it stays\n331\t    exactly what it was before N31 (per N90 finding F1's own resolution --\n332\t    `full_binding_inventory()`/`unit_repair_binding_inventory()` below are the\n333\t    functions that widen it; this one never does). Use `unit_repair_binding_\n334\t    inventory()` for the actual widened set `build_curriculum_factory_graph`\n335\t    compiles against.\n336\t\n337\t    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n338\t    likewise absent from *this* function deliberately, not by oversight: D24\n339\t    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n340\t    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n341\t    already-verified tables) declare that edge deferred to N32 by name. If D24\n342\t    entered this function, `unit_graph.register_unit_path`'s *own*\n343\t    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n344\t    silently widen to include it -- correct for a production run, but it\n345\t    would falsify N30's own already-passing topology tests, which independently\n346\t    recompute their expectation from this exact function's return value.\n347\t    `register_workbook_topology` registers the workbook engine as an additive\n348\t    step over its own separate builder (N32 exercises it directly, not through\n349\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n350\t    byte-identical to what they were before N32 and the workbook branch is\n351\t    still fully real -- just not reachable from `D05` in this generation,\n352\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n353\t    \"\"\"\n354\t\n355\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n356\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n357\t        bindings[job_id] = adapter\n358\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n359\t    return bindings\n360\t\n361\t\n362\tdef unit_repair_binding_inventory() -> dict[str, Callable[..., Any]]:\n363\t    \"\"\"`binding_inventory()` plus this node's own D16-D23 unit-repair-cycle bodies.\n364\t\n365\t    The set `build_curriculum_factory_graph` actually compiles the one\n366\t    production graph against (N90 finding F1): D16-D23 become real, reachable\n367\t    members of that graph, while D24-D32 (N32's still-deferred workbook\n368\t    engine) stay absent, exactly as `binding_inventory()`'s own docstring\n369\t    documents for that pair. Kept separate from `binding_inventory()` itself\n370\t    so N30's tests, which recompute their expectation directly from that\n371\t    function's return value, stay unaffected by this widening.\n372\t    \"\"\"\n373\t\n374\t    bindings = dict(binding_inventory())\n375\t    bindings.update(acceptance.UNIT_REPAIR_NODE_BODIES)\n376\t    return bindings\n377\t\n378\t\n379\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n380\t    \"\"\"`unit_repair_binding_inventory()` plus N32's workbook engine (D24-D32).\n381\t\n382\t    The complete node set this generation's node bodies span. Kept separate\n383\t    from `binding_inventory()` itself for the reason documented there.\n384\t    \"\"\"\n385\t\n386\t    bindings = dict(unit_repair_binding_inventory())\n387\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n388\t    return bindings\n389\t\n390\t\n391\tdef _reject(code: str, node_id: str, detail: str) -> None:\n392\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n393\t\n394\t\n395\tdef validate_bindings(\n396\t    bindings: Mapping[str, Callable[..., Any]],\n397\t    *,\n398\t    required: Sequence[str],\n399\t) -> dict[str, dict[str, Any]]:\n400\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n401\t\n402\t    for node_id in required:\n403\t        if node_id not in bindings:\n404\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n405\t\n406\t    seen: dict[tuple[str, str], str] = {}\n407\t    inventory: dict[str, dict[str, Any]] = {}\n408\t    for node_id in sorted(bindings):\n409\t        body = bindings[node_id]\n410\t        if not callable(body):\n411\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n412\t        record = _binding_record(node_id, body)\n413\t        module = record[\"module\"]\n414\t        if not any(\n415\t            module == allowed or module.startswith(f\"{allowed}.\")\n416\t            for allowed in PRODUCTION_BINDING_MODULES\n417\t        ):\n418\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n419\t        lowered = f\"{module}.{record['qualname']}\".lower()\n420\t        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n421\t        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n422\t        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n423\t        # positive on the spec's own vocabulary, not a caught stand-in.\n424\t        marker = next(\n425\t            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n426\t            None,\n427\t        )\n428\t        if marker is not None:\n429\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n430\t        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n431\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n432\t        source = inspect.getsource(_underlying(body))\n433\t        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n434\t        if marker is not None:\n435\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n436\t        identity = (module, record[\"qualname\"])\n437\t        if identity in seen:\n438\t            _reject(\n439\t                \"N20-BIND-DUPLICATE\",\n440\t                node_id,\n441\t                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n442\t            )\n443\t        seen[identity] = node_id\n444\t        inventory[node_id] = record\n445\t    return inventory\n446\t\n447\t\n448\tdef _validate_topology(registered: Sequence[str]) -> None:\n449\t    known = set(registered) | {START, END}\n450\t    wired: set[str] = set()\n451\t    for source, target in SKELETON_NORMAL_EDGES:\n452\t        for endpoint in (source, target):\n453\t            if endpoint not in known:\n454\t                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n455\t        wired.update({source, target})\n456\t    for source, path in SKELETON_BRANCHES:\n457\t        if source not in known:\n458\t            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n459\t        wired.add(source)\n460\t        for target in routing.guard_destinations(source):\n461\t            if target not in known:\n462\t                _reject(\n463\t                    \"N20-EDGE-DANGLING\",\n464\t                    target,\n465\t                    f\"{source} branch {path.__name__} names an unregistered destination\",\n466\t                )\n467\t            wired.add(target)\n468\t    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n469\t        wired.update({source, target})\n470\t    for source, _ in unit_graph.UNIT_BRANCHES:\n471\t        wired.add(source)\n472\t        wired.update(unit_graph.branch_destinations(source, registered))\n473\t    for node_id in registered:\n474\t        if node_id in wired:\n475\t            continue\n476\t        owner = DEFERRED_TOPOLOGY.get(node_id)\n477\t        if owner is None:\n478\t            _reject(\n479\t                \"N20-NODE-UNDECLARED\",\n480\t                node_id,\n481\t                \"is registered but neither wired by the skeleton nor declared deferred\",\n482\t            )\n483\t\n484\t\n485\t# ---------------------------------------------------------------- registration\n486\t\n487\t\n488\tdef register_skeleton(\n489\t    builder: StateGraph,\n490\t    bindings: Mapping[str, Callable[..., Any]],\n491\t) -> dict[str, dict[str, Any]]:\n492\t    \"\"\"Register every available node and the fixed skeleton edges.\n493\t\n494\t    N30 and N32 extend the same builder by adding their own `add_node`-free\n495\t    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n496\t    rewritten by them, so the skeleton stays the one place START, the recovery\n497\t    branch, and the single edge to END are decided.\n498\t    \"\"\"\n499\t\n500\t    routing.assert_guard_table_total(NODE_CATALOGUE)\n501\t    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n502\t    _validate_topology(sorted(bindings))\n503\t\n504\t    for node_id in sorted(bindings):\n505\t        model_node = node_id in MODEL_NODE_ADAPTERS\n506\t        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n507\t\n508\t    for source, target in SKELETON_NORMAL_EDGES:\n509\t        builder.add_edge(source, target)\n510\t\n511\t    for source, path in SKELETON_BRANCHES:\n512\t        destinations = routing.guard_destinations(source)\n513\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n514\t\n515\t    unit_graph.register_unit_path(builder, sorted(bindings))\n516\t\n517\t    return inventory\n518\t\n519\t\n520\tdef register_unit_repair_topology(builder: StateGraph, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n521\t    \"\"\"Wire D16-D23's internal repair/acceptance cycle, additively over `register_skeleton`.\n522\t\n523\t    Called from `build_curriculum_factory_graph` immediately after `register_\n524\t    skeleton` (which has already `add_node`-registered every member of\n525\t    `unit_repair_binding_inventory()`, D16-D23 included) and after `unit_graph\n526\t    .register_unit_path` (run inside `register_skeleton` itself). This closes\n527\t    N90 finding F1 for the six DEFERRED_EDGES rows N31 owns: those six edges\n528\t    are not added here -- they are `unit_graph.py`'s own rows, and resolve\n529\t    automatically the moment D16/D17 are members of the bindings `register_\n530\t    skeleton` receives -- this function adds only the loop internal to D16-D23\n531\t    itself, which no other module owns.\n532\t    \"\"\"\n533\t\n534\t    return acceptance.register_unit_repair_path(builder, available)\n535\t\n536\t\n537\tdef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n538\t    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n539\t\n540\t    Not called by `build_curriculum_factory_graph`: this generation's single\n541\t    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n542\t    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n543\t    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n544\t    this function into whatever the production compile point becomes once the\n545\t    workbook branch is in scope; until then it is exercised directly, over its\n546\t    own builder, the way N32's own topology test already does.\n547\t    `register_skeleton` itself must never see these bindings; this function\n548\t    adds exactly the nodes `register_skeleton` did not, then wires them over\n549\t    the *full* merged node set so `workbook.register_workbook_path` can\n550\t    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n551\t    \"\"\"\n552\t\n553\t    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n554\t    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n555\t    for node_id in sorted(workbook_bindings):\n556\t        if node_id in builder.nodes:\n557\t            # `build_curriculum_factory_graph` now compiles against `full_\n558\t            # binding_inventory()`, so `register_skeleton` has already added\n559\t            # these nodes; only N32's own direct-builder topology test still\n560\t            # calls this function before any `add_node` for D24-D32 exists.\n561\t            continue\n562\t        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n563\t    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n564\t\n565\t\n566\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n567\t    required = {source for source, _ in SKELETON_BRANCHES}\n568\t    for source, target in SKELETON_NORMAL_EDGES:\n569\t        required.update({source, target})\n570\t    for source, _ in SKELETON_BRANCHES:\n571\t        required.update(routing.guard_destinations(source))\n572\t    return tuple(sorted(required - {START, END}))\n573\t\n574\t\n575\tdef build_curriculum_factory_graph(\n576\t    *, engine_root: Path, output_root: Path\n577\t) -> CompiledStateGraph:\n578\t    \"\"\"Build and compile the one production graph (spec section 4).\n579\t\n580\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n581\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n582\t    services are captured at build time, so the compiled object carries no\n583\t    run identity and no authorization.\n584\t\n585\t    Compiles against `full_binding_inventory()`, not `binding_inventory()` or\n586\t    `unit_repair_binding_inventory()`: D16-D23 (N31's unit repair/acceptance\n587\t    cycle) and D24-D32 (N32's workbook engine) are both real, wired members of\n588\t    the one compiled production graph (N90 findings F1 and F2). `register_\n589\t    unit_repair_topology` is called immediately after `register_skeleton` to\n590\t    wire the loop internal to D16-D23 that no other module owns; `register_\n591\t    workbook_topology` is called immediately after that to wire D24-D32's own\n592\t    internal loop additively over the same builder. Once D24-D32's bodies are\n593\t    members of the bindings `register_skeleton` passes to `unit_graph\n594\t    .register_unit_path`, the `(D05_SELECT_NEXT_UNIT, manifest_exhausted) ->\n595\t    D24_PROVE_EXACT_MANIFEST_COVERAGE` row in `unit_graph.DEFERRED_EDGES`\n596\t    resolves automatically, the same way N31's six rows did.\n597\t    \"\"\"\n598\t\n599\t    engine_root = Path(engine_root).resolve()\n600\t    output_root = Path(output_root).resolve()\n601\t    builder: StateGraph = StateGraph(\n602\t        FactoryState,\n603\t        context_schema=RuntimeContext,\n604\t        input_schema=FactoryInput,\n605\t        output_schema=FactoryOutput,\n606\t    )\n607\t    bindings = full_binding_inventory()\n608\t    register_skeleton(builder, bindings)\n609\t    register_unit_repair_topology(builder, sorted(bindings))\n610\t    register_workbook_topology(builder)\n611\t    saver, _connection = open_checkpoint_saver(output_root)\n612\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n613\t\n614\t\n615\t# ---------------------------------------------------------------------- digest\n616\t\n617\t\n618\tdef _canonical_digest(payload: Any) -> str:\n619\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n620\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n621\t\n622\t\n623\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n624\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n625\t\n626\t    drawn = compiled.get_graph()\n627\t    return {\n628\t        \"name\": compiled.name,\n629\t        \"nodes\": sorted(drawn.nodes),\n630\t        \"edges\": sorted(\n631\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n632\t        ),\n633\t    }\n634\t\n635\t\n636\tdef contract_digests() -> dict[str, str]:\n637\t    \"\"\"File digests of every frozen model prompt and output schema.\n638\t\n639\t    Folded into the graph digest so prompt or schema drift is visible as graph\n640\t    drift: the same topology over a changed prompt is not the same graph.\n641\t    \"\"\"\n642\t\n643\t    digests: dict[str, str] = {}\n644\t    registry = tp.load_job_registry()\n645\t    for job_id in sorted(registry):\n646\t        route = registry[job_id]\n647\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n648\t            path = Path(path)\n649\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n650\t    return digests\n651\t\n652\t\n653\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n654\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n655\t\n656\t    Identical real bindings give an identical digest; a changed node body,\n657\t    reducer declaration, prompt, or schema changes it. Python object identity is\n658\t    deliberately not an input, so two builds in one process and two builds in two\n659\t    processes agree.\n660\t    \"\"\"\n661\t\n662\t    payload = {\n663\t        \"topology\": compiled_topology(compiled),\n664\t        \"bindings\": [\n665\t            _binding_record(node_id, body)\n666\t            for node_id, body in sorted(binding_inventory().items())\n667\t        ],\n668\t        \"state\": {\n669\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n670\t            \"input\": list(FACTORY_INPUT_FIELDS),\n671\t            \"output\": list(FACTORY_OUTPUT_FIELDS),\n672\t        },\n673\t        \"contracts\": contract_digests(),\n674\t    }\n675\t    return _canonical_digest(payload)\n676\t"}]},"parent_tool_use_id":"toolu_01A83BcuDzoa7A4Ptyz7sPPU","session_id":"512d45f8-5e59-47de-883c-0e101cf89d49","uuid":"9be38f34-578a-4182-9be5-f91c4ee1b475","timestamp":"2026-08-13T00:55:54.379Z","subagent_type":"Explore","task_description":"Verify 8 Plan 26 runtime invariants from source"}
