{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wem17R1NvxidezR4SgGvrQ","type":"tool_result","content":"1\t\"\"\"The eight model job adapters (spec 6.3) plus D90/D91 attempt bookkeeping.\n2\t\n3\tEach adapter is thin: it proves a D90 reservation exists, materializes exactly one\n4\tauthorized projection from spec section 9's allowlist, invokes the frozen N13\n5\ttransport once, validates the structured candidate against the declared boundary,\n6\tand returns a typed pre-admission state update.\n7\t\n8\tA model node can never admit, merge, route, accept, resume, or terminate. It writes\n9\tonly the candidate channels in ``MODEL_NODE_WRITABLE_FIELDS``; every head, accepted\n10\treceipt, and terminal channel is code-owned by a deterministic node.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport ast\n16\timport copy\n17\timport dataclasses\n18\tfrom collections.abc import Mapping, Sequence\n19\tfrom datetime import datetime, timezone\n20\tfrom pathlib import Path\n21\tfrom typing import Any, Callable\n22\t\n23\timport jsonschema\n24\t\n25\tfrom . import transport as tp\n26\tfrom .reducers import canonical_digest\n27\tfrom .state import RuntimeContext\n28\t\n29\t__all__ = [\n30\t    \"MODEL_NODE_IDS\",\n31\t    \"MODEL_NODE_FAMILIES\",\n32\t    \"MODEL_NODE_ATTEMPT_LIMIT\",\n33\t    \"MODEL_NODE_WRITABLE_FIELDS\",\n34\t    \"FORBIDDEN_MODEL_NODE_FIELDS\",\n35\t    \"ADMISSION_OWNED_CANDIDATE_FIELDS\",\n36\t    \"PROJECTION_SPECS\",\n37\t    \"ProjectionSpec\",\n38\t    \"ModelNodeContext\",\n39\t    \"ModelNodeError\",\n40\t    \"ProjectionViolation\",\n41\t    \"RepairBoundaryViolation\",\n42\t    \"PageDenominatorViolation\",\n43\t    \"CandidateRejected\",\n44\t    \"AttemptNotReserved\",\n45\t    \"FamilyViolation\",\n46\t    \"build_projection\",\n47\t    \"build_model_node_context\",\n48\t    \"build_test_model_node_context\",\n49\t    \"build_model_nodes\",\n50\t    \"reserve_model_attempt\",\n51\t    \"classify_model_failure\",\n52\t    \"MODEL_BOOKKEEPING_NODES\",\n53\t    \"D90_RESERVE_MODEL_ATTEMPT\",\n54\t    \"D91_CLASSIFY_MODEL_FAILURE\",\n55\t    \"m01_research_unit_sources\",\n56\t    \"m01_discover_unit_sources\",\n57\t    \"m01_interpret_unit_sources\",\n58\t    \"m02_create_unit_domain_data\",\n59\t    \"m03_write_unit_content\",\n60\t    \"m04_create_unit_visuals\",\n61\t    \"m05_review_actual_unit\",\n62\t    \"m06_repair_named_unit_artifact\",\n63\t    \"m07_review_actual_workbook\",\n64\t    \"m08_repair_named_workbook_defect\",\n65\t]\n66\t\n67\t\n68\t# --------------------------------------------------------------------------- errors\n69\t\n70\t\n71\tclass ModelNodeError(RuntimeError):\n72\t    \"\"\"A model node boundary was violated. Never retried by this module.\"\"\"\n73\t\n74\t\n75\tclass ProjectionViolation(ModelNodeError):\n76\t    \"\"\"The dispatching deterministic node offered an inadmissible packet.\"\"\"\n77\t\n78\t\n79\tclass RepairBoundaryViolation(ProjectionViolation):\n80\t    \"\"\"A repair packet or candidate reaches outside its one declared boundary.\"\"\"\n81\t\n82\t\n83\tclass PageDenominatorViolation(ProjectionViolation):\n84\t    \"\"\"A review packet or finding set does not match the exact frozen page set.\"\"\"\n85\t\n86\t\n87\tclass CandidateRejected(ModelNodeError):\n88\t    \"\"\"A structured model candidate failed schema, control-field, or scope validation.\"\"\"\n89\t\n90\t\n91\tclass AttemptNotReserved(ModelNodeError):\n92\t    \"\"\"No D90 reservation was committed before this dispatch.\"\"\"\n93\t\n94\t\n95\tclass FamilyViolation(ModelNodeError):\n96\t    \"\"\"A route executed in a family the frozen registry does not authorize.\"\"\"\n97\t\n98\t\n99\t# ------------------------------------------------------------------------ constants\n100\t\n101\tMODEL_NODE_IDS: tuple[str, ...] = (\n102\t    \"M01_RESEARCH_UNIT_SOURCES\",\n103\t    \"M02_CREATE_UNIT_DOMAIN_DATA\",\n104\t    \"M03_WRITE_UNIT_CONTENT\",\n105\t    \"M04_CREATE_UNIT_VISUALS\",\n106\t    \"M05_REVIEW_ACTUAL_UNIT\",\n107\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n108\t    \"M07_REVIEW_ACTUAL_WORKBOOK\",\n109\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\",\n110\t)\n111\t\n112\tMODEL_NODE_FAMILIES: Mapping[str, str] = {\n113\t    \"M01_RESEARCH_UNIT_SOURCES\": tp.AUTHORING_FAMILY,\n114\t    \"M02_CREATE_UNIT_DOMAIN_DATA\": tp.AUTHORING_FAMILY,\n115\t    \"M03_WRITE_UNIT_CONTENT\": tp.AUTHORING_FAMILY,\n116\t    \"M04_CREATE_UNIT_VISUALS\": tp.AUTHORING_FAMILY,\n117\t    \"M05_REVIEW_ACTUAL_UNIT\": tp.REVIEW_FAMILY,\n118\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": tp.AUTHORING_FAMILY,\n119\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": tp.REVIEW_FAMILY,\n120\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": tp.AUTHORING_FAMILY,\n121\t}\n122\t\n123\t# One original activation plus at most one D91-authorized retry, matching the frozen\n124\t# per-route `retry_limit: 1`. D91 may never exceed this.\n125\tMODEL_NODE_ATTEMPT_LIMIT = 2\n126\t\n127\tRESERVATION_KIND = \"model_attempt_reservation\"\n128\t\n129\tMODEL_NODE_WRITABLE_FIELDS: frozenset[str] = frozenset({\n130\t    \"source_discoveries\",\n131\t    \"source_interpretations\",\n132\t    \"artifact_versions\",\n133\t    \"visual_results\",\n134\t    \"unit_reviews\",\n135\t    \"workbook_reviews\",\n136\t    \"workbook_versions\",\n137\t    \"model_execution_receipts\",\n138\t    \"activation_receipts\",\n139\t    \"pending_failure\",\n140\t})\n141\t\n142\tFORBIDDEN_MODEL_NODE_FIELDS: frozenset[str] = frozenset({\n143\t    \"artifact_heads\",\n144\t    \"workbook_head\",\n145\t    \"accepted_unit_receipts\",\n146\t    \"accepted_unit_checkpoint_receipts\",\n147\t    \"terminal\",\n148\t    \"terminal_history\",\n149\t    \"terminal_candidate\",\n150\t    \"unit_status\",\n151\t    \"source_admissions\",\n152\t    \"deterministic_checks\",\n153\t    \"final_release_audits\",\n154\t    \"pending_guard\",\n155\t    \"resume_frontier\",\n156\t    \"cursor\",\n157\t})\n158\t\n159\tADMISSION_OWNED_CANDIDATE_FIELDS: frozenset[str] = frozenset({\n160\t    \"version\", \"hash\", \"parent_hash\",\n161\t})\n162\t\n163\tRESERVE_ATTEMPT_WRITABLE_FIELDS: frozenset[str] = frozenset({\n164\t    \"attempt_counters\", \"activation_receipts\", \"pending_guard\", \"pending_packet\",\n165\t})\n166\t\n167\tCLASSIFY_FAILURE_WRITABLE_FIELDS: frozenset[str] = frozenset({\n168\t    \"failure_fingerprints\", \"pending_failure\", \"pending_guard\", \"terminal_candidate\",\n169\t})\n170\t\n171\t# Transient or malformed transport outcomes: the only class D91 may send back to D90.\n172\tRETRYABLE_FAILURE_CLASSES: frozenset[str] = frozenset({\n173\t    \"empty_result\",\n174\t    \"fenced_result\",\n175\t    \"malformed_json\",\n176\t    \"trailing_material\",\n177\t    \"result_is_not_an_object\",\n178\t    \"duplicate_json_key\",\n179\t    \"non_finite_json_constant\",\n180\t    \"envelope_carries_no_response\",\n181\t    \"schema_invalid_result\",\n182\t    \"m01_must_emit_exactly_one_phase_key\",\n183\t    \"timeout\",\n184\t    \"nonzero_exit\",\n185\t    # An activation D92 found with no execution receipt: nobody observed its\n186\t    # outcome, so it is transient by construction and a later attempt must still\n187\t    # pass D90 (spec 6.2 D92, section 11.3).\n188\t    \"aborted_activation\",\n189\t})\n190\t\n191\t# Content the model actually produced but that violates its declared scope. These are\n192\t# repaired through the targeted-repair engine; re-running the same transport call\n193\t# would only reproduce them.\n194\tPOLICY_OR_CONTENT_FAILURE_CLASSES: frozenset[str] = frozenset({\n195\t    \"candidate_control_field\",\n196\t    \"candidate_undeclared_artifact\",\n197\t    \"candidate_boundary_violation\",\n198\t    \"candidate_page_denominator\",\n199\t    \"candidate_authoritative_visual\",\n200\t    \"policy_refusal\",\n201\t    \"content_violation\",\n202\t})\n203\t\n204\t# Integrity faults. Never retried, never repaired: they become a system terminal.\n205\tSYSTEM_FAILURE_CLASSES: frozenset[str] = frozenset({\n206\t    \"IdentityMismatch\",\n207\t    \"IdentityUnobservable\",\n208\t    \"RouteRejected\",\n209\t    \"CapabilityProofFailed\",\n210\t    \"WorkspaceViolation\",\n211\t    \"AttemptLimitExceeded\",\n212\t    \"AuthorizationDenied\",\n213\t    \"family_violation\",\n214\t})\n215\t\n216\t# A model brief that would invent an authoritative circuit/pin/electrical fact is\n217\t# never eligible for M04; a deterministic producer owns those (spec 9, section 13).\n218\tAUTHORITATIVE_VISUAL_CLASSES: frozenset[str] = frozenset({\n219\t    \"circuit\", \"schematic\", \"netlist\", \"pinout\", \"pin_map\", \"breadboard\",\n220\t    \"wiring\", \"electrical\", \"power_path\", \"terminal_block\",\n221\t})\n222\t\n223\tWORKBOOK_OWNED_COMPONENTS: frozenset[str] = frozenset({\n224\t    \"front_matter\", \"navigation\", \"layout\", \"assembly\",\n225\t})\n226\t\n227\t# Persisted state channels and verdict hints that may never enter any projection.\n228\tDENIED_PROJECTION_NAMES: frozenset[str] = frozenset({\n229\t    \"artifact_heads\", \"workbook_head\", \"accepted_unit_receipts\",\n230\t    \"accepted_unit_checkpoint_receipts\", \"terminal\", \"terminal_history\",\n231\t    \"terminal_candidate\", \"route_decisions\", \"pending_guard\", \"pending_failure\",\n232\t    \"resume_frontier\", \"resume_from\", \"attempt_counters\", \"failure_fingerprints\",\n233\t    \"unit_reviews\", \"workbook_reviews\", \"review_packets\", \"workbook_review_packets\",\n234\t    \"repair_requests\", \"workbook_repair_requests\", \"retest_plans\", \"retest_results\",\n235\t    \"workbook_retests\", \"invalidations\", \"workbook_invalidations\",\n236\t    \"finding_partitions\", \"workbook_finding_partitions\", \"unit_status\", \"cursor\",\n237\t    \"model_execution_receipts\", \"activation_receipts\", \"capability_receipts\",\n238\t    \"checkpoint_metadata\", \"final_release_audits\", \"evidence_index_entries\",\n239\t    \"log_audit_receipts\", \"external_authorizations\", \"source_admissions\",\n240\t    \"deterministic_checks\", \"output_root\", \"engine_root\", \"curriculum_root\",\n241\t    \"active_manifest_path\", \"frozen_inputs\", \"effective_run\", \"invocation\",\n242\t    \"desired_verdict\", \"expected_verdict\", \"target_verdict\", \"author_history\",\n243\t    \"repair_history\", \"reviewer_history\", \"sibling_units\", \"full_state\", \"state\",\n244\t})\n245\t\n246\t# Additional names a review job may never see: anything that hints at the wanted\n247\t# outcome, or that reveals who authored or repaired the artifact under review.\n248\tREVIEW_DENIED_NAMES: frozenset[str] = frozenset({\n249\t    \"verdict\", \"prior_findings\", \"previous_findings\", \"prompt\", \"prompts\",\n250\t    \"model_output\", \"model_outputs\", \"job_outputs\", \"author_notes\", \"authored_by\",\n251\t    \"attempt\", \"attempts\", \"attempt_count\", \"counter\", \"counters\", \"retry_count\",\n252\t})\n253\t\n254\t\n255\t# ------------------------------------------------------------------- projection table\n256\t\n257\t\n258\t@dataclasses.dataclass(frozen=True)\n259\tclass ProjectionSpec:\n260\t    \"\"\"One row of spec section 9's context table, materialized as code.\"\"\"\n261\t\n262\t    name: str\n263\t    job_id: str\n264\t    family: str\n265\t    allowed: tuple[str, ...]\n266\t    required: tuple[str, ...]\n267\t    denied: frozenset[str]\n268\t    excluded_doc: str\n269\t\n270\t    @property\n271\t    def is_review(self) -> bool:\n272\t        return self.family == tp.REVIEW_FAMILY\n273\t\n274\t\n275\tdef _spec(\n276\t    name: str,\n277\t    job_id: str,\n278\t    allowed: tuple[str, ...],\n279\t    required: tuple[str, ...],\n280\t    denied: Sequence[str],\n281\t    excluded_doc: str,\n282\t) -> ProjectionSpec:\n283\t    family = MODEL_NODE_FAMILIES[job_id]\n284\t    extra = REVIEW_DENIED_NAMES if family == tp.REVIEW_FAMILY else frozenset()\n285\t    return ProjectionSpec(\n286\t        name=name,\n287\t        job_id=job_id,\n288\t        family=family,\n289\t        allowed=allowed,\n290\t        required=required,\n291\t        denied=DENIED_PROJECTION_NAMES | frozenset(denied) | extra,\n292\t        excluded_doc=excluded_doc,\n293\t    )\n294\t\n295\t\n296\tPROJECTION_SPECS: Mapping[str, ProjectionSpec] = {\n297\t    \"M01_discovery\": _spec(\n298\t        \"M01_discovery\", \"M01_RESEARCH_UNIT_SOURCES\",\n299\t        allowed=(\"request\", \"unit\", \"source_rules\", \"discovery_authority\"),\n300\t        required=(\"request\", \"unit\", \"source_rules\", \"discovery_authority\"),\n301\t        denied=(\"sibling_requests\", \"source_requests\", \"retrievals\", \"retrieval_group\"),\n302\t        excluded_doc=\"sibling requests/units, author history, acceptance, output tree\",\n303\t    ),\n304\t    \"M01_interpretation\": _spec(\n305\t        \"M01_interpretation\", \"M01_RESEARCH_UNIT_SOURCES\",\n306\t        allowed=(\"request\", \"unit\", \"source_rules\", \"retrieval_group\"),\n307\t        required=(\"request\", \"unit\", \"source_rules\", \"retrieval_group\"),\n308\t        denied=(\"discovery_authority\", \"browsing_authority\", \"network_access\",\n309\t                \"repository_access\", \"other_retrieval_groups\"),\n310\t        excluded_doc=\"network/repository access, other retrieval groups, \"\n311\t                     \"routing/acceptance state\",\n312\t    ),\n313\t    \"M02_domain\": _spec(\n314\t        \"M02_domain\", \"M02_CREATE_UNIT_DOMAIN_DATA\",\n315\t        allowed=(\"unit\", \"admitted_sources\", \"domain_schema\", \"domain_config\",\n316\t                 \"verifier_interface\", \"calibration\"),\n317\t        required=(\"unit\", \"admitted_sources\", \"domain_schema\", \"verifier_interface\"),\n318\t        denied=(\"unit_content\", \"content_drafts\", \"sibling_artifacts\"),\n319\t        excluded_doc=\"content drafts, reviews, sibling units, terminals\",\n320\t    ),\n321\t    \"M03_content\": _spec(\n322\t        \"M03_content\", \"M03_WRITE_UNIT_CONTENT\",\n323\t        allowed=(\"unit\", \"admitted_domain\", \"curriculum_contracts\",\n324\t                 \"admitted_evidence_references\"),\n325\t        required=(\"unit\", \"admitted_domain\", \"curriculum_contracts\"),\n326\t        denied=(\"rejected_domain_versions\", \"sibling_artifacts\", \"acceptance_state\"),\n327\t        excluded_doc=\"rejected domain versions, reviewer history, sibling artifacts, \"\n328\t                     \"acceptance state\",\n329\t    ),\n330\t    \"M04_visual\": _spec(\n331\t        \"M04_visual\", \"M04_CREATE_UNIT_VISUALS\",\n332\t        allowed=(\"brief\", \"permitted_facts\", \"visual_contract\"),\n333\t        required=(\"brief\", \"permitted_facts\", \"visual_contract\"),\n334\t        denied=(\"visual_briefs\", \"other_briefs\", \"authoritative_facts\", \"netlist\",\n335\t                \"wiring\", \"schematic\", \"pinout\"),\n336\t        excluded_doc=\"authoritative circuit/pin/electrical invention, other briefs, \"\n337\t                     \"full state\",\n338\t    ),\n339\t    \"M05_unit_review\": _spec(\n340\t        \"M05_unit_review\", \"M05_REVIEW_ACTUAL_UNIT\",\n341\t        allowed=(\"unit_artifacts\", \"unit_pdf\", \"page_inventory\", \"pages\",\n342\t                 \"deterministic_evidence\", \"rubric\"),\n343\t        required=(\"unit_artifacts\", \"unit_pdf\", \"page_inventory\", \"pages\",\n344\t                  \"deterministic_evidence\", \"rubric\"),\n345\t        denied=(\"repair_requests\", \"sibling_artifacts\"),\n346\t        excluded_doc=\"author/repair history, prompts/outputs from M01-M04/M06, counters, \"\n347\t                     \"desired verdict\",\n348\t    ),\n349\t    \"M06_unit_repair\": _spec(\n350\t        \"M06_unit_repair\", \"M06_REPAIR_NAMED_UNIT_ARTIFACT\",\n351\t        allowed=(\"owner\", \"findings\", \"parent\", \"boundary\", \"allowed_facts\",\n352\t                 \"invalidated_descendants\", \"retest_order\"),\n353\t        required=(\"owner\", \"findings\", \"parent\", \"boundary\"),\n354\t        denied=(\"unrelated_findings\", \"accepted_bytes\", \"sibling_units\", \"routing\"),\n355\t        excluded_doc=\"unrelated findings/artifacts, accepted bytes, sibling units, \"\n356\t                     \"routing/terminal state\",\n357\t    ),\n358\t    \"M07_workbook_review\": _spec(\n359\t        \"M07_workbook_review\", \"M07_REVIEW_ACTUAL_WORKBOOK\",\n360\t        allowed=(\"coverage_map\", \"accepted_unit_hashes\", \"workbook_pdf\",\n361\t                 \"page_inventory\", \"pages\", \"deterministic_evidence\", \"rubric\"),\n362\t        required=(\"coverage_map\", \"accepted_unit_hashes\", \"workbook_pdf\",\n363\t                  \"page_inventory\", \"pages\", \"deterministic_evidence\", \"rubric\"),\n364\t        denied=(\"mutable_unit_sources\", \"unit_sources\", \"repair_requests\"),\n365\t        excluded_doc=\"author and unit repair history, desired verdict, mutable unit sources\",\n366\t    ),\n367\t    \"M08_workbook_repair\": _spec(\n368\t        \"M08_workbook_repair\", \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\",\n369\t        allowed=(\"defect\", \"parent\", \"allowed_files\", \"accepted_unit_hashes\",\n370\t                 \"workbook_pdf_hash\", \"invalidated_descendants\", \"retest_order\"),\n371\t        required=(\"defect\", \"parent\", \"allowed_files\", \"accepted_unit_hashes\"),\n372\t        denied=(\"unit_content\", \"unit_domain\", \"unit_visual_sources\", \"other_defects\",\n373\t                \"acceptance_state\"),\n374\t        excluded_doc=\"unit content/domain/visual sources, unrelated workbook defects, \"\n375\t                     \"acceptance/terminal authority\",\n376\t    ),\n377\t}\n378\t\n379\t\n380\t# --------------------------------------------------------------------------- helpers\n381\t\n382\t\n383\tdef _utc_now() -> str:\n384\t    return datetime.now(timezone.utc).isoformat()\n385\t\n386\t\n387\tdef _require_mapping(value: Any, label: str) -> Mapping[str, Any]:\n388\t    if not isinstance(value, Mapping):\n389\t        raise ProjectionViolation(f\"{label} must be a mapping, got {type(value).__name__}\")\n390\t    return value\n391\t\n392\t\n393\tdef _collect_keys(value: Any) -> set[str]:\n394\t    keys: set[str] = set()\n395\t    if isinstance(value, Mapping):\n396\t        keys.update(str(key) for key in value)\n397\t        for item in value.values():\n398\t            keys |= _collect_keys(item)\n399\t    elif isinstance(value, (list, tuple)):\n400\t        for item in value:\n401\t            keys |= _collect_keys(item)\n402\t    return keys\n403\t\n404\t\n405\tdef _assert_no_denied_names(projection: Mapping[str, Any], spec: ProjectionSpec) -> None:\n406\t    present = _collect_keys(projection)\n407\t    offending = sorted(name for name in present if name in spec.denied)\n408\t    if offending:\n409\t        raise ProjectionViolation(\n410\t            f\"{spec.name} projection carries structurally excluded fields {offending}; \"\n411\t            f\"spec 9 excludes: {spec.excluded_doc}\")\n412\t\n413\t\n414\tdef build_projection(spec_name: str, packet: Mapping[str, Any]) -> dict[str, Any]:\n415\t    \"\"\"Materialize one projection from its allowlist alone.\n416\t\n417\t    The allowlist is read, never the packet's key set, so handing this function a\n418\t    whole ``FactoryState`` cannot widen the result: unlisted channels are not copied\n419\t    and unreachable, and any excluded name nested inside an allowed value is rejected.\n420\t    \"\"\"\n421\t\n422\t    spec = PROJECTION_SPECS[spec_name]\n423\t    _require_mapping(packet, f\"{spec.name} packet\")\n424\t    missing = [name for name in spec.required\n425\t               if packet.get(name) is None]\n426\t    if missing:\n427\t        raise ProjectionViolation(f\"{spec.name} packet is missing required {missing}\")\n428\t    projection = {name: copy.deepcopy(packet[name])\n429\t                  for name in spec.allowed if packet.get(name) is not None}\n430\t    _assert_no_denied_names(projection, spec)\n431\t    tp.assert_no_authoritative_fields(projection, label=f\"{spec.name} projection\")\n432\t    return projection\n433\t\n434\t\n435\tdef _resolve_reservation(packet: Mapping[str, Any], *, job_id: str) -> Mapping[str, Any]:\n436\t    reservation = packet.get(\"reservation\")\n437\t    if not isinstance(reservation, Mapping):\n438\t        raise AttemptNotReserved(\n439\t            f\"{job_id}: no D90 reservation in the packet; D90_RESERVE_MODEL_ATTEMPT must \"\n440\t            f\"commit a counter before any dispatch\")\n441\t    if reservation.get(\"reservation_kind\") != RESERVATION_KIND:\n442\t        raise AttemptNotReserved(f\"{job_id}: reservation is not a {RESERVATION_KIND}\")\n443\t    if reservation.get(\"job_id\") != job_id:\n444\t        raise AttemptNotReserved(\n445\t            f\"{job_id}: reservation was minted for {reservation.get('job_id')!r}\")\n446\t    ordinal = reservation.get(\"attempt_ordinal\")\n447\t    if not isinstance(ordinal, int) or isinstance(ordinal, bool) or not 1 <= ordinal:\n448\t        raise AttemptNotReserved(f\"{job_id}: reservation has no positive attempt ordinal\")\n449\t    if ordinal > MODEL_NODE_ATTEMPT_LIMIT:\n450\t        raise AttemptNotReserved(\n451\t            f\"{job_id}: attempt {ordinal} exceeds the frozen limit \"\n452\t            f\"{MODEL_NODE_ATTEMPT_LIMIT}\")\n453\t    for field in (\"activation_id\", \"reservation_id\"):\n454\t        if not isinstance(reservation.get(field), str) or not reservation[field]:\n455\t            raise AttemptNotReserved(f\"{job_id}: reservation is missing {field}\")\n456\t    return reservation\n457\t\n458\t\n459\tdef _resolve_correlation(packet: Mapping[str, Any], *, job_id: str,\n460\t                         needs_key: bool) -> Mapping[str, Any]:\n461\t    correlation = _require_mapping(packet.get(\"correlation\"), f\"{job_id} correlation\")\n462\t    for field in (\"run_id\", \"episode_id\"):\n463\t        if not isinstance(correlation.get(field), str) or not correlation[field]:\n464\t            raise ProjectionViolation(f\"{job_id}: correlation is missing {field}\")\n465\t    if needs_key and (not isinstance(correlation.get(\"correlation_key\"), str)\n466\t                      or not correlation[\"correlation_key\"]):\n467\t        raise ProjectionViolation(\n468\t            f\"{job_id}: a fan-out job requires a code-computed correlation_key\")\n469\t    return correlation\n470\t\n471\t\n472\tdef _staged_inputs(packet: Mapping[str, Any], projection: Mapping[str, Any],\n473\t                   *, job_id: str) -> tuple[tp.StagedInput, ...]:\n474\t    declared = packet.get(\"staged_inputs\") or ()\n475\t    if not isinstance(declared, Sequence) or isinstance(declared, (str, bytes)):\n476\t        raise ProjectionViolation(f\"{job_id}: staged_inputs must be a sequence\")\n477\t    referenced = _collect_values(projection)\n478\t    staged: list[tp.StagedInput] = []\n479\t    for item in declared:\n480\t        record = _require_mapping(item, f\"{job_id} staged input\")\n481\t        name = record.get(\"name\")\n482\t        if not isinstance(name, str) or not name:\n483\t            raise ProjectionViolation(f\"{job_id}: staged input has no name\")\n484\t        if name not in referenced:\n485\t            raise ProjectionViolation(\n486\t                f\"{job_id}: staged input {name!r} is not declared by the projection\")\n487\t        staged.append(tp.StagedInput(name=name,\n488\t                                     source_path=Path(str(record[\"source_path\"])),\n489\t                                     sha256=str(record[\"sha256\"])))\n490\t    return tuple(staged)\n491\t\n492\t\n493\tdef _collect_values(value: Any) -> set[str]:\n494\t    found: set[str] = set()\n495\t    if isinstance(value, Mapping):\n496\t        for item in value.values():\n497\t            found |= _collect_values(item)\n498\t    elif isinstance(value, (list, tuple)):\n499\t        for item in value:\n500\t            found |= _collect_values(item)\n501\t    elif isinstance(value, str):\n502\t        found.add(value)\n503\t    return found\n504\t\n505\t\n506\t# ------------------------------------------------------------- candidate validation\n507\t\n508\t\n509\tdef _schema_for(route: tp.JobRoute) -> dict[str, Any]:\n510\t    return tp.load_output_schema(route)\n511\t\n512\t\n513\tdef _resolve_ref(schema: Mapping[str, Any], root: Mapping[str, Any]) -> Mapping[str, Any]:\n514\t    ref = schema.get(\"$ref\")\n515\t    if not isinstance(ref, str) or not ref.startswith(\"#/\"):\n516\t        return schema\n517\t    node: Any = root\n518\t    for part in ref[2:].split(\"/\"):\n519\t        node = node[part]\n520\t    return node\n521\t\n522\t\n523\tdef _assert_closed(value: Any, schema: Mapping[str, Any], root: Mapping[str, Any],\n524\t                   *, path: str, label: str) -> None:\n525\t    \"\"\"Enforce closed-object semantics even where a schema leaves an object open.\n526\t\n527\t    N13's schemas already declare ``additionalProperties: false`` at every level but\n528\t    one (``M02.domain_version.fields``, which is intentionally free-form). Rather than\n529\t    trust that, every object in a candidate is checked here before it can reach state.\n530\t    \"\"\"\n531\t\n532\t    schema = _resolve_ref(schema, root)\n533\t    if isinstance(value, Mapping):\n534\t        properties = schema.get(\"properties\")\n535\t        if isinstance(properties, Mapping):\n536\t            undeclared = sorted(set(map(str, value)) - set(map(str, properties)))\n537\t            if undeclared:\n538\t                raise CandidateRejected(\n539\t                    f\"{label}: undeclared properties {undeclared} at {path}\")\n540\t            for key, item in value.items():\n541\t                subschema = properties.get(key)\n542\t                if isinstance(subschema, Mapping):\n543\t                    _assert_closed(item, subschema, root, path=f\"{path}/{key}\", label=label)\n544\t        else:\n545\t            tp.assert_no_authoritative_fields(value, label=f\"{label} at {path}\")\n546\t    elif isinstance(value, list):\n547\t        items = schema.get(\"items\")\n548\t        if isinstance(items, Mapping):\n549\t            for index, item in enumerate(value):\n550\t                _assert_closed(item, items, root, path=f\"{path}[{index}]\", label=label)\n551\t\n552\t\n553\tCANDIDATE_VALIDATION_ERRORS = (jsonschema.ValidationError, tp.TransportError,\n554\t                               CandidateRejected)\n555\t\n556\t\n557\tdef _validate_candidate_shape(candidate: Mapping[str, Any], route: tp.JobRoute) -> None:\n558\t    schema = _schema_for(route)\n559\t    jsonschema.Draft202012Validator(schema).validate(dict(candidate))\n560\t    tp.assert_no_authoritative_fields(candidate, label=f\"{route.job_id} candidate\")\n561\t    _assert_closed(candidate, schema, schema, path=\"$\", label=f\"{route.job_id} candidate\")\n562\t\n563\t\n564\tdef _assert_subset(actual: Sequence[str], declared: Sequence[str], *, label: str,\n565\t                   error: type[ModelNodeError]) -> None:\n566\t    extra = sorted(set(actual) - set(declared))\n567\t    if extra:\n568\t        raise error(f\"{label}: undeclared {extra}; declared {sorted(set(declared))}\")\n569\t\n570\t\n571\tdef _page_denominator(projection: Mapping[str, Any], *, label: str) -> dict[int, str]:\n572\t    inventory = _require_mapping(projection.get(\"page_inventory\"), f\"{label} page_inventory\")\n573\t    count = inventory.get(\"page_count\")\n574\t    if not isinstance(count, int) or isinstance(count, bool) or count < 1:\n575\t        raise PageDenominatorViolation(f\"{label}: page_count must be a positive integer\")\n576\t    declared: dict[int, str] = {}\n577\t    entries = inventory.get(\"pages\")\n578\t    if not isinstance(entries, list) or not entries:\n579\t        raise PageDenominatorViolation(f\"{label}: page_inventory.pages is empty\")\n580\t    for entry in entries:\n581\t        record = _require_mapping(entry, f\"{label} page entry\")\n582\t        number = record.get(\"page_number\")\n583\t        digest = record.get(\"page_sha256\")\n584\t        if not isinstance(number, int) or isinstance(number, bool):\n585\t            raise PageDenominatorViolation(f\"{label}: page_number must be an integer\")\n586\t        if number in declared:\n587\t            raise PageDenominatorViolation(f\"{label}: duplicate page {number}\")\n588\t        if not isinstance(digest, str) or len(digest) != 64:\n589\t            raise PageDenominatorViolation(f\"{label}: page {number} has no sha256\")\n590\t        declared[number] = digest\n591\t    expected = set(range(1, count + 1))\n592\t    if set(declared) != expected:\n593\t        raise PageDenominatorViolation(\n594\t            f\"{label}: inventory covers {sorted(declared)}, denominator is \"\n595\t            f\"{sorted(expected)}\")\n596\t    supplied = projection.get(\"pages\")\n597\t    if not isinstance(supplied, list):\n598\t        raise PageDenominatorViolation(f\"{label}: pages must be a list\")\n599\t    seen: dict[int, str] = {}\n600\t    for entry in supplied:\n601\t        record = _require_mapping(entry, f\"{label} page image\")\n602\t        number = record.get(\"page_number\")\n603\t        digest = record.get(\"page_sha256\")\n604\t        if number in seen:\n605\t            raise PageDenominatorViolation(f\"{label}: duplicate page image {number}\")\n606\t        if number not in declared:\n607\t            raise PageDenominatorViolation(f\"{label}: page image {number} is not in the denominator\")\n608\t        if digest != declared[number]:\n609\t            raise PageDenominatorViolation(f\"{label}: page {number} image hash differs from inventory\")\n610\t        seen[number] = str(digest)\n611\t    if set(seen) != expected:\n612\t        raise PageDenominatorViolation(\n613\t            f\"{label}: page images cover {sorted(seen)}, denominator is {sorted(expected)}\")\n614\t    return declared\n615\t\n616\t\n617\tdef _assert_findings_cover_pages(candidate: Mapping[str, Any], denominator: Mapping[int, str],\n618\t                                 *, label: str) -> None:\n619\t    seen: set[int] = set()\n620\t    for entry in candidate.get(\"page_findings\", []):\n621\t        number = entry.get(\"page_number\")\n622\t        if number in seen:\n623\t            raise CandidateRejected(f\"{label}: duplicate page finding for page {number}\")\n624\t        if number not in denominator:\n625\t            raise CandidateRejected(f\"{label}: finding for undeclared page {number}\")\n626\t        if entry.get(\"page_sha256\") != denominator[number]:\n627\t            raise CandidateRejected(f\"{label}: page {number} finding cites the wrong page hash\")\n628\t        seen.add(int(number))\n629\t    if seen != set(denominator):\n630\t        missing = sorted(set(denominator) - seen)\n631\t        raise CandidateRejected(f\"{label}: no finding result for pages {missing}\")\n632\t\n633\t\n634\tdef _assert_visual_brief_eligible(brief: Mapping[str, Any]) -> None:\n635\t    if brief.get(\"authoritative\") is True:\n636\t        raise ProjectionViolation(\n637\t            \"M04: an authoritative brief is produced deterministically, never by a model\")\n638\t    klass = str(brief.get(\"visual_class\", \"\")).lower()\n639\t    if klass in AUTHORITATIVE_VISUAL_CLASSES:\n640\t        raise ProjectionViolation(\n641\t            f\"M04: visual_class {klass!r} asserts authoritative circuit/pin/electrical \"\n642\t            f\"detail and is not model-eligible\")\n643\t    if brief.get(\"eligibility\") != \"model_eligible\":\n644\t        raise ProjectionViolation(\"M04: brief is not marked model_eligible\")\n645\t\n646\t\n647\t# ---------------------------------------------------------------------------- context\n648\t\n649\t\n650\t@dataclasses.dataclass(frozen=True)\n651\tclass ModelNodeContext:\n652\t    \"\"\"Everything a model adapter may reach. No state, no routing, no head authority.\"\"\"\n653\t\n654\t    transport: Any\n655\t    registry: Mapping[str, tp.JobRoute]\n656\t\n657\t\n658\tdef _assert_production_transport(transport: Any) -> None:\n659\t    \"\"\"Production adapters accept the real contained transport and nothing else.\"\"\"\n660\t\n661\t    if isinstance(transport, tp.FakeCliTransport):\n662\t        raise ModelNodeError(\n663\t            \"a fake transport is only injectable through build_test_model_node_context\")\n664\t    if not isinstance(transport, tp.CliTransport):\n665\t        raise ModelNodeError(\n666\t            f\"production model nodes require transport.CliTransport, got \"\n667\t            f\"{type(transport).__name__}\")\n668\t\n669\t\n670\tdef build_model_node_context(context: RuntimeContext, *,\n671\t                             registry: Mapping[str, tp.JobRoute] | None = None,\n672\t                             ) -> ModelNodeContext:\n673\t    \"\"\"The one production construction path. It can only bind the real transport.\"\"\"\n674\t\n675\t    transport = context.transport_registry\n676\t    _assert_production_transport(transport)\n677\t    return ModelNodeContext(\n678\t        transport=transport,\n679\t        registry=registry if registry is not None else tp.load_job_registry(),\n680\t    )\n681\t\n682\t\n683\tdef build_test_model_node_context(*, sandbox_root: Path | str,\n684\t                                  responses: Mapping[str, Mapping[str, Any]],\n685\t                                  registry: Mapping[str, tp.JobRoute] | None = None,\n686\t                                  ) -> ModelNodeContext:\n687\t    \"\"\"Test-only graph build. Named explicitly so no production path can select it.\"\"\"\n688\t\n689\t    routes = registry if registry is not None else tp.load_job_registry()\n690\t    return ModelNodeContext(\n691\t        transport=tp.FakeCliTransport(sandbox_root=sandbox_root, responses=responses,\n692\t                                      registry=routes),\n693\t        registry=routes,\n694\t    )\n695\t\n696\t\n697\t# ---------------------------------------------------------------- D90 / D91 bookkeeping\n698\t\n699\t\n700\tdef attempt_counter_key(job_id: str, correlation_key: str,\n701\t                        phase: str | None = None) -> str:\n702\t    \"\"\"The counter one attempt budget is spent against.\n703\t\n704\t    The phase widens the key without touching `correlation_key` itself: M01's\n705\t    discovery and interpretation activations must keep the same correlation key,\n706\t    because D06B indexes `source_discoveries` and D07 indexes\n707\t    `source_interpretations` by it, but they are two independent activations and\n708\t    each owns its own retry budget.\n709\t    \"\"\"\n710\t\n711\t    if phase:\n712\t        return f\"{job_id}|{phase}|{correlation_key}\"\n713\t    return f\"{job_id}|{correlation_key}\"\n714\t\n715\t\n716\tdef reserve_model_attempt(\n717\t    state: Mapping[str, Any],\n718\t    *,\n719\t    job_id: str,\n720\t    correlation_key: str,\n721\t    activation_id: str,\n722\t    phase: str | None = None,\n723\t    limit: int = MODEL_NODE_ATTEMPT_LIMIT,\n724\t    fingerprints: Sequence[Mapping[str, Any]] = (),\n725\t    clock: Callable[[], str] = _utc_now,\n726\t) -> dict[str, Any]:\n727\t    \"\"\"D90: commit the counter increment before the transport call exists.\n728\t\n729\t    The increment is returned as a ``monotonic_max`` update, so an attempt that never\n730\t    returns still leaves a durable reservation and the bound stays enforceable.\n731\t    \"\"\"\n732\t\n733\t    if job_id not in MODEL_NODE_FAMILIES:\n734\t        raise ModelNodeError(f\"D90: {job_id!r} is not one of the eight model jobs\")\n735\t    counters = state.get(\"attempt_counters\") or {}\n736\t    key = attempt_counter_key(job_id, correlation_key, phase)\n737\t    current = int(counters.get(key, 0))\n738\t    now = clock()\n739\t    if current >= limit:\n740\t        return {\n741\t            \"attempt_counters\": {key: current},\n742\t            \"pending_guard\": {\n743\t                \"kind\": \"model_attempt\",\n744\t                \"decision\": \"exhausted\",\n745\t                \"job_id\": job_id,\n746\t                \"counter_key\": key,\n747\t                \"attempts_used\": current,\n748\t                \"limit\": limit,\n749\t                \"fingerprints\": [dict(item) for item in fingerprints],\n750\t                \"reserved_at_utc\": now,\n751\t            },\n752\t        }\n753\t    ordinal = current + 1\n754\t    reservation_id = f\"{activation_id}#{ordinal}\"\n755\t    reservation = {\n756\t        \"reservation_kind\": RESERVATION_KIND,\n757\t        \"reservation_id\": reservation_id,\n758\t        \"activation_id\": activation_id,\n759\t        \"job_id\": job_id,\n760\t        \"counter_key\": key,\n761\t        \"attempt_ordinal\": ordinal,\n762\t        \"limit\": limit,\n763\t        \"reserved_at_utc\": now,\n764\t    }\n765\t    return {\n766\t        \"attempt_counters\": {key: ordinal},\n767\t        \"activation_receipts\": [{\"key\": f\"reservation:{reservation_id}\", **reservation}],\n768\t        \"pending_guard\": {\n769\t            \"kind\": \"model_attempt\",\n770\t            \"decision\": \"authorized\",\n771\t            \"job_id\": job_id,\n772\t            \"counter_key\": key,\n773\t            \"reservation\": reservation,\n774\t        },\n775\t    }\n776\t\n777\t\n778\tdef _repair_destination(job_id: Any) -> str:\n779\t    if job_id in {\"M07_REVIEW_ACTUAL_WORKBOOK\", \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\"}:\n780\t        return \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n781\t    return \"D17_CLASSIFY_UNIT_FINDINGS\"\n782\t\n783\t\n784\tdef classify_model_failure(\n785\t    failure: Mapping[str, Any],\n786\t    *,\n787\t    attempts_used: int,\n788\t    limit: int = MODEL_NODE_ATTEMPT_LIMIT,\n789\t    clock: Callable[[], str] = _utc_now,\n790\t) -> dict[str, Any]:\n791\t    \"\"\"D91: decide retry, repair, exhaustion, or system from one execution failure.\n792\t\n793\t    A retry is authorized only for a malformed/transient transport class that is still\n794\t    inside the frozen limit, and it must go back through D90. Policy and content\n795\t    failures are repaired, never transport-retried; integrity faults are terminal.\n796\t    \"\"\"\n797\t\n798\t    _require_mapping(failure, \"D91 failure\")\n799\t    failure_class = str(failure.get(\"failure_class\") or \"unknown\")\n800\t    job_id = failure.get(\"job_id\")\n801\t    counter_key = failure.get(\"counter_key\")\n802\t    now = clock()\n803\t    fingerprint = (f\"{job_id}|{counter_key}|{failure_class}\")\n804\t\n805\t    if failure_class in SYSTEM_FAILURE_CLASSES:\n806\t        decision, destination, terminal = \"system\", \"D98_WRITE_TERMINAL\", \"SYSTEM_FAILURE\"\n807\t    elif failure_class in POLICY_OR_CONTENT_FAILURE_CLASSES:\n808\t        decision, destination, terminal = \"repair\", _repair_destination(job_id), None\n809\t    elif failure_class in RETRYABLE_FAILURE_CLASSES:\n810\t        if attempts_used < limit:\n811\t            decision, destination, terminal = \"retry\", \"D90_RESERVE_MODEL_ATTEMPT\", None\n812\t        else:\n813\t            decision, destination, terminal = (\n814\t                \"exhausted\", \"D98_WRITE_TERMINAL\", \"CONVERGENCE_EXHAUSTED\")\n815\t    else:\n816\t        decision, destination, terminal = \"system\", \"D98_WRITE_TERMINAL\", \"SYSTEM_FAILURE\"\n817\t\n818\t    update: dict[str, Any] = {\n819\t        \"failure_fingerprints\": [{\n820\t            \"key\": f\"{fingerprint}|{attempts_used}\",\n821\t            \"fingerprint\": fingerprint,\n822\t            \"job_id\": job_id,\n823\t            \"counter_key\": counter_key,\n824\t            \"failure_class\": failure_class,\n825\t            \"attempts_used\": attempts_used,\n826\t            \"limit\": limit,\n827\t            \"classified_at_utc\": now,\n828\t        }],\n829\t        \"pending_failure\": {**dict(failure), \"classification\": decision},\n830\t        \"pending_guard\": {\n831\t            \"kind\": \"model_failure\",\n832\t            \"decision\": decision,\n833\t            \"destination\": destination,\n834\t            # `routing.route_model_failure` resolves the dynamic `repair`\n835\t            # destination out of `detail`, so the same fact is carried where the\n836\t            # guard table reads it.\n837\t            \"detail\": {\"destination\": destination, \"job_id\": job_id,\n838\t                       \"counter_key\": counter_key},\n839\t            \"job_id\": job_id,\n840\t            \"counter_key\": counter_key,\n841\t            \"failure_class\": failure_class,\n842\t            \"attempts_used\": attempts_used,\n843\t            \"limit\": limit,\n844\t        },\n845\t    }\n846\t    if terminal is not None:\n847\t        update[\"terminal_candidate\"] = {\n848\t            \"terminal_kind\": terminal,\n849\t            \"cause\": failure_class,\n850\t            \"job_id\": job_id,\n851\t            \"counter_key\": counter_key,\n852\t            \"fingerprint\": fingerprint,\n853\t            \"proposed_at_utc\": now,\n854\t        }\n855\t    return update\n856\t\n857\t\n858\t# --------------------------------------------------------- D90 / D91 node callables\n859\t\n860\t\n861\tATTEMPT_RESERVATION_NODE = \"D90_RESERVE_MODEL_ATTEMPT\"\n862\tMODEL_FAILURE_NODE = \"D91_CLASSIFY_MODEL_FAILURE\"\n863\t\n864\t\n865\tdef _staged_dispatch(state: Mapping[str, Any]) -> tuple[str, str, list[Mapping[str, Any]]]:\n866\t    \"\"\"The job, the member list key, and the members of the staged dispatch packet.\n867\t\n868\t    The member list key is read back rather than normalized because\n869\t    `routing._staged_fanout` translates whichever of `packets`/`briefs` the\n870\t    dispatching node used, and D90 must restage under the same name.\n871\t    \"\"\"\n872\t\n873\t    packet = state.get(\"pending_packet\")\n874\t    if not isinstance(packet, Mapping):\n875\t        raise ModelNodeError(\n876\t            f\"{ATTEMPT_RESERVATION_NODE}: no `pending_packet` is staged; a reservation \"\n877\t            f\"can only be minted for a dispatch the denominator already committed to\")\n878\t    job_id = packet.get(\"dispatch\")\n879\t    if job_id not in MODEL_NODE_FAMILIES:\n880\t        raise ModelNodeError(\n881\t            f\"{ATTEMPT_RESERVATION_NODE}: staged packet dispatches {job_id!r}, which is \"\n882\t            f\"not one of the eight model jobs\")\n883\t    member_key = \"packets\" if packet.get(\"packets\") is not None else \"briefs\"\n884\t    members = packet.get(member_key)\n885\t    if (not isinstance(members, Sequence) or isinstance(members, (str, bytes))\n886\t            or not members):\n887\t        raise ModelNodeError(\n888\t            f\"{ATTEMPT_RESERVATION_NODE}: staged packet carries no non-empty \"\n889\t            f\"{member_key!r} member list\")\n890\t    return job_id, member_key, [_require_mapping(m, f\"{job_id} member\") for m in members]\n891\t\n892\t\n893\tdef _retry_counter_key(state: Mapping[str, Any]) -> str | None:\n894\t    \"\"\"The one counter key D91 authorized a further attempt for, if it did.\"\"\"\n895\t\n896\t    guard = state.get(\"pending_guard\")\n897\t    if not isinstance(guard, Mapping) or guard.get(\"kind\") != \"model_failure\":\n898\t        return None\n899\t    if guard.get(\"decision\") != \"retry\":\n900\t        return None\n901\t    key = guard.get(\"counter_key\")\n902\t    if not isinstance(key, str) or not key:\n903\t        raise ModelNodeError(\n904\t            f\"{ATTEMPT_RESERVATION_NODE}: a classified retry names no counter key\")\n905\t    return key\n906\t\n907\t\n908\tdef _activation_phase(member: Mapping[str, Any]) -> str | None:\n909\t    \"\"\"The activation kind a staged member declares, if its job has more than one.\n910\t\n911\t    Only M01 dispatches two structurally different activations (`DISCOVER` and\n912\t    `INTERPRET`) under one correlation key, and its dispatchers already stage the\n913\t    distinction; every other job stages no `phase` and keeps an unwidened key.\n914\t    \"\"\"\n915\t\n916\t    phase = member.get(\"phase\")\n917\t    if phase is None:\n918\t        return None\n919\t    if not isinstance(phase, str) or not phase:\n920\t        raise ModelNodeError(\n921\t            f\"{ATTEMPT_RESERVATION_NODE}: staged member declares a non-string phase \"\n922\t            f\"{phase!r}, so its attempt budget could not be keyed\")\n923\t    return phase\n924\t\n925\t\n926\tdef _activation_id(correlation: Mapping[str, Any], *, counter_key: str,\n927\t                   ordinal: int) -> str:\n928\t    \"\"\"One activation identity per attempt, derived so no two attempts share one.\n929\t\n930\t    D92 accounts for an interrupted attempt by matching activation ids against\n931\t    execution receipts, so the ordinal is part of the identity: reusing it across\n932\t    attempts would make an unobserved attempt indistinguishable from an observed one.\n933\t    \"\"\"\n934\t\n935\t    return (f\"{correlation['run_id']}/{correlation['episode_id']}/{counter_key}\"\n936\t            f\"/attempt-{ordinal}\")\n937\t\n938\t\n939\tdef D90_RESERVE_MODEL_ATTEMPT(state: Mapping[str, Any],\n940\t                              context: Any) -> dict[str, Any]:\n941\t    \"\"\"D90: commit one attempt counter per staged dispatch member, before dispatch.\n942\t\n943\t    A map superstep stages N worker projections and each is a separate attempt\n944\t    against its own correlation, so this reserves per member and returns the\n945\t    packet restaged with each member's reservation attached — the fan-out guard\n946\t    then translates exactly what was reserved. A D91-authorized retry names one\n947\t    counter key, and only that member is re-reserved and restaged: the other\n948\t    members' results are already committed and are not re-dispatched.\n949\t\n950\t    Any member at the frozen limit exhausts the whole superstep rather than\n951\t    dispatching a partial map, so the bound can never be crossed by a sibling.\n952\t    \"\"\"\n953\t\n954\t    job_id, member_key, members = _staged_dispatch(state)\n955\t    retry_key = _retry_counter_key(state)\n956\t    counters = state.get(\"attempt_counters\") or {}\n957\t\n958\t    reserved_counters: dict[str, int] = {}\n959\t    receipts: list[dict[str, Any]] = []\n960\t    restaged: list[dict[str, Any]] = []\n961\t    reservations: dict[str, Any] = {}\n962\t    exhausted: list[dict[str, Any]] = []\n963\t\n964\t    for member in members:\n965\t        correlation = _resolve_correlation(member, job_id=job_id, needs_key=True)\n966\t        phase = _activation_phase(member)\n967\t        key = attempt_counter_key(job_id, correlation[\"correlation_key\"], phase)\n968\t        if retry_key is not None and key != retry_key:\n969\t            continue\n970\t        ordinal = int(counters.get(key, 0)) + 1\n971\t        update = reserve_model_attempt(\n972\t            state, job_id=job_id, correlation_key=correlation[\"correlation_key\"],\n973\t            phase=phase,\n974\t            activation_id=_activation_id(correlation, counter_key=key, ordinal=ordinal))\n975\t        guard = update[\"pending_guard\"]\n976\t        reserved_counters.update(update[\"attempt_counters\"])\n977\t        if guard[\"decision\"] == \"exhausted\":\n978\t            exhausted.append({\"counter_key\": key, \"attempts_used\": guard[\"attempts_used\"],\n979\t                              \"limit\": guard[\"limit\"]})\n980\t            continue\n981\t        reservation = guard[\"reservation\"]\n982\t        reservations[key] = reservation\n983\t        receipts.extend(update[\"activation_receipts\"])\n984\t        restaged.append({**member, \"reservation\": reservation})\n985\t\n986\t    if retry_key is not None and not (restaged or exhausted):\n987\t        raise ModelNodeError(\n988\t            f\"{ATTEMPT_RESERVATION_NODE}: classified retry {retry_key!r} matches no \"\n989\t            f\"staged member, so there is nothing to re-dispatch\")\n990\t\n991\t    if exhausted:\n992\t        return {\n993\t            \"attempt_counters\": reserved_counters,\n994\t            \"pending_guard\": {\n995\t                \"node\": ATTEMPT_RESERVATION_NODE,\n996\t                \"value\": \"exhausted\",\n997\t                \"kind\": \"model_attempt\",\n998\t                \"decision\": \"exhausted\",\n999\t                \"detail\": {\"job_id\": job_id, \"exhausted\": exhausted,\n1000\t                           \"limit\": MODEL_NODE_ATTEMPT_LIMIT},\n1001\t            },\n1002\t        }\n1003\t\n1004\t    packet = dict(state[\"pending_packet\"])\n1005\t    packet[member_key] = restaged\n1006\t    return {\n1007\t        \"attempt_counters\": reserved_counters,\n1008\t        \"activation_receipts\": receipts,\n1009\t        \"pending_packet\": packet,\n1010\t        \"pending_guard\": {\n1011\t            \"node\": ATTEMPT_RESERVATION_NODE,\n1012\t            \"value\": \"authorized\",\n1013\t            \"kind\": \"model_attempt\",\n1014\t            \"decision\": \"authorized\",\n1015\t            \"detail\": {\"job_id\": job_id, \"reservations\": reservations,\n1016\t                       \"members\": len(restaged)},\n1017\t        },\n1018\t    }\n1019\t\n1020\t\n1021\tdef _aborted_activation(state: Mapping[str, Any]) -> dict[str, Any]:\n1022\t    \"\"\"The failure record for an activation D92 could not account for.\n1023\t\n1024\t    D92 hands D91 activation ids, not a failure: the reservation receipt is the\n1025\t    only place the job and counter that attempt belongs to still exist.\n1026\t    \"\"\"\n1027\t\n1028\t    guard = state.get(\"pending_guard\")\n1029\t    detail = guard.get(\"detail\") if isinstance(guard, Mapping) else None\n1030\t    activations = detail.get(\"activations\") if isinstance(detail, Mapping) else None\n1031\t    if not isinstance(activations, Sequence) or isinstance(activations, (str, bytes)):\n1032\t        raise ModelNodeError(\n1033\t            f\"{MODEL_FAILURE_NODE}: no model failure and no incomplete activation to \"\n1034\t            f\"classify\")\n1035\t    pending = sorted(str(item) for item in activations)\n1036\t    if not pending:\n1037\t        raise ModelNodeError(f\"{MODEL_FAILURE_NODE}: the incomplete activation list is empty\")\n1038\t    activation_id = pending[0]\n1039\t    reservation = next(\n1040\t        (record for record in (state.get(\"activation_receipts\") or ())\n1041\t         if isinstance(record, Mapping)\n1042\t         and record.get(\"activation_id\") == activation_id\n1043\t         and record.get(\"reservation_kind\") == RESERVATION_KIND),\n1044\t        None)\n1045\t    if reservation is None:\n1046\t        raise ModelNodeError(\n1047\t            f\"{MODEL_FAILURE_NODE}: activation {activation_id!r} has no reservation \"\n1048\t            f\"receipt, so the attempt it belongs to cannot be identified\")\n1049\t    return {\n1050\t        \"job_id\": reservation[\"job_id\"],\n1051\t        \"counter_key\": reservation[\"counter_key\"],\n1052\t        \"activation_id\": activation_id,\n1053\t        \"reservation_id\": reservation[\"reservation_id\"],\n1054\t        \"attempt_ordinal\": reservation[\"attempt_ordinal\"],\n1055\t        \"failure_class\": \"aborted_activation\",\n1056\t        \"detail\": f\"activation {activation_id} has no execution receipt\",\n1057\t        \"unclassified_activations\": pending[1:],\n1058\t    }\n1059\t\n1060\t\n1061\tdef D91_CLASSIFY_MODEL_FAILURE(state: Mapping[str, Any],\n1062\t                               context: Any) -> dict[str, Any]:\n1063\t    \"\"\"D91: classify one model failure, or one activation D92 could not account for.\n1064\t\n1065\t    The attempt count is read from the committed counter rather than from the\n1066\t    failure record, so a retry is authorized against the reservation that is\n1067\t    actually durable. A `retry` clears `pending_failure`: D90 is the next node,\n1068\t    and an uncleared failure would route it to the terminal writer instead.\n1069\t    \"\"\"\n1070\t\n1071\t    failure = state.get(\"pending_failure\")\n1072\t    if not isinstance(failure, Mapping):\n1073\t        failure = _aborted_activation(state)\n1074\t    counter_key = failure.get(\"counter_key\")\n1075\t    counters = state.get(\"attempt_counters\") or {}\n1076\t    attempts_used = int(counters.get(counter_key, failure.get(\"attempt_ordinal\") or 1))\n1077\t    update = classify_model_failure(failure, attempts_used=attempts_used)\n1078\t    if update[\"pending_guard\"][\"decision\"] == \"retry\":\n1079\t        update[\"pending_failure\"] = None\n1080\t    return update\n1081\t\n1082\t\n1083\t# Registrable by stable ID: both are `(state, context) -> update` callables owned\n1084\t# by this module, which is what N20's binding-owner audit requires of a node body.\n1085\tMODEL_BOOKKEEPING_NODES: Mapping[str, Callable[..., dict[str, Any]]] = {\n1086\t    ATTEMPT_RESERVATION_NODE: D90_RESERVE_MODEL_ATTEMPT,\n1087\t    MODEL_FAILURE_NODE: D91_CLASSIFY_MODEL_FAILURE,\n1088\t}\n1089\t\n1090\t\n1091\t# ------------------------------------------------------------------- shared dispatch\n1092\t\n1093\t\n1094\t@dataclasses.dataclass(frozen=True)\n1095\tclass _Dispatch:\n1096\t    spec: ProjectionSpec\n1097\t    route: tp.JobRoute\n1098\t    projection: dict[str, Any]\n1099\t    correlation: Mapping[str, Any]\n1100\t    reservation: Mapping[str, Any]\n1101\t    candidate: dict[str, Any]\n1102\t    receipt: dict[str, Any]\n1103\t    attempts: tuple[dict[str, Any], ...]\n1104\t\n1105\t\n1106\tdef _execution_receipts(dispatch_receipts: Sequence[Mapping[str, Any]], *,\n1107\t                        spec: ProjectionSpec, reservation: Mapping[str, Any],\n1108\t                        correlation: Mapping[str, Any],\n1109\t                        projection_sha256: str) -> list[dict[str, Any]]:\n1110\t    records: list[dict[str, Any]] = []\n1111\t    for index, receipt in enumerate(dispatch_receipts, start=1):\n1112\t        records.append({\n1113\t            \"key\": f\"{reservation['reservation_id']}#{index}\",\n1114\t            \"job_id\": spec.job_id,\n1115\t            \"projection_name\": spec.name,\n1116\t            \"reservation_id\": reservation[\"reservation_id\"],\n1117\t            \"activation_id\": reservation[\"activation_id\"],\n1118\t            \"attempt_ordinal\": reservation[\"attempt_ordinal\"],\n1119\t            \"run_id\": correlation[\"run_id\"],\n1120\t            \"episode_id\": correlation[\"episode_id\"],\n1121\t            \"projection_sha256\": projection_sha256,\n1122\t            \"receipt\": dict(receipt),\n1123\t        })\n1124\t    return records\n1125\t\n1126\t\n1127\tdef _activation_receipt(*, spec: ProjectionSpec, reservation: Mapping[str, Any],\n1128\t                        correlation: Mapping[str, Any], projection_sha256: str,\n1129\t                        candidate_sha256: str | None, executed_family: str | None,\n1130\t                        executed_model: str | None, result: str) -> dict[str, Any]:\n1131\t    return {\n1132\t        \"key\": f\"activation:{reservation['reservation_id']}\",\n1133\t        \"job_id\": spec.job_id,\n1134\t        \"projection_name\": spec.name,\n1135\t        \"reservation_id\": reservation[\"reservation_id\"],\n1136\t        \"activation_id\": reservation[\"activation_id\"],\n1137\t        \"attempt_ordinal\": reservation[\"attempt_ordinal\"],\n1138\t        \"run_id\": correlation[\"run_id\"],\n1139\t        \"episode_id\": correlation[\"episode_id\"],\n1140\t        \"decided_family\": spec.family,\n1141\t        \"executed_family\": executed_family,\n1142\t        \"executed_model\": executed_model,\n1143\t        \"projection_sha256\": projection_sha256,\n1144\t        \"candidate_sha256\": candidate_sha256,\n1145\t        \"result\": result,\n1146\t    }\n1147\t\n1148\t\n1149\tdef _executed_family(receipt: Mapping[str, Any]) -> str | None:\n1150\t    observed = receipt.get(\"observed_family\")\n1151\t    return observed if isinstance(observed, str) and observed else receipt.get(\"decided_family\")\n1152\t\n1153\t\n1154\tdef _failure_update(*, spec: ProjectionSpec, reservation: Mapping[str, Any],\n1155\t                    correlation: Mapping[str, Any], projection_sha256: str,\n1156\t                    failure_class: str, detail: str,\n1157\t                    receipts: Sequence[Mapping[str, Any]]) -> dict[str, Any]:\n1158\t    return {\n1159\t        \"model_execution_receipts\": _execution_receipts(\n1160\t            receipts, spec=spec, reservation=reservation, correlation=correlation,\n1161\t            projection_sha256=projection_sha256),\n1162\t        \"activation_receipts\": [_activation_receipt(\n1163\t            spec=spec, reservation=reservation, correlation=correlation,\n1164\t            projection_sha256=projection_sha256, candidate_sha256=None,\n1165\t            executed_family=None, executed_model=None, result=\"failed\")],\n1166\t        \"pending_failure\": {\n1167\t            \"job_id\": spec.job_id,\n1168\t            \"projection_name\": spec.name,\n1169\t            \"counter_key\": reservation[\"counter_key\"],\n1170\t            \"activation_id\": reservation[\"activation_id\"],\n1171\t            \"reservation_id\": reservation[\"reservation_id\"],\n1172\t            \"attempt_ordinal\": reservation[\"attempt_ordinal\"],\n1173\t            \"failure_class\": failure_class,\n1174\t            \"detail\": detail[:2000],\n1175\t            \"requires_classification_by\": \"D91_CLASSIFY_MODEL_FAILURE\",\n1176\t        },\n1177\t    }\n1178\t\n1179\t\n1180\tdef _dispatch(spec_name: str, packet: Mapping[str, Any], context: ModelNodeContext,\n1181\t              *, needs_correlation_key: bool = False,\n1182\t              ) -> tuple[_Dispatch | None, dict[str, Any] | None]:\n1183\t    \"\"\"The module's only transport call site.\n1184\t\n1185\t    Returning ``(None, failure_update)`` rather than raising keeps a model failure a\n1186\t    routable state fact: D91 classifies it and only D90 may authorize another attempt.\n1187\t    \"\"\"\n1188\t\n1189\t    spec = PROJECTION_SPECS[spec_name]\n1190\t    route = tp.resolve_route(spec.job_id, context.registry)\n1191\t    if route.family != spec.family:\n1192\t        raise FamilyViolation(\n1193\t            f\"{spec.job_id}: frozen registry family {route.family!r} != {spec.family!r}\")\n1194\t    reservation = _resolve_reservation(packet, job_id=spec.job_id)\n1195\t    correlation = _resolve_correlation(packet, job_id=spec.job_id,\n1196\t                                       needs_key=needs_correlation_key)\n1197\t    projection = build_projection(spec_name, packet)\n1198\t    projection_sha256 = canonical_digest(projection)\n1199\t    staged = _staged_inputs(packet, projection, job_id=spec.job_id)\n1200\t\n1201\t    try:\n1202\t        result = context.transport.execute(\n1203\t            job_id=spec.job_id,\n1204\t            activation_id=reservation[\"activation_id\"],\n1205\t            episode_id=correlation[\"episode_id\"],\n1206\t            projection=projection,\n1207\t            staged_inputs=staged,\n1208\t        )\n1209\t    except tp.TransportError as error:\n1210\t        failure_class = getattr(error, \"failure_class\", type(error).__name__)\n1211\t        receipts = [getattr(error, \"receipt\", None) or {\"outcome\": \"transport_failure\"}]\n1212\t        return None, _failure_update(\n1213\t            spec=spec, reservation=reservation, correlation=correlation,\n1214\t            projection_sha256=projection_sha256, failure_class=str(failure_class),\n1215\t            detail=str(error), receipts=receipts)\n1216\t\n1217\t    executed_family = _executed_family(result.receipt)\n1218\t    if spec.is_review and executed_family == tp.AUTHORING_FAMILY:\n1219\t        raise FamilyViolation(\n1220\t            f\"{spec.job_id}: a review executed in the authoring family \"\n1221\t            f\"{tp.AUTHORING_FAMILY!r}\")\n1222\t    if executed_family is not None and executed_family != spec.family:\n1223\t        raise FamilyViolation(\n1224\t            f\"{spec.job_id}: executed family {executed_family!r} != decided {spec.family!r}\")\n1225\t\n1226\t    candidate = dict(result.candidate)\n1227\t    return _Dispatch(spec=spec, route=route, projection=projection,\n1228\t                     correlation=correlation, reservation=reservation,\n1229\t                     candidate=candidate, receipt=dict(result.receipt),\n1230\t                     attempts=tuple(dict(item) for item in result.attempts)), None\n1231\t\n1232\t\n1233\tdef _reject(dispatch: _Dispatch, failure_class: str, detail: str) -> dict[str, Any]:\n1234\t    return _failure_update(\n1235\t        spec=dispatch.spec, reservation=dispatch.reservation,\n1236\t        correlation=dispatch.correlation,\n1237\t        projection_sha256=canonical_digest(dispatch.projection),"}]},"parent_tool_use_id":"toolu_01A83BcuDzoa7A4Ptyz7sPPU","session_id":"512d45f8-5e59-47de-883c-0e101cf89d49","uuid":"28557f6c-ade0-4ff9-a0c5-6d5ac4de0d36","timestamp":"2026-08-13T00:55:58.632Z","subagent_type":"Explore","task_description":"Verify 8 Plan 26 runtime invariants from source"}
