t_id, \"invalid_input\", \"no unit is selected\")\n487\t\n488\t    denominator = None\n489\t    for value in projection[\"source_denominators\"].values():\n490\t        if isinstance(value, dict) and value.get(\"unit_id\") == unit_id:\n491\t            denominator = value\n492\t    require(denominator is not None, \"invalid_input\", f\"no source denominator for {unit_id!r}\")\n493\t\n494\t    expected = set(denominator[\"request_keys\"])\n495\t    retrievals = projection[\"retrievals\"]\n496\t    interpretations = projection[\"source_interpretations\"]\n497\t    requests_by_key = {\n498\t        request.get(\"key\"): request\n499\t        for request in projection[\"source_requests\"]\n500\t        if isinstance(request, dict)\n501\t    }\n502\t\n503\t    # Cross-unit contamination is a join failure, not a filterable condition: a\n504\t    # member keyed to another unit means the fan-out correlation itself is wrong.\n505\t    for label, collection in ((\"retrievals\", retrievals), (\"interpretations\", interpretations)):\n506\t        foreign = sorted(\n507\t            key\n508\t            for key, value in collection.items()\n509\t            if isinstance(value, dict)\n510\t            and candidate_field(value, \"unit_id\") not in (None, unit_id)\n511\t            and key in expected\n512\t        )\n513\t        require(\n514\t            not foreign,\n515\t            \"join\",\n516\t            f\"{label} contain members correlated to another unit\",\n517\t            keys=foreign,\n518\t        )\n519\t\n520\t    interpreted = {key for key in interpretations if key in expected}\n521\t    missing = sorted(expected - interpreted)\n522\t    extra = sorted(\n523\t        key for key in interpretations if key not in expected and _keyed_to(interpretations[key], unit_id)\n524\t    )\n525\t    require(not extra, \"join\", \"interpretations contain members outside the denominator\", keys=extra)\n526\t\n527\t    stale: list[dict[str, Any]] = []\n528\t    for key in s