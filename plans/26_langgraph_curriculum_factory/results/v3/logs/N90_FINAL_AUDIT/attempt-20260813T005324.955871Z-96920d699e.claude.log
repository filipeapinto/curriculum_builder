elf, event: str, **fields: Any) -> dict[str, Any]:\n94\t        record = {\n95\t            \"schema_version\": 1,\n96\t            \"event_id\": new_id(\"event\"),\n97\t            \"occurred_at\": utc_now(),\n98\t            \"event\": event,\n99\t            **fields,\n100\t        }\n101\t        payload = (json.dumps(record, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()\n102\t        self.path.parent.mkdir(parents=True, exist_ok=True)\n103\t        descriptor = os.open(self.path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)\n104\t        try:\n105\t            os.write(descriptor, payload)\n106\t            os.fsync(descriptor)\n107\t        finally:\n108\t            os.close(descriptor)\n109\t        return record\n110\t\n111\t\n112\tdef terminate_active_processes(signum: int, _frame: Any) -> None:\n113\t    \"\"\"Do not orphan nested Claude/test processes when the controller stops.\"\"\"\n114\t\n115\t    with ACTIVE_PROCESSES_LOCK:\n116\t        processes = list(ACTIVE_PROCESSES)\n117\t    for process in processes:\n118\t        if process.poll() is not None:\n119\t            continue\n120\t        try:\n121\t            os.killpg(process.pid, signal.SIGTERM)\n122\t        except ProcessLookupError:\n123\t            pass\n124\t    deadline = time.monotonic() + 5\n125\t    while time.monotonic() < deadline and any(process.poll() is None for process in processes):\n126\t        time.sleep(0.05)\n127\t    for process in processes:\n128\t        if process.poll() is None:\n129\t            try:\n130\t                os.killpg(process.pid, signal.SIGKILL)\n131\t            except ProcessLookupError:\n132\t                pass\n133\t    raise SystemExit(128 + signum)\n134\t\n135\t\n136\tdef ignored(relative: Path) -> bool:\n137\t    return any(part in EPHEMERAL_NAMES for part in relative.parts) or relative.suffix in EPHEMERAL_SUFFIXES\n138\t\n139\t\n140\tdef copytree_ignore_for_sandbox(manifest: \"Manifest\") -> Callable[[str, list[str]], set[str]]:\n141\t    \"\"\"Copytree ignore callback for a fresh, isolated node sandbox.\n142\t\n143\t    Excludes ephemeral harness bookkeeping (.plan26-run, __pycache__, etc.)\n144\t    everywhere. Within the receipt state directory itself, keeps only the\n145\t    top-level *.receipt.v1.json files and excludes everything else (logs,\n146\t    the audit event log, receipt history, and — in configurations where\n147\t    attempt_dir is nested under state_dir — the attempt tree itself, which\n148\t    must never be copied into a sandbox it may itself be part of). The\n149\t    receipt files are the controller's actual admitted state — run.prompt\n150\t    describes every sandbox as an isolated copy of \"the current dirty\n151\t    baseline\", and those receipts are part of that baseline — so they are\n152\t    kept, meaning Controller methods like status()/receipts.load() behave\n153\t    the same way when a node's own verification runs them from inside a\n154\t    sandbox as they do against the live repo. An allowlist (keep only\n155\t    receipt files) rather than a denylist of known bulky subdirectory names\n156\t    is deliberate: it stays correct regardless of what else state_dir holds\n157\t    or how attempt_dir is configured relative to it.\n158\t    \"\"\"\n159\t    state_dir = manifest.data[\"execution\"][\"state_dir\"]\n160\t\n161\t    def ignore(directory: str, names: list[str]) -> set[str]:\n162\t        ignored_names = {name for name in names if name in EPHEMERAL_NAMES}\n163\t        directory_path = Path(directory).resolve()\n164\t        relative = (\n165\t            directory_path.relative_to(REPO_ROOT.resolve())\n166\t            if directory_path != REPO_ROOT.resolve()\n167\t            else Path()\n168\t        )\n169\t        if relative.as_posix() == state_dir:\n170\t            ignored_names.update(name for name in names if not name.endswith(\".receipt.v1.json\"))\n171\t        return ignored_names\n172\t\n173\t    return ignore\n174\t\n175\t\n176