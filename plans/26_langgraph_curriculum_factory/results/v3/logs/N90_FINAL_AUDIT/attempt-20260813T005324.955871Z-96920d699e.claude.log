{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XpBgCE1LKgh9QPj1obkgyw","type":"tool_result","content":"960\t            try:\n961\t                existing = self.records()\n962\t                for record in existing:\n963\t                    if record[\"payload\"][\"key\"] == key:\n964\t                        if record[\"payload\"][\"output_hash\"] != output_hash:\n965\t                            raise AdmissionConflict(\n966\t                                f\"admission key {key!r} already committed with a different output hash\"\n967\t                            )\n968\t                        return False, output_hash\n969\t                ordinal = len(existing) + 1\n970\t                prev_hash = existing[-1][\"record_hash\"] if existing else GENESIS_HASH\n971\t                body = {\n972\t                    \"schema\": self.schema,\n973\t                    \"ordinal\": ordinal,\n974\t                    \"prev_hash\": prev_hash,\n975\t                    \"payload\": {\"key\": key, \"output_hash\": output_hash, \"at\": time.time_ns()},\n976\t                }\n977\t                record = {**body, \"record_hash\": canonical_digest(body)}\n978\t                handle.seek(0, os.SEEK_END)\n979\t                handle.write(canonical_json_bytes(record) + b\"\\n\")\n980\t                handle.flush()\n981\t                os.fsync(handle.fileno())\n982\t            finally:\n983\t                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)\n984\t        return True, output_hash\n985\t\n986\t\n987\t# --------------------------------------------------------------------------\n988\t# Resume admissibility (spec 11.4 steps 4-5)\n989\t# --------------------------------------------------------------------------\n990\t\n991\t\n992\t_DRIFT_FIELD_CLASSES: dict[str, str] = {\n993\t    \"contract_version\": \"identity\",\n994\t    \"run_id\": \"identity\",\n995\t    \"created_at\": \"identity\",\n996\t    \"engine_root\": \"identity\",\n997\t    \"curriculum_root\": \"identity\",\n998\t    \"active_manifest_path\": \"identity\",\n999\t    \"output_root\": \"identity\",\n1000\t    \"mode\": \"identity\",\n1001\t    \"requested_unit_id\": \"identity\",\n1002\t    \"frozen_digest\": \"frozen_digest\",\n1003\t    \"frozen_inputs\": \"frozen_digest\",\n1004\t    \"frozen_executable_identities\": \"executable\",\n1005\t    \"evidence_chain_hashes\": \"evidence\",\n1006\t    \"accepted_receipt_hashes\": \"accepted_bytes\",\n1007\t    \"accepted_byte_digests\": \"accepted_bytes\",\n1008\t}\n1009\t\n1010\t\n1011\tdef validate_resume_inputs(\n1012\t    *, expected: Mapping[str, Any], observed: Mapping[str, Any]\n1013\t) -> None:\n1014\t    \"\"\"Refuse resume on any identity/digest/executable/evidence/accepted drift.\n1015\t\n1016\t    ``expected`` is the immutable identity envelope merged with whatever the\n1017\t    prior episode durably recorded (append-log chain hashes, accepted receipt\n1018\t    and accepted-byte digests); ``observed`` is the freshly recomputed value of\n1019\t    the same keys. An unclassified key is itself a refusal, because a difference\n1020\t    nobody has assigned a drift class to cannot be judged safe.\n1021\t    \"\"\"\n1022\t    for field in sorted(observed):\n1023\t        drift_class = _DRIFT_FIELD_CLASSES.get(field)\n1024\t        if drift_class is None:\n1025\t            raise ResumeRefused(\"identity\", field, \"a classified resume input\", \"unknown field\")\n1026\t        if field not in expected:\n1027\t            raise ResumeRefused(drift_class, field, \"present in the resume baseline\", \"absent\")\n1028\t        if canonical_digest(_json_safe(expected[field])) != canonical_digest(\n1029\t            _json_safe(observed[field])"}]},"parent_tool_use_id":"toolu_01A83BcuDzoa7A4Ptyz7sPPU","session_id":"512d45f8-5e59-47de-883c-0e101cf89d49","uuid":"4ed26ace-82c9-4cb3-b269-3aabfcb8f34b","timestamp":"2026-08-13T00:56:58.309Z","subagent_type":"Explore","task_description":