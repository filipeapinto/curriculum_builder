{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0118QwMPouYLPJisLCpPhtF5","type":"tool_result","content":"260\t# --------------------------------------------------------------------------\n261\t\n262\t\n263\tdef _visual_result(\n264\t    key: str, value: Any, briefs: dict[str, Any]\n265\t) -> tuple[str, Any]:\n266\t    \"\"\"Normalize one member of `visual_results` into the shape D11 also writes.\n267\t\n268\t    An M04 candidate is keyed on its activation and carries only the model's own\n269\t    answer, so the join key, the subset, the unit, and the content head it belongs\n270\t    to are the brief's, and the hash is this node's digest of the candidate — none\n271\t    of them a value the model was allowed to supply.\n272\t    \"\"\"\n273\t\n274\t    if not is_model_candidate(value):\n275\t        return key, value\n276\t    payload = candidate_payload(value, f\"visual candidate {key}\")\n277\t    visual = payload.get(\"visual_candidate\")\n278\t    require(\n279\t        isinstance(visual, dict),\n280\t        \"schema_contract\",\n281\t        f\"visual candidate {key} declares no visual_candidate\",\n282\t    )\n283\t    brief_id = str(value.get(\"brief_id\") or visual.get(\"brief_id\") or key)\n284\t    brief = briefs.get(brief_id, {})\n285\t    return brief_id, {\n286\t        \"key\": brief_id,\n287\t        \"unit_id\": value.get(\"unit_id\", brief.get(\"unit_id\")),\n288\t        \"subset\": value.get(\"subset\", \"model\"),\n289\t        \"provenance\": \"model_candidate\",\n290\t        \"content_hash\": value.get(\"content_hash\", brief.get(\"content_hash\")),\n291\t        \"domain_hash\": value.get(\"domain_hash\", brief.get(\"domain_hash\")),\n292\t        \"sha256\": canonical_digest(payload),\n293\t        \"format\": visual.get(\"image_format\"),\n294\t        \"accessibility_text\": visual.get(\"accessibility_text\"),\n295\t    }\n296\t\n297\t\n298\t@deterministic_node(\"D12_VISUAL_BARRIER_AND_JOIN\")\n299\tdef D12_VISUAL_BARRIER_AND_JOIN(projection: dict[str, Any], runtime_context: Any) -> dict[str, Any]:\n300\t    \"\"\"Prove the exact visual denominator, then dispatch model briefs or admit the head.\n301\t\n302\t    Entered twice per epoch: first to prove the deterministic subset is exactly\n303\t    complete before any model brief is dispatched, then to admit the visual head\n304\t    once the whole denominator has returned.\n305\t    \"\"\"\n306\t\n307\t    unit_id = projection[\"selected_unit_id\"]\n308\t    require(isinstance(unit_id, str) and unit_id, \"invalid_input\", \"no unit is selected\")\n309\t\n310\t    denominator = None\n311\t    for value in projection[\"visual_denominators\"].values():\n312\t        if isinstance(value, dict) and value.get(\"unit_id\") == unit_id:\n313\t            denominator = value\n314\t    require(denominator is not None, \"invalid_input\", f\"no visual denominator for {unit_id!r}\")\n315\t\n316\t    heads = projection[\"artifact_heads\"]\n317\t    content_head = heads.get(stream_id(unit_id, \"content\"))\n318\t    require(isinstance(content_head, dict), \"invalid_input\", \"no admitted content head\")\n319\t    require(\n320\t        denominator[\"content_hash\"] == content_head[\"hash\"],\n321\t        \"integrity\",\n322\t        \"the visual denominator was compiled against a superseded content head\",\n323\t        denominator_parent=denominator[\"content_hash\"],\n324\t        current_head=content_head[\"hash\"],\n325\t    )\n326\t\n327\t    expected_deterministic = set(denominator[\"deterministic_keys\"])\n328\t    expected_model = set(denominator[\"model_keys\"])\n329\t    briefs_by_key = {\n330\t        brief[\"key\"]: brief\n331\t        for brief in projection[\"visual_briefs\"]\n332\t        if isinstance(brief, dict) and \"key\" in brief\n333\t    }\n334\t    results: dict[str, Any] = {}\n335\t    for raw_key, value in projection[\"visual_results\"].items():\n336\t        joined_key, result = _visual_result(raw_key, value, briefs_by_key)\n337\t        results[joined_key] = result\n338\t\n339\t    actual_deterministic = {\n340\t        key\n341\t        for key, value in results.items()\n342\t        if isinstance(value, dict)\n343\t        and value.get(\"unit_id\") == unit_id\n344\t        and value.get(\"subset\") == \"deterministic\"\n345\t    }\n346\t    missing = sorted(expected_deterministic - actual_deterministic)\n347\t    extra = sorted(actual_deterministic - expected_deterministic)\n348\t    require(\n349\t        not missing and not extra,\n350\t        \"join\",\n351\t        \"the deterministic visual subset does not equal its frozen denominator\",\n352\t        missing=missing,\n353\t        extra=extra,\n354\t    )\n355\t\n356\t    stale = sorted(\n357\t        key\n358\t        for key in actual_deterministic\n359\t        if results[key].get(\"content_hash\") != content_head[\"hash\"]\n360\t    )\n361\t    require(\n362\t        not stale,\n363\t        \"integrity\",\n364\t        \"a deterministic visual was produced against a superseded content head\",\n365\t        stale=stale,\n366\t    )\n367\t\n368\t    actual_model = {\n369\t        key\n370\t        for key, value in results.items()\n371\t        if isinstance(value, dict)\n372\t        and value.get(\"unit_id\") == unit_id\n373\t        and value.get(\"subset\") == \"model\"\n374\t    }\n375\t\n376\t    if expected_model and actual_model != expected_model:\n377\t        pending = sorted(expected_model - actual_model)\n378\t        briefs = {\n379\t            brief[\"key\"]: brief\n380\t            for brief in projection[\"visual_briefs\"]\n381\t            if isinstance(brief, dict) and brief.get(\"key\") in pending\n382\t        }\n383\t        require(\n384\t            sorted(briefs) == pending,\n385\t            \"join\",\n386\t            \"a pending model visual key has no compiled brief\",\n387\t            pending=pending,\n388\t        )\n389\t        evidence = {\n390\t            \"key\": canonical_digest(\n391\t                {\"unit_id\": unit_id, \"phase\": \"deterministic_subset_proof\", \"keys\": sorted(expected_deterministic)}\n392\t            ),\n393\t            \"unit_id\": unit_id,\n394\t            \"phase\": \"deterministic_subset_proof\",\n395\t            \"result\": \"PASS\",\n396\t            \"deterministic_size\": len(expected_deterministic),\n397\t            \"pending_model_keys\": pending,\n398\t        }\n399\t        packets = ["}]},"parent_tool_use_id":"toolu_01A83BcuDzoa7A4Ptyz7sPPU","session_id":"512d45f8-5e59-47de-883c-0e101cf89d49","uuid":"0a0b37a5-338a-47e0-a5b8-3d852473ca16","timestamp":"2026-08-13T00:56:39.099Z","subagent_type":"Explore","task_description":"Verify 8 Plan 26 runtime invariants from source"}
