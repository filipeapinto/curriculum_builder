{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D1S9BSEXC3q6eZsmWWCb2b","type":"tool_result","content":"760\t    parent_body, current_hash, _current_version, _head_tracked, _body_keyed = _current_parent(state, stream)\n761\t    new_body = _deterministic_repair_candidate(request, parent_body)\n762\t    candidate = {\n763\t        \"key\": canonical_digest({\"request_key\": request[\"key\"], \"kind\": \"deterministic_candidate\"}),\n764\t        \"record_kind\": DETERMINISTIC_REPAIR_CANDIDATE_KIND,\n765\t        \"pre_admission\": True,\n766\t        \"stream\": stream,\n767\t        \"channel\": request[\"channel\"],\n768\t        \"unit_id\": unit_id,\n769\t        \"request_key\": request[\"key\"],\n770\t        \"owner\": request[\"owner\"],\n771\t        \"parent_sha256\": current_hash,\n772\t        \"addressed_finding_ids\": request[\"finding_ids\"],\n773\t        \"body\": new_body,\n774\t    }\n775\t    return {\n776\t        \"invalidations\": [invalidation],\n777\t        \"artifact_versions\": [candidate],\n778\t        \"pending_guard\": _guard(\n779\t            \"D19_ROUTE_UNIT_REPAIR\", \"deterministic_repair\", unit_id=unit_id, request_key=request[\"key\"]\n780\t        ),\n781\t    }\n782\t\n783\t\n784\t# --------------------------------------------------------------------------\n785\t# D20_ADMIT_UNIT_REPAIR\n786\t# --------------------------------------------------------------------------\n787\t\n788\t\n789\tdef _latest_deterministic_candidate(\n790\t    artifact_versions: Sequence[Any], *, stream: str, request_key: str\n791\t) -> dict[str, Any] | None:\n792\t    matches = [\n793\t        dict(record)\n794\t        for record in artifact_versions\n795\t        if isinstance(record, Mapping)\n796\t        and record.get(\"record_kind\") == DETERMINISTIC_REPAIR_CANDIDATE_KIND\n797\t        and record.get(\"stream\") == stream\n798\t        and record.get(\"request_key\") == request_key\n799\t    ]\n800\t    return matches[-1] if matches else None\n801\t\n802\t\n803\t# Bookkeeping keys this repair engine's own admitted records always carry,\n804\t# never a channel's content. Used only to recover a record's meaningful\n805\t# content when the record itself carries no `body` key (see `_record_content`\n806\t# below); domain/content admit a `body`-keyed record (`nodes/domain.py`,\n807\t# `nodes/content.py`) and are read directly, so this set is only consulted\n808\t# for a channel like layout that is not.\n809\t_RECORD_BOOKKEEPING_KEYS: frozenset[str] = frozenset(\n810\t    {\n811\t        \"key\", \"stream\", \"version\", \"parent_hash\", \"hash\", \"record_kind\",\n812\t        \"pre_admission\", \"request_key\", \"owner\", \"attempt\", \"channel\",\n813\t        \"unit_id\", \"minted_by\", \"addressed_finding_ids\",\n814\t    }\n815\t)\n816\t\n817\t\n818\tdef _record_content(record: Mapping[str, Any]) -> dict[str, Any]:\n819\t    \"\"\"The meaningful content fields of an admitted artifact record.\n820\t\n821\t    Domain/content nest their content under a `body` key (`nodes/domain.py`,\n822\t    `nodes/content.py`); layout does not -- `D13_RENDER_UNIT` (`nodes/render\n823\t    .py`) writes `pdf_path`/`pdf_sha256`/... directly on the record, alongside\n824\t    only this engine's own fixed bookkeeping keys. Reading either shape\n825\t    uniformly here is what lets D19's boundary-scoped JSON-pointer patch and\n826\t    D20's diff/boundary check apply to a channel regardless of which\n827\t    convention its own producer uses, instead of silently seeing an empty\n828\t    parent body for a channel that never wraps one.\n829\t    \"\"\"\n830\t\n831\t    if \"body\" in record:\n832\t        return dict(record.get(\"body\") or {})\n833\t    return {key: value for key, value in record.items() if key not in _RECORD_BOOKKEEPING_KEYS}\n834\t\n835\t\n836\tdef _current_parent(state: Mapping[str, Any], stream: str) -> tuple[Any, str | None, int, bool, bool]:\n837\t    \"\"\"The current parent body/hash/version of ``stream``, head-tracked or not.\n838\t\n839\t    Domain/content/visuals advance through `artifact_heads` (`advance_head`);\n840\t    layout does not (it is admitted by D13 as a plain append-unique version,\n841\t    the same convention `review.py` already reads it under). Both shapes\n842\t    resolve to one parent here so D20 admits either uniformly, the fourth\n843\t    element tells the caller whether `artifact_heads` may legally be written,\n844\t    and the fifth tells the caller whether the parent record itself was\n845\t    `body`-keyed -- so a child D20 admits stays in the same shape convention\n846\t    its own channel's real producer already uses (`D20_ADMIT_UNIT_REPAIR`\n847\t    reads this rather than assuming every channel is `body`-keyed).\n848\t    \"\"\"\n849\t\n850\t    heads = state.get(\"artifact_heads\") or {}\n851\t    head = heads.get(stream)\n852\t    artifact_versions = state.get(\"artifact_versions\") or []\n853\t    if isinstance(head, Mapping):\n854\t        for record in artifact_versions:\n855\t            if (\n856\t                isinstance(record, Mapping)\n857\t                and record.get(\"stream\") == stream\n858\t                and record.get(\"hash\") == head.get(\"hash\")\n859\t            ):\n860\t                return (\n861\t                    _record_content(record), head.get(\"hash\"), int(head.get(\"version\", 0)), True,\n862\t                    \"body\" in record,\n863\t                )\n864\t        return {}, head.get(\"hash\"), int(head.get(\"version\", 0)), True, True\n865\t\n866\t    candidates = [\n867\t        record\n868\t        for record in artifact_versions\n869\t        if isinstance(record, Mapping)\n870\t        and record.get(\"stream\") == stream\n871\t        and record.get(\"record_kind\") not in (DETERMINISTIC_REPAIR_CANDIDATE_KIND, \"model_candidate\")\n872\t    ]\n873\t    if not candidates:\n874\t        return {}, None, 0, False, True\n875\t    latest = max(candidates, key=lambda record: record.get(\"version\", 0))\n876\t    return (\n877\t        _record_content(latest), latest.get(\"hash\"), int(latest.get(\"version\", 0)), False,\n878\t        \"body\" in latest,\n879\t    )\n880\t\n881\t\n882\tdef D20_ADMIT_UNIT_REPAIR(state: Mapping[str, Any], runtime_context: Any) -> dict[str, Any]:\n883\t    \"\"\"Admit a boundary-checked child atomically, or refuse it as a system fault.\n884\t\n885\t    Recomputes the parent/child diff itself rather than trusting a model's own\n886\t    `changed_path_manifest`: a diff pointer outside the declared boundary, or a\n887\t    child that does not descend from the current head, is `SystemFailure`\n888\t    (\"out-of-bound/in-place = system\", spec section 6.2 D20 row) -- never a\n889\t    routed repairable finding, because a boundary violation is a build/model\n890\t    defect, not a product outcome to retry.\n891\t    \"\"\"\n892\t\n893\t    unit_id = state.get(\"selected_unit_id\")\n894\t    require(isinstance(unit_id, str) and bool(unit_id), \"invalid_input\", \"no unit is selected\")\n895\t\n896\t    requests = [\n897\t        entry\n898\t        for entry in state.get(\"repair_requests\") or []\n899\t        if isinstance(entry, Mapping) and entry.get(\"unit_id\") == unit_id\n900\t    ]\n901\t    require(bool(requests), \"invalid_input\", \"D20 requires a routed repair request\")\n902\t    request = requests[-1]\n903\t    stream = request[\"stream\"]\n904\t    boundary = request[\"boundary\"][\"json_pointers\"]\n905\t    heads = state.get(\"artifact_heads\") or {}\n906\t    parent_head = heads.get(stream)\n907\t    artifact_versions = state.get(\"artifact_versions\") or []\n908\t\n909\t    parent_body, current_hash, current_version, head_tracked, body_keyed = _current_parent(state, stream)\n910\t\n911\t    model_candidate = latest_model_candidate(artifact_versions, channel=request[\"channel\"], unit_id=unit_id)\n912\t    deterministic_candidate = _latest_deterministic_candidate(\n913\t        artifact_versions, stream=stream, request_key=request[\"key\"]\n914\t    )\n915\t    require(\n916\t        (model_candidate is not None) != (deterministic_candidate is not None),\n917\t        \"join\",\n918\t        \"D20 requires exactly one pending repair candidate: model or deterministic\",\n919\t        unit_id=unit_id,\n920\t    )\n921\t\n922\t    if model_candidate is not None:\n923\t        payload = candidate_payload(model_candidate, \"M06 repair candidate\")\n924\t        child = payload.get(\"candidate_child\") or {}\n925\t        require(isinstance(child, Mapping), \"schema_contract\", \"M06 candidate carries no candidate_child\")\n926\t        try:\n927\t            new_body = json.loads(child.get(\"artifact_body\", \"\"))\n928\t        except (TypeError, ValueError) as error:\n929\t            raise SystemFailure(\n930\t                \"schema_contract\", f\"M06 candidate_child.artifact_body is not JSON: {error}\"\n931\t            ) from error\n932\t        declared_parent_sha = model_candidate.get(\"parent_sha256\")\n933\t    else:\n934\t        new_body = deterministic_candidate[\"body\"]\n935\t        declared_parent_sha = deterministic_candidate.get(\"parent_sha256\")\n936\t\n937\t    require(\n938\t        declared_parent_sha == current_hash,\n939\t        \"integrity\",\n940\t        \"the repair candidate's declared parent is not the current head (stale repair)\",\n941\t        stream=stream, declared=declared_parent_sha, current=current_hash,\n942\t    )\n943\t\n944\t    diff = json_pointer_diff(parent_body, new_body)\n945\t    require(bool(diff), \"integrity\", \"a repair candidate makes no change (in-place, no-op repair)\", stream=stream)\n946\t    out_of_bound = sorted(pointer for pointer in diff if not within_boundary(pointer, boundary))\n947\t    require(\n948\t        not out_of_bound,\n949\t        \"integrity\",\n950\t        \"a repair candidate changed bytes outside its declared boundary\",\n951\t        stream=stream, out_of_bound=out_of_bound, boundary=boundary,\n952\t    )\n953\t\n954\t    child_record: dict[str, Any] = {\n955\t        \"stream\": stream,\n956\t        \"version\": current_version + 1,\n957\t        \"parent_hash\": current_hash,\n958\t        \"hash\": canonical_digest(new_body),\n959\t        \"minted_by\": \"targeted_repair_admission\",\n960\t        \"unit_id\": unit_id,\n961\t        \"channel\": request[\"channel\"],\n962\t        \"request_key\": request[\"key\"],\n963\t        \"owner\": request[\"owner\"],\n964\t        \"attempt\": request[\"attempt_ordinal\"],\n965\t    }\n966\t    # Admit the child in the same shape convention its own channel's real\n967\t    # producer already uses: `body`-keyed for domain/content (`nodes/domain\n968\t    # .py`, `nodes/content.py`), spread at top level for a channel like layout\n969\t    # that never wraps one (`nodes/render.py`) -- otherwise a channel's own\n970\t    # later real reader (D13/D14 for layout) would silently see a malformed\n971\t    # version instead of the admitted repair.\n972\t    if body_keyed:\n973\t        child_record[\"body\"] = new_body\n974\t    else:\n975\t        child_record.update(new_body)\n976\t    child_record[\"key\"] = canonical_digest({\"stream\": stream, \"hash\": child_record[\"hash\"]})\n977\t\n978\t    update: dict[str, Any] = {\n979\t        \"artifact_versions\": [child_record],\n980\t        \"pending_guard\": _guard(\n981\t            \"D20_ADMIT_UNIT_REPAIR\", \"repair_admitted\",\n982\t            unit_id=unit_id, request_key=request[\"key\"], stream=stream,\n983\t        ),\n984\t    }\n985\t    if head_tracked:\n986\t        update[\"artifact_heads\"] = {\n987\t            stream: {\"version\": child_record[\"version\"], \"parent_hash\": child_record[\"parent_hash\"], \"hash\": child_record[\"hash\"]}\n988\t        }\n989\t    return update"}]},"parent_tool_use_id":"toolu_01A83BcuDzoa7A4Ptyz7sPPU","session_id":"512d45f8-5e59-47de-883c-0e101cf89d49","uuid":"0708d52d-bad9-4e07-b4d6-