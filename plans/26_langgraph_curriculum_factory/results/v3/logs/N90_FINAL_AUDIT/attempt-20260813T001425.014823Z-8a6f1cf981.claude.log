{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VXiCama8zz6iejAJ51ZgQn","type":"tool_result","content":"351\tdef decide(node_id: str, state: Mapping[str, Any], *, model_node: bool = False) -> str:\n352\t    \"\"\"Resolve the one destination `node_id` authorizes for `state`.\"\"\"\n353\t\n354\t    failure = _failure_destination(state, model_node=model_node)\n355\t    if failure is not None:\n356\t        return failure\n357\t    if interrupt_requested(state):\n358\t        return INTERRUPT_GATE\n359\t    guard, value = _guard_value(state, node_id)\n360\t    dynamic = DYNAMIC_GUARDS.get(node_id, {})\n361\t    if value in dynamic:\n362\t        destination = _dynamic_destination(node_id, guard, dynamic[value])\n363\t        if node_id in (\"D92_REENTER_VALIDATED_FRONTIER\", \"D21_RETEST_REQUIRED_DESCENDANTS\"):\n364\t            if destination.startswith(_MODEL_ID_PREFIXES):\n365\t                raise RoutingViolation(\n366\t                    f\"{node_id}: {destination!r} is a model node and may not be a \"\n367\t                    f\"stored deterministic destination\"\n368\t                )\n369\t        return destination\n370\t    destinations = GUARD_DESTINATIONS.get(node_id, {})\n371\t    if value in destinations:\n372\t        return destinations[value]\n373\t    if value in FANOUT_GUARDS.get(node_id, {}):\n374\t        raise RoutingViolation(\n375\t            f\"{node_id}: guard value {value!r} dispatches a Send fan-out and must be \"\n376\t            f\"routed by its fan-out guard, not by a single-destination edge\"\n377\t        )\n378\t    raise RoutingViolation(f\"{node_id}: undeclared guard value {value!r}\")\n379\t\n380\t\n381\tdef guard_destinations(node_id: str) -> tuple[str, ...]:\n382\t    \"\"\"Every destination `node_id`'s conditional edge may return, for its path map.\"\"\"\n383\t\n384\t    declared = set(GUARD_DESTINATIONS.get(node_id, {}).values())\n385\t    declared.update(FANOUT_GUARDS.get(node_id, {}).values())\n386\t    declared.add(TERMINAL)\n387\t    declared.add(INTERRUPT_GATE)\n388\t    if node_id.startswith(_MODEL_ID_PREFIXES):\n389\t        declared.add(MODEL_FAILURE_CLASSIFIER)\n390\t    return tuple(sorted(declared))\n391\t\n392\t\n393\tdef assert_guard_table_total(catalogue: Mapping[str, Any]) -> None:\n394\t    \"\"\"Fail closed when a node declares a guard value this table cannot route.\n395\t"}]},"parent_tool_use_id":"toolu_019kwJZYNZqUFLgLkAmjUyqq","session_id":"47f42b4a-0f2f-488f-942b-22d2e1825427","uuid":"5dbc89eb-c7dc-4dce-8508-285fb2699966","timestamp":"2026-08-13T00:22:20.713Z","subagent_type":"Explore","task_description":"Verify eight-job and invariant evidence"}
