{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PXmnwmVGTPN47kxabGJthn","type":"tool_result","content":"129\tclass JobRoute:\n130\t    job_id: str\n131\t    job_type: str\n132\t    cli: str\n133\t    family: str\n134\t    provider: str\n135\t    model: str\n136\t    task_class: str | None\n137\t    reasoning_effort: str\n138\t    schema: str\n139\t    prompt: str\n140\t    timeout_seconds: int\n141\t    retry_limit: int\n142\t    data_classes: tuple[str, ...]\n143\t\n144\t    @property\n145\t    def is_review(self) -> bool:\n146\t        return self.family == REVIEW_FAMILY\n147\t\n148\t\n149\t_REGISTRY_CACHE: dict[Path, Mapping[str, JobRoute]] = {}\n150\t\n151\t\n152\tdef load_job_registry(path: Path | str = REGISTRY_PATH) -> Mapping[str, JobRoute]:\n153\t    resolved = Path(path).resolve()\n154\t    if resolved in _REGISTRY_CACHE:\n155\t        return _REGISTRY_CACHE[resolved]\n156\t    document = yaml.safe_load(resolved.read_text(encoding=\"utf-8\"))\n157\t    entries = document.get(\"jobs\") or []\n158\t    declared = int(document.get(\"job_count\", 0))\n159\t    if declared != 8 or len(entries) != 8:\n160\t        raise RouteRejected(\n161\t            f\"registry must declare exactly eight jobs, found {len(entries)} (declared {declared})\")\n162\t    routes: dict[str, JobRoute] = {}\n163\t    for entry in entries:\n164\t        route = JobRoute(\n165\t            job_id=entry[\"job_id\"],\n166\t            job_type=entry[\"job_type\"],\n167\t            cli=entry[\"cli\"],\n168\t            family=entry[\"family\"],\n169\t            provider=entry[\"provider\"],\n170\t            model=entry[\"model\"],\n171\t            task_class=entry.get(\"task_class\"),\n172\t            reasoning_effort=entry[\"reasoning_effort\"],\n173\t            schema=entry[\"schema\"],\n174\t            prompt=entry[\"prompt\"],\n175\t            timeout_seconds=int(entry[\"timeout_seconds\"]),\n176\t            retry_limit=int(entry[\"retry_limit\"]),\n177\t            data_classes=tuple(entry[\"data_classes\"]),\n178\t        )\n179\t        if route.cli not in {\"codex\", \"gemini\"}:\n180\t            raise RouteRejected(f\"unknown cli for {route.job_id}: {route.cli}\")\n181\t        if route.cli == \"codex\" and route.family != AUTHORING_FAMILY:\n182\t            raise RouteRejected(f\"codex route {route.job_id} must be family {AUTHORING_FAMILY}\")\n183\t        if route.cli == \"gemini\" and route.family != REVIEW_FAMILY:\n184\t            raise RouteRejected(f\"gemini route {route.job_id} must be family {REVIEW_FAMILY}\")\n185\t        if route.job_id in routes:\n186\t            raise RouteRejected(f\"duplicate job id {route.job_id}\")\n187\t        routes[route.job_id] = route\n188\t    _REGISTRY_CACHE[resolved] = routes\n189\t    return routes\n190\t\n191\t\n192\tdef resolve_route(job_id: str, registry: Mapping[str, JobRoute] | None = None) -> JobRoute:\n193\t    routes = registry if registry is not None else load_job_registry()\n194\t    try:\n195\t        return routes[job_id]\n196\t    except KeyError:\n197\t        raise RouteRejected(f\"unknown job id: {job_id!r}\") from None\n198\t\n199\t\n200\tdef resolve_prompt_path(route: JobRoute) -> Path:\n201\t    \"\"\"Resolve the prompt relative to this package, never the process cwd.\"\"\"\n202\t    candidate = (PROMPT_DIR / route.prompt).resolve()\n203\t    if candidate.parent != PROMPT_DIR:\n204\t        raise RouteRejected(f\"prompt escapes package prompt directory: {route.prompt!r}\")\n205\t    if not candidate.is_file():\n206\t        raise RouteRejected(f\"prompt does not resolve inside the package: {route.prompt!r}\")\n207\t    return candidate\n208\t\n209\t\n210\tdef resolve_schema_path(route: JobRoute) -> Path:\n211\t    candidate = (SCHEMA_DIR / route.schema).resolve()\n212\t    if candidate.parent != SCHEMA_DIR:\n213\t        raise RouteRejected(f\"schema escapes package schema directory: {route.schema!r}\")\n214\t    if not candidate.is_file():\n215\t        raise RouteRejected(f\"schema does not resolve inside the package: {route.schema!r}\")\n216\t    return candidate\n217\t\n218\t"}]},"parent_tool_use_id":"toolu_019kwJZYNZqUFLgLkAmjUyqq","session_id":"47f42b4a-0f2f-488f-942b-22d2e1825427","uuid":"d3e5701d-6228-4e36-a0ef-8b4b0254eda4","timestamp":"2026-08-13T00:21:58.945Z","subagent_type":"Explore","task_description":"Verify eight-job and invariant evidence"}
