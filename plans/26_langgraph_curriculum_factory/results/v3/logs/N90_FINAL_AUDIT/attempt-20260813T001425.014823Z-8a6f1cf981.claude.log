{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UvKBJEtzZK8UewEy9Tzyd5","type":"tool_result","content":"1011\tdef validate_resume_inputs(\n1012\t    *, expected: Mapping[str, Any], observed: Mapping[str, Any]\n1013\t) -> None:\n1014\t    \"\"\"Refuse resume on any identity/digest/executable/evidence/accepted drift.\n1015\t\n1016\t    ``expected`` is the immutable identity envelope merged with whatever the\n1017\t    prior episode durably recorded (append-log chain hashes, accepted receipt\n1018\t    and accepted-byte digests); ``observed`` is the freshly recomputed value of\n1019\t    the same keys. An unclassified key is itself a refusal, because a difference\n1020\t    nobody has assigned a drift class to cannot be judged safe.\n1021\t    \"\"\"\n1022\t    for field in sorted(observed):\n1023\t        drift_class = _DRIFT_FIELD_CLASSES.get(field)\n1024\t        if drift_class is None:\n1025\t            raise ResumeRefused(\"identity\", field, \"a classified resume input\", \"unknown field\")\n1026\t        if field not in expected:\n1027\t            raise ResumeRefused(drift_class, field, \"present in the resume baseline\", \"absent\")\n1028\t        if canonical_digest(_json_safe(expected[field])) != canonical_digest(\n1029\t            _json_safe(observed[field])\n1030\t        ):\n1031\t            raise ResumeRefused(drift_class, field, expected[field], observed[field])\n1032\t\n1033\t\n1034\tdef _validate_terminal_legality(terminal: Mapping[str, Any] | None) -> str:\n1035\t    if not terminal:\n1036\t        raise ResumeRefused(\"terminal_legality\", \"terminal\", \"a recorded episode terminal\", None)\n1037\t    name = terminal.get(\"terminal\") or terminal.get(\"kind\") or terminal.get(\"name\")\n1038\t    if name in NON_RESUMABLE_TERMINALS:\n1039\t        raise ResumeRefused(\n1040\t            \"terminal_legality\", \"terminal\", sorted(RESUMABLE_TERMINALS), name\n1041\t        )\n1042\t    if name not in RESUMABLE_TERMINALS:\n1043\t        raise ResumeRefused(\"terminal_legality\", \"terminal\", sorted(RESUMABLE_TERMINALS), name)\n1044\t    return str(name)\n1045\t\n1046\t\n1047\t# --------------------------------------------------------------------------\n1048\t# Deterministic resume frontier (spec 11.3, 11.4 steps 7-8)\n1049\t# --------------------------------------------------------------------------\n1050\t\n1051\t\n1052\tdef classify_join_members(\n1053\t    *, expected_keys: Iterable[str], completed_keys: Iterable[str]\n1054\t) -> dict[str, Any]:\n1055\t    \"\"\"Split a denominator into completed/pending; a join is satisfied only when equal.\n1056\t\n1057\t    Pending writes from a surviving sibling never shrink the denominator, so a\n1058\t    fan-out with one crashed member cannot be joined as a partial result.\n1059\t    \"\"\"\n1060\t    expected = sorted({str(key) for key in expected_keys})\n1061\t    completed = sorted({str(key) for key in completed_keys})\n1062\t    extra = sorted(set(completed) - set(expected))\n1063\t    if extra:\n1064\t        raise PersistenceError(f\"completed members outside the denominator: {extra}\")\n1065\t    pending = sorted(set(expected) - set(completed))\n1066\t    return {\n1067\t        \"expected\": expected,\n1068\t        \"completed\": completed,\n1069\t        \"pending\": pending,\n1070\t        \"satisfied\": not pending and bool(expected),\n1071\t    }\n1072\t\n1073\t\n1074\tdef compute_resume_frontier(\n1075\t    *,\n1076\t    readout: PriorEpisodeReadout,\n1077\t    denominators: Mapping[str, Mapping[str, Iterable[str]]] | None = None,\n1078\t    evidence_high_water: Mapping[str, int] | None = None,\n1079\t    reason: str = \"resume\",\n1080\t) -> dict[str, Any]:\n1081\t    \"\"\"Deterministic, model-free frontier for the next episode.\n1082\t\n1083\t    Any model destination is rewritten to `D91`: spec 11.3 forbids storing a\n1084\t    model node as a resume destination, because an aborted model receipt must be\n1085\t    classified before D90 can authorize another transmission.\n1086\t    \"\"\"\n1087\t    destinations: list[str] = []\n1088\t    reclassified: list[dict[str, str]] = []\n1089\t    incomplete_task_names = sorted(\n1090\t        {task[\"name\"] for task in readout.tasks if task[\"name\"]}\n1091\t    )\n1092\t    candidates = sorted(set(readout.next) | set(incomplete_task_names))\n1093\t    for candidate in candidates:\n1094\t        if candidate in MODEL_NODE_IDS:\n1095\t            reclassified.append({\"from\": candidate, \"to\": MODEL_CLASSIFICATION_ENTRY})\n1096\t            destinations.append(MODEL_CLASSIFICATION_ENTRY)\n1097\t        else:\n1098\t            destinations.append(candidate)\n1099\t    destinations = sorted(set(destinations))\n1100\t    reclassified.sort(key=lambda item: (item[\"from\"], item[\"to\"]))\n1101\t\n1102\t    joins: dict[str, Any] = {}\n1103\t    for join_name, spec in sorted((denominators or {}).items()):\n1104\t        joins[join_name] = classify_join_members(\n1105\t            expected_keys=spec.get(\"expected\", ()),\n1106\t            completed_keys=spec.get(\"completed\", ()),\n1107\t        )\n1108\t\n1109\t    frontier = {\n1110\t        \"schema\": RESUME_FRONTIER_SCHEMA,\n1111\t        \"reason\": reason,\n1112\t        \"prior_thread_id\": readout.thread_id,\n1113\t        \"prior_checkpoint_id\": readout.checkpoint_id,\n1114\t        \"checkpoint_ns\": CHECKPOINT_NS,\n1115\t        \"destinations\": destinations,\n1116\t        \"reclassified_model_destinations\": reclassified,\n1117\t        \"pending_writes\": [dict(write) for write in readout.pending_writes],\n1118\t        \"joins\": joins,\n1119\t        \"state_digest\": readout.state_digest,\n1120\t        \"evidence_high_water\": dict(sorted((evidence_high_water or {}).items())),\n1121\t    }\n1122\t    frontier[\"frontier_digest\"] = canonical_digest(frontier)\n1123\t    return frontier\n1124\t\n1125\t\n1126\tdef build_interrupt_terminal_candidate(\n1127\t    *,\n1128\t    run_id: str,\n1129\t    episode_id: str,\n1130\t    frontier: Mapping[str, Any],\n1131\t    classification: str,\n1132\t    heads: Mapping[str, str],\n1133\t    high_water_marks: Mapping[str, Any],\n1134\t) -> dict[str, Any]:\n1135\t    \"\"\"Exactly one `INTERRUPTED` terminal candidate for the episode D98 closes."}]},"parent_tool_use_id":"toolu_019kwJZYNZqUFLgLkAmjUyqq","session_id":"47f42b4a-0f2f-488f-942b-22d2e1825427","uuid":"de1a1acf-2801-4610-b378-be7723c3626b","timestamp":"2026-08-13T00:22:49.965Z","subagent_type":"Explore","task_description":"Verify eight-job and invariant evidence"}
