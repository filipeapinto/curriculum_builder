h in sorted(root.rglob(\"*\")):\n188:def path_digest(root: Path, relative: str) -> str | None:\n194:        for child in sorted(path.rglob(\"*\")):\n320:    def digest(self) -> str:\n462:            # the node_definition digest feeding every admissibility check.\n514:    def chain_digest(self, node_id: str) -> str:\n656:    def clear_digest_cache(self) -> None:\n659:    def current_digest(self, relative: str) -> str | None:\n695:    def node_definition_digest(self, node_id: str) -> str:\n721:            \"node_definition\": self.node_definition_digest(node_id),\n735:        if receipt is None or receipt.get(\"node_definition_sha256\") != self.node_definition_digest(node_id):\n787:            if predecessor_receipt.get(\"node_definition_sha256\") != self.node_definition_digest(predecessor):\n800:            \"node_definition\": self.node_definition_digest(node_id),\n857:    def harness_digest(self) -> str:\n1035:        for path in sorted(attempt_workspace.rglob(\"*\")):\n1154:            \"node_definition_sha256\": self.receipts.node_definition_digest(node_id),\n1813:            for path in sorted(results_root.rglob(\"*\")):","numLines":20,"totalLines":20}}
