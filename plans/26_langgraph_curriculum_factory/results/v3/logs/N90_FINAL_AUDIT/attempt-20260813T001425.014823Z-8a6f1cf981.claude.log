{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DLsicBrzunGFWbzac95zc8","type":"tool_result","content":"108\tdef compute_unit_denominator(state: Mapping[str, Any], unit_id: str) -> DenominatorResult:\n109\t    \"\"\"Recompute the complete current unit denominator (spec section 13.1).\"\"\"\n110\t\n111\t    heads = state.get(\"artifact_heads\") or {}\n112\t    checks = [\n113\t        record\n114\t        for record in state.get(\"deterministic_checks\") or []\n115\t        if isinstance(record, Mapping) and record.get(\"owner\") == unit_id\n116\t    ]\n117\t    findings: list[dict[str, Any]] = []\n118\t    categories: dict[str, Any] = {}\n119\t\n120\t    def _fail(owner: str, check_id: str, pointer: str, message: str) -> None:\n121\t        findings.append({\"check_id\": check_id, \"owner\": owner, \"pointer\": pointer, \"message\": message})\n122\t\n123\t    # 1-2. source admission and correlation.\n124\t    admissions = [\n125\t        record\n126\t        for record in state.get(\"source_admissions\") or []\n127\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n128\t    ]\n129\t    admissions_ok = bool(admissions) and all(\n130\t        isinstance(record.get(\"sha256\"), str) and record.get(\"sha256\") for record in admissions\n131\t    )\n132\t    categories[\"source_admissions\"] = {\"result\": \"PASS\" if admissions_ok else \"FAIL\", \"count\": len(admissions)}\n133\t    if not admissions_ok:\n134\t        _fail(\"source interpretation\", \"unit_source_admissions\", \"/sources\", \"no admitted source with a resolved sha256\")\n135\t\n136\t    # 3, 5. curriculum-domain schema/verifier/fixtures and fact-to-source resolution.\n137\t    domain_stream = stream_id(unit_id, \"domain\")\n138\t    domain_head = heads.get(domain_stream)\n139\t    domain_hash = domain_head.get(\"hash\") if isinstance(domain_head, Mapping) else None\n140\t    domain_checks = {\n141\t        record[\"check_id\"]: record\n142\t        for record in checks\n143\t        if record.get(\"check_id\") in DOMAIN_CHECK_IDS and record.get(\"head_hash\") == domain_hash\n144\t    }\n145\t    domain_ok = domain_hash is not None and all(\n146\t        domain_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in DOMAIN_CHECK_IDS\n147\t    )\n148\t    categories[\"domain\"] = {\"result\": \"PASS\" if domain_ok else \"FAIL\", \"head_hash\": domain_hash}\n149\t    if not domain_ok:\n150\t        _fail(\"curriculum domain\", \"unit_domain_denominator\", \"/domain\", \"the admitted domain head has no current passing check set\")\n151\t\n152\t    # 4, 6. unit schema and every sourced claim resolved.\n153\t    content_stream = stream_id(unit_id, \"content\")\n154\t    content_head = heads.get(content_stream)\n155\t    content_hash = content_head.get(\"hash\") if isinstance(content_head, Mapping) else None\n156\t    content_checks = {\n157\t        record[\"check_id\"]: record\n158\t        for record in checks\n159\t        if record.get(\"check_id\") in CONTENT_CHECK_IDS and record.get(\"head_hash\") == content_hash\n160\t    }\n161\t    content_ok = content_hash is not None and all(\n162\t        content_checks.get(check_id, {}).get(\"result\") == \"PASS\" for check_id in CONTENT_CHECK_IDS\n163\t    )\n164\t    categories[\"content\"] = {\"result\": \"PASS\" if content_ok else \"FAIL\", \"head_hash\": content_hash}\n165\t    if not content_ok:\n166\t        _fail(\"unit content\", \"unit_content_denominator\", \"/content\", \"the admitted content head has no current passing check set\")\n167\t\n168\t    # 8. every required actual visual, provenance, and asset resolution.\n169\t    visual_join = [\n170\t        record\n171\t        for record in state.get(\"visual_join_evidence\") or []\n172\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"phase\") == \"join\"\n173\t    ]\n174\t    visuals_ok = bool(visual_join) and visual_join[-1].get(\"result\") == \"PASS\"\n175\t    categories[\"visuals\"] = {\"result\": \"PASS\" if visuals_ok else \"FAIL\"}\n176\t    if not visuals_ok:\n177\t        _fail(\"unit visual\", \"unit_visual_denominator\", \"/visuals\", \"the visual join has no current passing result\")\n178\t\n179\t    # 9-10. rendered PDF and a positive contiguous page inventory/inspection.\n180\t    inventories = [\n181\t        record\n182\t        for record in state.get(\"unit_page_inventories\") or []\n183\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n184\t    ]\n185\t    inventory = max(inventories, key=lambda record: record.get(\"page_count\", 0)) if inventories else None\n186\t    pdf_sha256 = inventory.get(\"pdf_sha256\") if isinstance(inventory, Mapping) else None\n187\t    inventory_ok = isinstance(inventory, Mapping) and inventory.get(\"result\") == \"PASS\"\n188\t    inspections = [\n189\t        record\n190\t        for record in state.get(\"unit_page_inspections\") or []\n191\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"pdf_sha256\") == pdf_sha256\n192\t    ]\n193\t    expected_pages = inventory.get(\"page_count\") if isinstance(inventory, Mapping) else -1\n194\t    inspections_ok = (\n195\t        inventory_ok\n196\t        and len(inspections) == expected_pages\n197\t        and all(record.get(\"result\") == \"PASS\" for record in inspections)\n198\t    )\n199\t    categories[\"pages\"] = {\"result\": \"PASS\" if inspections_ok else \"FAIL\", \"pdf_sha256\": pdf_sha256, \"page_count\": expected_pages}\n200\t    if not inspections_ok:\n201\t        _fail(\"unit layout\", \"unit_layout_denominator\", \"/pages\", \"the page inventory/inspection set is not current and fully passing\")\n202\t\n203\t    # 11. one independent review of the frozen actual unit, every page included.\n204\t    review = _latest_unit_review(state.get(\"unit_reviews\"), pdf_sha256)\n205\t    review_ok = review is not None\n206\t    if review is not None:\n207\t        payload = candidate_payload(review, \"unit review\")\n208\t        blocking = [\n209\t            entry\n210\t            for entry in payload.get(\"overall_findings\", [])\n211\t            if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n212\t        ]\n213\t        for page_entry in payload.get(\"page_findings\", []):\n214\t            if isinstance(page_entry, Mapping):\n215\t                blocking.extend(\n216\t                    entry for entry in page_entry.get(\"findings\", [])\n217\t                    if isinstance(entry, Mapping) and entry.get(\"severity\") == \"blocking\"\n218\t                )\n219\t        for entry in blocking:\n220\t            owner = repair.owner_for_review_category(entry.get(\"category\"))\n221\t            require(\n222\t                owner is not None,\n223\t                \"invalid_input\",\n224\t                f\"review finding category {entry.get('category')!r} maps to no known owner\",\n225\t                unit_id=unit_id,\n226\t            )\n227\t            findings.append(\n228\t                {\n229\t                    \"check_id\": \"unit_review_finding\",\n230\t                    \"owner\": owner,\n231\t                    \"pointer\": entry.get(\"evidence_reference\") or \"/review\",\n232\t                    \"message\": entry.get(\"description\", \"\"),\n233\t                }\n234\t            )\n235\t        review_ok = not blocking\n236\t    categories[\"review\"] = {\"result\": \"PASS\" if review_ok else \"FAIL\", \"present\": review is not None}\n237\t    if review is None:\n238\t        _fail(\"unit content\", \"unit_review_missing\", \"/review\", \"no independent unit review candidate is present for the current pdf\")\n239\t\n240\t    # 12. complete repair partition, immutable history, and required current retests.\n241\t    unit_repair_requests = [\n242\t        record\n243\t        for record in state.get(\"repair_requests\") or []\n244\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id\n245\t    ]\n246\t    resolved_keys = {\n247\t        record.get(\"request_key\")\n248\t        for record in state.get(\"retest_results\") or []\n249\t        if isinstance(record, Mapping) and record.get(\"unit_id\") == unit_id and record.get(\"resolved\")\n250\t    }\n251\t    open_requests = [record for record in unit_repair_requests if record.get(\"key\") not in resolved_keys]\n252\t    repair_ok = not open_requests\n253\t    categories[\"repair\"] = {\"result\": \"PASS\" if repair_ok else \"FAIL\", \"open_requests\": len(open_requests)}\n254\t    if not repair_ok:\n255\t        _fail(open_requests[0][\"owner\"], \"unit_repair_unresolved\", \"/repair\", \"a repair request remains open (not yet retested)\")\n256\t\n257\t    passed = all(entry.get(\"result\") == \"PASS\" for entry in categories.values())\n258\t    summary_hash = canonical_digest({\"unit_id\": unit_id, \"categories\": categories})\n259\t    check = check_record(\n260\t        scope=\"unit\",\n261\t        owner=unit_id,\n262\t        head_hash=summary_hash,\n263\t        check_id=\"unit_denominator\",\n264\t        attempt=1,\n265\t        result=\"PASS\" if passed else \"FAIL\",\n266\t        detail={\"categories\": categories},\n267\t    )\n268\t    return DenominatorResult(passed=passed, check=check, findings=findings, denominator=categories)\n269\t\n270\t"}]},"parent_tool_use_id":"toolu_019kwJZYNZqUFLgLkAmjUyqq","session_id":"47f42b4a-0f2f-488f-942b-22d2e1825427","uuid":"adba14b1-4e22-4ebf-a61f-c3e1af3d9645","timestamp":"2026-08-13T00:22:32.409Z","subagent_type":"Explore","task_description":"Verify eight-job and invariant evidence"}
