{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019H2HsjmPpREvRMCVX8P3o6","type":"tool_result","content":"304\tdef _record(state: Mapping[str, Any], field: str) -> Mapping[str, Any] | None:\n305\t    value = state.get(field)\n306\t    return value if isinstance(value, Mapping) else None\n307\t\n308\t\n309\tdef interrupt_requested(state: Mapping[str, Any]) -> bool:\n310\t    \"\"\"Whether the node boundary observed a graceful signal at its atomic boundary.\n311\t\n312\t    The boundary (owned by `graph.py`) reads the signal token and records the\n313\t    observation on the guard record, so this stays a pure function of state.\n314\t    \"\"\"\n315\t\n316\t    guard = _record(state, \"pending_guard\")\n317\t    return bool(guard and guard.get(\"interrupt_requested\"))\n318\t\n319\t\n320\tdef _failure_destination(state: Mapping[str, Any], *, model_node: bool) -> str | None:\n321\t    failure = _record(state, \"pending_failure\")\n322\t    if not failure:\n323\t        return None\n324\t    return MODEL_FAILURE_CLASSIFIER if model_node else TERMINAL\n325\t\n326\t\n327\tdef _guard_value(state: Mapping[str, Any], node_id: str) -> tuple[Mapping[str, Any], str]:\n328\t    guard = _record(state, \"pending_guard\")\n329\t    if guard is None:\n330\t        raise RoutingViolation(f\"{node_id}: no guard record was produced for routing\")\n331\t    if guard.get(\"node\") not in (None, node_id):\n332\t        raise RoutingViolation(\n333\t            f\"{node_id}: guard record was emitted by {guard.get('node')!r}\"\n334\t        )\n335\t    value = guard.get(\"value\")\n336\t    if not isinstance(value, str):\n337\t        raise RoutingViolation(f\"{node_id}: guard value {value!r} is not a declared value\")\n338\t    return guard, value\n339\t\n340\t\n341\tdef _dynamic_destination(node_id: str, guard: Mapping[str, Any], detail_key: str) -> str:\n342\t    detail = guard.get(\"detail\")\n343\t    destination = detail.get(detail_key) if isinstance(detail, Mapping) else None\n344\t    if not isinstance(destination, str) or not destination:\n345\t        raise RoutingViolation(\n346\t            f\"{node_id}: guard carries no {detail_key!r} destination\"\n347\t        )\n348\t    return destination\n349\t\n350\t"}]},"parent_tool_use_id":"toolu_019kwJZYNZqUFLgLkAmjUyqq","session_id":"47f42b4a-0f2f-488f-942b-22d2e1825427","uuid":"2af9d51f-32ee-4f55-8f33-f21d9792e079","timestamp":"2026-08-13T00:22:25.115Z","subagent_type":"Explore","task_description":"Verify eight-job and invariant evidence"}
