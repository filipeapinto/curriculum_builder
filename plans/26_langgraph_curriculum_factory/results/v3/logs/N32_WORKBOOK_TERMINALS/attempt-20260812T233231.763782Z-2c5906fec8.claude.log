{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C69CSdeaXsT1e1XZATnKCE","type":"tool_result","content":"1690\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1691\t    tmp_path: Path, monkeypatch\n1692\t) -> None:\n1693\t    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n1694\t\n1695\t    The whole unit path now executes and M05 returns a real independent review.\n1696\t    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n1697\t    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n1698\t    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n1699\t    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n1700\t    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n1701\t    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n1702\t    F1). This only checks the halt is *some* declared row, not pinned to\n1703\t    today's, so it keeps proving \"no fabricated destination\" rather than just\n1704\t    \"today's specific one.\"\n1705\t    \"\"\"\n1706\t\n1707\t    fixture = _build_episode_fixture(tmp_path)\n1708\t    result = _run_episode(monkeypatch, fixture)\n1709\t\n1710\t    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n1711\t\n1712\t    state = result[\"state\"]\n1713\t    assert state.get(\"pending_failure\") is None\n1714\t    assert state.get(\"terminal\") is None\n1715\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1716\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1717\t    # handoff rather than a repair loop that happens to stop here.\n1718\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1719\t    assert sorted(state[\"artifact_heads\"]) == [\n1720\t        \"units/U001/content\",\n1721\t        \"units/U001/domain\",\n1722\t        \"units/U001/visuals\",\n1723\t    ]\n1724\t\n1725\t\n1726\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1727\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n1728\t    tmp_path: Path, monkeypatch, boundary: str\n1729\t) -> None:\n1730\t    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n1731\t\n1732\t    The signal is raised after `boundary` returns. The next boundary observes it,\n1733\t    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n1734\t    resume frontier — never two terminals, and never a product success. The\n1735\t    interrupt takes precedence over the guard value at every boundary, which is\n1736\t    why a signal raised after D09 still reaches the gate rather than D09's own\n1737\t    deferred destination.\n1738\t    \"\"\"\n1739\t\n1740\t    fixture = _build_episode_fixture(tmp_path, units=1)\n1741\t    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n1742\t    trace = result[\"trace\"]\n1743\t    terminal = result[\"state\"].get(\"terminal\")\n1744\t\n1745\t    assert boundary in trace\n1746\t    assert result[\"deferred_frontier\"] is None, (\n1747\t        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n1748\t    )\n1749\t    assert terminal is not None\n1750\t    assert terminal[\"kind\"] == \"INTERRUPTED\"\n1751\t    assert terminal[\"resumable\"] is True\n1752\t    assert terminal[\"exit_code\"] == 10\n1753\t    assert terminal[\"evidence\"][\"resume_frontier\"]\n1754\t    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n1755\t\n1756\t    # Exactly one terminal, counted as terminals and not as D98 entries. An\n1757\t    # interrupt raised inside a `Send` map sends every in-flight branch to the\n1758\t    # gate, so D96 and D98 legitimately run once per branch; what must never\n1759\t    # happen is a second terminal. The extra entries refuse rather than write.\n1760\t    assert len(result[\"state\"][\"terminal_history\"]) == 1\n1761\t    written = [\n1762\t        update\n1763\t        for node_id, update in result[\"updates\"]\n1764\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n1765\t    ]\n1766\t    assert len(written) == 1\n1767\t    for node_id, update in result[\"updates\"]:\n1768\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n1769\t            assert update[\"pending_failure\"][\"cause\"] == \"persistence\""}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"8c91cb61-0fd4-48d1-b4c2-f9c0c14214cd","timestamp":"2026-08-12T23:37:31.570Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T233231.763782Z-2c5906fec8/repo/tests/runtime/test_plan26_unit_graph.py","content":"def test_the_committed_path_stops_at_a_declared_deferred_edge(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n\n    The whole unit path now executes and M05 returns a real independent review.\n    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n    F1). This only checks the halt is *some* declared row, not pinned to\n    today's, so it keeps proving \"no fabricated destination\" rather than just\n    \"today's specific one.\"\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n\n    state = result[\"state\"]\n    assert state.get(\"pending_failure\") is None\n    assert state.get(\"terminal\") is None\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n    # Every deterministic check the path ran passed, so the frontier is a clean\n    # handoff rather than a repair loop that happens to stop here.\n    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n    assert sorted(state[\"artifact_heads\"]) == [\n        \"units/U001/content\",\n        \"units/U001/domain\",\n        \"units/U001/visuals\",\n    ]\n\n\n@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\ndef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n    tmp_path: Path, monkeypatch, boundary: str\n) -> None:\n    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n\n    The signal is raised after `boundary` returns. The next boundary observes it,\n    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n    resume frontier — never two terminals, and never a product success. The\n    interrupt takes precedence over the guard value at every boundary, which is\n    why a signal raised after D09 still reaches the gate rather than D09's own\n    deferred destination.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path, units=1)\n    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n    trace = result[\"trace\"]\n    terminal = result[\"state\"].get(\"terminal\")\n\n    assert boundary in trace\n    assert result[\"deferred_frontier\"] is None, (\n        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n    )\n    assert terminal is not None\n    assert terminal[\"kind\"] == \"INTERRUPTED\"\n    assert terminal[\"resumable\"] is True\n    assert terminal[\"exit_code\"] == 10\n    assert terminal[\"evidence\"][\"resume_frontier\"]\n    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n\n    # Exactly one terminal, counted as terminals and not as D98 entries. An\n    # interrupt raised inside a `Send` map sends every in-flight branch to the\n    # gate, so D96 and D98 legitimately run once per branch; what must never\n    # happen is a second terminal. The extra entries refuse rather than write.\n    assert len(result[\"state\"][\"terminal_history\"]) == 1\n    written = [\n        update\n        for node_id, update in result[\"updates\"]\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n    ]\n    assert len(written) == 1\n    for node_id, update in result[\"updates\"]:\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"","numLines":80,"startLine":1690,"totalLines":2701}}}
