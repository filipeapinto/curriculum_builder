{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NZobLogKSfq7qnLSzcTHgo","type":"tool_result","content":"2642\tdef test_this_nodes_renderers_are_a_test_double_and_not_exposed_to_n13s_store_gap(\n2643\t    tmp_path: Path, monkeypatch\n2644\t) -> None:\n2645\t    \"\"\"N13 generation 2 raised two gaps this node must state a position on.\n2646\t\n2647\t    `plan26/n13/artifact-bodies-never-reach-the-store`: no deterministic node\n2648\t    calls `ArtifactStore.admit_version`, so D08/D09/D12 advance heads in graph\n2649\t    state only and nothing writes the admitted *bytes*. A production\n2650\t    `CliTransport.render_unit`, which is handed head hashes and must resolve the\n2651\t    bodies out of the content store, therefore raises `RenderFault`.\n2652\t    `plan26/n13/visual-assets-are-unreachable-from-d13`: D13 passes no asset map,\n2653\t    so a production unit PDF is prose-only.\n2654\t\n2655\t    Neither is inherited by this node's proof, and that is checked rather than\n2656\t    assumed: the harness `transport_registry` is a test double that composes its\n2657\t    own bytes from the arguments it is handed and never reads the store, so the\n2658\t    graph-orchestration claims here hold with or without the store gap. Both\n2659\t    findings are real and both are N22/N31/N32/N40's to close before a live run.\n2660\t    \"\"\"\n2661\t\n2662\t    # The gap N13 named is real and still open: nothing in `nodes/` persists bodies.\n2663\t    from runtime.langgraph_factory import artifacts as A\n2664\t\n2665\t    assert hasattr(A.ArtifactStore, \"admit_version\")\n2666\t    nodes_dir = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"nodes\"\n2667\t    callers = [\n2668\t        path.name\n2669\t        for path in sorted(nodes_dir.glob(\"*.py\"))\n2670\t        if \"admit_version\" in path.read_text(encoding=\"utf-8\")\n2671\t    ]\n2672\t    assert callers == [], f\"{callers} now persists artifact bodies; revisit this note\"\n2673\t\n2674\t    # This node's renderers do not depend on it: no method of the harness registry\n2675\t    # names the store, the path guard, or the output root.\n2676\t    source = inspect.getsource(_StubRegistry)\n2677\t    for forbidden in (\"ArtifactStore\", \"admit_version\", \"path_guard\", \"output_root\"):\n2678\t        assert forbidden not in source\n2679\t\n2680\t    # And the episode really renders, inspects and admits without a single blob.\n2681\t    fixture = _build_episode_fixture(tmp_path)\n2682\t    result = _run_episode(monkeypatch, fixture)\n2683\t    store_root = fixture[\"output_root\"]\n2684\t    blobs = [path for path in store_root.rglob(\"*\") if path.is_file() and \"artifact\" in str(path)]\n2685\t    assert blobs == [], blobs\n2686\t    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n2687\t    assert result[\"state\"][\"unit_page_inventories\"][0][\"result\"] == \"PASS\"\n2688\t\n2689\t\n2690\tdef test_blocked_the_review_handoff_to_n31_is_declared_not_wired(available) -> None:\n2691\t    \"\"\"A clean D16 is N31's handoff; D16 has no body, so the edge is declared."}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"7f13818d-3a78-4aa5-a677-03928ec73775","timestamp":"2026-08-12T23:37:40.111Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T233231.763782Z-2c5906fec8/repo/tests/runtime/test_plan26_unit_graph.py","content":"def test_this_nodes_renderers_are_a_test_double_and_not_exposed_to_n13s_store_gap(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"N13 generation 2 raised two gaps this node must state a position on.\n\n    `plan26/n13/artifact-bodies-never-reach-the-store`: no deterministic node\n    calls `ArtifactStore.admit_version`, so D08/D09/D12 advance heads in graph\n    state only and nothing writes the admitted *bytes*. A production\n    `CliTransport.render_unit`, which is handed head hashes and must resolve the\n    bodies out of the content store, therefore raises `RenderFault`.\n    `plan26/n13/visual-assets-are-unreachable-from-d13`: D13 passes no asset map,\n    so a production unit PDF is prose-only.\n\n    Neither is inherited by this node's proof, and that is checked rather than\n    assumed: the harness `transport_registry` is a test double that composes its\n    own bytes from the arguments it is handed and never reads the store, so the\n    graph-orchestration claims here hold with or without the store gap. Both\n    findings are real and both are N22/N31/N32/N40's to close before a live run.\n    \"\"\"\n\n    # The gap N13 named is real and still open: nothing in `nodes/` persists bodies.\n    from runtime.langgraph_factory import artifacts as A\n\n    assert hasattr(A.ArtifactStore, \"admit_version\")\n    nodes_dir = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"nodes\"\n    callers = [\n        path.name\n        for path in sorted(nodes_dir.glob(\"*.py\"))\n        if \"admit_version\" in path.read_text(encoding=\"utf-8\")\n    ]\n    assert callers == [], f\"{callers} now persists artifact bodies; revisit this note\"\n\n    # This node's renderers do not depend on it: no method of the harness registry\n    # names the store, the path guard, or the output root.\n    source = inspect.getsource(_StubRegistry)\n    for forbidden in (\"ArtifactStore\", \"admit_version\", \"path_guard\", \"output_root\"):\n        assert forbidden not in source\n\n    # And the episode really renders, inspects and admits without a single blob.\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    store_root = fixture[\"output_root\"]\n    blobs = [path for path in store_root.rglob(\"*\") if path.is_file() and \"artifact\" in str(path)]\n    assert blobs == [], blobs\n    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n    assert result[\"state\"][\"unit_page_inventories\"][0][\"result\"] == \"PASS\"\n\n\ndef test_blocked_the_review_handoff_to_n31_is_declared_not_wired(available) -> None:\n    \"\"\"A clean D16 is N31's handoff; D16 has no body, so the edge is declared.","numLines":50,"startLine":2642,"totalLines":2701}}}
