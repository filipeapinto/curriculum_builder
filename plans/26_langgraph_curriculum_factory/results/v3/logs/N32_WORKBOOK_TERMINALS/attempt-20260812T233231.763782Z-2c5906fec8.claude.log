{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019n9ULsxFuRfNDpZAvDaG5U","type":"tool_result","content":"1703\t\n1704\t\n1705\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1706\t    tmp_path: Path, monkeypatch\n1707\t) -> None:\n1708\t    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n1709\t\n1710\t    The whole unit path now executes and M05 returns a real independent review.\n1711\t    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n1712\t    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n1713\t    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n1714\t    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n1715\t    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n1716\t    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n1717\t    F1). This only checks the halt is *some* declared row, not pinned to\n1718\t    today's, so it keeps proving \"no fabricated destination\" rather than just\n1719\t    \"today's specific one.\"\n1720\t    \"\"\"\n1721\t\n1722\t    fixture = _build_episode_fixture(tmp_path)\n1723\t    result = _run_episode(monkeypatch, fixture)\n1724\t\n1725\t    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n1726\t\n1727\t    state = result[\"state\"]\n1728\t    assert state.get(\"pending_failure\") is None\n1729\t    assert state.get(\"terminal\") is None\n1730\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1731\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1732\t    # handoff rather than a repair loop that happens to stop here.\n1733\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1734\t    assert sorted(state[\"artifact_heads\"]) == [\n1735\t        \"units/U001/content\",\n1736\t        \"units/U001/domain\",\n1737\t        \"units/U001/visuals\",\n1738\t    ]\n1739\t\n1740\t\n1741\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1742\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal("}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"a50694d0-657a-493b-a66d-20032bbee50b","timestamp":"2026-08-12T23:38:30.581Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T233231.763782Z-2c5906fec8/repo/tests/runtime/test_plan26_unit_graph.py","content":"\n\ndef test_the_committed_path_stops_at_a_declared_deferred_edge(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n\n    The whole unit path now executes and M05 returns a real independent review.\n    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n    F1). This only checks the halt is *some* declared row, not pinned to\n    today's, so it keeps proving \"no fabricated destination\" rather than just\n    \"today's specific one.\"\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n\n    state = result[\"state\"]\n    assert state.get(\"pending_failure\") is None\n    assert state.get(\"terminal\") is None\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n    # Every deterministic check the path ran passed, so the frontier is a clean\n    # handoff rather than a repair loop that happens to stop here.\n    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n    assert sorted(state[\"artifact_heads\"]) == [\n        \"units/U001/content\",\n        \"units/U001/domain\",\n        \"units/U001/visuals\",\n    ]\n\n\n@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\ndef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(","numLines":40,"startLine":1703,"totalLines":2716}}}
