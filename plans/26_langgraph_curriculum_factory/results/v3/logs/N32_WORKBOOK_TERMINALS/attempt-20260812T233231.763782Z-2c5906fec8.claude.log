{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UPAcP9g3p3dVGybL3pSo5H","type":"tool_result","content":"1466\tdef test_a_visual_denominator_permutation_produces_an_identical_admitted_head(\n1467\t    tmp_path: Path, monkeypatch\n1468\t) -> None:\n1469\t    \"\"\"Prompt TEST 5: the order the briefs are declared in cannot move the head.\n1470\t\n1471\t    Two real episodes, identical but for the order M03 declares its two visuals\n1472\t    in. The denominator members, the join, and the admitted `visuals` head hash\n1473\t    must all be identical: a join whose answer depended on arrival or declaration\n1474\t    order would admit a different artifact for the same content, which is exactly\n1475\t    what a content-addressed head is supposed to make impossible.\n1476\t    \"\"\"\n1477\t\n1478\t    def run(order: list[dict[str, Any]]) -> dict[str, Any]:\n1479\t        monkeypatch.setattr(\n1480\t            sys.modules[__name__], \"DECLARED_VISUALS\", order, raising=True\n1481\t        )\n1482\t        fixture = _build_episode_fixture(tmp_path / f\"perm-{len(order)}-{order[0]['role']}\")\n1483\t        return _run_episode(monkeypatch, fixture)\n1484\t\n1485\t    forward = run(list(DECLARED_VISUALS))\n1486\t    reverse = run(list(reversed(DECLARED_VISUALS)))\n1487\t\n1488\t    for result in (forward, reverse):\n1489\t        _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n1490\t        assert result[\"trace\"].count(\"D11_CREATE_DETERMINISTIC_VISUALS\") == 1\n1491\t        assert result[\"trace\"].count(\"M04_CREATE_UNIT_VISUALS\") == 1\n1492\t\n1493\t    assert forward[\"deferred_frontier\"] == reverse[\"deferred_frontier\"]\n1494\t\n1495\t    def denominator(result: dict[str, Any]) -> dict[str, Any]:\n1496\t        record = dict(next(iter(result[\"state\"][\"visual_denominators\"].values())))\n1497\t        record.pop(\"content_hash\", None)\n1498\t        return record\n1499\t\n1500\t    assert denominator(forward) == denominator(reverse)\n1501\t    assert (\n1502\t        forward[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n1503\t        == reverse[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n1504\t    )\n1505\t\n1506\t    join = [\n1507\t        record for record in forward[\"state\"][\"visual_join_evidence\"]\n1508\t        if record[\"phase\"] == \"join\"\n1509\t    ]\n1510\t    assert [record[\"result\"] for record in join] == [\"PASS\"]\n1511\t    assert join[0][\"denominator_size\"] == join[0][\"actual_size\"] == 2\n1512\t\n1513\t\n1514\tdef test_an_actual_pdf_and_a_positive_contiguous_page_inventory_are_required(\n1515\t    tmp_path: Path, monkeypatch\n1516\t) -> None:\n1517\t    \"\"\"Prompt TEST 6, positive half, on a real episode.\n1518\t\n1519\t    D13's declared PDF hash is re-derived from the bytes on disk by D13 itself and\n1520\t    again by D14, and D14's inventory is positive and numbered 1..N with a real\n1521\t    image and a real hash per page.\n1522\t    \"\"\"\n1523\t\n1524\t    fixture = _build_episode_fixture(tmp_path)\n1525\t    result = _run_episode(monkeypatch, fixture)\n1526\t    state = result[\"state\"]\n1527\t\n1528\t    layout = next(\n1529\t        record for record in state[\"artifact_versions\"]\n1530\t        if record.get(\"stream\") == \"units/U001/layout\"\n1531\t    )\n1532\t    pdf = Path(layout[\"pdf_path\"])\n1533\t    assert pdf.is_file()\n1534\t    assert _sha256_file(pdf) == layout[\"pdf_sha256\"]\n1535\t    assert Path(layout[\"layout_path\"]).is_file()\n1536\t\n1537\t    inventory = state[\"unit_page_inventories\"][0]\n1538\t    assert inventory[\"result\"] == \"PASS\"\n1539\t    assert inventory[\"contiguous\"] is True\n1540\t    assert inventory[\"page_count\"] == 2\n1541\t    assert inventory[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n1542\t\n1543\t    inspections = state[\"unit_page_inspections\"]\n1544\t    assert [record[\"page\"] for record in inspections] == [1, 2]\n1545\t    seen: set[str] = set()\n1546\t    for record in inspections:\n1547\t        assert record[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n1548\t        image = Path(record[\"image_path\"])\n1549\t        assert image.is_file()\n1550\t        assert record[\"page_sha256\"] == _sha256_file(image)\n1551\t        assert record[\"page_sha256\"] not in seen\n1552\t        seen.add(record[\"page_sha256\"])\n1553\t        assert record[\"result\"] == \"PASS\"\n1554\t\n1555\t    # The deterministic renderer's own asset is real too, and was written by D11\n1556\t    # rather than described by a model.\n1557\t    visual = state[\"visual_results\"][\"U001/visual/build_map\"]\n1558\t    assert visual[\"provenance\"] == \"deterministic_renderer\"\n1559\t    asset = Path(visual[\"asset_path\"])\n1560\t    assert asset.is_file()\n1561\t    assert visual[\"sha256\"] == _sha256_file(asset)\n1562\t\n1563\t\n1564\t@pytest.mark.parametrize(\n1565\t    \"defect\","}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"70af312b-40bb-4f72-905a-20c25cba5ff9","timestamp":"2026-08-12T23:37:20.318Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T233231.763782Z-2c5906fec8/repo/tests/runtime/test_plan26_unit_graph.py","content":"def test_a_visual_denominator_permutation_produces_an_identical_admitted_head(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 5: the order the briefs are declared in cannot move the head.\n\n    Two real episodes, identical but for the order M03 declares its two visuals\n    in. The denominator members, the join, and the admitted `visuals` head hash\n    must all be identical: a join whose answer depended on arrival or declaration\n    order would admit a different artifact for the same content, which is exactly\n    what a content-addressed head is supposed to make impossible.\n    \"\"\"\n\n    def run(order: list[dict[str, Any]]) -> dict[str, Any]:\n        monkeypatch.setattr(\n            sys.modules[__name__], \"DECLARED_VISUALS\", order, raising=True\n        )\n        fixture = _build_episode_fixture(tmp_path / f\"perm-{len(order)}-{order[0]['role']}\")\n        return _run_episode(monkeypatch, fixture)\n\n    forward = run(list(DECLARED_VISUALS))\n    reverse = run(list(reversed(DECLARED_VISUALS)))\n\n    for result in (forward, reverse):\n        _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n        assert result[\"trace\"].count(\"D11_CREATE_DETERMINISTIC_VISUALS\") == 1\n        assert result[\"trace\"].count(\"M04_CREATE_UNIT_VISUALS\") == 1\n\n    assert forward[\"deferred_frontier\"] == reverse[\"deferred_frontier\"]\n\n    def denominator(result: dict[str, Any]) -> dict[str, Any]:\n        record = dict(next(iter(result[\"state\"][\"visual_denominators\"].values())))\n        record.pop(\"content_hash\", None)\n        return record\n\n    assert denominator(forward) == denominator(reverse)\n    assert (\n        forward[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n        == reverse[\"state\"][\"artifact_heads\"][\"units/U001/visuals\"][\"hash\"]\n    )\n\n    join = [\n        record for record in forward[\"state\"][\"visual_join_evidence\"]\n        if record[\"phase\"] == \"join\"\n    ]\n    assert [record[\"result\"] for record in join] == [\"PASS\"]\n    assert join[0][\"denominator_size\"] == join[0][\"actual_size\"] == 2\n\n\ndef test_an_actual_pdf_and_a_positive_contiguous_page_inventory_are_required(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"Prompt TEST 6, positive half, on a real episode.\n\n    D13's declared PDF hash is re-derived from the bytes on disk by D13 itself and\n    again by D14, and D14's inventory is positive and numbered 1..N with a real\n    image and a real hash per page.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n    state = result[\"state\"]\n\n    layout = next(\n        record for record in state[\"artifact_versions\"]\n        if record.get(\"stream\") == \"units/U001/layout\"\n    )\n    pdf = Path(layout[\"pdf_path\"])\n    assert pdf.is_file()\n    assert _sha256_file(pdf) == layout[\"pdf_sha256\"]\n    assert Path(layout[\"layout_path\"]).is_file()\n\n    inventory = state[\"unit_page_inventories\"][0]\n    assert inventory[\"result\"] == \"PASS\"\n    assert inventory[\"contiguous\"] is True\n    assert inventory[\"page_count\"] == 2\n    assert inventory[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n\n    inspections = state[\"unit_page_inspections\"]\n    assert [record[\"page\"] for record in inspections] == [1, 2]\n    seen: set[str] = set()\n    for record in inspections:\n        assert record[\"pdf_sha256\"] == layout[\"pdf_sha256\"]\n        image = Path(record[\"image_path\"])\n        assert image.is_file()\n        assert record[\"page_sha256\"] == _sha256_file(image)\n        assert record[\"page_sha256\"] not in seen\n        seen.add(record[\"page_sha256\"])\n        assert record[\"result\"] == \"PASS\"\n\n    # The deterministic renderer's own asset is real too, and was written by D11\n    # rather than described by a model.\n    visual = state[\"visual_results\"][\"U001/visual/build_map\"]\n    assert visual[\"provenance\"] == \"deterministic_renderer\"\n    asset = Path(visual[\"asset_path\"])\n    assert asset.is_file()\n    assert visual[\"sha256\"] == _sha256_file(asset)\n\n\n@pytest.mark.parametrize(\n    \"defect\",","numLines":100,"startLine":1466,"totalLines":2701}}}
