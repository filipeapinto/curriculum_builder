{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0147ZpQ8UCVaCvYPKk4wwKWG","type":"tool_result","content":"753\tdef test_the_compiled_graph_really_registers_the_workbook_engine(tmp_path: Path) -> None:\n754\t    \"\"\"`register_workbook_topology` wires a real, internally-consistent branch.\n755\t\n756\t    D24 is deliberately unreachable from `D05_SELECT_NEXT_UNIT` in this\n757\t    generation (`test_blocked_d05_cannot_reach_d24_yet` below names why, and\n758\t    who owns closing it), and LangGraph's own `get_graph()` drawing prunes\n759\t    edges with no path from `START` -- so this asserts against the builder's\n760\t    own registered `branches` (the actual routing table LangGraph compiles\n761\t    from), not the pruned visualization `compiled_topology()` returns.\n762\t    \"\"\"\n763\t\n764\t    from langgraph.graph import StateGraph\n765\t\n766\t    from runtime.langgraph_factory.state import FactoryInput, FactoryOutput, FactoryState, RuntimeContext\n767\t\n768\t    builder = StateGraph(\n769\t        FactoryState, context_schema=RuntimeContext, input_schema=FactoryInput, output_schema=FactoryOutput\n770\t    )\n771\t    G.register_skeleton(builder, G.binding_inventory())\n772\t    resolved = G.register_workbook_topology(builder)\n773\t\n774\t    for node_id in workbook.WORKBOOK_NODE_BODIES:\n775\t        assert node_id in builder.nodes\n776\t\n777\t    assert set(resolved[\"D24_PROVE_EXACT_MANIFEST_COVERAGE\"]) == {\n778\t        \"D25_ASSEMBLE_WORKBOOK\", \"D98_WRITE_TERMINAL\", \"D96_GRACEFUL_INTERRUPT_GATE\"\n779\t    }\n780\t    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D25_ASSEMBLE_WORKBOOK\"]\n781\t    assert set(resolved[\"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\"]) >= {\n782\t        \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n783\t    }\n784\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" in resolved[\"D27_FREEZE_WORKBOOK_REVIEW_PACKET\"]\n785\t    assert set(resolved[\"D28_REDUCE_WORKBOOK_EVIDENCE\"]) >= {\n786\t        \"D32_RECOMPUTE_FINAL_RELEASE\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n787\t    }\n788\t    assert set(resolved[\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"]) >= {\n789\t        \"D90_RESERVE_MODEL_ATTEMPT\", \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\", \"D98_WRITE_TERMINAL\"\n790\t    }\n791\t    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\"]\n792\t    assert set(resolved[\"D32_RECOMPUTE_FINAL_RELEASE\"]) >= {\n793\t        \"D98_WRITE_TERMINAL\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n794\t    }\n795\t    assert \"D28_REDUCE_WORKBOOK_EVIDENCE\" in resolved[\"M07_REVIEW_ACTUAL_WORKBOOK\"]\n796\t    assert \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\" in resolved[\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\"]\n797\t\n798\t    # No branch this module registered names `END` or `START` -- D98 is the\n799\t    # sole terminal writer and D24/D32 only ever propose a candidate to it.\n800\t    for destinations in resolved.values():\n801\t        assert \"END\" not in destinations and \"__end__\" not in destinations\n802\t        assert \"START\" not in destinations and \"__start__\" not in destinations\n803\t\n804\t    # The real graph still compiles with this branch attached.\n805\t    saver, _connection = G.open_checkpoint_saver(tmp_path / \"out\")\n806\t    compiled = builder.compile(checkpointer=saver, name=G.GRAPH_NAME)\n807\t    assert compiled.name == G.GRAPH_NAME\n808\t\n809\t\n810\tdef test_blocked_d05_cannot_reach_d24_yet() -> None:\n811\t    \"\"\"Owned by N30_UNIT_GRAPH: `D05`'s one registered branch predates D24.\n812\t\n813\t    `unit_graph.UNIT_BRANCHES` registers exactly one conditional-edge branch\n814\t    for `D05_SELECT_NEXT_UNIT`, using `unit_graph.py`'s own frozen\n815\t    `MODEL_BRANCH_DESTINATIONS`-independent fallback\n816\t    (`routing.guard_destinations`), narrowed to `unit_graph.py`'s own\n817\t    `available` argument at registration time. `unit_graph.DEFERRED_EDGES`\n818\t    explicitly declares `(D05_SELECT_NEXT_UNIT, manifest_exhausted, D24_...,\n819\t    N32_WORKBOOK_TERMINALS)` as a row whose destination has no node body --\n820\t    a declaration this node cannot invalidate without either registering a\n821\t    second, colliding branch on the same source (LangGraph raises\n822\t    `ValueError: Branch ... already exists`) or editing `unit_graph.py`\n823\t    itself, which is outside this node's write set. D24 is therefore\n824\t    registered as a real node with real outgoing edges (proven above) but is\n825\t    not yet reachable from `D05` in the compiled graph -- an honest,\n826\t    structural consequence of `binding_inventory()` staying exactly what it\n827\t    was before N32 (see that function's own docstring), not a defect in D24's\n828\t    own implementation. Closing this is N30_UNIT_GRAPH's\n829\t    `unit_flow_or_denominator` rework edge: widen `MODEL_BRANCH_DESTINATIONS`/\n830\t    `UNIT_BRANCHES`' fallback to include `D24_PROVE_EXACT_MANIFEST_COVERAGE`.\n831\t    \"\"\"\n832\t\n833\t    assert (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\") in U.DEFERRED_EDGES\n834\t    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" not in G.binding_inventory()\n835\t    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" in G.full_binding_inventory()\n836\t\n837\t\n838\tdef test_blocked_d91_cannot_reach_d29_yet() -> None:\n839\t    \"\"\"Owned by N30_UNIT_GRAPH: `D91`'s one registered branch predates D29.\n840\t\n841\t    `unit_graph.MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]` is a\n842\t    frozen 4-tuple that names `D17_CLASSIFY_UNIT_FINDINGS` (the unit repair\n843\t    classifier) but not `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR`. `D91` is a\n844\t    shared bookkeeping node `unit_graph.py` already registers exactly one\n845\t    branch for; this node cannot register a second branch on the same source\n846\t    (every branch on a node fires on each of its executions, so a second,\n847\t    narrower branch would not shadow the first -- it would double-fire and\n848\t    `KeyError` on the first branch's own narrower `ends`), and cannot widen\n849\t    `unit_graph.py`'s table directly (outside this node's write set). A\n850\t    transport failure on `M07`/`M08` that `model_nodes\n851\t    ._repair_destination` classifies as workbook-repairable therefore cannot\n852\t    reach `D29` through the compiled graph in this generation.\n853\t    `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR` itself is fully implemented and\n854\t    independently correct (see the TEST 4/5 cases above, and\n855\t    `model_nodes._repair_destination`'s own routing logic); only the\n856\t    registered graph edge is missing. Closing this is N30_UNIT_GRAPH's\n857\t    `unit_flow_or_denominator` rework edge: add\n858\t    `\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"` to\n859\t    `MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]`.\n860\t    \"\"\"\n861\t\n862\t    from runtime.langgraph_factory import model_nodes as mn\n863\t\n864\t    assert mn._repair_destination(\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\") == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\""}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"89409dab-ceca-43ee-beeb-9862a6c21cc2","timestamp":"2026-08-12T23:39:15.967Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T233231.763782Z-2c5906fec8/repo/tests/runtime/test_plan26_workbook.py","content":"def test_the_compiled_graph_really_registers_the_workbook_engine(tmp_path: Path) -> None:\n    \"\"\"`register_workbook_topology` wires a real, internally-consistent branch.\n\n    D24 is deliberately unreachable from `D05_SELECT_NEXT_UNIT` in this\n    generation (`test_blocked_d05_cannot_reach_d24_yet` below names why, and\n    who owns closing it), and LangGraph's own `get_graph()` drawing prunes\n    edges with no path from `START` -- so this asserts against the builder's\n    own registered `branches` (the actual routing table LangGraph compiles\n    from), not the pruned visualization `compiled_topology()` returns.\n    \"\"\"\n\n    from langgraph.graph import StateGraph\n\n    from runtime.langgraph_factory.state import FactoryInput, FactoryOutput, FactoryState, RuntimeContext\n\n    builder = StateGraph(\n        FactoryState, context_schema=RuntimeContext, input_schema=FactoryInput, output_schema=FactoryOutput\n    )\n    G.register_skeleton(builder, G.binding_inventory())\n    resolved = G.register_workbook_topology(builder)\n\n    for node_id in workbook.WORKBOOK_NODE_BODIES:\n        assert node_id in builder.nodes\n\n    assert set(resolved[\"D24_PROVE_EXACT_MANIFEST_COVERAGE\"]) == {\n        \"D25_ASSEMBLE_WORKBOOK\", \"D98_WRITE_TERMINAL\", \"D96_GRACEFUL_INTERRUPT_GATE\"\n    }\n    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D25_ASSEMBLE_WORKBOOK\"]\n    assert set(resolved[\"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\"]) >= {\n        \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    }\n    assert \"D90_RESERVE_MODEL_ATTEMPT\" in resolved[\"D27_FREEZE_WORKBOOK_REVIEW_PACKET\"]\n    assert set(resolved[\"D28_REDUCE_WORKBOOK_EVIDENCE\"]) >= {\n        \"D32_RECOMPUTE_FINAL_RELEASE\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    }\n    assert set(resolved[\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"]) >= {\n        \"D90_RESERVE_MODEL_ATTEMPT\", \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\", \"D98_WRITE_TERMINAL\"\n    }\n    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\"]\n    assert set(resolved[\"D32_RECOMPUTE_FINAL_RELEASE\"]) >= {\n        \"D98_WRITE_TERMINAL\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    }\n    assert \"D28_REDUCE_WORKBOOK_EVIDENCE\" in resolved[\"M07_REVIEW_ACTUAL_WORKBOOK\"]\n    assert \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\" in resolved[\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\"]\n\n    # No branch this module registered names `END` or `START` -- D98 is the\n    # sole terminal writer and D24/D32 only ever propose a candidate to it.\n    for destinations in resolved.values():\n        assert \"END\" not in destinations and \"__end__\" not in destinations\n        assert \"START\" not in destinations and \"__start__\" not in destinations\n\n    # The real graph still compiles with this branch attached.\n    saver, _connection = G.open_checkpoint_saver(tmp_path / \"out\")\n    compiled = builder.compile(checkpointer=saver, name=G.GRAPH_NAME)\n    assert compiled.name == G.GRAPH_NAME\n\n\ndef test_blocked_d05_cannot_reach_d24_yet() -> None:\n    \"\"\"Owned by N30_UNIT_GRAPH: `D05`'s one registered branch predates D24.\n\n    `unit_graph.UNIT_BRANCHES` registers exactly one conditional-edge branch\n    for `D05_SELECT_NEXT_UNIT`, using `unit_graph.py`'s own frozen\n    `MODEL_BRANCH_DESTINATIONS`-independent fallback\n    (`routing.guard_destinations`), narrowed to `unit_graph.py`'s own\n    `available` argument at registration time. `unit_graph.DEFERRED_EDGES`\n    explicitly declares `(D05_SELECT_NEXT_UNIT, manifest_exhausted, D24_...,\n    N32_WORKBOOK_TERMINALS)` as a row whose destination has no node body --\n    a declaration this node cannot invalidate without either registering a\n    second, colliding branch on the same source (LangGraph raises\n    `ValueError: Branch ... already exists`) or editing `unit_graph.py`\n    itself, which is outside this node's write set. D24 is therefore\n    registered as a real node with real outgoing edges (proven above) but is\n    not yet reachable from `D05` in the compiled graph -- an honest,\n    structural consequence of `binding_inventory()` staying exactly what it\n    was before N32 (see that function's own docstring), not a defect in D24's\n    own implementation. Closing this is N30_UNIT_GRAPH's\n    `unit_flow_or_denominator` rework edge: widen `MODEL_BRANCH_DESTINATIONS`/\n    `UNIT_BRANCHES`' fallback to include `D24_PROVE_EXACT_MANIFEST_COVERAGE`.\n    \"\"\"\n\n    assert (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\") in U.DEFERRED_EDGES\n    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" not in G.binding_inventory()\n    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" in G.full_binding_inventory()\n\n\ndef test_blocked_d91_cannot_reach_d29_yet() -> None:\n    \"\"\"Owned by N30_UNIT_GRAPH: `D91`'s one registered branch predates D29.\n\n    `unit_graph.MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]` is a\n    frozen 4-tuple that names `D17_CLASSIFY_UNIT_FINDINGS` (the unit repair\n    classifier) but not `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR`. `D91` is a\n    shared bookkeeping node `unit_graph.py` already registers exactly one\n    branch for; this node cannot register a second branch on the same source\n    (every branch on a node fires on each of its executions, so a second,\n    narrower branch would not shadow the first -- it would double-fire and\n    `KeyError` on the first branch's own narrower `ends`), and cannot widen\n    `unit_graph.py`'s table directly (outside this node's write set). A\n    transport failure on `M07`/`M08` that `model_nodes\n    ._repair_destination` classifies as workbook-repairable therefore cannot\n    reach `D29` through the compiled graph in this generation.\n    `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR` itself is fully implemented and\n    independently correct (see the TEST 4/5 cases above, and\n    `model_nodes._repair_destination`'s own routing logic); only the\n    registered graph edge is missing. Closing this is N30_UNIT_GRAPH's\n    `unit_flow_or_denominator` rework edge: add\n    `\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"` to\n    `MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]`.\n    \"\"\"\n\n    from runtime.langgraph_factory import model_nodes as mn\n\n    assert mn._repair_destination(\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\") == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"","numLines":112,"startLine":753,"totalLines":866}}}
