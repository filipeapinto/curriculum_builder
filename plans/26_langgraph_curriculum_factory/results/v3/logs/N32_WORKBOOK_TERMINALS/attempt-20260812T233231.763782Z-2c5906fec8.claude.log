ripted claim\",\n459\t                            \"source_quote\": \"scripted quote\",\n460\t                            \"source_location\": \"p.1\",\n461\t                        }\n462\t                    ],\n463\t                    \"limitations\": [],\n464\t                }\n465\t                for record in group.get(\"retrieved_records\", [])\n466\t            ]\n467\t        }\n468\t    if job_id == \"M02_CREATE_UNIT_DOMAIN_DATA\":\n469\t        unit_id = projection[\"unit\"].get(\"unit_id\")\n470\t        admitted = projection.get(\"admitted_sources\") or []\n471\t        # Every declared fact resolves to an admitted source, which is D08's\n472\t        # `domain_facts_sourced` check: the body is derived from the join, not\n473\t        # invented alongside it.\n474\t        facts = [\n475\t            {"}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"eea882f2-d5a4-46a3-bb2c-1b4d0d56ec6c","timestamp":"2026-08-12T23:40:21.442Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T233231.763782Z-2c5906fec8/repo/tests/runtime/test_plan26_unit_graph.py","content":"class _HarnessContext:\n    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n\n    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n        from runtime.langgraph_factory.artifacts import ArtifactStore\n        from runtime.langgraph_factory.evidence import EvidenceStore\n\n        self.engine_root = engine_root\n        self.output_root = output_root\n        self.path_guard = ArtifactStore(output_root)\n        self.evidence_service = EvidenceStore(output_root)\n        self.transport_registry = _StubRegistry(sandbox)\n        self.source_retriever = _StubRetriever()\n        self.signal_token = _SwitchableToken()\n        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n\n