tENGINE_CONTRACTS: tuple[str, ...] = (\n581\t    \"schemas/manifest_domain.metaschema.v1.json\",\n582\t    \"policy/calibration.v1.yaml\",\n583\t    \"meta_prompt/assets/pedagogy.v1.md\",\n584\t    *domain.CURRICULUM_CONTRACTS,\n585\t)\n586\t\n587\t# The synthetic curriculum's own declared domain contract. A run that declares one\n588\t# is the path D02/D08 are built for; the engine metaschema constrains the shape of\n589\t# *this* file, not the domain instance a unit asserts.\n590\tSYNTHETIC_DOMAIN_SCHEMA_RELATIVE = \"schemas/synthetic_domain.v1.json\"\n591\tSYNTHETIC_DOMAIN_SCHEMA: dict[str, Any] = {\n592\t    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n593\t    \"$id\": \"plan26/test/synthetic_domain.v1.json\",\n594\t    \"type\": \"object\",\n595\t    \"additionalProperties\": False,\n596\t    \"required\": [\"unit_id\", \"facts\", \"verifier_result\"],\n597\t    \"properties\": {\n598\t        \"unit_id\": {\"type\": \"string\", \"minLength\": 1},\n599\t        \"facts\": {\n600\t            \"type\": \"array\",\n601\t            \"minItems\": 1,\n602\t            \"items\": {\n603\t                \"type\": \"object\",\n604\t                \"additionalProperties\": False,\n605\t                \"required\": [\"fact_id\", \"statement\"],\n606\t                \"properties\": {\n607\t                    \"fact_id\": {\"type\": \"string\", \"minLength\": 1},\n608\t                    \"statement\": {\"type\": \"string\", \"minLength\": 1},\n609\t                },\n610\t            },\n611\t        },\n612\t        \"verifier_result\": {\n613\t            \"type\": \"object\",\n614\t            \"additionalProperties\": True,\n615\t            \"required\": [\"result\"],\n616\t            \"properties\": {\"result\": {\"type\": \"string\"}},\n617\t        },\n618\t    },\n619\t}"}]},"parent_tool_use_id":null,"session_id":"5d3513ce-8315-45bf-a456-35d8284d697b","uuid":"449adba4-e2e0-4ed4-9238-c55f880381d3","timestamp":"2026-08-12T23:40:34.675Z"