{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ZUV9MpMXFHnzCysG9qM7H","type":"tool_result","content":"393\tclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n394\t    \"\"\"Composes each canned candidate from the projection it is handed.\n395\t\n396\t    Still a `FakeCliTransport`, so the real output-schema and no-authoritative-\n397\t    field validation still runs, and it is still refused by\n398\t    `build_model_node_context`.\n399\t    \"\"\"\n400\t\n401\t    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:\n402\t        super().__init__(sandbox_root=sandbox_root, responses={}, registry=registry)\n403\t        self.calls: list[tuple[str, str]] = []\n404\t\n405\t    def execute(self, *, job_id: str, activation_id: str, projection: Any = None, **kwargs: Any):\n406\t        projection = dict(projection or {})\n407\t        self.calls.append((job_id, activation_id))\n408\t        self.responses[job_id] = _scripted_candidate(job_id, projection)\n409\t        return super().execute(\n410\t            job_id=job_id, activation_id=activation_id, projection=projection, **kwargs\n411\t        )\n412\t\n413\t\n414\t# The visual denominator the scripted M03 declares. Two members, one per subset,\n415\t# so a real episode fans out to D11 *and* to M04 and D12 has two subsets to join.\n416\t# `_declared_visuals` returns the list in a chosen order, which is what prompt\n417\t# TEST 5's permutation-invariance claim varies.\n418\tDECLARED_VISUALS: list[dict[str, Any]] = [\n419\t    {\n420\t        \"role\": \"build_map\",\n421\t        \"kind\": \"schematic\",\n422\t        \"authoritative\": True,\n423\t        \"permitted_facts\": [\"fact-a\"],\n424\t    },\n425\t    {\n426\t        \"role\": \"overview\",\n427\t        \"kind\": \"diagram\",\n428\t        \"authoritative\": False,\n429\t        \"permitted_facts\": [\"fact-b\"],\n430\t    },\n431\t]\n432\t\n433\t\n434\tdef _scripted_candidate(job_id: str, projection: dict[str, Any]) -> dict[str, Any]:\n435\t    if job_id == \"M01_RESEARCH_UNIT_SOURCES\":\n436\t        request_id = projection[\"request\"].get(\"request_id\")\n437\t        group = projection.get(\"retrieval_group\")\n438\t        if group is None:\n439\t            return {\n440\t                \"locators\": [\n441\t                    {\n442\t                        \"request_id\": request_id,\n443\t                        \"url\": f\"https://example.invalid/{request_id}\",\n444\t                        \"title\": \"scripted source\",\n445\t                        \"publisher\": \"scripted publisher\",\n446\t                        \"locator_kind\": \"primary\",\n447\t                        \"rationale\": \"scripted rationale\",\n448\t                    }\n449\t                ]\n450\t            }\n451\t        return {\n452\t            \"interpretations\": [\n453\t                {\n454\t                    \"request_id\": request_id,\n455\t                    \"retrieval_id\": str(record.get(\"retrieval_id\")),\n456\t                    \"claims\": [\n457\t                        {\n458\t                            \"claim_text\": \"scripted claim\",\n459\t                            \"source_quote\": \"scripted quote\",\n460\t                            \"source_location\": \"p.1\",\n461\t                        }\n462\t                    ],\n463\t                    \"limitations\": [],\n464\t                }\n465\t                for record in group.get(\"retrieved_records\", [])\n466\t            ]\n467\t        }\n468\t    if job_id == \"M02_CREATE_UNIT_DOMAIN_DATA\":\n469\t        unit_id = projection[\"unit\"].get(\"unit_id\")\n470\t        admitted = projection.get(\"admitted_sources\") or []\n471\t        # Every declared fact resolves to an admitted source, which is D08's\n472\t        # `domain_facts_sourced` check: the body is derived from the join, not\n473\t        # invented alongside it.\n474\t        facts = [\n475\t            {\n476\t                \"fact_id\": str(source.get(\"fact_id\")),\n477\t                \"statement\": f\"scripted statement for {source.get('fact_id')}\",\n478\t            }\n479\t            for source in admitted\n480\t        ] or [{\"fact_id\": \"required_explanation:000\", \"statement\": \"scripted statement\"}]\n481\t        return {\n482\t            \"domain_version\": {\n483\t                \"unit_id\": unit_id,\n484\t                \"fields\": {\n485\t                    \"unit_id\": unit_id,\n486\t                    \"facts\": facts,\n487\t                    \"verifier_result\": {\"result\": \"all_fixtures_behaved\"},\n488\t                },\n489\t                \"evidence_references\": [\n490\t                    {\n491\t                        \"source_id\": str(source.get(\"source_id\") or source.get(\"key\") or \"s1\"),\n492\t                        \"source_location\": \"p.1\",\n493\t                    }\n494\t                    for source in admitted\n495\t                ]\n496\t                or [{\"source_id\": \"s1\", \"source_location\": \"p.1\"}],\n497\t            }\n498\t        }\n499\t    if job_id == \"M03_WRITE_UNIT_CONTENT\":\n500\t        admitted_domain = projection.get(\"admitted_domain\") or {}\n501\t        unit_id = str(admitted_domain.get(\"unit_id\") or projection[\"unit\"].get(\"unit_id\"))\n502\t        # Only the source ids D08 declared admissible may be cited; M03's adapter\n503\t        # rejects any other as `candidate_undeclared_artifact`.\n504\t        admissible = projection.get(\"admitted_evidence_references\") or []\n505\t        return {\n506\t            \"unit_content\": {\n507\t                \"unit_id\": unit_id,\n508\t                \"sections\": [\n509\t                    {\n510\t                        \"section_id\": f\"s{index:03d}\",\n511\t                        \"heading\": f\"scripted heading {index}\",\n512\t                        \"body\": f\"scripted body for {reference.get('fact_id')}\",\n513\t 