vation=reservation, correlation=correlation,\n1214\t            projection_sha256=projection_sha256, failure_class=str(failure_class),\n1215\t            detail=str(error), receipts=receipts)\n1216\t\n1217\t    executed_family = _executed_family(result.receipt)\n1218\t    if spec.is_review and executed_family == tp.AUTHORING_FAMILY:\n1219\t        raise FamilyViolation(\n1220\t            f\"{spec.job_id}: a review executed in the authoring family \"\n1221\t            f\"{tp.AUTHORING_FAMILY!r}\")\n1222\t    if executed_family is not None and executed_family != spec.family:\n1223\t        raise FamilyViolation(\n1224\t            f\"{spec.job_id}: executed family {executed_family!r} != decided {spec.family!r}\")\n1225\t\n1226\t    candidate = dict(result.candidate)\n1227\t    return _Dispatch(spec=spec, route=route, projection=projection,\n1228\t                     correlation=correlation, reservation=reservation,\n1229\t                     candidate=candidate, receipt=dict(result.receipt),\n1230\t                     attempts=tuple(dict(item) for item in result.attempts)), None\n1231\t\n1232\t\n1233\tdef _reject(dispatch: _Dispatch, failure_class: str, detail: str) -> dict[str, Any]:\n1234\t    return _failure_update(\n1235\t        spec=dispatch.spec, reservation=dispatch.reservation,\n1236\t        correlation=dispatch.correlation,\n1237\t        projection_sha256=canonical_digest(dispatch.projection),\n1238\t        failure_class=failure_class, detail=detail, receipts=dispatch.attempts)\n1239\t\n1240\t\n1241\tdef _accept(dispatch: _Dispatch, channel_update: Mapping[str, Any]) -> dict[str, Any]:\n1242\t    projection_sha256 = canonical_digest(dispatch.projection)\n1243\t    candidate_sha256 = canonical_digest(dispatch.candidate)\n1244\t    update: dict[str, Any] = dict(channel_update)\n1245\t    update[\"model_execution_receipts\"] = _execution_receipts(\n1246\t        dispatch.attempts, spec=dispatch.spec, reservation=dispatch.reservation,\n1247\t        correlation=dispatch.correlation, projection_sha256=projection_sha256)\n1248\t    update[\"activation_receipts\"] = [_activation_receipt(\n1249\t        spec=dispatch.spec, reservation=dispatch.reservation,\n1250\t        correlation=dispatch.correlation, projection_sha256=projection_sha256,\n1251\t        candidate_sha256=candidate_sha256,\n1252\t        executed_family=_executed_family(dispatch.receipt),\n1253\t        executed_model=dispatch.receipt.get(\"observed_model\")\n1254\t        or dispatch.receipt.get(\"decided_model\"),\n1255\t        result=\"candidate_produced\")]\n1256\t    _assert_model_node_update(update)\n1257\t    return update\n1258\t\n1259\t\n1260\tdef _assert_model_node_update(update: Mapping[str, Any]) -> None:\n1261\t    unknown = sorted(set(update) - MODEL_NODE_WRITABLE_FIELDS)\n1262\t    if unknown:\n1263\t        raise ModelNodeError(\n1264\t            f\"a model node may not write {unknown}; admission, heads, and terminals are \"\n1265\t            f\"deterministic-node authority\")\n1266\t\n1267\t\n1268\tdef _candidate_record(dispatch: _Dispatch, **extra: Any) -> dict[str, Any]:\n1269\t    \"\"\"A pre-admission candidate descriptor."}]},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"325142f1-23a3-44e7-88f9-49a8607e7a8f","timestamp":"2026-08-12T23:18:30.582Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo/runtime/langgraph_factory/model_nodes.py","content":"def _dispatch(spec_name: str, packet: Mapping[str, Any], context: ModelNodeContext,\n              *, needs_correlation_key: bool = False,\n              ) -> tuple[_Dispatch | None, dict[str, Any] | None]:\n    \"\"\"The module's only transport call site.\n\n    Returning ``(None, failure_update)`` rather than raising keeps a model failure a\n    routable state fact: D91 classifies it and only D90 may authorize another attempt.\n    \"\"\"\n\n    spec = PROJECTION_SPECS[spec_name]\n    route = tp.resolve_route(spec.job_id, context.registry)\n    if route.family != spec.family:\n        raise FamilyViolation(\n            f\"{spec.job_id}: frozen registry family {route.family!r} != {spec.family!r}\")\n    reservation = _resolve_reservation(packet, job_id=spec.job_id)\n    correlation = _resolve_correlation(packet, job_id=spec.job_id,\n                                       needs_key=needs_correlation_key)\n    projection = build_projection(spec_name, packet)\n    projection_sha256 = canonical_digest(projection)\n    staged = _staged_inputs(packet, projection, job_id=spec.job_id)\n\n    try:\n        result = context.transport.execute(\n            job_id=spec.job_id,\n            activation_id=reservation[\"activation_id\"],\n            episode_id=correlation[\"episode_id\"],\n            projection=projection,\n            staged_inputs=staged,\n        )\n    except tp.TransportError as error:\n        failure_class = getattr(error, \"failure_class\", type(error).__name__)\n        receipts = [getattr(error, \"receipt\", None) or {\"outcome\": \"transport_failure\"}]\n        return None, _failure_update(\n            spec=spec, reservation=reservation, correlation=correlation,\n            projection_sha256=projection_sha256, failure_class=str(failure_class),\n            detail=str(error), receipts=receipts)\n\n    executed_family = _executed_family(result.receipt)\n    if spec.is_review and executed_family == tp.AUTHORING_FAMILY:\n        raise FamilyViolation(\n            f\"{spec.job_id}: a review executed in the authoring family \"\n            f\"{tp.AUTHORING_FAMILY!r}\")\n    if executed_family is not None and executed_family != spec.family:\n        raise FamilyViolation(\n            f\"{spec.job_id}: executed family {executed_family!r} != decided {spec.family!r}\")\n\n    candidate = dict(result.candidate)\n    return _Dispatch(spec=spec, route=route, projection=projection,\n                     correlation=correlation, reservation=reservation,\n                     candidate=candidate, receipt=dict(result.receipt),\n                     attempts=tuple(dict(item) for item in result.attempts)), None\n\n\ndef _reject(dispatch: _Dispatch, failure_class: str, detail: str) -> dict[str, Any]:\n    return _failure_update(\n        spec=dispatch.spec, reservation=dispatch.reservation,\n        correlation=dispatch.correlation,\n        projection_sha256=canonical_digest(dispatch.projection),\n        failure_class=failure_class, detail=detail, receipts=dispatch.attempts)\n\n\ndef _accept(dispatch: _Dispatch, channel_update: Mapping[str, Any]) -> dict[str, Any]:\n    projection_sha256 = canonical_digest(dispatch.projection)\n    candidate_sha256 = canonical_digest(dispatch.candidate)\n    update: dict[str, Any] = dict(channel_update)\n    update[\"model_execution_receipts\"] = _execution_receipts(\n        dispatch.attempts, spec=dispatch.spec, reservation=dispatch.reservation,\n        correlation=dispatch.correlation, projection_sha256=projection_sha256)\n    update[\"activation_receipts\"] = [_activation_receipt(\n        spec=dispatch.spec, reservation=dispatch.reservation,\n        correlation=dispatch.correlation, projection_sha256=projection_sha256,\n        candidate_sha256=candidate_sha256,\n        executed_family=_executed_family(dispatch.receipt),\n        executed_model=dispatch.receipt.get(\"observed_model\")\n        or dispatch.receipt.get(\"decided_model\"),\n        result=\"candidate_produced\")]\n    _assert_model_node_update(update)\n    return update\n\n\ndef _assert_model_node_update(update: Mapping[str, Any]) -> None:\n    unknown = sorted(set(update) - MODEL_NODE_WRITABLE_FIELDS)\n    if unknown:\n        raise ModelNodeError(\n            f\"a model node may not write {unknown}; admission, heads, and terminals are \"\n            f\"deterministic-node authority\")\n\n\ndef _candidate_record(dispatch: _Dispatch, **extra: Any) -> dict[str, Any]:\n    \"\"\"A pre-admission candidate descriptor.","numLines":90,"startLine":1180,"totalLines":1694}}}
