  \"layout_path\": str(layout),\n317\t            \"layout_sha256\": digest,\n318\t            \"pdf_path\": str(pdf),\n319\t            \"pdf_sha256\": digest,\n320\t            \"renderer\": \"test_double_renderer\",\n321\t            \"attempt\": 1,\n322\t        }\n323\t\n324\t    def inspect_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n325\t        self.inspected.append(pdf_sha256)\n326\t        pages = []\n327\t        for number in (1, 2):\n328\t            image = self.sandbox / \"pages\" / f\"{Path(pdf_path).stem}-{number}.png\"\n329\t            image.parent.mkdir(parents=True, exist_ok=True)\n330\t            body = f\"page-{number}-{pdf_sha256}\".encode()\n331\t            image.write_bytes(body)\n332\t            pages.append(\n333\t                {\n334\t                    \"number\": number,\n335\t                    \"page_sha256\": hashlib.sha256(body).hexdigest(),\n336\t                    \"image_path\": str(image),\n337\t                    \"problems\": [],\n338\t                    \"unreadable\": False,\n339\t                }\n340\t            )\n341\t        return {\"pages\": pages}\n342\t\n343\t\n344\tclass _StubRetriever:\n345\t    def __init__(self) -> None:\n346\t        self.fetched: list[str] = []\n347\t\n348\t    def fetch(self, locator: Any, authorization: Any, scope: Any) -> dict[str, Any]:\n349\t        self.fetched.append(str(locator))\n350\t        body = json.dumps({\"locator\": locator, \"scope\": scope}, sort_keys=True).encode()\n351\t        return {\n352\t            \"locator\": locator,\n353\t            \"sha256\": hashlib.sha256(body).hexdigest(),\n354\t            \"status\": 200,\n355\t            \"content_type\": \"text/html\",\n356\t            \"tls\": {\"verified\": True},\n357\t            \"bytes_path\": None,\n358\t        }\n359\t\n360\t\n361\tclass _SwitchableToken:\n362\t    \"\"\"A signal token a test can raise at a chosen node boundary.\"\"\"\n363\t\n364\t    def __init__(self, trip_after: str | None = None) -> None:\n365\t        self.trip_after = trip_after\n366\t        self.tripped = False\n367\t        self.observed: list[str] = []\n368\t\n369\t    def trip(self) -> None:\n370\t        self.tripped = True\n371\t\n372\t    def is_set(self) -> bool:\n373\t        return self.tripped\n374\t\n375\t\n376\tclass _HarnessContext:\n377\t    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n378\t\n379\t    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n380\t        from runtime.langgraph_factory.artifacts import ArtifactStore\n381\t        from runtime.langgraph_factory.evidence import EvidenceStore\n382\t\n383\t        self.engine_root = engine_root\n384\t        self.output_root = output_root\n385\t        self.path_guard = ArtifactStore(output_root)\n386\t        self.evidence_service = EvidenceStore(output_root)\n387\t        self.transport_registry = _StubRegistry(sandbox)\n388\t        self.source_retriever = _StubRetriever()\n389\t        self.signal_token = _SwitchableToken()\n390\t        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n391\t\n392\t\n393\tclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n394\t    \"\"\"Composes each canned candidate from the projection it is handed.\n395\t\n396\t    Still a `FakeCliTransport`, so the real output-schema and no-authoritative-\n397\t    field validation still runs, and it is still refused by\n398\t    `build_model_node_context`.\n399\t    \"\"\"\n400\t\n401\t    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:"}]},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"70576339-74b6-4d0b-9302-e524b2e9a2b0","timestamp":"2026-08-12T23:17:04.130Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo/tests/runtime/test_plan26_unit_graph.py","content":"class _StubRegistry:\n    \"\"\"The capability/renderer/rasterizer surface D03/D11/D13/D14 reach for.\n\n    Production `CliTransport` implements none of these; see finding B-8.\n    \"\"\"\n\n    def __init__(self, sandbox: Path) -> None:\n        self.sandbox = sandbox\n        self.rendered_units: list[str] = []\n        self.inspected: list[str] = []\n\n    def prove_capability(self, capability: str) -> dict[str, Any]:\n        return {\"result\": \"PASS\", \"capability\": capability, \"detail\": \"test double\"}\n\n    def observe_executable(self, name: str) -> dict[str, Any]:\n        return {\"name\": name, \"path\": f\"/usr/bin/{name}\", \"sha256\": \"0\" * 64}\n\n    def render_deterministic_visual(self, brief: Any, permitted_facts: Any) -> dict[str, Any]:\n        path = self.sandbox / \"visuals\" / (str(brief[\"key\"]).replace(\"/\", \"_\") + \".svg\")\n        path.parent.mkdir(parents=True, exist_ok=True)\n        body = f\"<svg data-key='{brief['key']}'/>\".encode()\n        path.write_bytes(body)\n        return {\"asset_path\": str(path), \"sha256\": hashlib.sha256(body).hexdigest(), \"format\": \"svg\"}\n\n    def render_unit(self, unit_id: str, parents: Any) -> dict[str, Any]:\n        self.rendered_units.append(unit_id)\n        directory = self.sandbox / \"render\"\n        directory.mkdir(parents=True, exist_ok=True)\n        body = json.dumps({\"unit\": unit_id, \"parents\": parents}, sort_keys=True).encode()\n        pdf, layout = directory / f\"{unit_id}.pdf\", directory / f\"{unit_id}.layout.json\"\n        pdf.write_bytes(body)\n        layout.write_bytes(body)\n        digest = hashlib.sha256(body).hexdigest()\n        return {\n            \"layout_path\": str(layout),\n            \"layout_sha256\": digest,\n            \"pdf_path\": str(pdf),\n            \"pdf_sha256\": digest,\n            \"renderer\": \"test_double_renderer\",\n            \"attempt\": 1,\n        }\n\n    def inspect_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n        self.inspected.append(pdf_sha256)\n        pages = []\n        for number in (1, 2):\n            image = self.sandbox / \"pages\" / f\"{Path(pdf_path).stem}-{number}.png\"\n            image.parent.mkdir(parents=True, exist_ok=True)\n            body = f\"page-{number}-{pdf_sha256}\".encode()\n            image.write_bytes(body)\n            pages.append(\n                {\n                    \"number\": number,\n                    \"page_sha256\": hashlib.sha256(body).hexdigest(),\n                    \"image_path\": str(image),\n                    \"problems\": [],\n                    \"unreadable\": False,\n                }\n            )\n        return {\"pages\": pages}\n\n\nclass _StubRetriever:\n    def __init__(self) -> None:\n        self.fetched: list[str] = []\n\n    def fetch(self, locator: Any, authorization: Any, scope: Any) -> dict[str, Any]:\n        self.fetched.append(str(locator))\n        body = json.dumps({\"locator\": locator, \"scope\": scope}, sort_keys=True).encode()\n        return {\n            \"locator\": locator,\n            \"sha256\": hashlib.sha256(body).hexdigest(),\n            \"status\": 200,\n            \"content_type\": \"text/html\",\n            \"tls\": {\"verified\": True},\n            \"bytes_path\": None,\n        }\n\n\nclass _SwitchableToken:\n    \"\"\"A signal token a test can raise at a chosen node boundary.\"\"\"\n\n    def __init__(self, trip_after: str | None = None) -> None:\n        self.trip_after = trip_after\n        self.tripped = False\n        self.observed: list[str] = []\n\n    def trip(self) -> None:\n        self.tripped = True\n\n    def is_set(self) -> bool:\n        return self.tripped\n\n\nclass _HarnessContext:\n    \"\"\"`RuntimeContext`-shaped test double. No product root, no real transport.\"\"\"\n\n    def __init__(self, engine_root: Path, output_root: Path, sandbox: Path) -> None:\n        from runtime.langgraph_factory.artifacts import ArtifactStore\n        from runtime.langgraph_factory.evidence import EvidenceStore\n\n        self.engine_root = engine_root\n        self.output_root = output_root\n        self.path_guard = ArtifactStore(output_root)\n        self.evidence_service = EvidenceStore(output_root)\n        self.transport_registry = _StubRegistry(sandbox)\n        self.source_retriever = _StubRetriever()\n        self.signal_token = _SwitchableToken()\n        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n\n\nclass _ScriptedFakeTransport(mn.tp.FakeCliTransport):\n    \"\"\"Composes each canned candidate from the projection it is handed.\n\n    Still a `FakeCliTransport`, so the real output-schema and no-authoritative-\n    field validation still runs, and it is still refused by\n    `build_model_node_context`.\n    \"\"\"\n\n    def __init__(self, *, sandbox_root: Path, registry: Any = None) -> None:","numLines":120,"startLine":282,"totalLines":2705}}}
