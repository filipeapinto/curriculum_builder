{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W5dLxXmxbsqJmR2m9N1jJJ","type":"tool_result","content":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo\n__init__.py\nacceptance.py\nartifacts.py\nconfig\negress.py\nevidence.py\ngraph.py\nmodel_nodes.py\nnodes\npersistence.py\nprompts\nreducers.py\nrepair.py\nrouting.py\nschemas\nstate.py\ntransport.py\nunit_graph.py\nworkbook.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"5aadd096-dcd8-435d-9309-6afdf451e8c9","timestamp":"2026-08-12T23:09:24.401Z","tool_use_result":{"stdout":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo\n__init__.py\nacceptance.py\nartifacts.py\nconfig\negress.py\nevidence.py\ngraph.py\nmodel_nodes.py\nnodes\npersistence.py\nprompts\nreducers.py\nrepair.py\nrouting.py\nschemas\nstate.py\ntransport.py\nunit_graph.py\nworkbook.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FH767sJTeuhsgQcHZ55Xhn","type":"tool_result","content":"1\t\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n2\t\n3\tThis module owns registration, not node bodies. Every callable it registers is\n4\tresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\n5\tthat is missing, placeholder, test-only, duplicated, or dangling fails the build\n6\tby stable ID rather than compiling into a graph that would look complete.\n7\t\n8\tIt also owns the two things no node body can own:\n9\t\n10\t- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n11\t  records a graceful interrupt observed at the node's atomic boundary, and turns\n12\t  an unexpected exception into a classified `pending_failure` instead of letting\n13\t  an unproven state continue;\n14\t- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n15\t  guard, evidence writer, transport registry, source retriever, signal token and\n16\t  clock, and holds no model client and no routing authority.\n17\t\n18\tScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\n19\tpath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n20\t`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\n21\tmap/reduce, and the workbook branch are registered by N30 and N32 into this same\n22\tbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\n23\tbut not yet wired, so an undeclared unwired node still fails compilation.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport hashlib\n29\timport inspect\n30\timport json\n31\timport re\n32\tfrom collections.abc import Callable, Mapping, Sequence\n33\tfrom datetime import datetime, timezone\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom langgraph.errors import GraphBubbleUp\n38\tfrom langgraph.graph import END, START, StateGraph\n39\tfrom langgraph.graph.state import CompiledStateGraph\n40\tfrom langgraph.runtime import Runtime\n41\t\n42\tfrom . import acceptance, routing, transport as tp, unit_graph, workbook\n43\tfrom .artifacts import ArtifactStore\n44\tfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\n45\tfrom .evidence import EvidenceStore\n46\tfrom .model_nodes import (\n47\t    MODEL_BOOKKEEPING_NODES,\n48\t    MODEL_NODE_ADAPTERS,\n49\t    build_model_node_context,\n50\t)\n51\tfrom .nodes import NODE_CATALOGUE, node_registry\n52\tfrom .persistence import InterruptToken, open_checkpoint_saver\n53\tfrom .state import (\n54\t    FACTORY_INPUT_FIELDS,\n55\t    FACTORY_OUTPUT_FIELDS,\n56\t    FACTORY_STATE_FIELDS,\n57\t    FIELD_REDUCER_CLASSES,\n58\t    FactoryInput,\n59\t    FactoryOutput,\n60\t    FactoryState,\n61\t    RuntimeContext,\n62\t)\n63\t\n64\t__all__ = [\n65\t    \"GRAPH_NAME\",\n66\t    \"GraphBindingError\",\n67\t    \"DEFERRED_TOPOLOGY\",\n68\t    \"SKELETON_NORMAL_EDGES\",\n69\t    \"SKELETON_BRANCHES\",\n70\t    \"build_runtime_context\",\n71\t    \"binding_inventory\",\n72\t    \"unit_repair_binding_inventory\",\n73\t    \"full_binding_inventory\",\n74\t    \"validate_bindings\",\n75\t    \"register_skeleton\",\n76\t    \"register_unit_repair_topology\",\n77\t    \"register_workbook_topology\",\n78\t    \"build_curriculum_factory_graph\",\n79\t    \"compiled_topology\",\n80\t    \"graph_digest\",\n81\t    \"contract_digests\",\n82\t]\n83\t\n84\tGRAPH_NAME = \"plan26_curriculum_factory\"\n85\t\n86\t\n87\tclass GraphBindingError(RuntimeError):\n88\t    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n89\t\n90\t\n91\t# Only these modules may supply a production node body. A callable from anywhere\n92\t# else — a test module, a notebook, a locally defined lambda — is rejected by\n93\t# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n94\t# a stand-in\".\n95\tPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n96\t    \"runtime.langgraph_factory.nodes\",\n97\t    \"runtime.langgraph_factory.model_nodes\",\n98\t    \"runtime.langgraph_factory.workbook\",\n99\t    \"runtime.langgraph_factory.repair\",\n100\t    \"runtime.langgraph_factory.acceptance\",\n101\t)\n102\t\n103\tPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n104\t    \"stub\",\n105\t    \"placeholder\",\n106\t    \"fake\",\n107\t    \"dummy\",\n108\t    \"mock\",\n109\t    \"sample\",\n110\t    \"example\",\n111\t    \"todo\",\n112\t    \"noop\",\n113\t    \"test\",\n114\t)\n115\t\n116\tPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n117\t    \"raise NotImplementedError\",\n118\t    \"TODO: implement\",\n119\t    \"placeholder implementation\",\n120\t)\n121\t\n122\t# Registered here, wired by a later graph node. A node that is neither wired by\n123\t# the skeleton/unit-path tables `_validate_topology` inspects nor declared here\n124\t# fails the build: silence about an unwired node is how a topology gap becomes\n125\t# a silent halt at runtime.\n126\t#\n127\t# D16 and D17 need no row: once their bodies are members of `available`, they\n128\t# are reached as real *destinations* of already-wired `unit_graph.UNIT_BRANCHES`\n129\t# sources (D08/D09/D12/D14/D91 -> D17, M05 -> D16 -- the six rows `unit_graph\n130\t# .DEFERRED_EDGES` names), so `_validate_topology`'s own `wired` set already\n131\t# contains them. D18-D23 are reached only from *inside* the unit repair cycle\n132\t# itself (D17 -> D18 -> ... -> D21 -> D16, D22 -> D23 -> D05), which is wired by\n133\t# `acceptance.register_unit_repair_path` (via `register_unit_repair_topology`,\n134\t# called after `register_skeleton` returns) rather than by any table\n135\t# `_validate_topology` reads -- so they are declared deferred here for the same\n136\t# reason M06/M07/M08 are: really wired, by a registration step this function\n137\t# does not itself see.\n138\tDEFERRED_TOPOLOGY: Mapping[str, str] = {\n139\t    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n140\t    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n141\t    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n142\t    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n143\t    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n144\t    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n145\t    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n146\t    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n147\t    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n148\t}\n149\t\n150\tSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n151\t    (START, \"D00_BOOTSTRAP_EPISODE\"),\n152\t    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n153\t    (\"D98_WRITE_TERMINAL\", END),\n154\t)\n155\t\n156\tSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n157\t    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n158\t    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n159\t    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n160\t    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n161\t    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n162\t    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n163\t)\n164\t\n165\t\n166\t# --------------------------------------------------------------- runtime context\n167\t\n168\t\n169\tdef _utc_clock() -> str:\n170\t    return datetime.now(timezone.utc).isoformat()\n171\t\n172\t\n173\tdef build_runtime_context(\n174\t    *,\n175\t    engine_root: Path | str,\n176\t    output_root: Path | str,\n177\t    run_id: str,\n178\t    curriculum_digest: str,\n179\t    authorization: Any = None,\n180\t    capability_proof: Mapping[str, Any] | None = None,\n181\t    retrieval_hosts: Sequence[str] = (),\n182\t    clock: Callable[[], Any] = _utc_clock,\n183\t    env_passthrough: Sequence[str] = (),\n184\t) -> RuntimeContext:\n185\t    \"\"\"Open the services one invocation may reach (spec section 5.2).\n186\t\n187\t    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n188\t    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n189\t    inside the builder, because the transport and the authorization it enforces\n190\t    are bound to a run identity that does not exist at build time.\n191\t    \"\"\"\n192\t\n193\t    engine_root = Path(engine_root).resolve()\n194\t    output_root = Path(output_root).resolve()\n195\t    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n196\t    egress_guard = EgressGuard(receipts)\n197\t    return RuntimeContext(\n198\t        engine_root=engine_root,\n199\t        output_root=output_root,\n200\t        path_guard=ArtifactStore(output_root),\n201\t        evidence_service=EvidenceStore(output_root),\n202\t        transport_registry=tp.CliTransport(\n203\t            output_root=output_root,\n204\t            run_id=run_id,\n205\t            curriculum_digest=curriculum_digest,\n206\t            authorization=authorization,\n207\t            receipts=receipts,\n208\t            guard=egress_guard,\n209\t            ledger=tp.AttemptLedger(),\n210\t            capability_proof=capability_proof,\n211\t            env_passthrough=env_passthrough,\n212\t        ),\n213\t        source_retriever=SourceRetriever(\n214\t            guard=egress_guard,\n215\t            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n216\t        ),\n217\t        signal_token=InterruptToken(output_root),\n218\t        clock=clock,\n219\t    )\n220\t\n221\t\n222\t# ----------------------------------------------------------------- node boundary\n223\t\n224\t\n225\tdef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n226\t    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n227\t\n228\t    marked = dict(update)\n229\t    guard = marked.get(\"pending_guard\")\n230\t    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n231\t    guard[\"interrupt_requested\"] = True\n232\t    marked[\"pending_guard\"] = guard\n233\t    return marked\n234\t\n235\t\n236\tdef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n237\t    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n238\t\n239\t    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n240\t    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n241\t    callables take it as an explicit argument precisely so they cannot fetch it\n242\t    themselves.\n243\t    \"\"\"\n244\t\n245\t    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n246\t        context = getattr(runtime, \"context\", None)\n247\t        try:\n248\t            if model_node:\n249\t                update = body(state, build_model_node_context(context))\n250\t            else:\n251\t                update = body(state, context)\n252\t        except GraphBubbleUp:\n253\t            # LangGraph's own control flow (interrupt/resume propagation) is not a\n254\t            # product failure and must reach the engine untouched.\n255\t            raise\n256\t        except Exception as error:  # the classified-failure contract of spec 6.1\n257\t            return {\n258\t                \"pending_failure\": {\n259\t                    \"node\": node_id,\n260\t                    \"class\": \"system\",\n261\t                    \"cause\": \"unhandled\",\n262\t                    \"message\": f\"{type(error).__name__}: {error}\",\n263\t                    \"evidence\": {\"boundary\": \"node\"},\n264\t                },\n265\t                \"pending_guard\": None,\n266\t            }\n267\t        token = getattr(context, \"signal_token\", None)\n268\t        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n269\t            return _mark_interrupt(update, node_id)\n270\t        return dict(update)\n271\t\n272\t    node.__name__ = node_id\n273\t    node.__qualname__ = node_id\n274\t    node.__doc__ = getattr(body, \"__doc__\", None)\n275\t    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n276\t    return node\n277\t\n278\t\n279\tdef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n280\t    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n281\t\n282\t    return getattr(body, \"node_body\", body)\n283\t\n284\t\n285\tdef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n286\t    target = _underlying(body)\n287\t    try:\n288\t        source = inspect.getsource(target)\n289\t    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n290\t        source = \"\"\n291\t    return {\n292\t        \"node_id\": node_id,\n293\t        \"module\": getattr(target, \"__module__\", \"\"),\n294\t        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n295\t        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n296\t        \"source_lines\": len(source.splitlines()),\n297\t    }\n298\t\n299\t\n300\t# ------------------------------------------------------------ binding validation\n301\t\n302\t\n303\tdef binding_inventory() -> dict[str, Callable[..., Any]]:\n304\t    \"\"\"Every node callable N20's own skeleton/unit-path tables resolve against.\n305\t\n306\t    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n307\t    are deliberately absent from *this* function's return value even though\n308\t    they are real, wired members of the compiled production graph: several of\n309\t    N30's own tests in `test_plan26_unit_graph.py` independently recompute\n310\t    their expectation directly from this function's return value, so it stays\n311\t    exactly what it was before N31 (per N90 finding F1's own resolution --\n312\t    `full_binding_inventory()`/`unit_repair_binding_inventory()` below are the\n313\t    functions that widen it; this one never does). Use `unit_repair_binding_\n314\t    inventory()` for the actual widened set `build_curriculum_factory_graph`\n315\t    compiles against.\n316\t\n317\t    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n318\t    likewise absent from *this* function deliberately, not by oversight: D24\n319\t    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n320\t    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n321\t    already-verified tables) declare that edge deferred to N32 by name. If D24\n322\t    entered this function, `unit_graph.register_unit_path`'s *own*\n323\t    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n324\t    silently widen to include it -- correct for a production run, but it\n325\t    would falsify N30's own already-passing topology tests, which independently\n326\t    recompute their expectation from this exact function's return value.\n327\t    `register_workbook_topology` registers the workbook engine as an additive\n328\t    step over its own separate builder (N32 exercises it directly, not through\n329\t    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n330\t    byte-identical to what they were before N32 and the workbook branch is\n331\t    still fully real -- just not reachable from `D05` in this generation,\n332\t    exactly as `unit_graph.DEFERRED_EDGES` documents.\n333\t    \"\"\"\n334\t\n335\t    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n336\t    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n337\t        bindings[job_id] = adapter\n338\t    bindings.update(MODEL_BOOKKEEPING_NODES)\n339\t    return bindings\n340\t\n341\t\n342\tdef unit_repair_binding_inventory() -> dict[str, Callable[..., Any]]:\n343\t    \"\"\"`binding_inventory()` plus this node's own D16-D23 unit-repair-cycle bodies.\n344\t\n345\t    The set `build_curriculum_factory_graph` actually compiles the one\n346\t    production graph against (N90 finding F1): D16-D23 become real, reachable\n347\t    members of that graph, while D24-D32 (N32's still-deferred workbook\n348\t    engine) stay absent, exactly as `binding_inventory()`'s own docstring\n349\t    documents for that pair. Kept separate from `binding_inventory()` itself\n350\t    so N30's tests, which recompute their expectation directly from that\n351\t    function's return value, stay unaffected by this widening.\n352\t    \"\"\"\n353\t\n354\t    bindings = dict(binding_inventory())\n355\t    bindings.update(acceptance.UNIT_REPAIR_NODE_BODIES)\n356\t    return bindings\n357\t\n358\t\n359\tdef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n360\t    \"\"\"`unit_repair_binding_inventory()` plus N32's workbook engine (D24-D32).\n361\t\n362\t    The complete node set this generation's node bodies span. Kept separate\n363\t    from `binding_inventory()` itself for the reason documented there.\n364\t    \"\"\"\n365\t\n366\t    bindings = dict(unit_repair_binding_inventory())\n367\t    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n368\t    return bindings\n369\t\n370\t\n371\tdef _reject(code: str, node_id: str, detail: str) -> None:\n372\t    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n373\t\n374\t\n375\tdef validate_bindings(\n376\t    bindings: Mapping[str, Callable[..., Any]],\n377\t    *,\n378\t    required: Sequence[str],\n379\t) -> dict[str, dict[str, Any]]:\n380\t    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n381\t\n382\t    for node_id in required:\n383\t        if node_id not in bindings:\n384\t            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n385\t\n386\t    seen: dict[tuple[str, str], str] = {}\n387\t    inventory: dict[str, dict[str, Any]] = {}\n388\t    for node_id in sorted(bindings):\n389\t        body = bindings[node_id]\n390\t        if not callable(body):\n391\t            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n392\t        record = _binding_record(node_id, body)\n393\t        module = record[\"module\"]\n394\t        if not any(\n395\t            module == allowed or module.startswith(f\"{allowed}.\")\n396\t            for allowed in PRODUCTION_BINDING_MODULES\n397\t        ):\n398\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n399\t        lowered = f\"{module}.{record['qualname']}\".lower()\n400\t        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n401\t        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n402\t        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n403\t        # positive on the spec's own vocabulary, not a caught stand-in.\n404\t        marker = next(\n405\t            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n406\t            None,\n407\t        )\n408\t        if marker is not None:\n409\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n410\t        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n411\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n412\t        source = inspect.getsource(_underlying(body))\n413\t        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n414\t        if marker is not None:\n415\t            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n416\t        identity = (module, record[\"qualname\"])\n417\t        if identity in seen:\n418\t            _reject(\n419\t                \"N20-BIND-DUPLICATE\",\n420\t                node_id,\n421\t                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n422\t            )\n423\t        seen[identity] = node_id\n424\t        inventory[node_id] = record\n425\t    return inventory\n426\t\n427\t\n428\tdef _validate_topology(registered: Sequence[str]) -> None:\n429\t    known = set(registered) | {START, END}\n430\t    wired: set[str] = set()\n431\t    for source, target in SKELETON_NORMAL_EDGES:\n432\t        for endpoint in (source, target):\n433\t            if endpoint not in known:\n434\t                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n435\t        wired.update({source, target})\n436\t    for source, path in SKELETON_BRANCHES:\n437\t        if source not in known:\n438\t            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n439\t        wired.add(source)\n440\t        for target in routing.guard_destinations(source):\n441\t            if target not in known:\n442\t                _reject(\n443\t                    \"N20-EDGE-DANGLING\",\n444\t                    target,\n445\t                    f\"{source} branch {path.__name__} names an unregistered destination\",\n446\t                )\n447\t            wired.add(target)\n448\t    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n449\t        wired.update({source, target})\n450\t    for source, _ in unit_graph.UNIT_BRANCHES:\n451\t        wired.add(source)\n452\t        wired.update(unit_graph.branch_destinations(source, registered))\n453\t    for node_id in registered:\n454\t        if node_id in wired:\n455\t            continue\n456\t        owner = DEFERRED_TOPOLOGY.get(node_id)\n457\t        if owner is None:\n458\t            _reject(\n459\t                \"N20-NODE-UNDECLARED\",\n460\t                node_id,\n461\t                \"is registered but neither wired by the skeleton nor declared deferred\",\n462\t            )\n463\t\n464\t\n465\t# ---------------------------------------------------------------- registration\n466\t\n467\t\n468\tdef register_skeleton(\n469\t    builder: StateGraph,\n470\t    bindings: Mapping[str, Callable[..., Any]],\n471\t) -> dict[str, dict[str, Any]]:\n472\t    \"\"\"Register every available node and the fixed skeleton edges.\n473\t\n474\t    N30 and N32 extend the same builder by adding their own `add_node`-free\n475\t    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n476\t    rewritten by them, so the skeleton stays the one place START, the recovery\n477\t    branch, and the single edge to END are decided.\n478\t    \"\"\"\n479\t\n480\t    routing.assert_guard_table_total(NODE_CATALOGUE)\n481\t    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n482\t    _validate_topology(sorted(bindings))\n483\t\n484\t    for node_id in sorted(bindings):\n485\t        model_node = node_id in MODEL_NODE_ADAPTERS\n486\t        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n487\t\n488\t    for source, target in SKELETON_NORMAL_EDGES:\n489\t        builder.add_edge(source, target)\n490\t\n491\t    for source, path in SKELETON_BRANCHES:\n492\t        destinations = routing.guard_destinations(source)\n493\t        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n494\t\n495\t    unit_graph.register_unit_path(builder, sorted(bindings))\n496\t\n497\t    return inventory\n498\t\n499\t\n500\tdef register_unit_repair_topology(builder: StateGraph, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n501\t    \"\"\"Wire D16-D23's internal repair/acceptance cycle, additively over `register_skeleton`.\n502\t\n503\t    Called from `build_curriculum_factory_graph` immediately after `register_\n504\t    skeleton` (which has already `add_node`-registered every member of\n505\t    `unit_repair_binding_inventory()`, D16-D23 included) and after `unit_graph\n506\t    .register_unit_path` (run inside `register_skeleton` itself). This closes\n507\t    N90 finding F1 for the six DEFERRED_EDGES rows N31 owns: those six edges\n508\t    are not added here -- they are `unit_graph.py`'s own rows, and resolve\n509\t    automatically the moment D16/D17 are members of the bindings `register_\n510\t    skeleton` receives -- this function adds only the loop internal to D16-D23\n511\t    itself, which no other module owns.\n512\t    \"\"\"\n513\t\n514\t    return acceptance.register_unit_repair_path(builder, available)\n515\t\n516\t\n517\tdef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n518\t    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n519\t\n520\t    Not called by `build_curriculum_factory_graph`: this generation's single\n521\t    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n522\t    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n523\t    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n524\t    this function into whatever the production compile point becomes once the\n525\t    workbook branch is in scope; until then it is exercised directly, over its\n526\t    own builder, the way N32's own topology test already does.\n527\t    `register_skeleton` itself must never see these bindings; this function\n528\t    adds exactly the nodes `register_skeleton` did not, then wires them over\n529\t    the *full* merged node set so `workbook.register_workbook_path` can\n530\t    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n531\t    \"\"\"\n532\t\n533\t    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n534\t    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n535\t    for node_id in sorted(workbook_bindings):\n536\t        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n537\t    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n538\t\n539\t\n540\tdef _skeleton_required_nodes() -> tuple[str, ...]:\n541\t    required = {source for source, _ in SKELETON_BRANCHES}\n542\t    for source, target in SKELETON_NORMAL_EDGES:\n543\t        required.update({source, target})\n544\t    for source, _ in SKELETON_BRANCHES:\n545\t        required.update(routing.guard_destinations(source))\n546\t    return tuple(sorted(required - {START, END}))\n547\t\n548\t\n549\tdef build_curriculum_factory_graph(\n550\t    *, engine_root: Path, output_root: Path\n551\t) -> CompiledStateGraph:\n552\t    \"\"\"Build and compile the one production graph (spec section 4).\n553\t\n554\t    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n555\t    returned graph is invoked with `context=build_runtime_context(...)`; no\n556\t    services are captured at build time, so the compiled object carries no\n557\t    run identity and no authorization.\n558\t\n559\t    Compiles against `unit_repair_binding_inventory()`, not `binding_\n560\t    inventory()`: D16-D23 (this node's own unit repair/acceptance cycle) are\n561\t    real, wired members of the one compiled production graph (N90 finding\n562\t    F1), while D24-D32 (N32's still-deferred workbook engine) stay absent --\n563\t    `register_unit_repair_topology` is called immediately after `register_\n564\t    skeleton` to wire the loop internal to D16-D23 that no other module owns.\n565\t    \"\"\"\n566\t\n567\t    engine_root = Path(engine_root).resolve()\n568\t    output_root = Path(output_root).resolve()\n569\t    builder: StateGraph = StateGraph(\n570\t        FactoryState,\n571\t        context_schema=RuntimeContext,\n572\t        input_schema=FactoryInput,\n573\t        output_schema=FactoryOutput,\n574\t    )\n575\t    bindings = unit_repair_binding_inventory()\n576\t    register_skeleton(builder, bindings)\n577\t    register_unit_repair_topology(builder, sorted(bindings))\n578\t    saver, _connection = open_checkpoint_saver(output_root)\n579\t    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n580\t\n581\t\n582\t# ---------------------------------------------------------------------- digest\n583\t\n584\t\n585\tdef _canonical_digest(payload: Any) -> str:\n586\t    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n587\t    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n588\t\n589\t\n590\tdef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n591\t    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n592\t\n593\t    drawn = compiled.get_graph()\n594\t    return {\n595\t        \"name\": compiled.name,\n596\t        \"nodes\": sorted(drawn.nodes),\n597\t        \"edges\": sorted(\n598\t            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n599\t        ),\n600\t    }\n601\t\n602\t\n603\tdef contract_digests() -> dict[str, str]:\n604\t    \"\"\"File digests of every frozen model prompt and output schema.\n605\t\n606\t    Folded into the graph digest so prompt or schema drift is visible as graph\n607\t    drift: the same topology over a changed prompt is not the same graph.\n608\t    \"\"\"\n609\t\n610\t    digests: dict[str, str] = {}\n611\t    registry = tp.load_job_registry()\n612\t    for job_id in sorted(registry):\n613\t        route = registry[job_id]\n614\t        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n615\t            path = Path(path)\n616\t            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n617\t    return digests\n618\t\n619\t\n620\tdef graph_digest(compiled: CompiledStateGraph) -> str:\n621\t    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n622\t\n623\t    Identical real bindings give an identical digest; a changed node body,\n624\t    reducer declaration, prompt, or schema changes it. Python object identity is\n625\t    deliberately not an input, so two builds in one process and two builds in two\n626\t    processes agree.\n627\t    \"\"\"\n628\t\n629\t    payload = {\n630\t        \"topology\": compiled_topology(compiled),\n631\t        \"bindings\": [\n632\t            _binding_record(node_id, body)\n633\t            for node_id, body in sorted(binding_inventory().items())\n634\t        ],\n635\t        \"state\": {\n636\t            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n637\t            \"input\": list(FACTORY_INPUT_FIELDS),\n638\t            \"output\": list(FACTORY_OUTPUT_FIELDS),\n639\t        },\n640\t        \"contracts\": contract_digests(),\n641\t    }\n642\t    return _canonical_digest(payload)\n643\t"}]},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"a4099660-bc39-453d-bc28-4b461726be77","timestamp":"2026-08-12T23:09:24.692Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo/runtime/langgraph_factory/graph.py","content":"\"\"\"The one production `StateGraph`: bindings, skeleton topology, and compilation.\n\nThis module owns registration, not node bodies. Every callable it registers is\nresolved from N22's `node_registry()` or N23's `MODEL_NODE_ADAPTERS`; a binding\nthat is missing, placeholder, test-only, duplicated, or dangling fails the build\nby stable ID rather than compiling into a graph that would look complete.\n\nIt also owns the two things no node body can own:\n\n- the common node boundary (spec section 6.1), which injects `RuntimeContext`,\n  records a graceful interrupt observed at the node's atomic boundary, and turns\n  an unexpected exception into a classified `pending_failure` instead of letting\n  an unproven state continue;\n- the `RuntimeContext` factory itself (spec section 5.2), which opens the path\n  guard, evidence writer, transport registry, source retriever, signal token and\n  clock, and holds no model client and no routing authority.\n\nScope of this generation: the fixed skeleton only — `START -> D00 -> {D01 fresh\npath, D00R resume path} -> D03 -> D04 -> {D05, D92}` plus the orphan-recovery\n`D00 -> D96 -> D98 -> END` branch. The per-unit loop, the source/visual `Send`\nmap/reduce, and the workbook branch are registered by N30 and N32 into this same\nbuilder; `DEFERRED_TOPOLOGY` names their owner for every node registered here\nbut not yet wired, so an undeclared unwired node still fails compilation.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport inspect\nimport json\nimport re\nfrom collections.abc import Callable, Mapping, Sequence\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom langgraph.errors import GraphBubbleUp\nfrom langgraph.graph import END, START, StateGraph\nfrom langgraph.graph.state import CompiledStateGraph\nfrom langgraph.runtime import Runtime\n\nfrom . import acceptance, routing, transport as tp, unit_graph, workbook\nfrom .artifacts import ArtifactStore\nfrom .egress import EgressGuard, ReceiptLog, RetrievalPolicy, SourceRetriever\nfrom .evidence import EvidenceStore\nfrom .model_nodes import (\n    MODEL_BOOKKEEPING_NODES,\n    MODEL_NODE_ADAPTERS,\n    build_model_node_context,\n)\nfrom .nodes import NODE_CATALOGUE, node_registry\nfrom .persistence import InterruptToken, open_checkpoint_saver\nfrom .state import (\n    FACTORY_INPUT_FIELDS,\n    FACTORY_OUTPUT_FIELDS,\n    FACTORY_STATE_FIELDS,\n    FIELD_REDUCER_CLASSES,\n    FactoryInput,\n    FactoryOutput,\n    FactoryState,\n    RuntimeContext,\n)\n\n__all__ = [\n    \"GRAPH_NAME\",\n    \"GraphBindingError\",\n    \"DEFERRED_TOPOLOGY\",\n    \"SKELETON_NORMAL_EDGES\",\n    \"SKELETON_BRANCHES\",\n    \"build_runtime_context\",\n    \"binding_inventory\",\n    \"unit_repair_binding_inventory\",\n    \"full_binding_inventory\",\n    \"validate_bindings\",\n    \"register_skeleton\",\n    \"register_unit_repair_topology\",\n    \"register_workbook_topology\",\n    \"build_curriculum_factory_graph\",\n    \"compiled_topology\",\n    \"graph_digest\",\n    \"contract_digests\",\n]\n\nGRAPH_NAME = \"plan26_curriculum_factory\"\n\n\nclass GraphBindingError(RuntimeError):\n    \"\"\"A production binding or edge was rejected before compilation.\"\"\"\n\n\n# Only these modules may supply a production node body. A callable from anywhere\n# else — a test module, a notebook, a locally defined lambda — is rejected by\n# stable ID, so \"the graph compiled\" can never mean \"the graph compiled against\n# a stand-in\".\nPRODUCTION_BINDING_MODULES: tuple[str, ...] = (\n    \"runtime.langgraph_factory.nodes\",\n    \"runtime.langgraph_factory.model_nodes\",\n    \"runtime.langgraph_factory.workbook\",\n    \"runtime.langgraph_factory.repair\",\n    \"runtime.langgraph_factory.acceptance\",\n)\n\nPLACEHOLDER_NAME_MARKERS: tuple[str, ...] = (\n    \"stub\",\n    \"placeholder\",\n    \"fake\",\n    \"dummy\",\n    \"mock\",\n    \"sample\",\n    \"example\",\n    \"todo\",\n    \"noop\",\n    \"test\",\n)\n\nPLACEHOLDER_SOURCE_MARKERS: tuple[str, ...] = (\n    \"raise NotImplementedError\",\n    \"TODO: implement\",\n    \"placeholder implementation\",\n)\n\n# Registered here, wired by a later graph node. A node that is neither wired by\n# the skeleton/unit-path tables `_validate_topology` inspects nor declared here\n# fails the build: silence about an unwired node is how a topology gap becomes\n# a silent halt at runtime.\n#\n# D16 and D17 need no row: once their bodies are members of `available`, they\n# are reached as real *destinations* of already-wired `unit_graph.UNIT_BRANCHES`\n# sources (D08/D09/D12/D14/D91 -> D17, M05 -> D16 -- the six rows `unit_graph\n# .DEFERRED_EDGES` names), so `_validate_topology`'s own `wired` set already\n# contains them. D18-D23 are reached only from *inside* the unit repair cycle\n# itself (D17 -> D18 -> ... -> D21 -> D16, D22 -> D23 -> D05), which is wired by\n# `acceptance.register_unit_repair_path` (via `register_unit_repair_topology`,\n# called after `register_skeleton` returns) rather than by any table\n# `_validate_topology` reads -- so they are declared deferred here for the same\n# reason M06/M07/M08 are: really wired, by a registration step this function\n# does not itself see.\nDEFERRED_TOPOLOGY: Mapping[str, str] = {\n    \"D18_PLAN_TARGETED_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D19_ROUTE_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D20_ADMIT_UNIT_REPAIR\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D21_RETEST_REQUIRED_DESCENDANTS\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D22_ACCEPT_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"D23_CHECKPOINT_ACCEPTED_UNIT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M06_REPAIR_NAMED_UNIT_ARTIFACT\": \"N31_REPAIR_ACCEPTANCE\",\n    \"M07_REVIEW_ACTUAL_WORKBOOK\": \"N32_WORKBOOK_TERMINALS\",\n    \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\": \"N32_WORKBOOK_TERMINALS\",\n}\n\nSKELETON_NORMAL_EDGES: tuple[tuple[str, str], ...] = (\n    (START, \"D00_BOOTSTRAP_EPISODE\"),\n    (\"D96_GRACEFUL_INTERRUPT_GATE\", \"D98_WRITE_TERMINAL\"),\n    (\"D98_WRITE_TERMINAL\", END),\n)\n\nSKELETON_BRANCHES: tuple[tuple[str, Callable[[Mapping[str, Any]], str]], ...] = (\n    (\"D00_BOOTSTRAP_EPISODE\", routing.route_bootstrap),\n    (\"D01_VALIDATE_AND_FREEZE_INPUTS\", routing.route_frozen_inputs),\n    (\"D02_COMPILE_EFFECTIVE_RUN\", routing.route_effective_run),\n    (\"D00R_REVALIDATE_RESUME_IDENTITY\", routing.route_resume_identity),\n    (\"D03_PROVE_CAPABILITIES\", routing.route_capabilities),\n    (\"D04_INITIALIZE_OR_RESUME\", routing.route_initialize_or_resume),\n)\n\n\n# --------------------------------------------------------------- runtime context\n\n\ndef _utc_clock() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef build_runtime_context(\n    *,\n    engine_root: Path | str,\n    output_root: Path | str,\n    run_id: str,\n    curriculum_digest: str,\n    authorization: Any = None,\n    capability_proof: Mapping[str, Any] | None = None,\n    retrieval_hosts: Sequence[str] = (),\n    clock: Callable[[], Any] = _utc_clock,\n    env_passthrough: Sequence[str] = (),\n) -> RuntimeContext:\n    \"\"\"Open the services one invocation may reach (spec section 5.2).\n\n    Constructed by the CLI after `prepare_episode_invocation` has fixed the run\n    identity, and supplied to `invoke(context=...)`; it is deliberately not built\n    inside the builder, because the transport and the authorization it enforces\n    are bound to a run identity that does not exist at build time.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    receipts = ReceiptLog(output_root / \".evidence\" / \"egress_receipts.jsonl\")\n    egress_guard = EgressGuard(receipts)\n    return RuntimeContext(\n        engine_root=engine_root,\n        output_root=output_root,\n        path_guard=ArtifactStore(output_root),\n        evidence_service=EvidenceStore(output_root),\n        transport_registry=tp.CliTransport(\n            output_root=output_root,\n            run_id=run_id,\n            curriculum_digest=curriculum_digest,\n            authorization=authorization,\n            receipts=receipts,\n            guard=egress_guard,\n            ledger=tp.AttemptLedger(),\n            capability_proof=capability_proof,\n            env_passthrough=env_passthrough,\n        ),\n        source_retriever=SourceRetriever(\n            guard=egress_guard,\n            policy=RetrievalPolicy(allowed_hosts=frozenset(retrieval_hosts)),\n        ),\n        signal_token=InterruptToken(output_root),\n        clock=clock,\n    )\n\n\n# ----------------------------------------------------------------- node boundary\n\n\ndef _mark_interrupt(update: Mapping[str, Any], node_id: str) -> dict[str, Any]:\n    \"\"\"Record a graceful signal on the guard record so routing stays pure.\"\"\"\n\n    marked = dict(update)\n    guard = marked.get(\"pending_guard\")\n    guard = dict(guard) if isinstance(guard, Mapping) else {\"node\": node_id, \"value\": None}\n    guard[\"interrupt_requested\"] = True\n    marked[\"pending_guard\"] = guard\n    return marked\n\n\ndef _boundary(node_id: str, body: Callable[..., Any], *, model_node: bool) -> Callable[..., Any]:\n    \"\"\"Wrap one node body in the common boundary of spec section 6.1.\n\n    LangGraph injects `Runtime`, not the opened services, so the boundary is also\n    the only place the `RuntimeContext` reaches a node body — N22's and N23's\n    callables take it as an explicit argument precisely so they cannot fetch it\n    themselves.\n    \"\"\"\n\n    def node(state: Mapping[str, Any], runtime: Runtime[RuntimeContext]) -> dict[str, Any]:\n        context = getattr(runtime, \"context\", None)\n        try:\n            if model_node:\n                update = body(state, build_model_node_context(context))\n            else:\n                update = body(state, context)\n        except GraphBubbleUp:\n            # LangGraph's own control flow (interrupt/resume propagation) is not a\n            # product failure and must reach the engine untouched.\n            raise\n        except Exception as error:  # the classified-failure contract of spec 6.1\n            return {\n                \"pending_failure\": {\n                    \"node\": node_id,\n                    \"class\": \"system\",\n                    \"cause\": \"unhandled\",\n                    \"message\": f\"{type(error).__name__}: {error}\",\n                    \"evidence\": {\"boundary\": \"node\"},\n                },\n                \"pending_guard\": None,\n            }\n        token = getattr(context, \"signal_token\", None)\n        if token is not None and bool(getattr(token, \"is_set\", lambda: False)()):\n            return _mark_interrupt(update, node_id)\n        return dict(update)\n\n    node.__name__ = node_id\n    node.__qualname__ = node_id\n    node.__doc__ = getattr(body, \"__doc__\", None)\n    node.plan26_binding = _binding_record(node_id, body)  # type: ignore[attr-defined]\n    return node\n\n\ndef _underlying(body: Callable[..., Any]) -> Callable[..., Any]:\n    \"\"\"The authored function behind a decorated node, for identity and audit.\"\"\"\n\n    return getattr(body, \"node_body\", body)\n\n\ndef _binding_record(node_id: str, body: Callable[..., Any]) -> dict[str, Any]:\n    target = _underlying(body)\n    try:\n        source = inspect.getsource(target)\n    except (OSError, TypeError):  # pragma: no cover - a source-less callable is rejected\n        source = \"\"\n    return {\n        \"node_id\": node_id,\n        \"module\": getattr(target, \"__module__\", \"\"),\n        \"qualname\": getattr(target, \"__qualname__\", \"\"),\n        \"source_sha256\": hashlib.sha256(source.encode(\"utf-8\")).hexdigest(),\n        \"source_lines\": len(source.splitlines()),\n    }\n\n\n# ------------------------------------------------------------ binding validation\n\n\ndef binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"Every node callable N20's own skeleton/unit-path tables resolve against.\n\n    N31's unit-repair-cycle nodes (D16-D23) carry no `NODE_CATALOGUE` row and\n    are deliberately absent from *this* function's return value even though\n    they are real, wired members of the compiled production graph: several of\n    N30's own tests in `test_plan26_unit_graph.py` independently recompute\n    their expectation directly from this function's return value, so it stays\n    exactly what it was before N31 (per N90 finding F1's own resolution --\n    `full_binding_inventory()`/`unit_repair_binding_inventory()` below are the\n    functions that widen it; this one never does). Use `unit_repair_binding_\n    inventory()` for the actual widened set `build_curriculum_factory_graph`\n    compiles against.\n\n    N32's workbook engine (D24-D32, `workbook.WORKBOOK_NODE_BODIES`) is\n    likewise absent from *this* function deliberately, not by oversight: D24\n    is `D05_SELECT_NEXT_UNIT`'s own `manifest_exhausted` destination, and\n    `unit_graph.DEFERRED_EDGES`/`unit_graph.UNIT_BRANCHES` (N30's frozen,\n    already-verified tables) declare that edge deferred to N32 by name. If D24\n    entered this function, `unit_graph.register_unit_path`'s *own*\n    `available`-derived destination set for `D05_SELECT_NEXT_UNIT` would\n    silently widen to include it -- correct for a production run, but it\n    would falsify N30's own already-passing topology tests, which independently\n    recompute their expectation from this exact function's return value.\n    `register_workbook_topology` registers the workbook engine as an additive\n    step over its own separate builder (N32 exercises it directly, not through\n    `build_curriculum_factory_graph`), so the unit path's registered edges stay\n    byte-identical to what they were before N32 and the workbook branch is\n    still fully real -- just not reachable from `D05` in this generation,\n    exactly as `unit_graph.DEFERRED_EDGES` documents.\n    \"\"\"\n\n    bindings: dict[str, Callable[..., Any]] = dict(node_registry())\n    for job_id, adapter in MODEL_NODE_ADAPTERS.items():\n        bindings[job_id] = adapter\n    bindings.update(MODEL_BOOKKEEPING_NODES)\n    return bindings\n\n\ndef unit_repair_binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"`binding_inventory()` plus this node's own D16-D23 unit-repair-cycle bodies.\n\n    The set `build_curriculum_factory_graph` actually compiles the one\n    production graph against (N90 finding F1): D16-D23 become real, reachable\n    members of that graph, while D24-D32 (N32's still-deferred workbook\n    engine) stay absent, exactly as `binding_inventory()`'s own docstring\n    documents for that pair. Kept separate from `binding_inventory()` itself\n    so N30's tests, which recompute their expectation directly from that\n    function's return value, stay unaffected by this widening.\n    \"\"\"\n\n    bindings = dict(binding_inventory())\n    bindings.update(acceptance.UNIT_REPAIR_NODE_BODIES)\n    return bindings\n\n\ndef full_binding_inventory() -> dict[str, Callable[..., Any]]:\n    \"\"\"`unit_repair_binding_inventory()` plus N32's workbook engine (D24-D32).\n\n    The complete node set this generation's node bodies span. Kept separate\n    from `binding_inventory()` itself for the reason documented there.\n    \"\"\"\n\n    bindings = dict(unit_repair_binding_inventory())\n    bindings.update(workbook.WORKBOOK_NODE_BODIES)\n    return bindings\n\n\ndef _reject(code: str, node_id: str, detail: str) -> None:\n    raise GraphBindingError(f\"{code}:{node_id}: {detail}\")\n\n\ndef validate_bindings(\n    bindings: Mapping[str, Callable[..., Any]],\n    *,\n    required: Sequence[str],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Reject a missing, placeholder, test-only, duplicate, or unusable binding.\"\"\"\n\n    for node_id in required:\n        if node_id not in bindings:\n            _reject(\"N20-BIND-MISSING\", node_id, \"no production callable is registered\")\n\n    seen: dict[tuple[str, str], str] = {}\n    inventory: dict[str, dict[str, Any]] = {}\n    for node_id in sorted(bindings):\n        body = bindings[node_id]\n        if not callable(body):\n            _reject(\"N20-BIND-UNCALLABLE\", node_id, f\"binding is {type(body).__name__}\")\n        record = _binding_record(node_id, body)\n        module = record[\"module\"]\n        if not any(\n            module == allowed or module.startswith(f\"{allowed}.\")\n            for allowed in PRODUCTION_BINDING_MODULES\n        ):\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"module {module!r} is not a production node module\")\n        lowered = f\"{module}.{record['qualname']}\".lower()\n        # Whole-word match, not substring: `D31_ADMIT_AND_RETEST_...` legitimately\n        # contains \"test\" inside \"retest\", and a placeholder heuristic that\n        # rejected every real \"retest\"/\"latest\"/\"contest\" binding would be a false\n        # positive on the spec's own vocabulary, not a caught stand-in.\n        marker = next(\n            (m for m in PLACEHOLDER_NAME_MARKERS if re.search(rf\"(?<![a-z]){re.escape(m)}(?![a-z])\", lowered)),\n            None,\n        )\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding name declares {marker!r}\")\n        if not record[\"source_sha256\"] or record[\"source_lines\"] == 0:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, \"binding has no readable source\")\n        source = inspect.getsource(_underlying(body))\n        marker = next((m for m in PLACEHOLDER_SOURCE_MARKERS if m in source), None)\n        if marker is not None:\n            _reject(\"N20-BIND-PLACEHOLDER\", node_id, f\"binding body declares {marker!r}\")\n        identity = (module, record[\"qualname\"])\n        if identity in seen:\n            _reject(\n                \"N20-BIND-DUPLICATE\",\n                node_id,\n                f\"shares callable {module}.{record['qualname']} with {seen[identity]}\",\n            )\n        seen[identity] = node_id\n        inventory[node_id] = record\n    return inventory\n\n\ndef _validate_topology(registered: Sequence[str]) -> None:\n    known = set(registered) | {START, END}\n    wired: set[str] = set()\n    for source, target in SKELETON_NORMAL_EDGES:\n        for endpoint in (source, target):\n            if endpoint not in known:\n                _reject(\"N20-EDGE-DANGLING\", endpoint, f\"edge {source} -> {target} names an unregistered node\")\n        wired.update({source, target})\n    for source, path in SKELETON_BRANCHES:\n        if source not in known:\n            _reject(\"N20-EDGE-DANGLING\", source, \"conditional edge source is not registered\")\n        wired.add(source)\n        for target in routing.guard_destinations(source):\n            if target not in known:\n                _reject(\n                    \"N20-EDGE-DANGLING\",\n                    target,\n                    f\"{source} branch {path.__name__} names an unregistered destination\",\n                )\n            wired.add(target)\n    for source, target in unit_graph.UNIT_NORMAL_EDGES:\n        wired.update({source, target})\n    for source, _ in unit_graph.UNIT_BRANCHES:\n        wired.add(source)\n        wired.update(unit_graph.branch_destinations(source, registered))\n    for node_id in registered:\n        if node_id in wired:\n            continue\n        owner = DEFERRED_TOPOLOGY.get(node_id)\n        if owner is None:\n            _reject(\n                \"N20-NODE-UNDECLARED\",\n                node_id,\n                \"is registered but neither wired by the skeleton nor declared deferred\",\n            )\n\n\n# ---------------------------------------------------------------- registration\n\n\ndef register_skeleton(\n    builder: StateGraph,\n    bindings: Mapping[str, Callable[..., Any]],\n) -> dict[str, dict[str, Any]]:\n    \"\"\"Register every available node and the fixed skeleton edges.\n\n    N30 and N32 extend the same builder by adding their own `add_node`-free\n    `add_edge`/`add_conditional_edges` calls after this returns; nothing here is\n    rewritten by them, so the skeleton stays the one place START, the recovery\n    branch, and the single edge to END are decided.\n    \"\"\"\n\n    routing.assert_guard_table_total(NODE_CATALOGUE)\n    inventory = validate_bindings(bindings, required=_skeleton_required_nodes())\n    _validate_topology(sorted(bindings))\n\n    for node_id in sorted(bindings):\n        model_node = node_id in MODEL_NODE_ADAPTERS\n        builder.add_node(node_id, _boundary(node_id, bindings[node_id], model_node=model_node))\n\n    for source, target in SKELETON_NORMAL_EDGES:\n        builder.add_edge(source, target)\n\n    for source, path in SKELETON_BRANCHES:\n        destinations = routing.guard_destinations(source)\n        builder.add_conditional_edges(source, path, {target: target for target in destinations})\n\n    unit_graph.register_unit_path(builder, sorted(bindings))\n\n    return inventory\n\n\ndef register_unit_repair_topology(builder: StateGraph, available: Sequence[str]) -> dict[str, tuple[str, ...]]:\n    \"\"\"Wire D16-D23's internal repair/acceptance cycle, additively over `register_skeleton`.\n\n    Called from `build_curriculum_factory_graph` immediately after `register_\n    skeleton` (which has already `add_node`-registered every member of\n    `unit_repair_binding_inventory()`, D16-D23 included) and after `unit_graph\n    .register_unit_path` (run inside `register_skeleton` itself). This closes\n    N90 finding F1 for the six DEFERRED_EDGES rows N31 owns: those six edges\n    are not added here -- they are `unit_graph.py`'s own rows, and resolve\n    automatically the moment D16/D17 are members of the bindings `register_\n    skeleton` receives -- this function adds only the loop internal to D16-D23\n    itself, which no other module owns.\n    \"\"\"\n\n    return acceptance.register_unit_repair_path(builder, available)\n\n\ndef register_workbook_topology(builder: StateGraph) -> dict[str, tuple[str, ...]]:\n    \"\"\"Register D24-D32 and wire the workbook branch, additively over `register_skeleton`.\n\n    Not called by `build_curriculum_factory_graph`: this generation's single\n    compile point is the N20-owned skeleton/unit-path catalogue only (spec\n    section 8's D00-D23/M01-M06/D90/D91), and `binding_inventory()`'s own\n    docstring documents why D24-D32 must stay absent from it. N32 owns wiring\n    this function into whatever the production compile point becomes once the\n    workbook branch is in scope; until then it is exercised directly, over its\n    own builder, the way N32's own topology test already does.\n    `register_skeleton` itself must never see these bindings; this function\n    adds exactly the nodes `register_skeleton` did not, then wires them over\n    the *full* merged node set so `workbook.register_workbook_path` can\n    resolve `D90`/`D91`/`D98`/M07/M08 as real, already-registered targets.\n    \"\"\"\n\n    workbook_bindings = dict(workbook.WORKBOOK_NODE_BODIES)\n    validate_bindings(workbook_bindings, required=tuple(workbook_bindings))\n    for node_id in sorted(workbook_bindings):\n        builder.add_node(node_id, _boundary(node_id, workbook_bindings[node_id], model_node=False))\n    return workbook.register_workbook_path(builder, sorted(full_binding_inventory()))\n\n\ndef _skeleton_required_nodes() -> tuple[str, ...]:\n    required = {source for source, _ in SKELETON_BRANCHES}\n    for source, target in SKELETON_NORMAL_EDGES:\n        required.update({source, target})\n    for source, _ in SKELETON_BRANCHES:\n        required.update(routing.guard_destinations(source))\n    return tuple(sorted(required - {START, END}))\n\n\ndef build_curriculum_factory_graph(\n    *, engine_root: Path, output_root: Path\n) -> CompiledStateGraph:\n    \"\"\"Build and compile the one production graph (spec section 4).\n\n    Compiles exactly once, over the output-root `SqliteSaver` N21 opens. The\n    returned graph is invoked with `context=build_runtime_context(...)`; no\n    services are captured at build time, so the compiled object carries no\n    run identity and no authorization.\n\n    Compiles against `unit_repair_binding_inventory()`, not `binding_\n    inventory()`: D16-D23 (this node's own unit repair/acceptance cycle) are\n    real, wired members of the one compiled production graph (N90 finding\n    F1), while D24-D32 (N32's still-deferred workbook engine) stay absent --\n    `register_unit_repair_topology` is called immediately after `register_\n    skeleton` to wire the loop internal to D16-D23 that no other module owns.\n    \"\"\"\n\n    engine_root = Path(engine_root).resolve()\n    output_root = Path(output_root).resolve()\n    builder: StateGraph = StateGraph(\n        FactoryState,\n        context_schema=RuntimeContext,\n        input_schema=FactoryInput,\n        output_schema=FactoryOutput,\n    )\n    bindings = unit_repair_binding_inventory()\n    register_skeleton(builder, bindings)\n    register_unit_repair_topology(builder, sorted(bindings))\n    saver, _connection = open_checkpoint_saver(output_root)\n    return builder.compile(checkpointer=saver, name=GRAPH_NAME)\n\n\n# ---------------------------------------------------------------------- digest\n\n\ndef _canonical_digest(payload: Any) -> str:\n    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(encoded.encode(\"utf-8\")).hexdigest()\n\n\ndef compiled_topology(compiled: CompiledStateGraph) -> dict[str, Any]:\n    \"\"\"The node/edge structure of an actually compiled graph, not a declared one.\"\"\"\n\n    drawn = compiled.get_graph()\n    return {\n        \"name\": compiled.name,\n        \"nodes\": sorted(drawn.nodes),\n        \"edges\": sorted(\n            [edge.source, edge.target, bool(edge.conditional)] for edge in drawn.edges\n        ),\n    }\n\n\ndef contract_digests() -> dict[str, str]:\n    \"\"\"File digests of every frozen model prompt and output schema.\n\n    Folded into the graph digest so prompt or schema drift is visible as graph\n    drift: the same topology over a changed prompt is not the same graph.\n    \"\"\"\n\n    digests: dict[str, str] = {}\n    registry = tp.load_job_registry()\n    for job_id in sorted(registry):\n        route = registry[job_id]\n        for path in (tp.resolve_prompt_path(route), tp.resolve_schema_path(route)):\n            path = Path(path)\n            digests[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return digests\n\n\ndef graph_digest(compiled: CompiledStateGraph) -> str:\n    \"\"\"Canonical-JSON digest over topology, bindings, state schema, and contracts.\n\n    Identical real bindings give an identical digest; a changed node body,\n    reducer declaration, prompt, or schema changes it. Python object identity is\n    deliberately not an input, so two builds in one process and two builds in two\n    processes agree.\n    \"\"\"\n\n    payload = {\n        \"topology\": compiled_topology(compiled),\n        \"bindings\": [\n            _binding_record(node_id, body)\n            for node_id, body in sorted(binding_inventory().items())\n        ],\n        \"state\": {\n            \"fields\": [[field, FIELD_REDUCER_CLASSES[field]] for field in FACTORY_STATE_FIELDS],\n            \"input\": list(FACTORY_INPUT_FIELDS),\n            \"output\": list(FACTORY_OUTPUT_FIELDS),\n        },\n        \"contracts\": contract_digests(),\n    }\n    return _canonical_digest(payload)\n","numLines":643,"startLine":1,"totalLines":643}}}
