{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R3qqtQb3WWVN97DcAMz4Am","type":"tool_result","content":"1694\tdef test_the_committed_path_stops_at_a_declared_deferred_edge(\n1695\t    tmp_path: Path, monkeypatch\n1696\t) -> None:\n1697\t    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n1698\t\n1699\t    The whole unit path now executes and M05 returns a real independent review.\n1700\t    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n1701\t    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n1702\t    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n1703\t    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n1704\t    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n1705\t    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n1706\t    F1). This only checks the halt is *some* declared row, not pinned to\n1707\t    today's, so it keeps proving \"no fabricated destination\" rather than just\n1708\t    \"today's specific one.\"\n1709\t    \"\"\"\n1710\t\n1711\t    fixture = _build_episode_fixture(tmp_path)\n1712\t    result = _run_episode(monkeypatch, fixture)\n1713\t\n1714\t    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n1715\t\n1716\t    state = result[\"state\"]\n1717\t    assert state.get(\"pending_failure\") is None\n1718\t    assert state.get(\"terminal\") is None\n1719\t    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n1720\t    # Every deterministic check the path ran passed, so the frontier is a clean\n1721\t    # handoff rather than a repair loop that happens to stop here.\n1722\t    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n1723\t    assert sorted(state[\"artifact_heads\"]) == [\n1724\t        \"units/U001/content\",\n1725\t        \"units/U001/domain\",\n1726\t        \"units/U001/visuals\",\n1727\t    ]\n1728\t\n1729\t\n1730\t@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\n1731\tdef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n1732\t    tmp_path: Path, monkeypatch, boundary: str\n1733\t) -> None:\n1734\t    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n1735\t\n1736\t    The signal is raised after `boundary` returns. The next boundary observes it,\n1737\t    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n1738\t    resume frontier — never two terminals, and never a product success. The\n1739\t    interrupt takes precedence over the guard value at every boundary, which is\n1740\t    why a signal raised after D09 still reaches the gate rather than D09's own\n1741\t    deferred destination.\n1742\t    \"\"\"\n1743\t\n1744\t    fixture = _build_episode_fixture(tmp_path, units=1)\n1745\t    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n1746\t    trace = result[\"trace\"]\n1747\t    terminal = result[\"state\"].get(\"terminal\")\n1748\t\n1749\t    assert boundary in trace\n1750\t    assert result[\"deferred_frontier\"] is None, (\n1751\t        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n1752\t    )\n1753\t    assert terminal is not None\n1754\t    assert terminal[\"kind\"] == \"INTERRUPTED\"\n1755\t    assert terminal[\"resumable\"] is True\n1756\t    assert terminal[\"exit_code\"] == 10\n1757\t    assert terminal[\"evidence\"][\"resume_frontier\"]\n1758\t    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n1759\t\n1760\t    # Exactly one terminal, counted as terminals and not as D98 entries. An\n1761\t    # interrupt raised inside a `Send` map sends every in-flight branch to the\n1762\t    # gate, so D96 and D98 legitimately run once per branch; what must never\n1763\t    # happen is a second terminal. The extra entries refuse rather than write.\n1764\t    assert len(result[\"state\"][\"terminal_history\"]) == 1\n1765\t    written = [\n1766\t        update\n1767\t        for node_id, update in result[\"updates\"]\n1768\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n1769\t    ]\n1770\t    assert len(written) == 1\n1771\t    for node_id, update in result[\"updates\"]:\n1772\t        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n1773\t            assert update[\"pending_failure\"][\"cause\"] == \"persistence\""}]},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"3168c2ed-595b-4f87-936e-e393957e4556","timestamp":"2026-08-12T23:12:56.272Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo/tests/runtime/test_plan26_unit_graph.py","content":"def test_the_committed_path_stops_at_a_declared_deferred_edge(\n    tmp_path: Path, monkeypatch\n) -> None:\n    \"\"\"The episode's real frontier is a declared row, never a fabricated one.\n\n    The whole unit path now executes and M05 returns a real independent review.\n    Whichever `DEFERRED_EDGES` row is currently open is where a clean episode\n    halts (today that is `M05_REVIEW_ACTUAL_UNIT`'s `review_returned` guard\n    resolving to `D16_REDUCE_UNIT_EVIDENCE`, N30's own declared handoff to N31;\n    once N31 wires D16-D23 the same clean episode legitimately proceeds through\n    D22/D23 and a second `D05_SELECT_NEXT_UNIT` call to halt on `DEFERRED_EDGES`'\n    still-open `manifest_exhausted` row instead — P-N30-001, closing N90 finding\n    F1). This only checks the halt is *some* declared row, not pinned to\n    today's, so it keeps proving \"no fabricated destination\" rather than just\n    \"today's specific one.\"\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path)\n    result = _run_episode(monkeypatch, fixture)\n\n    _assert_frontier_is_a_declared_row(result[\"deferred_frontier\"])\n\n    state = result[\"state\"]\n    assert state.get(\"pending_failure\") is None\n    assert state.get(\"terminal\") is None\n    assert \"D91_CLASSIFY_MODEL_FAILURE\" not in result[\"trace\"]\n    # Every deterministic check the path ran passed, so the frontier is a clean\n    # handoff rather than a repair loop that happens to stop here.\n    assert {check[\"result\"] for check in state[\"deterministic_checks\"]} == {\"PASS\"}\n    assert sorted(state[\"artifact_heads\"]) == [\n        \"units/U001/content\",\n        \"units/U001/domain\",\n        \"units/U001/visuals\",\n    ]\n\n\n@pytest.mark.parametrize(\"boundary\", REACHABLE_BOUNDARIES)\ndef test_a_graceful_interrupt_at_every_reachable_boundary_writes_one_terminal(\n    tmp_path: Path, monkeypatch, boundary: str\n) -> None:\n    \"\"\"Prompt TEST 9, over every node, map and barrier boundary the path reaches.\n\n    The signal is raised after `boundary` returns. The next boundary observes it,\n    routes to D96, and D98 writes exactly one `INTERRUPTED` terminal carrying a\n    resume frontier — never two terminals, and never a product success. The\n    interrupt takes precedence over the guard value at every boundary, which is\n    why a signal raised after D09 still reaches the gate rather than D09's own\n    deferred destination.\n    \"\"\"\n\n    fixture = _build_episode_fixture(tmp_path, units=1)\n    result = _run_episode(monkeypatch, fixture, interrupt_after=boundary)\n    trace = result[\"trace\"]\n    terminal = result[\"state\"].get(\"terminal\")\n\n    assert boundary in trace\n    assert result[\"deferred_frontier\"] is None, (\n        \"an interrupt must pre-empt a deferred product edge, not fall through it\"\n    )\n    assert terminal is not None\n    assert terminal[\"kind\"] == \"INTERRUPTED\"\n    assert terminal[\"resumable\"] is True\n    assert terminal[\"exit_code\"] == 10\n    assert terminal[\"evidence\"][\"resume_frontier\"]\n    assert \"D96_GRACEFUL_INTERRUPT_GATE\" in trace, trace\n\n    # Exactly one terminal, counted as terminals and not as D98 entries. An\n    # interrupt raised inside a `Send` map sends every in-flight branch to the\n    # gate, so D96 and D98 legitimately run once per branch; what must never\n    # happen is a second terminal. The extra entries refuse rather than write.\n    assert len(result[\"state\"][\"terminal_history\"]) == 1\n    written = [\n        update\n        for node_id, update in result[\"updates\"]\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is not None\n    ]\n    assert len(written) == 1\n    for node_id, update in result[\"updates\"]:\n        if node_id == \"D98_WRITE_TERMINAL\" and update.get(\"terminal\") is None:\n            assert update[\"pending_failure\"][\"cause\"] == \"persistence\"","numLines":80,"startLine":1694,"totalLines":2705}}}
