   compiled = _compiled_full_graph(tmp_path)\n    nodes = set(compiled.get_graph().nodes)\n    for node_id in workbook.WORKBOOK_NODE_BODIES:\n        assert node_id in nodes, node_id\n\n\ndef test_binding_inventory_and_unit_repair_binding_inventory_are_unchanged_by_this_wiring() -> None:\n    \"\"\"P-N32-001 requires both stay provably unchanged even though `build_\n    curriculum_factory_graph` now compiles against the wider `full_binding_\n    inventory()` -- N30's and N31's own frozen tests recompute their own\n    expectations directly from these two functions' return values, so this\n    node's own widening must be provably invisible to them.\"\"\"\n\n    narrow = set(G.binding_inventory())\n    widened_unit_repair = set(G.unit_repair_binding_inventory())\n    assert narrow.isdisjoint(workbook.WORKBOOK_NODE_BODIES)\n    assert widened_unit_repair.isdisjoint(workbook.WORKBOOK_NODE_BODIES)\n    full = set(G.full_binding_inventory())\n    assert full == widened_unit_repair | set(workbook.WORKBOOK_NODE_BODIES)\n\n\ndef test_widening_to_full_bindings_raises_no_topology_or_binding_error(tmp_path: Path) -> None:\n    \"\"\"`validate_bindings`'s placeholder/duplicate/uncallable checks and both\n    `register_skeleton`'s and `register_workbook_topology`'s own topology\n    checks all pass for D24-D32 exactly as they already do for the\n    pre-existing skeleton and D16-D23 -- proven by actually compiling, not\n    by re-reading source. A `GraphBindingError`/`UnitTopologyError` here\n    would fail this test by propagating, not by an assertion.\"\"\"\n\n    compiled = _compiled_full_graph(tmp_path)\n    nodes = set(compiled.get_graph().nodes)\n    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" in nodes\n    assert \"D32_RECOMPUTE_FINAL_RELEASE\" in nodes\n\n\ndef test_the_d05_to_d24_deferred_edge_row_is_now_a_real_compiled_edge(tmp_path: Path) -> None:\n    \"\"\"Not merely absent from a \"still deferred\" set (the way `test_blocked_\n    d91_cannot_reach_d29_yet` checks the *other*, still-open row stays\n    deferred): this row must appear as an actual conditional edge of the\n    real compiled graph.\"\"\"\n\n    compiled = _compiled_full_graph(tmp_path)\n    edges = {(source, target) for source, target, _conditional in G.compiled_topology(compiled)[\"edges\"]}\n    assert (\"D05_SELECT_NEXT_UNIT\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\") in edges\n\n\nclass _WorkbookCapableStubRegistry(UG._StubRegistry):  # type: ignore[misc]\n    \"\"\"`UG._StubRegistry` (the unit renderer/inspector the real compiled\n    episode already exercises) plus D25/D26's own assembler/inspector\n    surface (`transport_registry.assemble_workbook`/`.inspect_workbook_\n    pages`), so a full real-compiled-graph run can pass through D24-D32\n    without editing `test_plan26_unit_graph.py` (outside this node's write\n    set) to teach its own harness a workbook capability it has no reason to\n    carry for its own generation's tests. Mirrors this file's own `_Registry`\n    test double above, adapted to `_StubRegistry`'s `self.sandbox`.\n    \"\"\"\n\n    def assemble_workbook(self, ordered_unit_ids: Any, unit_pdf_hashes: Any, front_matter: Any) -> dict[str, Any]:\n        body = json.dumps(\n            {\"ordered\": list(ordered_unit_ids), \"hashes\": dict(unit_pdf_hashes)}, sort_keys=True\n        ).encode()\n        path = self.sandbox / f\"workbook-{hashlib.sha256(body).hexdigest()[:16]}.pdf\"\n        sha = _write(path, body)\n        return {\n            \"workbook_pdf_path\": str(path),\n            \"workbook_pdf_sha256\": sha,\n            \"navigation\": {\"toc\": list(ordered_unit_ids)},\n            \"assembly_map\": [\n                {\"unit_id\": unit_id, \"unit_pdf_sha256\": unit_pdf_hashes[unit_id]}\n                for unit_id in ordered_unit_ids\n            ],\n        }\n\n    def inspect_workbook_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n        pages = []\n        for number in (1, 2):\n            image = self.sandbox / f\"wb-page-{pdf_sha256[:8]}-{number}.png\"\n            sha = _write(image, f\"page-{number}-{pdf_sha256}\".encode())\n            pages.append(\n                {\"number\": number, \"page_sha256\": sha, \"image_path\": str(image), \"problems\": [], \"unreadable\": False}\n            )\n        return {\"pages\": pages}\n\n\ndef _scripted_candidate_with_workbook_review(job_id: str, projection: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"`UG._scripted_candidate` plus the one workbook-owned job it predates.\n\n    Delegates every other job id to the real, unmodified `UG._scripted_\n    candidate` -- this is additive scripting over the unit path's own\n    scripted responses, not a fork of them.\n    \"\"\"\n\n    if job_id == \"M07_REVIEW_ACTUAL_WORKBOOK\":\n        pages = projection.get(\"pages\") or []\n        return {\n            \"overall_findings\": [],\n            \"page_findings\": [\n                {\"page_number\": int(page[\"page_number\"]), \"page_sha256\": str(page[\"page_sha256\"]), \"findings\": []}\n                for page in pages\n            ],\n        }\n    return UG._scripted_candidate(job_id, projection)\n\n\ndef _run_full_episode_to_workbook(monkeypatch: Any, fixture: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"A real run of the real compiled production graph, `mode=\"all\"`, one\n    unit, through the whole unit path, D24-D32, and the real D98 -- the\n    P-N32-001 required proof that the whole chain (D05 exhaustion -> D24\n    coverage -> D25 through D32) actually executes, not just that the nodes\n    exist. Reuses `UG._build_episode_fixture`/`_prepare_episode`/\n    `_HarnessContext`/`_scripted_model_context`, exactly the fake-CLI-\n    transport/scripted-response pattern `test_plan26_adversarial.py`\n    established and N31's own new tests already reused.\n    \"\"\"\n\n    monkeypatch.setattr(UG, \"_StubRegistry\", _WorkbookCapableStubRegistry)\n    monkeypatch.setattr(UG, \"_scripted_candidate\", _scripted_candidate_with_workbook_review)\n\n    lock, invocation, envelope = UG._prepare_episode(fixture, mode=\"all\", requested=None)\n    context = UG._HarnessContext(fixture[\"engine\"], fixture[\"output_root\"], fixture[\"sandbox\"])\n    monkeypatch.setattr(\n        G, \"build_model_node_context\", lambda _context, **_kwargs: UG._scripted_model_context(fixture[\"sandbox\"])\n    )\n    compiled = G.build_curriculum_factory_graph(engine_root=fixture[\"engine\"], output_root=fixture[\"output_root\"])\n\n    trace: list[str] = []\n    for chunk in compiled.stream(\n        {\"invocation\": envelope}, config=invocation.config, stream_mode=\"updates\", context=context\n    ):\n        trace.extend(chunk)\n    lock.release()\n    return {\n        \"trace\": trace,\n        \"state\": compiled.get_state(invocation.config).values,\n        \"compiled\": compiled,\n        \"invocation\": invocation,\n    }\n\n\ndef test_a_real_compiled_graph_run_reaches_a_real_workbook_complete_terminal(\n    tmp_path: Path, monkeypatch: Any\n) -> None:\n    \"\"\"The full chain, over the real compiled production graph, no stand-in.\n\n    A one-unit `mode=\"all\"` episode really runs D00 through the whole unit\n    path (M01-M05 scripted, D16-D23 accept, exactly N31's own proof), then\n    really exhausts the manifest at `D05`, really proves coverage at `D24`,\n    really assembles/inspects/reviews/reduces/releases the workbook at\n    D25-D32 (M07 scripted), and really reaches `D98_WRITE_TERMINAL` -- the\n    one real, unmodified N22-owned terminal writer -- with a `COMPLETE`\n    verdict. Nothing here fabricates a terminal: `D98`'s own `_validate_\n    complete` independently re-derives and accepts this run's candidate.\n    \"\"\"\n\n    fixture = UG._build_episode_fixture(tmp_path)\n    result = _run_full_episode_to_workbook(monkeypatch, fixture)\n\n    trace = result[\"trace\"]\n    for node_id in (\n        \"D22_ACCEPT_UNIT\",\n        \"D23_CHECKPOINT_ACCEPTED_UNIT\",\n        \"D24_PROVE_EXACT_MANIFEST_COVERAGE\",\n        \"D25_ASSEMBLE_WORKBOOK\",\n        \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n        \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\",\n        \"M07_REVIEW_ACTUAL_WORKBOOK\",\n        \"D28_REDUCE_WORKBOOK_EVIDENCE\",\n        \"D32_RECOMPUTE_FINAL_RELEASE\",\n        \"D98_WRITE_TERMINAL\",\n    ):\n        assert node_id in trace, (node_id, trace)\n\n    unit_position = trace.index(\"D23_CHECKPOINT_ACCEPTED_UNIT\")\n    coverage_position = trace.index(\"D24_PROVE_EXACT_MANIFEST_COVERAGE\")\n    release_position = trace.index(\"D32_RECOMPUTE_FINAL_RELEASE\")\n    terminal_position = trace.index(\"D98_WRITE_TERMINAL\")\n    assert unit_position < coverage_position < release_position < terminal_position\n\n    state = result[\"state\"]\n    terminal_record = state.get(\"terminal\")\n    assert terminal_record is not None\n    assert terminal_record[\"kind\"] == \"COMPLETE\"\n    assert terminal_record[\"validation\"][\"accepted\"] is True\n    assert state[\"accepted_unit_receipts\"][\"U001\"][\"receipt_hash\"]"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":912,"cache_read_input_tokens":210442,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":912},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"488594ff-cef8-4831-9c69-e4a7946d2de4","timestamp":"2026-08-12T23:21:34.018Z","request_id":"req_011CdyiGk7umUCVxW28xvpkv"}
