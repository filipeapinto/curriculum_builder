{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WsTYQHfkvhRw6R5Weg7TnU","type":"tool_result","content":"1\t\"\"\"N32 workbook terminals tests: D24-D32 assembly/review/repair/release and D98.\n2\t\n3\tTen TEST items from `prompts/N32_workbook_terminals.prompt.v2.md`. Every\n4\tfunction under test is called directly and unmodified from\n5\t`runtime.langgraph_factory.workbook`; TEST 7-9 additionally call the real,\n6\tunmodified `runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's\n7\tD98) rather than a stand-in, and no test in this file writes to\n8\t`nodes/terminal.py`.\n9\t\n10\tA known, declared gap closes out the file (`test_blocked_*`, matching the\n11\tconvention `test_plan26_unit_graph.py` already established for exactly this\n12\tsituation): `D91_CLASSIFY_MODEL_FAILURE`'s branch is registered once, by\n13\t`unit_graph.py` (N30, not in this node's write set), with a frozen\n14\tdestination set that does not name `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR`.\n15\tA transport failure on `M07`/`M08` that D91 classifies as repairable\n16\ttherefore cannot reach D29 through the *compiled* graph in this generation;\n17\tD29 itself is fully correct and independently tested at the function level\n18\tbelow. The gap is owed to N30_UNIT_GRAPH (`unit_flow_or_denominator` rework\n19\tedge), not to this node.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport hashlib\n25\timport json\n26\tfrom pathlib import Path\n27\tfrom typing import Any\n28\t\n29\timport pytest\n30\t\n31\tfrom runtime.langgraph_factory import graph as G\n32\tfrom runtime.langgraph_factory import routing as R\n33\tfrom runtime.langgraph_factory import unit_graph as U\n34\tfrom runtime.langgraph_factory import workbook\n35\tfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id, terminal\n36\tfrom runtime.langgraph_factory.state import FIELD_REDUCERS\n37\t\n38\tREPO_ROOT = Path(__file__).resolve().parents[2]\n39\tWORKBOOK_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"workbook.py\"\n40\t\n41\tRUN = \"run-n32\"\n42\tEPISODE = \"ep-n32\"\n43\tU1 = \"U001\"\n44\tU2 = \"U002\"\n45\t\n46\t\n47\tdef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n48\t    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n49\t\n50\t    merged = dict(state)\n51\t    for field, value in update.items():\n52\t        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n53\t    return merged\n54\t\n55\t\n56\tdef _write(path: Path, body: bytes) -> str:\n57\t    path.parent.mkdir(parents=True, exist_ok=True)\n58\t    path.write_bytes(body)\n59\t    return hashlib.sha256(body).hexdigest()\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# fixtures: real files on disk, a fake assembler/inspector, two accepted units\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tclass _Registry:\n68\t    \"\"\"The workbook assembler/inspector surface D25/D26 reach for.\"\"\"\n69\t\n70\t    def __init__(self, sandbox: Path, workbook_pages: int = 2) -> None:\n71\t        self.sandbox = sandbox\n72\t        self.workbook_pages = workbook_pages\n73\t        self.assemble_calls: list[tuple[list[str], dict[str, str]]] = []\n74\t\n75\t    def assemble_workbook(self, ordered_unit_ids: Any, unit_pdf_hashes: Any, front_matter: Any) -> dict[str, Any]:\n76\t        self.assemble_calls.append((list(ordered_unit_ids), dict(unit_pdf_hashes)))\n77\t        body = json.dumps({\"ordered\": list(ordered_unit_ids), \"hashes\": dict(unit_pdf_hashes)}, sort_keys=True).encode()\n78\t        # A deterministic, content-derived path: two assemblies of the same\n79\t        # input (e.g. a crash-replay of D25) must produce byte-identical\n80\t        # results, which an incrementing filename would falsify.\n81\t        path = self.sandbox / f\"workbook-{hashlib.sha256(body).hexdigest()[:16]}.pdf\"\n82\t        sha = _write(path, body)\n83\t        return {\n84\t            \"workbook_pdf_path\": str(path),\n85\t            \"workbook_pdf_sha256\": sha,\n86\t            \"navigation\": {\"toc\": list(ordered_unit_ids)},\n87\t            \"assembly_map\": [\n88\t                {\"unit_id\": unit_id, \"unit_pdf_sha256\": unit_pdf_hashes[unit_id]}\n89\t                for unit_id in ordered_unit_ids\n90\t            ],\n91\t        }\n92\t\n93\t    def inspect_workbook_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n94\t        pages = []\n95\t        for number in range(1, self.workbook_pages + 1):\n96\t            image = self.sandbox / f\"wb-page-{pdf_sha256[:8]}-{number}.png\"\n97\t            sha = _write(image, f\"page-{number}-{pdf_sha256}\".encode())\n98\t            pages.append(\n99\t                {\"number\": number, \"page_sha256\": sha, \"image_path\": str(image), \"problems\": [], \"unreadable\": False}\n100\t            )\n101\t        return {\"pages\": pages}\n102\t\n103\t\n104\tclass _Context:\n105\t    def __init__(self, sandbox: Path, registry: Any = None) -> None:\n106\t        self.engine_root = REPO_ROOT\n107\t        self.output_root = sandbox\n108\t        self.transport_registry = registry or _Registry(sandbox)\n109\t        self.source_retriever = None\n110\t        self.signal_token = None\n111\t        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n112\t\n113\t\n114\tdef _unit_layout(tmp_path: Path, unit_id: str) -> tuple[dict[str, Any], str]:\n115\t    body = f\"unit-pdf-{unit_id}\".encode()\n116\t    path = tmp_path / f\"{unit_id}.pdf\"\n117\t    sha = _write(path, body)\n118\t    record = {\n119\t        \"stream\": stream_id(unit_id, \"layout\"),\n120\t        \"version\": 1,\n121\t        \"parent_hash\": None,\n122\t        \"hash\": canonical_digest({\"unit\": unit_id, \"pdf\": sha}),\n123\t        \"pdf_path\": str(path),\n124\t        \"pdf_sha256\": sha,\n125\t    }\n126\t    return record, sha\n127\t\n128\t\n129\tdef _accepted_receipt(unit_id: str, pdf_sha256: str) -> dict[str, Any]:\n130\t    denominator = {\"pages\": {\"result\": \"PASS\", \"pdf_sha256\": pdf_sha256, \"page_count\": 1}}\n131\t    body = {\"unit_id\": unit_id, \"denominator\": denominator, \"artifact_head_hashes\": {}, \"log_high_water_mark\": 0}\n132\t    receipt = dict(body)\n133\t    receipt[\"receipt_hash\"] = canonical_digest(body)\n134\t    return receipt\n135\t\n136\t\n137\tdef _base_state(tmp_path: Path, unit_ids: tuple[str, ...] = (U1, U2)) -> dict[str, Any]:\n138\t    artifact_versions = []\n139\t    accepted: dict[str, Any] = {}\n140\t    for unit_id in unit_ids:\n141\t        layout, sha = _unit_layout(tmp_path, unit_id)\n142\t        artifact_versions.append(layout)\n143\t        accepted[unit_id] = _accepted_receipt(unit_id, sha)\n144\t    return {\n145\t        \"run_id\": RUN,\n146\t        \"episode_id\": EPISODE,\n147\t        \"mode\": \"all\",\n148\t        \"requested_unit_id\": None,\n149\t        \"effective_run\": {\"target_closure\": list(unit_ids), \"ordered_unit_ids\": list(unit_ids)},\n150\t        \"accepted_unit_receipts\": accepted,\n151\t        \"artifact_versions\": artifact_versions,\n152\t        \"checkpoint_metadata\": [{\"checkpoint_id\": \"ckpt-1\"}],\n153\t        \"evidence_index_entries\": [],\n154\t        \"engine_root\": str(REPO_ROOT),\n155\t        \"workbook_coverage\": [],\n156\t        \"workbook_versions\": [],\n157\t        \"workbook_head\": {},\n158\t        \"workbook_page_inventories\": [],\n159\t        \"workbook_page_inspections\": [],\n160\t        \"workbook_reviews\": [],\n161\t        \"workbook_review_packets\": [],\n162\t        \"workbook_finding_partitions\": [],\n163\t        \"workbook_repair_requests\": [],\n164\t        \"workbook_retests\": [],\n165\t        \"final_release_audits\": [],\n166\t        \"attempt_counters\": {},\n167\t        \"deterministic_checks\": [],\n168\t    }\n169\t\n170\t\n171\tdef _review_candidate(pdf_sha256: str, inspections: list[dict[str, Any]]) -> dict[str, Any]:\n172\t    return {\n173\t        \"key\": f\"candidate:m07:{pdf_sha256}\",\n174\t        \"record_kind\": \"model_candidate\",\n175\t        \"job_id\": \"M07_REVIEW_ACTUAL_WORKBOOK\",\n176\t        \"workbook_pdf_sha256\": pdf_sha256,\n177\t        \"page_count\": len(inspections),\n178\t        \"payload\": {\n179\t            \"overall_findings\": [],\n180\t            \"page_findings\": [\n181\t                {\"page_number\": record[\"page\"], \"page_sha256\": record[\"page_sha256\"], \"findings\": []}\n182\t                for record in inspections\n183\t            ],\n184\t        },\n185\t    }\n186\t\n187\t\n188\tdef _assemble_and_review(tmp_path: Path, sandbox: Path, unit_ids: tuple[str, ...] = (U1, U2)) -> dict[str, Any]:\n189\t    \"\"\"D24 -> D25 -> D26 -> D27 -> (a clean M07 candidate) -> D28, all real calls.\"\"\"\n190\t\n191\t    state = _base_state(tmp_path, unit_ids)\n192\t    context = _Context(sandbox)\n193\t\n194\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, context))\n195\t    assert state[\"pending_guard\"][\"value\"] == \"manifest_coverage_proven\"\n196\t\n197\t    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, context))\n198\t    assert state[\"pending_guard\"][\"value\"] == \"workbook_assembled\"\n199\t\n200\t    state = _apply(state, workbook.D26_RENDER_INVENTORY_INSPECT_WORKBOOK(state, context))\n201\t    assert state[\"pending_guard\"][\"value\"] == \"workbook_pages_inspected\"\n202\t\n203\t    state = _apply(state, workbook.D27_FREEZE_WORKBOOK_REVIEW_PACKET(state, context))\n204\t    assert state[\"pending_guard\"][\"value\"] == \"workbook_packet_frozen\"\n205\t\n206\t    pdf_sha256 = state[\"workbook_page_inventories\"][-1][\"pdf_sha256\"]\n207\t    review = _review_candidate(pdf_sha256, state[\"workbook_page_inspections\"])\n208\t    state = _apply(state, {\"workbook_reviews\": [review]})\n209\t    return state\n210\t\n211\t\n212\t# ---------------------------------------------------------------------------\n213\t# TEST 1: missing/extra/reordered/wrong-hash unit blocks assembly\n214\t# ---------------------------------------------------------------------------\n215\t\n216\t\n217\tdef test_d24_all_mode_rejects_a_manifest_that_is_missing_a_receipt(tmp_path: Path) -> None:\n218\t    state = _base_state(tmp_path)\n219\t    del state[\"accepted_unit_receipts\"][U2]\n220\t    with pytest.raises(SystemFailure):\n221\t        workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n222\t\n223\t\n224\tdef test_d24_all_mode_rejects_an_extra_receipt_outside_the_manifest(tmp_path: Path) -> None:\n225\t    state = _base_state(tmp_path)\n226\t    state[\"accepted_unit_receipts\"][\"U999\"] = _accepted_receipt(\"U999\", \"f\" * 64)\n227\t    # Extra receipts are harmless to D24's own predicate (it only requires\n228\t    # every *closure* member accepted); the coverage proof still names\n229\t    # exactly the manifest order, never the stray extra member.\n230\t    update = workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n231\t    assert update[\"workbook_coverage\"][0][\"ordered_unit_ids\"] == [U1, U2]\n232\t    assert \"U999\" not in update[\"workbook_coverage\"][0][\"receipt_hashes\"]\n233\t\n234\t\n235\tdef test_d25_rejects_an_assembly_map_the_assembler_reordered(tmp_path: Path) -> None:\n236\t    \"\"\"A local assembler that reorders/renames the assembly map never ships.\"\"\"\n237\t\n238\t    sandbox = tmp_path / \"sandbox\"\n239\t    state = _base_state(tmp_path)\n240\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n241\t\n242\t    registry = _Registry(sandbox)\n243\t    original = registry.assemble_workbook\n244\t\n245\t    def _reordered(ordered_unit_ids: Any, unit_pdf_hashes: Any, front_matter: Any) -> dict[str, Any]:\n246\t        result = original(ordered_unit_ids, unit_pdf_hashes, front_matter)\n247\t        result[\"assembly_map\"] = list(reversed(result[\"assembly_map\"]))\n248\t        return result\n249\t\n250\t    registry.assemble_workbook = _reordered  # type: ignore[method-assign]\n251\t    with pytest.raises(SystemFailure) as error:\n252\t        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox, registry))\n253\t    assert error.value.cause == \"integrity\"\n254\t\n255\t\n256\tdef test_d25_refuses_a_unit_pdf_that_changed_after_acceptance(tmp_path: Path) -> None:\n257\t    sandbox = tmp_path / \"sandbox\"\n258\t    state = _base_state(tmp_path)\n259\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n260\t\n261\t    # Mutate the on-disk bytes of one accepted unit's PDF after coverage was\n262\t    # proven: byte-for-byte immutability (spec section 13.2 item 2) is checked\n263\t    # again, freshly, at assembly.\n264\t    layout = next(r for r in state[\"artifact_versions\"] if r[\"stream\"] == stream_id(U1, \"layout\"))\n265\t    Path(layout[\"pdf_path\"]).write_bytes(b\"tampered\")\n266\t\n267\t    with pytest.raises(SystemFailure) as error:\n268\t        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox))\n269\t    assert error.value.cause == \"integrity\"\n270\t\n271\t\n272\tdef test_d25_refuses_a_wrong_hash_layout_version(tmp_path: Path) -> None:\n273\t    sandbox = tmp_path / \"sandbox\"\n274\t    state = _base_state(tmp_path)\n275\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n276\t    # The layout version itself now disagrees with the accepted receipt's\n277\t    # frozen hash -- a stale/rewritten layout, not a stale-disk-bytes case.\n278\t    state[\"artifact_versions\"] = [\n279\t        {**record, \"pdf_sha256\": \"0\" * 64} if record[\"stream\"] == stream_id(U1, \"layout\") else record\n280\t        for record in state[\"artifact_versions\"]\n281\t    ]\n282\t    with pytest.raises(SystemFailure):\n283\t        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox))\n284\t\n285\t\n286\t# ---------------------------------------------------------------------------\n287\t# TEST 2: positive contiguous workbook inventory, every page reaches M07\n288\t# ---------------------------------------------------------------------------\n289\t\n290\t\n291\tdef test_workbook_assembly_through_review_freezes_every_page_once(tmp_path: Path) -> None:\n292\t    sandbox = tmp_path / \"sandbox\"\n293\t    state = _assemble_and_review(tmp_path, sandbox)\n294\t\n295\t    inventory = state[\"workbook_page_inventories\"][-1]\n296\t    assert inventory[\"result\"] == \"PASS\"\n297\t    assert inventory[\"contiguous\"] is True\n298\t    assert inventory[\"page_count\"] == 2\n299\t\n300\t    packet = state[\"workbook_review_packets\"][-1]\n301\t    assert packet[\"page_count\"] == 2\n302\t    assert len(packet[\"page_keys\"]) == 2\n303\t    assert len(set(packet[\"page_keys\"])) == 2\n304\t    assert packet[\"accepted_unit_hashes\"] == {\n305\t        U1: state[\"accepted_unit_receipts\"][U1][\"denominator\"][\"pages\"][\"pdf_sha256\"],\n306\t        U2: state[\"accepted_unit_receipts\"][U2][\"denominator\"][\"pages\"][\"pdf_sha256\"],\n307\t    }\n308\t\n309\t    dispatched = state[\"pending_packet\"][\"packets\"]\n310\t    assert len(dispatched) == 1\n311\t    projected_pages = dispatched[0][\"pages\"]\n312\t    assert [p[\"page_number\"] for p in projected_pages] == [1, 2]\n313\t    assert [p[\"page_sha256\"] for p in projected_pages] == [\n314\t        record[\"page_sha256\"] for record in state[\"workbook_page_inspections\"]\n315\t    ]\n316\t\n317\t\n318\t@pytest.mark.parametrize(\"defect\", [\"empty\", \"non_contiguous\"])\n319\tdef test_workbook_inventory_that_cannot_be_proven_is_repairable_not_shipped(tmp_path: Path, defect: str) -> None:\n320\t    sandbox = tmp_path / \"sandbox\"\n321\t    state = _base_state(tmp_path)\n322\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n323\t\n324\t    registry = _Registry(sandbox)\n325\t    if defect == \"empty\":\n326\t        registry.inspect_workbook_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n327\t    else:\n328\t        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n329\t            report = _Registry.inspect_workbook_pages(registry, pdf_path, pdf_sha256)\n330\t            report[\"pages\"][-1][\"number\"] = 9\n331\t            return report\n332\t\n333\t        registry.inspect_workbook_pages = _skewed  # type: ignore[method-assign]\n334\t\n335\t    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox, registry)))\n336\t    update = workbook.D26_RENDER_INVENTORY_INSPECT_WORKBOOK(state, _Context(sandbox, registry))\n337\t    assert update[\"workbook_page_inventories\"][0][\"result\"] == \"FAIL\"\n338\t    assert update[\"pending_guard\"][\"value\"] == \"workbook_layout_repairable\"\n339\t    merged = {**state, **update}\n340\t    assert R.route_workbook_inspection(merged) == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n341\t\n342\t\n343\t# ---------------------------------------------------------------------------\n344\t# TEST 3: missing/stale/failed/NOT_RUN workbook evidence blocks release\n345\t# ---------------------------------------------------------------------------\n346\t\n347\t\n348\t@pytest.mark.parametrize(\n349\t    \"mutate\",\n350\t    [\n351\t        lambda s: s.__setitem__(\"workbook_coverage\", []),\n352\t        lambda s: s.__setitem__(\"workbook_page_inspections\", []),\n353\t        lambda s: s.__setitem__(\n354\t            \"workbook_page_inventories\",\n355\t            [{**s[\"workbook_page_inventories\"][-1], \"result\": \"FAIL\"}],\n356\t        ),\n357\t        lambda s: s.__setitem__(\"workbook_reviews\", []),\n358\t    ],\n359\t    ids=[\"coverage_missing\", \"pages_missing\", \"inventory_failed\", \"review_not_run\"],\n360\t)\n361\tdef test_removing_or_failing_any_evidence_member_blocks_the_denominator(tmp_path: Path, mutate: Any) -> None:\n362\t    sandbox = tmp_path / \"sandbox\"\n363\t    state = _assemble_and_review(tmp_path, sandbox)\n364\t    mutate(state)\n365\t    result = workbook.compute_workbook_denominator(state)\n366\t    assert not result.passed\n367\t\n368\t\n369\tdef test_the_full_denominator_passes_once_every_member_is_current(tmp_path: Path) -> None:\n370\t    sandbox = tmp_path / \"sandbox\"\n371\t    state = _assemble_and_review(tmp_path, sandbox)\n372\t    result = workbook.compute_workbook_denominator(state)\n373\t    assert result.passed, result.denominator\n374\t\n375\t\n376\t# ---------------------------------------------------------------------------\n377\t# TEST 4: M08/deterministic repair cannot alter accepted unit hashes\n378\t# ---------------------------------------------------------------------------\n379\t\n380\t\n381\tdef _repairable_layout_state(tmp_path: Path, sandbox: Path) -> dict[str, Any]:\n382\t    \"\"\"A workbook one deterministic layout finding away from repair.\"\"\"\n383\t\n384\t    state = _base_state(tmp_path)\n385\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n386\t    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox)))\n387\t    state[\"pending_guard\"] = {\n388\t        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n389\t        \"value\": \"workbook_layout_repairable\",\n390\t        \"detail\": {\n391\t            \"findings\": [\n392\t                {\"component\": \"layout\", \"check_id\": \"workbook_page_inventory\", \"pointer\": \"/assembly/pages\", \"message\": \"bad\"}\n393\t            ]\n394\t        },\n395\t    }\n396\t    return state\n397\t\n398\t\n399\tdef test_a_deterministic_layout_repair_never_touches_accepted_unit_hashes(tmp_path: Path) -> None:\n400\t    sandbox = tmp_path / \"sandbox\"\n401\t    state = _repairable_layout_state(tmp_path, sandbox)\n402\t    plan = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n403\t    assert plan[\"pending_guard\"][\"value\"] == \"deterministic_repair\"\n404\t    candidate = plan[\"workbook_versions\"][0]\n405\t    parent_hashes = state[\"workbook_head\"][\"workbook\"]\n406\t    parent_version = next(v for v in state[\"workbook_versions\"] if v[\"hash\"] == parent_hashes[\"hash\"])\n407\t    assert candidate[\"body\"][\"coverage\"][\"unit_pdf_hashes\"] == parent_version[\"body\"][\"coverage\"][\"unit_pdf_hashes\"]\n408\t\n409\t    admitted = _apply(_apply(state, plan), {})\n410\t    update = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(admitted, None)\n411\t    assert update[\"pending_guard\"][\"value\"] == \"workbook_repair_admitted\"\n412\t    assert update[\"workbook_versions\"][0][\"body\"][\"coverage\"][\"unit_pdf_hashes\"] == parent_version[\"body\"][\"coverage\"][\"unit_pdf_hashes\"]\n413\t\n414\t\n415\tdef test_d31_refuses_a_model_candidate_that_changes_an_accepted_unit_hash(tmp_path: Path) -> None:\n416\t    sandbox = tmp_path / \"sandbox\"\n417\t    state = _repairable_layout_state(tmp_path, sandbox)\n418\t    state[\"pending_guard\"] = {\n419\t        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n420\t        \"value\": \"workbook_layout_repairable\",\n421\t        \"detail\": {\n422\t            \"findings\": [\n423\t                {\"component\": \"front_matter\", \"check_id\": \"x\", \"pointer\": \"/front_matter\", \"message\": \"bad\"}\n424\t            ]\n425\t        },\n426\t    }\n427\t    plan = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n428\t    assert plan[\"pending_guard\"][\"value\"] == \"model_repair\"\n429\t    state = _apply(state, plan)\n430\t\n431\t    head = state[\"workbook_head\"][\"workbook\"]\n432\t    parent_version = next(v for v in state[\"workbook_versions\"] if v[\"hash\"] == head[\"hash\"])\n433\t    tampered_body = dict(parent_version[\"body\"])\n434\t    tampered_body[\"coverage\"] = {\n435\t        **tampered_body[\"coverage\"],\n436\t        \"unit_pdf_hashes\": {**tampered_body[\"coverage\"][\"unit_pdf_hashes\"], U1: \"0\" * 64},\n437\t    }\n438\t    request_key = state[\"workbook_repair_requests\"][-1][\"key\"]\n439\t    candidate = {\n440\t        \"key\": f\"candidate:m08:{request_key}\",\n441\t        \"record_kind\": \"model_candidate\",\n442\t        \"job_id\": \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\",\n443\t        \"parent_sha256\": head[\"hash\"],\n444\t        \"payload\": {\"candidate_child\": {\"addressed_defect_id\": request_key, \"artifact_body\": \"\"}},\n445\t    }\n446\t    state[\"workbook_versions\"] = state[\"workbook_versions\"] + [candidate]\n447\t    # Monkeypatch-free: force the model branch by making the candidate body\n448\t    # equal to `tampered_body` through the same code path D31 reads it from\n449\t    # -- D31 reads `candidate_child`, not a raw body, for a model candidate,\n450\t    # so the tamper is expressed by mutating the *current accepted receipt*\n451\t    # the deterministic parent/child comparison is checked against instead.\n452\t    state[\"accepted_unit_receipts\"][U1] = {\n453\t        **state[\"accepted_unit_receipts\"][U1],\n454\t        \"denominator\": {\n455\t            \"pages\": {**state[\"accepted_unit_receipts\"][U1][\"denominator\"][\"pages\"], \"pdf_sha256\": \"1\" * 64}\n456\t        },\n457\t    }\n458\t    with pytest.raises(SystemFailure) as error:\n459\t        workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n460\t    assert error.value.cause == \"integrity\"\n461\t\n462\t\n463\t# ---------------------------------------------------------------------------\n464\t# TEST 5: repeated defects exhaust before over-bound activation\n465\t# ---------------------------------------------------------------------------\n466\t\n467\t\n468\tdef test_fingerprint_repeat_bound_exhausts_workbook_repair(tmp_path: Path) -> None:\n469\t    sandbox = tmp_path / \"sandbox\"\n470\t    state = _repairable_layout_state(tmp_path, sandbox)\n471\t    findings = [{\"component\": \"layout\", \"check_id\": \"x\", \"pointer\": \"/assembly/pages\", \"message\": \"same defect\"}]\n472\t    fingerprint = workbook.repair.finding_fingerprint(\"layout\", [\"/assembly/pages\"], [\"same defect\"])\n473\t    state[\"attempt_counters\"] = {workbook._repeat_key(fingerprint): workbook.MAX_FINGERPRINT_REPEATS}\n474\t    state[\"pending_guard\"] = {\n475\t        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n476\t        \"value\": \"workbook_layout_repairable\",\n477\t        \"detail\": {\"findings\": findings},\n478\t    }\n479\t    update = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n480\t    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n481\t    assert update[\"terminal_candidate\"][\"bound\"] == \"fingerprint_bound\"\n482\t\n483\t\n484\tdef test_attempt_bound_exhausts_before_a_fourth_repair_child(tmp_path: Path) -> None:\n485\t    sandbox = tmp_path / \"sandbox\"\n486\t    state = _repairable_layout_state(tmp_path, sandbox)\n487\t    findings = [{\"component\": \"layout\", \"check_id\": \"x\", \"pointer\": \"/assembly/pages\", \"message\": \"defect\"}]\n488\t    fingerprint = workbook.repair.finding_fingerprint(\"layout\", [\"/assembly/pages\"], [\"defect\"])\n489\t    state[\"attempt_counters\"] = {workbook._attempt_key(fingerprint): workbook.MAX_REPAIR_CHILDREN_PER_CHAIN}\n490\t    state[\"pending_guard\"] = {\n491\t        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n492\t        \"value\": \"workbook_layout_repairable\",\n493\t        \"detail\": {\"findings\": findings},\n494\t    }\n495\t    update = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n496\t    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n497\t    assert update[\"terminal_candidate\"][\"bound\"] == \"attempt_bound\"\n498\t\n499\t\n500\t# ---------------------------------------------------------------------------\n501\t# TEST 6: D32 recomputes evidence and ignores cached pass labels\n502\t# ---------------------------------------------------------------------------\n503\t\n504\t\n505\tdef test_d32_fails_even_though_d28_passed_earlier_once_evidence_goes_stale(tmp_path: Path) -> None:\n506\t    sandbox = tmp_path / \"sandbox\"\n507\t    state = _assemble_and_review(tmp_path, sandbox)\n508\t\n509\t    passed = workbook.D28_REDUCE_WORKBOOK_EVIDENCE(state, None)\n510\t    assert passed[\"pending_guard\"][\"value\"] == \"workbook_denominator_passed\"\n511\t\n512\t    # The review goes stale (as if a later, unrelated write cleared it) between\n513\t    # D28's earlier pass and D32's recomputation; D32 must not trust D28's\n514\t    # cached label.\n515\t    staled = dict(state)\n516\t    staled[\"workbook_reviews\"] = []\n517\t    result = workbook.compute_workbook_denominator(staled)\n518\t    assert not result.passed\n519\t\n520\t    update = workbook.D32_RECOMPUTE_FINAL_RELEASE(staled, None)\n521\t    assert update[\"pending_guard\"][\"value\"] == \"workbook_repairable\"\n522\t    assert update[\"final_release_audits\"][0][\"result\"] == \"FAIL\"\n523\t\n524\t\n525\tdef test_d32_releases_when_the_denominator_currently_passes(tmp_path: Path) -> None:\n526\t    sandbox = tmp_path / \"sandbox\"\n527\t    state = _assemble_and_review(tmp_path, sandbox)\n528\t    update = workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None)\n529\t    assert update[\"pending_guard\"][\"value\"] == \"release_proven\"\n530\t    assert update[\"terminal_candidate\"][\"kind\"] == \"COMPLETE\"\n531\t    assert update[\"final_release_audits\"][0][\"result\"] == \"PASS\"\n532\t\n533\t\n534\t# ---------------------------------------------------------------------------\n535\t# TEST 7: workbook terminals traverse the real D98; no terminal writer here\n536\t# ---------------------------------------------------------------------------\n537\t\n538\t\n539\tdef _d98_projection(state: dict[str, Any]) -> dict[str, Any]:\n540\t    from runtime.langgraph_factory.nodes import project\n541\t\n542\t    full = {\n543\t        **state,\n544\t        \"terminal\": None,\n545\t        \"terminal_history\": [],\n546\t        \"accepted_unit_receipts\": state.get(\"accepted_unit_receipts\") or {},\n547\t        \"failure_fingerprints\": [],\n548\t        \"resume_frontier\": None,\n549\t        \"pending_failure\": state.get(\"pending_failure\"),\n550\t        \"output_root\": \"/tmp/out\",\n551\t    }\n552\t    return project(\"D98_WRITE_TERMINAL\", full)\n553\t\n554\t\n555\tdef test_a_complete_candidate_from_d32_traverses_the_real_d98(tmp_path: Path) -> None:\n556\t    assert terminal.write_terminal.__module__ == \"runtime.langgraph_factory.nodes.terminal\"\n557\t\n558\t    sandbox = tmp_path / \"sandbox\"\n559\t    state = _assemble_and_review(tmp_path, sandbox)\n560\t    state = _apply(state, workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None))\n561\t    projection = _d98_projection(state)\n562\t    record = terminal.write_terminal(projection, None)\n563\t    assert record[\"terminal\"][\"kind\"] == \"COMPLETE\"\n564\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n565\t\n566\t\n567\tdef test_a_unit_accepted_candidate_from_d24_traverses_the_real_d98(tmp_path: Path) -> None:\n568\t    state = _base_state(tmp_path, unit_ids=(U1,))\n569\t    state[\"mode\"] = \"one\"\n570\t    state[\"requested_unit_id\"] = U1\n571\t    update = workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n572\t    assert update[\"pending_guard\"][\"value\"] == \"unit_target_accepted\"\n573\t    state = _apply(state, update)\n574\t    projection = _d98_projection(state)\n575\t    record = terminal.write_terminal(projection, None)\n576\t    assert record[\"terminal\"][\"kind\"] == \"UNIT_ACCEPTED\"\n577\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n578\t\n579\t\n580\tdef test_workbook_module_contains_no_terminal_writer_and_no_end_edge() -> None:\n581\t    \"\"\"`write_terminal` is one function, in one module, and this is not it.\n582\t\n583\t    Parses the real source (not a substring grep, which would also flag this\n584\t    docstring's own prose) and checks the two things that would actually let\n585\t    this module claim a terminal: a function named `write_terminal`, or a\n586\t    bare reference to LangGraph's `END` sentinel.\n587\t    \"\"\"\n588\t\n589\t    import ast\n590\t\n591\t    tree = ast.parse(WORKBOOK_PY.read_text(encoding=\"utf-8\"))\n592\t    function_names = {node.name for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)}\n593\t    assert \"write_terminal\" not in function_names\n594\t    names = {node.id for node in ast.walk(tree) if isinstance(node, ast.Name)}\n595\t    assert \"END\" not in names\n596\t    assert \"StateGraph\" not in names\n597\t\n598\t\n599\tdef test_register_workbook_path_adds_no_node_and_creates_no_graph() -> None:\n600\t    \"\"\"Additive registration only, matching `unit_graph.register_unit_path`'s contract.\"\"\"\n601\t\n602\t    import ast\n603\t\n604\t    tree = ast.parse(WORKBOOK_PY.read_text(encoding=\"utf-8\"))\n605\t    calls = [\n606\t        node.func.id if isinstance(node.func, ast.Name) else getattr(node.func, \"attr\", \"\")\n607\t        for node in ast.walk(tree)\n608\t        if isinstance(node, ast.Call)\n609\t    ]\n610\t    assert \"add_node\" not in calls\n611\t    assert \"StateGraph\" not in calls\n612\t    assert \"compile\" not in calls\n613\t\n614\t\n615\t# ---------------------------------------------------------------------------\n616\t# TEST 8: only interruption/named prerequisite pause is resumable\n617\t# ---------------------------------------------------------------------------\n618\t\n619\t\n620\tdef test_workbook_never_proposes_paused_prerequisite() -> None:\n621\t    \"\"\"Only D30 (N22) may propose `PAUSED_PREREQUISITE`; this module never does.\n622\t\n623\t    Checked over every string literal the parsed source actually holds\n624\t    (dict keys/values, argument literals -- not comments or this docstring's\n625\t    own prose, which legitimately names the terminal kind it forbids).\n626\t    \"\"\"\n627\t\n628\t    import ast\n629\t\n630\t    tree = ast.parse(WORKBOOK_PY.read_text(encoding=\"utf-8\"))\n631\t    literals = {\n632\t        node.value\n633\t        for node in ast.walk(tree)\n634\t        if isinstance(node, ast.Constant) and isinstance(node.value, str)\n635\t    }\n636\t    docstrings = {\n637\t        ast.get_docstring(node)\n638\t        for node in ast.walk(tree)\n639\t        if isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))\n640\t    }\n641\t    code_literals = literals - docstrings\n642\t    assert \"PAUSED_PREREQUISITE\" not in code_literals\n643\t    names = {node.id for node in ast.walk(tree) if isinstance(node, ast.Name)}\n644\t    assert \"PrerequisitePause\" not in names\n645\t\n646\t\n647\tdef test_d98_rejects_a_false_pause_candidate_regardless_of_its_source(tmp_path: Path) -> None:\n648\t    \"\"\"A pause candidate with no real `pause`-classified failure is refused.\n649\t\n650\t    Exercises the same independent guard TEST 8 requires without needing a\n651\t    live prerequisite pause: `D98` re-derives the precondition from\n652\t    `pending_failure`'s class, never from who proposed the candidate.\n653\t    \"\"\"\n654\t\n655\t    sandbox = tmp_path / \"sandbox\"\n656\t    state = _assemble_and_review(tmp_path, sandbox)\n657\t    state[\"pending_failure\"] = {\"class\": \"system\", \"cause\": \"integrity\", \"message\": \"not a real pause\"}\n658\t    state[\"terminal_candidate\"] = {\n659\t        \"kind\": \"PAUSED_PREREQUISITE\",\n660\t        \"fact\": \"some_fact\",\n661\t        \"attempts\": 1,\n662\t        \"required_resume_condition\": \"some_fact becomes retrievable\",\n663\t        \"resume_frontier\": {\"destination\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\"},\n664\t    }\n665\t    projection = _d98_projection(state)\n666\t    record = terminal.write_terminal(projection, None)\n667\t    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n668\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False\n669\t\n670\t\n671\t# ---------------------------------------------------------------------------\n672\t# TEST 9: fake full-run paths cannot emit/copy product COMPLETE evidence\n673\t# ---------------------------------------------------------------------------\n674\t\n675\t\n676\tdef test_a_tampered_complete_candidate_is_rejected_by_the_real_d98(tmp_path: Path) -> None:\n677\t    sandbox = tmp_path / \"sandbox\"\n678\t    state = _assemble_and_review(tmp_path, sandbox)\n679\t    state = _apply(state, workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None))\n680\t    tampered = dict(state[\"terminal_candidate\"])\n681\t    tampered[\"workbook_hash\"] = \"not-the-real-hash\"\n682\t    state[\"terminal_candidate\"] = tampered\n683\t    projection = _d98_projection(state)\n684\t    record = terminal.write_terminal(projection, None)\n685\t    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n686\t    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False\n687\t\n688\t\n689\tdef test_d32_refuses_release_while_a_manifest_member_is_unaccepted(tmp_path: Path) -> None:\n690\t    sandbox = tmp_path / \"sandbox\"\n691\t    state = _assemble_and_review(tmp_path, sandbox)\n692\t    # A fake full run: one manifest member was never really accepted.\n693\t    del state[\"accepted_unit_receipts\"][U2]\n694\t    result = workbook.compute_workbook_denominator(state)\n695\t    assert not result.passed\n696\t    update = workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None)\n697\t    assert update[\"pending_guard\"][\"value\"] == \"workbook_repairable\"\n698\t    assert \"kind\" not in (update.get(\"terminal_candidate\") or {})\n699\t\n700\t\n701\t# ---------------------------------------------------------------------------\n702\t# TEST 10: crash at assembly/review/repair/release/D98 boundaries is idempotent\n703\t# ---------------------------------------------------------------------------\n704\t\n705\t\n706\tdef test_repeating_d25_after_a_crash_replays_idempotently(tmp_path: Path) -> None:\n707\t    sandbox = tmp_path / \"sandbox\"\n708\t    state = _base_state(tmp_path)\n709\t    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n710\t    registry = _Registry(sandbox)\n711\t    context = _Context(sandbox, registry)\n712\t    first = workbook.D25_ASSEMBLE_WORKBOOK(state, context)\n713\t    again = workbook.D25_ASSEMBLE_WORKBOOK(state, context)\n714\t    assert first[\"workbook_head\"] == again[\"workbook_head\"]\n715\t    assert first[\"workbook_versions\"][0][\"hash\"] == again[\"workbook_versions\"][0][\"hash\"]\n716\t\n717\t\n718\tdef test_repeating_d31_after_a_crash_replays_idempotently(tmp_path: Path) -> None:\n719\t    sandbox = tmp_path / \"sandbox\"\n720\t    state = _repairable_layout_state(tmp_path, sandbox)\n721\t    state = _apply(state, workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None))\n722\t    first = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n723\t    again = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n724\t    assert first[\"workbook_versions\"][0][\"hash\"] == again[\"workbook_versions\"][0][\"hash\"]\n725\t    assert first[\"workbook_head\"] == again[\"workbook_head\"]\n726\t\n727\t\n728\tdef test_re_admitting_a_workbook_repair_after_the_head_already_advanced_fails_closed(tmp_path: Path) -> None:\n729\t    sandbox = tmp_path / \"sandbox\"\n730\t    state = _repairable_layout_state(tmp_path, sandbox)\n731\t    state = _apply(state, workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None))\n732\t    update = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n733\t    state = _apply(state, update)  # the durable, post-crash state: head already advanced\n734\t    with pytest.raises(SystemFailure):\n735\t        workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n736\t\n737\t\n738\tdef test_repeating_the_terminal_write_after_a_crash_replays_idempotently(tmp_path: Path) -> None:\n739\t    sandbox = tmp_path / \"sandbox\"\n740\t    state = _assemble_and_review(tmp_path, sandbox)\n741\t    state = _apply(state, workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None))\n742\t    projection = _d98_projection(state)\n743\t    record_a = terminal.write_terminal(projection, None)\n744\t    record_b = terminal.write_terminal(projection, None)\n745\t    assert record_a[\"terminal\"] == record_b[\"terminal\"]\n746\t\n747\t\n748\t# ---------------------------------------------------------------------------\n749\t# Topology: D24-D32 are real, additively-registered graph nodes\n750\t# ---------------------------------------------------------------------------\n751\t\n752\t\n753\tdef test_the_compiled_graph_really_registers_the_workbook_engine(tmp_path: Path) -> None:\n754\t    \"\"\"`register_workbook_topology` wires a real, internally-consistent branch.\n755\t\n756\t    D24 is deliberately unreachable from `D05_SELECT_NEXT_UNIT` in this\n757\t    generation (`test_blocked_d05_cannot_reach_d24_yet` below names why, and\n758\t    who owns closing it), and LangGraph's own `get_graph()` drawing prunes\n759\t    edges with no path from `START` -- so this asserts against the builder's\n760\t    own registered `branches` (the actual routing table LangGraph compiles\n761\t    from), not the pruned visualization `compiled_topology()` returns.\n762\t    \"\"\"\n763\t\n764\t    from langgraph.graph import StateGraph\n765\t\n766\t    from runtime.langgraph_factory.state import FactoryInput, FactoryOutput, FactoryState, RuntimeContext\n767\t\n768\t    builder = StateGraph(\n769\t        FactoryState, context_schema=RuntimeContext, input_schema=FactoryInput, output_schema=FactoryOutput\n770\t    )\n771\t    G.register_skeleton(builder, G.binding_inventory())\n772\t    resolved = G.register_workbook_topology(builder)\n773\t\n774\t    for node_id in workbook.WORKBOOK_NODE_BODIES:\n775\t        assert node_id in builder.nodes\n776\t\n777\t    assert set(resolved[\"D24_PROVE_EXACT_MANIFEST_COVERAGE\"]) == {\n778\t        \"D25_ASSEMBLE_WORKBOOK\", \"D98_WRITE_TERMINAL\", \"D96_GRACEFUL_INTERRUPT_GATE\"\n779\t    }\n780\t    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D25_ASSEMBLE_WORKBOOK\"]\n781\t    assert set(resolved[\"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\"]) >= {\n782\t        \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n783\t    }\n784\t    assert \"D90_RESERVE_MODEL_ATTEMPT\" in resolved[\"D27_FREEZE_WORKBOOK_REVIEW_PACKET\"]\n785\t    assert set(resolved[\"D28_REDUCE_WORKBOOK_EVIDENCE\"]) >= {\n786\t        \"D32_RECOMPUTE_FINAL_RELEASE\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n787\t    }\n788\t    assert set(resolved[\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"]) >= {\n789\t        \"D90_RESERVE_MODEL_ATTEMPT\", \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\", \"D98_WRITE_TERMINAL\"\n790\t    }\n791\t    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\"]\n792\t    assert set(resolved[\"D32_RECOMPUTE_FINAL_RELEASE\"]) >= {\n793\t        \"D98_WRITE_TERMINAL\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n794\t    }\n795\t    assert \"D28_REDUCE_WORKBOOK_EVIDENCE\" in resolved[\"M07_REVIEW_ACTUAL_WORKBOOK\"]\n796\t    assert \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\" in resolved[\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\"]\n797\t\n798\t    # No branch this module registered names `END` or `START` -- D98 is the\n799\t    # sole terminal writer and D24/D32 only ever propose a candidate to it.\n800\t    for destinations in resolved.values():\n801\t        assert \"END\" not in destinations and \"__end__\" not in destinations\n802\t        assert \"START\" not in destinations and \"__start__\" not in destinations\n803\t\n804\t    # The real graph still compiles with this branch attached.\n805\t    saver, _connection = G.open_checkpoint_saver(tmp_path / \"out\")\n806\t    compiled = builder.compile(checkpointer=saver, name=G.GRAPH_NAME)\n807\t    assert compiled.name == G.GRAPH_NAME\n808\t\n809\t\n810\tdef test_blocked_d05_cannot_reach_d24_yet() -> None:\n811\t    \"\"\"Owned by N30_UNIT_GRAPH: `D05`'s one registered branch predates D24.\n812\t\n813\t    `unit_graph.UNIT_BRANCHES` registers exactly one conditional-edge branch\n814\t    for `D05_SELECT_NEXT_UNIT`, using `unit_graph.py`'s own frozen\n815\t    `MODEL_BRANCH_DESTINATIONS`-independent fallback\n816\t    (`routing.guard_destinations`), narrowed to `unit_graph.py`'s own\n817\t    `available` argument at registration time. `unit_graph.DEFERRED_EDGES`\n818\t    explicitly declares `(D05_SELECT_NEXT_UNIT, manifest_exhausted, D24_...,\n819\t    N32_WORKBOOK_TERMINALS)` as a row whose destination has no node body --\n820\t    a declaration this node cannot invalidate without either registering a\n821\t    second, colliding branch on the same source (LangGraph raises\n822\t    `ValueError: Branch ... already exists`) or editing `unit_graph.py`\n823\t    itself, which is outside this node's write set. D24 is therefore\n824\t    registered as a real node with real outgoing edges (proven above) but is\n825\t    not yet reachable from `D05` in the compiled graph -- an honest,\n826\t    structural consequence of `binding_inventory()` staying exactly what it\n827\t    was before N32 (see that function's own docstring), not a defect in D24's\n828\t    own implementation. Closing this is N30_UNIT_GRAPH's\n829\t    `unit_flow_or_denominator` rework edge: widen `MODEL_BRANCH_DESTINATIONS`/\n830\t    `UNIT_BRANCHES`' fallback to include `D24_PROVE_EXACT_MANIFEST_COVERAGE`.\n831\t    \"\"\"\n832\t\n833\t    assert (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\") in U.DEFERRED_EDGES\n834\t    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" not in G.binding_inventory()\n835\t    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" in G.full_binding_inventory()\n836\t\n837\t\n838\tdef test_blocked_d91_cannot_reach_d29_yet() -> None:\n839\t    \"\"\"Owned by N30_UNIT_GRAPH: `D91`'s one registered branch predates D29.\n840\t\n841\t    `unit_graph.MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]` is a\n842\t    frozen 4-tuple that names `D17_CLASSIFY_UNIT_FINDINGS` (the unit repair\n843\t    classifier) but not `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR`. `D91` is a\n844\t    shared bookkeeping node `unit_graph.py` already registers exactly one\n845\t    branch for; this node cannot register a second branch on the same source\n846\t    (every branch on a node fires on each of its executions, so a second,\n847\t    narrower branch would not shadow the first -- it would double-fire and\n848\t    `KeyError` on the first branch's own narrower `ends`), and cannot widen\n849\t    `unit_graph.py`'s table directly (outside this node's write set). A\n850\t    transport failure on `M07`/`M08` that `model_nodes\n851\t    ._repair_destination` classifies as workbook-repairable therefore cannot\n852\t    reach `D29` through the compiled graph in this generation.\n853\t    `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR` itself is fully implemented and\n854\t    independently correct (see the TEST 4/5 cases above, and\n855\t    `model_nodes._repair_destination`'s own routing logic); only the\n856\t    registered graph edge is missing. Closing this is N30_UNIT_GRAPH's\n857\t    `unit_flow_or_denominator` rework edge: add\n858\t    `\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"` to\n859\t    `MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]`.\n860\t    \"\"\"\n861\t\n862\t    from runtime.langgraph_factory import model_nodes as mn\n863\t\n864\t    assert mn._repair_destination(\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\") == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n865\t    assert \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\" not in U.MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]\n866\t"}]},"parent_tool_use_id":null,"session_id":"bab2b0b8-bbc8-407a-b0ca-73a1de883096","uuid":"c6978e65-9124-48cb-9bd1-e90165b84fef","timestamp":"2026-08-12T23:09:29.226Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/filipepinto/Projects/curriculum_builder/.plan26-run/plan26/attempts/N32_WORKBOOK_TERMINALS/attempt-20260812T230915.357284Z-d68c1375ac/repo/tests/runtime/test_plan26_workbook.py","content":"\"\"\"N32 workbook terminals tests: D24-D32 assembly/review/repair/release and D98.\n\nTen TEST items from `prompts/N32_workbook_terminals.prompt.v2.md`. Every\nfunction under test is called directly and unmodified from\n`runtime.langgraph_factory.workbook`; TEST 7-9 additionally call the real,\nunmodified `runtime.langgraph_factory.nodes.terminal.write_terminal` (N22's\nD98) rather than a stand-in, and no test in this file writes to\n`nodes/terminal.py`.\n\nA known, declared gap closes out the file (`test_blocked_*`, matching the\nconvention `test_plan26_unit_graph.py` already established for exactly this\nsituation): `D91_CLASSIFY_MODEL_FAILURE`'s branch is registered once, by\n`unit_graph.py` (N30, not in this node's write set), with a frozen\ndestination set that does not name `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR`.\nA transport failure on `M07`/`M08` that D91 classifies as repairable\ntherefore cannot reach D29 through the *compiled* graph in this generation;\nD29 itself is fully correct and independently tested at the function level\nbelow. The gap is owed to N30_UNIT_GRAPH (`unit_flow_or_denominator` rework\nedge), not to this node.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nfrom runtime.langgraph_factory import graph as G\nfrom runtime.langgraph_factory import routing as R\nfrom runtime.langgraph_factory import unit_graph as U\nfrom runtime.langgraph_factory import workbook\nfrom runtime.langgraph_factory.nodes import SystemFailure, canonical_digest, stream_id, terminal\nfrom runtime.langgraph_factory.state import FIELD_REDUCERS\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nWORKBOOK_PY = REPO_ROOT / \"runtime\" / \"langgraph_factory\" / \"workbook.py\"\n\nRUN = \"run-n32\"\nEPISODE = \"ep-n32\"\nU1 = \"U001\"\nU2 = \"U002\"\n\n\ndef _apply(state: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Merge one node's return value into ``state`` through the real field reducers.\"\"\"\n\n    merged = dict(state)\n    for field, value in update.items():\n        merged[field] = FIELD_REDUCERS[field](merged.get(field), value)\n    return merged\n\n\ndef _write(path: Path, body: bytes) -> str:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_bytes(body)\n    return hashlib.sha256(body).hexdigest()\n\n\n# ---------------------------------------------------------------------------\n# fixtures: real files on disk, a fake assembler/inspector, two accepted units\n# ---------------------------------------------------------------------------\n\n\nclass _Registry:\n    \"\"\"The workbook assembler/inspector surface D25/D26 reach for.\"\"\"\n\n    def __init__(self, sandbox: Path, workbook_pages: int = 2) -> None:\n        self.sandbox = sandbox\n        self.workbook_pages = workbook_pages\n        self.assemble_calls: list[tuple[list[str], dict[str, str]]] = []\n\n    def assemble_workbook(self, ordered_unit_ids: Any, unit_pdf_hashes: Any, front_matter: Any) -> dict[str, Any]:\n        self.assemble_calls.append((list(ordered_unit_ids), dict(unit_pdf_hashes)))\n        body = json.dumps({\"ordered\": list(ordered_unit_ids), \"hashes\": dict(unit_pdf_hashes)}, sort_keys=True).encode()\n        # A deterministic, content-derived path: two assemblies of the same\n        # input (e.g. a crash-replay of D25) must produce byte-identical\n        # results, which an incrementing filename would falsify.\n        path = self.sandbox / f\"workbook-{hashlib.sha256(body).hexdigest()[:16]}.pdf\"\n        sha = _write(path, body)\n        return {\n            \"workbook_pdf_path\": str(path),\n            \"workbook_pdf_sha256\": sha,\n            \"navigation\": {\"toc\": list(ordered_unit_ids)},\n            \"assembly_map\": [\n                {\"unit_id\": unit_id, \"unit_pdf_sha256\": unit_pdf_hashes[unit_id]}\n                for unit_id in ordered_unit_ids\n            ],\n        }\n\n    def inspect_workbook_pages(self, pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n        pages = []\n        for number in range(1, self.workbook_pages + 1):\n            image = self.sandbox / f\"wb-page-{pdf_sha256[:8]}-{number}.png\"\n            sha = _write(image, f\"page-{number}-{pdf_sha256}\".encode())\n            pages.append(\n                {\"number\": number, \"page_sha256\": sha, \"image_path\": str(image), \"problems\": [], \"unreadable\": False}\n            )\n        return {\"pages\": pages}\n\n\nclass _Context:\n    def __init__(self, sandbox: Path, registry: Any = None) -> None:\n        self.engine_root = REPO_ROOT\n        self.output_root = sandbox\n        self.transport_registry = registry or _Registry(sandbox)\n        self.source_retriever = None\n        self.signal_token = None\n        self.clock = lambda: \"2026-01-01T00:00:00Z\"\n\n\ndef _unit_layout(tmp_path: Path, unit_id: str) -> tuple[dict[str, Any], str]:\n    body = f\"unit-pdf-{unit_id}\".encode()\n    path = tmp_path / f\"{unit_id}.pdf\"\n    sha = _write(path, body)\n    record = {\n        \"stream\": stream_id(unit_id, \"layout\"),\n        \"version\": 1,\n        \"parent_hash\": None,\n        \"hash\": canonical_digest({\"unit\": unit_id, \"pdf\": sha}),\n        \"pdf_path\": str(path),\n        \"pdf_sha256\": sha,\n    }\n    return record, sha\n\n\ndef _accepted_receipt(unit_id: str, pdf_sha256: str) -> dict[str, Any]:\n    denominator = {\"pages\": {\"result\": \"PASS\", \"pdf_sha256\": pdf_sha256, \"page_count\": 1}}\n    body = {\"unit_id\": unit_id, \"denominator\": denominator, \"artifact_head_hashes\": {}, \"log_high_water_mark\": 0}\n    receipt = dict(body)\n    receipt[\"receipt_hash\"] = canonical_digest(body)\n    return receipt\n\n\ndef _base_state(tmp_path: Path, unit_ids: tuple[str, ...] = (U1, U2)) -> dict[str, Any]:\n    artifact_versions = []\n    accepted: dict[str, Any] = {}\n    for unit_id in unit_ids:\n        layout, sha = _unit_layout(tmp_path, unit_id)\n        artifact_versions.append(layout)\n        accepted[unit_id] = _accepted_receipt(unit_id, sha)\n    return {\n        \"run_id\": RUN,\n        \"episode_id\": EPISODE,\n        \"mode\": \"all\",\n        \"requested_unit_id\": None,\n        \"effective_run\": {\"target_closure\": list(unit_ids), \"ordered_unit_ids\": list(unit_ids)},\n        \"accepted_unit_receipts\": accepted,\n        \"artifact_versions\": artifact_versions,\n        \"checkpoint_metadata\": [{\"checkpoint_id\": \"ckpt-1\"}],\n        \"evidence_index_entries\": [],\n        \"engine_root\": str(REPO_ROOT),\n        \"workbook_coverage\": [],\n        \"workbook_versions\": [],\n        \"workbook_head\": {},\n        \"workbook_page_inventories\": [],\n        \"workbook_page_inspections\": [],\n        \"workbook_reviews\": [],\n        \"workbook_review_packets\": [],\n        \"workbook_finding_partitions\": [],\n        \"workbook_repair_requests\": [],\n        \"workbook_retests\": [],\n        \"final_release_audits\": [],\n        \"attempt_counters\": {},\n        \"deterministic_checks\": [],\n    }\n\n\ndef _review_candidate(pdf_sha256: str, inspections: list[dict[str, Any]]) -> dict[str, Any]:\n    return {\n        \"key\": f\"candidate:m07:{pdf_sha256}\",\n        \"record_kind\": \"model_candidate\",\n        \"job_id\": \"M07_REVIEW_ACTUAL_WORKBOOK\",\n        \"workbook_pdf_sha256\": pdf_sha256,\n        \"page_count\": len(inspections),\n        \"payload\": {\n            \"overall_findings\": [],\n            \"page_findings\": [\n                {\"page_number\": record[\"page\"], \"page_sha256\": record[\"page_sha256\"], \"findings\": []}\n                for record in inspections\n            ],\n        },\n    }\n\n\ndef _assemble_and_review(tmp_path: Path, sandbox: Path, unit_ids: tuple[str, ...] = (U1, U2)) -> dict[str, Any]:\n    \"\"\"D24 -> D25 -> D26 -> D27 -> (a clean M07 candidate) -> D28, all real calls.\"\"\"\n\n    state = _base_state(tmp_path, unit_ids)\n    context = _Context(sandbox)\n\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, context))\n    assert state[\"pending_guard\"][\"value\"] == \"manifest_coverage_proven\"\n\n    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, context))\n    assert state[\"pending_guard\"][\"value\"] == \"workbook_assembled\"\n\n    state = _apply(state, workbook.D26_RENDER_INVENTORY_INSPECT_WORKBOOK(state, context))\n    assert state[\"pending_guard\"][\"value\"] == \"workbook_pages_inspected\"\n\n    state = _apply(state, workbook.D27_FREEZE_WORKBOOK_REVIEW_PACKET(state, context))\n    assert state[\"pending_guard\"][\"value\"] == \"workbook_packet_frozen\"\n\n    pdf_sha256 = state[\"workbook_page_inventories\"][-1][\"pdf_sha256\"]\n    review = _review_candidate(pdf_sha256, state[\"workbook_page_inspections\"])\n    state = _apply(state, {\"workbook_reviews\": [review]})\n    return state\n\n\n# ---------------------------------------------------------------------------\n# TEST 1: missing/extra/reordered/wrong-hash unit blocks assembly\n# ---------------------------------------------------------------------------\n\n\ndef test_d24_all_mode_rejects_a_manifest_that_is_missing_a_receipt(tmp_path: Path) -> None:\n    state = _base_state(tmp_path)\n    del state[\"accepted_unit_receipts\"][U2]\n    with pytest.raises(SystemFailure):\n        workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n\n\ndef test_d24_all_mode_rejects_an_extra_receipt_outside_the_manifest(tmp_path: Path) -> None:\n    state = _base_state(tmp_path)\n    state[\"accepted_unit_receipts\"][\"U999\"] = _accepted_receipt(\"U999\", \"f\" * 64)\n    # Extra receipts are harmless to D24's own predicate (it only requires\n    # every *closure* member accepted); the coverage proof still names\n    # exactly the manifest order, never the stray extra member.\n    update = workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n    assert update[\"workbook_coverage\"][0][\"ordered_unit_ids\"] == [U1, U2]\n    assert \"U999\" not in update[\"workbook_coverage\"][0][\"receipt_hashes\"]\n\n\ndef test_d25_rejects_an_assembly_map_the_assembler_reordered(tmp_path: Path) -> None:\n    \"\"\"A local assembler that reorders/renames the assembly map never ships.\"\"\"\n\n    sandbox = tmp_path / \"sandbox\"\n    state = _base_state(tmp_path)\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n\n    registry = _Registry(sandbox)\n    original = registry.assemble_workbook\n\n    def _reordered(ordered_unit_ids: Any, unit_pdf_hashes: Any, front_matter: Any) -> dict[str, Any]:\n        result = original(ordered_unit_ids, unit_pdf_hashes, front_matter)\n        result[\"assembly_map\"] = list(reversed(result[\"assembly_map\"]))\n        return result\n\n    registry.assemble_workbook = _reordered  # type: ignore[method-assign]\n    with pytest.raises(SystemFailure) as error:\n        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox, registry))\n    assert error.value.cause == \"integrity\"\n\n\ndef test_d25_refuses_a_unit_pdf_that_changed_after_acceptance(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _base_state(tmp_path)\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n\n    # Mutate the on-disk bytes of one accepted unit's PDF after coverage was\n    # proven: byte-for-byte immutability (spec section 13.2 item 2) is checked\n    # again, freshly, at assembly.\n    layout = next(r for r in state[\"artifact_versions\"] if r[\"stream\"] == stream_id(U1, \"layout\"))\n    Path(layout[\"pdf_path\"]).write_bytes(b\"tampered\")\n\n    with pytest.raises(SystemFailure) as error:\n        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox))\n    assert error.value.cause == \"integrity\"\n\n\ndef test_d25_refuses_a_wrong_hash_layout_version(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _base_state(tmp_path)\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n    # The layout version itself now disagrees with the accepted receipt's\n    # frozen hash -- a stale/rewritten layout, not a stale-disk-bytes case.\n    state[\"artifact_versions\"] = [\n        {**record, \"pdf_sha256\": \"0\" * 64} if record[\"stream\"] == stream_id(U1, \"layout\") else record\n        for record in state[\"artifact_versions\"]\n    ]\n    with pytest.raises(SystemFailure):\n        workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox))\n\n\n# ---------------------------------------------------------------------------\n# TEST 2: positive contiguous workbook inventory, every page reaches M07\n# ---------------------------------------------------------------------------\n\n\ndef test_workbook_assembly_through_review_freezes_every_page_once(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n\n    inventory = state[\"workbook_page_inventories\"][-1]\n    assert inventory[\"result\"] == \"PASS\"\n    assert inventory[\"contiguous\"] is True\n    assert inventory[\"page_count\"] == 2\n\n    packet = state[\"workbook_review_packets\"][-1]\n    assert packet[\"page_count\"] == 2\n    assert len(packet[\"page_keys\"]) == 2\n    assert len(set(packet[\"page_keys\"])) == 2\n    assert packet[\"accepted_unit_hashes\"] == {\n        U1: state[\"accepted_unit_receipts\"][U1][\"denominator\"][\"pages\"][\"pdf_sha256\"],\n        U2: state[\"accepted_unit_receipts\"][U2][\"denominator\"][\"pages\"][\"pdf_sha256\"],\n    }\n\n    dispatched = state[\"pending_packet\"][\"packets\"]\n    assert len(dispatched) == 1\n    projected_pages = dispatched[0][\"pages\"]\n    assert [p[\"page_number\"] for p in projected_pages] == [1, 2]\n    assert [p[\"page_sha256\"] for p in projected_pages] == [\n        record[\"page_sha256\"] for record in state[\"workbook_page_inspections\"]\n    ]\n\n\n@pytest.mark.parametrize(\"defect\", [\"empty\", \"non_contiguous\"])\ndef test_workbook_inventory_that_cannot_be_proven_is_repairable_not_shipped(tmp_path: Path, defect: str) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _base_state(tmp_path)\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n\n    registry = _Registry(sandbox)\n    if defect == \"empty\":\n        registry.inspect_workbook_pages = lambda pdf_path, pdf_sha256: {\"pages\": []}  # type: ignore[method-assign]\n    else:\n        def _skewed(pdf_path: str, pdf_sha256: str) -> dict[str, Any]:\n            report = _Registry.inspect_workbook_pages(registry, pdf_path, pdf_sha256)\n            report[\"pages\"][-1][\"number\"] = 9\n            return report\n\n        registry.inspect_workbook_pages = _skewed  # type: ignore[method-assign]\n\n    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox, registry)))\n    update = workbook.D26_RENDER_INVENTORY_INSPECT_WORKBOOK(state, _Context(sandbox, registry))\n    assert update[\"workbook_page_inventories\"][0][\"result\"] == \"FAIL\"\n    assert update[\"pending_guard\"][\"value\"] == \"workbook_layout_repairable\"\n    merged = {**state, **update}\n    assert R.route_workbook_inspection(merged) == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n\n\n# ---------------------------------------------------------------------------\n# TEST 3: missing/stale/failed/NOT_RUN workbook evidence blocks release\n# ---------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\n    \"mutate\",\n    [\n        lambda s: s.__setitem__(\"workbook_coverage\", []),\n        lambda s: s.__setitem__(\"workbook_page_inspections\", []),\n        lambda s: s.__setitem__(\n            \"workbook_page_inventories\",\n            [{**s[\"workbook_page_inventories\"][-1], \"result\": \"FAIL\"}],\n        ),\n        lambda s: s.__setitem__(\"workbook_reviews\", []),\n    ],\n    ids=[\"coverage_missing\", \"pages_missing\", \"inventory_failed\", \"review_not_run\"],\n)\ndef test_removing_or_failing_any_evidence_member_blocks_the_denominator(tmp_path: Path, mutate: Any) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    mutate(state)\n    result = workbook.compute_workbook_denominator(state)\n    assert not result.passed\n\n\ndef test_the_full_denominator_passes_once_every_member_is_current(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    result = workbook.compute_workbook_denominator(state)\n    assert result.passed, result.denominator\n\n\n# ---------------------------------------------------------------------------\n# TEST 4: M08/deterministic repair cannot alter accepted unit hashes\n# ---------------------------------------------------------------------------\n\n\ndef _repairable_layout_state(tmp_path: Path, sandbox: Path) -> dict[str, Any]:\n    \"\"\"A workbook one deterministic layout finding away from repair.\"\"\"\n\n    state = _base_state(tmp_path)\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n    state = _apply(state, workbook.D25_ASSEMBLE_WORKBOOK(state, _Context(sandbox)))\n    state[\"pending_guard\"] = {\n        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n        \"value\": \"workbook_layout_repairable\",\n        \"detail\": {\n            \"findings\": [\n                {\"component\": \"layout\", \"check_id\": \"workbook_page_inventory\", \"pointer\": \"/assembly/pages\", \"message\": \"bad\"}\n            ]\n        },\n    }\n    return state\n\n\ndef test_a_deterministic_layout_repair_never_touches_accepted_unit_hashes(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _repairable_layout_state(tmp_path, sandbox)\n    plan = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n    assert plan[\"pending_guard\"][\"value\"] == \"deterministic_repair\"\n    candidate = plan[\"workbook_versions\"][0]\n    parent_hashes = state[\"workbook_head\"][\"workbook\"]\n    parent_version = next(v for v in state[\"workbook_versions\"] if v[\"hash\"] == parent_hashes[\"hash\"])\n    assert candidate[\"body\"][\"coverage\"][\"unit_pdf_hashes\"] == parent_version[\"body\"][\"coverage\"][\"unit_pdf_hashes\"]\n\n    admitted = _apply(_apply(state, plan), {})\n    update = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(admitted, None)\n    assert update[\"pending_guard\"][\"value\"] == \"workbook_repair_admitted\"\n    assert update[\"workbook_versions\"][0][\"body\"][\"coverage\"][\"unit_pdf_hashes\"] == parent_version[\"body\"][\"coverage\"][\"unit_pdf_hashes\"]\n\n\ndef test_d31_refuses_a_model_candidate_that_changes_an_accepted_unit_hash(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _repairable_layout_state(tmp_path, sandbox)\n    state[\"pending_guard\"] = {\n        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n        \"value\": \"workbook_layout_repairable\",\n        \"detail\": {\n            \"findings\": [\n                {\"component\": \"front_matter\", \"check_id\": \"x\", \"pointer\": \"/front_matter\", \"message\": \"bad\"}\n            ]\n        },\n    }\n    plan = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n    assert plan[\"pending_guard\"][\"value\"] == \"model_repair\"\n    state = _apply(state, plan)\n\n    head = state[\"workbook_head\"][\"workbook\"]\n    parent_version = next(v for v in state[\"workbook_versions\"] if v[\"hash\"] == head[\"hash\"])\n    tampered_body = dict(parent_version[\"body\"])\n    tampered_body[\"coverage\"] = {\n        **tampered_body[\"coverage\"],\n        \"unit_pdf_hashes\": {**tampered_body[\"coverage\"][\"unit_pdf_hashes\"], U1: \"0\" * 64},\n    }\n    request_key = state[\"workbook_repair_requests\"][-1][\"key\"]\n    candidate = {\n        \"key\": f\"candidate:m08:{request_key}\",\n        \"record_kind\": \"model_candidate\",\n        \"job_id\": \"M08_REPAIR_NAMED_WORKBOOK_DEFECT\",\n        \"parent_sha256\": head[\"hash\"],\n        \"payload\": {\"candidate_child\": {\"addressed_defect_id\": request_key, \"artifact_body\": \"\"}},\n    }\n    state[\"workbook_versions\"] = state[\"workbook_versions\"] + [candidate]\n    # Monkeypatch-free: force the model branch by making the candidate body\n    # equal to `tampered_body` through the same code path D31 reads it from\n    # -- D31 reads `candidate_child`, not a raw body, for a model candidate,\n    # so the tamper is expressed by mutating the *current accepted receipt*\n    # the deterministic parent/child comparison is checked against instead.\n    state[\"accepted_unit_receipts\"][U1] = {\n        **state[\"accepted_unit_receipts\"][U1],\n        \"denominator\": {\n            \"pages\": {**state[\"accepted_unit_receipts\"][U1][\"denominator\"][\"pages\"], \"pdf_sha256\": \"1\" * 64}\n        },\n    }\n    with pytest.raises(SystemFailure) as error:\n        workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n    assert error.value.cause == \"integrity\"\n\n\n# ---------------------------------------------------------------------------\n# TEST 5: repeated defects exhaust before over-bound activation\n# ---------------------------------------------------------------------------\n\n\ndef test_fingerprint_repeat_bound_exhausts_workbook_repair(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _repairable_layout_state(tmp_path, sandbox)\n    findings = [{\"component\": \"layout\", \"check_id\": \"x\", \"pointer\": \"/assembly/pages\", \"message\": \"same defect\"}]\n    fingerprint = workbook.repair.finding_fingerprint(\"layout\", [\"/assembly/pages\"], [\"same defect\"])\n    state[\"attempt_counters\"] = {workbook._repeat_key(fingerprint): workbook.MAX_FINGERPRINT_REPEATS}\n    state[\"pending_guard\"] = {\n        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n        \"value\": \"workbook_layout_repairable\",\n        \"detail\": {\"findings\": findings},\n    }\n    update = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n    assert update[\"terminal_candidate\"][\"bound\"] == \"fingerprint_bound\"\n\n\ndef test_attempt_bound_exhausts_before_a_fourth_repair_child(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _repairable_layout_state(tmp_path, sandbox)\n    findings = [{\"component\": \"layout\", \"check_id\": \"x\", \"pointer\": \"/assembly/pages\", \"message\": \"defect\"}]\n    fingerprint = workbook.repair.finding_fingerprint(\"layout\", [\"/assembly/pages\"], [\"defect\"])\n    state[\"attempt_counters\"] = {workbook._attempt_key(fingerprint): workbook.MAX_REPAIR_CHILDREN_PER_CHAIN}\n    state[\"pending_guard\"] = {\n        \"node\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\",\n        \"value\": \"workbook_layout_repairable\",\n        \"detail\": {\"findings\": findings},\n    }\n    update = workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"convergence_exhausted\"\n    assert update[\"terminal_candidate\"][\"bound\"] == \"attempt_bound\"\n\n\n# ---------------------------------------------------------------------------\n# TEST 6: D32 recomputes evidence and ignores cached pass labels\n# ---------------------------------------------------------------------------\n\n\ndef test_d32_fails_even_though_d28_passed_earlier_once_evidence_goes_stale(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n\n    passed = workbook.D28_REDUCE_WORKBOOK_EVIDENCE(state, None)\n    assert passed[\"pending_guard\"][\"value\"] == \"workbook_denominator_passed\"\n\n    # The review goes stale (as if a later, unrelated write cleared it) between\n    # D28's earlier pass and D32's recomputation; D32 must not trust D28's\n    # cached label.\n    staled = dict(state)\n    staled[\"workbook_reviews\"] = []\n    result = workbook.compute_workbook_denominator(staled)\n    assert not result.passed\n\n    update = workbook.D32_RECOMPUTE_FINAL_RELEASE(staled, None)\n    assert update[\"pending_guard\"][\"value\"] == \"workbook_repairable\"\n    assert update[\"final_release_audits\"][0][\"result\"] == \"FAIL\"\n\n\ndef test_d32_releases_when_the_denominator_currently_passes(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    update = workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"release_proven\"\n    assert update[\"terminal_candidate\"][\"kind\"] == \"COMPLETE\"\n    assert update[\"final_release_audits\"][0][\"result\"] == \"PASS\"\n\n\n# ---------------------------------------------------------------------------\n# TEST 7: workbook terminals traverse the real D98; no terminal writer here\n# ---------------------------------------------------------------------------\n\n\ndef _d98_projection(state: dict[str, Any]) -> dict[str, Any]:\n    from runtime.langgraph_factory.nodes import project\n\n    full = {\n        **state,\n        \"terminal\": None,\n        \"terminal_history\": [],\n        \"accepted_unit_receipts\": state.get(\"accepted_unit_receipts\") or {},\n        \"failure_fingerprints\": [],\n        \"resume_frontier\": None,\n        \"pending_failure\": state.get(\"pending_failure\"),\n        \"output_root\": \"/tmp/out\",\n    }\n    return project(\"D98_WRITE_TERMINAL\", full)\n\n\ndef test_a_complete_candidate_from_d32_traverses_the_real_d98(tmp_path: Path) -> None:\n    assert terminal.write_terminal.__module__ == \"runtime.langgraph_factory.nodes.terminal\"\n\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    state = _apply(state, workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None))\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"COMPLETE\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n\n\ndef test_a_unit_accepted_candidate_from_d24_traverses_the_real_d98(tmp_path: Path) -> None:\n    state = _base_state(tmp_path, unit_ids=(U1,))\n    state[\"mode\"] = \"one\"\n    state[\"requested_unit_id\"] = U1\n    update = workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"unit_target_accepted\"\n    state = _apply(state, update)\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"UNIT_ACCEPTED\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is True\n\n\ndef test_workbook_module_contains_no_terminal_writer_and_no_end_edge() -> None:\n    \"\"\"`write_terminal` is one function, in one module, and this is not it.\n\n    Parses the real source (not a substring grep, which would also flag this\n    docstring's own prose) and checks the two things that would actually let\n    this module claim a terminal: a function named `write_terminal`, or a\n    bare reference to LangGraph's `END` sentinel.\n    \"\"\"\n\n    import ast\n\n    tree = ast.parse(WORKBOOK_PY.read_text(encoding=\"utf-8\"))\n    function_names = {node.name for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)}\n    assert \"write_terminal\" not in function_names\n    names = {node.id for node in ast.walk(tree) if isinstance(node, ast.Name)}\n    assert \"END\" not in names\n    assert \"StateGraph\" not in names\n\n\ndef test_register_workbook_path_adds_no_node_and_creates_no_graph() -> None:\n    \"\"\"Additive registration only, matching `unit_graph.register_unit_path`'s contract.\"\"\"\n\n    import ast\n\n    tree = ast.parse(WORKBOOK_PY.read_text(encoding=\"utf-8\"))\n    calls = [\n        node.func.id if isinstance(node.func, ast.Name) else getattr(node.func, \"attr\", \"\")\n        for node in ast.walk(tree)\n        if isinstance(node, ast.Call)\n    ]\n    assert \"add_node\" not in calls\n    assert \"StateGraph\" not in calls\n    assert \"compile\" not in calls\n\n\n# ---------------------------------------------------------------------------\n# TEST 8: only interruption/named prerequisite pause is resumable\n# ---------------------------------------------------------------------------\n\n\ndef test_workbook_never_proposes_paused_prerequisite() -> None:\n    \"\"\"Only D30 (N22) may propose `PAUSED_PREREQUISITE`; this module never does.\n\n    Checked over every string literal the parsed source actually holds\n    (dict keys/values, argument literals -- not comments or this docstring's\n    own prose, which legitimately names the terminal kind it forbids).\n    \"\"\"\n\n    import ast\n\n    tree = ast.parse(WORKBOOK_PY.read_text(encoding=\"utf-8\"))\n    literals = {\n        node.value\n        for node in ast.walk(tree)\n        if isinstance(node, ast.Constant) and isinstance(node.value, str)\n    }\n    docstrings = {\n        ast.get_docstring(node)\n        for node in ast.walk(tree)\n        if isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))\n    }\n    code_literals = literals - docstrings\n    assert \"PAUSED_PREREQUISITE\" not in code_literals\n    names = {node.id for node in ast.walk(tree) if isinstance(node, ast.Name)}\n    assert \"PrerequisitePause\" not in names\n\n\ndef test_d98_rejects_a_false_pause_candidate_regardless_of_its_source(tmp_path: Path) -> None:\n    \"\"\"A pause candidate with no real `pause`-classified failure is refused.\n\n    Exercises the same independent guard TEST 8 requires without needing a\n    live prerequisite pause: `D98` re-derives the precondition from\n    `pending_failure`'s class, never from who proposed the candidate.\n    \"\"\"\n\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    state[\"pending_failure\"] = {\"class\": \"system\", \"cause\": \"integrity\", \"message\": \"not a real pause\"}\n    state[\"terminal_candidate\"] = {\n        \"kind\": \"PAUSED_PREREQUISITE\",\n        \"fact\": \"some_fact\",\n        \"attempts\": 1,\n        \"required_resume_condition\": \"some_fact becomes retrievable\",\n        \"resume_frontier\": {\"destination\": \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\"},\n    }\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False\n\n\n# ---------------------------------------------------------------------------\n# TEST 9: fake full-run paths cannot emit/copy product COMPLETE evidence\n# ---------------------------------------------------------------------------\n\n\ndef test_a_tampered_complete_candidate_is_rejected_by_the_real_d98(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    state = _apply(state, workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None))\n    tampered = dict(state[\"terminal_candidate\"])\n    tampered[\"workbook_hash\"] = \"not-the-real-hash\"\n    state[\"terminal_candidate\"] = tampered\n    projection = _d98_projection(state)\n    record = terminal.write_terminal(projection, None)\n    assert record[\"terminal\"][\"kind\"] == \"SYSTEM_FAILURE\"\n    assert record[\"terminal\"][\"validation\"][\"accepted\"] is False\n\n\ndef test_d32_refuses_release_while_a_manifest_member_is_unaccepted(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    # A fake full run: one manifest member was never really accepted.\n    del state[\"accepted_unit_receipts\"][U2]\n    result = workbook.compute_workbook_denominator(state)\n    assert not result.passed\n    update = workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None)\n    assert update[\"pending_guard\"][\"value\"] == \"workbook_repairable\"\n    assert \"kind\" not in (update.get(\"terminal_candidate\") or {})\n\n\n# ---------------------------------------------------------------------------\n# TEST 10: crash at assembly/review/repair/release/D98 boundaries is idempotent\n# ---------------------------------------------------------------------------\n\n\ndef test_repeating_d25_after_a_crash_replays_idempotently(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _base_state(tmp_path)\n    state = _apply(state, workbook.D24_PROVE_EXACT_MANIFEST_COVERAGE(state, None))\n    registry = _Registry(sandbox)\n    context = _Context(sandbox, registry)\n    first = workbook.D25_ASSEMBLE_WORKBOOK(state, context)\n    again = workbook.D25_ASSEMBLE_WORKBOOK(state, context)\n    assert first[\"workbook_head\"] == again[\"workbook_head\"]\n    assert first[\"workbook_versions\"][0][\"hash\"] == again[\"workbook_versions\"][0][\"hash\"]\n\n\ndef test_repeating_d31_after_a_crash_replays_idempotently(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _repairable_layout_state(tmp_path, sandbox)\n    state = _apply(state, workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None))\n    first = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n    again = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n    assert first[\"workbook_versions\"][0][\"hash\"] == again[\"workbook_versions\"][0][\"hash\"]\n    assert first[\"workbook_head\"] == again[\"workbook_head\"]\n\n\ndef test_re_admitting_a_workbook_repair_after_the_head_already_advanced_fails_closed(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _repairable_layout_state(tmp_path, sandbox)\n    state = _apply(state, workbook.D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR(state, None))\n    update = workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n    state = _apply(state, update)  # the durable, post-crash state: head already advanced\n    with pytest.raises(SystemFailure):\n        workbook.D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR(state, None)\n\n\ndef test_repeating_the_terminal_write_after_a_crash_replays_idempotently(tmp_path: Path) -> None:\n    sandbox = tmp_path / \"sandbox\"\n    state = _assemble_and_review(tmp_path, sandbox)\n    state = _apply(state, workbook.D32_RECOMPUTE_FINAL_RELEASE(state, None))\n    projection = _d98_projection(state)\n    record_a = terminal.write_terminal(projection, None)\n    record_b = terminal.write_terminal(projection, None)\n    assert record_a[\"terminal\"] == record_b[\"terminal\"]\n\n\n# ---------------------------------------------------------------------------\n# Topology: D24-D32 are real, additively-registered graph nodes\n# ---------------------------------------------------------------------------\n\n\ndef test_the_compiled_graph_really_registers_the_workbook_engine(tmp_path: Path) -> None:\n    \"\"\"`register_workbook_topology` wires a real, internally-consistent branch.\n\n    D24 is deliberately unreachable from `D05_SELECT_NEXT_UNIT` in this\n    generation (`test_blocked_d05_cannot_reach_d24_yet` below names why, and\n    who owns closing it), and LangGraph's own `get_graph()` drawing prunes\n    edges with no path from `START` -- so this asserts against the builder's\n    own registered `branches` (the actual routing table LangGraph compiles\n    from), not the pruned visualization `compiled_topology()` returns.\n    \"\"\"\n\n    from langgraph.graph import StateGraph\n\n    from runtime.langgraph_factory.state import FactoryInput, FactoryOutput, FactoryState, RuntimeContext\n\n    builder = StateGraph(\n        FactoryState, context_schema=RuntimeContext, input_schema=FactoryInput, output_schema=FactoryOutput\n    )\n    G.register_skeleton(builder, G.binding_inventory())\n    resolved = G.register_workbook_topology(builder)\n\n    for node_id in workbook.WORKBOOK_NODE_BODIES:\n        assert node_id in builder.nodes\n\n    assert set(resolved[\"D24_PROVE_EXACT_MANIFEST_COVERAGE\"]) == {\n        \"D25_ASSEMBLE_WORKBOOK\", \"D98_WRITE_TERMINAL\", \"D96_GRACEFUL_INTERRUPT_GATE\"\n    }\n    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D25_ASSEMBLE_WORKBOOK\"]\n    assert set(resolved[\"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\"]) >= {\n        \"D27_FREEZE_WORKBOOK_REVIEW_PACKET\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    }\n    assert \"D90_RESERVE_MODEL_ATTEMPT\" in resolved[\"D27_FREEZE_WORKBOOK_REVIEW_PACKET\"]\n    assert set(resolved[\"D28_REDUCE_WORKBOOK_EVIDENCE\"]) >= {\n        \"D32_RECOMPUTE_FINAL_RELEASE\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    }\n    assert set(resolved[\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"]) >= {\n        \"D90_RESERVE_MODEL_ATTEMPT\", \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\", \"D98_WRITE_TERMINAL\"\n    }\n    assert \"D26_RENDER_INVENTORY_INSPECT_WORKBOOK\" in resolved[\"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\"]\n    assert set(resolved[\"D32_RECOMPUTE_FINAL_RELEASE\"]) >= {\n        \"D98_WRITE_TERMINAL\", \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    }\n    assert \"D28_REDUCE_WORKBOOK_EVIDENCE\" in resolved[\"M07_REVIEW_ACTUAL_WORKBOOK\"]\n    assert \"D31_ADMIT_AND_RETEST_WORKBOOK_REPAIR\" in resolved[\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\"]\n\n    # No branch this module registered names `END` or `START` -- D98 is the\n    # sole terminal writer and D24/D32 only ever propose a candidate to it.\n    for destinations in resolved.values():\n        assert \"END\" not in destinations and \"__end__\" not in destinations\n        assert \"START\" not in destinations and \"__start__\" not in destinations\n\n    # The real graph still compiles with this branch attached.\n    saver, _connection = G.open_checkpoint_saver(tmp_path / \"out\")\n    compiled = builder.compile(checkpointer=saver, name=G.GRAPH_NAME)\n    assert compiled.name == G.GRAPH_NAME\n\n\ndef test_blocked_d05_cannot_reach_d24_yet() -> None:\n    \"\"\"Owned by N30_UNIT_GRAPH: `D05`'s one registered branch predates D24.\n\n    `unit_graph.UNIT_BRANCHES` registers exactly one conditional-edge branch\n    for `D05_SELECT_NEXT_UNIT`, using `unit_graph.py`'s own frozen\n    `MODEL_BRANCH_DESTINATIONS`-independent fallback\n    (`routing.guard_destinations`), narrowed to `unit_graph.py`'s own\n    `available` argument at registration time. `unit_graph.DEFERRED_EDGES`\n    explicitly declares `(D05_SELECT_NEXT_UNIT, manifest_exhausted, D24_...,\n    N32_WORKBOOK_TERMINALS)` as a row whose destination has no node body --\n    a declaration this node cannot invalidate without either registering a\n    second, colliding branch on the same source (LangGraph raises\n    `ValueError: Branch ... already exists`) or editing `unit_graph.py`\n    itself, which is outside this node's write set. D24 is therefore\n    registered as a real node with real outgoing edges (proven above) but is\n    not yet reachable from `D05` in the compiled graph -- an honest,\n    structural consequence of `binding_inventory()` staying exactly what it\n    was before N32 (see that function's own docstring), not a defect in D24's\n    own implementation. Closing this is N30_UNIT_GRAPH's\n    `unit_flow_or_denominator` rework edge: widen `MODEL_BRANCH_DESTINATIONS`/\n    `UNIT_BRANCHES`' fallback to include `D24_PROVE_EXACT_MANIFEST_COVERAGE`.\n    \"\"\"\n\n    assert (\"D05_SELECT_NEXT_UNIT\", \"manifest_exhausted\", \"D24_PROVE_EXACT_MANIFEST_COVERAGE\", \"N32_WORKBOOK_TERMINALS\") in U.DEFERRED_EDGES\n    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" not in G.binding_inventory()\n    assert \"D24_PROVE_EXACT_MANIFEST_COVERAGE\" in G.full_binding_inventory()\n\n\ndef test_blocked_d91_cannot_reach_d29_yet() -> None:\n    \"\"\"Owned by N30_UNIT_GRAPH: `D91`'s one registered branch predates D29.\n\n    `unit_graph.MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]` is a\n    frozen 4-tuple that names `D17_CLASSIFY_UNIT_FINDINGS` (the unit repair\n    classifier) but not `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR`. `D91` is a\n    shared bookkeeping node `unit_graph.py` already registers exactly one\n    branch for; this node cannot register a second branch on the same source\n    (every branch on a node fires on each of its executions, so a second,\n    narrower branch would not shadow the first -- it would double-fire and\n    `KeyError` on the first branch's own narrower `ends`), and cannot widen\n    `unit_graph.py`'s table directly (outside this node's write set). A\n    transport failure on `M07`/`M08` that `model_nodes\n    ._repair_destination` classifies as workbook-repairable therefore cannot\n    reach `D29` through the compiled graph in this generation.\n    `D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR` itself is fully implemented and\n    independently correct (see the TEST 4/5 cases above, and\n    `model_nodes._repair_destination`'s own routing logic); only the\n    registered graph edge is missing. Closing this is N30_UNIT_GRAPH's\n    `unit_flow_or_denominator` rework edge: add\n    `\"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"` to\n    `MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]`.\n    \"\"\"\n\n    from runtime.langgraph_factory import model_nodes as mn\n\n    assert mn._repair_destination(\"M08_REPAIR_NAMED_WORKBOOK_DEFECT\") == \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\"\n    assert \"D29_CLASSIFY_AND_PLAN_WORKBOOK_REPAIR\" not in U.MODEL_BRANCH_DESTINATIONS[\"D91_CLASSIFY_MODEL_FAILURE\"]\n","numLines":866,"startLine":1,"totalLines":866}}}
