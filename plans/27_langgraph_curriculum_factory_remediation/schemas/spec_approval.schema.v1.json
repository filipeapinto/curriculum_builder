{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run 27 corrected specification approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approved",
    "approved_spec",
    "approved_spec_sha256",
    "qa_verdict",
    "qa_verification_sha256",
    "approved_for",
    "approved_at",
    "approval_statement"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "approved": {"const": true},
    "approved_spec": {
      "const": "plans/26_langgraph_curriculum_factory/spec/langgraph_curriculum_factory.spec.v2.md"
    },
    "approved_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "qa_verdict": {"const": "QA_PASSED"},
    "qa_verification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_for": {"const": "plan27_implementation_remediation"},
    "approved_at": {"type": "string", "format": "date-time"},
    "approval_statement": {"type": "string", "minLength": 20}
  }
}
