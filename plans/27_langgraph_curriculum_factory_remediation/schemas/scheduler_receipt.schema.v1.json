{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run 27 scheduler receipt v1",
  "description": "Controller-internal admission record. Distinct from the node-authored node_result.schema.v1.json: a node result is a claim, a scheduler receipt is the controller's binding of that claim to graph, specification, prompt, baseline, predecessor, command, log, changed-file, and final-output digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "node_id",
    "attempt_id",
    "parent_attempt_id",
    "status",
    "admitted_at",
    "admission",
    "graph_sha256",
    "node_definition_sha256",
    "prompt_sha256",
    "approved_spec_sha256",
    "baseline_sha256",
    "baseline",
    "predecessor_receipts",
    "predecessor_results",
    "lineage_fingerprint",
    "result_path",
    "result_sha256",
    "changed_files",
    "commands",
    "verification",
    "evidence",
    "final_outputs"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{2}_[A-Z0-9_]+$"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code", "log", "log_sha256"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "log": {"type": "string", "minLength": 1},
        "log_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"$ref": "#/$defs/node_id"},
    "attempt_id": {"type": "string", "minLength": 1},
    "parent_attempt_id": {"type": ["string", "null"], "minLength": 1},
    "status": {
      "description": "Only admissible outcomes are ever receipted. BLOCKED node results never produce a receipt.",
      "enum": ["PASSED", "NOT_AVAILABLE"]
    },
    "admitted_at": {"type": "string", "minLength": 1},
    "admission": {"enum": ["normal", "recovery_readmission"]},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "node_definition_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "approved_spec_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "baseline": {
      "description": "Digest of every declared write path immediately before the attempt began.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/nullable_sha256"}
    },
    "predecessor_receipts": {
      "description": "Digest of each predecessor's scheduler receipt file at admission time.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/nullable_sha256"}
    },
    "predecessor_results": {
      "description": "Predecessor result-file digests as declared by the node result itself.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "lineage_fingerprint": {
      "description": "Canonical digest of graph, node definition, prompt, approved specification, and predecessor receipt digests. A receipt stops being current the moment this recomputes differently.",
      "$ref": "#/$defs/sha256"
    },
    "result_path": {"type": "string", "minLength": 1},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "change": {"enum": ["created", "modified", "deleted"]},
          "sha256": {"$ref": "#/$defs/nullable_sha256"}
        }
      }
    },
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "verification": {
      "description": "The graph's own verification commands as rerun by the controller during admission.",
      "type": "array",
      "items": {"$ref": "#/$defs/command"}
    },
    "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "final_outputs": {
      "description": "Digest of every declared write path at admission time. Files digest directly; directories digest as their canonical file tree.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/nullable_sha256"}
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "reason",
        "expect_result_sha256",
        "superseded_receipt_sha256",
        "verification_rerun"
      ],
      "properties": {
        "reason_code": {
          "enum": [
            "INTERRUPTED_MERGE_COMPLETED",
            "EXTERNAL_PROCESS_KILL",
            "STATE_STORE_CORRUPTION",
            "ANCESTOR_REWORK_REVALIDATION"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "expect_result_sha256": {"$ref": "#/$defs/sha256"},
        "superseded_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "verification_rerun": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"admission": {"const": "recovery_readmission"}},
        "required": ["admission"]
      },
      "then": {"required": ["recovery"]},
      "else": {"not": {"required": ["recovery"]}}
    }
  ]
}
