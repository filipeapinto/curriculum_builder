{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-same-model-qa-gate:calibration:extraction:v1",
  "title": "Codex same-model QA evidence extraction record",
  "description": "Proposed frozen extraction schema pending human approval of the calibration packet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "extraction_id", "source_id", "source_version_id", "created_at_utc", "responsible_role", "source_class", "research_question_ids", "mechanism_family_ids", "mechanism", "assurance_claims", "artifact_types", "model_relationship", "study_or_control_design", "metrics", "failure_modes", "trust_assumptions", "applicability", "claim_source_links", "appraisal", "record_provenance"],
  "properties": {
    "schema_name": {"const": "codex_same_model_qa_gate.evidence_extraction"},
    "schema_version": {"const": "1.0.0"},
    "extraction_id": {"type": "string", "pattern": "^EXT-[A-Z0-9._-]+$"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9._-]+$"},
    "source_version_id": {"type": "string", "minLength": 1},
    "supersedes_extraction_id": {"type": ["string", "null"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "responsible_role": {"type": "string", "minLength": 1},
    "source_class": {"enum": ["empirical", "standard_or_official_document", "software", "formal_or_theoretical"]},
    "research_question_ids": {"type": "array", "items": {"enum": ["RQ1", "RQ2", "RQ3", "RQ4", "RQ5"]}, "minItems": 1, "uniqueItems": true},
    "mechanism_family_ids": {"type": "array", "items": {"enum": ["MF1", "MF2", "MF3", "MF4", "MF5", "MF6"]}, "minItems": 1, "uniqueItems": true},
    "mechanism": {"type": "object", "required": ["name", "description", "gate_location"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "gate_location": {"type": "string"}}, "additionalProperties": false},
    "assurance_claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "claim_text", "claim_type", "direction"], "properties": {"claim_id": {"type": "string"}, "claim_text": {"type": "string"}, "claim_type": {"enum": ["causal", "associational", "descriptive", "formal", "normative", "operational"]}, "direction": {"enum": ["supports", "contradicts", "null_or_mixed", "boundary_only"]}}, "additionalProperties": false}, "minItems": 1},
    "artifact_types": {"type": "array", "items": {"enum": ["code", "document", "plan", "mixed", "general_or_unspecified"]}, "minItems": 1, "uniqueItems": true},
    "model_relationship": {"type": "object", "required": ["producer_model", "reviewer_model", "relationship", "separation_qualifier"], "properties": {"producer_model": {"type": ["string", "null"]}, "reviewer_model": {"type": ["string", "null"]}, "relationship": {"enum": ["same_named_model_and_version", "same_family", "different_family", "non_model", "mixed", "not_reported", "not_applicable"]}, "separation_qualifier": {"enum": ["fresh_context_procedural", "sample_only", "model_family", "organizational", "cryptographic_trust", "none", "not_reported", "not_applicable"]}}, "additionalProperties": false},
    "study_or_control_design": {"type": "object", "required": ["design_type", "sample", "baseline", "randomization", "blinding", "contamination_controls"], "properties": {"design_type": {"type": "string"}, "sample": {"type": "string"}, "baseline": {"type": ["string", "null"]}, "randomization": {"type": ["string", "null"]}, "blinding": {"type": ["string", "null"]}, "contamination_controls": {"type": ["string", "null"]}}, "additionalProperties": false},
    "metrics": {"type": "array", "items": {"type": "object", "required": ["name", "value", "uncertainty", "unit", "denominator"], "properties": {"name": {"type": "string"}, "value": {"type": ["number", "string", "null"]}, "uncertainty": {"type": ["string", "null"]}, "unit": {"type": ["string", "null"]}, "denominator": {"type": ["integer", "string", "null"]}}, "additionalProperties": false}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "resource_cost": {"type": "object", "properties": {"latency": {"type": ["string", "null"]}, "model_calls": {"type": ["integer", "null"]}, "tokens": {"type": ["integer", "null"]}, "monetary_cost": {"type": ["number", "null"]}, "human_time": {"type": ["string", "null"]}}, "additionalProperties": false},
    "trust_assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "applicability": {"type": "object", "required": ["codex_relevance", "artifact_scope", "risk_tier_limits", "transfer_limits"], "properties": {"codex_relevance": {"type": "string"}, "artifact_scope": {"type": "string"}, "risk_tier_limits": {"type": "string"}, "transfer_limits": {"type": "string"}}, "additionalProperties": false},
    "claim_source_links": {"type": "array", "items": {"type": "object", "required": ["claim_id", "locator", "evidence_kind", "paraphrase"], "properties": {"claim_id": {"type": "string"}, "locator": {"type": "string"}, "evidence_kind": {"enum": ["direct_result", "method", "normative_text", "code_or_test", "author_interpretation", "limitation"]}, "paraphrase": {"type": "string"}, "verbatim_quote": {"type": ["string", "null"]}}, "additionalProperties": false}, "minItems": 1},
    "appraisal": {"type": "object", "required": ["instrument_id", "overall_rating", "appraisal_record_id"], "properties": {"instrument_id": {"enum": ["APP-EMPIRICAL-v1", "APP-STANDARD-DOC-v1", "APP-SOFTWARE-v1", "APP-FORMAL-v1"]}, "overall_rating": {"enum": ["high", "moderate", "low"]}, "appraisal_record_id": {"type": "string"}}, "additionalProperties": false},
    "contradictions_or_nulls": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "record_provenance": {"type": "object", "required": ["source_url", "retrieved_at_utc", "content_sha256", "extractor_model", "extractor_effort"], "properties": {"source_url": {"type": "string"}, "retrieved_at_utc": {"type": "string", "format": "date-time"}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "extractor_model": {"type": "string"}, "extractor_effort": {"type": "string"}}, "additionalProperties": false}
  }
}
