{
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "artifact_sha256", "state", "findings", "observations"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{2}-[0-9]{2}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["PASS", "FAIL", "QA_ERROR"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "evidence", "consequence"],
        "properties": {
          "criterion": {"type": "string"},
          "evidence": {"type": "string"},
          "consequence": {"type": "string"}
        }
      }
    },
    "observations": {"type": "array", "items": {"type": "string"}}
  }
}
