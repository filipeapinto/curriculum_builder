{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/M01_research_unit_sources.schema.json",
  "title": "M01 research_unit_sources candidate output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "url", "title", "publisher", "locator_kind", "rationale"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "url": {"type": "string", "minLength": 1, "maxLength": 2000},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "publisher": {"type": "string", "minLength": 1, "maxLength": 300},
          "locator_kind": {"type": "string", "enum": ["primary", "secondary", "reference"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "retrieval_id", "claims", "limitations"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "retrieval_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_text", "source_quote", "source_location"],
              "properties": {
                "claim_text": {"type": "string", "minLength": 1, "maxLength": 4000},
                "source_quote": {"type": "string", "minLength": 1, "maxLength": 4000},
                "source_location": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        }
      }
    },
    "no_verified_source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "reason"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  },
  "if": {"required": ["locators"]},
  "then": {"not": {"anyOf": [{"required": ["interpretations"]}, {"required": ["no_verified_source"]}]}},
  "else": {
    "if": {"required": ["interpretations"]},
    "then": {"not": {"required": ["no_verified_source"]}},
    "else": {"required": ["no_verified_source"]}
  }
}
