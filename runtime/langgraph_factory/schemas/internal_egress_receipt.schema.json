{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/internal_egress_receipt.schema.json",
  "title": "Internal egress broker receipt (allowed retrieval or denial)",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_kind", "recorded_at_utc", "channel", "requested_target", "outcome"],
  "properties": {
    "receipt_kind": {"type": "string", "enum": ["egress_allowed", "egress_denied"]},
    "recorded_at_utc": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "enum": ["socket_connect", "socket_connect_ex", "create_connection", "source_retrieval", "subprocess_transmission"]},
    "requested_target": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["allowed", "denied"]},
    "denial_reason": {"type": ["string", "null"]},
    "authorization_receipt_id": {"type": ["string", "null"]},
    "locator": {"type": ["string", "null"]},
    "resolved_host": {"type": ["string", "null"]},
    "resolved_addresses": {"type": "array", "items": {"type": "string"}},
    "final_url": {"type": ["string", "null"]},
    "redirect_chain": {"type": "array", "items": {"type": "string"}},
    "http_status": {"type": ["integer", "null"]},
    "tls": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "protocol": {"type": ["string", "null"]},
        "cipher": {"type": ["string", "null"]},
        "peer_subject": {"type": ["string", "null"]}
      }
    },
    "content_type": {"type": ["string", "null"]},
    "byte_count": {"type": ["integer", "null"], "minimum": 0},
    "bytes_sha256": {"type": ["string", "null"]},
    "data_class": {"type": ["string", "null"]},
    "traceback_origin": {"type": ["string", "null"]}
  }
}
