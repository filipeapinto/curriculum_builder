{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/internal_authorization_receipt.schema.json",
  "title": "Internal external-data authorization receipt (spec 7.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "authorization_digest", "provider", "data_classes",
    "curriculum_digest", "run_id", "output_root", "approved_at_utc",
    "expires_at_utc", "checked_at_utc", "decision"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "authorization_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"type": "string", "enum": ["openai", "google", "primary_source_hosts"]},
    "data_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "curriculum_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "approved_at_utc": {"type": "string", "minLength": 1},
    "expires_at_utc": {"type": "string", "minLength": 1},
    "checked_at_utc": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["granted"]}
  }
}
