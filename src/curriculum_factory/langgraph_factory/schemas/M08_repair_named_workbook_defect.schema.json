{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/M08_repair_named_workbook_defect.schema.json",
  "title": "M08 repair_named_workbook_defect candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_child", "changed_file_manifest"],
  "properties": {
    "candidate_child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_name", "artifact_body", "addressed_defect_id"],
      "properties": {
        "artifact_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "artifact_body": {"type": "string", "minLength": 1, "maxLength": 500000},
        "addressed_defect_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "changed_file_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["staged_file_name", "change_kind", "defect_id"],
        "properties": {
          "staged_file_name": {"type": "string", "minLength": 1, "maxLength": 300},
          "change_kind": {"type": "string", "enum": ["replace", "insert", "remove"]},
          "defect_id": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
