{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/internal_execution_receipt.schema.json",
  "title": "Internal immutable transport execution receipt (never sent to a model)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_id", "attempt_ordinal", "reservation_id", "job_id", "job_type",
    "decided_family", "decided_model", "decided_reasoning_effort",
    "observed_family", "observed_model", "observed_identity_source",
    "executable_path", "executable_sha256", "executable_version",
    "redacted_command", "returncode", "pid",
    "started_utc", "ended_utc", "duration_seconds",
    "timeout_seconds", "termination",
    "workspace_path", "authorized_input_sha256", "output_schema_sha256",
    "cli_schema_projection_sha256",
    "prompt_sha256", "staged_input_sha256", "result_sha256",
    "stdout_evidence_path", "stderr_evidence_path",
    "stdout_sha256", "stderr_sha256",
    "sandbox_mechanism", "authorization_receipt_id", "outcome"
  ],
  "properties": {
    "activation_id": {"type": "string", "minLength": 1},
    "attempt_ordinal": {"type": "integer", "minimum": 1},
    "reservation_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "job_type": {"type": "string", "minLength": 1},
    "decided_family": {"type": "string", "minLength": 1},
    "decided_model": {"type": "string", "minLength": 1},
    "decided_reasoning_effort": {"type": "string", "minLength": 1},
    "observed_family": {"type": ["string", "null"]},
    "observed_model": {"type": ["string", "null"]},
    "observed_identity_source": {"type": ["string", "null"]},
    "executable_path": {"type": "string", "minLength": 1},
    "executable_sha256": {"type": ["string", "null"]},
    "executable_version": {"type": "string", "minLength": 1},
    "redacted_command": {"type": "array", "items": {"type": "string"}},
    "returncode": {"type": ["integer", "null"]},
    "pid": {"type": ["integer", "null"]},
    "started_utc": {"type": "string", "minLength": 1},
    "ended_utc": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "termination": {"type": "string", "enum": ["exited", "timeout_term", "timeout_kill", "signal", "not_launched"]},
    "workspace_path": {"type": "string", "minLength": 1},
    "authorized_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cli_schema_projection_sha256": {
      "anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]
    },
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "staged_input_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "result_sha256": {"type": ["string", "null"]},
    "stdout_evidence_path": {"type": "string", "minLength": 1},
    "stderr_evidence_path": {"type": "string", "minLength": 1},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sandbox_mechanism": {"type": "string", "minLength": 1},
    "authorization_receipt_id": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["candidate_produced", "transport_failure"]},
    "failure_class": {"type": ["string", "null"]},
    "failure_detail": {"type": ["string", "null"]},
    "workspace_inventory_before": {"type": "array", "items": {"type": "string"}},
    "workspace_inventory_after": {"type": "array", "items": {"type": "string"}}
  }
}
