{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/M03_write_unit_content.schema.json",
  "title": "M03 write_unit_content candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_content"],
  "properties": {
    "unit_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "sections", "evidence_references"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "heading", "body"],
            "properties": {
              "section_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "heading": {"type": "string", "minLength": 1, "maxLength": 500},
              "body": {"type": "string", "minLength": 1, "maxLength": 200000}
            }
          }
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "source_id", "source_location"],
            "properties": {
              "section_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "source_location": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          }
        },
        "visuals": {
          "description": "Declared visual briefs. D10 compiles these into the unit's exact visual denominator and splits them into the deterministic and model subsets; a unit that needs no picture omits the key or declares an empty list.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "kind"],
            "properties": {
              "role": {"type": "string", "minLength": 1, "maxLength": 200},
              "kind": {"type": "string", "minLength": 1, "maxLength": 200},
              "authoritative": {"type": "boolean"},
              "requests_authoritative_facts": {"type": "boolean"},
              "permitted_facts": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    }
  }
}
