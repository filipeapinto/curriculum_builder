{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan26/M02_create_unit_domain_data.schema.json",
  "title": "M02 create_unit_domain_data candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_version"],
  "properties": {
    "domain_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "fields", "evidence_references"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_location"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "source_location": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          }
        }
      }
    }
  }
}
