{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "embedded-family-model.schema.json",
  "title": "Skill Family Embedded Model",
  "description": "Machine-readable model embedded in every family-guide.html as <script type=\"application/json\" id=\"family-model\">. Consumed by validate_embedded_model.py and by update/audit mode to detect drift.",
  "type": "object",
  "required": ["schema_version", "family", "components", "edges", "entry_point", "evaluations", "sources", "assurance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },

    "family": {
      "type": "object",
      "required": ["slug", "name", "outcome", "audience", "scope", "status"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },

    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "job", "entry_conditions", "inputs", "outputs", "dependencies", "required", "failure_owner", "evidence_path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "job": { "type": "string", "minLength": 1 },
          "entry_conditions": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "caller_facing_outputs": { "type": "array", "items": { "type": "string" } },
          "direct_writes": { "type": "array", "items": { "type": "string" } },
          "delegated_outputs": { "type": "array", "items": { "type": "string" } },
          "control_outputs": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "downstream_consumer": { "type": ["string", "null"] },
          "failure_owner": { "type": "string", "minLength": 1 },
          "evidence_path": { "type": "string", "minLength": 1 },
          "is_default_orchestrator": { "type": "boolean" },
          "is_utility": { "type": "boolean" }
        }
      }
    },

    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": {
            "enum": ["sequence", "dependency", "optional_gate", "utility", "repair_route", "alternate_entry"]
          },
          "note": { "type": "string" }
        }
      }
    },

    "entry_point": {
      "type": "object",
      "required": ["component_id", "status"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": ["string", "null"] },
        "status": { "enum": ["proven", "declared", "unknown"] },
        "invocation": { "type": "string" }
      }
    },

    "shared_state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "description"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "description": { "type": "string" },
          "writers": { "type": "array", "items": { "type": "string" } },
          "readers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "failure_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symptom", "owner", "recovery"],
        "additionalProperties": false,
        "properties": {
          "symptom": { "type": "string" },
          "owner": { "type": "string" },
          "recovery": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    },

    "requirements": {
      "type": "array",
      "items": { "type": "string" }
    },

    "authority_ladder": {
      "type": "array",
      "items": { "type": "string" }
    },

    "known_drift": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "class"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "class": {
            "enum": [
              "MEMBERSHIP_DRIFT", "TOPOLOGY_DRIFT", "INTERFACE_DRIFT",
              "DEPENDENCY_DRIFT", "AUTHORITY_DRIFT", "PROSE_DRIFT", "SOURCE_DRIFT"
            ]
          },
          "evidence": { "type": "string" }
        }
      }
    },

    "evaluations": {
      "type": "object",
      "required": ["component_tests", "family_integration", "documentation_evaluation"],
      "additionalProperties": false,
      "properties": {
        "component_tests": { "type": "array", "items": { "$ref": "#/definitions/evaluation_result" } },
        "family_integration": { "type": "array", "items": { "$ref": "#/definitions/evaluation_result" } },
        "documentation_evaluation": { "type": "array", "items": { "$ref": "#/definitions/evaluation_result" } }
      }
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|unavailable)$" },
          "role": { "type": "string" }
        }
      }
    },

    "assurance": {
      "type": "object",
      "required": ["generated_utc", "mode", "document_path", "version"],
      "additionalProperties": false,
      "properties": {
        "generated_utc": { "type": "string" },
        "mode": { "enum": ["create", "update", "audit"] },
        "document_path": { "type": "string" },
        "previous_version_path": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 1 },
        "generator": {
          "type": "object",
          "required": ["agent", "skill", "implementation"],
          "additionalProperties": false,
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "skill": { "type": "string", "minLength": 1 },
            "implementation": { "type": "string", "minLength": 1 }
          }
        },
        "disclosures": { "type": "array", "items": { "type": "string" } }
      }
    }
  },

  "definitions": {
    "evaluation_result": {
      "type": "object",
      "required": ["name", "status", "scope"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "status": {
          "enum": ["NOT_RUN", "NO_EVIDENCE_FOUND", "PARTIAL", "PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]
        },
        "scope": { "type": "string" },
        "method": { "type": "string" },
        "date": { "type": "string" },
        "environment": { "type": "string" },
        "findings": { "type": "string" },
        "evidence_path": { "type": "string" },
        "limitations": { "type": "string" },
        "evidence_type": { "enum": ["observed_historical", "executed_during_creation", "declared_unexecuted"] }
      }
    }
  }
}
